[
 {
  "level": 1,
  "text": "第三章 复乐园",
  "uiIdx": "",
  "range": "",
  "chapterUid": 20
 },
 {
  "level": 2,
  "text": "怡婷和伊纹姐姐的悲伤",
  "uiIdx": "1",
  "range": "3952-3979",
  "chapterUid": 20
 },
 {
  "level": 3,
  "text": "怡婷看完日记后，感到悲伤和绝望",
  "uiIdx": "1.1",
  "range": "3952-3979",
  "chapterUid": 20
 },
 {
  "level": 4,
  "text": "怡婷把日记翻到会背了，她感觉那些事简直像发生在她身上。",
  "uiIdx": "",
  "range": "3952-3979",
  "chapterUid": 20
 },
 {
  "level": 4,
  "text": "怡婷约了李国华，说她知道了，让她去他的小公寓吧。",
  "uiIdx": "",
  "range": "4631-4655",
  "chapterUid": 20
 },
 {
  "level": 3,
  "text": "伊纹姐姐在律师的帮助下，试图为思琪讨回公道",
  "uiIdx": "1.2",
  "range": "4005-4027",
  "chapterUid": 20
 },
 {
  "level": 4,
  "text": "伊纹姐姐的律师介绍了女权律师，她们一齐去找律师。",
  "uiIdx": "",
  "range": "4005-4027",
  "chapterUid": 20
 },
 {
  "level": 4,
  "text": "律师说：“没办法的，要证据，没有证据，你们只会被反咬妨害名誉，而且是他会胜诉。”。",
  "uiIdx": "",
  "range": "4058-4098",
  "chapterUid": 20
 },
 {
  "level": 2,
  "text": "思琪的疯癫和怡婷的愤怒",
  "uiIdx": "2",
  "range": "6448-6470",
  "chapterUid": 20
 },
 {
  "level": 3,
  "text": "思琪在精神病院里，对周围的一切都感到无聊",
  "uiIdx": "2.1",
  "range": "6448-6470",
  "chapterUid": 20
 },
 {
  "level": 4,
  "text": "思琪总是缩成一团，水果拿在手上小口小口啃。",
  "uiIdx": "",
  "range": "6448-6470",
  "chapterUid": 20
 },
 {
  "level": 4,
  "text": "伊纹姐姐读道：“我才知道，在奥斯维辛也可以感到无聊。”。",
  "uiIdx": "",
  "range": "6470-6497",
  "chapterUid": 20
 },
 {
  "level": 3,
  "text": "怡婷对李国华的愤怒，让她想要报复",
  "uiIdx": "2.2",
  "range": "5240-5262",
  "chapterUid": 20
 },
 {
  "level": 4,
  "text": "怡婷一口气把衣裤脱了，眼睛里也无风雨也无晴。",
  "uiIdx": "",
  "range": "5240-5262",
  "chapterUid": 20
 },
 {
  "level": 4,
  "text": "“老师，你强暴我吧。”——像你对思琪做的那样，我要感受所有她感受到的，她对你的挚爱和讨厌，我要做两千个晚上一模一样的噩梦。”。",
  "uiIdx": "",
  "range": "5273-5323",
  "chapterUid": 20
 },
 {
  "level": 2,
  "text": "毛毛和伊纹的和解",
  "uiIdx": "3",
  "range": "2565-2585",
  "chapterUid": 20
 },
 {
  "level": 3,
  "text": "毛毛对伊纹的失望，让他决定离开",
  "uiIdx": "3.1",
  "range": "2565-2585",
  "chapterUid": 20
 },
 {
  "level": 4,
  "text": "毛毛回伊纹这儿，打开门就听见伊纹在淋浴。",
  "uiIdx": "",
  "range": "2565-2585",
  "chapterUid": 20
 },
 {
  "level": 4,
  "text": "毛毛发现自己在大喊。伊纹生气了：“为什么我要回答这个问题？你是我的谁？”。",
  "uiIdx": "",
  "range": "2787-2806",
  "chapterUid": 20
 },
 {
  "level": 3,
  "text": "伊纹对毛毛的愤怒，让她决定离开",
  "uiIdx": "3.2",
  "range": "2902-2943",
  "chapterUid": 20
 },
 {
  "level": 4,
  "text": "伊纹默默收拾屋子，突然觉得什么都是假的，什么人都要求她，只有陀思妥耶夫斯基属于她。",
  "uiIdx": "",
  "range": "2902-2943",
  "chapterUid": 20
 },
 {
  "level": 4,
  "text": "一个小时后，毛毛回来了。",
  "uiIdx": "",
  "range": "2972-2984",
  "chapterUid": 20
 },
 {
  "level": 2,
  "text": "怡婷的决定和勇气",
  "uiIdx": "4",
  "range": "7407-7449",
  "chapterUid": 20
 },
 {
  "level": 3,
  "text": "怡婷决定面对思琪的疯癫，学习她的勇气",
  "uiIdx": "4.1",
  "range": "7407-7449",
  "chapterUid": 20
 },
 {
  "level": 4,
  "text": "怡婷对伊纹姐姐说：“怡婷，你才十八岁，你有选择，你可以假装世界上没有人以强暴小女孩为乐。”。",
  "uiIdx": "",
  "range": "7407-7449",
  "chapterUid": 20
 },
 {
  "level": 4,
  "text": "怡婷对伊纹姐姐说：“怡婷，你可以写一本生气的书，你想想，能看到你的书的人是多么幸运，他们不用接触，就可以看到世界的背面。”。",
  "uiIdx": "",
  "range": "8270-8321",
  "chapterUid": 20
 },
 {
  "level": 3,
  "text": "怡婷的勇气，让她决定为思琪活下去",
  "uiIdx": "4.2",
  "range": "4631-4655",
  "chapterUid": 20
 },
 {
  "level": 4,
  "text": "怡婷对伊纹姐姐说：“每次去找思琪，念书给她听，我不知道为什么总是想到家里的香氛蜡烛，白胖带泪的蜡烛总是让我想到那个词——尿失禁，这时候我就会想，思琪，她真的爱过，她的爱只是失禁了。”。",
  "uiIdx": "",
  "range": "4631-4655",
  "chapterUid": 20
 },
 {
  "level": 4,
  "text": "怡婷对伊纹姐姐说：“忍耐不是美德，把忍耐当成美德是这个伪善的世界维持它扭曲的秩序的方式，生气才是美德。怡婷，你可以写一本生气的书，你想想，能看到你的书的人是多么幸运，他们不用接触，就可以看到世界的背面。”。",
  "uiIdx": "",
  "range": "7407-7449",
  "chapterUid": 20
 },
 {
  "level": 2,
  "text": "圆桌上的对话和背后的含义",
  "uiIdx": "5",
  "range": "9076-9114",
  "chapterUid": 20
 },
 {
  "level": 3,
  "text": "圆桌上的对话充满了欢乐和调笑，但背后隐藏着对年轻一代的担忧和期待",
  "uiIdx": "5.1",
  "range": "9076-9114",
  "chapterUid": 20
 },
 {
  "level": 4,
  "text": "张先生在桌上也不顾礼数，伸长筷子把合菜里的蔬菜拨开，挑了肉便夹进太太的碗里。刘妈妈一看，马上高声说话，一边用手肘挤弄丈夫：“你看人家张先生，结婚这么久还这么宠太太。”。",
  "uiIdx": "",
  "range": "9076-9188",
  "chapterUid": 20
 },
 {
  "level": 4,
  "text": "大家笑得酒杯七歪八倒。陈太太说：“你看看，这是什么啊？这就是年轻人说的，说的什么啊？”。",
  "uiIdx": "",
  "range": "9309-9381",
  "chapterUid": 20
 },
 {
  "level": 4,
  "text": "李老师接话：“放闪！”。吴奶奶笑出更多皱纹：“还是当老师最好，每天跟年轻人在一起，都变年轻了。”。",
  "uiIdx": "",
  "range": "9450-9486",
  "chapterUid": 20
 },
 {
  "level": 4,
  "text": "陈太太说：“小孩一个一个长大了，赶得我们想不老都不行。”。谢先生问：“晞晞今天怎么没有来？”。",
  "uiIdx": "",
  "range": "9515-9589",
  "chapterUid": 20
 },
 {
  "level": 4,
  "text": "李师母跟熟人在一起很放松，她说：“晞晞说要到同学家写功课。每次去那个同学家，回来都大包小包的。我看她功课是在百货公司写的！”。",
  "uiIdx": "",
  "range": "9618-9665",
  "chapterUid": 20
 },
 {
  "level": 4,
  "text": "又嗔了一下李老师：“都是他太宠！”。张太太笑说：“女孩子把零用钱花在自己身上，总比花在男朋友身上好。”。",
  "uiIdx": "",
  "range": "9709-9788",
  "chapterUid": 20
 },
 {
  "level": 4,
  "text": "李老师听着，只是露出哀戚的神气，缓缓地点头。",
  "uiIdx": "",
  "range": "10979-11001",
  "chapterUid": 20
 },
 {
  "level": 4,
  "text": "陈太太伸长手指，指头上箍的祖母绿也透着一丝玄机，她大声说：“哎呀，师母，不好了，张太太跟老师有秘密！”。",
  "uiIdx": "",
  "range": "11030-11081",
  "chapterUid": 20
 },
 {
  "level": 4,
  "text": "老钱先生说：“这张桌上不能有秘密。”。张先生笑着打圆场说：“我太太刚刚在问老师意见，问我们现在再生一个，配你们小钱先生，不知道来得及来不及？”。",
  "uiIdx": "",
  "range": "11110-11209",
  "chapterUid": 20
 },
 {
  "level": 4,
  "text": "也只有张先生敢开老钱一家玩笑。老钱太太大叫：“哎哟，这不是放闪了，自己想跟太太生孩子，就算到一维头上！”。",
  "uiIdx": "",
  "range": "11238-11319",
  "chapterUid": 20
 },
 {
  "level": 4,
  "text": "先生太太们全尖声大笑。红酒洒了出来，在白桌巾上渐渐晕开，桌巾也羞涩不已的样子。",
  "uiIdx": "",
  "range": "11348-11387",
  "chapterUid": 20
 },
 {
  "level": 3,
  "text": "圆桌上的对话反映了人们对年轻一代的担忧和期待，他们希望年轻人能够有自己的生活，有自己的追求，而不是沉迷于物质和享乐",
  "uiIdx": "5.2",
  "range": "10250-10296",
  "chapterUid": 20
 },
 {
  "level": 4,
  "text": "吴奶奶的皱纹仿佛有一种权威性，她清清嗓子说：“以前看怡婷她们，倒不像是会轻易喜欢人的类型。”。",
  "uiIdx": "",
  "range": "10250-10296",
  "chapterUid": 20
 },
 {
  "level": 4,
  "text": "刘妈妈高声说：“我们家那个呀，等于是嫁掉了，才上大学，我还以为她去火星了！连节日都不回家。”。",
  "uiIdx": "",
  "range": "9887-9923",
  "chapterUid": 20
 },
 {
  "level": 4,
  "text": "吴奶奶环顾四周，大笑着说：“坐个电梯能错过多少事情呢？”。",
  "uiIdx": "",
  "range": "10773-10801",
  "chapterUid": 20
 },
 {
  "level": 4,
  "text": "大家都笑了。张太太把手围在李老师耳边，悄声说：“我就说不要给小孩子读文学嘛，你看读到发疯了这真是，连我，连我都宁愿看连续剧也不要看原著小说，要像你这样强壮才能读文啊，你说是不是啊？”。",
  "uiIdx": "",
  "range": "10865-10950",
  "chapterUid": 20
 },
 {
  "level": 4,
  "text": "李老师听着，只是露出哀戚的神气，缓缓地点头。",
  "uiIdx": "",
  "range": "10979-11001",
  "chapterUid": 20
 },
 {
  "level": 4,
  "text": "陈太太伸长手指，指头上箍的祖母绿也透着一丝玄机，她大声说：“哎呀，师母，不好了，张太太跟老师有秘密！”。",
  "uiIdx": "",
  "range": "11030-11081",
  "chapterUid": 20
 },
 {
  "level": 4,
  "text": "老钱先生说：“这张桌上不能有秘密。”。张先生笑着打圆场说：“我太太刚刚在问老师意见，问我们现在再生一个，配你们小钱先生，不知道来得及来不及？”。",
  "uiIdx": "",
  "range": "11110-11209",
  "chapterUid": 20
 },
 {
  "level": 4,
  "text": "也只有张先生敢开老钱一家玩笑。老钱太太大叫：“哎哟，这不是放闪了，自己想跟太太生孩子，就算到一维头上！”。",
  "uiIdx": "",
  "range": "11238-11319",
  "chapterUid": 20
 },
 {
  "level": 4,
  "text": "先生太太们全尖声大笑。红酒洒了出来，在白桌巾上渐渐晕开，桌巾也羞涩不已的样子。",
  "uiIdx": "",
  "range": "11348-11387",
  "chapterUid": 20
 },
 {
  "level": 1,
  "text": "林奕含婚礼致辞",
  "uiIdx": "",
  "range": "",
  "chapterUid": 22
 },
 {
  "level": 2,
  "text": "林奕含的抑郁症经历",
  "uiIdx": "1",
  "range": "882-918",
  "chapterUid": 22
 },
 {
  "level": 3,
  "text": "林奕含从高中二年级开始与重度抑郁症共生",
  "uiIdx": "1.1",
  "range": "882-918",
  "chapterUid": 22
 },
 {
  "level": 4,
  "text": "林奕含失去了“快乐”这个能力，就像有人失去了他的眼睛，然后再也拿不回来一样。",
  "uiIdx": "",
  "range": "882-918",
  "chapterUid": 22
 },
 {
  "level": 3,
  "text": "林奕含的抑郁症症状包括哭泣、暴躁、自残、幻觉、幻听、解离和自杀",
  "uiIdx": "1.2",
  "range": "1026-1051",
  "chapterUid": 22
 },
 {
  "level": 4,
  "text": "林奕含常常会哭泣，然后脾气变得非常暴躁，然后她会自残。",
  "uiIdx": "",
  "range": "1026-1051",
  "chapterUid": 22
 },
 {
  "level": 4,
  "text": "林奕含会幻觉，会幻听，会解离，然后她自杀很多次，进过加护病房或是精神病房。",
  "uiIdx": "",
  "range": "1097-1134",
  "chapterUid": 22
 },
 {
  "level": 2,
  "text": "精神病污名化的问题",
  "uiIdx": "2",
  "range": "1210-1282",
  "chapterUid": 22
 },
 {
  "level": 3,
  "text": "林奕含质疑为什么台南人要在台北治疗疾病",
  "uiIdx": "2.1",
  "range": "1210-1282",
  "chapterUid": 22
 },
 {
  "level": 4,
  "text": "林奕含在台南生病，但是为什么每一个人都告诉她，我要到一个没有人认识我的地方去治疗我的疾病？",
  "uiIdx": "",
  "range": "1210-1282",
  "chapterUid": 22
 },
 {
  "level": 3,
  "text": "林奕含认为社会对精神疾患者的期待是衣衫褴褛、口齿不清，然后六十天没有洗澡去找他，他就会相信我真的有精神病",
  "uiIdx": "2.2",
  "range": "2534-2576",
  "chapterUid": 22
 },
 {
  "level": 4,
  "text": "林奕含想问的是，他是用什么东西来诊断我？是用我的坐姿、我的洋装、我的唇膏，或是我的口齿来诊断我吗？",
  "uiIdx": "",
  "range": "2441-2490",
  "chapterUid": 22
 },
 {
  "level": 4,
  "text": "这个社会对精神疾患者的想象是什么？或我们说得难听一点，这个社会对精神疾患者的期待是什么？是不是我今天衣衫褴褛、口齿不清，然后六十天没有洗澡去找他，他就会相信我真的有精神病？又或者他觉得精神病根本不是病呢？",
  "uiIdx": "",
  "range": "2490-2592",
  "chapterUid": 22
 },
 {
  "level": 2,
  "text": "林奕含对婚姻的看法",
  "uiIdx": "3",
  "range": "4494-4514",
  "chapterUid": 22
 },
 {
  "level": 3,
  "text": "林奕含认为婚姻是平等的，她愿意成为他老婆，但她不是他“的”老婆",
  "uiIdx": "3.1",
  "range": "4494-4514",
  "chapterUid": 22
 },
 {
  "level": 4,
  "text": "林奕含说，我愿意成为他老婆，但我不是他“的”老婆。",
  "uiIdx": "",
  "range": "4494-4514",
  "chapterUid": 22
 },
 {
  "level": 4,
  "text": "林奕含说，我坐享他的爱，但是我不会把他视为理所当然。",
  "uiIdx": "",
  "range": "4514-4535",
  "chapterUid": 22
 },
 {
  "level": 3,
  "text": "林奕含希望成为一个对他人痛苦有更多想象力的人，可以让无论有钱或没有钱的人都毫无顾忌地去看病，可以实质上帮助精神病去污名化",
  "uiIdx": "3.2",
  "range": "4972-5082",
  "chapterUid": 22
 },
 {
  "level": 4,
  "text": "林奕含说，我想成为一个对他人的痛苦有更多想象力的人。",
  "uiIdx": "",
  "range": "4972-5082",
  "chapterUid": 22
 },
 {
  "level": 4,
  "text": "林奕含说，我想要成为可以告诉那些恨不得得精神病的孩子这种愿望是不对的那种人。",
  "uiIdx": "",
  "range": "4972-5082",
  "chapterUid": 22
 },
 {
  "level": 4,
  "text": "林奕含说，我想要成为可以让无论有钱或没有钱的人都毫无顾忌地去看病的那种人。",
  "uiIdx": "",
  "range": "4972-5082",
  "chapterUid": 22
 },
 {
  "level": 4,
  "text": "林奕含说，我想要成为可以实质上帮助精神病去污名化的那种人。",
  "uiIdx": "",
  "range": "4972-5082",
  "chapterUid": 22
 }
]