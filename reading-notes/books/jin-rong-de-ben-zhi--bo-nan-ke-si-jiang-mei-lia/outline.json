[
 {
  "level": 1,
  "text": "央行是什么？",
  "uiIdx": "",
  "range": "",
  "chapterUid": 4
 },
 {
  "level": 2,
  "text": "中央银行的定义和职能",
  "uiIdx": "1",
  "range": "1136-1195",
  "chapterUid": 4
 },
 {
  "level": 3,
  "text": "中央银行是政府机构，处于一个国家货币和金融体系的核心",
  "uiIdx": "1.1",
  "range": "1136-1195",
  "chapterUid": 4
 },
 {
  "level": 4,
  "text": "中央银行引导了现代货币及金融体系的发展，并在经济政策制定中发挥重要作用。",
  "uiIdx": "",
  "range": "1195-1241",
  "chapterUid": 4
 },
 {
  "level": 3,
  "text": "中央银行的职能是维持宏观经济稳定和金融稳定",
  "uiIdx": "1.2",
  "range": "1501-1563",
  "chapterUid": 4
 },
 {
  "level": 4,
  "text": "宏观经济稳定是指追求经济稳定增长，避免大幅波动，并维持稳定的低通胀。",
  "uiIdx": "",
  "range": "1501-1563",
  "chapterUid": 4
 },
 {
  "level": 4,
  "text": "金融稳定是指中央银行要尽可能地保证金融系统的正常运作，尤其是要尽可能防止金融恐慌，避免发生金融危机。",
  "uiIdx": "",
  "range": "1598-1642",
  "chapterUid": 4
 },
 {
  "level": 2,
  "text": "金融恐慌的定义和影响",
  "uiIdx": "2",
  "range": "3076-3103",
  "chapterUid": 4
 },
 {
  "level": 3,
  "text": "金融恐慌是由大家对金融机构失去信心而引起的",
  "uiIdx": "2.1",
  "range": "3076-3103",
  "chapterUid": 4
 },
 {
  "level": 4,
  "text": "金融恐慌的典型例子是银行挤兑，即储户因担心银行倒闭而纷纷前往银行提取存款。",
  "uiIdx": "",
  "range": "3885-3960",
  "chapterUid": 4
 },
 {
  "level": 3,
  "text": "金融恐慌会导致银行倒闭，银行业恐慌常常会蔓延到其他市场",
  "uiIdx": "2.2",
  "range": "3960-4017",
  "chapterUid": 4
 },
 {
  "level": 4,
  "text": "在联邦存款保险公司成立之前，有时银行为了应对恐慌或挤兑会拒绝储户提款，限制储户取款会产生负面影响，也会给那些需要支付工资或需要买东西的人带来麻烦。",
  "uiIdx": "",
  "range": "3960-4055",
  "chapterUid": 4
 },
 {
  "level": 4,
  "text": "不只是许多银行会倒闭，更为严重的是，银行业恐慌常常会蔓延到其他市场，例如常常伴随而来的是股市崩盘。",
  "uiIdx": "",
  "range": "4055-4104",
  "chapterUid": 4
 },
 {
  "level": 2,
  "text": "美联储的成立背景和职能",
  "uiIdx": "3",
  "range": "5417-5454",
  "chapterUid": 4
 },
 {
  "level": 3,
  "text": "美联储成立于1913年，出于对宏观经济和金融稳定性的考虑",
  "uiIdx": "3.1",
  "range": "5417-5454",
  "chapterUid": 4
 },
 {
  "level": 4,
  "text": "南北战争过后直到20世纪初期，美国还没有成立央行。",
  "uiIdx": "",
  "range": "5454-5479",
  "chapterUid": 4
 },
 {
  "level": 4,
  "text": "当财政部不能行使稳定金融系统的职能时，这种职能只能由私营企业完成。",
  "uiIdx": "",
  "range": "5479-5515",
  "chapterUid": 4
 },
 {
  "level": 3,
  "text": "美联储有两项任务：一是行使最后贷款人职能，二是管理金本位制",
  "uiIdx": "3.2",
  "range": "9877-9920",
  "chapterUid": 4
 },
 {
  "level": 4,
  "text": "新成立的美联储有两项任务：一是行使最后贷款人职能，努力缓解银行体系每隔几年就要经历的恐慌；二是管理金本位制，取消金本位制对币值的严格限定，避免利率和其他宏观经济指标的大幅波动。",
  "uiIdx": "",
  "range": "9821-9920",
  "chapterUid": 4
 },
 {
  "level": 2,
  "text": "金本位制的利弊",
  "uiIdx": "4",
  "range": "6850-6858",
  "chapterUid": 4
 },
 {
  "level": 3,
  "text": "金本位制能维持币值的稳定，但会导致许多更严重的金融及经济问题",
  "uiIdx": "4.1",
  "range": "7198-7243",
  "chapterUid": 4
 },
 {
  "level": 4,
  "text": "金本位制造成了极大的资源浪费，你需要开采数以吨计的黄金，然后运到纽约美联储的地下室。",
  "uiIdx": "",
  "range": "7198-7243",
  "chapterUid": 4
 },
 {
  "level": 4,
  "text": "金本位制对货币供给的影响，由于金本位制决定了货币供给，央行通过货币政策调控来稳定经济的作为空间就会受到限制。",
  "uiIdx": "",
  "range": "7367-7424",
  "chapterUid": 4
 },
 {
  "level": 4,
  "text": "金本位制还存在其他问题，比如，它会导致实施金本位制的各国货币之间形成一个固定汇率体系。",
  "uiIdx": "",
  "range": "7656-7687",
  "chapterUid": 4
 },
 {
  "level": 4,
  "text": "金本位制的另一个问题是投机冲击。",
  "uiIdx": "",
  "range": "8203-8219",
  "chapterUid": 4
 },
 {
  "level": 4,
  "text": "金本位制的优点之一是能维持币值的稳定，它能让通货膨胀水平保持稳定——长期来看确实如此。但是短期来看(差不多5年或10年内)，你会发现，金本位制下的通货膨胀(物价上涨)或通货紧缩(物价下跌)现象经常发生。",
  "uiIdx": "",
  "range": "8767-8909",
  "chapterUid": 4
 },
 {
  "level": 2,
  "text": "美联储的第一次大挑战：1929年大萧条",
  "uiIdx": "5",
  "range": "11174-11203",
  "chapterUid": 4
 },
 {
  "level": 3,
  "text": "“大萧条”是美联储面临的第一次重大挑战，美国股市在10月29日崩溃",
  "uiIdx": "5.1",
  "range": "11174-11203",
  "chapterUid": 4
 },
 {
  "level": 4,
  "text": "1929年的大崩盘只是一个开始，之后股价还经历了更为严重的下跌。",
  "uiIdx": "",
  "range": "11858-11905",
  "chapterUid": 4
 },
 {
  "level": 4,
  "text": "实体经济，即非金融经济，在这次“大萧条”中同样受到了很大冲击。",
  "uiIdx": "",
  "range": "12002-12033",
  "chapterUid": 4
 },
 {
  "level": 4,
  "text": "随着经济的萎缩，失业率飙升。",
  "uiIdx": "",
  "range": "13043-13057",
  "chapterUid": 4
 },
 {
  "level": 4,
  "text": "在经济一团糟的情况下，大量储户到银行挤兑，许多银行因而倒闭。",
  "uiIdx": "",
  "range": "13577-13616",
  "chapterUid": 4
 },
 {
  "level": 3,
  "text": "美联储在应对“大萧条”时，无论是在货币政策还是在金融稳定方面都表现得不尽如人意",
  "uiIdx": "5.2",
  "range": "14641-14689",
  "chapterUid": 4
 },
 {
  "level": 4,
  "text": "美联储没有如我们所期盼的那样在这个严重萧条的时期放松货币政策。",
  "uiIdx": "",
  "range": "14689-14728",
  "chapterUid": 4
 },
 {
  "level": 4,
  "text": "美联储的另一项职能是充当最后贷款人，然而它也没有履行这一使命。",
  "uiIdx": "",
  "range": "15253-15284",
  "chapterUid": 4
 },
 {
  "level": 3,
  "text": "罗斯福总统上台执政，肩负起应对“大萧条”的重任，采取了一系列措施",
  "uiIdx": "5.3",
  "range": "15638-15671",
  "chapterUid": 4
 },
 {
  "level": 4,
  "text": "罗斯福于1934年建立了联邦存款保险公司。",
  "uiIdx": "",
  "range": "15811-15834",
  "chapterUid": 4
 },
 {
  "level": 4,
  "text": "罗斯福做的另一件事就是废除了金本位制。",
  "uiIdx": "",
  "range": "15927-15946",
  "chapterUid": 4
 },
 {
  "level": 2,
  "text": "对话",
  "uiIdx": "6",
  "range": "16388-16390",
  "chapterUid": 4
 },
 {
  "level": 3,
  "text": "学生提问：美联储是否应该采取其他措施，比如提高保证金要求，来防止市场投机？",
  "uiIdx": "6.1",
  "range": "16528-16584",
  "chapterUid": 4
 },
 {
  "level": 4,
  "text": "伯南克回答：有证据表明，当时美国股市溢价过高，美联储对此非常担忧。它只想着通过提高利率来应对，而没有考虑到会对经济产生多大的影响。",
  "uiIdx": "",
  "range": "16683-16742",
  "chapterUid": 4
 },
 {
  "level": 4,
  "text": "我认为美联储若要应对当时的股市投机，应首先从银行贷款、金融监管和交易所运行这几个方面着手。",
  "uiIdx": "",
  "range": "16996-17044",
  "chapterUid": 4
 },
 {
  "level": 3,
  "text": "学生提问：回归金本位制还有可能吗？",
  "uiIdx": "6.2",
  "range": "17217-17229",
  "chapterUid": 4
 },
 {
  "level": 4,
  "text": "伯南克回答：无论从实践还是从政策角度来看，金本位制都不可行。",
  "uiIdx": "",
  "range": "17599-17629",
  "chapterUid": 4
 },
 {
  "level": 4,
  "text": "黄金总量不足以支持整个国际金本位体系，而要获得足量黄金，代价也是很高昂的。",
  "uiIdx": "",
  "range": "17629-17683",
  "chapterUid": 4
 },
 {
  "level": 4,
  "text": "世界环境已经发生了改变，承诺保持金本位制就意味着，无论在何种情况下，无论失业情况变得多糟糕，央行都不会采取任何货币政策进行干预。",
  "uiIdx": "",
  "range": "17930-17991",
  "chapterUid": 4
 },
 {
  "level": 3,
  "text": "学生提问：我们应该注意哪些曾在“大萧条”期间犯过，而如今应当予以规避的错误？",
  "uiIdx": "6.3",
  "range": "18474-18519",
  "chapterUid": 4
 },
 {
  "level": 4,
  "text": "伯南克回答：二次经济衰退是由过早收紧的货币和财政政策所致。",
  "uiIdx": "",
  "range": "18745-18798",
  "chapterUid": 4
 },
 {
  "level": 4,
  "text": "如果你接受这种传统的解释，那你需要仔细观察经济运行处于哪个环节，是否过快改变了那些有利于经济复苏的政策。",
  "uiIdx": "",
  "range": "18914-18966",
  "chapterUid": 4
 },
 {
  "level": 3,
  "text": "学生提问：在经济萧条发生5年后，失业率仍保持在很高的水平这一现象正常吗？",
  "uiIdx": "6.4",
  "range": "19171-19205",
  "chapterUid": 4
 },
 {
  "level": 4,
  "text": "伯南克回答：“大萧条”是一次非同寻常的事件。19世纪也曾经历过多次严重的经济下滑，但是没有一次像“大萧条”那样严重。",
  "uiIdx": "",
  "range": "19294-19377",
  "chapterUid": 4
 },
 {
  "level": 4,
  "text": "从1929年一直持续到“二战”的高失业率是不正常的，因此我们不能下结论认为这是种常态。",
  "uiIdx": "",
  "range": "19377-19420",
  "chapterUid": 4
 },
 {
  "level": 3,
  "text": "学生提问：为什么没有更多的全球性合作，为什么各国央行没有采取合作，形成一个统一的修复方式，而是仍然各自为政呢？",
  "uiIdx": "6.5",
  "range": "19768-19867",
  "chapterUid": 4
 },
 {
  "level": 4,
  "text": "伯南克回答：美联储和多国央行已经采取了合作，而且合作仍将持续。",
  "uiIdx": "",
  "range": "19924-19980",
  "chapterUid": 4
 },
 {
  "level": 4,
  "text": "“大萧条”的问题之一是“一战”遗留下来的不良情绪。",
  "uiIdx": "",
  "range": "19980-20005",
  "chapterUid": 4
 },
 {
  "level": 4,
  "text": "今天汇率制度是灵活的，汇率是可以调整的，这可使其他国家免受一国货币政策的影响，从而在某种程度上减少了央行国际合作的需求，但我仍然认为这种合作是非常必要的。",
  "uiIdx": "",
  "range": "20111-20142",
  "chapterUid": 4
 },
 {
  "level": 1,
  "text": "货币政策与通货膨胀",
  "uiIdx": "",
  "range": "",
  "chapterUid": 6
 },
 {
  "level": 2,
  "text": "中央银行的两大基本职能",
  "uiIdx": "1",
  "range": "424-450",
  "chapterUid": 6
 },
 {
  "level": 3,
  "text": "保持宏观经济稳定，即维持经济的平稳增长和低通胀",
  "uiIdx": "1.1",
  "range": "424-450",
  "chapterUid": 6
 },
 {
  "level": 4,
  "text": "维持宏观经济稳定的主要工具是货币政策。",
  "uiIdx": "",
  "range": "450-470",
  "chapterUid": 6
 },
 {
  "level": 3,
  "text": "维持金融稳定，确保金融系统运转正常，防止出现金融危机或金融恐慌",
  "uiIdx": "1.2",
  "range": "577-636",
  "chapterUid": 6
 },
 {
  "level": 4,
  "text": "在发生金融恐慌时，中央银行应遵循白芝浩原则，即央行应当在惩罚性利率的基础上，允许自由放贷给有优质抵押品的金融机构，同时通过向金融机构提供短期贷款来防止或减少恐慌以及对金融系统和整体经济的损害。",
  "uiIdx": "",
  "range": "577-750",
  "chapterUid": 6
 },
 {
  "level": 2,
  "text": "货币政策与通货膨胀的关系",
  "uiIdx": "2",
  "range": "783-792",
  "chapterUid": 6
 },
 {
  "level": 3,
  "text": "长期维持低利率可能会造成经济过热和通货膨胀",
  "uiIdx": "2.1",
  "range": "837-884",
  "chapterUid": 6
 },
 {
  "level": 4,
  "text": "“二战”期间，美国通过发行大量国债来为战争埋单。美联储和美国财政部合作，利用自身管理利率的职能，使利率保持在低位，从而帮助美国政府以较低的成本来为“二战”筹资。",
  "uiIdx": "",
  "range": "837-884",
  "chapterUid": 6
 },
 {
  "level": 4,
  "text": "战争结束后，债台高筑的美国政府为如何偿还这些高昂的国债利息而忧心忡忡。因此，即使战争已经结束，美联储仍面临着维持低利率的巨大压力。",
  "uiIdx": "",
  "range": "1055-1120",
  "chapterUid": 6
 },
 {
  "level": 3,
  "text": "货币政策制定者变得过于乐观，认为经济过热并不会导致通货膨胀",
  "uiIdx": "2.2",
  "range": "2619-2658",
  "chapterUid": 6
 },
 {
  "level": 4,
  "text": "在经济繁荣的20世纪50年代和60年代初期，美联储开始遵循这一做法。",
  "uiIdx": "",
  "range": "2702-2739",
  "chapterUid": 6
 },
 {
  "level": 4,
  "text": "提高通货膨胀率可能会降低失业率，但只是暂时会起到效果。提高通货膨胀率就好比吃糖：你吃了一块糖，在短期内它能给你充沛的能量，但过了一段时间，它只会让你发胖。",
  "uiIdx": "",
  "range": "2923-3004",
  "chapterUid": 6
 },
 {
  "level": 3,
  "text": "通货膨胀无论在何时何地都是一个货币现象",
  "uiIdx": "2.3",
  "range": "3208-3236",
  "chapterUid": 6
 },
 {
  "level": 4,
  "text": "如果没有过于宽松的货币政策，也就不会出现持续的通货膨胀。",
  "uiIdx": "",
  "range": "3208-3236",
  "chapterUid": 6
 },
 {
  "level": 4,
  "text": "一些因素加剧了问题的恶化，也使得美联储抵御通胀的行动变得更加困难。首先，石油和食品的价格受到了一系列的冲击。一个非常明显的例子发生在1973年。当年10月，赎罪日战争在中东爆发，为报复美国支持以色列，石油输出国组织利用其垄断权力禁止石油出口。",
  "uiIdx": "",
  "range": "3281-3338",
  "chapterUid": 6
 },
 {
  "level": 2,
  "text": "经济“大缓和”时期的到来",
  "uiIdx": "3",
  "range": "6380-6389",
  "chapterUid": 6
 },
 {
  "level": 3,
  "text": "20世纪80年代中期到2006年间，经济变得更加稳定",
  "uiIdx": "3.1",
  "range": "7357-7393",
  "chapterUid": 6
 },
 {
  "level": 4,
  "text": "不仅实际GDP在此期间增长稳定，通货膨胀也保持稳定水平。",
  "uiIdx": "",
  "range": "7357-7393",
  "chapterUid": 6
 },
 {
  "level": 3,
  "text": "货币政策在其中发挥了作用",
  "uiIdx": "3.2",
  "range": "8060-8185",
  "chapterUid": 6
 },
 {
  "level": 4,
  "text": "特别是，沃尔克在20世纪80年代早期降低通货膨胀的努力，虽然导致了严重的经济衰退和大量的短期阵痛，但至少带来了一个回报，那就是经济更加稳定，包括稳定的低通胀率、更加稳定的货币政策以及企业主和家庭对政府更加信任——这对于建立更广泛的稳定性而言意义重大。",
  "uiIdx": "",
  "range": "8060-8185",
  "chapterUid": 6
 },
 {
  "level": 3,
  "text": "经济结构的转型也是原因之一",
  "uiIdx": "3.3",
  "range": "8466-8495",
  "chapterUid": 6
 },
 {
  "level": 4,
  "text": "比如，企业在发展过程中学会了如何更加有效地管理自己的库存。",
  "uiIdx": "",
  "range": "8466-8495",
  "chapterUid": 6
 },
 {
  "level": 4,
  "text": "还有可能是运气变好了，比如石油价格冲击减小等也促进了此次“大缓和”。",
  "uiIdx": "",
  "range": "8659-8693",
  "chapterUid": 6
 },
 {
  "level": 2,
  "text": "金融危机的前奏",
  "uiIdx": "4",
  "range": "8993-9000",
  "chapterUid": 6
 },
 {
  "level": 3,
  "text": "房价的大幅上涨是导致此次危机的一个关键事件",
  "uiIdx": "4.1",
  "range": "9046-9070",
  "chapterUid": 6
 },
 {
  "level": 4,
  "text": "从20世纪90年代末到2006年初，全美房价上涨了约130%。",
  "uiIdx": "",
  "range": "9110-9141",
  "chapterUid": 6
 },
 {
  "level": 3,
  "text": "新增住房抵押贷款标准的破坏，使得越来越多的人进入房地产市场",
  "uiIdx": "4.2",
  "range": "9442-9494",
  "chapterUid": 6
 },
 {
  "level": 4,
  "text": "新的抵押贷款承销标准变得越来越低，这反过来使越来越多的人进入房地产市场，从而进一步推高了价格。",
  "uiIdx": "",
  "range": "9442-9494",
  "chapterUid": 6
 },
 {
  "level": 3,
  "text": "抵押贷款质量恶化，许多银行开始把款贷给资质较差的借款人",
  "uiIdx": "4.3",
  "range": "9990-10213",
  "chapterUid": 6
 },
 {
  "level": 4,
  "text": "大约1/3的贷款是非优质抵押贷款。",
  "uiIdx": "",
  "range": "10390-10407",
  "chapterUid": 6
 },
 {
  "level": 4,
  "text": "截至2007年，60%的非优质抵押贷款关于借款人信誉的文件证明没有或不全。",
  "uiIdx": "",
  "range": "11261-11324",
  "chapterUid": 6
 },
 {
  "level": 2,
  "text": "房地产泡沫的破灭",
  "uiIdx": "5",
  "range": "12533-12541",
  "chapterUid": 6
 },
 {
  "level": 3,
  "text": "房价崩盘造成了一系列严重的后果",
  "uiIdx": "5.1",
  "range": "12571-12587",
  "chapterUid": 6
 },
 {
  "level": 4,
  "text": "很多人因为他们的房子价格上涨、手上有很多股票而觉得自己非常富有，但突然发现房价和股票都缩水了，这意味着他们抵押贷款欠的钱已经大大超过了房屋的价值。",
  "uiIdx": "",
  "range": "12587-12667",
  "chapterUid": 6
 },
 {
  "level": 4,
  "text": "由于许多人的债务已经超出其还款能力范围，房价的下跌也会导致住房抵押贷款拖欠率显著上升，债务人未能按时还本付息，最终银行接管了他们的房产并转售给他人，也就是说债务人丧失了抵押品赎回权。",
  "uiIdx": "",
  "range": "13219-13313",
  "chapterUid": 6
 },
 {
  "level": 3,
  "text": "房价暴跌和住房抵押贷款受损点燃了导火索，但星星之火想要燎原还需“借东风”",
  "uiIdx": "5.2",
  "range": "14329-14387",
  "chapterUid": 6
 },
 {
  "level": 4,
  "text": "这借的“东风”就是经济和金融体系的漏洞。",
  "uiIdx": "",
  "range": "14329-14387",
  "chapterUid": 6
 },
 {
  "level": 2,
  "text": "对话",
  "uiIdx": "6",
  "range": "20214-20292",
  "chapterUid": 6
 },
 {
  "level": 3,
  "text": "找到恰当时机收紧或者放松政策的确很有挑战性",
  "uiIdx": "6.1",
  "range": "20214-20292",
  "chapterUid": 6
 },
 {
  "level": 4,
  "text": "预测并不是非常准确，所以我们需要持续观察现状并适时做出调整。",
  "uiIdx": "",
  "range": "20292-20322",
  "chapterUid": 6
 },
 {
  "level": 3,
  "text": "货币政策对房价的上扬没有起到关键作用",
  "uiIdx": "6.2",
  "range": "16695-16719",
  "chapterUid": 6
 },
 {
  "level": 4,
  "text": "利率和住房抵押贷款利率的变化确实能影响房价和房产需求，但是如果你关注包括住房抵押贷款利率在内的利率的变化幅度和房价变动的幅度，基于历史数据分析两者的关系，就会发现房价上涨只有一小部分可以用利率变动来解释。",
  "uiIdx": "",
  "range": "17043-17157",
  "chapterUid": 6
 },
 {
  "level": 3,
  "text": "我们想要达到的是经济整体更加均衡",
  "uiIdx": "6.3",
  "range": "21657-21730",
  "chapterUid": 6
 },
 {
  "level": 4,
  "text": "所以货币政策既会刺激资本形成，也会促进出口。",
  "uiIdx": "",
  "range": "21657-21730",
  "chapterUid": 6
 },
 {
  "level": 3,
  "text": "透明度是非常重要的",
  "uiIdx": "6.4",
  "range": "24035-24056",
  "chapterUid": 6
 },
 {
  "level": 4,
  "text": "中央银行保持独立性的重要性，与此也有关系。如果中央银行是独立的并且在制定与每个人都息息相关的政策，那它必须为此承担解释责任。",
  "uiIdx": "",
  "range": "24035-24097",
  "chapterUid": 6
 },
 {
  "level": 1,
  "text": "金融体系的漏洞",
  "uiIdx": "",
  "range": "",
  "chapterUid": 8
 },
 {
  "level": 2,
  "text": "金融体系的漏洞",
  "uiIdx": "1",
  "range": "725-732",
  "chapterUid": 8
 },
 {
  "level": 3,
  "text": "私人部门的漏洞包括过度负债、银行部门风险监管缺失、对短期流动性供给的过度依赖以及奇异金融工具的使用",
  "uiIdx": "1.1",
  "range": "909-992",
  "chapterUid": 8
 },
 {
  "level": 4,
  "text": "过度负债可能由经济“大缓和”造成。",
  "uiIdx": "",
  "range": "870-909",
  "chapterUid": 8
 },
 {
  "level": 4,
  "text": "银行部门对于自身风险监管的缺失，对短期流动性供给的过度依赖。",
  "uiIdx": "",
  "range": "909-992",
  "chapterUid": 8
 },
 {
  "level": 4,
  "text": "奇异金融工具的使用，比如信用违约掉期等金融衍生品，它们会将风险过度集中于某个特定的公司或市场。",
  "uiIdx": "",
  "range": "992-1044",
  "chapterUid": 8
 },
 {
  "level": 3,
  "text": "公共部门的漏洞包括监管机构的缺陷和政府支持型企业“两房”的漏洞",
  "uiIdx": "1.2",
  "range": "1088-1110",
  "chapterUid": 8
 },
 {
  "level": 4,
  "text": "监管机构对于一些较为重要的企业或市场的监管不够充分。",
  "uiIdx": "",
  "range": "1110-1136",
  "chapterUid": 8
 },
 {
  "level": 4,
  "text": "“两房”虽然名义上是私人企业，但它们实际上是经美国国会批准、为支持房地产业的发展而建立起来的政府支持型企业。",
  "uiIdx": "",
  "range": "1380-1445",
  "chapterUid": 8
 },
 {
  "level": 2,
  "text": "金融衍生品的泛滥",
  "uiIdx": "2",
  "range": "2202-2210",
  "chapterUid": 8
 },
 {
  "level": 3,
  "text": "导致金融危机爆发的重要原因不仅仅在于房价的起落，更在于随房价变化而变化的住房抵押贷款产品及相关衍生产品的广泛使用",
  "uiIdx": "2.1",
  "range": "2240-2297",
  "chapterUid": 8
 },
 {
  "level": 4,
  "text": "当时市场上充斥着大量的奇异住房抵押贷款产品，之所以称为“奇异”，是因为它们不是标准化的产品。",
  "uiIdx": "",
  "range": "2297-2372",
  "chapterUid": 8
 },
 {
  "level": 4,
  "text": "大部分劣质的住房抵押贷款都有一个共同的特征，即还款额在最初的几期会低于应还额，但是随着时间的推移，还款额会逐渐上升。",
  "uiIdx": "",
  "range": "3047-3105",
  "chapterUid": 8
 },
 {
  "level": 3,
  "text": "住房抵押贷款证券产品被打包成证券化产品，在市场上销售",
  "uiIdx": "2.2",
  "range": "3958-4034",
  "chapterUid": 8
 },
 {
  "level": 4,
  "text": "有些住房抵押贷款证券产品相对来说比较简单，如果要将住房抵押贷款出售给房利美或者房地美，就必须满足这两家公司的信用证明要求。",
  "uiIdx": "",
  "range": "4063-4124",
  "chapterUid": 8
 },
 {
  "level": 4,
  "text": "现实经济中也存在一些非常复杂且难于理解的证券，比如担保债务凭证。",
  "uiIdx": "",
  "range": "4237-4272",
  "chapterUid": 8
 },
 {
  "level": 2,
  "text": "应对危机的举措",
  "uiIdx": "3",
  "range": "7755-7762",
  "chapterUid": 8
 },
 {
  "level": 3,
  "text": "美联储和联邦政府采取了强有力的政策行动来阻止21世纪初的这次金融恐慌",
  "uiIdx": "3.1",
  "range": "7990-8062",
  "chapterUid": 8
 },
 {
  "level": 4,
  "text": "美联储根据“白芝浩原则”进行自由放贷，以避免银行挤兑，从而稳定金融体系。",
  "uiIdx": "",
  "range": "7824-7919",
  "chapterUid": 8
 },
 {
  "level": 4,
  "text": "美联储以宽松的货币政策来避免经济陷入深度衰退。",
  "uiIdx": "",
  "range": "7919-7990",
  "chapterUid": 8
 },
 {
  "level": 3,
  "text": "国际合作是应对金融危机的重要途径",
  "uiIdx": "3.2",
  "range": "8204-8263",
  "chapterUid": 8
 },
 {
  "level": 4,
  "text": "2008年10月10日，七国集团例行峰会在华盛顿举行，商讨应对金融危机的问题。",
  "uiIdx": "",
  "range": "8204-8263",
  "chapterUid": 8
 },
 {
  "level": 4,
  "text": "在美联储的提议下，会议新拟了一份原则声明，各国将会共同采取措施来避免那些具有系统重要性的金融机构破产。",
  "uiIdx": "",
  "range": "8457-8518",
  "chapterUid": 8
 },
 {
  "level": 3,
  "text": "美联储在应对危机中扮演了至关重要的角色",
  "uiIdx": "3.3",
  "range": "9710-9757",
  "chapterUid": 8
 },
 {
  "level": 4,
  "text": "美联储通过贴现窗口工具为银行提供短期融资。",
  "uiIdx": "",
  "range": "9781-9821",
  "chapterUid": 8
 },
 {
  "level": 4,
  "text": "美联储为货币市场基金提供流动性支持，平息了金融恐慌。",
  "uiIdx": "",
  "range": "13268-13314",
  "chapterUid": 8
 },
 {
  "level": 4,
  "text": "美联储为美国国际集团提供贷款，避免了其破产。",
  "uiIdx": "",
  "range": "15894-15936",
  "chapterUid": 8
 },
 {
  "level": 1,
  "text": "扑灭金融危机之火",
  "uiIdx": "",
  "range": "",
  "chapterUid": 10
 },
 {
  "level": 2,
  "text": "美联储在金融危机中的角色和反应",
  "uiIdx": "1",
  "range": "437-473",
  "chapterUid": 10
 },
 {
  "level": 3,
  "text": "美联储扮演最后贷款人的角色，与其他机构合作，为关键机构提供了短期流动性",
  "uiIdx": "1.1",
  "range": "437-473",
  "chapterUid": 10
 },
 {
  "level": 4,
  "text": "美联储的反应与中央银行的历史角色并无太大差别，都是充当最后贷款人来抑制恐慌。",
  "uiIdx": "",
  "range": "502-577",
  "chapterUid": 10
 },
 {
  "level": 3,
  "text": "美联储与美国其他机构以及境外当局有着密切的协作关系",
  "uiIdx": "1.2",
  "range": "749-775",
  "chapterUid": 10
 },
 {
  "level": 4,
  "text": "美国国会通过了不良资产救助计划立法后，财政部开始介入。",
  "uiIdx": "",
  "range": "775-805",
  "chapterUid": 10
 },
 {
  "level": 4,
  "text": "联邦存款保险公司发挥了重要作用，特别是在取消了对交易账户25万美元的存款保额上限之后。",
  "uiIdx": "",
  "range": "856-899",
  "chapterUid": 10
 },
 {
  "level": 4,
  "text": "美联储还与境外机构保持密切协作，上次我提到货币互换，正是美联储与境外中央银行紧密合作的项目之一。",
  "uiIdx": "",
  "range": "1003-1051",
  "chapterUid": 10
 },
 {
  "level": 2,
  "text": "扑灭金融危机之火的措施",
  "uiIdx": "2",
  "range": "1195-1261",
  "chapterUid": 10
 },
 {
  "level": 3,
  "text": "美联储与其他金融机构合作，在2009年春对美国最主要的19家大型银行进行了压力测试",
  "uiIdx": "2.1",
  "range": "1195-1261",
  "chapterUid": 10
 },
 {
  "level": 4,
  "text": "这是危机最紧张阶段过去后不久，有史以来第一次，我们向市场披露了最主要银行的金融头寸。",
  "uiIdx": "",
  "range": "1261-1304",
  "chapterUid": 10
 },
 {
  "level": 3,
  "text": "美联储采用的主要工具是大规模资产购买计划，即媒体和其他地方所说的量化宽松",
  "uiIdx": "2.2",
  "range": "3655-3691",
  "chapterUid": 10
 },
 {
  "level": 4,
  "text": "为了影响长期利率，美联储开始大规模购买国债和政府支持型企业抵押的相关证券。",
  "uiIdx": "",
  "range": "3766-3803",
  "chapterUid": 10
 },
 {
  "level": 4,
  "text": "两轮计划给美联储的资产负债表增加了两万多亿美元。",
  "uiIdx": "",
  "range": "4026-4053",
  "chapterUid": 10
 },
 {
  "level": 2,
  "text": "政策的指引者",
  "uiIdx": "3",
  "range": "6977-6983",
  "chapterUid": 10
 },
 {
  "level": 3,
  "text": "美联储有双重使命，其中之一是就业最大化，另一个使命是保持物价稳定",
  "uiIdx": "3.1",
  "range": "7013-7091",
  "chapterUid": 10
 },
 {
  "level": 4,
  "text": "我们解读为保持经济增长并最大限度地发挥其能力，而低利率是刺激经济增长、使人们重新就业的一种方式。",
  "uiIdx": "",
  "range": "7013-7091",
  "chapterUid": 10
 },
 {
  "level": 4,
  "text": "在维持低通货膨胀方面我们做得非常成功，这里要特别感谢沃尔克和格林斯潘，他们使我的工作做起来更容易，因为他们已经让市场相信美联储承诺保持低通货膨胀。",
  "uiIdx": "",
  "range": "7091-7189",
  "chapterUid": 10
 },
 {
  "level": 3,
  "text": "美联储做出了很多努力，以使货币政策更加透明，从而确保人们理解我们要达到的目标",
  "uiIdx": "3.2",
  "range": "7979-8018",
  "chapterUid": 10
 },
 {
  "level": 4,
  "text": "例如，在一年四次、每次持续两天的联邦公开市场委员会会议之后，我都会召开一个记者招待会，回答关于货币政策制定的问题。",
  "uiIdx": "",
  "range": "8047-8104",
  "chapterUid": 10
 },
 {
  "level": 4,
  "text": "为了更清晰地传达政策意图，我们近期采取的另外一个举措是对外发表一份描述货币政策基本执行方法的声明。",
  "uiIdx": "",
  "range": "8157-8206",
  "chapterUid": 10
 },
 {
  "level": 4,
  "text": "美联储已经开始为投资者和公众提供指引，即鉴于目前对经济的看法，我们在未来如何调整联邦基金利率。",
  "uiIdx": "",
  "range": "8365-8435",
  "chapterUid": 10
 },
 {
  "level": 2,
  "text": "缓慢复苏",
  "uiIdx": "4",
  "range": "8561-8565",
  "chapterUid": 10
 },
 {
  "level": 3,
  "text": "经济衰退，即严重的经济紧缩时期，正式结束了",
  "uiIdx": "4.1",
  "range": "8595-8617",
  "chapterUid": 10
 },
 {
  "level": 4,
  "text": "国家经济研究局明确定义了这次衰退开始和结束的日期。",
  "uiIdx": "",
  "range": "8617-8642",
  "chapterUid": 10
 },
 {
  "level": 4,
  "text": "当他们说衰退结束的时候，一般并不意味着经济回到常态，而只是意味着经济紧缩停止，经济开始再次增长了。",
  "uiIdx": "",
  "range": "8708-8757",
  "chapterUid": 10
 },
 {
  "level": 3,
  "text": "缓慢复苏还反映在失业率的缓慢下降上",
  "uiIdx": "4.2",
  "range": "9680-9698",
  "chapterUid": 10
 },
 {
  "level": 4,
  "text": "失业率在衰退期急剧上升，到达10%左右的峰值，然后缓慢下落到现在的8.3%左右。",
  "uiIdx": "",
  "range": "9698-9759",
  "chapterUid": 10
 },
 {
  "level": 3,
  "text": "房地产市场复苏很缓慢",
  "uiIdx": "4.3",
  "range": "9816-9842",
  "chapterUid": 10
 },
 {
  "level": 4,
  "text": "房屋建设量自2005年开始急剧下滑。",
  "uiIdx": "",
  "range": "9816-9842",
  "chapterUid": 10
 },
 {
  "level": 4,
  "text": "虽然近两年降幅收窄，但房地产市场仍未恢复。",
  "uiIdx": "",
  "range": "9842-9863",
  "chapterUid": 10
 },
 {
  "level": 2,
  "text": "监管的变化",
  "uiIdx": "5",
  "range": "14991-14996",
  "chapterUid": 10
 },
 {
  "level": 3,
  "text": "2008年之后，美国进行了大量的金融监管改革，其中最为引人瞩目的当属《多德–弗兰克法案》",
  "uiIdx": "5.1",
  "range": "15186-15231",
  "chapterUid": 10
 },
 {
  "level": 4,
  "text": "该法案的正式名称为《华尔街改革与消费者保护法案》，于2010年夏天通过。",
  "uiIdx": "",
  "range": "15231-15267",
  "chapterUid": 10
 },
 {
  "level": 4,
  "text": "它是一套全面的金融改革方案，致力于应对我之前谈到过的诸多漏洞。",
  "uiIdx": "",
  "range": "15267-15298",
  "chapterUid": 10
 },
 {
  "level": 3,
  "text": "《多德–弗兰克法案》的主题之一便是尝试建立一种系统性的方法，以使监管者能够监管整个体系，而不只是某个组成部分",
  "uiIdx": "5.2",
  "range": "15398-15456",
  "chapterUid": 10
 },
 {
  "level": 4,
  "text": "达成上述目标的工具之一是新创建的一个名为“金融稳定监督委员会”(FSOC)的机构，美联储作为成员之一，协调各监管机构。",
  "uiIdx": "",
  "range": "15456-15515",
  "chapterUid": 10
 },
 {
  "level": 3,
  "text": "《多德–弗兰克法案》可使监管机构有责任在实施自身监管、监督举措的同时考虑其隐含的、广泛的系统性影响",
  "uiIdx": "5.3",
  "range": "15592-15645",
  "chapterUid": 10
 },
 {
  "level": 4,
  "text": "尤其是美联储在很大程度上重组了监管部门，使我们现在能以综合的眼光看待整个金融市场和一系列金融机构。",
  "uiIdx": "",
  "range": "15645-15694",
  "chapterUid": 10
 },
 {
  "level": 3,
  "text": "《多德–弗兰克法案》提供了一种让大型机构可以安全倒闭(fail-safe)的机制",
  "uiIdx": "5.4",
  "range": "15821-16010",
  "chapterUid": 10
 },
 {
  "level": 4,
  "text": "对于任何被认为未受充分监督的机构，金融稳定监督委员会均可以通过投票来指定其接受美联储的监督。",
  "uiIdx": "",
  "range": "15821-16010",
  "chapterUid": 10
 },
 {
  "level": 3,
  "text": "解决“大而不倒”的问题，一方面要求将这些大型综合机构置于更为严格的监督之下，比如更多监管、更多资本储备、更多压力测试以及更为严格的业务限制",
  "uiIdx": "5.5",
  "range": "16510-16580",
  "chapterUid": 10
 },
 {
  "level": 4,
  "text": "另一方面就是处理正在破产的机构。",
  "uiIdx": "",
  "range": "16580-16596",
  "chapterUid": 10
 },
 {
  "level": 3,
  "text": "《多德–弗兰克法案》设立了一个名为“消费者金融保护局”的新机构，致力于在金融交易中保护消费者",
  "uiIdx": "5.6",
  "range": "17382-17445",
  "chapterUid": 10
 },
 {
  "level": 4,
  "text": "美联储在抵押贷款的消费者保护领域做得并不尽如人意。",
  "uiIdx": "",
  "range": "17357-17382",
  "chapterUid": 10
 },
 {
  "level": 2,
  "text": "对话",
  "uiIdx": "6",
  "range": "18645-18647",
  "chapterUid": 10
 },
 {
  "level": 3,
  "text": "美联储通过更多的推广活动，比如新闻发布会以及其他途径，试图解释其所作所为",
  "uiIdx": "6.1",
  "range": "19070-19112",
  "chapterUid": 10
 },
 {
  "level": 4,
  "text": "美联储是非常负责的，不仅仅是我，理事会的其他成员以及各位储备银行行长也经常出席作证、发表演讲，也会出席诸多场合，不一而足。",
  "uiIdx": "",
  "range": "19127-19178",
  "chapterUid": 10
 },
 {
  "level": 3,
  "text": "美联储拥有三种不同的工具可供使用，任何一种都允许我们逐步退出上述政策，但综合使用这三种工具能使我们更为放心",
  "uiIdx": "6.2",
  "range": "19626-19712",
  "chapterUid": 10
 },
 {
  "level": 4,
  "text": "首先，我们有能力对银行存放在美联储的准备金付息。",
  "uiIdx": "",
  "range": "19770-19794",
  "chapterUid": 10
 },
 {
  "level": 4,
  "text": "其次，我们拥有的第二个工具即排水工具。",
  "uiIdx": "",
  "range": "19975-19991",
  "chapterUid": 10
 },
 {
  "level": 4,
  "text": "最后，第三个也是最后一个工具是将资产持有至到期，或者将之出售。",
  "uiIdx": "",
  "range": "20106-20134",
  "chapterUid": 10
 },
 {
  "level": 3,
  "text": "目前有一些与之类似的计划，尤其是其中一个由房地美、房利美等政府赞助企业及其监管者联邦住房金融局运作的可偿付再融资计划(HARP)",
  "uiIdx": "6.3",
  "range": "20733-20829",
  "chapterUid": 10
 },
 {
  "level": 4,
  "text": "在该计划中，如果你在抵押贷款上资不抵债，即房屋抵押贷款金额超过了房屋净值，并且抵押贷款由房利美和房地美持有，你也许仍能以较低的利率再融资，以减少月供。",
  "uiIdx": "",
  "range": "20829-20904",
  "chapterUid": 10
 },
 {
  "level": 3,
  "text": "美联储并没有新的货币政策工具，但是我们有利率政策，而且可以继续根据经济前景的变化适时使用相应的货币政策",
  "uiIdx": "6.4",
  "range": "23517-23608",
  "chapterUid": 10
 },
 {
  "level": 4,
  "text": "我们高度关注并且近期有所起色的一系列指标集中在劳动力市场方面的进展：工作数量、失业率、失业救济申请、工作时数，所有的这些指标都显示出劳动力市场正在增强。",
  "uiIdx": "",
  "range": "24073-24152",
  "chapterUid": 10
 },
 {
  "level": 4,
  "text": "正如我在第三讲中所讨论的，如果我们观测到总需求和经济增长水平的上升，劳动力市场的改善更有可能持续下去。",
  "uiIdx": "",
  "range": "24264-24315",
  "chapterUid": 10
 },
 {
  "level": 1,
  "text": "Lecture 1 Origins and Mission of the Federal Reserve",
  "uiIdx": "",
  "range": "",
  "chapterUid": 10
 },
 {
  "level": 2,
  "text": "中央银行的起源和定义",
  "uiIdx": "1",
  "range": "35891-35940",
  "chapterUid": 10
 },
 {
  "level": 3,
  "text": "中央银行是政府机构的组成部分，位于国家货币和金融系统的中心。",
  "uiIdx": "1.1",
  "range": "35891-35940",
  "chapterUid": 10
 },
 {
  "level": 3,
  "text": "中央银行的主要任务是实现宏观经济稳定和维持金融稳定",
  "uiIdx": "1.2",
  "range": "35891-35940",
  "chapterUid": 10
 },
 {
  "level": 4,
  "text": "宏观经济稳定是指实现稳定的经济增长，避免大波动，保持低且稳定的通货膨胀。",
  "uiIdx": "",
  "range": "35891-35940",
  "chapterUid": 10
 },
 {
  "level": 4,
  "text": "金融稳定是指保持金融系统正常工作，特别是防止或减轻金融恐慌或金融危机。",
  "uiIdx": "",
  "range": "35891-35940",
  "chapterUid": 10
 },
 {
  "level": 2,
  "text": "中央银行的工具",
  "uiIdx": "2",
  "range": "35891-35940",
  "chapterUid": 10
 },
 {
  "level": 3,
  "text": "中央银行使用货币政策来实现宏观经济稳定，主要是通过调整短期利率",
  "uiIdx": "2.1",
  "range": "35891-35940",
  "chapterUid": 10
 },
 {
  "level": 4,
  "text": "如果经济增长过慢或通货膨胀过低，中央银行可以通过降低利率来刺激经济。",
  "uiIdx": "",
  "range": "35891-35940",
  "chapterUid": 10
 },
 {
  "level": 4,
  "text": "如果经济增长过热或通货膨胀成为问题，中央银行可以通过提高利率来减缓经济。",
  "uiIdx": "",
  "range": "35891-35940",
  "chapterUid": 10
 },
 {
  "level": 3,
  "text": "中央银行通过提供流动性来处理金融恐慌或金融危机",
  "uiIdx": "2.2",
  "range": "35891-35940",
  "chapterUid": 10
 },
 {
  "level": 4,
  "text": "在恐慌或危机期间，中央银行可以向金融机构提供短期贷款。",
  "uiIdx": "",
  "range": "35891-35940",
  "chapterUid": 10
 },
 {
  "level": 2,
  "text": "美国联邦储备系统",
  "uiIdx": "3",
  "range": "35891-35940",
  "chapterUid": 10
 },
 {
  "level": 3,
  "text": "美国联邦储备系统成立于1914年，旨在作为最后贷款人，并管理金本位",
  "uiIdx": "3.1",
  "range": "35891-35940",
  "chapterUid": 10
 },
 {
  "level": 4,
  "text": "美国在1914年之前没有中央银行，金融稳定功能由财政部执行。",
  "uiIdx": "",
  "range": "35891-35940",
  "chapterUid": 10
 },
 {
  "level": 4,
  "text": "金本位是一种货币体系，其中货币的价值与黄金固定，这有助于设定货币供应和价格水平。",
  "uiIdx": "",
  "range": "35891-35940",
  "chapterUid": 10
 },
 {
  "level": 3,
  "text": "联邦储备系统由十二个联邦储备银行组成，由位于华盛顿特区的联邦储备委员会监督",
  "uiIdx": "3.2",
  "range": "35891-35940",
  "chapterUid": 10
 },
 {
  "level": 4,
  "text": "这种结构确保了全国各地都有人在中央银行中有发言权，并且有关国家经济的所有信息都会在华盛顿得到听取。",
  "uiIdx": "",
  "range": "35891-35940",
  "chapterUid": 10
 },
 {
  "level": 2,
  "text": "大萧条及其对美联储的影响",
  "uiIdx": "4",
  "range": "35891-35940",
  "chapterUid": 10
 },
 {
  "level": 3,
  "text": "大萧条是从1929年到1933年的全球经济衰退，对美国和全球都产生了深远影响",
  "uiIdx": "4.1",
  "range": "35891-35940",
  "chapterUid": 10
 },
 {
  "level": 4,
  "text": "1929年10月29日，美国股市崩盘，随后金融危机席卷全球。",
  "uiIdx": "",
  "range": "35891-35940",
  "chapterUid": 10
 },
 {
  "level": 4,
  "text": "经济收缩非常严重，从1929年到1933年，GDP下降了接近三分之一。",
  "uiIdx": "",
  "range": "35111-35202",
  "chapterUid": 10
 },
 {
  "level": 4,
  "text": "同时，经济经历了通货紧缩，价格水平在1931年和1932年下降了大约10％。",
  "uiIdx": "",
  "range": "35278-35360",
  "chapterUid": 10
 },
 {
  "level": 4,
  "text": "失业率高企，在1933年早期，失业率接近25％。",
  "uiIdx": "",
  "range": "35891-35940",
  "chapterUid": 10
 },
 {
  "level": 4,
  "text": "许多银行倒闭，从1930年到1933年，每年都有大量的银行倒闭。",
  "uiIdx": "",
  "range": "35014-35110",
  "chapterUid": 10
 },
 {
  "level": 3,
  "text": "美联储在应对大萧条时，未能有效地履行其职责",
  "uiIdx": "4.2",
  "range": "35891-35940",
  "chapterUid": 10
 },
 {
  "level": 4,
  "text": "在货币政策方面，美联储没有像预期的那样在深度衰退中放松货币政策，而是通过提高利率来试图阻止股市投机。",
  "uiIdx": "",
  "range": "35891-35940",
  "chapterUid": 10
 },
 {
  "level": 4,
  "text": "在金融稳定方面，美联储没有充分履行其作为最后贷款人的职责，允许许多银行倒闭，并导致信贷和货币供应的收缩。",
  "uiIdx": "",
  "range": "35891-35940",
  "chapterUid": 10
 },
 {
  "level": 2,
  "text": "对美联储应对2008-2009年金融危机的启示",
  "uiIdx": "5",
  "range": "35891-35940",
  "chapterUid": 10
 },
 {
  "level": 3,
  "text": "美联储在2008-2009年金融危机期间采取了多种措施来稳定经济",
  "uiIdx": "5.1",
  "range": "35891-35940",
  "chapterUid": 10
 },
 {
  "level": 4,
  "text": "美联储降低了利率，实施了量化宽松政策，向银行系统提供了大量流动性。",
  "uiIdx": "",
  "range": "35891-35940",
  "chapterUid": 10
 },
 {
  "level": 4,
  "text": "美联储还与其他国家的中央银行合作，通过互换额度等方式提供美元流动性。",
  "uiIdx": "",
  "range": "35891-35940",
  "chapterUid": 10
 },
 {
  "level": 3,
  "text": "从大萧条中吸取的教训，美联储在应对金融危机时应更加积极和灵活",
  "uiIdx": "5.2",
  "range": "35891-35940",
  "chapterUid": 10
 },
 {
  "level": 4,
  "text": "美联储应更加积极地使用货币政策来防止通货紧缩和经济崩溃。",
  "uiIdx": "",
  "range": "35891-35940",
  "chapterUid": 10
 },
 {
  "level": 4,
  "text": "美联储应更加灵活地履行其作为最后贷款人的职责，以防止银行倒闭和信贷紧缩。",
  "uiIdx": "",
  "range": "35891-35940",
  "chapterUid": 10
 },
 {
  "level": 1,
  "text": "Lecture 2 The Federal Reserve after World WarⅡ",
  "uiIdx": "",
  "range": "",
  "chapterUid": 10
 },
 {
  "level": 2,
  "text": "中央银行的两大使命：维护宏观经济稳定和维护金融稳定",
  "uiIdx": "1",
  "range": "1550-1643",
  "chapterUid": 10
 },
 {
  "level": 3,
  "text": "宏观经济稳定的主要政策工具是货币政策",
  "uiIdx": "1.1",
  "range": "1550-1643",
  "chapterUid": 10
 },
 {
  "level": 4,
  "text": "通过公开市场操作调整利率，影响宏观经济环境。",
  "uiIdx": "",
  "range": "1550-1643",
  "chapterUid": 10
 },
 {
  "level": 3,
  "text": "中央银行关注金融系统的正常运行，防止金融危机或恐慌",
  "uiIdx": "1.2",
  "range": "2524-2908",
  "chapterUid": 10
 },
 {
  "level": 4,
  "text": "在金融危机时，中央银行应遵循Bagehot规则，自由放贷并收取惩罚性利率。",
  "uiIdx": "",
  "range": "2524-2908",
  "chapterUid": 10
 },
 {
  "level": 2,
  "text": "美联储的历史角色",
  "uiIdx": "2",
  "range": "1550-1643",
  "chapterUid": 10
 },
 {
  "level": 3,
  "text": "二战后，美联储与财政部合作，保持低利率以资助战争",
  "uiIdx": "2.1",
  "range": "1550-1643",
  "chapterUid": 10
 },
 {
  "level": 4,
  "text": "美联储管理利率，使政府以较低成本融资战争。",
  "uiIdx": "",
  "range": "1550-1643",
  "chapterUid": 10
 },
 {
  "level": 3,
  "text": "战后，美联储面临维持低利率的压力，但也可能导致经济过热和通胀",
  "uiIdx": "2.2",
  "range": "4082-4165",
  "chapterUid": 10
 },
 {
  "level": 4,
  "text": "1951年，美联储担心美国通胀前景，与财政部达成独立设定利率的协议。",
  "uiIdx": "",
  "range": "4082-4165",
  "chapterUid": 10
 },
 {
  "level": 2,
  "text": "美联储的独立性和政策效果",
  "uiIdx": "3",
  "range": "1550-1643",
  "chapterUid": 10
 },
 {
  "level": 3,
  "text": "独立央行能忽略短期政治压力，做出更长远和更好的决策",
  "uiIdx": "3.1",
  "range": "1550-1643",
  "chapterUid": 10
 },
 {
  "level": 4,
  "text": "证据表明，独立央行通常能带来更好的政策效果。",
  "uiIdx": "",
  "range": "1550-1643",
  "chapterUid": 10
 },
 {
  "level": 3,
  "text": "20世纪50年代和60年代，美联储的“逆风而行”货币政策试图保持通胀和增长稳定",
  "uiIdx": "3.2",
  "range": "6035-6126",
  "chapterUid": 10
 },
 {
  "level": 4,
  "text": "威廉·麦克切斯尼·马丁担任美联储主席期间，强调通胀风险，实行“逆风而行”政策。",
  "uiIdx": "",
  "range": "6035-6126",
  "chapterUid": 10
 },
 {
  "level": 2,
  "text": "20世纪70年代通胀问题的出现和解决",
  "uiIdx": "4",
  "range": "1550-1643",
  "chapterUid": 10
 },
 {
  "level": 3,
  "text": "70年代，货币政策过于宽松，导致通胀上升",
  "uiIdx": "4.1",
  "range": "1550-1643",
  "chapterUid": 10
 },
 {
  "level": 4,
  "text": "经济理论认为低通胀可带来高就业，导致货币政策过于宽松。",
  "uiIdx": "",
  "range": "1550-1643",
  "chapterUid": 10
 },
 {
  "level": 4,
  "text": "1973年石油危机和1979年伊朗人质危机等外部冲击加剧了通胀问题。",
  "uiIdx": "",
  "range": "17540-17568",
  "chapterUid": 10
 },
 {
  "level": 3,
  "text": "保罗·沃尔克担任美联储主席后，采取强硬措施控制通胀",
  "uiIdx": "4.2",
  "range": "1550-1643",
  "chapterUid": 10
 },
 {
  "level": 4,
  "text": "沃尔克认为，要打破通胀周期，必须有可信和纪律严明的货币政策。",
  "uiIdx": "",
  "range": "1550-1643",
  "chapterUid": 10
 },
 {
  "level": 4,
  "text": "高利率政策虽然导致经济衰退，但成功降低了通胀。",
  "uiIdx": "",
  "range": "1550-1643",
  "chapterUid": 10
 },
 {
  "level": 2,
  "text": "大缓和时期的经济稳定和金融稳定",
  "uiIdx": "5",
  "range": "20084-20110",
  "chapterUid": 10
 },
 {
  "level": 3,
  "text": "80年代中期至2000年代初，经济波动大幅减少，被称为“大缓和”",
  "uiIdx": "5.1",
  "range": "20084-20110",
  "chapterUid": 10
 },
 {
  "level": 4,
  "text": "实际GDP增长和通胀的波动性均大幅降低。",
  "uiIdx": "",
  "range": "20084-20110",
  "chapterUid": 10
 },
 {
  "level": 3,
  "text": "经济稳定的部分原因可能是货币政策的作用",
  "uiIdx": "5.2",
  "range": "1550-1643",
  "chapterUid": 10
 },
 {
  "level": 4,
  "text": "低且稳定的通胀有助于经济稳定。",
  "uiIdx": "",
  "range": "1550-1643",
  "chapterUid": 10
 },
 {
  "level": 4,
  "text": "货币政策通过影响经济主体的预期，有助于维持经济稳定。",
  "uiIdx": "",
  "range": "1550-1643",
  "chapterUid": 10
 },
 {
  "level": 2,
  "text": "金融危机的触发和原因",
  "uiIdx": "6",
  "range": "1550-1643",
  "chapterUid": 10
 },
 {
  "level": 3,
  "text": "2000年代初的低利率政策并非房价泡沫的主要原因",
  "uiIdx": "6.1",
  "range": "1550-1643",
  "chapterUid": 10
 },
 {
  "level": 4,
  "text": "国际比较显示，房价泡沫并非仅由货币政策引发。",
  "uiIdx": "",
  "range": "1550-1643",
  "chapterUid": 10
 },
 {
  "level": 4,
  "text": "房价泡沫在2000年代初已开始，早于货币政策调整。",
  "uiIdx": "",
  "range": "25472-25568",
  "chapterUid": 10
 },
 {
  "level": 3,
  "text": "金融危机的触发是房价下跌和抵押贷款损失",
  "uiIdx": "6.2",
  "range": "1550-1643",
  "chapterUid": 10
 },
 {
  "level": 4,
  "text": "房价下跌导致许多购房者负资产，增加了抵押贷款违约风险。",
  "uiIdx": "",
  "range": "1550-1643",
  "chapterUid": 10
 },
 {
  "level": 4,
  "text": "抵押贷款违约导致银行和金融机构遭受重大损失。",
  "uiIdx": "",
  "range": "1550-1643",
  "chapterUid": 10
 },
 {
  "level": 2,
  "text": "金融危机前的金融体系脆弱性",
  "uiIdx": "7",
  "range": "35187-35253",
  "chapterUid": 10
 },
 {
  "level": 3,
  "text": "私营部门：过度负债、风险管理不足、短期融资依赖、复杂金融工具使用不当",
  "uiIdx": "7.1",
  "range": "35187-35253",
  "chapterUid": 10
 },
 {
  "level": 4,
  "text": "许多借款人和 lenders 过度负债，杠杆率过高。",
  "uiIdx": "",
  "range": "35187-35253",
  "chapterUid": 10
 },
 {
  "level": 4,
  "text": "金融交易变得越来越复杂，但银行和金融机构的风险监控和管理能力未能跟上。",
  "uiIdx": "",
  "range": "1550-1643",
  "chapterUid": 10
 },
 {
  "level": 4,
  "text": "许多金融公司严重依赖短期融资，如商业票据，容易引发挤兑。",
  "uiIdx": "",
  "range": "1550-1643",
  "chapterUid": 10
 },
 {
  "level": 4,
  "text": "金融公司广泛使用复杂的衍生工具和信用违约掉期(CDS)等。",
  "uiIdx": "",
  "range": "7381-7436",
  "chapterUid": 10
 },
 {
  "level": 3,
  "text": "公共部门：金融监管结构过时、监管不足",
  "uiIdx": "7.2",
  "range": "1550-1643",
  "chapterUid": 10
 },
 {
  "level": 4,
  "text": "金融监管结构基本上还是1930年代大萧条时期建立的。",
  "uiIdx": "",
  "range": "1550-1643",
  "chapterUid": 10
 },
 {
  "level": 4,
  "text": "许多重要的金融机构没有受到任何金融监管机构的全面监督。",
  "uiIdx": "",
  "range": "1550-1643",
  "chapterUid": 10
 },
 {
  "level": 4,
  "text": "美联储在监管银行和银行控股公司方面未能充分强调风险衡量。",
  "uiIdx": "",
  "range": "1550-1643",
  "chapterUid": 10
 },
 {
  "level": 4,
  "text": "美联储在消费者保护方面做得不够，未能有效减少不良贷款。",
  "uiIdx": "",
  "range": "1550-1643",
  "chapterUid": 10
 },
 {
  "level": 2,
  "text": "金融危机后的经济和政策反应",
  "uiIdx": "8",
  "range": "1550-1643",
  "chapterUid": 10
 },
 {
  "level": 3,
  "text": "经济遭受严重打击，金融压力急剧上升",
  "uiIdx": "8.1",
  "range": "1550-1643",
  "chapterUid": 10
 },
 {
  "level": 4,
  "text": "股市暴跌，房地产市场崩溃，失业率上升。",
  "uiIdx": "",
  "range": "1550-1643",
  "chapterUid": 10
 },
 {
  "level": 3,
  "text": "货币政策在危机期间和之后被用来刺激经济",
  "uiIdx": "8.2",
  "range": "1550-1643",
  "chapterUid": 10
 },
 {
  "level": 4,
  "text": "美联储将联邦基金利率降至接近零，并实施了量化宽松政策。",
  "uiIdx": "",
  "range": "1550-1643",
  "chapterUid": 10
 },
 {
  "level": 2,
  "text": "对未来货币政策的启示",
  "uiIdx": "9",
  "range": "1550-1643",
  "chapterUid": 10
 },
 {
  "level": 3,
  "text": "在制定货币政策时，应考虑资产价格泡沫的风险",
  "uiIdx": "9.1",
  "range": "1550-1643",
  "chapterUid": 10
 },
 {
  "level": 4,
  "text": "货币政策应旨在实现宏观经济稳定，而非特定资产价格。",
  "uiIdx": "",
  "range": "1550-1643",
  "chapterUid": 10
 },
 {
  "level": 4,
  "text": "监管和宏观审慎政策应作为应对资产价格泡沫的第一道防线。",
  "uiIdx": "",
  "range": "1550-1643",
  "chapterUid": 10
 },
 {
  "level": 3,
  "text": "保持低通胀预期对于经济稳定至关重要",
  "uiIdx": "9.2",
  "range": "1550-1643",
  "chapterUid": 10
 },
 {
  "level": 4,
  "text": "长期低通胀预期有助于稳定经济。",
  "uiIdx": "",
  "range": "1550-1643",
  "chapterUid": 10
 },
 {
  "level": 4,
  "text": "中央银行应通过透明度和沟通来维持通胀预期的稳定。",
  "uiIdx": "",
  "range": "1550-1643",
  "chapterUid": 10
 },
 {
  "level": 1,
  "text": "Lecture 3 The Federal Reserve’s Response to the Financial Crisis",
  "uiIdx": "",
  "range": "",
  "chapterUid": 10
 },
 {
  "level": 2,
  "text": "金融危机的起因和影响",
  "uiIdx": "1",
  "range": "1586-1668",
  "chapterUid": 10
 },
 {
  "level": 3,
  "text": "金融危机由多种因素引发，包括房地产价格下跌、过度债务、银行风险监控不足等",
  "uiIdx": "1.1",
  "range": "1586-1668",
  "chapterUid": 10
 },
 {
  "level": 4,
  "text": "房地产价格下跌导致贷款人无法偿还贷款，引发金融危机。",
  "uiIdx": "",
  "range": "1586-1668",
  "chapterUid": 10
 },
 {
  "level": 4,
  "text": "过度债务和银行风险监控不足加剧了金融危机的严重性。",
  "uiIdx": "",
  "range": "1586-1668",
  "chapterUid": 10
 },
 {
  "level": 3,
  "text": "金融危机导致全球经济陷入严重衰退，失业率上升，股市暴跌",
  "uiIdx": "1.2",
  "range": "46595-46665",
  "chapterUid": 10
 },
 {
  "level": 4,
  "text": "美国GDP下降超过5%，850万人失去工作，失业率上升至10%。",
  "uiIdx": "",
  "range": "46595-46665",
  "chapterUid": 10
 },
 {
  "level": 4,
  "text": "美国股市在危机期间下跌了85%。",
  "uiIdx": "",
  "range": "1586-1668",
  "chapterUid": 10
 },
 {
  "level": 2,
  "text": "联邦储备系统的应对策略",
  "uiIdx": "2",
  "range": "1586-1668",
  "chapterUid": 10
 },
 {
  "level": 3,
  "text": "联邦储备系统通过提供流动性、降低利率等手段，努力稳定金融市场",
  "uiIdx": "2.1",
  "range": "1586-1668",
  "chapterUid": 10
 },
 {
  "level": 4,
  "text": "联邦储备系统通过贴现窗口提供短期贷款，帮助银行应对资金短缺。",
  "uiIdx": "",
  "range": "1586-1668",
  "chapterUid": 10
 },
 {
  "level": 4,
  "text": "联邦储备系统降低利率，刺激经济增长。",
  "uiIdx": "",
  "range": "1586-1668",
  "chapterUid": 10
 },
 {
  "level": 3,
  "text": "联邦储备系统与国际社会合作，共同应对金融危机",
  "uiIdx": "2.2",
  "range": "1586-1668",
  "chapterUid": 10
 },
 {
  "level": 4,
  "text": "联邦储备系统与欧洲中央银行进行货币互换，缓解全球美元资金压力。",
  "uiIdx": "",
  "range": "1586-1668",
  "chapterUid": 10
 },
 {
  "level": 4,
  "text": "联邦储备系统与七国集团其他成员国中央银行协调利率政策，共同应对金融危机。",
  "uiIdx": "",
  "range": "1586-1668",
  "chapterUid": 10
 },
 {
  "level": 2,
  "text": "联邦储备系统的救援措施",
  "uiIdx": "3",
  "range": "43199-43315",
  "chapterUid": 10
 },
 {
  "level": 3,
  "text": "联邦储备系统对部分陷入困境的金融机构进行了救援，避免了系统性风险的发生",
  "uiIdx": "3.1",
  "range": "43199-43315",
  "chapterUid": 10
 },
 {
  "level": 4,
  "text": "联邦储备系统通过贷款帮助贝尔斯登、AIG等金融机构度过危机。",
  "uiIdx": "",
  "range": "43199-43315",
  "chapterUid": 10
 },
 {
  "level": 4,
  "text": "联邦储备系统通过购买金融机构资产等方式，为市场提供流动性。",
  "uiIdx": "",
  "range": "1586-1668",
  "chapterUid": 10
 },
 {
  "level": 3,
  "text": "联邦储备系统的救援措施引发了对“太大而不能倒”问题的讨论",
  "uiIdx": "3.2",
  "range": "9654-9693",
  "chapterUid": 10
 },
 {
  "level": 4,
  "text": "“太大而不能倒”问题使得一些大型金融机构敢于承担过多风险。",
  "uiIdx": "",
  "range": "9654-9693",
  "chapterUid": 10
 },
 {
  "level": 4,
  "text": "联邦储备系统正在努力解决“太大而不能倒”问题，以确保金融市场的稳定。",
  "uiIdx": "",
  "range": "9654-9693",
  "chapterUid": 10
 },
 {
  "level": 1,
  "text": "Lecture 4 The Aftermath of the Crisis",
  "uiIdx": "",
  "range": "",
  "chapterUid": 10
 },
 {
  "level": 2,
  "text": "美联储在金融危机中的应对策略",
  "uiIdx": "1",
  "range": "1532-1587",
  "chapterUid": 10
 },
 {
  "level": 3,
  "text": "美联储提供短期流动性以稳定市场",
  "uiIdx": "1.1",
  "range": "1532-1587",
  "chapterUid": 10
 },
 {
  "level": 4,
  "text": "美联储通过与其他国家的中央银行进行货币互换，为金融体系提供美元流动性。",
  "uiIdx": "",
  "range": "1532-1587",
  "chapterUid": 10
 },
 {
  "level": 4,
  "text": "美联储为银行提供贷款，帮助其度过危机。",
  "uiIdx": "",
  "range": "1532-1587",
  "chapterUid": 10
 },
 {
  "level": 3,
  "text": "美联储与其他机构合作，共同应对危机",
  "uiIdx": "1.2",
  "range": "1532-1587",
  "chapterUid": 10
 },
 {
  "level": 4,
  "text": "美联储与财政部合作，确保银行有足够的资本。",
  "uiIdx": "",
  "range": "1532-1587",
  "chapterUid": 10
 },
 {
  "level": 4,
  "text": "美联储与联邦存款保险公司合作，提高存款保险限额，为银行提供担保。",
  "uiIdx": "",
  "range": "1532-1587",
  "chapterUid": 10
 },
 {
  "level": 2,
  "text": "金融危机后的经济恢复",
  "uiIdx": "2",
  "range": "1532-1587",
  "chapterUid": 10
 },
 {
  "level": 3,
  "text": "美联储通过量化宽松政策刺激经济",
  "uiIdx": "2.1",
  "range": "1532-1587",
  "chapterUid": 10
 },
 {
  "level": 4,
  "text": "美联储购买大量国债和抵押贷款支持证券，降低长期利率。",
  "uiIdx": "",
  "range": "1532-1587",
  "chapterUid": 10
 },
 {
  "level": 4,
  "text": "美联储通过提高银行准备金率，控制货币供应。",
  "uiIdx": "",
  "range": "1532-1587",
  "chapterUid": 10
 },
 {
  "level": 3,
  "text": "经济恢复缓慢，就业市场仍需改善",
  "uiIdx": "2.2",
  "range": "1532-1587",
  "chapterUid": 10
 },
 {
  "level": 4,
  "text": "尽管经济恢复，但失业率仍居高不下。",
  "uiIdx": "",
  "range": "1532-1587",
  "chapterUid": 10
 },
 {
  "level": 4,
  "text": "房屋市场复苏缓慢，影响整体经济。",
  "uiIdx": "",
  "range": "1532-1587",
  "chapterUid": 10
 },
 {
  "level": 2,
  "text": "金融监管改革",
  "uiIdx": "3",
  "range": "11898-12027",
  "chapterUid": 10
 },
 {
  "level": 3,
  "text": "《多德-弗兰克法案》的通过",
  "uiIdx": "3.1",
  "range": "11898-12027",
  "chapterUid": 10
 },
 {
  "level": 4,
  "text": "《多德-弗兰克法案》旨在解决金融危机中暴露的问题。",
  "uiIdx": "",
  "range": "11898-12027",
  "chapterUid": 10
 },
 {
  "level": 4,
  "text": "法案包括加强金融监管、解决“太大而不能倒”问题、保护消费者等措施。",
  "uiIdx": "",
  "range": "45859-45900",
  "chapterUid": 10
 },
 {
  "level": 3,
  "text": "美联储的监管改革",
  "uiIdx": "3.2",
  "range": "1532-1587",
  "chapterUid": 10
 },
 {
  "level": 4,
  "text": "美联储重组监管部分，全面监管金融市场。",
  "uiIdx": "",
  "range": "1532-1587",
  "chapterUid": 10
 },
 {
  "level": 4,
  "text": "美联储加强对大型金融机构的监管，提高资本要求。",
  "uiIdx": "",
  "range": "1532-1587",
  "chapterUid": 10
 },
 {
  "level": 2,
  "text": "中央银行的角色和挑战",
  "uiIdx": "4",
  "range": "45859-45900",
  "chapterUid": 10
 },
 {
  "level": 3,
  "text": "中央银行在维护金融稳定中的作用",
  "uiIdx": "4.1",
  "range": "45859-45900",
  "chapterUid": 10
 },
 {
  "level": 4,
  "text": "中央银行作为“最后贷款人”，防止或减轻金融危机。",
  "uiIdx": "",
  "range": "45859-45900",
  "chapterUid": 10
 },
 {
  "level": 4,
  "text": "中央银行使用货币政策工具，促进经济稳定。",
  "uiIdx": "",
  "range": "1532-1587",
  "chapterUid": 10
 },
 {
  "level": 3,
  "text": "中央银行面临的挑战和未来方向",
  "uiIdx": "4.2",
  "range": "1532-1587",
  "chapterUid": 10
 },
 {
  "level": 4,
  "text": "中央银行需要继续监控整个金融体系，识别问题并作出响应。",
  "uiIdx": "",
  "range": "1532-1587",
  "chapterUid": 10
 },
 {
  "level": 4,
  "text": "中央银行需要与其他政府部门和私人部门合作，共同促进经济增长。",
  "uiIdx": "",
  "range": "1532-1587",
  "chapterUid": 10
 }
]