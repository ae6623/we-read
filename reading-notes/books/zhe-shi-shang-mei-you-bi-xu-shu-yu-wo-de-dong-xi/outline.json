[
 {
  "level": 1,
  "text": "正文",
  "uiIdx": "",
  "range": "",
  "chapterUid": 3
 },
 {
  "level": 2,
  "text": "作者的执念与现实的冲突",
  "uiIdx": "1",
  "range": "572-621",
  "chapterUid": 3
 },
 {
  "level": 3,
  "text": "作者渴望拥有一间宽敞、明亮的，能放得下她所有东西的房子",
  "uiIdx": "1.1",
  "range": "572-621",
  "chapterUid": 3
 },
 {
  "level": 4,
  "text": "这个执念深入了她太久的心念，变成了一种心魔，甚至是我日日所思。",
  "uiIdx": "",
  "range": "621-652",
  "chapterUid": 3
 },
 {
  "level": 3,
  "text": "作者总是错过一些合适的时候，错过一些必要的机遇，错过一些需要下定决心的冒险",
  "uiIdx": "1.2",
  "range": "652-690",
  "chapterUid": 3
 },
 {
  "level": 4,
  "text": "直至今日，我依然没有一间足够宽敞得，住得下我的家和我的物品的房子。",
  "uiIdx": "",
  "range": "690-804",
  "chapterUid": 3
 },
 {
  "level": 2,
  "text": "作者在北京的生活与成长",
  "uiIdx": "2",
  "range": "1418-1438",
  "chapterUid": 3
 },
 {
  "level": 3,
  "text": "作者在北京租过数不清的房子，经历过北漂生活的酸甜苦辣",
  "uiIdx": "2.1",
  "range": "1418-1438",
  "chapterUid": 3
 },
 {
  "level": 4,
  "text": "我们住过的最大的房子也就是工作室这么大了。",
  "uiIdx": "",
  "range": "1418-1438",
  "chapterUid": 3
 },
 {
  "level": 4,
  "text": "有一回，我们从南边搬回到北边，北边有很多朋友，我的工作也回到了朝阳。",
  "uiIdx": "",
  "range": "1438-1495",
  "chapterUid": 3
 },
 {
  "level": 4,
  "text": "那时候我才二十多岁，有朋友，有喜欢的工作，也有喜欢的人在身边……一个热热闹闹的年轻人，在二十几岁的时候，即便想要拥有自己的房子，这个欲望也没有强烈到要去牺牲生活的琐碎，去换取一个暂时遥不可及的梦想。",
  "uiIdx": "",
  "range": "1438-1594",
  "chapterUid": 3
 },
 {
  "level": 4,
  "text": "我们最好的朋友们就住在附近小区或者同小区。我上下班，就搭乘闺蜜的车，我们经常一起吃饭，不是在我家，就是在他们家，彼此走来走去，像《老友记》里一样不分彼此。",
  "uiIdx": "",
  "range": "3055-3155",
  "chapterUid": 3
 },
 {
  "level": 4,
  "text": "离开的时候，我和朋友们吃了三顿散货饭都没有告别干净。",
  "uiIdx": "",
  "range": "4178-4227",
  "chapterUid": 3
 },
 {
  "level": 3,
  "text": "作者在北京的生活让她变成了一个要带着理想主义，回到上海做文化的怪物",
  "uiIdx": "2.2",
  "range": "6184-6239",
  "chapterUid": 3
 },
 {
  "level": 4,
  "text": "我必然不舍，但我却不得不离开。因为成长到了下一个阶段。",
  "uiIdx": "",
  "range": "6239-6289",
  "chapterUid": 3
 },
 {
  "level": 2,
  "text": "作者回到上海的生活与挣扎",
  "uiIdx": "3",
  "range": "6507-6599",
  "chapterUid": 3
 },
 {
  "level": 3,
  "text": "作者回到上海后，还是两个图书编辑，在不同的图书公司和出版社里工作",
  "uiIdx": "3.1",
  "range": "6507-6599",
  "chapterUid": 3
 },
 {
  "level": 4,
  "text": "我们果断搬到了那所离他公司很近，离我入职的出版社也只有20分钟不到行走距离的房子。",
  "uiIdx": "",
  "range": "6694-6735",
  "chapterUid": 3
 },
 {
  "level": 4,
  "text": "我们之前的两居室，租给了当时我们在上海非常要好的朋友，她们也是我老公公司的同事。",
  "uiIdx": "",
  "range": "7409-7472",
  "chapterUid": 3
 },
 {
  "level": 3,
  "text": "作者和老公因为买房的事情吵架，她渴望成功，急切地渴望",
  "uiIdx": "3.2",
  "range": "7829-7864",
  "chapterUid": 3
 },
 {
  "level": 4,
  "text": "我那时候处在一个对金钱极度焦虑的时期，我想买房，我想要在这个城市过不憋屈的生活，但我们的现实却像乌龟在爬行，离那个遥不可及的梦想，几乎存在着令人绝望的距离。",
  "uiIdx": "",
  "range": "7559-7660",
  "chapterUid": 3
 },
 {
  "level": 4,
  "text": "老公说，我在那时候，近乎疯魔地变了。总是在催他上进，催他赚钱，催他买房……他从未见过这样的我。",
  "uiIdx": "",
  "range": "7660-7721",
  "chapterUid": 3
 },
 {
  "level": 3,
  "text": "作者决定做一个自己的独立工作室",
  "uiIdx": "3.3",
  "range": "11421-11476",
  "chapterUid": 3
 },
 {
  "level": 4,
  "text": "三年前我们决定把那个小房子变成工作室，家没有，但工作可以安顿了。",
  "uiIdx": "",
  "range": "11421-11476",
  "chapterUid": 3
 },
 {
  "level": 2,
  "text": "作者的断舍离与成长",
  "uiIdx": "4",
  "range": "12744-12829",
  "chapterUid": 3
 },
 {
  "level": 3,
  "text": "作者开始毫不留情地扔东西，她意识到，她被自己裹挟得喘不过气来，她需要实实在在地，清理出，她可以生活的空间",
  "uiIdx": "4.1",
  "range": "12744-12829",
  "chapterUid": 3
 },
 {
  "level": 4,
  "text": "我扔了一个礼拜，从东西，到衣服，到家里的锅碗瓢盆。",
  "uiIdx": "",
  "range": "12877-12925",
  "chapterUid": 3
 },
 {
  "level": 4,
  "text": "我还把家里清掉了两个家具。多余的收纳会换来多余的物品，而其实，没有收纳，就没有堆积。",
  "uiIdx": "",
  "range": "12925-12967",
  "chapterUid": 3
 },
 {
  "level": 3,
  "text": "作者认为，真正的安全感从来不来源于物品，她在四十岁的某一天，意识到，她不会永远活着",
  "uiIdx": "4.2",
  "range": "13510-13560",
  "chapterUid": 3
 },
 {
  "level": 4,
  "text": "我曾翻译过一篇文章，很多人应该都读过，它叫《我想在死前扔掉自己所有的东西》，但实际上，那篇文章的原标题就是《搬家》，这个标题，是我突然即兴发挥起的。",
  "uiIdx": "",
  "range": "13621-13718",
  "chapterUid": 3
 },
 {
  "level": 4,
  "text": "那段时间就是我的断舍离狂热期。我突然像是开了窍的决定，我要给自己在死之前，留下一无所有的空白。除了我的创造，我的文字，我的思想，我的工作，我什么都不会留下。",
  "uiIdx": "",
  "range": "13621-13796",
  "chapterUid": 3
 }
]