[
 {
  "level": 1,
  "text": "1 凌晨三点仍在工作的年轻人",
  "uiIdx": "",
  "range": "",
  "chapterUid": 2
 },
 {
  "level": 2,
  "text": "凌晨三点的城市",
  "uiIdx": "1",
  "range": "545-614",
  "chapterUid": 2
 },
 {
  "level": 3,
  "text": "物流园、早点铺、环卫车、便利店员、外卖骑手和工地等仍在工作",
  "uiIdx": "1.1",
  "range": "545-614",
  "chapterUid": 2
 },
 {
  "level": 4,
  "text": "物流园里依旧灯火通明，货车进进出出。",
  "uiIdx": "",
  "range": "460-481",
  "chapterUid": 2
 },
 {
  "level": 4,
  "text": "早点铺的师傅已经开始揉面了。",
  "uiIdx": "",
  "range": "545-614",
  "chapterUid": 2
 },
 {
  "level": 4,
  "text": "环卫车正沿着主干道缓缓驶过。",
  "uiIdx": "",
  "range": "545-614",
  "chapterUid": 2
 },
 {
  "level": 4,
  "text": "便利店员忙着理货。",
  "uiIdx": "",
  "range": "545-614",
  "chapterUid": 2
 },
 {
  "level": 4,
  "text": "外卖骑手还在守着夜宵单子。",
  "uiIdx": "",
  "range": "545-614",
  "chapterUid": 2
 },
 {
  "level": 4,
  "text": "有些工地为了赶工期，依然机器轰鸣。",
  "uiIdx": "",
  "range": "545-614",
  "chapterUid": 2
 },
 {
  "level": 2,
  "text": "年轻人的误判",
  "uiIdx": "2",
  "range": "803-828",
  "chapterUid": 2
 },
 {
  "level": 3,
  "text": "年轻人总觉得只要自己还有把子力气，就等于有了退路。",
  "uiIdx": "2.1",
  "range": "803-828",
  "chapterUid": 2
 },
 {
  "level": 3,
  "text": "年轻人总觉得只要肯吃苦，就能换来稳定的生活。",
  "uiIdx": "2.2",
  "range": "828-850",
  "chapterUid": 2
 },
 {
  "level": 2,
  "text": "体力岗位的残酷真相",
  "uiIdx": "3",
  "range": "1330-1372",
  "chapterUid": 2
 },
 {
  "level": 3,
  "text": "岗位对个人的依赖度极低，只要活儿足够简单，管理者就能源源不断地去找那些更便宜、更年轻、更坐得住的人来顶替你",
  "uiIdx": "3.1",
  "range": "1330-1372",
  "chapterUid": 2
 },
 {
  "level": 4,
  "text": "小周在仓库里当然也学到了一些门道，比如他知道什么样的包裹容易破损，知道高峰期哪条流水线最忙，也琢磨出了怎么干活更省力。可这些所谓的“经验”，并不能让他的工资涨上去。",
  "uiIdx": "",
  "range": "1401-1483",
  "chapterUid": 2
 },
 {
  "level": 4,
  "text": "公司发工资的逻辑很简单：看你一天能搬多少件、能站多久、能不能听从排班。至于你是在这儿干了半年还是一年，对老板来说差别真的没那么大。",
  "uiIdx": "",
  "range": "1512-1579",
  "chapterUid": 2
 },
 {
  "level": 2,
  "text": "读书的意义",
  "uiIdx": "4",
  "range": "1991-2006",
  "chapterUid": 2
 },
 {
  "level": 3,
  "text": "读书的意义，首先就体现在这里。它不一定能保证你过得轻松，也不一定能让你发大财。它最大的作用，是增加了一个普通人在职场上的选择范围",
  "uiIdx": "4.1",
  "range": "1991-2006",
  "chapterUid": 2
 },
 {
  "level": 4,
  "text": "能读懂文件，能通过各类考试，能熟练使用工具，能理清业务流程。",
  "uiIdx": "",
  "range": "2056-2086",
  "chapterUid": 2
 },
 {
  "level": 4,
  "text": "能跟陌生人沟通得体，能处理稍微复杂一点的状况——这些能力平时看着不起眼，却决定了一个人能不能离开那些最容易被替代的岗位。",
  "uiIdx": "",
  "range": "2115-2175",
  "chapterUid": 2
 },
 {
  "level": 3,
  "text": "读书这件事对普通家庭的孩子来说，真的特别要紧",
  "uiIdx": "4.2",
  "range": "2790-2817",
  "chapterUid": 2
 },
 {
  "level": 4,
  "text": "它不是为了挣个面子，也不是为了给父母交差，而是一种提前的生存训练。",
  "uiIdx": "",
  "range": "2817-2850",
  "chapterUid": 2
 },
 {
  "level": 4,
  "text": "它训练你以后不必只靠透支身体去硬撑，训练你在岗位上有能力看透更多门道。",
  "uiIdx": "",
  "range": "2850-2885",
  "chapterUid": 2
 },
 {
  "level": 1,
  "text": "2 体力岗位的价格由谁决定",
  "uiIdx": "",
  "range": "",
  "chapterUid": 2
 },
 {
  "level": 2,
  "text": "体力岗位的价格决定因素",
  "uiIdx": "1",
  "range": "561-599",
  "chapterUid": 2
 },
 {
  "level": 3,
  "text": "工资体系取决于替代难度、培训周期、责任大小、结果的影响力，还有供需关系和议价能力",
  "uiIdx": "1.1",
  "range": "561-599",
  "chapterUid": 2
 },
 {
  "level": 4,
  "text": "一个岗位如果只要三天就能上手，谁都能干，而且干得好坏一眼就能看出来，那工资就很难涨上去。",
  "uiIdx": "",
  "range": "628-676",
  "chapterUid": 2
 },
 {
  "level": 4,
  "text": "有些岗位虽然体力消耗没那么大，却需要漫长的专业训练，这些人的工资高，是因为能干这活儿的人少。",
  "uiIdx": "",
  "range": "913-943",
  "chapterUid": 2
 },
 {
  "level": 3,
  "text": "职业的关键分界线，并不在于表面上是出体力还是动脑子，而在于这份工作能不能让你积累起那种越来越难被别人替代的能力",
  "uiIdx": "1.2",
  "range": "1268-1298",
  "chapterUid": 2
 },
 {
  "level": 4,
  "text": "有些岗位你干上十年，工资可能跟第一年没啥差别。但有些岗位你干个三年，就能接触到更复杂的项目，能带新人，能管理流程。",
  "uiIdx": "",
  "range": "1363-1420",
  "chapterUid": 2
 },
 {
  "level": 4,
  "text": "前一种岗位是在消耗你的时间，而后一种岗位是让你的经验随着岁月的增长越来越值钱。",
  "uiIdx": "",
  "range": "1449-1488",
  "chapterUid": 2
 },
 {
  "level": 2,
  "text": "努力与定价权的关系",
  "uiIdx": "2",
  "range": "2190-2238",
  "chapterUid": 2
 },
 {
  "level": 3,
  "text": "努力是有方向差异的，如果你把一天十五个小时全用来重复那种低价劳动，短期内确实能多赚点辛苦钱，但长远来看可能毫无成长",
  "uiIdx": "2.1",
  "range": "2190-2238",
  "chapterUid": 2
 },
 {
  "level": 4,
  "text": "相反，如果把时间花在钻研一门有门槛的技术上，前期收入可能少点，但能力一旦练成了，往后的路子会越走越宽。",
  "uiIdx": "",
  "range": "2267-2318",
  "chapterUid": 2
 },
 {
  "level": 3,
  "text": "选择去学习、去钻研，并不代表就能图轻松，很多技术岗位同样辛苦，不少办公室工作也得天天加班，但它们起码提供了一种可能，就是让你的经验能逐步转化为更高层次的职业资本",
  "uiIdx": "2.2",
  "range": "2318-2338",
  "chapterUid": 2
 },
 {
  "level": 4,
  "text": "纯体力劳动如果没有技能上的升级，随着年龄增长，路只会越走越窄。",
  "uiIdx": "",
  "range": "2399-2430",
  "chapterUid": 2
 },
 {
  "level": 2,
  "text": "工资背后的逻辑",
  "uiIdx": "3",
  "range": "2430-2456",
  "chapterUid": 2
 },
 {
  "level": 3,
  "text": "一份工作到底值多少钱，完全由市场上的替代难度来决定",
  "uiIdx": "3.1",
  "range": "2430-2456",
  "chapterUid": 2
 },
 {
  "level": 4,
  "text": "孩子越早明白这个道理，就越不容易把“我愿意吃苦”这种态度，误当成是自己真正的“竞争力”。",
  "uiIdx": "",
  "range": "2485-2529",
  "chapterUid": 2
 },
 {
  "level": 1,
  "text": "3 年轻能扛住的事不等于一辈子能扛",
  "uiIdx": "",
  "range": "",
  "chapterUid": 2
 },
 {
  "level": 2,
  "text": "身体与工作的关系",
  "uiIdx": "1",
  "range": "704-726",
  "chapterUid": 2
 },
 {
  "level": 3,
  "text": "身体硬朗时，收入看着还行；可一旦身体出了岔子，收入立马就会断崖式下滑",
  "uiIdx": "1.1",
  "range": "704-726",
  "chapterUid": 2
 },
 {
  "level": 4,
  "text": "腰伤、膝盖磨损、手腕劳损，这些在体力活里都不是小概率事件。",
  "uiIdx": "",
  "range": "726-755",
  "chapterUid": 2
 },
 {
  "level": 4,
  "text": "长期上夜班、在高温下作业、频繁搬运重物，这些损耗都会在身体里慢慢堆积。",
  "uiIdx": "",
  "range": "784-819",
  "chapterUid": 2
 },
 {
  "level": 3,
  "text": "靠体力挣钱还有一个硬伤，就是增长空间太有限",
  "uiIdx": "1.2",
  "range": "1130-1152",
  "chapterUid": 2
 },
 {
  "level": 4,
  "text": "很多活儿是按件、按小时或者按天算的。",
  "uiIdx": "",
  "range": "1152-1170",
  "chapterUid": 2
 },
 {
  "level": 4,
  "text": "你要想多赚点，就得拿命多干。",
  "uiIdx": "",
  "range": "1170-1183",
  "chapterUid": 2
 },
 {
  "level": 2,
  "text": "知识型或技术型工作的优势",
  "uiIdx": "2",
  "range": "1257-1297",
  "chapterUid": 2
 },
 {
  "level": 3,
  "text": "知识型或技术型的工作能把经验转化成更高的职位",
  "uiIdx": "2.1",
  "range": "1257-1297",
  "chapterUid": 2
 },
 {
  "level": 4,
  "text": "一个写基础代码的程序员，可以往项目管理走。",
  "uiIdx": "",
  "range": "1297-1318",
  "chapterUid": 2
 },
 {
  "level": 4,
  "text": "一个懂机械设备的操作工，可以转去做维修、调试、培训或者质量管理。",
  "uiIdx": "",
  "range": "1318-1350",
  "chapterUid": 2
 },
 {
  "level": 3,
  "text": "能力的积累，下次还能接着用，并且能和新的经验不断叠加",
  "uiIdx": "2.2",
  "range": "1404-1432",
  "chapterUid": 2
 },
 {
  "level": 4,
  "text": "体力的消耗，干完当天就没了。",
  "uiIdx": "",
  "range": "1379-1404",
  "chapterUid": 2
 },
 {
  "level": 4,
  "text": "学习虽然消耗精力和时间，但它能给你留下带得走的能力。",
  "uiIdx": "",
  "range": "1493-1519",
  "chapterUid": 2
 },
 {
  "level": 2,
  "text": "读书的意义",
  "uiIdx": "3",
  "range": "1652-1681",
  "chapterUid": 2
 },
 {
  "level": 3,
  "text": "读书依然是增加选择权、应对未来变化的最好机会",
  "uiIdx": "3.1",
  "range": "1652-1681",
  "chapterUid": 2
 },
 {
  "level": 4,
  "text": "教育带给人的底层能力，其实远不止那几个具体的知识点。",
  "uiIdx": "",
  "range": "1710-1736",
  "chapterUid": 2
 },
 {
  "level": 4,
  "text": "它更像是一种综合素质，让你能读懂复杂的说明书，理解社会的运行制度，顺利通过考试，接受职业培训，甚至是查找资料、表达诉求以及辨别信息的真伪。",
  "uiIdx": "",
  "range": "1736-1805",
  "chapterUid": 2
 },
 {
  "level": 3,
  "text": "只要具备了这些能力，哪怕行业发生巨变，你依然能学会使用新工具",
  "uiIdx": "3.2",
  "range": "1834-1865",
  "chapterUid": 2
 },
 {
  "level": 4,
  "text": "人到了三十岁才会发现，真正宝贵的财富是你是否还拥有调整生活状态的能力。",
  "uiIdx": "",
  "range": "1889-1924",
  "chapterUid": 2
 },
 {
  "level": 4,
  "text": "你能不能从熬人的夜班换到白班？能不能从纯体力的执行岗转到技术岗？能不能从被动等派单变成自己主动接项目？",
  "uiIdx": "",
  "range": "1953-2004",
  "chapterUid": 2
 },
 {
  "level": 4,
  "text": "人在少年时最容易低估时间的威力。总觉得未来还很遥远，身体永远经得起折腾，但现实的变脸往往极快。",
  "uiIdx": "",
  "range": "2004-2051",
  "chapterUid": 2
 },
 {
  "level": 1,
  "text": "4 读书改变的是理解复杂问题的能力",
  "uiIdx": "",
  "range": "",
  "chapterUid": 2
 },
 {
  "level": 2,
  "text": "读书改变的是理解复杂问题的能力",
  "uiIdx": "1",
  "range": "372-389",
  "chapterUid": 2
 },
 {
  "level": 3,
  "text": "学习过程本身带来的训练作用",
  "uiIdx": "1.1",
  "range": "556-580",
  "chapterUid": 2
 },
 {
  "level": 4,
  "text": "做数学题，训练的是你在既定规则下的逻辑推理能力。",
  "uiIdx": "",
  "range": "556-580",
  "chapterUid": 2
 },
 {
  "level": 4,
  "text": "学语文，练的是对信息的理解和精准的表达。",
  "uiIdx": "",
  "range": "580-600",
  "chapterUid": 2
 },
 {
  "level": 4,
  "text": "学英语，是为了让你拥有接触更多资料的可能性。",
  "uiIdx": "",
  "range": "600-622",
  "chapterUid": 2
 },
 {
  "level": 4,
  "text": "学历史，是让你看清事件背后的因果逻辑。",
  "uiIdx": "",
  "range": "651-670",
  "chapterUid": 2
 },
 {
  "level": 4,
  "text": "物理和化学，则是教你如何把复杂的现象拆解成具体的步骤。",
  "uiIdx": "",
  "range": "670-697",
  "chapterUid": 2
 },
 {
  "level": 4,
  "text": "考试本身，都在训练你如何在压力和各种限制条件下完成既定任务。",
  "uiIdx": "",
  "range": "697-730",
  "chapterUid": 2
 },
 {
  "level": 3,
  "text": "学习耐力的重要性",
  "uiIdx": "1.2",
  "range": "1207-1242",
  "chapterUid": 2
 },
 {
  "level": 4,
  "text": "面对完全陌生的东西时，能定下心来坐得住、读得完。",
  "uiIdx": "",
  "range": "1207-1242",
  "chapterUid": 2
 },
 {
  "level": 4,
  "text": "遇到搞不懂的问题，知道去哪里查资料。",
  "uiIdx": "",
  "range": "1271-1289",
  "chapterUid": 2
 },
 {
  "level": 4,
  "text": "第一次做错了，还有耐心复盘修改。",
  "uiIdx": "",
  "range": "1289-1305",
  "chapterUid": 2
 },
 {
  "level": 4,
  "text": "需要长期磨炼时，不只是凭着三分钟热度撑几天。",
  "uiIdx": "",
  "range": "1305-1327",
  "chapterUid": 2
 },
 {
  "level": 3,
  "text": "读书对语言能力的影响",
  "uiIdx": "1.3",
  "range": "1648-1701",
  "chapterUid": 2
 },
 {
  "level": 4,
  "text": "你能不能把一件事讲得清清楚楚，能不能写出一份像样的简历，能不能向客户解释明白方案，这些都直接影响你的前途。",
  "uiIdx": "",
  "range": "1648-1701",
  "chapterUid": 2
 },
 {
  "level": 3,
  "text": "学习对创业的影响",
  "uiIdx": "1.4",
  "range": "1431-1469",
  "chapterUid": 2
 },
 {
  "level": 4,
  "text": "真正经营好一家店，你得选址、算租金、跟供应商谈判、盯着库存、定价格、招员工。",
  "uiIdx": "",
  "range": "1431-1469",
  "chapterUid": 2
 },
 {
  "level": 4,
  "text": "一个没有学习能力的人去创业，那是把自己暴露在更复杂的风险之中。",
  "uiIdx": "",
  "range": "1568-1599",
  "chapterUid": 2
 },
 {
  "level": 3,
  "text": "学习对人生的影响",
  "uiIdx": "1.5",
  "range": "1876-1892",
  "chapterUid": 2
 },
 {
  "level": 4,
  "text": "学习带来的好处，很少能当天兑现。今天多读一页书，明天可能看不出任何变化。可几年之后，人与人的差距就会在具体的事情里显现出来。",
  "uiIdx": "",
  "range": "1876-1938",
  "chapterUid": 2
 },
 {
  "level": 4,
  "text": "谁能率先学会新工具，谁能快速适应新行业，谁就更有底气离开那些低薪重复的岗位。",
  "uiIdx": "",
  "range": "1938-1976",
  "chapterUid": 2
 },
 {
  "level": 1,
  "text": "5 文凭有边界 技能有后劲",
  "uiIdx": "",
  "range": "",
  "chapterUid": 2
 },
 {
  "level": 2,
  "text": "学历的边界",
  "uiIdx": "1",
  "range": "545-563",
  "chapterUid": 2
 },
 {
  "level": 3,
  "text": "学历不再能自动兑换成一份好工作",
  "uiIdx": "1.1",
  "range": "545-563",
  "chapterUid": 2
 },
 {
  "level": 4,
  "text": "大学生找工作处处碰壁，甚至连坐在办公室里的白领也面临裁员的风险。",
  "uiIdx": "",
  "range": "459-491",
  "chapterUid": 2
 },
 {
  "level": 3,
  "text": "学历竞争变得愈发激烈，并不代表学习本身失去了价值",
  "uiIdx": "1.2",
  "range": "641-669",
  "chapterUid": 2
 },
 {
  "level": 4,
  "text": "社会对个人能力的要求提高了，文凭最起码的作用，是为你争取到一个“入场券”。",
  "uiIdx": "",
  "range": "669-716",
  "chapterUid": 2
 },
 {
  "level": 2,
  "text": "技能的重要性",
  "uiIdx": "2",
  "range": "800-836",
  "chapterUid": 2
 },
 {
  "level": 3,
  "text": "真正能让一个人在职场路上走得稳、走得远的，其实是藏在文凭背后的真本事",
  "uiIdx": "2.1",
  "range": "800-836",
  "chapterUid": 2
 },
 {
  "level": 4,
  "text": "技能必须是能够被验证的，只有这种看得见、摸得着的能力，才能为你持续创造收入。",
  "uiIdx": "",
  "range": "939-965",
  "chapterUid": 2
 },
 {
  "level": 3,
  "text": "有些孩子天生就不是那种能长久坐在教室里钻研理论的性格，但这绝不代表他这辈子就没前途了",
  "uiIdx": "2.2",
  "range": "1843-1886",
  "chapterUid": 2
 },
 {
  "level": 4,
  "text": "他可能更擅长动手操作，对设备感兴趣，关键点在于，他不能因为自己“不适合搞学术”，就顺理成章地选择“不再学习”。",
  "uiIdx": "",
  "range": "1886-1941",
  "chapterUid": 2
 },
 {
  "level": 2,
  "text": "职业教育与技能成长",
  "uiIdx": "3",
  "range": "1274-1296",
  "chapterUid": 2
 },
 {
  "level": 3,
  "text": "优质的职业教育能提供非常清晰的技能成长路径",
  "uiIdx": "3.1",
  "range": "1274-1296",
  "chapterUid": 2
 },
 {
  "level": 4,
  "text": "你得不断地问自己：我到底掌握了什么本事？我能帮别人解决什么问题？我有哪些成果是可以理直气壮拿给别人看的？",
  "uiIdx": "",
  "range": "1028-1080",
  "chapterUid": 2
 },
 {
  "level": 3,
  "text": "那些真正有后劲、能让你吃长久饭的技能，通常都有这么几个特点",
  "uiIdx": "3.2",
  "range": "1359-1419",
  "chapterUid": 2
 },
 {
  "level": 4,
  "text": "它们往往需要较长时间的系统训练，新人很难在短期内大量替代你。",
  "uiIdx": "",
  "range": "1359-1419",
  "chapterUid": 2
 },
 {
  "level": 4,
  "text": "它们的应用场景很广，不会被某一家公司完全锁死。",
  "uiIdx": "",
  "range": "1419-1442",
  "chapterUid": 2
 },
 {
  "level": 4,
  "text": "它们直接关系到安全、效率、质量、成本或者客户的最终结果。",
  "uiIdx": "",
  "range": "1471-1499",
  "chapterUid": 2
 },
 {
  "level": 4,
  "text": "随着你经验的积累，你能逐渐承担起更复杂、更有挑战性的任务。",
  "uiIdx": "",
  "range": "1499-1531",
  "chapterUid": 2
 },
 {
  "level": 2,
  "text": "学习与成长",
  "uiIdx": "4",
  "range": "2110-2142",
  "chapterUid": 2
 },
 {
  "level": 3,
  "text": "对普通人来说，真正的竞争往往从走出校门那一刻才刚刚开始",
  "uiIdx": "4.1",
  "range": "2110-2142",
  "chapterUid": 2
 },
 {
  "level": 4,
  "text": "学校给你的只是一个地基，而社会要检验的，是你能不能把这些基础转化成解决具体问题的能力。",
  "uiIdx": "",
  "range": "2142-2185",
  "chapterUid": 2
 },
 {
  "level": 3,
  "text": "如果一个少年现在的成绩不理想，完全没必要因此就觉得自己走投无路",
  "uiIdx": "4.2",
  "range": "2214-2246",
  "chapterUid": 2
 },
 {
  "level": 4,
  "text": "他必须得找到一件值得投入时间去长期训练的事情。",
  "uiIdx": "",
  "range": "2246-2270",
  "chapterUid": 2
 },
 {
  "level": 4,
  "text": "只要这件事能够产生积累、能被结果验证，它就一定比单纯消耗体力的活儿要靠谱得多。",
  "uiIdx": "",
  "range": "2270-2309",
  "chapterUid": 2
 },
 {
  "level": 1,
  "text": "6 草根成功故事里被省略的部分",
  "uiIdx": "",
  "range": "",
  "chapterUid": 2
 },
 {
  "level": 2,
  "text": "草根成功故事中的误导",
  "uiIdx": "1",
  "range": "544-594",
  "chapterUid": 2
 },
 {
  "level": 3,
  "text": "草根成功故事往往只盯着光鲜的结果，却很少拆解背后的过程",
  "uiIdx": "1.1",
  "range": "544-594",
  "chapterUid": 2
 },
 {
  "level": 4,
  "text": "这类故事往往只盯着那个光鲜的结果，却很少拆解背后的过程，更不会去提那些成千上万的失败者。",
  "uiIdx": "",
  "range": "544-594",
  "chapterUid": 2
 },
 {
  "level": 3,
  "text": "能被讲出来的，往往只是极少数的极端个案",
  "uiIdx": "1.2",
  "range": "1070-1118",
  "chapterUid": 2
 },
 {
  "level": 4,
  "text": "这就是“幸存者偏差”带来的误导。",
  "uiIdx": "",
  "range": "1054-1070",
  "chapterUid": 2
 },
 {
  "level": 2,
  "text": "草根成功者的真实学习过程",
  "uiIdx": "2",
  "range": "672-716",
  "chapterUid": 2
 },
 {
  "level": 3,
  "text": "他们绝大多数人并不拒绝学习，而是在进入市场后，付出了更高的成本把这一课给补上了",
  "uiIdx": "2.1",
  "range": "672-716",
  "chapterUid": 2
 },
 {
  "level": 4,
  "text": "有些草根老板每天盯着账本，那股细致劲儿比学生做数学题还认真。",
  "uiIdx": "",
  "range": "716-746",
  "chapterUid": 2
 },
 {
  "level": 4,
  "text": "有的人虽然没学历，却是研究客户的顶级高手。",
  "uiIdx": "",
  "range": "800-821",
  "chapterUid": 2
 },
 {
  "level": 4,
  "text": "还有的人极擅长处理人情世故和商务谈判，知道怎么跟供应商周旋、怎么带员工，这些实战经历全都是学习。",
  "uiIdx": "",
  "range": "849-907",
  "chapterUid": 2
 },
 {
  "level": 3,
  "text": "他们更看不见，在同一批没读书的人里，有多少人最终默默无闻甚至处境凄凉，这些失败者被励志故事自动过滤掉了。",
  "uiIdx": "2.2",
  "range": "1002-1054",
  "chapterUid": 2
 },
 {
  "level": 2,
  "text": "对“不读书也能成功”的误解",
  "uiIdx": "3",
  "range": "1158-1189",
  "chapterUid": 2
 },
 {
  "level": 3,
  "text": "一个人赶上了风口，并不意味着后来者照着原来的路子走还能成功",
  "uiIdx": "3.1",
  "range": "1158-1189",
  "chapterUid": 2
 },
 {
  "level": 4,
  "text": "早些年做批发生意、做电商平台或者短视频带货，这些行业在上升期确实让一批人发了财。",
  "uiIdx": "",
  "range": "1118-1158",
  "chapterUid": 2
 },
 {
  "level": 4,
  "text": "现在的市场越来越成熟，规矩多、竞争大，进场的门槛也变得越来越高。",
  "uiIdx": "",
  "range": "1218-1250",
  "chapterUid": 2
 },
 {
  "level": 3,
  "text": "如果一个孩子把“不读书也能当老板”当成自己的人生规划，那他得先老老实实回答几个具体的问题",
  "uiIdx": "3.2",
  "range": "1332-1377",
  "chapterUid": 2
 },
 {
  "level": 4,
  "text": "你会算账吗？合同里的坑你能看出来吗？你知道一个店每天得卖出多少货才能保住本钱吗？",
  "uiIdx": "",
  "range": "1377-1417",
  "chapterUid": 2
 },
 {
  "level": 2,
  "text": "教育的重要性",
  "uiIdx": "4",
  "range": "1725-1768",
  "chapterUid": 2
 },
 {
  "level": 3,
  "text": "教育的本质从来不是要把人死死锁在校园里，而是要培养一个人终身学习和解决实际问题的能力",
  "uiIdx": "4.1",
  "range": "1725-1768",
  "chapterUid": 2
 },
 {
  "level": 4,
  "text": "如果一个人学历不高，但他能坚持读书、虚心请教、不断实践并复盘，他依然有出头之时。",
  "uiIdx": "",
  "range": "1619-1659",
  "chapterUid": 2
 },
 {
  "level": 4,
  "text": "反过来，如果一个人学历不错，却从此停止了进步，眼高手低，照样会被时代淘汰。",
  "uiIdx": "",
  "range": "1688-1725",
  "chapterUid": 2
 },
 {
  "level": 2,
  "text": "对于普通家庭孩子的建议",
  "uiIdx": "5",
  "range": "1797-1836",
  "chapterUid": 2
 },
 {
  "level": 3,
  "text": "最稳妥的策略既不是迷信学历，也不是迷信那些逆袭的神话",
  "uiIdx": "5.1",
  "range": "1797-1836",
  "chapterUid": 2
 },
 {
  "level": 4,
  "text": "更现实的做法是：能读书的时候，尽量把书读好；如果确实要走职业技能的路子，就把技术练扎实。",
  "uiIdx": "",
  "range": "1836-1880",
  "chapterUid": 2
 },
 {
  "level": 1,
  "text": "7 家长最该讲清楚的社会规则",
  "uiIdx": "",
  "range": "",
  "chapterUid": 2
 },
 {
  "level": 2,
  "text": "家长应如何教育孩子理解社会规则",
  "uiIdx": "1",
  "range": "690-740",
  "chapterUid": 2
 },
 {
  "level": 3,
  "text": "让孩子了解家庭的收支情况，理解劳动的价值",
  "uiIdx": "1.1",
  "range": "690-740",
  "chapterUid": 2
 },
 {
  "level": 4,
  "text": "让孩子看看家里每个月挣多少钱，房贷或房租占多少，水电燃气、吃饭交通又要花掉多少，老人看病和教育支出分别是多少。",
  "uiIdx": "",
  "range": "690-740",
  "chapterUid": 2
 },
 {
  "level": 4,
  "text": "告诉孩子，每一份工作都有其价值，比如同样是一个月干二十六天活，有人每天只是重复体力搬运，工资按件计酬；有人负责设备维修，一旦机器出了故障，全厂的人都得等他解决。",
  "uiIdx": "",
  "range": "874-959",
  "chapterUid": 2
 },
 {
  "level": 3,
  "text": "停止把读书描述成唯一的成功路径，帮助孩子找到一个可以持续积累的方向",
  "uiIdx": "1.2",
  "range": "1141-1213",
  "chapterUid": 2
 },
 {
  "level": 4,
  "text": "如果强行把所有孩子都推向同一个评价标准，只会让一部分孩子过早地产生挫败感，甚至彻底放弃自己。",
  "uiIdx": "",
  "range": "1141-1213",
  "chapterUid": 2
 },
 {
  "level": 4,
  "text": "如果他数学不错，就带他看看工程、数据分析或设备研发等领域。如果他动手能力强，就让他去了解机械、电气、汽修、施工管理等职业。",
  "uiIdx": "",
  "range": "1213-1274",
  "chapterUid": 2
 },
 {
  "level": 3,
  "text": "帮助孩子建立起对劳动的正确态度，尊重每一种劳动",
  "uiIdx": "1.3",
  "range": "1582-1609",
  "chapterUid": 2
 },
 {
  "level": 4,
  "text": "别拿某些职业去吓唬孩子，别说什么“送外卖没出息”。",
  "uiIdx": "",
  "range": "1582-1609",
  "chapterUid": 2
 },
 {
  "level": 4,
  "text": "任何劳动都值得尊重，但你得尽量让自己的劳动变得更有技术含量、更安全。",
  "uiIdx": "",
  "range": "1684-1732",
  "chapterUid": 2
 },
 {
  "level": 3,
  "text": "承认现实，帮助孩子降低起点，找回最基本的能力",
  "uiIdx": "1.4",
  "range": "1954-1981",
  "chapterUid": 2
 },
 {
  "level": 4,
  "text": "如果一个学生连续几年坐在教室里都像听天书一样，他怎么可能因为你的一顿训斥，就突然变得热爱学习了？",
  "uiIdx": "",
  "range": "1901-1954",
  "chapterUid": 2
 },
 {
  "level": 4,
  "text": "这时候，最实际的做法是帮他降低起点，找回最基本的能力。",
  "uiIdx": "",
  "range": "1954-1981",
  "chapterUid": 2
 },
 {
  "level": 1,
  "text": "8 不走学术路也不能停止学习",
  "uiIdx": "",
  "range": "",
  "chapterUid": 2
 },
 {
  "level": 2,
  "text": "不走学术路的孩子也能继续学习",
  "uiIdx": "1",
  "range": "542-601",
  "chapterUid": 2
 },
 {
  "level": 3,
  "text": "不适合搞学术，绝不等于可以理直气壮地放弃学习",
  "uiIdx": "1.1",
  "range": "542-601",
  "chapterUid": 2
 },
 {
  "level": 4,
  "text": "在现实社会中，有太多既有体面收入、又有职业尊严的岗位，并不要求你去做什么高深的学术研究，但却无一例外地要求你保持学习。",
  "uiIdx": "",
  "range": "542-601",
  "chapterUid": 2
 },
 {
  "level": 3,
  "text": "技术工人、厨师、护士、销售、电商运营等各行各业都需要不断学习",
  "uiIdx": "1.2",
  "range": "683-710",
  "chapterUid": 2
 },
 {
  "level": 4,
  "text": "只要一个行业还在发展变化，从业者就一刻也不能停止学习。",
  "uiIdx": "",
  "range": "683-710",
  "chapterUid": 2
 },
 {
  "level": 4,
  "text": "那些停止进化的人，很快就会被困在底层。",
  "uiIdx": "",
  "range": "710-729",
  "chapterUid": 2
 },
 {
  "level": 2,
  "text": "选择职业路线的底线",
  "uiIdx": "2",
  "range": "1297-1311",
  "chapterUid": 2
 },
 {
  "level": 3,
  "text": "尽量拿下一个基本学历",
  "uiIdx": "2.1",
  "range": "1297-1311",
  "chapterUid": 2
 },
 {
  "level": 4,
  "text": "基础教育的意义不只是为了那张文凭，更是为了培养你的阅读、计算和表达能力。",
  "uiIdx": "",
  "range": "1311-1347",
  "chapterUid": 2
 },
 {
  "level": 3,
  "text": "选岗位要看能不能积累技能",
  "uiIdx": "2.2",
  "range": "1376-1392",
  "chapterUid": 2
 },
 {
  "level": 4,
  "text": "如果一个岗位只需要你做重复动作，干了半年还跟第一天上班没什么两样，那你就要警惕了。",
  "uiIdx": "",
  "range": "1392-1433",
  "chapterUid": 2
 },
 {
  "level": 4,
  "text": "即便暂时为了生计在做，也要想方设法往那些有技术含量、有规范流程的方向靠拢。",
  "uiIdx": "",
  "range": "1433-1470",
  "chapterUid": 2
 },
 {
  "level": 3,
  "text": "一定要重视证书和作品",
  "uiIdx": "2.3",
  "range": "1499-1513",
  "chapterUid": 2
 },
 {
  "level": 4,
  "text": "很多行当都是看“牌照”说话的。电工、焊工、叉车、护理、会计，这些领域都有不同等级的证书要求。",
  "uiIdx": "",
  "range": "1513-1559",
  "chapterUid": 2
 },
 {
  "level": 4,
  "text": "搞设计、剪辑、装修的，拿得出手的真实成果就是你最好的名片。",
  "uiIdx": "",
  "range": "1559-1588",
  "chapterUid": 2
 },
 {
  "level": 3,
  "text": "找一个愿意教人的环境",
  "uiIdx": "2.4",
  "range": "1617-1631",
  "chapterUid": 2
 },
 {
  "level": 4,
  "text": "刚入行的时候，别把工资当成唯一的衡量标准。",
  "uiIdx": "",
  "range": "1631-1652",
  "chapterUid": 2
 },
 {
  "level": 4,
  "text": "如果一个地方能让你学到规范的流程，能让你接触到复杂的任务，还有前辈愿意带带你，那么前期少赚点钱其实并不亏。",
  "uiIdx": "",
  "range": "1652-1705",
  "chapterUid": 2
 },
 {
  "level": 3,
  "text": "保留阅读和记录的习惯",
  "uiIdx": "2.5",
  "range": "1734-1748",
  "chapterUid": 2
 },
 {
  "level": 4,
  "text": "很多技术的进阶都藏在细节里。今天修好了一个故障，随手记下原因和处理方法。",
  "uiIdx": "",
  "range": "1748-1784",
  "chapterUid": 2
 },
 {
  "level": 4,
  "text": "今天被客户投诉了，复盘一下沟通出了什么问题。这些点滴的记录最后都会化作你的经验。",
  "uiIdx": "",
  "range": "1784-1824",
  "chapterUid": 2
 },
 {
  "level": 2,
  "text": "不走学术路线的孩子如何接触真实行业",
  "uiIdx": "3",
  "range": "1877-1895",
  "chapterUid": 2
 },
 {
  "level": 3,
  "text": "去实习，去工厂实地看看，去门店转转",
  "uiIdx": "3.1",
  "range": "1877-1895",
  "chapterUid": 2
 },
 {
  "level": 4,
  "text": "千万不要只凭脑子里的想象去选专业，更不要被短视频里那些“轻轻松松赚大钱”的画面给带偏了。",
  "uiIdx": "",
  "range": "1895-1939",
  "chapterUid": 2
 },
 {
  "level": 3,
  "text": "很多看起来“赚钱轻松”的行业，背后其实都经过了高强度的训练",
  "uiIdx": "3.2",
  "range": "1968-1998",
  "chapterUid": 2
 },
 {
  "level": 4,
  "text": "主播得懂内容策划、供应链管理；摄影师得精通器材、构图、后期修图。",
  "uiIdx": "",
  "range": "1998-2030",
  "chapterUid": 2
 },
 {
  "level": 4,
  "text": "健身教练得钻研人体解剖、课程设计。",
  "uiIdx": "",
  "range": "2030-2047",
  "chapterUid": 2
 },
 {
  "level": 2,
  "text": "家长如何帮助孩子做好职业规划",
  "uiIdx": "4",
  "range": "2132-2146",
  "chapterUid": 2
 },
 {
  "level": 3,
  "text": "帮孩子问清楚：到底想学什么？去哪儿学？多久能入门？要考什么证？就业岗位有哪些？三年后怎么升级？",
  "uiIdx": "4.1",
  "range": "2132-2146",
  "chapterUid": 2
 },
 {
  "level": 4,
  "text": "这绝不叫放任自流，而是换一种形式，让学习继续下去。",
  "uiIdx": "",
  "range": "2208-2233",
  "chapterUid": 2
 },
 {
  "level": 3,
  "text": "社会其实需要各行各业的人，既需要学者，也需要技师、厨师、维修工、销售",
  "uiIdx": "4.2",
  "range": "2233-2268",
  "chapterUid": 2
 },
 {
  "level": 4,
  "text": "问题的关键不在于孩子未来必须选哪条路，而在于他选的那条路，能不能让他看到成长。",
  "uiIdx": "",
  "range": "2268-2307",
  "chapterUid": 2
 },
 {
  "level": 1,
  "text": "9 短视频 游戏和难以持续的注意力",
  "uiIdx": "",
  "range": "",
  "chapterUid": 2
 },
 {
  "level": 2,
  "text": "短视频、游戏和难以持续的注意力",
  "uiIdx": "1",
  "range": "372-389",
  "chapterUid": 2
 },
 {
  "level": 3,
  "text": "现在的孩子面对的诱惑，比我们那一代人要密集得多",
  "uiIdx": "1.1",
  "range": "450-473",
  "chapterUid": 2
 },
 {
  "level": 4,
  "text": "手机里塞满了短视频、游戏、直播。看一个视频只要十几秒，拿一个游戏奖励只要几分钟。",
  "uiIdx": "",
  "range": "473-513",
  "chapterUid": 2
 },
 {
  "level": 4,
  "text": "相比之下，学习这件事显得太慢、太难，而且反馈周期实在太长了。",
  "uiIdx": "",
  "range": "542-572",
  "chapterUid": 2
 },
 {
  "level": 3,
  "text": "学习本质上需要的是“连续注意力”",
  "uiIdx": "1.2",
  "range": "695-712",
  "chapterUid": 2
 },
 {
  "level": 4,
  "text": "无论是读完一篇文章、解出一道难题，都需要一段完整且不被打断的时间。",
  "uiIdx": "",
  "range": "712-745",
  "chapterUid": 2
 },
 {
  "level": 4,
  "text": "如果一个人的注意力长期被高频刺激占据，他就很难再静下心。",
  "uiIdx": "",
  "range": "745-773",
  "chapterUid": 2
 },
 {
  "level": 2,
  "text": "娱乐失去了边界，导致学习被挤到了全天最疲惫、最零碎的时间段里",
  "uiIdx": "2",
  "range": "948-989",
  "chapterUid": 2
 },
 {
  "level": 3,
  "text": "一个学生如果每天刷短视频两小时，一年下来就是七百多个小时",
  "uiIdx": "2.1",
  "range": "802-840",
  "chapterUid": 2
 },
 {
  "level": 4,
  "text": "这些时间，足够把英语基础彻底补上一轮，足够学会一门编程入门课。",
  "uiIdx": "",
  "range": "862-893",
  "chapterUid": 2
 },
 {
  "level": 3,
  "text": "很多家庭在处理手机问题时，往往只剩下两个极端的动作",
  "uiIdx": "2.2",
  "range": "989-1015",
  "chapterUid": 2
 },
 {
  "level": 4,
  "text": "要么是完全撒手不管，要么是突然爆发、强行没收，结果引发激烈的家庭对抗。",
  "uiIdx": "",
  "range": "1044-1079",
  "chapterUid": 2
 },
 {
  "level": 2,
  "text": "注意力是需要“环境呵护”的",
  "uiIdx": "3",
  "range": "1164-1178",
  "chapterUid": 2
 },
 {
  "level": 3,
  "text": "如果一个孩子坐在书桌前，手机就摆在手边，屏幕一亮，他几乎不可能忍住不去瞄一眼",
  "uiIdx": "3.1",
  "range": "1178-1217",
  "chapterUid": 2
 },
 {
  "level": 4,
  "text": "很多所谓的“不自律”，其实本质上是环境安排的失败。",
  "uiIdx": "",
  "range": "1217-1242",
  "chapterUid": 2
 },
 {
  "level": 4,
  "text": "把干扰源拿得远一点，往往比讲大道理管用。",
  "uiIdx": "",
  "range": "1242-1262",
  "chapterUid": 2
 },
 {
  "level": 2,
  "text": "学校里的学习也必须和现实生活建立起连接",
  "uiIdx": "4",
  "range": "1291-1314",
  "chapterUid": 2
 },
 {
  "level": 3,
  "text": "如果孩子长期觉得学这些东西没用，他自然更容易被那些即时娱乐勾走魂儿",
  "uiIdx": "4.1",
  "range": "1314-1348",
  "chapterUid": 2
 },
 {
  "level": 4,
  "text": "家长和老师需要不断地把知识和生活挂钩：数学关乎工资、利息；语文关乎合同签署、自我表达。",
  "uiIdx": "",
  "range": "1348-1391",
  "chapterUid": 2
 },
 {
  "level": 4,
  "text": "只有当孩子亲眼看到学习能够解释现实世界时，他才更有动力去忍受学习过程中的那份枯燥与缓慢。",
  "uiIdx": "",
  "range": "1420-1464",
  "chapterUid": 2
 },
 {
  "level": 2,
  "text": "很多孩子之所以“不学好”，是因为落下的功课实在太多了",
  "uiIdx": "5",
  "range": "1464-1500",
  "chapterUid": 2
 },
 {
  "level": 3,
  "text": "课堂上像听天书，作业一个字写不出",
  "uiIdx": "5.1",
  "range": "1500-1517",
  "chapterUid": 2
 },
 {
  "level": 4,
  "text": "这时候，游戏就成了最现成的避难所，毕竟游戏里规则明确、奖励及时。",
  "uiIdx": "",
  "range": "1546-1578",
  "chapterUid": 2
 },
 {
  "level": 4,
  "text": "如果当家长的只知道盯着“沉迷”两个字开骂，却不去帮孩子把落下的基础补上，这死结根本解不开。",
  "uiIdx": "",
  "range": "1578-1623",
  "chapterUid": 2
 },
 {
  "level": 4,
  "text": "想让孩子重新找回学习的状态，要从简单的任务开始，与其逼他一天背两百个单词，不如每天实实在在地背二十个；与其要求他立马写出高分作文，不如先让他每天静下心读二十分钟书。",
  "uiIdx": "",
  "range": "1623-1705",
  "chapterUid": 2
 },
 {
  "level": 4,
  "text": "人的注意力和肌肉是一个道理，得循序渐进地练，指望一个长期散漫的人突然变强是不现实的。",
  "uiIdx": "",
  "range": "1705-1747",
  "chapterUid": 2
 },
 {
  "level": 2,
  "text": "游戏也并非一无是处，它确实能锻炼人的反应力、协作能力，但这一切都有个大前提：时间得控得住",
  "uiIdx": "6",
  "range": "1790-1825",
  "chapterUid": 2
 },
 {
  "level": 3,
  "text": "如果一个孩子拿游戏当挡箭牌，拒绝面对现实里所有的任务，那这就不叫兴趣爱好，而是他选择了逃避",
  "uiIdx": "6.1",
  "range": "1825-1871",
  "chapterUid": 2
 },
 {
  "level": 4,
  "text": "相比之下，短视频更值得警惕。它最擅长给人制造一种“我懂了”的幻觉。",
  "uiIdx": "",
  "range": "1900-1933",
  "chapterUid": 2
 },
 {
  "level": 4,
  "text": "刷过几个职场段子、听了几句人生导师的建议，并不等于你就掌握了这些本事。",
  "uiIdx": "",
  "range": "1933-1968",
  "chapterUid": 2
 },
 {
  "level": 4,
  "text": "真正的技能，必须经过反复的练习、不断的纠正和实际的应用。",
  "uiIdx": "",
  "range": "1968-1996",
  "chapterUid": 2
 },
 {
  "level": 2,
  "text": "在少年时代，最值钱的宝贝从来不是什么新款手机，而是那段可以由自己支配、持续投入的时间",
  "uiIdx": "7",
  "range": "2025-2068",
  "chapterUid": 2
 },
 {
  "level": 3,
  "text": "一个人从十五岁到二十二岁这黄金七年，如果能沉下心磨炼专业技能，往后的路会越走越宽",
  "uiIdx": "7.1",
  "range": "2068-2109",
  "chapterUid": 2
 },
 {
  "level": 4,
  "text": "当家长的要管手机，但眼光不能只盯着手机。",
  "uiIdx": "",
  "range": "2138-2158",
  "chapterUid": 2
 },
 {
  "level": 4,
  "text": "你还得帮孩子把生活充实起来，运动、阅读、做家务、现实社交，都得安排上。",
  "uiIdx": "",
  "range": "2158-2193",
  "chapterUid": 2
 },
 {
  "level": 4,
  "text": "一个孩子的生活如果是一片荒芜，手机自然会趁虚而入；只有现实里的任务清晰了，手机才会回到娱乐位置。",
  "uiIdx": "",
  "range": "2193-2241",
  "chapterUid": 2
 },
 {
  "level": 4,
  "text": "真正的自律，从来不是靠每天喊几句热血口号，而是把生活节奏理顺。",
  "uiIdx": "",
  "range": "2270-2301",
  "chapterUid": 2
 },
 {
  "level": 4,
  "text": "固定的作息、明确的任务、减少外界干扰、适度的娱乐。这些招数听着挺土，但比家长偶尔发一通火要管用得多。",
  "uiIdx": "",
  "range": "2301-2351",
  "chapterUid": 2
 },
 {
  "level": 1,
  "text": "10 把选择权留到三十岁以后",
  "uiIdx": "",
  "range": "",
  "chapterUid": 2
 },
 {
  "level": 2,
  "text": "选择权的重要性",
  "uiIdx": "1",
  "range": "658-690",
  "chapterUid": 2
 },
 {
  "level": 3,
  "text": "选择权是面对危险工作、拖欠工资、行业下坡路、身体熬不动夜等困境时的底气",
  "uiIdx": "1.1",
  "range": "658-690",
  "chapterUid": 2
 },
 {
  "level": 4,
  "text": "选择权是当你面对一份危险的工作时，有底气说不，因为你知道别处还有岗。",
  "uiIdx": "",
  "range": "658-690",
  "chapterUid": 2
 },
 {
  "level": 4,
  "text": "是老板成天拖欠工资时，你敢抬腿就走。",
  "uiIdx": "",
  "range": "690-708",
  "chapterUid": 2
 },
 {
  "level": 4,
  "text": "是行业走下坡路时，你还有本事学新技术。",
  "uiIdx": "",
  "range": "708-727",
  "chapterUid": 2
 },
 {
  "level": 4,
  "text": "是身体熬不动夜了，你能顺理成章换到白班或技术岗。",
  "uiIdx": "",
  "range": "727-751",
  "chapterUid": 2
 },
 {
  "level": 2,
  "text": "读书和学习对选择权的影响",
  "uiIdx": "2",
  "range": "780-807",
  "chapterUid": 2
 },
 {
  "level": 3,
  "text": "读书和学习是在年轻时给具体的选择攒点筹码",
  "uiIdx": "2.1",
  "range": "780-807",
  "chapterUid": 2
 },
 {
  "level": 4,
  "text": "多考一个证，多练一项技能，多参加一次实习，往后的腾挪空间都会大一点。",
  "uiIdx": "",
  "range": "836-870",
  "chapterUid": 2
 },
 {
  "level": 3,
  "text": "读书是为了以后在社会上，少一些被人随意定价、任人挑拣的时刻",
  "uiIdx": "2.2",
  "range": "944-990",
  "chapterUid": 2
 },
 {
  "level": 4,
  "text": "你可以不当学霸，但起码要把基础学业完成。",
  "uiIdx": "",
  "range": "1019-1039",
  "chapterUid": 2
 },
 {
  "level": 4,
  "text": "你可以没考上名校，但手里总得攥着一项能进场交易的技能。",
  "uiIdx": "",
  "range": "1039-1066",
  "chapterUid": 2
 },
 {
  "level": 4,
  "text": "哪怕你将来打算干体力活，也最好让这份活儿带有技术含量、有证书加持、有经验积累。",
  "uiIdx": "",
  "range": "1066-1105",
  "chapterUid": 2
 },
 {
  "level": 2,
  "text": "小决定积累成大选择",
  "uiIdx": "3",
  "range": "1134-1172",
  "chapterUid": 2
 },
 {
  "level": 3,
  "text": "普通人的路，大多时候并不怎么华丽，它其实是由一连串不起眼的小决定拼凑出来的",
  "uiIdx": "3.1",
  "range": "1134-1172",
  "chapterUid": 2
 },
 {
  "level": 4,
  "text": "今天少刷一小时手机，今天弄懂一道难题，今天背下一个单词。",
  "uiIdx": "",
  "range": "1172-1200",
  "chapterUid": 2
 },
 {
  "level": 4,
  "text": "这些事单看都没什么了不起，可长年累月攒下来，就能决定你最后能站上什么样的岗位。",
  "uiIdx": "",
  "range": "1200-1239",
  "chapterUid": 2
 },
 {
  "level": 3,
  "text": "一个人的放弃也是由一连串小决定构成的",
  "uiIdx": "3.2",
  "range": "1268-1293",
  "chapterUid": 2
 },
 {
  "level": 4,
  "text": "今天不写作业，明天不听课，考试随随便便应付。",
  "uiIdx": "",
  "range": "1293-1315",
  "chapterUid": 2
 },
 {
  "level": 4,
  "text": "几年一过，你可能会突然发现自己被推到了一个极其被动的位置。",
  "uiIdx": "",
  "range": "1315-1344",
  "chapterUid": 2
 },
 {
  "level": 4,
  "text": "这种处境不是哪一天突然造成的，而是无数个得过且过的日子堆出来的。",
  "uiIdx": "",
  "range": "1344-1376",
  "chapterUid": 2
 },
 {
  "level": 2,
  "text": "成年人的学习机会",
  "uiIdx": "4",
  "range": "1414-1442",
  "chapterUid": 2
 },
 {
  "level": 3,
  "text": "二十五岁以后再开始补课、考证、学技术，什么时候都不算晚",
  "uiIdx": "4.1",
  "range": "1414-1442",
  "chapterUid": 2
 },
 {
  "level": 4,
  "text": "但咱们得承认，年纪越大确实越难。",
  "uiIdx": "",
  "range": "1442-1458",
  "chapterUid": 2
 },
 {
  "level": 4,
  "text": "时间被工作切得细碎，精力被生活琐事占满。",
  "uiIdx": "",
  "range": "1458-1478",
  "chapterUid": 2
 },
 {
  "level": 4,
  "text": "所以说，积累这事儿越早开始，成本就越低。",
  "uiIdx": "",
  "range": "1478-1498",
  "chapterUid": 2
 },
 {
  "level": 2,
  "text": "社会的责任与个人的积累",
  "uiIdx": "5",
  "range": "1565-1576",
  "chapterUid": 2
 },
 {
  "level": 3,
  "text": "社会也得承担起该有的责任，尊重劳动不能光靠嘴说",
  "uiIdx": "5.1",
  "range": "1565-1576",
  "chapterUid": 2
 },
 {
  "level": 4,
  "text": "干体力活的人需要更完善的保障、更公平的报酬。",
  "uiIdx": "",
  "range": "1543-1565",
  "chapterUid": 2
 },
 {
  "level": 4,
  "text": "如果一个社会让最辛苦的人长期得不到保障，那这种问题绝不该只让个人去扛。",
  "uiIdx": "",
  "range": "1576-1641",
  "chapterUid": 2
 },
 {
  "level": 4,
  "text": "对于普通家庭的孩子来说，等社会变好，不能代替你自己的积累。",
  "uiIdx": "",
  "range": "1576-1641",
  "chapterUid": 2
 },
 {
  "level": 3,
  "text": "你能做的，就是尽量让自己多长点本事，争取进入更有成长性的岗位",
  "uiIdx": "5.2",
  "range": "1666-1697",
  "chapterUid": 2
 },
 {
  "level": 4,
  "text": "一个普通人能给自己准备的最好退路，就是让能力一点点见长。",
  "uiIdx": "",
  "range": "2196-2279",
  "chapterUid": 2
 },
 {
  "level": 4,
  "text": "让工作经验能像滚雪球一样积累。",
  "uiIdx": "",
  "range": "2196-2279",
  "chapterUid": 2
 },
 {
  "level": 4,
  "text": "让收入来源不只靠出卖体力。",
  "uiIdx": "",
  "range": "2196-2279",
  "chapterUid": 2
 },
 {
  "level": 4,
  "text": "让自己到了三十岁以后，依然拥有随时调整人生方向的底气。",
  "uiIdx": "",
  "range": "2196-2279",
  "chapterUid": 2
 },
 {
  "level": 2,
  "text": "男孩的教育与未来",
  "uiIdx": "6",
  "range": "1741-1769",
  "chapterUid": 2
 },
 {
  "level": 3,
  "text": "男性往往被寄予了更多关于收入和责任的期待",
  "uiIdx": "6.1",
  "range": "1741-1769",
  "chapterUid": 2
 },
 {
  "level": 4,
  "text": "如果一个男孩在年少时只顾着贪图安逸，等步入成年，他很可能得花上几倍的时间去填以前落下的坑。",
  "uiIdx": "",
  "range": "1769-1814",
  "chapterUid": 2
 },
 {
  "level": 3,
  "text": "作为家长，教育方式也得变一变",
  "uiIdx": "6.2",
  "range": "1843-1858",
  "chapterUid": 2
 },
 {
  "level": 4,
  "text": "别只知道把孩子死死按在书桌前，得带他去看看真实的世界。",
  "uiIdx": "",
  "range": "1858-1896",
  "chapterUid": 2
 },
 {
  "level": 4,
  "text": "要告诉他，读书并不是为了高人一等，而是为了将来即便过着平凡的生活，手里也能有更多的筹码。",
  "uiIdx": "",
  "range": "1896-1940",
  "chapterUid": 2
 },
 {
  "level": 4,
  "text": "如果孩子现在已经落后了，也别急着否定，就从今天能上手的琐事做起。",
  "uiIdx": "",
  "range": "1969-2001",
  "chapterUid": 2
 },
 {
  "level": 4,
  "text": "现实的转机往往是从微小的改变开始的，关键在于能不能坚持下去。",
  "uiIdx": "",
  "range": "2034-2064",
  "chapterUid": 2
 }
]