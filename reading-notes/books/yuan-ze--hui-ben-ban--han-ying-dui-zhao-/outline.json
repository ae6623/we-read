[
 {
  "level": 1,
  "text": "作者简介",
  "uiIdx": "",
  "range": "",
  "chapterUid": 2
 },
 {
  "level": 2,
  "text": "瑞·达利欧简介",
  "uiIdx": "1",
  "range": "460-472",
  "chapterUid": 2
 },
 {
  "level": 3,
  "text": "美国桥水投资公司创始人",
  "uiIdx": "1.1",
  "range": "460-472",
  "chapterUid": 2
 },
 {
  "level": 4,
  "text": "他出生于纽约长岛一个非常普通的中产家庭，26岁时在自己的两居室公寓内创办了桥水。",
  "uiIdx": "",
  "range": "472-512",
  "chapterUid": 2
 },
 {
  "level": 3,
  "text": "《时代周刊》世界100位最具影响力人物，《福布斯》美国最慷慨的50位慈善家之一",
  "uiIdx": "1.2",
  "range": "550-597",
  "chapterUid": 2
 },
 {
  "level": 4,
  "text": "经过40多年的发展，桥水跻身美国最重要的私营公司榜单第五位(《财富》杂志)。",
  "uiIdx": "",
  "range": "512-550",
  "chapterUid": 2
 },
 {
  "level": 3,
  "text": "《原则》一书作者",
  "uiIdx": "1.3",
  "range": "597-659",
  "chapterUid": 2
 },
 {
  "level": 4,
  "text": "2017年，瑞基于自己的生活和工作经历而撰写的《原则》一书广受好评，在中国大陆上市半年内即畅销百万册，登上各大商业畅销书榜。",
  "uiIdx": "",
  "range": "597-659",
  "chapterUid": 2
 },
 {
  "level": 1,
  "text": "文前",
  "uiIdx": "",
  "range": "",
  "chapterUid": 5
 },
 {
  "level": 2,
  "text": "独立思考，并保证头脑极度开放",
  "uiIdx": "1",
  "range": "730-744",
  "chapterUid": 5
 },
 {
  "level": 3,
  "text": "时间就像一条河流，推着我们前行，途中会与现实相遇，需要我们做出决策",
  "uiIdx": "1.1",
  "range": "861-911",
  "chapterUid": 5
 },
 {
  "level": 4,
  "text": "我们无法停止前行，也无法回避现实。",
  "uiIdx": "",
  "range": "1319-1336",
  "chapterUid": 5
 },
 {
  "level": 4,
  "text": "我们只能以最好的方式应对现实。",
  "uiIdx": "",
  "range": "1659-1674",
  "chapterUid": 5
 },
 {
  "level": 3,
  "text": "决定的质量将决定你的生活质量",
  "uiIdx": "1.2",
  "range": "1992-2007",
  "chapterUid": 5
 },
 {
  "level": 4,
  "text": "好的决定会带给你好的结果，糟糕的决定则会伤害你。",
  "uiIdx": "",
  "range": "2036-2060",
  "chapterUid": 5
 },
 {
  "level": 3,
  "text": "如果你够聪明，你所遇到的事将教会你现实是如何运作的，并教给你一些原则，以更好地应对现实",
  "uiIdx": "1.3",
  "range": "2599-2643",
  "chapterUid": 5
 },
 {
  "level": 4,
  "text": "起初，我并没有这些原则。我是从一生的经历当中获得了这些原则——主要是通过犯错误和反思错误。",
  "uiIdx": "",
  "range": "3021-3066",
  "chapterUid": 5
 },
 {
  "level": 2,
  "text": "知道真相是什么，至关重要",
  "uiIdx": "2",
  "range": "6073-6095",
  "chapterUid": 5
 },
 {
  "level": 3,
  "text": "知道真相是什么，也就是知道现实是如何运行的",
  "uiIdx": "2.1",
  "range": "6073-6095",
  "chapterUid": 5
 },
 {
  "level": 4,
  "text": "为了成功，我们必须遵循自然法则，这些自然法则并不是由人类创造的，但如果我们能理解这些自然法则，就能利用它们来实现自己的目标。",
  "uiIdx": "",
  "range": "6095-6157",
  "chapterUid": 5
 },
 {
  "level": 3,
  "text": "这让我成为一个超级现实的人：拥抱现实并妥善应对现实，而不是否定现实，还抱怨现实不如自己的意",
  "uiIdx": "2.2",
  "range": "6438-6484",
  "chapterUid": 5
 },
 {
  "level": 4,
  "text": "要想做出好的决定，知道真相是什么，至关重要。",
  "uiIdx": "",
  "range": "5740-5762",
  "chapterUid": 5
 },
 {
  "level": 2,
  "text": "梦想+现实+决心=成功的生活",
  "uiIdx": "3",
  "range": "6848-6862",
  "chapterUid": 5
 },
 {
  "level": 3,
  "text": "如果你能一直专注于实现自己的梦想，主动去理解对你有影响的现实，找到应对现实的方法，并且有决心付诸实践，那么你就会学到通往成功的原则",
  "uiIdx": "3.1",
  "range": "7165-7236",
  "chapterUid": 5
 },
 {
  "level": 4,
  "text": "我们每个人都必须自己决定什么是成功的生活。",
  "uiIdx": "",
  "range": "8025-8046",
  "chapterUid": 5
 },
 {
  "level": 4,
  "text": "你想要什么完全取决于你自己。我只是想让你快乐、健康，自己进化的同时，也为人类进化做出贡献。",
  "uiIdx": "",
  "range": "8324-8369",
  "chapterUid": 5
 },
 {
  "level": 4,
  "text": "然而，无论选择哪条道路，你都必须去拥抱现实……尤其是那些你但愿从未发生的现实。",
  "uiIdx": "",
  "range": "8747-8770",
  "chapterUid": 5
 },
 {
  "level": 4,
  "text": "一开始，我的问题、错误和弱点让我很痛苦，主要是因为我陷入了不想面对它们的情绪。",
  "uiIdx": "",
  "range": "9203-9242",
  "chapterUid": 5
 },
 {
  "level": 4,
  "text": "后来，我意识到这些痛苦是一种信号，提醒我需要反思自己的现状，以及反思如何最好地应对现实。",
  "uiIdx": "",
  "range": "9427-9471",
  "chapterUid": 5
 },
 {
  "level": 4,
  "text": "那时我才明白:痛苦 +反思=进步。",
  "uiIdx": "",
  "range": "9975-9984",
  "chapterUid": 5
 },
 {
  "level": 4,
  "text": "认识到这些，我发现通向成功需要遵循“五步流程”。",
  "uiIdx": "",
  "range": "10263-10287",
  "chapterUid": 5
 },
 {
  "level": 1,
  "text": "第一步 目标",
  "uiIdx": "",
  "range": "",
  "chapterUid": 5
 },
 {
  "level": 2,
  "text": "了解并实现目标",
  "uiIdx": "1",
  "range": "494-552",
  "chapterUid": 5
 },
 {
  "level": 3,
  "text": "决定目标的先后顺序",
  "uiIdx": "1.1",
  "range": "494-552",
  "chapterUid": 5
 },
 {
  "level": 4,
  "text": "什么对你是最好的，取决于你的兴趣、优势、弱点。",
  "uiIdx": "",
  "range": "494-552",
  "chapterUid": 5
 },
 {
  "level": 3,
  "text": "找到适合自己的目标",
  "uiIdx": "1.2",
  "range": "494-552",
  "chapterUid": 5
 },
 {
  "level": 4,
  "text": "你需要真正了解自己，找到适合自己的目标，从而决定自己的人生道路。",
  "uiIdx": "",
  "range": "494-552",
  "chapterUid": 5
 },
 {
  "level": 3,
  "text": "在反复试错中学习，并下定决心去实现自己的目标",
  "uiIdx": "1.3",
  "range": "552-602",
  "chapterUid": 5
 },
 {
  "level": 4,
  "text": "前方总有适合你的精彩道路，要找到它们，你只需好好反思，在反复试错中学习，并下定决心去实现自己的目标。",
  "uiIdx": "",
  "range": "552-602",
  "chapterUid": 5
 },
 {
  "level": 1,
  "text": "STEP 1 GOALS",
  "uiIdx": "",
  "range": "",
  "chapterUid": 5
 },
 {
  "level": 2,
  "text": "确定目标",
  "uiIdx": "1",
  "range": "378-384",
  "chapterUid": 5
 },
 {
  "level": 3,
  "text": "知道你的目标并为之努力",
  "uiIdx": "1.1",
  "range": "378-384",
  "chapterUid": 5
 },
 {
  "level": 4,
  "text": "你可以选择任何你想要的东西，但不能拥有所有你想要的，所以你需要做出一些决定。",
  "uiIdx": "",
  "range": "378-384",
  "chapterUid": 5
 },
 {
  "level": 3,
  "text": "根据你的激情、强项和弱点来确定你的优先事项",
  "uiIdx": "1.2",
  "range": "378-384",
  "chapterUid": 5
 },
 {
  "level": 4,
  "text": "你需要真正了解自己，并了解如何将你的目标与你自己的特点相匹配，以确定你的人生道路。",
  "uiIdx": "",
  "range": "378-384",
  "chapterUid": 5
 },
 {
  "level": 3,
  "text": "通过反思、尝试和决心来找到你的道路",
  "uiIdx": "1.3",
  "range": "378-384",
  "chapterUid": 5
 },
 {
  "level": 4,
  "text": "总有美好的道路等待着你，你只需要通过良好的反思、尝试和决心来找到它们。",
  "uiIdx": "",
  "range": "378-384",
  "chapterUid": 5
 },
 {
  "level": 1,
  "text": "STEP 2 PROBLEMS",
  "uiIdx": "",
  "range": "",
  "chapterUid": 9
 },
 {
  "level": 2,
  "text": "问题的存在",
  "uiIdx": "1",
  "range": "378-384",
  "chapterUid": 9
 },
 {
  "level": 3,
  "text": "问题是阻碍我们实现目标的障碍",
  "uiIdx": "1.1",
  "range": "378-384",
  "chapterUid": 9
 },
 {
  "level": 4,
  "text": "问题通常带来痛苦，但也是成长的契机。",
  "uiIdx": "",
  "range": "378-384",
  "chapterUid": 9
 },
 {
  "level": 3,
  "text": "我们需要识别并解决这些问题",
  "uiIdx": "1.2",
  "range": "378-384",
  "chapterUid": 9
 },
 {
  "level": 4,
  "text": "进化需要识别并解决问题，而不是逃避。",
  "uiIdx": "",
  "range": "378-384",
  "chapterUid": 9
 },
 {
  "level": 1,
  "text": "第三步 诊断",
  "uiIdx": "",
  "range": "",
  "chapterUid": 9
 },
 {
  "level": 2,
  "text": "准确诊断问题，找到问题的根源",
  "uiIdx": "1",
  "range": "430-449",
  "chapterUid": 9
 },
 {
  "level": 3,
  "text": "有时，你或他人的弱点就是问题的根源",
  "uiIdx": "1.1",
  "range": "480-517",
  "chapterUid": 9
 },
 {
  "level": 4,
  "text": "在你的进化过程中，你需要了解自己在哪些方面做得不好，并做出相应改变。",
  "uiIdx": "",
  "range": "480-517",
  "chapterUid": 9
 },
 {
  "level": 3,
  "text": "不管问题是什么，你都需要找到并解决它。",
  "uiIdx": "1.2",
  "range": "517-536",
  "chapterUid": 9
 },
 {
  "level": 1,
  "text": "STEP 3 DIAGNOSIS",
  "uiIdx": "",
  "range": "",
  "chapterUid": 9
 },
 {
  "level": 2,
  "text": "诊断问题以找到根本原因",
  "uiIdx": "1",
  "range": "378-384",
  "chapterUid": 9
 },
 {
  "level": 3,
  "text": "考虑自身或他人的弱点可能是问题的原因",
  "uiIdx": "1.1",
  "range": "378-384",
  "chapterUid": 9
 },
 {
  "level": 4,
  "text": "这个进化旅程要求你学习自己不擅长的事情，并改变。",
  "uiIdx": "",
  "range": "378-384",
  "chapterUid": 9
 },
 {
  "level": 3,
  "text": "需要找出问题并解决它",
  "uiIdx": "1.2",
  "range": "378-384",
  "chapterUid": 9
 },
 {
  "level": 4,
  "text": "无论是什么问题，你都需要找到它并解决它。",
  "uiIdx": "",
  "range": "378-384",
  "chapterUid": 9
 },
 {
  "level": 1,
  "text": "STEP 5 DO IT",
  "uiIdx": "",
  "range": "",
  "chapterUid": 15
 },
 {
  "level": 2,
  "text": "执行设计，推动自己前进",
  "uiIdx": "1",
  "range": "749-785",
  "chapterUid": 15
 },
 {
  "level": 3,
  "text": "做好五步自然会经历起伏，也会取得进步",
  "uiIdx": "1.1",
  "range": "749-785",
  "chapterUid": 15
 },
 {
  "level": 4,
  "text": "进化过程看上去就像这样：A successful life consists of doing these five steps over and over again. Doing them well will naturally create the ups and downs and improvements that lead to your personal evolution to higher levels of success.",
  "uiIdx": "",
  "range": "785-1043",
  "chapterUid": 15
 },
 {
  "level": 3,
  "text": "你爬得越高，跌得也就越重",
  "uiIdx": "1.2",
  "range": "2463-2479",
  "chapterUid": 15
 },
 {
  "level": 4,
  "text": "当然，你爬得越高，跌得也就越重。Of course as the heights get greater, the falls get greater, too.",
  "uiIdx": "",
  "range": "2463-2573",
  "chapterUid": 15
 },
 {
  "level": 2,
  "text": "面对挫折，客观面对并做出正确决定",
  "uiIdx": "2",
  "range": "2813-2842",
  "chapterUid": 15
 },
 {
  "level": 3,
  "text": "我们每个人都会遭遇挫折，它们有可能毁了我们……也有可能极大程度地帮助我们进步，这取决于我们如何应对挫折",
  "uiIdx": "2.1",
  "range": "2813-2842",
  "chapterUid": 15
 },
 {
  "level": 4,
  "text": "terrible things happen to all of us. Depending on how we handle them, they can ruin us...or they can profoundly improve us.",
  "uiIdx": "",
  "range": "2871-2958",
  "chapterUid": 15
 },
 {
  "level": 3,
  "text": "我们是渡过难关还是一蹶不振，这取决于我们是否愿意客观地面对失败，并做出正确的决定",
  "uiIdx": "2.2",
  "range": "3211-3252",
  "chapterUid": 15
 },
 {
  "level": 4,
  "text": "Whether we get through them or spiral downward depends on whether we’re willing to face the failure objectively and make the right decisions.",
  "uiIdx": "",
  "range": "3281-3422",
  "chapterUid": 15
 },
 {
  "level": 2,
  "text": "经历失败，反思并找到前进之路",
  "uiIdx": "3",
  "range": "3656-3686",
  "chapterUid": 15
 },
 {
  "level": 3,
  "text": "1982年，我经历了一次重大失败，我错误地预测经济大萧条即将到来，并把全副身家押注于此",
  "uiIdx": "3.1",
  "range": "3656-3686",
  "chapterUid": 15
 },
 {
  "level": 4,
  "text": "当时，市场极度动荡，我认为美国经济以及与之紧密挂钩的世界经济，即将陷入危机。",
  "uiIdx": "",
  "range": "3715-3753",
  "chapterUid": 15
 },
 {
  "level": 4,
  "text": "这个看法极具争议。我十分高调地冒险，结果大错特错。美国经济迎来了有史以来最繁荣的增长时期。",
  "uiIdx": "",
  "range": "3782-3827",
  "chapterUid": 15
 },
 {
  "level": 3,
  "text": "这一次失败抹杀了我之前所有的成绩，我找不到一条合适的道路，既能给我想要的回报，又不会带来我无法承受的风险",
  "uiIdx": "3.2",
  "range": "6013-6052",
  "chapterUid": 15
 },
 {
  "level": 4,
  "text": "我不得不向父亲借了4000美元，才勉强维生。",
  "uiIdx": "",
  "range": "4514-4536",
  "chapterUid": 15
 },
 {
  "level": 4,
  "text": "更糟糕的是，我不得不解雇我关心、在意的人，后来我的公司就只剩下一个人——我。",
  "uiIdx": "",
  "range": "4904-4942",
  "chapterUid": 15
 },
 {
  "level": 2,
  "text": "理解现实，形成更好的视角",
  "uiIdx": "4",
  "range": "7837-7896",
  "chapterUid": 15
 },
 {
  "level": 3,
  "text": "我观察到，所有事情的发生都是有原因的，而所有已经发生的事情都将导致其他事情的发生，所以现实就像永动机一样运转，永不停歇",
  "uiIdx": "4.1",
  "range": "7837-7896",
  "chapterUid": 15
 },
 {
  "level": 4,
  "text": "At the Big Bang, all the laws and forces of the universe were propelled forward, interacting with each other as a perpetual motion machine in which all the bits and pieces formed machines that worked for a while, fell apart, and then formed new machines.",
  "uiIdx": "",
  "range": "7962-8052",
  "chapterUid": 15
 },
 {
  "level": 3,
  "text": "我注意到，人们容易受近期事件的影响，而忽视很久没发生的事，尤其是他们没有亲身经历过的事",
  "uiIdx": "4.2",
  "range": "12992-13036",
  "chapterUid": 15
 },
 {
  "level": 4,
  "text": "But they will happen again.",
  "uiIdx": "",
  "range": "13284-13311",
  "chapterUid": 15
 },
 {
  "level": 2,
  "text": "平衡风险和回报，实现更大的人生价值",
  "uiIdx": "5",
  "range": "13588-13614",
  "chapterUid": 15
 },
 {
  "level": 3,
  "text": "我意识到风险和回报相伴相随，要想实现更大的人生价值，就得冒更大的风险",
  "uiIdx": "5.1",
  "range": "13588-13614",
  "chapterUid": 15
 },
 {
  "level": 4,
  "text": "I could see that to get more out of life one has to take more risk…and that knowing how to appropriately balance risk and reward is essential to having the best life possible.",
  "uiIdx": "",
  "range": "13668-13990",
  "chapterUid": 15
 },
 {
  "level": 3,
  "text": "假设你现在有两个选择：你可以留在原地，度过安逸但平庸的一生；你也可以冒险穿越丛林，过上精彩的生活",
  "uiIdx": "5.2",
  "range": "14206-14236",
  "chapterUid": 15
 },
 {
  "level": 4,
  "text": "How would you approach that choice？",
  "uiIdx": "",
  "range": "14653-14688",
  "chapterUid": 15
 },
 {
  "level": 2,
  "text": "克服自我意识和思维盲点障碍，找到正确的道路",
  "uiIdx": "6",
  "range": "15432-15448",
  "chapterUid": 15
 },
 {
  "level": 3,
  "text": "我们的自我意识障碍阻止我们承认自己的弱点",
  "uiIdx": "6.1",
  "range": "15725-15746",
  "chapterUid": 15
 },
 {
  "level": 4,
  "text": "我们把“我是对的”看得很重要，比了解真相还重要……所以我们对自己的看法深信不疑，哪怕这些看法是未经验证的。",
  "uiIdx": "",
  "range": "16054-16107",
  "chapterUid": 15
 },
 {
  "level": 4,
  "text": "我们尤其不喜欢正视自己的错误和弱点。当别人指出我们的错误和弱点时，我们本能地视之为对我们的攻击。",
  "uiIdx": "",
  "range": "16469-16517",
  "chapterUid": 15
 },
 {
  "level": 3,
  "text": "思维盲点障碍之所以存在，是因为不同的人看待事物的方式不同",
  "uiIdx": "6.2",
  "range": "17256-17285",
  "chapterUid": 15
 },
 {
  "level": 4,
  "text": "总有别人能够看到而你看不到的东西，如果你能获得这些人的帮助，就能在很大程度上拓宽自己的视野。",
  "uiIdx": "",
  "range": "17540-17586",
  "chapterUid": 15
 },
 {
  "level": 2,
  "text": "与有见解但与你视角不同的人结伴同行，实现共同目标",
  "uiIdx": "7",
  "range": "20659-20704",
  "chapterUid": 15
 },
 {
  "level": 3,
  "text": "为了实现我的目标，我需要不再为自己是对的而沾沾自喜，要为了解到真相而感到喜悦",
  "uiIdx": "7.1",
  "range": "18356-18395",
  "chapterUid": 15
 },
 {
  "level": 4,
  "text": "So I looked for the most thoughtful people who disagreed with me.",
  "uiIdx": "",
  "range": "18791-18856",
  "chapterUid": 15
 },
 {
  "level": 4,
  "text": "I wanted to see through their eyes and have them see through mine... so that we could together find what’s true and how to deal with it. I wanted to learn the art of thoughtful disagreement.",
  "uiIdx": "",
  "range": "18791-18856",
  "chapterUid": 15
 },
 {
  "level": 3,
  "text": "记住五步流程，并不是每个人都能很好地完成所有这五步，但总有人能看到你看不到的，能做到你做不到的，你可以寻求他们的帮助",
  "uiIdx": "7.2",
  "range": "21092-21111",
  "chapterUid": 15
 },
 {
  "level": 4,
  "text": "But you can get help from others who can see and do things you can’t.",
  "uiIdx": "",
  "range": "21488-21557",
  "chapterUid": 15
 },
 {
  "level": 4,
  "text": "You just need to let go of your attachment to having the right answers yourself and become open-minded to these other views. This radically open-minded approach significantly improved my decision making.",
  "uiIdx": "",
  "range": "21858-22061",
  "chapterUid": 15
 },
 {
  "level": 2,
  "text": "成功并不在于实现目标，而在于获得个人进化和有意义的关系",
  "uiIdx": "8",
  "range": "25078-25093",
  "chapterUid": 15
 },
 {
  "level": 3,
  "text": "我们所追求的东西只是鱼饵……与我们关心的人一起为共同的目标而奋斗，从而获得个人进化和有意义的关系，这才是真正的回报",
  "uiIdx": "8.1",
  "range": "25456-25470",
  "chapterUid": 15
 },
 {
  "level": 4,
  "text": "The things we strive for are just the bait...the struggle to get them with people that we care about gives us the personal evolution and the meaningful relationships that are the real rewards.",
  "uiIdx": "",
  "range": "25543-25586",
  "chapterUid": 15
 },
 {
  "level": 3,
  "text": "随着时间的推移，成就使命和帮助他人获得幸福，变得比我自己的成功更重要",
  "uiIdx": "8.2",
  "range": "26415-26450",
  "chapterUid": 15
 },
 {
  "level": 4,
  "text": "With time, the success of the mission and the well-being of other people became more important than my own success.",
  "uiIdx": "",
  "range": "26479-26594",
  "chapterUid": 15
 },
 {
  "level": 1,
  "text": "理解并拥抱现实",
  "uiIdx": "",
  "range": "",
  "chapterUid": 18
 },
 {
  "level": 2,
  "text": "理解并拥抱现实的重要性",
  "uiIdx": "1",
  "range": "440-466",
  "chapterUid": 18
 },
 {
  "level": 3,
  "text": "大多数事情都会基于类似的原因而一再重演。",
  "uiIdx": "1.1",
  "range": "440-466",
  "chapterUid": 18
 },
 {
  "level": 3,
  "text": "通过反思这些规律，并参考其他人对这些规律的想法，你可以学到应对现实的原则，从而变得更成功。",
  "uiIdx": "1.2",
  "range": "495-546",
  "chapterUid": 18
 },
 {
  "level": 1,
  "text": "绕过最大的两个障碍",
  "uiIdx": "",
  "range": "",
  "chapterUid": 18
 },
 {
  "level": 2,
  "text": "对靠自己找到正确答案的执着程度。",
  "uiIdx": "1",
  "range": "395-418",
  "chapterUid": 18
 },
 {
  "level": 2,
  "text": "处理深思熟虑的分歧的能力",
  "uiIdx": "2",
  "range": "447-474",
  "chapterUid": 18
 },
 {
  "level": 3,
  "text": "处理深思熟虑的分歧是否可以帮助你找到最佳答案?你愿意这么做吗？",
  "uiIdx": "2.1",
  "range": "447-474",
  "chapterUid": 18
 },
 {
  "level": 2,
  "text": "从别人视角看问题的能力",
  "uiIdx": "3",
  "range": "511-539",
  "chapterUid": 18
 },
 {
  "level": 3,
  "text": "你有多擅长从别人的视角看问题，从而发掘出尽可能好的想法？",
  "uiIdx": "3.1",
  "range": "511-539",
  "chapterUid": 18
 },
 {
  "level": 2,
  "text": "应对困境的能力",
  "uiIdx": "4",
  "range": "568-584",
  "chapterUid": 18
 },
 {
  "level": 3,
  "text": "你想要学会如何更好地应对困境吗？",
  "uiIdx": "4.1",
  "range": "568-584",
  "chapterUid": 18
 },
 {
  "level": 1,
  "text": "瑞的其他原则",
  "uiIdx": "",
  "range": "",
  "chapterUid": 18
 },
 {
  "level": 2,
  "text": "实现愿望的原则",
  "uiIdx": "1",
  "range": "391-419",
  "chapterUid": 18
 },
 {
  "level": 3,
  "text": "头脑开放，有决心，几乎可以实现任何愿望",
  "uiIdx": "1.1",
  "range": "391-419",
  "chapterUid": 18
 },
 {
  "level": 4,
  "text": "不要担心自己的形象，只关心如何实现目标。",
  "uiIdx": "",
  "range": "448-468",
  "chapterUid": 18
 },
 {
  "level": 2,
  "text": "痛苦与反思的关系",
  "uiIdx": "2",
  "range": "516-524",
  "chapterUid": 18
 },
 {
  "level": 3,
  "text": "痛苦+反思=进步",
  "uiIdx": "2.1",
  "range": "516-524",
  "chapterUid": 18
 },
 {
  "level": 4,
  "text": "反思过去的错误，从中学习，实现进步。",
  "uiIdx": "",
  "range": "516-524",
  "chapterUid": 18
 },
 {
  "level": 2,
  "text": "梦想与现实的结合",
  "uiIdx": "3",
  "range": "560-574",
  "chapterUid": 18
 },
 {
  "level": 3,
  "text": "梦想+现实+决心=成功的生活",
  "uiIdx": "3.1",
  "range": "560-574",
  "chapterUid": 18
 },
 {
  "level": 4,
  "text": "有梦想，面对现实，并有决心去实现。",
  "uiIdx": "",
  "range": "391-419",
  "chapterUid": 18
 },
 {
  "level": 2,
  "text": "工作的价值",
  "uiIdx": "4",
  "range": "603-631",
  "chapterUid": 18
 },
 {
  "level": 3,
  "text": "有意义的工作和有意义的人际关系是最大的财富和最大的回报",
  "uiIdx": "4.1",
  "range": "603-631",
  "chapterUid": 18
 },
 {
  "level": 4,
  "text": "打造允许犯错，但不容忍罔顾教训、一错再错的文化。",
  "uiIdx": "",
  "range": "660-684",
  "chapterUid": 18
 },
 {
  "level": 2,
  "text": "自我意识与思维盲点",
  "uiIdx": "5",
  "range": "732-754",
  "chapterUid": 18
 },
 {
  "level": 3,
  "text": "不要让自我意识障碍和思维盲点障碍阻碍你进步",
  "uiIdx": "5.1",
  "range": "732-754",
  "chapterUid": 18
 },
 {
  "level": 4,
  "text": "既要头脑开放，又要果断自信。",
  "uiIdx": "",
  "range": "790-804",
  "chapterUid": 18
 },
 {
  "level": 2,
  "text": "对结果负责",
  "uiIdx": "6",
  "range": "833-839",
  "chapterUid": 18
 },
 {
  "level": 3,
  "text": "对结果负责，一直都存在一条合适的道路",
  "uiIdx": "6.1",
  "range": "881-909",
  "chapterUid": 18
 },
 {
  "level": 4,
  "text": "如果你还没找到，你只需要接受别人的帮助，好好地继续寻找。",
  "uiIdx": "",
  "range": "881-909",
  "chapterUid": 18
 },
 {
  "level": 2,
  "text": "五步流程",
  "uiIdx": "7",
  "range": "1040-1060",
  "chapterUid": 18
 },
 {
  "level": 3,
  "text": "明确你的目标；识别你的问题，并且不容忍你的问题；诊断你的问题，以找出根本原因；设计解决问题的方案；践行你的方案",
  "uiIdx": "7.1",
  "range": "1040-1060",
  "chapterUid": 18
 },
 {
  "level": 4,
  "text": "如果你有效地重复上述五步流程，同时找到能弥补你弱点的人，有了他们的帮助，你就会成功。",
  "uiIdx": "",
  "range": "1137-1179",
  "chapterUid": 18
 },
 {
  "level": 2,
  "text": "优先级与选择",
  "uiIdx": "8",
  "range": "1208-1254",
  "chapterUid": 18
 },
 {
  "level": 3,
  "text": "虽然你可以得到几乎任何你想要的东西，但不可能得到所有你想要的东西，因此你需要决定其先后顺序",
  "uiIdx": "8.1",
  "range": "1208-1254",
  "chapterUid": 18
 },
 {
  "level": 4,
  "text": "每个人都有弱点和强项。",
  "uiIdx": "",
  "range": "1283-1294",
  "chapterUid": 18
 },
 {
  "level": 2,
  "text": "克服弱点的方法",
  "uiIdx": "9",
  "range": "1403-1439",
  "chapterUid": 18
 },
 {
  "level": 3,
  "text": "在你不擅长的领域请教其他擅长的人；改进你的弱点",
  "uiIdx": "9.1",
  "range": "1403-1439",
  "chapterUid": 18
 },
 {
  "level": 4,
  "text": "通常第一种方法是最好的。",
  "uiIdx": "",
  "range": "1449-1461",
  "chapterUid": 18
 },
 {
  "level": 2,
  "text": "思维方式的重要性",
  "uiIdx": "10",
  "range": "1509-1561",
  "chapterUid": 18
 },
 {
  "level": 3,
  "text": "要知道，人与人的思维方式是不同的",
  "uiIdx": "10.1",
  "range": "1509-1561",
  "chapterUid": 18
 },
 {
  "level": 4,
  "text": "能站在那些聪明但与你观点不同的人的角度看待问题，才是明智之举。",
  "uiIdx": "",
  "range": "1509-1561",
  "chapterUid": 18
 },
 {
  "level": 2,
  "text": "伙伴关系与金钱的价值",
  "uiIdx": "11",
  "range": "1597-1623",
  "chapterUid": 18
 },
 {
  "level": 3,
  "text": "相互关心和慷慨大方的伙伴关系远比金钱更有价值",
  "uiIdx": "11.1",
  "range": "1597-1623",
  "chapterUid": 18
 },
 {
  "level": 4,
  "text": "记住，钱是非常重要的，除非你已经有足够的钱来照顾自己和你关心的人。",
  "uiIdx": "",
  "range": "1652-1685",
  "chapterUid": 18
 },
 {
  "level": 2,
  "text": "工作与热情的结合",
  "uiIdx": "12",
  "range": "1775-1796",
  "chapterUid": 18
 },
 {
  "level": 3,
  "text": "让热情与工作合二为一，并与志同道合者共事",
  "uiIdx": "12.1",
  "range": "1775-1796",
  "chapterUid": 18
 },
 {
  "level": 4,
  "text": "在不可妥协的事情上妥协，是不可能获得成功的。",
  "uiIdx": "",
  "range": "1825-1847",
  "chapterUid": 18
 },
 {
  "level": 2,
  "text": "真诚与透明",
  "uiIdx": "13",
  "range": "1895-1907",
  "chapterUid": 18
 },
 {
  "level": 3,
  "text": "做到极度求真和极度透明",
  "uiIdx": "13.1",
  "range": "1895-1907",
  "chapterUid": 18
 },
 {
  "level": 4,
  "text": "分享最难分享的事情。",
  "uiIdx": "",
  "range": "1943-1953",
  "chapterUid": 18
 },
 {
  "level": 4,
  "text": "当面不会说的，背地里也不要说，要批评别人就当面指出来。",
  "uiIdx": "",
  "range": "1982-2009",
  "chapterUid": 18
 },
 {
  "level": 4,
  "text": "要记住很多人只是假装为你考虑，而实际上是在追求一己私利。",
  "uiIdx": "",
  "range": "2038-2066",
  "chapterUid": 18
 },
 {
  "level": 2,
  "text": "进化与成长",
  "uiIdx": "14",
  "range": "2095-2102",
  "chapterUid": 18
 },
 {
  "level": 3,
  "text": "不进化就死亡",
  "uiIdx": "14.1",
  "range": "2095-2102",
  "chapterUid": 18
 },
 {
  "level": 4,
  "text": "了解你和你关心的人在人生弧线上所处的位置，以便正确看待事物，并为未来做好计划。",
  "uiIdx": "",
  "range": "2131-2170",
  "chapterUid": 18
 },
 {
  "level": 1,
  "text": "你的人生弧线练习",
  "uiIdx": "",
  "range": "",
  "chapterUid": 18
 },
 {
  "level": 2,
  "text": "人生弧线练习的目的和意义",
  "uiIdx": "1",
  "range": "457-537",
  "chapterUid": 18
 },
 {
  "level": 3,
  "text": "帮助正确看待你和你所关心的人的人生，并为未来做好计划",
  "uiIdx": "1.1",
  "range": "457-537",
  "chapterUid": 18
 },
 {
  "level": 4,
  "text": "几乎每件事情都会基于类似的原因而一再重演，所以要想理解任何事情，如果能从一个典型案例着手，摸清它的来龙去脉，并观察其中的前因后果，会很有帮助。",
  "uiIdx": "",
  "range": "457-537",
  "chapterUid": 18
 },
 {
  "level": 2,
  "text": "人生弧线的三个阶段",
  "uiIdx": "2",
  "range": "768-787",
  "chapterUid": 18
 },
 {
  "level": 3,
  "text": "第一阶段，我们依赖其他人，不断学习。",
  "uiIdx": "2.1",
  "range": "768-787",
  "chapterUid": 18
 },
 {
  "level": 3,
  "text": "第二阶段，我们努力工作，成为其他人的依靠，同时这一阶段的我们也最渴望成功。",
  "uiIdx": "2.2",
  "range": "787-825",
  "chapterUid": 18
 },
 {
  "level": 3,
  "text": "第三阶段，我们最关心的不再是自己能否更加成功，而是帮助自己关心的人，使他们能够在他们的人生第二阶段独立取得成功",
  "uiIdx": "2.3",
  "range": "825-882",
  "chapterUid": 18
 },
 {
  "level": 4,
  "text": "这不光对他们，对处于第三阶段的我们来说也是最好的，因为这意味着我们完成了应尽的义务，不需要再有所担忧。",
  "uiIdx": "",
  "range": "882-933",
  "chapterUid": 18
 },
 {
  "level": 2,
  "text": "审视人生弧线的三个阶段的注意事项",
  "uiIdx": "3",
  "range": "992-1104",
  "chapterUid": 18
 },
 {
  "level": 3,
  "text": "在审视每个阶段时，了解在这个阶段对于一个典型的人来说会发生什么，再对比你的个人经历",
  "uiIdx": "3.1",
  "range": "992-1104",
  "chapterUid": 18
 },
 {
  "level": 4,
  "text": "我们会要你设想你的未来，尤其要关注一些重要节点，因为我们在这些节点所做的选择(比如是否读完高中或大学，从事什么工作，要不要生孩子)，将对我们之后的人生产生重大影响。",
  "uiIdx": "",
  "range": "992-1104",
  "chapterUid": 18
 },
 {
  "level": 1,
  "text": "第一阶段",
  "uiIdx": "",
  "range": "",
  "chapterUid": 18
 },
 {
  "level": 2,
  "text": "第一阶段的特点和影响",
  "uiIdx": "1",
  "range": "419-456",
  "chapterUid": 18
 },
 {
  "level": 3,
  "text": "第一阶段是依赖他人的阶段，早年的经历对你的喜好和性格的形成有很大的影响",
  "uiIdx": "1.1",
  "range": "419-456",
  "chapterUid": 18
 },
 {
  "level": 4,
  "text": "早年的经历赋予你基本的能力和技能。",
  "uiIdx": "",
  "range": "419-456",
  "chapterUid": 18
 },
 {
  "level": 3,
  "text": "高中时期是人生中最具挑战性的阶段，你会自然地希望自己更独立",
  "uiIdx": "1.2",
  "range": "499-518",
  "chapterUid": 18
 },
 {
  "level": 4,
  "text": "在激素的作用下，你容易吸引异性，也容易被异性吸引。",
  "uiIdx": "",
  "range": "518-543",
  "chapterUid": 18
 },
 {
  "level": 3,
  "text": "高中毕业后，你要么去上大学，要么直接进入人生第二阶段——工作",
  "uiIdx": "1.3",
  "range": "581-612",
  "chapterUid": 18
 },
 {
  "level": 4,
  "text": "如果去上大学，你会有更大程度的自由，也会交到更多朋友，还会学习到更多东西。",
  "uiIdx": "",
  "range": "612-649",
  "chapterUid": 18
 },
 {
  "level": 4,
  "text": "在大学期间，你还是被引导着，因为你的课程和大部分生活都是被安排好的。",
  "uiIdx": "",
  "range": "649-683",
  "chapterUid": 18
 },
 {
  "level": 4,
  "text": "你毕业后进入职场，就开启了人生第二阶段。",
  "uiIdx": "",
  "range": "683-703",
  "chapterUid": 18
 },
 {
  "level": 1,
  "text": "第二阶段",
  "uiIdx": "",
  "range": "",
  "chapterUid": 24
 },
 {
  "level": 2,
  "text": "第二阶段的特点",
  "uiIdx": "1",
  "range": "389-416",
  "chapterUid": 24
 },
 {
  "level": 3,
  "text": "在第二阶段，你会努力工作获得成功，其他人会开始依靠你",
  "uiIdx": "1.1",
  "range": "389-416",
  "chapterUid": 24
 },
 {
  "level": 4,
  "text": "刚进入第二阶段时，你不再在他人的指导下生活，可以自由地做选择。",
  "uiIdx": "",
  "range": "416-453",
  "chapterUid": 24
 },
 {
  "level": 3,
  "text": "20来岁是人生中最快乐的时期之一，你会邂逅爱情，很可能找到想共度一生的伴侣",
  "uiIdx": "1.2",
  "range": "545-601",
  "chapterUid": 24
 },
 {
  "level": 4,
  "text": "随着时间推移，你会做出更多的承诺，在工作和爱情中承担更大的责任，所以你的选择会变少，越来越不容易平衡工作和生活。",
  "uiIdx": "",
  "range": "545-601",
  "chapterUid": 24
 },
 {
  "level": 3,
  "text": "45~55岁的这段时光特别艰难，据说这是人们最不快乐的几年",
  "uiIdx": "1.3",
  "range": "639-669",
  "chapterUid": 24
 },
 {
  "level": 4,
  "text": "大多数人会在55~65岁经历过渡期，这时他们退休了，第二阶段也就结束了。",
  "uiIdx": "",
  "range": "669-705",
  "chapterUid": 24
 },
 {
  "level": 2,
  "text": "第二阶段可能经历的重大事件",
  "uiIdx": "2",
  "range": "601-639",
  "chapterUid": 24
 },
 {
  "level": 3,
  "text": "你可能会离婚(大多数人是在25~40岁这一年龄段离婚的)，这种经历并不愉快。",
  "uiIdx": "2.1",
  "range": "601-639",
  "chapterUid": 24
 },
 {
  "level": 1,
  "text": "第三阶段",
  "uiIdx": "",
  "range": "",
  "chapterUid": 24
 },
 {
  "level": 2,
  "text": "第三阶段的特点",
  "uiIdx": "1",
  "range": "389-440",
  "chapterUid": 24
 },
 {
  "level": 3,
  "text": "在第三阶段，你会获得更大程度的自由，因为你已经完成了工作和生儿育女的责任，父母也已经去世，无赡养义务。",
  "uiIdx": "1.1",
  "range": "389-440",
  "chapterUid": 24
 },
 {
  "level": 3,
  "text": "通常是在这个阶段，你见证孙辈降生，享受含饴弄孙的乐趣",
  "uiIdx": "1.2",
  "range": "465-499",
  "chapterUid": 24
 },
 {
  "level": 4,
  "text": "调查显示，70~80岁是人生中最快乐的时光。",
  "uiIdx": "",
  "range": "499-521",
  "chapterUid": 24
 },
 {
  "level": 3,
  "text": "在这个阶段的后期，你的日子可能会过得不很舒心；朋友相继离世，伴侣也可能先过世，健康问题频发。",
  "uiIdx": "1.3",
  "range": "544-567",
  "chapterUid": 24
 },
 {
  "level": 3,
  "text": "幸福水平虽然在这一阶段后期有所下降，但一直到人们去世前，仍然相对较高",
  "uiIdx": "1.4",
  "range": "567-640",
  "chapterUid": 24
 },
 {
  "level": 4,
  "text": "因为这时人们富有人生智慧，心灵上也趋于平静。",
  "uiIdx": "",
  "range": "567-640",
  "chapterUid": 24
 },
 {
  "level": 1,
  "text": "规划你的人生弧线",
  "uiIdx": "",
  "range": "",
  "chapterUid": 27
 },
 {
  "level": 2,
  "text": "想象你和你关心的人在10年后的位置",
  "uiIdx": "1",
  "range": "667-705",
  "chapterUid": 27
 },
 {
  "level": 3,
  "text": "预先设想出未来的情景，思考如何让自己和他们在接下来的10年过得最好",
  "uiIdx": "1.1",
  "range": "667-705",
  "chapterUid": 27
 },
 {
  "level": 4,
  "text": "例如，10年后，你的孩子将离开家独立生活，你的父母可能时日无多，甚至已经去世。你也将面临自己职业生涯的最严峻时期。",
  "uiIdx": "",
  "range": "586-667",
  "chapterUid": 27
 },
 {
  "level": 2,
  "text": "向前人请教具体情况，学习他们应对挑战的原则",
  "uiIdx": "2",
  "range": "881-918",
  "chapterUid": 27
 },
 {
  "level": 3,
  "text": "找到在你想要获得成功的方面已经获得成功的人，试着找出他们成功的方法和原则",
  "uiIdx": "2.1",
  "range": "881-918",
  "chapterUid": 27
 },
 {
  "level": 4,
  "text": "例如，如果你要选择进入某一行业工作，可请教该行业权威人士，询问关于该行业的具体情况，包括职业前景等。",
  "uiIdx": "",
  "range": "831-881",
  "chapterUid": 27
 },
 {
  "level": 2,
  "text": "在图上标注你的笔记，并不断完善它们",
  "uiIdx": "3",
  "range": "1018-1050",
  "chapterUid": 27
 },
 {
  "level": 3,
  "text": "当你进入第三阶段，想要帮助其他人时，你可以把这些原则传授给他们",
  "uiIdx": "3.1",
  "range": "1018-1050",
  "chapterUid": 27
 },
 {
  "level": 4,
  "text": "你设想得越具体(例如，你需要多少钱和时间去达成什么目标)，下一个10年的情况就会越好。",
  "uiIdx": "",
  "range": "705-748",
  "chapterUid": 27
 },
