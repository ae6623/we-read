[
 {
  "level": 1,
  "text": "“难得粟裕！壮哉粟裕！”",
  "uiIdx": "",
  "range": "",
  "chapterUid": 2
 },
 {
  "level": 2,
  "text": "粟裕的军事才能和贡献",
  "uiIdx": "1",
  "range": "873-960",
  "chapterUid": 2
 },
 {
  "level": 3,
  "text": "粟裕在解放战争中指挥了许多重要战役，每役歼敌数量均超过3万人",
  "uiIdx": "1.1",
  "range": "873-960",
  "chapterUid": 2
 },
 {
  "level": 4,
  "text": "在近四年的解放战争中，中国人民解放军进行的较为重要的战役共134次，每役歼敌3万人以上有38次，其中粟裕指挥的有12次。",
  "uiIdx": "",
  "range": "873-985",
  "chapterUid": 2
 },
 {
  "level": 4,
  "text": "每役歼敌5万人以上有23次，其中粟裕指挥的有8次。",
  "uiIdx": "",
  "range": "960-985",
  "chapterUid": 2
 },
 {
  "level": 3,
  "text": "粟裕在淮海战役中，以60万解放军大胜80万国民党军，奠定解放战争的胜局",
  "uiIdx": "1.2",
  "range": "985-1058",
  "chapterUid": 2
 },
 {
  "level": 4,
  "text": "1948年11月6日，粟裕率华东野战军发起淮海战役。",
  "uiIdx": "",
  "range": "1376-1402",
  "chapterUid": 2
 },
 {
  "level": 4,
  "text": "在整个淮海战役中，他运筹帷幄、指挥若定，与陈毅、刘伯承、邓小平、谭震林等配合默契，一举歼灭国民党军44万余人。",
  "uiIdx": "",
  "range": "1402-1457",
  "chapterUid": 2
 },
 {
  "level": 2,
  "text": "粟裕的成长历程",
  "uiIdx": "2",
  "range": "1103-1127",
  "chapterUid": 2
 },
 {
  "level": 3,
  "text": "粟裕在南昌起义时，只是起义军总指挥部的警卫队班长",
  "uiIdx": "2.1",
  "range": "1103-1127",
  "chapterUid": 2
 },
 {
  "level": 4,
  "text": "1927年8月1日，南昌起义爆发，粟裕担任起义军总指挥部的警卫队班长。",
  "uiIdx": "",
  "range": "1103-1127",
  "chapterUid": 2
 },
 {
  "level": 3,
  "text": "粟裕在井冈山时期，从战争中学习战争",
  "uiIdx": "2.2",
  "range": "1127-1163",
  "chapterUid": 2
 },
 {
  "level": 4,
  "text": "1928年，他上了井冈山，在毛泽东、朱德的指挥下战斗。",
  "uiIdx": "",
  "range": "1127-1163",
  "chapterUid": 2
 },
 {
  "level": 3,
  "text": "粟裕在南方三年游击战争中，迅速成长起来",
  "uiIdx": "2.3",
  "range": "1191-1234",
  "chapterUid": 2
 },
 {
  "level": 4,
  "text": "皖南事变后，粟裕在苏中地区指挥新四军神出鬼没，打得日伪军鬼哭狼嚎。",
  "uiIdx": "",
  "range": "1191-1234",
  "chapterUid": 2
 },
 {
  "level": 2,
  "text": "粟裕的为人风范和坚定信念",
  "uiIdx": "3",
  "range": "1779-1831",
  "chapterUid": 2
 },
 {
  "level": 3,
  "text": "粟裕一生先后6次负伤，将自己的一切都奉献给中国的革命事业",
  "uiIdx": "3.1",
  "range": "1779-1831",
  "chapterUid": 2
 },
 {
  "level": 4,
  "text": "1984年2月5日他逝世后，家人从他火化的头颅骨灰中发现了三块弹片。",
  "uiIdx": "",
  "range": "1687-1721",
  "chapterUid": 2
 },
 {
  "level": 3,
  "text": "粟裕谦虚朴素，坚持真理",
  "uiIdx": "3.2",
  "range": "1779-1831",
  "chapterUid": 2
 },
 {
  "level": 4,
  "text": "粟裕一生，两袖清风，将自己的一切都奉献给中国的革命事业。",
  "uiIdx": "",
  "range": "1779-1831",
  "chapterUid": 2
 },
 {
  "level": 1,
  "text": "将军如何炼成",
  "uiIdx": "",
  "range": "",
  "chapterUid": 2
 },
 {
  "level": 2,
  "text": "粟裕的童年经历和革命起点",
  "uiIdx": "1",
  "range": "686-723",
  "chapterUid": 2
 },
 {
  "level": 3,
  "text": "粟裕出生于湖南会同县坪村镇枫木树脚村一个地主家庭，自幼萌生为民除害的剑侠梦想",
  "uiIdx": "1.1",
  "range": "686-723",
  "chapterUid": 2
 },
 {
  "level": 4,
  "text": "粟裕从小玩枪舞棒，跟着阿陀练功习武，练就了一身好武艺。",
  "uiIdx": "",
  "range": "928-945",
  "chapterUid": 2
 },
 {
  "level": 4,
  "text": "粟裕对故事里的受苦受难的人们同情极了，对故事里的坏人痛恨极了，对故事里“专管人间不平事”的剑侠崇拜极了。",
  "uiIdx": "",
  "range": "740-851",
  "chapterUid": 2
 },
 {
  "level": 3,
  "text": "粟裕在湖南省立第二师范学校积极参加中共领导的学生运动，并加入了共青团",
  "uiIdx": "1.2",
  "range": "2230-2313",
  "chapterUid": 2
 },
 {
  "level": 4,
  "text": "1927年5月，“四一二”反革命政变后不久，粟裕参加了常德各界声讨蒋介石的活动，被当局通缉。",
  "uiIdx": "",
  "range": "2313-2359",
  "chapterUid": 2
 },
 {
  "level": 4,
  "text": "反动军警派出两个营将“二师”团团围住，粟裕和一些同学悄悄从校内下水道撤离到了常德城外，挤上了开往当时中共中央所在地武昌的火车。",
  "uiIdx": "",
  "range": "2359-2422",
  "chapterUid": 2
 },
 {
  "level": 2,
  "text": "粟裕在革命熔炉中的成长",
  "uiIdx": "2",
  "range": "2878-2941",
  "chapterUid": 2
 },
 {
  "level": 3,
  "text": "粟裕在教导大队受训期间，周恩来、恽代英等人常来作报告，每次听完报告，他都备受鼓舞",
  "uiIdx": "2.1",
  "range": "2878-2941",
  "chapterUid": 2
 },
 {
  "level": 4,
  "text": "周恩来同志给我们作过两次报告，主要是讲形势和任务，他那爽朗明快的语言、鲜明的观点、透彻的分析、对革命前途充满信心的坚定态度，给大家留下了难以磨灭的印象。",
  "uiIdx": "",
  "range": "2941-3044",
  "chapterUid": 2
 },
 {
  "level": 4,
  "text": "恽代英同志讲话十分幽默，富有鼓动力量。蒋介石叛变，一部分国民党人士实际亲蒋，表面上却标榜自己是中间派，孙科就是其中一个代表。恽代英同志就挖苦他说：“人家说孙科是中间派，我看他是站在中间，向前一步走，向右看齐！”。",
  "uiIdx": "",
  "range": "3108-3158",
  "chapterUid": 2
 },
 {
  "level": 3,
  "text": "粟裕在南昌起义和湘南起义中，表现出色，迅速成长为高级指挥员",
  "uiIdx": "2.2",
  "range": "5963-6031",
  "chapterUid": 2
 },
 {
  "level": 4,
  "text": "1927年8月，粟裕随教导队参加了南昌起义，并担任警卫队班长，主要负责保护后勤物资。",
  "uiIdx": "",
  "range": "4094-4136",
  "chapterUid": 2
 },
 {
  "level": 4,
  "text": "1928年1月揭开了湘南起义的序幕。紧接着，起义军在坪石打败了许克祥的部队，缴获大批枪支弹药和药品，鼓舞了湘南人民的革命斗志。",
  "uiIdx": "",
  "range": "5369-5448",
  "chapterUid": 2
 },
 {
  "level": 4,
  "text": "在井冈山时期，为适应红军战略战术的要求，部队的军事训练不同于国民革命军了。没有花架子，训练从实战需要出发。",
  "uiIdx": "",
  "range": "6807-6883",
  "chapterUid": 2
 },
 {
  "level": 2,
  "text": "粟裕在抗日战争和解放战争中建立的卓越功勋",
  "uiIdx": "3",
  "range": "9089-9111",
  "chapterUid": 2
 },
 {
  "level": 3,
  "text": "粟裕在浙南三年游击战争中，迅速成长，成为我党最年轻的将领之一",
  "uiIdx": "3.1",
  "range": "9089-9111",
  "chapterUid": 2
 },
 {
  "level": 4,
  "text": "1934年7月，中共中央和中央革命军事委员会主要领导人宣布由红七军团组成红军北上抗日先遣队，立即向闽、浙、赣、皖等省出动，宣传中共北上抗日主张，推动抗日救亡运动的发展。北上抗日先遣队保持军团体制，寻淮洲任军团长，乐少华为军团政治委员，粟裕担任军团参谋长。",
  "uiIdx": "",
  "range": "9137-9264",
  "chapterUid": 2
 },
 {
  "level": 4,
  "text": "1937年7月，全面抗日战争爆发后，粟裕在失去与上级党组织和中共闽浙临时省委联系的情况下，正确判断形势，主动发表挺进师抗日宣言和通电，要求遂昌县政府派人进行谈判，遂昌县当局积极回应，在谈判中同意挺进师保持独立和合作抗日等要求。挺进师改编为国民革命军浙闽边抗日游击总队，结束了艰难曲折的浙南三年游击战争。",
  "uiIdx": "",
  "range": "9137-9221",
  "chapterUid": 2
 },
 {
  "level": 3,
  "text": "粟裕在解放战争中，率部南征北战、逐鹿中原，为夺取解放战争的胜利建立了不朽功勋",
  "uiIdx": "3.2",
  "range": "13022-13080",
  "chapterUid": 2
 },
 {
  "level": 4,
  "text": "1946年6月，国共决战大幕拉开。7月，国民党军5个整编师15个旅约12万人，向江苏中部的解放区大举进犯。7月13日至8月27日，粟裕指挥了苏中战役，“七战七捷”，首创一个战役歼敌5.3万余人的记录，歼敌总数为自身兵力总数的1.76倍，堪称战争史上的奇迹。",
  "uiIdx": "",
  "range": "13154-13330",
  "chapterUid": 2
 },
 {
  "level": 4,
  "text": "1947年5月的孟良崮战役，是他军事生涯中的得意之笔。",
  "uiIdx": "",
  "range": "14519-14546",
  "chapterUid": 2
 },
 {
  "level": 4,
  "text": "1948年6月17日至7月6日，在中原野战军的配合下，粟裕指挥了大规模攻城打援作战———豫东战役，歼敌15.3万人，打破了中原战场上的僵持局面，使我军由战略进攻阶段转向战略决战阶段，为全歼国民党军主力于长江以北、彻底解决中原问题创造了条件。",
  "uiIdx": "",
  "range": "15664-15766",
  "chapterUid": 2
 },
 {
  "level": 4,
  "text": "1948年9月，在粟裕的指挥下，华东野战军又取得了济南战役的胜利，使华东、华北两大解放区完全连成一片，为而后同敌人大规模的决战创造了极为有利的条件，并由此拉开了中国人民解放军同国民党军进行南线战略决战的序幕。",
  "uiIdx": "",
  "range": "15837-15891",
  "chapterUid": 2
 },
 {
  "level": 4,
  "text": "1948年11月，由邓小平、刘伯承、陈毅、粟裕、谭震林组成的总前委，统筹指挥华东、中原两大野战军共60万人，发动了震惊中外的淮海战役。战役至1949年1月10日胜利结束，历时66天，消灭国民党军55.5万余人，基本歼灭了蒋介石在长江以北的精锐部队，解放了华东、中原地区，取得了解放战争的决定性胜利。",
  "uiIdx": "",
  "range": "16071-16102",
  "chapterUid": 2
 },
 {
  "level": 4,
  "text": "1949年4月下旬指挥的渡江战役解放了南京、杭州，5月指挥上海战役，在上海外围歼敌主力8个军。",
  "uiIdx": "",
  "range": "21674-21730",
  "chapterUid": 2
 },
 {
  "level": 2,
  "text": "粟裕的军事才能和战略眼光",
  "uiIdx": "4",
  "range": "15553-15664",
  "chapterUid": 2
 },
 {
  "level": 3,
  "text": "粟裕善于组织指挥大兵团作战，能从战略全局思考问题，结合实际，独立思考，积极探索战争的特点和规律",
  "uiIdx": "4.1",
  "range": "15553-15664",
  "chapterUid": 2
 },
 {
  "level": 4,
  "text": "粟裕在苏中战役中消灭的敌人，比他自己的兵力还要多。",
  "uiIdx": "",
  "range": "14357-14391",
  "chapterUid": 2
 },
 {
  "level": 4,
  "text": "粟裕在淮海战役中，直接指挥的华东野战军歼灭包括杜聿明集团在内的国民党军44.3万人，占淮海战役歼敌总数的80%。",
  "uiIdx": "",
  "range": "19323-19380",
  "chapterUid": 2
 },
 {
  "level": 3,
  "text": "粟裕具有卓越的军事思想和高超的指挥才能，被誉为“战神”",
  "uiIdx": "4.2",
  "range": "12602-12646",
  "chapterUid": 2
 },
 {
  "level": 4,
  "text": "毛泽东说：“淮海战役，粟裕同志立了第一功。”。",
  "uiIdx": "",
  "range": "18246-18262",
  "chapterUid": 2
 },
 {
  "level": 4,
  "text": "斯大林得知淮海战役胜利的消息，在笔记本上写道：“60万战胜80万，奇迹，真是奇迹！”。",
  "uiIdx": "",
  "range": "19518-19560",
  "chapterUid": 2
 },
 {
  "level": 1,
  "text": "“人格品德，光彩照人”",
  "uiIdx": "",
  "range": "",
  "chapterUid": 2
 },
 {
  "level": 2,
  "text": "粟裕的人格品德",
  "uiIdx": "1",
  "range": "509-537",
  "chapterUid": 2
 },
 {
  "level": 3,
  "text": "粟裕是一个永不退役的老兵，一辈子在等待、在准备硝烟来临。",
  "uiIdx": "1.1",
  "range": "509-537",
  "chapterUid": 2
 },
 {
  "level": 3,
  "text": "除了战争，他别无所虑；除了胜利，他别无所求。",
  "uiIdx": "1.2",
  "range": "537-548",
  "chapterUid": 2
 },
 {
  "level": 3,
  "text": "在这样的军人面前，不管你懂不懂军事、是不是军人，都会明白：国家安全应该托付给这样的人。",
  "uiIdx": "1.3",
  "range": "559-604",
  "chapterUid": 2
 },
 {
  "level": 1,
  "text": "“难得粟裕！壮哉粟裕！竟三次辞帅”",
  "uiIdx": "",
  "range": "",
  "chapterUid": 2
 },
 {
  "level": 2,
  "text": "粟裕的回国和任职",
  "uiIdx": "1",
  "range": "515-534",
  "chapterUid": 2
 },
 {
  "level": 3,
  "text": "1951年9月下旬，粟裕从莫斯科回国，11月被调到总参工作",
  "uiIdx": "1.1",
  "range": "515-534",
  "chapterUid": 2
 },
 {
  "level": 4,
  "text": "粟裕给秘书鞠开写了一个条子，让他帮忙搬东西到北京。",
  "uiIdx": "",
  "range": "548-640",
  "chapterUid": 2
 },
 {
  "level": 3,
  "text": "1951年12月12日，粟裕正式就任中央军委副总参谋长",
  "uiIdx": "1.2",
  "range": "768-849",
  "chapterUid": 2
 },
 {
  "level": 4,
  "text": "粟裕协助代总参谋长聂荣臻主管作战、训练、海空军和陆军特种兵建设。",
  "uiIdx": "",
  "range": "768-849",
  "chapterUid": 2
 },
 {
  "level": 2,
  "text": "粟裕的日常生活和健康状况",
  "uiIdx": "2",
  "range": "2631-2654",
  "chapterUid": 2
 },
 {
  "level": 3,
  "text": "粟裕在北京的住所简单，生活节俭",
  "uiIdx": "2.1",
  "range": "2631-2654",
  "chapterUid": 2
 },
 {
  "level": 4,
  "text": "粟裕一家住在雨儿胡同12号院，房子多次维修，每次他都亲自把关。",
  "uiIdx": "",
  "range": "2631-2654",
  "chapterUid": 2
 },
 {
  "level": 4,
  "text": "粟裕在院子里种了桃树和最喜欢的白皮松，养了鱼，种了花。",
  "uiIdx": "",
  "range": "2654-2704",
  "chapterUid": 2
 },
 {
  "level": 3,
  "text": "粟裕的身体状况时好时坏，多次休养",
  "uiIdx": "2.2",
  "range": "3483-3517",
  "chapterUid": 2
 },
 {
  "level": 4,
  "text": "1952年底，他先在南京休养，不见好转，血压一直很高，转到杭州休养。",
  "uiIdx": "",
  "range": "3483-3517",
  "chapterUid": 2
 },
 {
  "level": 4,
  "text": "1953年2月下旬，他结束休养，去厦门前线考察大、小金门和台湾国民党军队的防务情况。",
  "uiIdx": "",
  "range": "3517-3559",
  "chapterUid": 2
 },
 {
  "level": 4,
  "text": "不到半年，他病情加重，又转到青岛休养。",
  "uiIdx": "",
  "range": "3559-3578",
  "chapterUid": 2
 },
 {
  "level": 4,
  "text": "1956年，他有近五个月时间在广州和青岛养病，这期间被诊断为心血管主动脉硬化。",
  "uiIdx": "",
  "range": "3578-3617",
  "chapterUid": 2
 },
 {
  "level": 2,
  "text": "粟裕的军衔问题",
  "uiIdx": "3",
  "range": "1172-1225",
  "chapterUid": 2
 },
 {
  "level": 3,
  "text": "1955年9月27日，粟裕被授予大将军衔，位列十大大将之首",
  "uiIdx": "3.1",
  "range": "1172-1225",
  "chapterUid": 2
 },
 {
  "level": 4,
  "text": "粟裕被授予大将军衔后，一时间议论纷纷，一些人认为他战功很大，应该授元帅衔。",
  "uiIdx": "",
  "range": "1225-1285",
  "chapterUid": 2
 },
 {
  "level": 3,
  "text": "粟裕曾三次辞帅",
  "uiIdx": "3.2",
  "range": "1547-1609",
  "chapterUid": 2
 },
 {
  "level": 4,
  "text": "1945年让了华中军区司令员，1948年让了华东野战军司令员，现在辞了元帅衔。",
  "uiIdx": "",
  "range": "1547-1609",
  "chapterUid": 2
 },
 {
  "level": 2,
  "text": "粟裕的个人品质",
  "uiIdx": "4",
  "range": "2253-2304",
  "chapterUid": 2
 },
 {
  "level": 3,
  "text": "粟裕对地位、名利、荣誉、权力，一向不感兴趣，看得淡如水",
  "uiIdx": "4.1",
  "range": "2253-2304",
  "chapterUid": 2
 },
 {
  "level": 4,
  "text": "粟裕对评大将军衔根本不存在不满意，也不存在毛泽东找他谈话，把他批哭了的问题。",
  "uiIdx": "",
  "range": "1773-1837",
  "chapterUid": 2
 },
 {
  "level": 4,
  "text": "粟裕仍然保留着战争年代的生活习惯，每晚睡前把衣服鞋袜、腰带背包放到随手可及的地方。",
  "uiIdx": "",
  "range": "2812-2876",
  "chapterUid": 2
 },
 {
  "level": 4,
  "text": "从结婚起，粟裕就包揽了家务事。家里的账是他在管，楚青每个月的工资如数交给他。孩子的生活用品，大都是他亲自上街去买。孩子上托儿所是他去送，汗衫穿破了自己用针线缝补，节假日陪妻儿去郊区散步。",
  "uiIdx": "",
  "range": "2876-2992",
  "chapterUid": 2
 },
 {
  "level": 4,
  "text": "他和楚青双方老人的生活费，他每月会按时寄去。解放后，他把母亲从湖南会同接到了南京。去北京后，母亲留在了南京家中，由他的大姐照顾。",
  "uiIdx": "",
  "range": "2992-3079",
  "chapterUid": 2
 },
 {
  "level": 4,
  "text": "粟裕去世后，鞠开听楚青说，粟裕当年追求楚青时，楚青开始不答应，说自己不愿意做大首长的夫人，要有自己的独立性。粟裕说，不会把她当家庭主妇看待。解放后，楚青一心忙于工作，每天搭公交车到电报大楼东边的商业部上班。",
  "uiIdx": "",
  "range": "3079-3182",
  "chapterUid": 2
 },
 {
  "level": 1,
  "text": "教子“十字”秘笈",
  "uiIdx": "",
  "range": "",
  "chapterUid": 2
 },
 {
  "level": 2,
  "text": "粟裕对子女的教育理念及方式",
  "uiIdx": "1",
  "range": "556-595",
  "chapterUid": 2
 },
 {
  "level": 3,
  "text": "粟裕对子女的关爱和教育是严厉“无情”的，更多地充满了军人特殊的教育方式：吃苦、耐劳、严肃、顽强、勇敢。",
  "uiIdx": "1.1",
  "range": "556-595",
  "chapterUid": 2
 },
 {
  "level": 2,
  "text": "粟裕对子女的具体教育方法",
  "uiIdx": "2",
  "range": "700-720",
  "chapterUid": 2
 },
 {
  "level": 3,
  "text": "粟裕通过体育锻炼培养孩子的吃苦精神和胆量",
  "uiIdx": "2.1",
  "range": "700-720",
  "chapterUid": 2
 },
 {
  "level": 4,
  "text": "粟裕一有空就带着孩子们去游泳或滑冰。",
  "uiIdx": "",
  "range": "700-720",
  "chapterUid": 2
 },
 {
  "level": 4,
  "text": "粟戎生刚满三岁的时候，粟裕与楚青就带着他去河边游泳，粟裕拿出事先准备好的竹筒，塞给孩子说：“抱紧了，跳下去！”。",
  "uiIdx": "",
  "range": "720-799",
  "chapterUid": 2
 },
 {
  "level": 3,
  "text": "粟裕要求子女在艰苦的环境中锻炼",
  "uiIdx": "2.2",
  "range": "1122-1184",
  "chapterUid": 2
 },
 {
  "level": 4,
  "text": "粟戎生从哈尔滨军事工程学院毕业后，粟裕就要求他到作战部队，从一名普通士兵做起。",
  "uiIdx": "",
  "range": "1122-1184",
  "chapterUid": 2
 },
 {
  "level": 4,
  "text": "粟寒生入伍后，一直在舰艇上工作。因长期海上作业，粟寒生得了风湿性关节炎，转业到交通部。粟裕又支持他继续上远洋轮工作，所以粟寒生又转业到了远洋公司。",
  "uiIdx": "",
  "range": "1289-1385",
  "chapterUid": 2
 },
 {
  "level": 4,
  "text": "粟惠宁在当兵头三年，就做过通信值机员、展览会讲解员、宣传队员、炊事兵等多种工作。",
  "uiIdx": "",
  "range": "1473-1513",
  "chapterUid": 2
 },
 {
  "level": 3,
  "text": "粟裕对子女在日常生活中的要求",
  "uiIdx": "2.3",
  "range": "1861-1921",
  "chapterUid": 2
 },
 {
  "level": 4,
  "text": "粟戎生当兵后，好不容易有休假在家的时间，不必像在部队那样每天保持高度作战准备，所以背包也不打，内务也没有整理，就出门了。粟裕看到他的房间衣服鞋子放置很乱，就把他叫回来进行了严肃地批评。",
  "uiIdx": "",
  "range": "1861-1974",
  "chapterUid": 2
 },
 {
  "level": 4,
  "text": "粟戎生看着父亲那严整的军容，深刻理解到父亲是要自己从战士做起，脚踏实地，才能成长为一名合格的军人。",
  "uiIdx": "",
  "range": "2099-2148",
  "chapterUid": 2
 },
 {
  "level": 1,
  "text": "“图痴”“枪迷”",
  "uiIdx": "",
  "range": "",
  "chapterUid": 2
 },
 {
  "level": 2,
  "text": "粟裕对地图的热爱和研究",
  "uiIdx": "1",
  "range": "527-598",
  "chapterUid": 2
 },
 {
  "level": 3,
  "text": "粟裕对地图有着深入的研究和热爱，每到一个地方，首先是挂地图，随后就是看地图",
  "uiIdx": "1.1",
  "range": "527-598",
  "chapterUid": 2
 },
 {
  "level": 4,
  "text": "粟裕用图有一个特点，“不仅看1/50000的地图，还要看友邻部队地区的1/200000图，以及更大范围的1/500000图和全国1/1000000图”。",
  "uiIdx": "",
  "range": "803-914",
  "chapterUid": 2
 },
 {
  "level": 3,
  "text": "粟裕不仅爱看地图，还能熟记地图上的内容",
  "uiIdx": "1.2",
  "range": "971-1014",
  "chapterUid": 2
 },
 {
  "level": 4,
  "text": "粟裕早就反复察看过这一带的地图，背得滚瓜烂熟了。",
  "uiIdx": "",
  "range": "1077-1101",
  "chapterUid": 2
 },
 {
  "level": 3,
  "text": "粟裕对地图的珍视，不允许有一处污点，更不许将地图用作其他方面",
  "uiIdx": "1.3",
  "range": "1252-1286",
  "chapterUid": 2
 },
 {
  "level": 4,
  "text": "即使是废旧地图，他也提出不能随便乱丢，要交专门部门保密处理。",
  "uiIdx": "",
  "range": "1286-1316",
  "chapterUid": 2
 },
 {
  "level": 2,
  "text": "粟裕对枪支的热爱和研究",
  "uiIdx": "2",
  "range": "1645-1669",
  "chapterUid": 2
 },
 {
  "level": 3,
  "text": "粟裕对枪支有着深入的研究和热爱，少年时代就请家里长工阿陀给他做过“土枪”",
  "uiIdx": "2.1",
  "range": "1645-1669",
  "chapterUid": 2
 },
 {
  "level": 4,
  "text": "在湖南省立第二师范学校念书时，他应中共组织的号召，与同学滕久忠一起自掏腰包，凑钱买了一支驳壳枪。",
  "uiIdx": "",
  "range": "1669-1748",
  "chapterUid": 2
 },
 {
  "level": 3,
  "text": "粟裕家里的枪几乎每支都有一段故事，有的来自他指挥战斗的战场缴获，有的则是部队或者国际友人给他的赠品",
  "uiIdx": "2.2",
  "range": "1808-1881",
  "chapterUid": 2
 },
 {
  "level": 4,
  "text": "粟裕担任总参谋长时，粟戎生向父亲抱怨说：“咱们的枪不好，美国的卡宾枪又轻又灵活。”。",
  "uiIdx": "",
  "range": "2066-2107",
  "chapterUid": 2
 },
 {
  "level": 3,
  "text": "粟裕不仅爱枪，而且善射，弹无虚发",
  "uiIdx": "2.3",
  "range": "2854-2894",
  "chapterUid": 2
 },
 {
  "level": 4,
  "text": "一次视察训练场时，粟裕走到一个战士前，拿出一枚硬币，放在他的枪的准星上，命令他射击。战士的扳机一扣，硬币应声落地。粟裕当即取过枪支，卧姿趴下，又将硬币放到枪的准星上，连续击发，硬币却纹丝不动。",
  "uiIdx": "",
  "range": "2894-2990",
  "chapterUid": 2
 },
 {
  "level": 1,
  "text": "未了的夙愿",
  "uiIdx": "",
  "range": "",
  "chapterUid": 2
 },
 {
  "level": 2,
  "text": "粟裕在军委扩大会议上受到不公正批判",
  "uiIdx": "1",
  "range": "503-554",
  "chapterUid": 2
 },
 {
  "level": 3,
  "text": "粟裕被撤去总参谋长职务，被扣上了“个人主义”的帽子。",
  "uiIdx": "1.1",
  "range": "503-554",
  "chapterUid": 2
 },
 {
  "level": 3,
  "text": "粟裕对此宠辱不惊，全身心地投入到军事科学院的工作中去",
  "uiIdx": "1.2",
  "range": "579-643",
  "chapterUid": 2
 },
 {
  "level": 4,
  "text": "粟裕不表白、不埋怨、不消沉。",
  "uiIdx": "",
  "range": "579-643",
  "chapterUid": 2
 },
 {
  "level": 2,
  "text": "粟裕在军事上的贡献",
  "uiIdx": "2",
  "range": "771-890",
  "chapterUid": 2
 },
 {
  "level": 3,
  "text": "粟裕在庐山会议上提出歼灭入侵之敌的具体方案",
  "uiIdx": "2.1",
  "range": "771-890",
  "chapterUid": 2
 },
 {
  "level": 4,
  "text": "该方案被认为是“奇特的作战构想”和歼敌的“锦囊妙计”。",
  "uiIdx": "",
  "range": "771-890",
  "chapterUid": 2
 },
 {
  "level": 3,
  "text": "粟裕在东南沿海紧急战备期间提出具体作战方案",
  "uiIdx": "2.2",
  "range": "771-890",
  "chapterUid": 2
 },
 {
  "level": 4,
  "text": "粟裕在深入实地调查研究后，根据敌情我情，向福州军区领导提出歼灭入侵之敌的具体方案。",
  "uiIdx": "",
  "range": "771-890",
  "chapterUid": 2
 },
 {
  "level": 3,
  "text": "粟裕在任中共中央军委常委后，协助中央军委副主席兼秘书长叶剑英发布和制订许多命令、规定",
  "uiIdx": "2.3",
  "range": "890-991",
  "chapterUid": 2
 },
 {
  "level": 4,
  "text": "粟裕极力把军队的运动限制在院校和部分机关，保持部队的基本稳定。",
  "uiIdx": "",
  "range": "890-991",
  "chapterUid": 2
 },
 {
  "level": 3,
  "text": "粟裕受周恩来委托，历时50天行程7000多千米，视察西北、华北边防",
  "uiIdx": "2.4",
  "range": "991-1142",
  "chapterUid": 2
 },
 {
  "level": 4,
  "text": "粟裕获得北部边防大量第一手材料，特别是进一步发现作战指导思想和国防工程方面存在的某些严重问题。返京后，他如实地向中共中央反映情况。",
  "uiIdx": "",
  "range": "991-1160",
  "chapterUid": 2
 },
 {
  "level": 2,
  "text": "粟裕与陈毅的友情",
  "uiIdx": "3",
  "range": "1214-1247",
  "chapterUid": 2
 },
 {
  "level": 3,
  "text": "陈毅去世后，粟裕早早来到了追悼会，毛泽东看到了粟裕，紧紧地握着他的手说：“井冈山时期的战友不多了。”。",
  "uiIdx": "3.1",
  "range": "1214-1247",
  "chapterUid": 2
 },
 {
  "level": 2,
  "text": "粟裕的身体状况和逝世",
  "uiIdx": "4",
  "range": "1309-1366",
  "chapterUid": 2
 },
 {
  "level": 3,
  "text": "粟裕的身体状况一直不好，长期住院治疗，身体已经无法胜任高强度的工作",
  "uiIdx": "4.1",
  "range": "1309-1366",
  "chapterUid": 2
 },
 {
  "level": 4,
  "text": "粟裕一生先后六次负伤。",
  "uiIdx": "",
  "range": "1366-1419",
  "chapterUid": 2
 },
 {
  "level": 3,
  "text": "1984年2月5日，粟裕逝世，骨灰被撒在了山东、江苏、浙江、福建、江西、安徽、河南等他战斗过的地方，以及他四次渡过的长江中。",
  "uiIdx": "4.2",
  "range": "1556-1612",
  "chapterUid": 2
 },
 {
  "level": 2,
  "text": "粟裕的夙愿",
  "uiIdx": "5",
  "range": "1612-1672",
  "chapterUid": 2
 },
 {
  "level": 3,
  "text": "粟裕曾对儿女许愿，全国解放了，就带他们回湖南老家，但一直未能了却这个夙愿",
  "uiIdx": "5.1",
  "range": "1612-1672",
  "chapterUid": 2
 },
 {
  "level": 4,
  "text": "自从1927年跟随毛泽东、朱德上了井冈山，终其一生，他再未踏上故土一步。",
  "uiIdx": "",
  "range": "1672-1708",
  "chapterUid": 2
 },
 {
  "level": 1,
  "text": "粟裕大事年表",
  "uiIdx": "",
  "range": "",
  "chapterUid": 2
 },
 {
  "level": 2,
  "text": "粟裕的生平经历",
  "uiIdx": "1",
  "range": "504-530",
  "chapterUid": 2
 },
 {
  "level": 3,
  "text": "1907年8月10日生于湖南会同坪村乡枫木树脚村，侗族。",
  "uiIdx": "1.1",
  "range": "504-530",
  "chapterUid": 2
 },
 {
  "level": 3,
  "text": "1927年6月加入中国共产党。",
  "uiIdx": "1.2",
  "range": "533-572",
  "chapterUid": 2
 },
 {
  "level": 3,
  "text": "1928年参加湘南起义后到井冈山，历任中国工农红军连长、营长、团长、师长，红4军参谋长、红七军团参谋长等职。",
  "uiIdx": "1.3",
  "range": "613-673",
  "chapterUid": 2
 },
 {
  "level": 3,
  "text": "1934年7月任红军北上抗日先遣队参谋长。",
  "uiIdx": "1.4",
  "range": "673-718",
  "chapterUid": 2
 },
 {
  "level": 3,
  "text": "1935年1月任挺进师师长、闽浙军区司令员。",
  "uiIdx": "1.5",
  "range": "718-764",
  "chapterUid": 2
 },
 {
  "level": 3,
  "text": "1938年4月任新四军第2支队副司令员、先遣支队司令员。",
  "uiIdx": "1.6",
  "range": "764-816",
  "chapterUid": 2
 },
 {
  "level": 3,
  "text": "1939年8月至1944年12月任新四军江南指挥部副指挥、苏北指挥部副指挥兼参谋长、第1师师长(后兼政治委员)，苏中军区司令员兼政治委员、中共苏中区委员会书记、苏浙军区司令员兼政治委员等职。",
  "uiIdx": "1.7",
  "range": "816-981",
  "chapterUid": 2
 },
 {
  "level": 3,
  "text": "1945年10月任华中军区副司令员、华中野战军司令员。",
  "uiIdx": "1.8",
  "range": "981-1032",
  "chapterUid": 2
 },
 {
  "level": 3,
  "text": "1947年1月任华东野战军副司令员。",
  "uiIdx": "1.9",
  "range": "1032-1074",
  "chapterUid": 2
 },
 {
  "level": 3,
  "text": "1948年5月任华东野战军代司令员兼代政治委员。",
  "uiIdx": "1.10",
  "range": "1074-1122",
  "chapterUid": 2
 },
 {
  "level": 3,
  "text": "1949年1月任第三野战军副司令员兼第二副政治委员(仍代理司令员、政治委员职务)。",
  "uiIdx": "1.11",
  "range": "1122-1210",
  "chapterUid": 2
 },
 {
  "level": 3,
  "text": "1951年任人民解放军副总参谋长，1954年任总参谋长。",
  "uiIdx": "1.12",
  "range": "1210-1285",
  "chapterUid": 2
 },
 {
  "level": 3,
  "text": "1955年被授予大将军衔。",
  "uiIdx": "1.13",
  "range": "1285-1322",
  "chapterUid": 2
 },
 {
  "level": 3,
  "text": "1958年调任国防部副部长兼军事科学院副院长。",
  "uiIdx": "1.14",
  "range": "1322-1369",
  "chapterUid": 2
 },
 {
  "level": 3,
  "text": "1972年任军事科学院第一政治委员。",
  "uiIdx": "1.15",
  "range": "1369-1411",
  "chapterUid": 2
 },
 {
  "level": 3,
  "text": "1980年当选为全国人大常委会副委员长。",
  "uiIdx": "1.16",
  "range": "1411-1455",
  "chapterUid": 2
 },
 {
  "level": 3,
  "text": "1984年2月5日病逝于北京。",
  "uiIdx": "1.17",
  "range": "1455-1494",
  "chapterUid": 2
 }
]