[
 {
  "level": 1,
  "text": "要不要买三毛的房子",
  "uiIdx": "",
  "range": "",
  "chapterUid": 3
 },
 {
  "level": 2,
  "text": "老爷爷是三毛故居的现任房主",
  "uiIdx": "1",
  "range": "4093-4116",
  "chapterUid": 3
 },
 {
  "level": 3,
  "text": "老爷爷从三毛手里买下了这个房子",
  "uiIdx": "1.1",
  "range": "4093-4116",
  "chapterUid": 3
 },
 {
  "level": 4,
  "text": "老爷爷40多年前是个年轻人，三毛也是个年轻中年人。",
  "uiIdx": "",
  "range": "4093-4116",
  "chapterUid": 3
 },
 {
  "level": 4,
  "text": "老爷爷见过三毛，人很随和。",
  "uiIdx": "",
  "range": "1250-1260",
  "chapterUid": 3
 },
 {
  "level": 2,
  "text": "三毛在加纳利岛的生活",
  "uiIdx": "2",
  "range": "2205-2270",
  "chapterUid": 3
 },
 {
  "level": 3,
  "text": "三毛在大加纳利gran canaria住了两年，搬到更偏僻的Tenerife岛",
  "uiIdx": "2.1",
  "range": "2205-2270",
  "chapterUid": 3
 },
 {
  "level": 4,
  "text": "三毛在《温柔的夜》里写到，她住在这里时喜欢去对面的垃圾场捡垃圾，改造成家具、衣服、装饰品。",
  "uiIdx": "",
  "range": "3636-3681",
  "chapterUid": 3
 },
 {
  "level": 3,
  "text": "荷西在Tenerife岛去世，三毛在48岁时逝世",
  "uiIdx": "2.2",
  "range": "2006-2014",
  "chapterUid": 3
 },
 {
  "level": 4,
  "text": "三毛在Tenerife岛总觉得要出什么事，亲人死前会有预兆。",
  "uiIdx": "",
  "range": "2270-2419",
  "chapterUid": 3
 },
 {
  "level": 2,
  "text": "作者对三毛房子的看法",
  "uiIdx": "3",
  "range": "7035-7049",
  "chapterUid": 3
 },
 {
  "level": 3,
  "text": "作者认为买下三毛的房子会把自己困住",
  "uiIdx": "3.1",
  "range": "7035-7049",
  "chapterUid": 3
 },
 {
  "level": 4,
  "text": "作者认为，买她的房子岂不是买椟还珠？",
  "uiIdx": "",
  "range": "7035-7049",
  "chapterUid": 3
 },
 {
  "level": 3,
  "text": "作者建议真正想要致敬，不如去浪迹天涯",
  "uiIdx": "3.2",
  "range": "7332-7352",
  "chapterUid": 3
 },
 {
  "level": 4,
  "text": "作者认为，人钻笼子钻久了，就想钻更大的笼子，想给笼子镶嵌上宝石，或者用黄金打造一个笼子，再给笼子门口挂一个VIP专属。等那一天，我住惯了黄金宝石的笼子，你打开门，我也不会走出去了。因为我习惯了笼子，离开笼子就像蜗牛取了壳一样，血肉模糊。",
  "uiIdx": "",
  "range": "7332-7466",
  "chapterUid": 3
 },
 {
  "level": 1,
  "text": "沙漠边有大海和裸体",
  "uiIdx": "",
  "range": "",
  "chapterUid": 3
 },
 {
  "level": 2,
  "text": "大加那利岛的北部Las Palmas小城的生活",
  "uiIdx": "1",
  "range": "477-529",
  "chapterUid": 3
 },
 {
  "level": 3,
  "text": "小城中心区非常小，随便哪个方向走一阵子，很容易走到尽头",
  "uiIdx": "1.1",
  "range": "477-529",
  "chapterUid": 3
 },
 {
  "level": 4,
  "text": "巷子里总能发现新东西，一家烤乳猪店、一家菲律宾菜馆、一家旧书店、一家瑜伽馆。",
  "uiIdx": "",
  "range": "546-690",
  "chapterUid": 3
 },
 {
  "level": 4,
  "text": "几个街心花园突然出现，花园的一半种着蔬菜，菜地旁还煞有介事地半躺着一个稻草人。",
  "uiIdx": "",
  "range": "690-729",
  "chapterUid": 3
 },
 {
  "level": 4,
  "text": "还有一条街，散落着几家亚洲饭店和一间小卖部。",
  "uiIdx": "",
  "range": "729-751",
  "chapterUid": 3
 },
 {
  "level": 3,
  "text": "中餐厅的鱼香肉丝与福建鱼香肉丝的区别",
  "uiIdx": "1.2",
  "range": "1654-1690",
  "chapterUid": 3
 },
 {
  "level": 4,
  "text": "“这是什么？”我看着一盘清清白白，鱼干、肉丝、青红椒、洋葱搅和在一起，一点酱油也没有。以为她上错菜了。",
  "uiIdx": "",
  "range": "1654-1690",
  "chapterUid": 3
 },
 {
  "level": 4,
  "text": "“这是福建鱼香肉丝。你看，有鱼有肉丝。你说的那种没有鱼。”。",
  "uiIdx": "",
  "range": "2077-2096",
  "chapterUid": 3
 },
 {
  "level": 2,
  "text": "大加那利岛的南部与沙漠",
  "uiIdx": "2",
  "range": "4589-4731",
  "chapterUid": 3
 },
 {
  "level": 3,
  "text": "南部沙滩边的酒店里、饭店里，80%都是老人",
  "uiIdx": "2.1",
  "range": "4589-4731",
  "chapterUid": 3
 },
 {
  "level": 4,
  "text": "我走过海边的美食街，两边坐满了老人，他们都好奇地看着我。我感觉像进入了一家露天养老院。",
  "uiIdx": "",
  "range": "4731-4774",
  "chapterUid": 3
 },
 {
  "level": 3,
  "text": "沙漠背后的山，前面是海，中间是一条街",
  "uiIdx": "2.2",
  "range": "4774-4899",
  "chapterUid": 3
 },
 {
  "level": 4,
  "text": "我脱了鞋，爬过一座座沙丘，到达最高处。",
  "uiIdx": "",
  "range": "4899-4918",
  "chapterUid": 3
 },
 {
  "level": 4,
  "text": "左边深深浅浅的褐色山脉，右边白云蓝天，眼前起起伏伏的黄色沙漠。脚下是柔软温暖的沙子。",
  "uiIdx": "",
  "range": "4918-4949",
  "chapterUid": 3
 },
 {
  "level": 2,
  "text": "沙漠与人的关系",
  "uiIdx": "3",
  "range": "6190-6218",
  "chapterUid": 3
 },
 {
  "level": 3,
  "text": "沙漠把坚硬的地面变得柔软，像地球的柔软肚皮",
  "uiIdx": "3.1",
  "range": "6190-6218",
  "chapterUid": 3
 },
 {
  "level": 4,
  "text": "我知道为什么沙漠让人开心了，因为它把坚硬的地面变得柔软。",
  "uiIdx": "",
  "range": "6190-6218",
  "chapterUid": 3
 },
 {
  "level": 4,
  "text": "地球如果都是软软的，人的心应该也软很多吧。就像我们把头靠在毛茸茸的动物身上，就觉得平静有爱一样。沙漠就像地球的柔软肚皮。",
  "uiIdx": "",
  "range": "6218-6278",
  "chapterUid": 3
 },
 {
  "level": 3,
  "text": "裸着可以做任何事，裸着的人面不改色，周围的人也习以为常",
  "uiIdx": "3.2",
  "range": "6441-6469",
  "chapterUid": 3
 },
 {
  "level": 4,
  "text": "我在西班牙见了很多裸体，从巴塞罗那岛加纳利岛，人们想裸就裸了。",
  "uiIdx": "",
  "range": "6410-6441",
  "chapterUid": 3
 },
 {
  "level": 4,
  "text": "人要穿衣服，说到底是人自己制定的规则。规则如果变了，人不穿衣服也可以。一直恪守的规则，换了一个地方，发现没人把它当回事，这时才发现自己的局限之处。",
  "uiIdx": "",
  "range": "6469-6648",
  "chapterUid": 3
 }
]