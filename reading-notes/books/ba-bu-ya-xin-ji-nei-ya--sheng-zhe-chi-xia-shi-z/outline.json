[
 {
  "level": 1,
  "text": "正文",
  "uiIdx": "",
  "range": "",
  "chapterUid": 4
 },
 {
  "level": 2,
  "text": "作者的旅行经历",
  "uiIdx": "1",
  "range": "2166-2269",
  "chapterUid": 4
 },
 {
  "level": 3,
  "text": "作者在巴布亚新几内亚的旅行中，经历了地震、机场关闭、同伴病倒等意外",
  "uiIdx": "1.1",
  "range": "2166-2269",
  "chapterUid": 4
 },
 {
  "level": 4,
  "text": "出发前一周拿到签证，却在出发前收到巴新全境为极高风险的恶性疟疾区的信息。",
  "uiIdx": "",
  "range": "2567-2725",
  "chapterUid": 4
 },
 {
  "level": 4,
  "text": "飞机降落在莫尔斯比港，巴新的首都，也是东南部最大城市。",
  "uiIdx": "",
  "range": "3583-3610",
  "chapterUid": 4
 },
 {
  "level": 4,
  "text": "我们去市郊的公园看动物，巴新最著名的动物是极乐鸟和树袋熊。",
  "uiIdx": "",
  "range": "4633-4706",
  "chapterUid": 4
 },
 {
  "level": 4,
  "text": "第二天我们早上4：30出发，飞往高地。",
  "uiIdx": "",
  "range": "5138-5180",
  "chapterUid": 4
 },
 {
  "level": 4,
  "text": "我们坐上一辆巴士，沿着这条道路驶向旅馆。",
  "uiIdx": "",
  "range": "5700-5743",
  "chapterUid": 4
 },
 {
  "level": 4,
  "text": "在殖民者到来之前，基督教还没有取代本土信仰，每个部落都有自己的神灵。",
  "uiIdx": "",
  "range": "10475-10532",
  "chapterUid": 4
 },
 {
  "level": 4,
  "text": "从部落出来，Diego问哪里能买到酒。",
  "uiIdx": "",
  "range": "12058-12077",
  "chapterUid": 4
 },
 {
  "level": 4,
  "text": "早上8点，我们去盛大的Goroka show(部落文化节)。",
  "uiIdx": "",
  "range": "12290-12354",
  "chapterUid": 4
 },
 {
  "level": 4,
  "text": "这天我们来到昆虫猎人和青蛙猎人部落。",
  "uiIdx": "",
  "range": "17657-17675",
  "chapterUid": 4
 },
 {
  "level": 4,
  "text": "晚餐时，大家问Scot对巴新的未来如何看待，他回答：“最希望国家有更多工作机会，有更多海外投资者，因为很多孩子上完大学也找不到工作，我上过大学，毕业后3年找不到工作，又回到村里，种地打猎。",
  "uiIdx": "",
  "range": "22567-22684",
  "chapterUid": 4
 },
 {
  "level": 2,
  "text": "巴布亚新几内亚的食人族",
  "uiIdx": "2",
  "range": "1041-1133",
  "chapterUid": 4
 },
 {
  "level": 3,
  "text": "基督教普及之前，食人很常见，吃人总有目的，有的是为了生存(食物)；有的为了显示威严，在战争中吃掉其他部落的首领和武士，宣告大获全胜；还有的部落，女人死了丈夫，太过悲伤不能忘怀，就吃掉他的手掌和大腿，剩下的肉与全家分食",
  "uiIdx": "2.1",
  "range": "1041-1133",
  "chapterUid": 4
 },
 {
  "level": 4,
  "text": "他们认为死者的灵魂和生命力通过被吃下而得以延续。",
  "uiIdx": "",
  "range": "6890-6914",
  "chapterUid": 4
 },
 {
  "level": 4,
  "text": "吃人的方式也不同，有的直接放锅里煮熟吃；有的火化后把骨头磨成粉，做成汤全族人一起喝；有的生吃心脏和大脑。",
  "uiIdx": "",
  "range": "6914-6989",
  "chapterUid": 4
 },
 {
  "level": 3,
  "text": "基督教劝人们不要吃人，否则无法进入吃喝不愁、尽情享乐的天堂，又在山区建免费学校，普及基础教育，总之，现在绝无食人族了",
  "uiIdx": "2.2",
  "range": "7053-7135",
  "chapterUid": 4
 },
 {
  "level": 4,
  "text": "食人族的探寻还没开始就宣告结束，但失之东隅，收之桑榆，巴新永远不缺好故事。",
  "uiIdx": "",
  "range": "7135-7195",
  "chapterUid": 4
 },
 {
  "level": 2,
  "text": "巴布亚新几内亚的部落文化",
  "uiIdx": "3",
  "range": "10577-10591",
  "chapterUid": 4
 },
 {
  "level": 3,
  "text": "巴布亚新几内亚的部落拥有自己的神灵，人们死后有灵魂，会在原地生活",
  "uiIdx": "3.1",
  "range": "10577-10591",
  "chapterUid": 4
 },
 {
  "level": 4,
  "text": "无论多远，巴新人的遗体都要被运回故乡，否则灵魂将成为无家可归的游魂。",
  "uiIdx": "",
  "range": "10591-10627",
  "chapterUid": 4
 },
 {
  "level": 3,
  "text": "部落以族类进行敌我区分，而不是个人，如果一个部落的人杀死了另一个部落的人，他们不必找凶手报仇，而可以杀死仇人部落的任何一人",
  "uiIdx": "3.2",
  "range": "14199-14284",
  "chapterUid": 4
 },
 {
  "level": 4,
  "text": "设想100年前，一名游客闯入部落，做了惹怒他们的事之后逃走，第二名到来的游客就会被杀掉复仇，哪怕这位新游客非常友善，对历史恩怨一无所知。",
  "uiIdx": "",
  "range": "14314-14382",
  "chapterUid": 4
 },
 {
  "level": 3,
  "text": "部落文化吸引来世界各地的游客，他们付门票、住旅馆、买食物和纪念品，为人民带来了经济收入",
  "uiIdx": "3.3",
  "range": "14548-14593",
  "chapterUid": 4
 },
 {
  "level": 4,
  "text": "父母们要教育孩子，做遵纪守法的良民，不要抽大麻、酗酒、偷窃、暴力，去上学，勤劳工作，继承部落文化，不要忘记，这是我们的生命力之源，也是发展的基石。",
  "uiIdx": "",
  "range": "14593-14667",
  "chapterUid": 4
 },
 {
  "level": 2,
  "text": "作者对旅行的理解",
  "uiIdx": "4",
  "range": "2329-2413",
  "chapterUid": 4
 },
 {
  "level": 3,
  "text": "旅行的开始并不顺利，出发日期临近，签证却没拿到",
  "uiIdx": "4.1",
  "range": "2329-2413",
  "chapterUid": 4
 },
 {
  "level": 4,
  "text": "扣款倒是非常迅速，之后的两个月，工作人员像消失了一样，发几封邮件都不回复。",
  "uiIdx": "",
  "range": "2329-2413",
  "chapterUid": 4
 },
 {
  "level": 3,
  "text": "作者认为，旅行就是跳入未知的世界，尽情享受无尽的冒险",
  "uiIdx": "4.2",
  "range": "2269-2329",
  "chapterUid": 4
 },
 {
  "level": 4,
  "text": "以至于后来，我已经忘记最初的目的，只是纵身跳入未知的世界，尽情享受无尽的冒险，仿佛穿越到另一个星球，神出鬼没，无拘无束。",
  "uiIdx": "",
  "range": "2269-2329",
  "chapterUid": 4
 }
]