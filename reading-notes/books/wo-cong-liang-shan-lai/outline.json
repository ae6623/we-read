[
 {
  "level": 1,
  "text": "阿呷，火车来了，你听",
  "uiIdx": "",
  "range": "",
  "chapterUid": 4
 },
 {
  "level": 2,
  "text": "父亲与母亲的相遇与相爱",
  "uiIdx": "1",
  "range": "1710-1875",
  "chapterUid": 4
 },
 {
  "level": 3,
  "text": "父亲在越西县的姑姑家帮忙干活儿时，遇见了母亲",
  "uiIdx": "1.1",
  "range": "1710-1875",
  "chapterUid": 4
 },
 {
  "level": 4,
  "text": "父亲二十二岁那年，去越西县的姑姑家帮忙干活儿。",
  "uiIdx": "",
  "range": "1710-1875",
  "chapterUid": 4
 },
 {
  "level": 4,
  "text": "一日，父亲坐在火塘边生火。母亲来串门，进门便坐到火塘边和姑姑聊起家常。",
  "uiIdx": "",
  "range": "1916-1974",
  "chapterUid": 4
 },
 {
  "level": 4,
  "text": "父亲说：“你妈妈太美了，我一见她就喜欢上了她。”。",
  "uiIdx": "",
  "range": "1974-1998",
  "chapterUid": 4
 },
 {
  "level": 3,
  "text": "父亲与母亲因酒而相识，彼此产生了好感",
  "uiIdx": "1.2",
  "range": "2147-2194",
  "chapterUid": 4
 },
 {
  "level": 4,
  "text": "彝人喝酒前往往会论一论各家的家支谱系、远近亲朋，再往上追溯一番，往往就有了不可动摇的亲戚关系。",
  "uiIdx": "",
  "range": "2147-2194",
  "chapterUid": 4
 },
 {
  "level": 4,
  "text": "母亲那年十七岁，彝人有谚：彝家女子十七嫁。母亲一到十七岁，外公便托人给她做媒。",
  "uiIdx": "",
  "range": "2247-2309",
  "chapterUid": 4
 },
 {
  "level": 4,
  "text": "父亲遇见母亲时，母亲已有婚约在身。父亲并未退缩，向母亲表达了心意。",
  "uiIdx": "",
  "range": "2450-2506",
  "chapterUid": 4
 },
 {
  "level": 4,
  "text": "青涩的母亲第一次尝到恋爱的滋味，她大起胆子向外公外婆提出了退婚。",
  "uiIdx": "",
  "range": "2506-2538",
  "chapterUid": 4
 },
 {
  "level": 2,
  "text": "父亲与母亲的人生历程",
  "uiIdx": "2",
  "range": "3085-3127",
  "chapterUid": 4
 },
 {
  "level": 3,
  "text": "父亲家境贫寒，但坚信读书可以改变命运",
  "uiIdx": "2.1",
  "range": "3085-3127",
  "chapterUid": 4
 },
 {
  "level": 4,
  "text": "父亲十六岁丧父，从那时起开始独自闯荡。",
  "uiIdx": "",
  "range": "3085-3127",
  "chapterUid": 4
 },
 {
  "level": 4,
  "text": "爷爷没给他留下财产与人脉，父亲贫穷且孤零。",
  "uiIdx": "",
  "range": "3127-3148",
  "chapterUid": 4
 },
 {
  "level": 4,
  "text": "父亲深信读书可以改变命运，大半生都敬畏书本，敬畏知识。",
  "uiIdx": "",
  "range": "2768-2802",
  "chapterUid": 4
 },
 {
  "level": 3,
  "text": "母亲不识字，却颇有生意头脑，家庭一跃成了乡上的首富",
  "uiIdx": "2.2",
  "range": "3360-3423",
  "chapterUid": 4
 },
 {
  "level": 4,
  "text": "母亲先是经营了一家小卖部，后又开办了乡上第一家KTV。",
  "uiIdx": "",
  "range": "3360-3423",
  "chapterUid": 4
 },
 {
  "level": 4,
  "text": "铁道上的叔叔阿姨们常在下班后来此唱上几首，喝上几杯，尽兴而归。",
  "uiIdx": "",
  "range": "3423-3454",
  "chapterUid": 4
 },
 {
  "level": 4,
  "text": "如此，我家一跃成了乡上的首富。",
  "uiIdx": "",
  "range": "3454-3469",
  "chapterUid": 4
 },
 {
  "level": 3,
  "text": "父亲成为乡长，母亲患上白血病，家庭面临巨大考验",
  "uiIdx": "2.3",
  "range": "3517-3566",
  "chapterUid": 4
 },
 {
  "level": 4,
  "text": "1999年是父亲生命中幸福的一年，他成了年轻的乡长。",
  "uiIdx": "",
  "range": "3517-3594",
  "chapterUid": 4
 },
 {
  "level": 4,
  "text": "1999年同样是父亲生命中痛苦的一年，母亲患上了白血病。",
  "uiIdx": "",
  "range": "3517-3594",
  "chapterUid": 4
 },
 {
  "level": 4,
  "text": "母亲病情日益恶化，几近瘫痪，父亲用尽一切可以腾出的时间陪伴她，背着她寻医问药。",
  "uiIdx": "",
  "range": "3705-3768",
  "chapterUid": 4
 },
 {
  "level": 2,
  "text": "母亲去世后的父亲",
  "uiIdx": "3",
  "range": "7841-7891",
  "chapterUid": 4
 },
 {
  "level": 3,
  "text": "母亲去世后，父亲变得多愁善感，开始看情感节目",
  "uiIdx": "3.1",
  "range": "7841-7891",
  "chapterUid": 4
 },
 {
  "level": 4,
  "text": "母亲去世前曾在成都开了治疗慢粒白血病的药—格列卫，也就是电影《我不是药神》里的天价药。",
  "uiIdx": "",
  "range": "7537-7603",
  "chapterUid": 4
 },
 {
  "level": 4,
  "text": "此药的确天价，一盒上万，母亲只吃了几颗便与世长辞。",
  "uiIdx": "",
  "range": "7603-7628",
  "chapterUid": 4
 },
 {
  "level": 4,
  "text": "后来，父亲带着剩下的药去了成都，希望能将剩下的药退回。",
  "uiIdx": "",
  "range": "7628-7655",
  "chapterUid": 4
 },
 {
  "level": 3,
  "text": "父亲开始学着与我们做朋友，成为我们的母亲",
  "uiIdx": "3.2",
  "range": "8186-8213",
  "chapterUid": 4
 },
 {
  "level": 4,
  "text": "父亲对母亲的遗物视若珍宝。他将母亲生前的衣服挂得整整齐齐，将母亲的戒指小心存放。",
  "uiIdx": "",
  "range": "8186-8213",
  "chapterUid": 4
 },
 {
  "level": 4,
  "text": "母亲去世前曾在成都开了治疗慢粒白血病的药—格列卫，也就是电影《我不是药神》里的天价药。",
  "uiIdx": "",
  "range": "7537-7603",
  "chapterUid": 4
 },
 {
  "level": 4,
  "text": "此药的确天价，一盒上万，母亲只吃了几颗便与世长辞。",
  "uiIdx": "",
  "range": "7603-7628",
  "chapterUid": 4
 },
 {
  "level": 4,
  "text": "后来，父亲带着剩下的药去了成都，希望能将剩下的药退回。",
  "uiIdx": "",
  "range": "7628-7655",
  "chapterUid": 4
 },
 {
  "level": 4,
  "text": "父亲归来已是清晨，我在睡眼惺忪中看到他坐在床边，满脸笑意地看着我，转身从还未卸下的包中取出一张小方帕，上面画着几只小熊。",
  "uiIdx": "",
  "range": "7655-7715",
  "chapterUid": 4
 },
 {
  "level": 4,
  "text": "父亲展开小方帕，温柔地对我说：“阿呷，你看，这是爸爸从成都给你买的小熊帕子。”。",
  "uiIdx": "",
  "range": "7715-7754",
  "chapterUid": 4
 },
 {
  "level": 1,
  "text": "今天的云真好看啊，乌达",
  "uiIdx": "",
  "range": "",
  "chapterUid": 4
 },
 {
  "level": 2,
  "text": "乌达的父亲和乌达的情况",
  "uiIdx": "1",
  "range": "1583-1636",
  "chapterUid": 4
 },
 {
  "level": 3,
  "text": "乌达的父亲是重症监护室的陪护，乌达因重度肺炎无法咳痰而切开气管",
  "uiIdx": "1.1",
  "range": "1583-1636",
  "chapterUid": 4
 },
 {
  "level": 4,
  "text": "乌达的父亲四十多岁，一头较长的鬈发，小小的眼睛，汉语说得非常流利。",
  "uiIdx": "",
  "range": "1636-1757",
  "chapterUid": 4
 },
 {
  "level": 4,
  "text": "乌达光着头，紧闭双眼，靠着胃管进食，喉间有一处凹进去的地方，那是术后因重度肺炎无法咳痰而切开气管留下的痕迹。",
  "uiIdx": "",
  "range": "1583-1636",
  "chapterUid": 4
 },
 {
  "level": 3,
  "text": "乌达在火把节时摔伤，手术后一直昏迷不醒",
  "uiIdx": "1.2",
  "range": "2410-2470",
  "chapterUid": 4
 },
 {
  "level": 4,
  "text": "乌达是在火把节时摔伤的，被发现时已经过了一夜，送到医院后立即做了开颅手术。",
  "uiIdx": "",
  "range": "2410-2470",
  "chapterUid": 4
 },
 {
  "level": 4,
  "text": "十四天里，乌达父亲一个人守在重症监护室外，只要有医生出来就赶紧凑上去问：“我儿子怎么样了，有没有睁眼？”。",
  "uiIdx": "",
  "range": "2470-2522",
  "chapterUid": 4
 },
 {
  "level": 4,
  "text": "终于，十四天后，医生通知他孩子可以转到楼下的重症观察室了，尽管医生再三强调病人没有完全脱离生命危险，乌达父亲还是认为这已经是非常大的进步了，至少儿子离开了那个经常死人的地方，至少下一个死的不会是他儿子。",
  "uiIdx": "",
  "range": "2650-2774",
  "chapterUid": 4
 },
 {
  "level": 2,
  "text": "乌达父亲的生活经历",
  "uiIdx": "2",
  "range": "3342-3414",
  "chapterUid": 4
 },
 {
  "level": 3,
  "text": "乌达父亲二十岁在广东打工时，曾被同村发小诱惑吸毒，几个月后感到害怕回了家，戒掉了毒瘾",
  "uiIdx": "2.1",
  "range": "3342-3414",
  "chapterUid": 4
 },
 {
  "level": 4,
  "text": "乌达父亲二十四岁时，父母请媒人说亲，给他找了媳妇，也就是乌达的母亲，他们只见了一面便定了亲。",
  "uiIdx": "",
  "range": "3414-3460",
  "chapterUid": 4
 },
 {
  "level": 3,
  "text": "乌达父亲和母亲一起外出打工，跟着村里年轻人组队去了山东",
  "uiIdx": "2.2",
  "range": "3574-3675",
  "chapterUid": 4
 },
 {
  "level": 4,
  "text": "到了山东，男人们去工地抬钢筋、扛水泥，女人们去工厂，做食品的加工包装。",
  "uiIdx": "",
  "range": "3722-3780",
  "chapterUid": 4
 },
 {
  "level": 4,
  "text": "“那时候我就会开塔吊嘞，塔吊少得很哦那时候，不过我也只是没人的时候让师傅教我玩玩，要有人就不敢弄，怕砸到人。”。",
  "uiIdx": "",
  "range": "3780-3835",
  "chapterUid": 4
 },
 {
  "level": 4,
  "text": "“那时干劲儿大啊，又年轻，只要肯卖力气，真是可以赚很多钱的。我们都不怕苦，做什么不苦呢？在外面见到多少人家没见过的，是吧？”。",
  "uiIdx": "",
  "range": "4040-4143",
  "chapterUid": 4
 },
 {
  "level": 4,
  "text": "“是啊，人活在世上，做什么不苦呢？”叔叔答道。他也是二十多年前就开始携家带口去打工，听着乌达父亲这番话，深有体会。",
  "uiIdx": "",
  "range": "4125-4143",
  "chapterUid": 4
 },
 {
  "level": 3,
  "text": "乌达父亲四十岁时，妻子打电话让他回家，说小儿子全身瘀青，不知怎么了",
  "uiIdx": "2.3",
  "range": "5054-5111",
  "chapterUid": 4
 },
 {
  "level": 4,
  "text": "他赶紧收拾，坐了几天几夜的火车赶回去，到医院时却被告知孩子得的是急性白血病，已经不行了。",
  "uiIdx": "",
  "range": "5111-5155",
  "chapterUid": 4
 },
 {
  "level": 4,
  "text": "他和妻子把小儿子带回家，让他在家里度过了最后的几天。小儿子离世后，乌达父亲开始喜欢上喝酒，喝酒上脸的他总是进出于村里的小卖部，在门口和人摆谈，好像丧子之痛已成过眼云烟。“人嘛，就要往前看噻！”。",
  "uiIdx": "",
  "range": "5155-5239",
  "chapterUid": 4
 },
 {
  "level": 3,
  "text": "小儿子离世一年多后，妻子也病了，脑梗让她右边的身体一度无法动弹，几个月后才逐渐恢复知觉",
  "uiIdx": "2.4",
  "range": "5264-5331",
  "chapterUid": 4
 },
 {
  "level": 4,
  "text": "乌达父亲从此戒了酒，全心照顾妻子，直到她能下地自理才又出去打工。",
  "uiIdx": "",
  "range": "5331-5363",
  "chapterUid": 4
 },
 {
  "level": 2,
  "text": "乌达父亲的崩溃和离世",
  "uiIdx": "3",
  "range": "6917-6974",
  "chapterUid": 4
 },
 {
  "level": 3,
  "text": "乌达在回家十天后就离世了，乌达父亲成为很多人的心结",
  "uiIdx": "3.1",
  "range": "6917-6974",
  "chapterUid": 4
 },
 {
  "level": 4,
  "text": "那天下午，叔叔请乌达父亲喝了一顿酒，他又一次喝得脸红，喝得左右摇晃。",
  "uiIdx": "",
  "range": "6917-6974",
  "chapterUid": 4
 },
 {
  "level": 4,
  "text": "他问叔叔：“我年轻时，犯过吸毒这个错，是不是因为这个，才惩罚我呢？”。",
  "uiIdx": "",
  "range": "6974-7008",
  "chapterUid": 4
 },
 {
  "level": 4,
  "text": "那天云很好，叔叔说乌达父亲喝得有点醉，竟对着远处的晚霞举杯：“今天的云真好看啊。”。",
  "uiIdx": "",
  "range": "7008-7049",
  "chapterUid": 4
 },
 {
  "level": 1,
  "text": "阿卓",
  "uiIdx": "",
  "range": "",
  "chapterUid": 4
 },
 {
  "level": 2,
  "text": "阿卓的遭遇和成长",
  "uiIdx": "1",
  "range": "1563-1588",
  "chapterUid": 4
 },
 {
  "level": 3,
  "text": "阿卓是一名艾滋病患儿，长年的病痛导致了她的发育不良",
  "uiIdx": "1.1",
  "range": "1563-1588",
  "chapterUid": 4
 },
 {
  "level": 4,
  "text": "艾滋是她从母亲那里得来的。",
  "uiIdx": "",
  "range": "1588-1624",
  "chapterUid": 4
 },
 {
  "level": 4,
  "text": "第一次发病后，她的身体开始浮肿，原本小麦色的皮肤变得黑里泛红，嘴唇也乌白皴裂。",
  "uiIdx": "",
  "range": "1642-1681",
  "chapterUid": 4
 },
 {
  "level": 4,
  "text": "不久，她又开始暴瘦，脸上血色全无，身体像一口被抽干水的枯井。",
  "uiIdx": "",
  "range": "1681-1711",
  "chapterUid": 4
 },
 {
  "level": 3,
  "text": "阿卓的家人对她的病情抱有希望，但科学诊断让他们接受现实",
  "uiIdx": "1.2",
  "range": "1711-1735",
  "chapterUid": 4
 },
 {
  "level": 4,
  "text": "村医隐晦地告诉爷爷奶奶：“这个病你们也知道的。”。",
  "uiIdx": "",
  "range": "1711-1735",
  "chapterUid": 4
 },
 {
  "level": 4,
  "text": "爷爷奶奶还是一次次地找来毕摩，他们坚信在那个病之外，一定还有其他的原因。",
  "uiIdx": "",
  "range": "1735-1772",
  "chapterUid": 4
 },
 {
  "level": 4,
  "text": "负责艾防工作的同事曾跟我回忆与阿卓的初见：“她长得美极了，鼻梁很高很直，眼睛又长又宽，典型的彝族美人。”。",
  "uiIdx": "",
  "range": "1825-1900",
  "chapterUid": 4
 },
 {
  "level": 2,
  "text": "阿卓与外界的隔阂",
  "uiIdx": "2",
  "range": "2360-2387",
  "chapterUid": 4
 },
 {
  "level": 3,
  "text": "阿卓对艾滋病患者有深深的恐惧，这让她与外界隔绝",
  "uiIdx": "2.1",
  "range": "2360-2387",
  "chapterUid": 4
 },
 {
  "level": 4,
  "text": "人们对艾滋病总是避之唯恐不及，而患者家对此也心中有数。",
  "uiIdx": "",
  "range": "2360-2387",
  "chapterUid": 4
 },
 {
  "level": 4,
  "text": "我与阿卓之间仅隔了一个火塘，却似乎离得很远很远。",
  "uiIdx": "",
  "range": "2387-2411",
  "chapterUid": 4
 },
 {
  "level": 3,
  "text": "阿卓的家人尽力保护她，不让她受到外界的伤害",
  "uiIdx": "2.2",
  "range": "2275-2340",
  "chapterUid": 4
 },
 {
  "level": 4,
  "text": "奶奶生起了火，火越燃越旺，火光照在沙发上，我总算看见阿卓的身形轮廓，但仍旧不够清晰。",
  "uiIdx": "",
  "range": "2275-2340",
  "chapterUid": 4
 },
 {
  "level": 4,
  "text": "半小时过去了，大家虽有说笑，却始终拘礼。人们对艾滋病总是避之唯恐不及，而患者家对此也心中有数。我与阿卓之间仅隔了一个火塘，却似乎离得很远很远。",
  "uiIdx": "",
  "range": "2340-2411",
  "chapterUid": 4
 },
 {
  "level": 4,
  "text": "于是我试探着问能否坐到她身边去。奶奶听后愣了几秒，随即展露笑颜近乎殷切地说：“可以可以，当然可以。”。",
  "uiIdx": "",
  "range": "2429-2479",
  "chapterUid": 4
 },
 {
  "level": 2,
  "text": "阿卓的内心世界",
  "uiIdx": "3",
  "range": "2687-2723",
  "chapterUid": 4
 },
 {
  "level": 3,
  "text": "阿卓对自己的病情感到羞怯，但内心充满了对生活的渴望",
  "uiIdx": "3.1",
  "range": "2687-2723",
  "chapterUid": 4
 },
 {
  "level": 4,
  "text": "阿卓有些羞怯，但难掩欣喜。几个月来，除了爷爷奶奶和乡邻，她没有见过其他人。",
  "uiIdx": "",
  "range": "2687-2747",
  "chapterUid": 4
 },
 {
  "level": 4,
  "text": "同学们惦念，总问她什么时候回来，她只能回以一个大哭的表情，以轻盈的玩笑藏下那些说不尽也说不清的痛楚。",
  "uiIdx": "",
  "range": "2747-2797",
  "chapterUid": 4
 },
 {
  "level": 3,
  "text": "阿卓对母亲的去世感到痛苦，但同时也对父亲的选择表示理解",
  "uiIdx": "3.2",
  "range": "3592-3628",
  "chapterUid": 4
 },
 {
  "level": 4,
  "text": "阿卓忆起早逝的两个弟弟、一个妹妹。关于这些年幼的生命，阿卓记忆模糊。小弟小妹都在出生不久后夭折，与她相伴较久的大弟也因艾滋病发只活到了五岁。",
  "uiIdx": "",
  "range": "3558-3628",
  "chapterUid": 4
 },
 {
  "level": 4,
  "text": "父亲帅气、温柔，做什么都是慢条斯理的。父亲总爱抱着她，给她讲故事，把她放在背上“骑马”，这是弟弟妹妹们都不曾有的待遇。",
  "uiIdx": "",
  "range": "3704-3763",
  "chapterUid": 4
 },
 {
  "level": 4,
  "text": "父亲走后，阿卓开始思考一个问题：他们的死是不是都因为我？再长大一些，她便暗暗笃定自己就是那悲惨命运的本身，是它的源头。",
  "uiIdx": "",
  "range": "3763-3822",
  "chapterUid": 4
 },
 {
  "level": 2,
  "text": "阿卓的生活状态",
  "uiIdx": "4",
  "range": "5171-5225",
  "chapterUid": 4
 },
 {
  "level": 3,
  "text": "阿卓在剧组的工作让她感到快乐，但也让她对现实世界产生了隔阂",
  "uiIdx": "4.1",
  "range": "5171-5225",
  "chapterUid": 4
 },
 {
  "level": 4,
  "text": "一位剧组朋友无意中看见了阿卓的照片，遂请我引荐。一段时间的相处后，阿卓与剧组间逐渐相互信任。正当万事俱备只待开机时，朋友却打来电话，称一向配合的阿卓突然性情大变，让人不敢接近也不便追问，只得匆忙告辞。",
  "uiIdx": "",
  "range": "5099-5225",
  "chapterUid": 4
 },
 {
  "level": 3,
  "text": "阿卓的爷爷去世后，她的病情加重，最终昏迷不醒",
  "uiIdx": "4.2",
  "range": "6694-6734",
  "chapterUid": 4
 },
 {
  "level": 4,
  "text": "爷爷去世以来，阿卓每日都扶着灵床大哭，边哭边喊：“爷爷，你别走，别走。我没有爸爸，也没有妈妈，爷爷你也要离开我吗？我做错什么，连你也不要我了吗？”。",
  "uiIdx": "",
  "range": "6694-6772",
  "chapterUid": 4
 },
 {
  "level": 4,
  "text": "阿卓微微翻着白眼，意识模糊地来回摆头，额头上虚汗密布。我凑到她身旁轻抚着她的头小声呼唤，她虚弱地睁开了眼：“阿呷姐姐，回去吧，我说不了话了。”。",
  "uiIdx": "",
  "range": "6167-6237",
  "chapterUid": 4
 },
 {
  "level": 1,
  "text": "远去的母亲",
  "uiIdx": "",
  "range": "",
  "chapterUid": 4
 },
 {
  "level": 2,
  "text": "母亲的文化追求",
  "uiIdx": "1",
  "range": "1682-1714",
  "chapterUid": 4
 },
 {
  "level": 3,
  "text": "母亲虽未读过书，但胆大聪颖，勇于挑战并具有冒险精神",
  "uiIdx": "1.1",
  "range": "1682-1714",
  "chapterUid": 4
 },
 {
  "level": 4,
  "text": "母亲不甘心，总是偷偷溜到学堂外旁听。",
  "uiIdx": "",
  "range": "1585-1626",
  "chapterUid": 4
 },
 {
  "level": 4,
  "text": "老师不忍一棵好苗子就此埋没，又多次来家里劝说。",
  "uiIdx": "",
  "range": "1585-1626",
  "chapterUid": 4
 },
 {
  "level": 3,
  "text": "母亲学会了缝纫和台球",
  "uiIdx": "1.2",
  "range": "1846-1876",
  "chapterUid": 4
 },
 {
  "level": 4,
  "text": "母亲存钱买回了一台缝纫机，无师自通地学会了缝纫。",
  "uiIdx": "",
  "range": "1846-1876",
  "chapterUid": 4
 },
 {
  "level": 4,
  "text": "母亲是一个台球高手，在乡上少有败绩。",
  "uiIdx": "",
  "range": "2045-2110",
  "chapterUid": 4
 },
 {
  "level": 2,
  "text": "母亲的商业帝国梦",
  "uiIdx": "2",
  "range": "2478-2545",
  "chapterUid": 4
 },
 {
  "level": 3,
  "text": "母亲在乡政府附近开办了小卖部，又打造了全乡第一家歌舞厅",
  "uiIdx": "2.1",
  "range": "2478-2545",
  "chapterUid": 4
 },
 {
  "level": 4,
  "text": "母亲借着台球店的收入，在乡政府附近开办了小卖部。",
  "uiIdx": "",
  "range": "2478-2545",
  "chapterUid": 4
 },
 {
  "level": 4,
  "text": "再过了一两年，又打造了全乡第一家歌舞厅。",
  "uiIdx": "",
  "range": "2478-2545",
  "chapterUid": 4
 },
 {
  "level": 3,
  "text": "母亲一步步走近了她的“商业帝国”梦，她的生命肆意盛放",
  "uiIdx": "2.2",
  "range": "2545-2590",
  "chapterUid": 4
 },
 {
  "level": 4,
  "text": "歌舞大厅的灯光下，人们在斑斓五彩的舞池中喝酒跳舞，母亲则唱歌助兴，成了舞厅的常驻歌手。",
  "uiIdx": "",
  "range": "2590-2633",
  "chapterUid": 4
 },
 {
  "level": 4,
  "text": "她光是听就学会了不少时下流行的歌曲。",
  "uiIdx": "",
  "range": "2633-2651",
  "chapterUid": 4
 },
 {
  "level": 2,
  "text": "母亲的家庭生活",
  "uiIdx": "3",
  "range": "3113-3178",
  "chapterUid": 4
 },
 {
  "level": 3,
  "text": "母亲是一个家庭摄影师，留下了三百余张旧日光影",
  "uiIdx": "3.1",
  "range": "3113-3178",
  "chapterUid": 4
 },
 {
  "level": 4,
  "text": "母亲得到相机后爱不释手，从此化身家庭摄影师。",
  "uiIdx": "",
  "range": "3113-3178",
  "chapterUid": 4
 },
 {
  "level": 4,
  "text": "在那些她尚康健的日子里，同我们一道留下了三百余张旧日光影。",
  "uiIdx": "",
  "range": "3113-3178",
  "chapterUid": 4
 },
 {
  "level": 3,
  "text": "母亲爱拍照的习惯一直保留到她去世前",
  "uiIdx": "3.2",
  "range": "3296-3337",
  "chapterUid": 4
 },
 {
  "level": 4,
  "text": "即便那时她已美丽不再，却依旧以为，摄影是为了记录与唤起。",
  "uiIdx": "",
  "range": "3337-3365",
  "chapterUid": 4
 },
 {
  "level": 4,
  "text": "她生前爱从照片中回忆我们的幼年，她去世后，回忆的人变成了我们。",
  "uiIdx": "",
  "range": "3365-3396",
  "chapterUid": 4
 },
 {
  "level": 2,
  "text": "母亲的疾病与抗争",
  "uiIdx": "4",
  "range": "3442-3480",
  "chapterUid": 4
 },
 {
  "level": 3,
  "text": "1999年，母亲患上了白血病，但她没有放弃",
  "uiIdx": "4.1",
  "range": "3442-3480",
  "chapterUid": 4
 },
 {
  "level": 4,
  "text": "“商业帝国”停摆了，永开不败的幻梦破灭了。",
  "uiIdx": "",
  "range": "3480-3501",
  "chapterUid": 4
 },
 {
  "level": 4,
  "text": "母亲没能成为自己梦想的商业强人，却在此后成为一位敢于直面人生淋漓鲜血的勇士。",
  "uiIdx": "",
  "range": "3501-3539",
  "chapterUid": 4
 },
 {
  "level": 3,
  "text": "父亲在母亲生病期间，为她奔走出一些生的希望",
  "uiIdx": "4.2",
  "range": "3555-3580",
  "chapterUid": 4
 },
 {
  "level": 4,
  "text": "父亲从未对母亲有过埋怨。他所有的忧愁与愤恨都向外发泄，再不济就向我们发泄。",
  "uiIdx": "",
  "range": "3555-3580",
  "chapterUid": 4
 },
 {
  "level": 4,
  "text": "他明白，疼痛都在母亲的身上。他唯一能做的，是为母亲奔走出一些生的希望，让母亲看到他为此付出的努力，渴盼她能因不忍这样的努力白白东流而同他一并努力，活下来。",
  "uiIdx": "",
  "range": "3580-3657",
  "chapterUid": 4
 },
 {
  "level": 2,
  "text": "母亲去世后的生活",
  "uiIdx": "5",
  "range": "8236-8288",
  "chapterUid": 4
 },
 {
  "level": 3,
  "text": "母亲去世后，父亲与外婆、姨妈们每每见面便相看泪眼，无语凝噎",
  "uiIdx": "5.1",
  "range": "8236-8288",
  "chapterUid": 4
 },
 {
  "level": 4,
  "text": "我们那时小，只知道他们怀念母亲，尚不明白怀念一个人就是翻忆她一生的欢忧，让她在你一言我一语中重新活一次，又重新死一次，再得到一次，又再失去一次，终是往复的伤逝。",
  "uiIdx": "",
  "range": "8288-8368",
  "chapterUid": 4
 },
 {
  "level": 4,
  "text": "到最后，我们一直往前，母亲一直往后，与生命中所有逝去的部分一样，我们离得越来越远，在各自的世界，不再一步三回头。",
  "uiIdx": "",
  "range": "8368-8424",
  "chapterUid": 4
 },
 {
  "level": 3,
  "text": "母亲走后，我梦见她在故宫的红墙绿瓦前，张开手，像要拥我入怀",
  "uiIdx": "5.2",
  "range": "8107-8130",
  "chapterUid": 4
 },
 {
  "level": 4,
  "text": "我伸手去触，她又到了另一处。",
  "uiIdx": "",
  "range": "8130-8144",
  "chapterUid": 4
 },
 {
  "level": 4,
  "text": "我不再似从前那样无措，而是随着她的转移，一次次去触。",
  "uiIdx": "",
  "range": "8144-8170",
  "chapterUid": 4
 },
 {
  "level": 4,
  "text": "梦里，她像海市蜃楼，像蝴蝶，像梦中梦。",
  "uiIdx": "",
  "range": "8170-8189",
  "chapterUid": 4
 },
 {
  "level": 4,
  "text": "我没有再哭喊着挽留她，求她活下来、留下来。",
  "uiIdx": "",
  "range": "8189-8210",
  "chapterUid": 4
 },
 {
  "level": 4,
  "text": "我们彼此望着，仍旧未发一言，母亲笑了，我明白她的笑。",
  "uiIdx": "",
  "range": "8210-8236",
  "chapterUid": 4
 },
 {
  "level": 1,
  "text": "大花流水",
  "uiIdx": "",
  "range": "",
  "chapterUid": 4
 },
 {
  "level": 2,
  "text": "大花的得名和探秘",
  "uiIdx": "1",
  "range": "1547-1680",
  "chapterUid": 4
 },
 {
  "level": 3,
  "text": "大花得名于艳阳午后父母亲带我们坐车经过的一段路",
  "uiIdx": "1.1",
  "range": "1547-1680",
  "chapterUid": 4
 },
 {
  "level": 4,
  "text": "车驶进大花路，沿路的石垛垒起高高的半墙，半墙背后伸出许多硕大的花朵。",
  "uiIdx": "",
  "range": "1547-1680",
  "chapterUid": 4
 },
 {
  "level": 4,
  "text": "旅途颠簸，花朵们就在颠簸中摇曳，仿佛诱引着我走进。",
  "uiIdx": "",
  "range": "1680-1781",
  "chapterUid": 4
 },
 {
  "level": 3,
  "text": "作者对大花的探秘充满了朦胧的孤清",
  "uiIdx": "1.2",
  "range": "1781-1843",
  "chapterUid": 4
 },
 {
  "level": 4,
  "text": "我怀着隐忧拨开那高高密密的一簇又一簇的花丛，走得愈来愈深，也愈来愈远。",
  "uiIdx": "",
  "range": "1781-1843",
  "chapterUid": 4
 },
 {
  "level": 4,
  "text": "探秘的最终也不记得是如何回返的，总之到了今日，唯独记得也是至今仍牵绕我的，竟是在那年的骄阳下，莫名生出的一种朦胧的孤清。",
  "uiIdx": "",
  "range": "2076-2212",
  "chapterUid": 4
 },
 {
  "level": 2,
  "text": "回到大花",
  "uiIdx": "2",
  "range": "2659-2663",
  "chapterUid": 4
 },
 {
  "level": 3,
  "text": "外婆家原住在高山之巅，后搬下山住在大花路边",
  "uiIdx": "2.1",
  "range": "2771-2801",
  "chapterUid": 4
 },
 {
  "level": 4,
  "text": "因为分隔两县，即使下了山，我们去大花仍要几番周折。",
  "uiIdx": "",
  "range": "2801-2849",
  "chapterUid": 4
 },
 {
  "level": 3,
  "text": "每次回外婆家，父母亲都带着我们挤进候车的茫茫人潮",
  "uiIdx": "2.2",
  "range": "2870-2919",
  "chapterUid": 4
 },
 {
  "level": 4,
  "text": "每到年节，父母亲就带着我们挤进候车的茫茫人潮，在数不清的行李间穿梭，在人群的前端翘首盼着远方鸣笛。",
  "uiIdx": "",
  "range": "2870-2919",
  "chapterUid": 4
 },
 {
  "level": 2,
  "text": "我的玩伴",
  "uiIdx": "3",
  "range": "4802-4806",
  "chapterUid": 4
 },
 {
  "level": 3,
  "text": "赤达是外婆家小卖部的男孩，性格腼腆，但宽厚、温柔，还有善良",
  "uiIdx": "3.1",
  "range": "5000-5056",
  "chapterUid": 4
 },
 {
  "level": 4,
  "text": "他穿得干净，还很文雅，一件藏青色毛线马甲，里面是一件红色格纹衬衫。",
  "uiIdx": "",
  "range": "4967-5000",
  "chapterUid": 4
 },
 {
  "level": 4,
  "text": "他性格腼腆，但递东西时总会笑一笑，在我尚不太通事理之际，他似乎早就有了一种深深的内在品质—宽厚、温柔，还有善良。",
  "uiIdx": "",
  "range": "5000-5056",
  "chapterUid": 4
 },
 {
  "level": 3,
  "text": "我和赤达的见面起初只限于那个铁窗，因为他要守店不能离开",
  "uiIdx": "3.2",
  "range": "5056-5107",
  "chapterUid": 4
 },
 {
  "level": 4,
  "text": "直到一个身影的出现，她瘦瘦高高，穿着一件浅绿色的格纹衬衫，一条米白色的紧身灯芯绒裤，同样的干净文雅。",
  "uiIdx": "",
  "range": "5107-5157",
  "chapterUid": 4
 },
 {
  "level": 4,
  "text": "她还未转头，我就已经陷在她的美丽里，那扇小小的铁窗，唤起了我内心关于成熟女人的无限遐思。",
  "uiIdx": "",
  "range": "5197-5241",
  "chapterUid": 4
 },
 {
  "level": 2,
  "text": "罂粟花",
  "uiIdx": "4",
  "range": "5625-5628",
  "chapterUid": 4
 },
 {
  "level": 3,
  "text": "大花路边的那些石垛背后，那面半墙背后，很久以前是一望无垠的罂粟花地",
  "uiIdx": "4.1",
  "range": "6477-6519",
  "chapterUid": 4
 },
 {
  "level": 4,
  "text": "民国年间，外婆也曾被大人们带着在那里栽过罂粟。",
  "uiIdx": "",
  "range": "6519-6542",
  "chapterUid": 4
 },
 {
  "level": 4,
  "text": "我这才惊晓，艳丽与危险原来早有渊源。",
  "uiIdx": "",
  "range": "6459-6477",
  "chapterUid": 4
 },
 {
  "level": 2,
  "text": "阿依阿芝",
  "uiIdx": "5",
  "range": "6587-6591",
  "chapterUid": 4
 },
 {
  "level": 3,
  "text": "外婆年轻时是远近闻名的美人，外公自从在人群中见过外婆一面，便认定她做自己的妻子",
  "uiIdx": "5.1",
  "range": "7035-7061",
  "chapterUid": 4
 },
 {
  "level": 4,
  "text": "他虽俊朗，身材却有些矮小，站在一米七五的外婆身旁怎么看都不相配，众人劝他打消这个念头，他却誓要娶到心仪的女子。",
  "uiIdx": "",
  "range": "7061-7116",
  "chapterUid": 4
 },
 {
  "level": 4,
  "text": "外婆那年十七，她在极不情愿中被迫出嫁。",
  "uiIdx": "",
  "range": "7154-7196",
  "chapterUid": 4
 },
 {
  "level": 3,
  "text": "外婆是个宽和的人，她的脸上永远挂着宽厚的笑，无论是对谁，亲近抑或陌生的，她都拢称为“我的孩子”",
  "uiIdx": "5.2",
  "range": "8160-8231",
  "chapterUid": 4
 },
 {
  "level": 4,
  "text": "“我的孩子阿呷妞妞(宝贝)，还记不记得小时候外婆带你上山割猪草呀？”这是外婆每年必问我的问题，她一年一年地追问，我一年一年地回答，旧日光景似乎从未与我们隔断。",
  "uiIdx": "",
  "range": "8231-8310",
  "chapterUid": 4
 },
 {
  "level": 4,
  "text": "某一年，我又准备好回答时，外婆却没有再问起。她老了，开始遗忘一些事情。而自她不再问后，那些事情便也在不觉间离我远去了。",
  "uiIdx": "",
  "range": "8310-8369",
  "chapterUid": 4
 },
 {
  "level": 1,
  "text": "“阿诗玛”少年",
  "uiIdx": "",
  "range": "",
  "chapterUid": 4
 },
 {
  "level": 2,
  "text": "“阿诗玛”少年足球队的成立",
  "uiIdx": "1",
  "range": "1869-1920",
  "chapterUid": 4
 },
 {
  "level": 3,
  "text": "教练何伟回到故乡，游说学校和家长们，希望将孩子带到球队",
  "uiIdx": "1.1",
  "range": "1869-1920",
  "chapterUid": 4
 },
 {
  "level": 4,
  "text": "何伟的父亲决定出手相助，联系农村里的家支亲戚，找到符合条件的孩子。",
  "uiIdx": "",
  "range": "1949-2035",
  "chapterUid": 4
 },
 {
  "level": 3,
  "text": "孩子们从公路旁的村庄，寻至罕有人烟的山顶，终于有了雏形",
  "uiIdx": "1.2",
  "range": "2141-2188",
  "chapterUid": 4
 },
 {
  "level": 4,
  "text": "父亲和母亲在孩子们依依盼望的眼神中坚定地转身。",
  "uiIdx": "",
  "range": "2264-2315",
  "chapterUid": 4
 },
 {
  "level": 2,
  "text": "“阿诗玛”少年足球队的训练生活",
  "uiIdx": "2",
  "range": "3089-3126",
  "chapterUid": 4
 },
 {
  "level": 3,
  "text": "训练艰苦，但孩子们从未有抱怨",
  "uiIdx": "2.1",
  "range": "3089-3126",
  "chapterUid": 4
 },
 {
  "level": 4,
  "text": "他们的童年伴随着泥土与劳作，三四岁便帮着家里喂猪，再大一些就放牛羊。",
  "uiIdx": "",
  "range": "3126-3181",
  "chapterUid": 4
 },
 {
  "level": 3,
  "text": "训练中，孩子们不懂汉语，不懂足球，更别提其中规则",
  "uiIdx": "2.2",
  "range": "2968-2989",
  "chapterUid": 4
 },
 {
  "level": 4,
  "text": "训练了一个多月后，何伟决定将队伍拉出去练一练，见见世面。",
  "uiIdx": "",
  "range": "2989-3017",
  "chapterUid": 4
 },
 {
  "level": 4,
  "text": "孩子们到了场上一通乱窜，裁判给了曲坡一张黄牌，曲坡却以为自己得了奖励，既惊又喜地接过黄牌朝何伟奔来。",
  "uiIdx": "",
  "range": "3017-3071",
  "chapterUid": 4
 },
 {
  "level": 2,
  "text": "“阿诗玛”少年足球队的比赛经历",
  "uiIdx": "3",
  "range": "4069-4127",
  "chapterUid": 4
 },
 {
  "level": 3,
  "text": "“阿诗玛”第一次出征省级赛事，首战就与省内数一数二的队伍迎上",
  "uiIdx": "3.1",
  "range": "4069-4127",
  "chapterUid": 4
 },
 {
  "level": 4,
  "text": "何伟做好了当炮灰的准备，却不想孩子们竟出乎意料地拿下当场胜利，一路走到了冠军之战。",
  "uiIdx": "",
  "range": "4127-4168",
  "chapterUid": 4
 },
 {
  "level": 3,
  "text": "比赛终究以一球之差告负，孩子们在场上张望良久，任汗水在紧蹙的眉间淌下，就是不肯下场",
  "uiIdx": "3.2",
  "range": "5010-5075",
  "chapterUid": 4
 },
 {
  "level": 4,
  "text": "何伟走进场中拍了拍每一个人的肩膀，连声安慰：“没事没事，已经非常好了。”。",
  "uiIdx": "",
  "range": "5075-5111",
  "chapterUid": 4
 },
 {
  "level": 2,
  "text": "“阿诗玛”少年足球队的成长与变化",
  "uiIdx": "4",
  "range": "5180-5235",
  "chapterUid": 4
 },
 {
  "level": 3,
  "text": "一年后，“阿诗玛”第一次出征就赢回了荣誉，何伟决定奖励他们乐山大佛一日游",
  "uiIdx": "4.1",
  "range": "5180-5235",
  "chapterUid": 4
 },
 {
  "level": 4,
  "text": "那时正是假期，人山人海。为了避免走散，队伍每到一处就点一次名，点到下山时却出了状况，少了一人。",
  "uiIdx": "",
  "range": "5235-5282",
  "chapterUid": 4
 },
 {
  "level": 4,
  "text": "半个小时过去，还是一无所获。管理员请他们出去时，何伟一把抓起面前的话筒用彝语大喊：“体哈体哈，我是何教我是何教，你去入口处等着，去入口处等着！”。",
  "uiIdx": "",
  "range": "5341-5413",
  "chapterUid": 4
 },
 {
  "level": 4,
  "text": "几分钟后，入口处真的出现了体哈的身影。他坐了坐准备起身离开，何伟一看立马又拿起话筒大喊：“别动，就在那儿坐着！”。",
  "uiIdx": "",
  "range": "5451-5530",
  "chapterUid": 4
 },
 {
  "level": 4,
  "text": "等何伟呼哧呼哧地赶到时，小小的身影还在四面张望，像在寻觅什么，直到发现教练，才猛地起立，害怕又欣喜地朝他奔去。",
  "uiIdx": "",
  "range": "5543-5598",
  "chapterUid": 4
 },
 {
  "level": 4,
  "text": "还没喘过气的何伟本想发作一通，话到嘴边又变成了：“你小子让我好找呀！”。",
  "uiIdx": "",
  "range": "5598-5633",
  "chapterUid": 4
 },
 {
  "level": 3,
  "text": "孩子们一边踢球，一边补习文化，汉语是他们最头疼的事",
  "uiIdx": "4.2",
  "range": "3727-3765",
  "chapterUid": 4
 },
 {
  "level": 4,
  "text": "面对老师们的提问，大家总是默契地低头不应。他们最怕与老师对视，一旦对视就会被叫起来回答。",
  "uiIdx": "",
  "range": "3765-3820",
  "chapterUid": 4
 },
 {
  "level": 4,
  "text": "而被点到的孩子只能吞吞吐吐，用浓重的彝腔挤出令汉族同学们哄堂大笑的汉语词汇。",
  "uiIdx": "",
  "range": "3820-3858",
  "chapterUid": 4
 },
 {
  "level": 4,
  "text": "这个时候，没被点到的孩子也掩面跟着笑，不自觉地跟着红了脸。",
  "uiIdx": "",
  "range": "3858-3887",
  "chapterUid": 4
 },
 {
  "level": 4,
  "text": "一个不懂汉语的球员如何在球场上表达？何伟也开始着急，于是规定今后在场上只能用汉语交流，不能用彝语。",
  "uiIdx": "",
  "range": "3887-3959",
  "chapterUid": 4
 },
 {
  "level": 4,
  "text": "何伟严厉，他的话孩子们不敢不听。但要去适应一门新的语言谈何容易，几句之后大家又都恢复了彝语交流。",
  "uiIdx": "",
  "range": "3959-4007",
  "chapterUid": 4
 },
 {
  "level": 4,
  "text": "何伟气得在场边直跺脚：“谁谁谁，刚刚那个用汉语怎么说？被叫住的球员往往一脸无辜，抓耳挠腮。",
  "uiIdx": "",
  "range": "4007-4051",
  "chapterUid": 4
 },
 {
  "level": 4,
  "text": "何伟也只能头痛得挥手：“去吧去吧。”。",
  "uiIdx": "",
  "range": "4051-4069",
  "chapterUid": 4
 },
 {
  "level": 3,
  "text": "“阿诗玛”球队原型为凉山鹫诺足球队，“阿诗玛”为教练何伟建队之初临时取的名",
  "uiIdx": "4.3",
  "range": "9492-9739",
  "chapterUid": 4
 },
 {
  "level": 4,
  "text": "该队伍成立于2015年，是由四川省体校及凉山州体校共同培养的第一批2005、2006年龄段队伍。",
  "uiIdx": "",
  "range": "9739-9863",
  "chapterUid": 4
 },
 {
  "level": 4,
  "text": "球队自成立至今，总共培养了22名国家一级运动员，2名现役职业足球运动员，10多名中超预备队、省队及各职业俱乐部梯队运动员。",
  "uiIdx": "",
  "range": "9863-9924",
  "chapterUid": 4
 },
 {
  "level": 1,
  "text": "洋芋姐姐",
  "uiIdx": "",
  "range": "",
  "chapterUid": 4
 },
 {
  "level": 2,
  "text": "阿甘的洋芋店和她的生活经历",
  "uiIdx": "1",
  "range": "1596-1628",
  "chapterUid": 4
 },
 {
  "level": 3,
  "text": "阿甘是锅边洋芋店的老板，生意火爆",
  "uiIdx": "1.1",
  "range": "1596-1628",
  "chapterUid": 4
 },
 {
  "level": 4,
  "text": "阿甘一人，要切配、上菜、端盘、清扫，眼睛还得随时盯着每桌的火力。",
  "uiIdx": "",
  "range": "1596-1628",
  "chapterUid": 4
 },
 {
  "level": 3,
  "text": "阿甘出生在冕宁县一个叫“依呷拉达”的寨子，寨子周边盛产水稻",
  "uiIdx": "1.2",
  "range": "1854-2145",
  "chapterUid": 4
 },
 {
  "level": 4,
  "text": "阿甘四岁那年，奶奶操作脱粒机时一时不慎，被当场锯掉了一截手指。",
  "uiIdx": "",
  "range": "2229-2291",
  "chapterUid": 4
 },
 {
  "level": 4,
  "text": "阿甘十三岁那年，父亲买来一辆东风牌大车停在家门口，准备与叔叔一道做货物运输生意。",
  "uiIdx": "",
  "range": "2643-2706",
  "chapterUid": 4
 },
 {
  "level": 4,
  "text": "父亲自知理亏，只能埋头不语任他们拉扯。家里拥满了对方家族的人，姐姐紧紧搂着阿甘和弟弟，担心地望着被逼的父亲不知如何是好。",
  "uiIdx": "",
  "range": "2856-2916",
  "chapterUid": 4
 },
 {
  "level": 4,
  "text": "深夜，开门声吵醒了睡梦中的孩子，姐姐唤醒阿甘穿衣起身。母亲推开了里屋的门。她脚步缓重，语气粗沉地唤道：“阿妹，把灯打开啊。”。",
  "uiIdx": "",
  "range": "4596-4646",
  "chapterUid": 4
 },
 {
  "level": 4,
  "text": "然后凭着熟悉摸坐到了火塘边。灯光昏暗，母亲靠在柱旁深深地埋着头，拖着一口长气让阿甘生火。",
  "uiIdx": "",
  "range": "4681-4725",
  "chapterUid": 4
 },
 {
  "level": 4,
  "text": "过了一会儿，火堆燃起来了，母亲缓缓地抬头。在火光的映照下，阿甘看清了母亲血流满面的脸。",
  "uiIdx": "",
  "range": "4725-4768",
  "chapterUid": 4
 },
 {
  "level": 4,
  "text": "她惊得失声尖叫，扑到母亲身上大哭，姐姐也哭。母亲的血和泪一起流下，她虚弱地抚着阿甘的头：“别哭阿妹，快去找姑姑，妈妈的手‘断’了，姑姑会接手，快去。”。",
  "uiIdx": "",
  "range": "4768-4843",
  "chapterUid": 4
 },
 {
  "level": 4,
  "text": "姐姐牵着阿甘，在无边的黑暗里冒雨一路小跑，姑姑紧跟在身后，总算将母亲脱臼的手正了回来。",
  "uiIdx": "",
  "range": "4843-4909",
  "chapterUid": 4
 },
 {
  "level": 3,
  "text": "阿甘和姐姐去广东打工，经历了生活的艰辛",
  "uiIdx": "1.3",
  "range": "5313-5382",
  "chapterUid": 4
 },
 {
  "level": 4,
  "text": "临行前，母亲将她们送至公路边，两个瘦小的孩子一人背上一个大包，手里还一起提着一个大蛇皮口袋。",
  "uiIdx": "",
  "range": "5313-5382",
  "chapterUid": 4
 },
 {
  "level": 4,
  "text": "队伍到达昆明时，因为买不上票，他们被滞留在火车站。为了节省盘缠，领班大叔顿顿都给大家买馒头充饥。",
  "uiIdx": "",
  "range": "5508-5579",
  "chapterUid": 4
 },
 {
  "level": 4,
  "text": "十几天下来，其他人倒是无恙，阿甘姐妹俩的嘴边却都生满了脓包，脸也跟着肿了起来。",
  "uiIdx": "",
  "range": "5579-5618",
  "chapterUid": 4
 },
 {
  "level": 4,
  "text": "到了夜间，三十个男男女女混挤在一个破旧的房间，发烧的阿甘蜷成小小的一团，止不住地抽泣，她太想母亲、太想回去了。",
  "uiIdx": "",
  "range": "5618-5673",
  "chapterUid": 4
 },
 {
  "level": 4,
  "text": "困了快二十天时，领班大叔终于搞到了票。他一进门就激动地大喊：“有票了有票了！快快快快！”。",
  "uiIdx": "",
  "range": "5720-5788",
  "chapterUid": 4
 },
 {
  "level": 4,
  "text": "大家一听立马手忙脚乱地收拾起行李，阿甘也被姐姐使劲儿摇醒。姐妹俩拖着大包小包，跟在队伍的最后上了车。",
  "uiIdx": "",
  "range": "5788-5838",
  "chapterUid": 4
 },
 {
  "level": 4,
  "text": "票是站票，一群人挤坐在卫生间旁的过道里，在臭气熏天中醒来又睡去，看车窗一会儿黑一会儿亮，不知过了多久，才总算到了广东。",
  "uiIdx": "",
  "range": "5838-5897",
  "chapterUid": 4
 },
 {
  "level": 4,
  "text": "她们被安排进了一家塑胶加工厂，主要负责音响外壳的制作，每天早上七点出工，晚上七点收工，中途只给半小时的吃饭时间。",
  "uiIdx": "",
  "range": "5897-5976",
  "chapterUid": 4
 },
 {
  "level": 4,
  "text": "姐妹俩负责的第一道工序需要全程站立，那时还只有一米五的阿甘要想让面前高大的机器运转，得踩在一块近二十厘米的厚板上才能勉强够到开机键，然后便开始十二个小时的循环。",
  "uiIdx": "",
  "range": "5976-6056",
  "chapterUid": 4
 },
 {
  "level": 4,
  "text": "同来的伙伴们，十几天后便邀约着走了一大半；再过了一个月，就只剩下了阿甘和姐姐。",
  "uiIdx": "",
  "range": "6056-6118",
  "chapterUid": 4
 },
 {
  "level": 4,
  "text": "大家觉得这样的活儿又累又枯燥，关键是挣不了什么钱。在她们的听说中，广东遍布生计，有的是地方去。",
  "uiIdx": "",
  "range": "6118-6165",
  "chapterUid": 4
 },
 {
  "level": 4,
  "text": "阿甘见状也想跟着走，却被姐姐拦下：“凡事坚持就能挣到钱，我们比不得别人有时间找工作，家里还等着呢。”。",
  "uiIdx": "",
  "range": "6165-6215",
  "chapterUid": 4
 },
 {
  "level": 4,
  "text": "眼见哀求无果，阿甘赌气说自己要一个人出走，看姐姐弄丢了自己怎么和父母交代。姐姐听了，也只是笑笑，任由她去收拾行李。",
  "uiIdx": "",
  "range": "6215-6272",
  "chapterUid": 4
 },
 {
  "level": 4,
  "text": "晚上，阿甘将自己藏在被子里，姐姐轻轻掀开被子探进头去，宠溺地吓道：“嘿！”。",
  "uiIdx": "",
  "range": "6272-6309",
  "chapterUid": 4
 },
 {
  "level": 4,
  "text": "两姐妹躲在被窝里看着彼此咯咯地笑，第二天又一起开开心心上了工。",
  "uiIdx": "",
  "range": "6309-6340",
  "chapterUid": 4
 },
 {
  "level": 3,
  "text": "阿甘和姐姐在塑胶厂存下了钱，还清了债务，然后离开",
  "uiIdx": "1.4",
  "range": "6913-6956",
  "chapterUid": 4
 },
 {
  "level": 4,
  "text": "两年后，阿甘和姐姐坐在门口，从那台小而笨重的老式电视机中见证了2008年的北京奥运会。",
  "uiIdx": "",
  "range": "6913-6956",
  "chapterUid": 4
 },
 {
  "level": 4,
  "text": "也是在那一年，她们被转为正式工，工资从原先的一天一百元提到了两百元，一天只用工作八小时，加班也有了加班费。",
  "uiIdx": "",
  "range": "6956-7009",
  "chapterUid": 4
 },
 {
  "level": 4,
  "text": "日复一日地节存下，还不完的债终于还清了。",
  "uiIdx": "",
  "range": "7009-7029",
  "chapterUid": 4
 },
 {
  "level": 4,
  "text": "2011年，姐妹俩离开待了五年的塑胶厂，告别了人生第一份工作，从此开始新的闯荡与漂泊。",
  "uiIdx": "",
  "range": "7029-7072",
  "chapterUid": 4
 },
 {
  "level": 2,
  "text": "阿甘的火锅店经历和婚姻生活",
  "uiIdx": "2",
  "range": "7072-7134",
  "chapterUid": 4
 },
 {
  "level": 3,
  "text": "阿甘和姐姐在昆明的一家火锅店做起了服务员",
  "uiIdx": "2.1",
  "range": "7072-7134",
  "chapterUid": 4
 },
 {
  "level": 4,
  "text": "火锅店呈“回”字形布局，客坐四方，中间设一方台，台上立着一个音响，任谁酒兴来时都能高歌一曲。",
  "uiIdx": "",
  "range": "7134-7180",
  "chapterUid": 4
 },
 {
  "level": 4,
  "text": "那年春节，店长为了营造气氛，鼓励员工们上去唱歌助兴。大家你推我让间，阿甘大着胆子上台，一口气连唱了几首。",
  "uiIdx": "",
  "range": "7180-7232",
  "chapterUid": 4
 },
 {
  "level": 4,
  "text": "她嗓音高亢又不失深情，台下观众们都为她叫好，要她再多来几首。她害羞又开心地站在台上直跺脚，接着唱道：遥望夜空的明月，想起了久别的故乡，漂泊异乡的游子，牵念着妈妈，明月啊明月，请你等等，请你等等我，我想把思念捎给你，送给我的妈妈……",
  "uiIdx": "",
  "range": "7232-8038",
  "chapterUid": 4
 },
 {
  "level": 4,
  "text": "那日打烊后，店长给员工们都发了新年红包，给阿甘发了双份，好些员工还将自己的那份也让给了阿甘，夸她唱得好、唱得感人。",
  "uiIdx": "",
  "range": "8038-8125",
  "chapterUid": 4
 },
 {
  "level": 3,
  "text": "阿甘的姐姐出嫁，阿甘独自面对生活",
  "uiIdx": "2.2",
  "range": "8212-8248",
  "chapterUid": 4
 },
 {
  "level": 4,
  "text": "姐姐出嫁前一天，她将经年积蓄交到父母手中，今后她为妻为母，难再分身全尽孝道。",
  "uiIdx": "",
  "range": "8212-8248",
  "chapterUid": 4
 },
 {
  "level": 4,
  "text": "父亲背身走出了门，再回来时眼角泪迹未干。母亲低头握着姐姐的手搓了又搓，看着这个最像自己的女儿，她的眼泪簌簌地落，声音也跟着颤抖起来：“阿达阿嫫(爸爸妈妈)没本事，这些年真是苦了你了……”。",
  "uiIdx": "",
  "range": "8248-10240",
  "chapterUid": 4
 },
 {
  "level": 4,
  "text": "那晚，寨子里的男人女人们围聚一堂，在烟酒与火焰中，一对又一对的女人轮换着上场，她们披上披毡，站到屋子中间，来回踱步哭嫁对吟，她们吟：妈妈的宝贝啊宝贝，从前小的时候啊小的时候，吃饭饭量大的时候啊，穿衣长个子的时候啊，那真是无忧无虑的时候，如今你在妈妈身边，待到了姑娘十七岁呀，小宝贝呀，你开始有了心事呀，现在我们要送你去到婆家了，妈妈为你买了你想要的衣裙呀，妈妈给你买了一件深蓝色披毡呀，那真是无忧无虑的时候，如今你在妈妈身边，待到了姑娘十七岁呀，小宝贝呀，你开始有了心事呀，现在我们要送你去到婆家了，妈妈为你买了你想要的衣裙呀，妈妈给你买了一件深蓝色披毡呀，……",
  "uiIdx": "",
  "range": "8248-10240",
  "chapterUid": 4
 },
 {
  "level": 4,
  "text": "父母招呼着远来的亲朋，人们把酒言欢彻夜相伴。近黎明时分，本已沉静的人群再度喧嚷，女人们开始为姐姐梳妆穿戴。她们有的围系衣裙，有的盘扣首饰，一根红色头绳绕过姐姐的头发，将它高绾成一个圆髻。母亲取来新置办的深蓝色披毡，又拿来一副挂在胸前的银牌，最后递上一顶镶着交叉银带的圆帽。姐姐坐在草席上，尝一口饭，吃一口鸡蛋，再抿下一杯出嫁酒，眼泪无声地流。",
  "uiIdx": "",
  "range": "8268-10441",
  "chapterUid": 4
 },
 {
  "level": 4,
  "text": "随着一方印着彝族纹样的红色盖头落下，表弟屈膝躬身，姐姐侧坐上他的背，在天还未亮之际，趁着夜色与送亲之人一道出了家门。",
  "uiIdx": "",
  "range": "10441-10499",
  "chapterUid": 4
 },
 {
  "level": 4,
  "text": "三天后是回门日，再离家时，阿甘与父母一起目送姐姐姐夫的车远去—姐姐此行要去姐夫的工作地浙江长住，再见不知何年。",
  "uiIdx": "",
  "range": "10499-10577",
  "chapterUid": 4
 },
 {
  "level": 3,
  "text": "阿甘离婚，再次独立面对生活",
  "uiIdx": "2.3",
  "range": "12228-12269",
  "chapterUid": 4
 },
 {
  "level": 4,
  "text": "我与阿甘相识时，正赶上她的离婚风波。那时的凉山尚未如今天这般移风易俗，彝族社会的习惯法中，主动提出离婚的一方将付出不菲代价。",
  "uiIdx": "",
  "range": "12228-12313",
  "chapterUid": 4
 },
 {
  "level": 4,
  "text": "阿甘是主动的一方，但她宁肯被男方拖累年华，也不屈从于不公的赔付。",
  "uiIdx": "",
  "range": "12313-12345",
  "chapterUid": 4
 },
 {
  "level": 4,
  "text": "我听得皱眉，她却讲得神色飞舞，讲着讲着又发出了标志性的笑声：“哈、哈、哈、哈……”。",
  "uiIdx": "",
  "range": "12345-12438",
  "chapterUid": 4
 },
 {
  "level": 4,
  "text": "那笑声里透蕴着一种至简的智慧与勇气，它们自生活的高山中来，又回到新的高山中去，一次次翻越，又一次次获得。",
  "uiIdx": "",
  "range": "12345-12438",
  "chapterUid": 4
 },
 {
  "level": 4,
  "text": "毕业离校前一晚，阿甘提早关店为我饯行。我们来到一家烧烤店，店里灯火斑斓，不停地变色和旋转。",
  "uiIdx": "",
  "range": "12438-12506",
  "chapterUid": 4
 },
 {
  "level": 4,
  "text": "深蓝色的灯光映在她脸上时，她轻微低头，斜刘海挡住一只眼睛，抬头便从兜里掏出了一包烟，抽出一支偏过头熟练地点燃。",
  "uiIdx": "",
  "range": "12506-12561",
  "chapterUid": 4
 },
 {
  "level": 4,
  "text": "她指尖轻夹着烟，嘴里长呼一口，坐姿豪迈地为我添着酒，深沉的模样与往日大相径庭。",
  "uiIdx": "",
  "range": "12561-12600",
  "chapterUid": 4
 },
 {
  "level": 4,
  "text": "这是我第一次触碰到她那副无忧外表下藏满的隐衷，那被笑貌掩去的实则是她最深重的部分。",
  "uiIdx": "",
  "range": "12600-12641",
  "chapterUid": 4
 },
 {
  "level": 4,
  "text": "也是在那时，我才清楚地看见了她生命里的高山，看见了它们的走向与形貌，真正读懂了那些智慧与勇气的缘来。",
  "uiIdx": "",
  "range": "12641-12691",
  "chapterUid": 4
 },
 {
  "level": 4,
  "text": "不久，阿甘打来电话。她兴奋地告诉我，自己终于离婚成功，只归还了最初的彩礼，没有赔付。",
  "uiIdx": "",
  "range": "12724-12756",
  "chapterUid": 4
 },
 {
  "level": 4,
  "text": "说完，又传出一阵没心没肺的笑声，她像个孩子般得意地宣布着胜利。",
  "uiIdx": "",
  "range": "12756-12787",
  "chapterUid": 4
 },
 {
  "level": 3,
  "text": "阿甘再婚，有了女儿，继续独立生活",
  "uiIdx": "2.4",
  "range": "12822-12837",
  "chapterUid": 4
 },
 {
  "level": 4,
  "text": "一年后，我与阿甘再相见。她那时已经再婚，有了一个女儿。",
  "uiIdx": "",
  "range": "12787-12837",
  "chapterUid": 4
 },
 {
  "level": 4,
  "text": "她还是那样勤快，一个人背着孩子招呼客人、上菜撤盘、清洁卫生，直到夜深才打烊休息。",
  "uiIdx": "",
  "range": "12837-12877",
  "chapterUid": 4
 },
 {
  "level": 1,
  "text": "待到苦尽甘来时",
  "uiIdx": "",
  "range": "",
  "chapterUid": 4
 },
 {
  "level": 2,
  "text": "叔叔与婶母的相识与相爱",
  "uiIdx": "1",
  "range": "1692-1751",
  "chapterUid": 4
 },
 {
  "level": 3,
  "text": "叔叔早年是村里出了名的混子，婶母家原本住在昭觉县与越西县边界的一个山坳里",
  "uiIdx": "1.1",
  "range": "1692-1751",
  "chapterUid": 4
 },
 {
  "level": 4,
  "text": "叔叔心仪婶母时，婶母还有婚约未解。",
  "uiIdx": "",
  "range": "1812-1852",
  "chapterUid": 4
 },
 {
  "level": 4,
  "text": "叔叔知道后，向父亲和伯伯们开口借钱，凑够了八千元，为婶母断了这桩婚事。",
  "uiIdx": "",
  "range": "1897-1932",
  "chapterUid": 4
 },
 {
  "level": 3,
  "text": "叔叔与婶母的交往既私密又光明，二伯早就看出了两人的情意绵绵",
  "uiIdx": "1.2",
  "range": "2274-2298",
  "chapterUid": 4
 },
 {
  "level": 4,
  "text": "“你二伯嘛，就是想要两百元的媒人钱，他想着肥水不流外人田。”。",
  "uiIdx": "",
  "range": "2298-2328",
  "chapterUid": 4
 },
 {
  "level": 2,
  "text": "叔叔与婶母的婚后生活",
  "uiIdx": "2",
  "range": "2450-2504",
  "chapterUid": 4
 },
 {
  "level": 3,
  "text": "叔叔与婶母一结婚就有了儿子，堂弟踉跄着来敲我们的门，我和弟弟就装作听不见",
  "uiIdx": "2.1",
  "range": "2450-2504",
  "chapterUid": 4
 },
 {
  "level": 4,
  "text": "我们那时自视甚高，总觉得自己是县城孩子，与农村孩子存在着天生的隔阂。",
  "uiIdx": "",
  "range": "2504-2538",
  "chapterUid": 4
 },
 {
  "level": 3,
  "text": "叔叔一家去山东，并在那里定居了下来",
  "uiIdx": "2.2",
  "range": "2797-2856",
  "chapterUid": 4
 },
 {
  "level": 4,
  "text": "他们不记得走的年份，农村里的彝族人很少记公历年月，一般只记生肖。",
  "uiIdx": "",
  "range": "2856-2888",
  "chapterUid": 4
 },
 {
  "level": 4,
  "text": "小堂弟出生那年是狗年，他们是狗年走的，次年母亲便离世了。",
  "uiIdx": "",
  "range": "2888-2916",
  "chapterUid": 4
 },
 {
  "level": 2,
  "text": "叔叔的辛苦与坚韧",
  "uiIdx": "3",
  "range": "4509-4545",
  "chapterUid": 4
 },
 {
  "level": 3,
  "text": "叔叔没有一日想过放弃，孩子们的学费、家庭大大小小的开支、家族里婚丧嫁娶的份子钱……这一切让他不能向后看",
  "uiIdx": "3.1",
  "range": "4509-4545",
  "chapterUid": 4
 },
 {
  "level": 4,
  "text": "他只需要闷着头，干就是了。",
  "uiIdx": "",
  "range": "4556-4569",
  "chapterUid": 4
 },
 {
  "level": 3,
  "text": "叔叔热情贪玩的性子依旧，逢年过节喝了几杯后，便在众人面前唱起歌、跳起舞",
  "uiIdx": "3.2",
  "range": "5515-5575",
  "chapterUid": 4
 },
 {
  "level": 4,
  "text": "每当这时，婶母就坐在一边掩着面不好意思地笑，好像叔叔在丢她的人，但也跟着开心和取闹。",
  "uiIdx": "",
  "range": "5575-5617",
  "chapterUid": 4
 },
 {
  "level": 2,
  "text": "婶母的病情与去世",
  "uiIdx": "4",
  "range": "6991-7026",
  "chapterUid": 4
 },
 {
  "level": 3,
  "text": "婶母的病情加重，需要连夜来市里，医生看了看县里的一堆报告，也觉得都没有大问题，我心下稍安",
  "uiIdx": "4.1",
  "range": "6991-7026",
  "chapterUid": 4
 },
 {
  "level": 4,
  "text": "等到他问出一句“最近咯过血吗？”，叔叔和婶母都摇摇头。",
  "uiIdx": "",
  "range": "7312-7339",
  "chapterUid": 4
 },
 {
  "level": 4,
  "text": "“以前呢？”我下意识地跟着答“没有没有”。可婶母却突然冒出一句：“咯过，前几年咯过两三次。”。",
  "uiIdx": "",
  "range": "7345-7385",
  "chapterUid": 4
 },
 {
  "level": 3,
  "text": "婶母病倒当天，恰逢弟媳临盆，县医院对于顺产还是剖腹举棋不定，婶母知道了，硬要叔叔接通堂嫂们的视频",
  "uiIdx": "4.2",
  "range": "7548-7585",
  "chapterUid": 4
 },
 {
  "level": 4,
  "text": "视频里，婶母突然振作起精神，鲜见地朝着几个嫂子发了火：“你们在做什么，让一个年轻孩子遭那么多罪？她肯定很痛，赶快把她送来西昌！”。",
  "uiIdx": "",
  "range": "7620-7684",
  "chapterUid": 4
 },
 {
  "level": 4,
  "text": "说完便怒气冲冲地挂了，整个人提着的气也一下子泄掉了，垮在床上。",
  "uiIdx": "",
  "range": "7684-7715",
  "chapterUid": 4
 },
 {
  "level": 3,
  "text": "婶母在世上的最后时刻，像刚出生的婴儿一样被擦得干干净净，男人们把她抬回了家，随行的医生拔掉了氧气管",
  "uiIdx": "4.3",
  "range": "9344-9395",
  "chapterUid": 4
 },
 {
  "level": 4,
  "text": "一片哭声中，婶母永远永远地去了。",
  "uiIdx": "",
  "range": "9417-9433",
  "chapterUid": 4
 },
 {
  "level": 2,
  "text": "叔叔的坚强与变化",
  "uiIdx": "5",
  "range": "9433-9492",
  "chapterUid": 4
 },
 {
  "level": 3,
  "text": "叔叔始终没有停下来，他穿走在人群中，任女人们为婶母穿戴，男人们制作担架",
  "uiIdx": "5.1",
  "range": "9433-9492",
  "chapterUid": 4
 },
 {
  "level": 4,
  "text": "他甚至没有到婶母面前看上一眼，仿佛在刻意地躲避什么。",
  "uiIdx": "",
  "range": "9492-9518",
  "chapterUid": 4
 },
 {
  "level": 3,
  "text": "丧礼结束后，叔叔颇为通透地告诉父亲自己想在家好好歇几个月，歇好后再去打工",
  "uiIdx": "5.2",
  "range": "9735-9795",
  "chapterUid": 4
 },
 {
  "level": 4,
  "text": "过去二十年，他从未给自己放过这样长的假。",
  "uiIdx": "",
  "range": "9795-9815",
  "chapterUid": 4
 },
 {
  "level": 4,
  "text": "但叔叔只是口头上这样说，没过多久便又起程去了甘肃做风电工。",
  "uiIdx": "",
  "range": "9815-9844",
  "chapterUid": 4
 },
 {
  "level": 1,
  "text": "一曲月光",
  "uiIdx": "",
  "range": "",
  "chapterUid": 4
 },
 {
  "level": 2,
  "text": "尔曲的视力恢复",
  "uiIdx": "1",
  "range": "1507-1533",
  "chapterUid": 4
 },
 {
  "level": 3,
  "text": "54岁的尔曲，盲了半生的双眼重新获得隐约的视力",
  "uiIdx": "1.1",
  "range": "1507-1533",
  "chapterUid": 4
 },
 {
  "level": 4,
  "text": "他站在往日常来的山崖边，山风阵阵吹向我们。",
  "uiIdx": "",
  "range": "1533-1553",
  "chapterUid": 4
 },
 {
  "level": 4,
  "text": "他告诉我，这儿是他心里风景最好的地方，过去他需要人扶着才能来，现在可以独自来了，接着指向远处山脚说，自己已经能看到那里的村落。",
  "uiIdx": "",
  "range": "1553-1616",
  "chapterUid": 4
 },
 {
  "level": 2,
  "text": "尔曲的过去",
  "uiIdx": "2",
  "range": "2026-2076",
  "chapterUid": 4
 },
 {
  "level": 3,
  "text": "尔曲六个月大时生了一场大病，病好以后，眼睛就看不见了",
  "uiIdx": "2.1",
  "range": "2026-2076",
  "chapterUid": 4
 },
 {
  "level": 4,
  "text": "孩子们一起玩耍时，别人家的孩子都向前爬，尔曲却只会在原地打转。",
  "uiIdx": "",
  "range": "2076-2107",
  "chapterUid": 4
 },
 {
  "level": 4,
  "text": "邻居好意提醒尔曲的母亲，她的孩子眼睛可能有问题。母亲不以为意，只觉得邻居的话难听。",
  "uiIdx": "",
  "range": "2107-2148",
  "chapterUid": 4
 },
 {
  "level": 4,
  "text": "母亲离世时，尔曲二十二岁。他没有号啕大哭，也没有流泪。二十二年来，他看不见一切，唯独看见了命运。",
  "uiIdx": "",
  "range": "2167-2238",
  "chapterUid": 4
 },
 {
  "level": 3,
  "text": "母亲养育了六个孩子，她背上背着、手里牵着、怀里抱着，一直到四十七岁那年，命运召走了她",
  "uiIdx": "2.2",
  "range": "2238-2281",
  "chapterUid": 4
 },
 {
  "level": 4,
  "text": "妻子和女伴们围坐火塘，兄弟邻里操忙着招待宾客。",
  "uiIdx": "",
  "range": "3266-3289",
  "chapterUid": 4
 },
 {
  "level": 4,
  "text": "随着尔曲进屋，女伴们起了哄，听说他擅弹月琴，便闹着他给新娘子献一曲。",
  "uiIdx": "",
  "range": "3289-3323",
  "chapterUid": 4
 },
 {
  "level": 4,
  "text": "尔曲羞涩中带着坦然，他取来月琴，坐在离新娘较远的地方，弹了一首轻快的曲子。",
  "uiIdx": "",
  "range": "3323-3360",
  "chapterUid": 4
 },
 {
  "level": 4,
  "text": "妻子勤劳，总是天不亮就背着锄头去地里干活，直到临盆前才停歇。",
  "uiIdx": "",
  "range": "3423-3476",
  "chapterUid": 4
 },
 {
  "level": 4,
  "text": "他们结婚的当年，长子出生，幸福来得突然又转瞬即逝，没多久孩子便夭折了。",
  "uiIdx": "",
  "range": "3476-3511",
  "chapterUid": 4
 },
 {
  "level": 4,
  "text": "逝子之殇在第三年终于得到宽慰，他们又迎来了一个女儿，几年后，再有了两个儿子。",
  "uiIdx": "",
  "range": "3661-3722",
  "chapterUid": 4
 },
 {
  "level": 4,
  "text": "妻子嫁给尔曲时十九岁，离开尔曲时三十八岁。",
  "uiIdx": "",
  "range": "4098-4142",
  "chapterUid": 4
 },
 {
  "level": 2,
  "text": "尔曲的现在",
  "uiIdx": "3",
  "range": "4682-4727",
  "chapterUid": 4
 },
 {
  "level": 3,
  "text": "在弹了近四十年月琴后，县文化馆注意到了尔曲",
  "uiIdx": "3.1",
  "range": "4682-4727",
  "chapterUid": 4
 },
 {
  "level": 4,
  "text": "他们派人将他请来，和其他的民间艺人同台演出，他由此结识了阿哈。",
  "uiIdx": "",
  "range": "4727-4758",
  "chapterUid": 4
 },
 {
  "level": 4,
  "text": "演出反响热烈，尔曲和阿哈收到了大公司的聘请，阿哈选择去见更广阔的世界，尔曲却因担心自己拖累他人留在了村里。",
  "uiIdx": "",
  "range": "4758-4811",
  "chapterUid": 4
 },
 {
  "level": 3,
  "text": "村里来人通知，称国家出台了白内障扶贫政策，尔曲的眼睛可能可以免费手术",
  "uiIdx": "3.2",
  "range": "4811-4869",
  "chapterUid": 4
 },
 {
  "level": 4,
  "text": "经过检查，他患的是后天性白内障，手术虽不能让他完全复明，但能恢复百分之二十的视力。",
  "uiIdx": "",
  "range": "4869-4910",
  "chapterUid": 4
 },
 {
  "level": 4,
  "text": "“人家是老了眼睛会看不见，我是老了反而恢复了光明，这怎能让人不高兴呢？”他觉得自己是一个幸福的人。",
  "uiIdx": "",
  "range": "4910-4946",
  "chapterUid": 4
 },
 {
  "level": 3,
  "text": "能看见些东西后，朋友便向尔曲发出了邀请，让他和阿哈一起前往北京、上海等地巡演",
  "uiIdx": "3.3",
  "range": "5273-5345",
  "chapterUid": 4
 },
 {
  "level": 4,
  "text": "家人聚在一起，坐在火塘边聊起往昔，他们都觉得不可思议。",
  "uiIdx": "",
  "range": "5371-5398",
  "chapterUid": 4
 },
 {
  "level": 4,
  "text": "被尔曲照顾大的弟弟欣慰又惭愧地说：“这么多年，我们几个都没有能力带你去看看北京，现在有人能带你去，真是太好了。”。",
  "uiIdx": "",
  "range": "5398-5454",
  "chapterUid": 4
 },
 {
  "level": 4,
  "text": "演出从北至南，历时近一个月，途经北京、上海、广州、深圳，最后回到成都。",
  "uiIdx": "",
  "range": "5454-5512",
  "chapterUid": 4
 },
 {
  "level": 4,
  "text": "与他们同台的嘉宾来自各类音乐领域，尔曲的月琴平生第一次与现代流行器乐结合，他在其间听到了月琴全新的生命，也因此结识了许多像他一样热爱声音的人。",
  "uiIdx": "",
  "range": "5512-5583",
  "chapterUid": 4
 },
 {
  "level": 2,
  "text": "尔曲的感悟",
  "uiIdx": "4",
  "range": "4578-4654",
  "chapterUid": 4
 },
 {
  "level": 3,
  "text": "他对生死有了更加深刻的理解",
  "uiIdx": "4.1",
  "range": "4578-4654",
  "chapterUid": 4
 },
 {
  "level": 4,
  "text": "不论是妻子还是曾经夭折的孩子、英年早逝的母亲，抑或所有人，死亡都会不期而至，它不会因你在尘世的责任未尽而收回成命，也不会因你尚未睁眼看过世界而停下呼召。",
  "uiIdx": "",
  "range": "4578-4654",
  "chapterUid": 4
 },
 {
  "level": 4,
  "text": "日复一日并非生命的全貌，无常是它的部分，也是自然的部分。",
  "uiIdx": "",
  "range": "4654-4682",
  "chapterUid": 4
 },
 {
  "level": 3,
  "text": "他对生活有了更加乐观的态度",
  "uiIdx": "4.2",
  "range": "6331-6397",
  "chapterUid": 4
 },
 {
  "level": 4,
  "text": "他想起了自己的小村庄，一切因循自然，时光在溪流中逝去，人的周围只有动物、植物和泥土，它们足以填满全部的生活，它们令人感到充实与富足。",
  "uiIdx": "",
  "range": "6331-6397",
  "chapterUid": 4
 },
 {
  "level": 4,
  "text": "他觉得大城市虽有着无尽繁华，却也处处拥挤，到处是车流人声。",
  "uiIdx": "",
  "range": "6266-6331",
  "chapterUid": 4
 },
 {
  "level": 4,
  "text": "他想起了自己的父亲，父亲未病时也是如此，但凡我放假回来，他都提前一两个小时守在车站。",
  "uiIdx": "",
  "range": "6627-6663",
  "chapterUid": 4
 },
 {
  "level": 4,
  "text": "父亲知道车不会早到，但他就是想早早地等待，对他来说等待意味着幸福将至，或者他已在幸福之中。",
  "uiIdx": "",
  "range": "6663-6708",
  "chapterUid": 4
 },
 {
  "level": 1,
  "text": "我的父亲",
  "uiIdx": "",
  "range": "",
  "chapterUid": 4
 },
 {
  "level": 2,
  "text": "父亲的生命状态和我们的担忧",
  "uiIdx": "1",
  "range": "1546-1576",
  "chapterUid": 4
 },
 {
  "level": 3,
  "text": "父亲术后萎靡，不爱说话，总是低着头",
  "uiIdx": "1.1",
  "range": "1546-1576",
  "chapterUid": 4
 },
 {
  "level": 4,
  "text": "父亲说：“太阳每天从东边升起，又落向西边，什么时候才是尽头？”。",
  "uiIdx": "",
  "range": "1546-1576",
  "chapterUid": 4
 },
 {
  "level": 3,
  "text": "我们无法回应父亲，事实上，谁又能回应父亲呢？",
  "uiIdx": "1.2",
  "range": "1606-1627",
  "chapterUid": 4
 },
 {
  "level": 2,
  "text": "父亲的过去和现在",
  "uiIdx": "2",
  "range": "1730-1760",
  "chapterUid": 4
 },
 {
  "level": 3,
  "text": "父亲曾每隔一周就要坐上火车去市里为母亲买药",
  "uiIdx": "2.1",
  "range": "1730-1760",
  "chapterUid": 4
 },
 {
  "level": 4,
  "text": "父亲在阳台上看见火车穿城而过，就可以判定父亲已经下车，坐上了三轮儿正在回家的路上。",
  "uiIdx": "",
  "range": "1760-1801",
  "chapterUid": 4
 },
 {
  "level": 3,
  "text": "父亲病倒后，我们开始像他一样奔走，同他一样担忧",
  "uiIdx": "2.2",
  "range": "2137-2197",
  "chapterUid": 4
 },
 {
  "level": 4,
  "text": "我们开始在夕阳里凝思，在漫漫长夜中看天从黑到亮，我才终于体会到了他的心情。",
  "uiIdx": "",
  "range": "2137-2197",
  "chapterUid": 4
 },
 {
  "level": 2,
  "text": "父亲对“小阿呷”的思念",
  "uiIdx": "3",
  "range": "2288-2312",
  "chapterUid": 4
 },
 {
  "level": 3,
  "text": "父亲非说自己有四个孩子，最小的也叫阿呷",
  "uiIdx": "3.1",
  "range": "2288-2312",
  "chapterUid": 4
 },
 {
  "level": 4,
  "text": "我们耐心地向父亲解释，自己就是阿呷，他只有三个孩子。",
  "uiIdx": "",
  "range": "2312-2337",
  "chapterUid": 4
 },
 {
  "level": 4,
  "text": "父亲不听，反而怒斥我狠心。",
  "uiIdx": "",
  "range": "2337-2350",
  "chapterUid": 4
 },
 {
  "level": 3,
  "text": "我们理解父亲，心疼父亲，决心要找回这个妹妹，按父亲的意愿让她上学",
  "uiIdx": "3.2",
  "range": "2508-2541",
  "chapterUid": 4
 },
 {
  "level": 4,
  "text": "寻找“小阿呷”成了我们的心结。",
  "uiIdx": "",
  "range": "2541-2579",
  "chapterUid": 4
 },
 {
  "level": 4,
  "text": "一天，父亲又说起我们四个孩子，但第四个孩子不再是“小阿呷”，而变成了“小阿木”，与我弟弟同名。",
  "uiIdx": "",
  "range": "2579-2628",
  "chapterUid": 4
 },
 {
  "level": 4,
  "text": "他告诉我们，自己梦见了奶奶—他的母亲。",
  "uiIdx": "",
  "range": "2812-2830",
  "chapterUid": 4
 },
 {
  "level": 2,
  "text": "父亲的自尊心和坚强",
  "uiIdx": "4",
  "range": "4110-4220",
  "chapterUid": 4
 },
 {
  "level": 3,
  "text": "父亲的自尊心极强，尤其在母亲去世后，他生怕别人在背后议论",
  "uiIdx": "4.1",
  "range": "4110-4220",
  "chapterUid": 4
 },
 {
  "level": 4,
  "text": "父亲闻言只是摇摇头，让她不要担心，自己已经习惯了一个人。",
  "uiIdx": "",
  "range": "5357-5385",
  "chapterUid": 4
 },
 {
  "level": 3,
  "text": "父亲是一个坚强的人，从不轻易掉泪",
  "uiIdx": "4.2",
  "range": "3160-3177",
  "chapterUid": 4
 },
 {
  "level": 4,
  "text": "他恨潦困的家庭不能给他任何支撑，更恨自己的努力被不公的命运践踏。",
  "uiIdx": "",
  "range": "3200-3250",
  "chapterUid": 4
 },
 {
  "level": 4,
  "text": "他的求告与哭诉无人知晓，也无须旁人知晓，他更加沉默地用功，沉默里装着他无声的喊叫。",
  "uiIdx": "",
  "range": "3250-3291",
  "chapterUid": 4
 },
 {
  "level": 2,
  "text": "父亲的爱和期待",
  "uiIdx": "5",
  "range": "3854-3875",
  "chapterUid": 4
 },
 {
  "level": 3,
  "text": "父亲一生都在追求荣誉，关于自己，关于责任",
  "uiIdx": "5.1",
  "range": "3854-3875",
  "chapterUid": 4
 },
 {
  "level": 4,
  "text": "他背着母亲从乡里到县里，又从县里到市里、省里，像电影《阿甘正传》里的阿甘一样，在炮火连天的命运中一次次将母亲背回，不知停歇，不愿放弃。",
  "uiIdx": "",
  "range": "3875-3942",
  "chapterUid": 4
 },
 {
  "level": 3,
  "text": "父亲期待我们能够成为大树，让他去做我们树荫下的小草",
  "uiIdx": "5.2",
  "range": "9111-9180",
  "chapterUid": 4
 },
 {
  "level": 4,
  "text": "我们陪伴在父亲身边，像他曾经一样学着长成一棵大树，让他去做我们树荫下的小草。",
  "uiIdx": "",
  "range": "9111-9180",
  "chapterUid": 4
 }
]