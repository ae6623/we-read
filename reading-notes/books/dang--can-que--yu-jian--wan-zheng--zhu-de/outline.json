[
 {
  "level": 1,
  "text": "文前",
  "uiIdx": "",
  "range": "",
  "chapterUid": 12
 },
 {
  "level": 2,
  "text": "朱德庸的新书《一个人的人生未爆弹》宣传",
  "uiIdx": "1",
  "range": "432-491",
  "chapterUid": 12
 },
 {
  "level": 3,
  "text": "朱德庸给大众的印象总是锋利的，他的作品记录下对人性和时代的观察。",
  "uiIdx": "1.1",
  "range": "492-686",
  "chapterUid": 12
 },
 {
  "level": 3,
  "text": "这一次，我们看到的不是朱德庸的锋利，而是他的脆弱、柔软，甚至绝望时刻。",
  "uiIdx": "1.2",
  "range": "754-892",
  "chapterUid": 12
 },
 {
  "level": 2,
  "text": "朱德庸和冯曼伦的夫妻关系",
  "uiIdx": "2",
  "range": "908-1062",
  "chapterUid": 12
 },
 {
  "level": 3,
  "text": "朱德庸曾说过，他一直是“半个人”，他的人生有很多的残缺和黑洞，只有和妻子冯曼伦在一起，他才是完整的自己。",
  "uiIdx": "2.1",
  "range": "908-1062",
  "chapterUid": 12
 },
 {
  "level": 3,
  "text": "冯曼伦曾是台湾《联合报》的副刊主编，被誉为媒体界才女，和朱德庸在一起之后，她选择放弃事业，在家带孩子，而后成为他的图书编辑和经纪人。",
  "uiIdx": "2.2",
  "range": "1282-1450",
  "chapterUid": 12
 },
 {
  "level": 2,
  "text": "朱德庸和冯曼伦的生活态度",
  "uiIdx": "3",
  "range": "1451-1640",
  "chapterUid": 12
 },
 {
  "level": 3,
  "text": "朱德庸都拒绝成为大人，保有他的童真，这也意味着，成为妻子和母亲后，很多时刻，冯曼伦像是一个护卫，站在朱德庸和现实世界之间，帮助朱德庸抵挡很多来自成人世界的规则和恶意。",
  "uiIdx": "3.1",
  "range": "1451-1640",
  "chapterUid": 12
 },
 {
  "level": 3,
  "text": "他们曾经说过，他们都是半个小孩，只有合在一起，才是“一个人”。",
  "uiIdx": "3.2",
  "range": "2511-2644",
  "chapterUid": 12
 },
 {
  "level": 2,
  "text": "朱德庸和冯曼伦的人生故事",
  "uiIdx": "4",
  "range": "1854-1911",
  "chapterUid": 12
 },
 {
  "level": 3,
  "text": "他们无比坦诚、真挚，带着一种古早气息的得体，他们完全地敞开自己。",
  "uiIdx": "4.1",
  "range": "1854-1911",
  "chapterUid": 12
 },
 {
  "level": 3,
  "text": "他们曾经在人生中生了一场病，各自面临了漫长的黑暗和痛苦，这不是一个谁付出更多或者谁牺牲更多的叙事，我们看到了两个受伤的人，带着情感的残缺，找到了彼此，相互抚平对方的伤痕。",
  "uiIdx": "4.2",
  "range": "2424-2510",
  "chapterUid": 12
 },
 {
  "level": 1,
  "text": "朱德庸",
  "uiIdx": "",
  "range": "",
  "chapterUid": 12
 },
 {
  "level": 2,
  "text": "朱德庸的父亲去世后的家庭变化",
  "uiIdx": "1",
  "range": "623-758",
  "chapterUid": 12
 },
 {
  "level": 3,
  "text": "朱德庸的父亲去世前，家庭氛围和谐",
  "uiIdx": "1.1",
  "range": "623-758",
  "chapterUid": 12
 },
 {
  "level": 4,
  "text": "朱德庸的父亲去世前两个多月，朱德庸去陪他，两人话很少，但父亲偶尔对他笑一下。",
  "uiIdx": "",
  "range": "623-841",
  "chapterUid": 12
 },
 {
  "level": 3,
  "text": "朱德庸的父亲去世后，家庭关系破裂",
  "uiIdx": "1.2",
  "range": "1620-1800",
  "chapterUid": 12
 },
 {
  "level": 4,
  "text": "朱德庸的父亲去世后，母子之间、兄弟之间的关系变得非常紧张。",
  "uiIdx": "",
  "range": "1620-1800",
  "chapterUid": 12
 },
 {
  "level": 4,
  "text": "朱德庸发现自己对童年、对原生家庭的想法原来都是错的，父亲就像一块镇压石，把很多人性微小的邪恶镇压住，所以你看不见。当他过世了，这一块镇压石就没有了，妖魔鬼怪就出来了。",
  "uiIdx": "",
  "range": "1537-1619",
  "chapterUid": 12
 },
 {
  "level": 2,
  "text": "朱德庸对家庭变故的反思",
  "uiIdx": "2",
  "range": "2028-2053",
  "chapterUid": 12
 },
 {
  "level": 3,
  "text": "朱德庸认为家庭变故是普遍现象",
  "uiIdx": "2.1",
  "range": "2028-2053",
  "chapterUid": 12
 },
 {
  "level": 4,
  "text": "朱德庸认为这个事情是非常普遍的，虽然你们有血缘关系，但并不表示可以弥补一切的鸿沟。",
  "uiIdx": "",
  "range": "2028-2053",
  "chapterUid": 12
 },
 {
  "level": 3,
  "text": "朱德庸对父亲的一生表示知足",
  "uiIdx": "2.2",
  "range": "2978-3149",
  "chapterUid": 12
 },
 {
  "level": 4,
  "text": "朱德庸认为他父亲这一生却过得很知足，从来没有听过他有什么怨言，永远都是开开心心，他就是慢慢过他的小小日子，家里什么东西坏了，他就慢慢修。",
  "uiIdx": "",
  "range": "2978-3149",
  "chapterUid": 12
 },
 {
  "level": 2,
  "text": "朱德庸对母亲的态度和处理方式",
  "uiIdx": "3",
  "range": "3473-3614",
  "chapterUid": 12
 },
 {
  "level": 3,
  "text": "朱德庸对母亲的态度分为两个阶段",
  "uiIdx": "3.1",
  "range": "3473-3614",
  "chapterUid": 12
 },
 {
  "level": 4,
  "text": "小时候的妈妈，跟父亲过世后的妈妈，朱德庸觉得是两个妈妈。",
  "uiIdx": "",
  "range": "3473-3614",
  "chapterUid": 12
 },
 {
  "level": 3,
  "text": "朱德庸尝试理解母亲的真实想法",
  "uiIdx": "3.2",
  "range": "4466-4508",
  "chapterUid": 12
 },
 {
  "level": 4,
  "text": "朱德庸认为他们那一代，不管战争也好，时代的大变动也好，很多人是在没有爱情的情况下结合在一起的。当他们还年轻的时候，他们还有能力去对抗内心微小的邪恶，当他们体力衰退，可能就没有力量去对抗了。",
  "uiIdx": "",
  "range": "4466-4555",
  "chapterUid": 12
 },
 {
  "level": 4,
  "text": "朱德庸认为为了让这一颗炸弹不要爆炸，他只能想办法拆除引线。他太太同时跟他承受这一切，他跟她一直不停地交谈，把很多很多迷惑，或者曾经存在而我们忽略的、漠视的问题，理出一些线头来。慢慢理，慢慢理，才发现这并不是偶发事件，其实它一直都是存在的。",
  "uiIdx": "",
  "range": "4583-4803",
  "chapterUid": 12
 },
 {
  "level": 1,
  "text": "冯曼伦",
  "uiIdx": "",
  "range": "",
  "chapterUid": 12
 },
 {
  "level": 2,
  "text": "冯曼伦的家庭背景和成长经历",
  "uiIdx": "1",
  "range": "615-669",
  "chapterUid": 12
 },
 {
  "level": 3,
  "text": "父亲是一个温和、自足、真诚的人，在白色恐怖时期救人于危难",
  "uiIdx": "1.1",
  "range": "615-669",
  "chapterUid": 12
 },
 {
  "level": 4,
  "text": "父亲与世无争，事业上没有什么作为，却非常自足于他的生活。",
  "uiIdx": "",
  "range": "615-669",
  "chapterUid": 12
 },
 {
  "level": 4,
  "text": "父亲在白色恐怖时期，甚至把人从监狱里救出来，但没有要求任何人感谢他。",
  "uiIdx": "",
  "range": "669-702",
  "chapterUid": 12
 },
 {
  "level": 3,
  "text": "冯曼伦在情感上觉察错误，对父亲的欺骗感到痛苦",
  "uiIdx": "1.2",
  "range": "848-868",
  "chapterUid": 12
 },
 {
  "level": 4,
  "text": "冯曼伦会觉得自己50年都生活在假象里面吗？我是旁观者，其实很清醒地看到这一切。",
  "uiIdx": "",
  "range": "848-868",
  "chapterUid": 12
 },
 {
  "level": 4,
  "text": "冯曼伦不能跟父亲说，他还是眼睁睁看着他受到了最后的一个重击，那对我来说也是一个重击。",
  "uiIdx": "",
  "range": "868-926",
  "chapterUid": 12
 },
 {
  "level": 2,
  "text": "冯曼伦与德庸的婚姻关系和处理方式",
  "uiIdx": "2",
  "range": "1330-1527",
  "chapterUid": 12
 },
 {
  "level": 3,
  "text": "冯曼伦对德庸有深厚的感情，但希望他能做一个独立的人",
  "uiIdx": "2.1",
  "range": "1330-1527",
  "chapterUid": 12
 },
 {
  "level": 4,
  "text": "冯曼伦回到德庸家也要受到非常大的压力，但她逼迫自己回去。",
  "uiIdx": "",
  "range": "1330-1527",
  "chapterUid": 12
 },
 {
  "level": 4,
  "text": "冯曼伦认为他们只享受把她当仆役在用的方式，这不是一个家人应该相处的方式。",
  "uiIdx": "",
  "range": "1668-1728",
  "chapterUid": 12
 },
 {
  "level": 3,
  "text": "冯曼伦和德庸都是独立的人，感情上有很大的黑洞，需要用很大的爱，很大的关注，很大的互相了解来填满",
  "uiIdx": "2.2",
  "range": "2464-2672",
  "chapterUid": 12
 },
 {
  "level": 4,
  "text": "冯曼伦和德庸都是互相支持度过的，他托住她，她每天陪着他，不管她讲多少重复的话，用各种方式跟他说，他都努力帮助她理解，为什么有这么多不合理的事情发生。",
  "uiIdx": "",
  "range": "2405-2463",
  "chapterUid": 12
 },
 {
  "level": 4,
  "text": "冯曼伦说，他像一个盲人在骑脚踏车，她是一个聋子坐在他的后座上，他看不见，她听不到，但是可以告诉他怎么往前走，他也可以顺利地骑车。",
  "uiIdx": "",
  "range": "2673-2842",
  "chapterUid": 12
 },
 {
  "level": 1,
  "text": "朱德庸",
  "uiIdx": "",
  "range": "",
  "chapterUid": 12
 },
 {
  "level": 2,
  "text": "朱德庸的童年经历",
  "uiIdx": "1",
  "range": "1049-1113",
  "chapterUid": 12
 },
 {
  "level": 3,
  "text": "朱德庸从小就有识字困难，阅读障碍",
  "uiIdx": "1.1",
  "range": "1049-1113",
  "chapterUid": 12
 },
 {
  "level": 4,
  "text": "比如“实力”两个字，眼睛是不认识的，大脑跟你讲，这叫“实力”，但我的大脑去挑字，会挑一个卖，再挑一个刀，所以我看到的是“卖刀”。",
  "uiIdx": "",
  "range": "1049-1113",
  "chapterUid": 12
 },
 {
  "level": 3,
  "text": "朱德庸在歧视中长大，不善与人交流",
  "uiIdx": "1.2",
  "range": "861-890",
  "chapterUid": 12
 },
 {
  "level": 4,
  "text": "从出生到我念幼儿园、念小学、念初中，我都是在歧视中长大的。",
  "uiIdx": "",
  "range": "861-890",
  "chapterUid": 12
 },
 {
  "level": 4,
  "text": "我不会念书，怎样都读不好，一直到我很大很大，我都成名了，我才解谜了，原来我有识字困难，我有阅读障碍。",
  "uiIdx": "",
  "range": "891-1049",
  "chapterUid": 12
 },
 {
  "level": 2,
  "text": "朱德庸的自我接纳与成长",
  "uiIdx": "2",
  "range": "1532-1714",
  "chapterUid": 12
 },
 {
  "level": 3,
  "text": "朱德庸知道自己是亚斯伯格综合征后，释怀并原谅了自己",
  "uiIdx": "2.1",
  "range": "1532-1714",
  "chapterUid": 12
 },
 {
  "level": 4,
  "text": "当我知道我有亚斯伯格，我就释怀了，我真的松了一口气，在那一刹那我就原谅了我自己，原谅了我小时候所有的愚蠢，所有的不被接受，很强烈的自卑，全部我都原谅了。",
  "uiIdx": "",
  "range": "1532-1714",
  "chapterUid": 12
 },
 {
  "level": 3,
  "text": "朱德庸认为做大人一点都不好，拒绝成为大人",
  "uiIdx": "2.2",
  "range": "3248-3380",
  "chapterUid": 12
 },
 {
  "level": 4,
  "text": "我一直到现在都觉得我没有变成大人，我也不想变成大人。变大人只会让我倒霉，我拒绝成为大人，做大人一点儿都不好。",
  "uiIdx": "",
  "range": "3248-3408",
  "chapterUid": 12
 },
 {
  "level": 2,
  "text": "朱德庸的创作与童年",
  "uiIdx": "3",
  "range": "4038-4070",
  "chapterUid": 12
 },
 {
  "level": 3,
  "text": "朱德庸的成名作《双响炮》和《涩女郎》都是在他的老家诞生的",
  "uiIdx": "3.1",
  "range": "4038-4070",
  "chapterUid": 12
 },
 {
  "level": 4,
  "text": "我所有一切，我的想象，我所有的东西都在那个地方产生的，如果有一天我真的有能力，我希望重建老家，让我真正能够去触摸我的记忆。",
  "uiIdx": "",
  "range": "4092-4259",
  "chapterUid": 12
 },
 {
  "level": 3,
  "text": "朱德庸通过画《绝对小孩》系列，表达对童年的怀念和对真实自我的追求",
  "uiIdx": "3.2",
  "range": "2513-2656",
  "chapterUid": 12
 },
 {
  "level": 4,
  "text": "2008年，我会画《绝对小孩》这个系列，是因为我觉得童年对一个人太重要了。人无论如何都要回到你的童年。",
  "uiIdx": "",
  "range": "2513-2656",
  "chapterUid": 12
 },
 {
  "level": 1,
  "text": "冯曼伦",
  "uiIdx": "",
  "range": "",
  "chapterUid": 12
 },
 {
  "level": 2,
  "text": "冯曼伦的个性和习惯",
  "uiIdx": "1",
  "range": "488-688",
  "chapterUid": 12
 },
 {
  "level": 3,
  "text": "冯曼伦是一个极度天真跟热情的人，他的脑部确实跟正常的人不一样，他的行为跟一般正常人也不一样。",
  "uiIdx": "1.1",
  "range": "488-688",
  "chapterUid": 12
 },
 {
  "level": 3,
  "text": "他是一个非常有意思的人，你会被他搞得昏头转向，因为他的兴趣实在太活跃了，他是一种全面的吸收。",
  "uiIdx": "1.2",
  "range": "689-841",
  "chapterUid": 12
 },
 {
  "level": 3,
  "text": "他读世界，我们出去散步，他是读那个人群，如果可以，他一定是坐在过道，这样看人比较方便。",
  "uiIdx": "1.3",
  "range": "1228-1377",
  "chapterUid": 12
 },
 {
  "level": 2,
  "text": "冯曼伦的婚姻和家庭",
  "uiIdx": "2",
  "range": "1378-1568",
  "chapterUid": 12
 },
 {
  "level": 3,
  "text": "我和他们的婚姻有几十年，常常会察觉自己有时会情绪低落，后来我发现了，不是我低落，而是家里有个人在低落，但没有告诉我。",
  "uiIdx": "2.1",
  "range": "1378-1568",
  "chapterUid": 12
 },
 {
  "level": 3,
  "text": "我曾经因为他的沉默，非常生气，你有什么不舒服的、困难的，应该告诉我，而不是选择不说。",
  "uiIdx": "2.2",
  "range": "1730-1772",
  "chapterUid": 12
 },
 {
  "level": 2,
  "text": "冯曼伦的自闭症和亚斯伯格",
  "uiIdx": "3",
  "range": "1963-2123",
  "chapterUid": 12
 },
 {
  "level": 3,
  "text": "朱老师是在53岁发现自己患有亚斯伯格，对他冲击很大，他终于理解自己不善于表达，不善于社交，甚至有社恐这一面。",
  "uiIdx": "3.1",
  "range": "1963-2123",
  "chapterUid": 12
 },
 {
  "level": 3,
  "text": "亚斯伯格也是一种自闭症，朱老师的情形比较轻微，算是高功能的。",
  "uiIdx": "3.2",
  "range": "2124-2260",
  "chapterUid": 12
 },
 {
  "level": 3,
  "text": "看了一本书，讲自闭症的小孩，我很难受，他们看世界是俯视的，和我们的视角不一样而已。",
  "uiIdx": "3.3",
  "range": "2260-2302",
  "chapterUid": 12
 },
 {
  "level": 1,
  "text": "朱德庸",
  "uiIdx": "",
  "range": "",
  "chapterUid": 12
 },
 {
  "level": 2,
  "text": "朱德庸与妻子的相遇与相爱",
  "uiIdx": "1",
  "range": "5924-5931",
  "chapterUid": 12
 },
 {
  "level": 3,
  "text": "朱德庸与妻子因工作相识，开始了一段奇妙的相遇",
  "uiIdx": "1.1",
  "range": "467-638",
  "chapterUid": 12
 },
 {
  "level": 4,
  "text": "朱德庸的妻子原是报社主编，她打电话约朱德庸约稿吃饭，朱德庸答应后并未真正想去。",
  "uiIdx": "",
  "range": "467-638",
  "chapterUid": 12
 },
 {
  "level": 4,
  "text": "朱德庸的妻子因朱德庸不交稿，开始打电话催稿，朱德庸借机与她攀谈，慢慢开始了解彼此。",
  "uiIdx": "",
  "range": "976-1016",
  "chapterUid": 12
 },
 {
  "level": 3,
  "text": "朱德庸的妻子补足了他非常多，他是一个很残缺的人",
  "uiIdx": "1.2",
  "range": "1017-1150",
  "chapterUid": 12
 },
 {
  "level": 4,
  "text": "朱德庸的妻子钱挣得比他多，工作比他好，很多方面都强过他。",
  "uiIdx": "",
  "range": "1017-1150",
  "chapterUid": 12
 },
 {
  "level": 4,
  "text": "朱德庸的妻子个性很强，开玩笑说如果有一天他们不在一起了，朱德庸的钱她都不会拿的。",
  "uiIdx": "",
  "range": "2686-2721",
  "chapterUid": 12
 },
 {
  "level": 2,
  "text": "朱德庸与妻子的婚姻生活",
  "uiIdx": "2",
  "range": "2647-2686",
  "chapterUid": 12
 },
 {
  "level": 3,
  "text": "朱德庸的妻子选择以家庭为重，以孩子为重，后来，她选择跟朱德庸一起做",
  "uiIdx": "2.1",
  "range": "2647-2686",
  "chapterUid": 12
 },
 {
  "level": 4,
  "text": "朱德庸的妻子结婚后辞职了，在家等小孩出生，后来当然她会想要出去做事，但她发觉当时的环境根本没有办法托小孩出去，她就选择在家带小孩。",
  "uiIdx": "",
  "range": "1551-1721",
  "chapterUid": 12
 },
 {
  "level": 4,
  "text": "朱德庸的妻子帮朱德庸编书，帮他做，朱德庸是不善于交流的，也不善于应酬，跟外界是隔离的，但一个家庭，总有人要去触摸真实的世界，那就是她。",
  "uiIdx": "",
  "range": "1779-1933",
  "chapterUid": 12
 },
 {
  "level": 3,
  "text": "朱德庸的妻子是朱德庸所知道大概最坚强的一个人",
  "uiIdx": "2.2",
  "range": "4366-4405",
  "chapterUid": 12
 },
 {
  "level": 4,
  "text": "朱德庸的妻子带给他无比的安定，他自己一个人出去，他会很惶恐，他会不知道该怎么办，只要她在旁边，他就很安定。",
  "uiIdx": "",
  "range": "4366-4405",
  "chapterUid": 12
 },
 {
  "level": 4,
  "text": "朱德庸的妻子在公事上，有些东西做到最后他都觉得差不多了，够了，但她永远会追到最后一个细节，永远想办法做到她认为最好的。",
  "uiIdx": "",
  "range": "4983-5036",
  "chapterUid": 12
 },
 {
  "level": 2,
  "text": "朱德庸对婚姻的看法",
  "uiIdx": "3",
  "range": "3145-3220",
  "chapterUid": 12
 },
 {
  "level": 3,
  "text": "朱德庸认为现代的女性更应该要有她的选择权",
  "uiIdx": "3.1",
  "range": "3145-3220",
  "chapterUid": 12
 },
 {
  "level": 4,
  "text": "朱德庸认为选择权并不是单一的，而是她真正觉得她想要怎么样，选择事业或家庭，都没有对错，只要是她自己的选择，都是非常伟大的。",
  "uiIdx": "",
  "range": "3145-3220",
  "chapterUid": 12
 },
 {
  "level": 4,
  "text": "朱德庸认为如果一个女人认为，我就是希望找一个喜欢的人，在我的家去塑造一个我要的世界，只要是她认定的，就是伟大的女性。",
  "uiIdx": "",
  "range": "3417-3576",
  "chapterUid": 12
 },
 {
  "level": 3,
  "text": "朱德庸认为爱情最好的一个定义就是找到了自己的玩伴",
  "uiIdx": "3.2",
  "range": "5037-5165",
  "chapterUid": 12
 },
 {
  "level": 4,
  "text": "朱德庸认为我们是爱人，又是亲密的工作伙伴，更重要的是，她是我的玩伴，爱人太局限了，玩伴的范围很大，玩伴也包括了爱人。",
  "uiIdx": "",
  "range": "5165-5218",
  "chapterUid": 12
 },
 {
  "level": 4,
  "text": "朱德庸认为他旁边永远有一个人，不管任何事情你都能够结伴而行。",
  "uiIdx": "",
  "range": "5218-5246",
  "chapterUid": 12
 },
 {
  "level": 1,
  "text": "冯曼伦",
  "uiIdx": "",
  "range": "",
  "chapterUid": 12
 },
 {
  "level": 2,
  "text": "冯曼伦与朱德庸的婚姻生活",
  "uiIdx": "1",
  "range": "608-631",
  "chapterUid": 12
 },
 {
  "level": 3,
  "text": "冯曼伦与朱德庸因年龄差距和性格原因开始交往",
  "uiIdx": "1.1",
  "range": "608-631",
  "chapterUid": 12
 },
 {
  "level": 4,
  "text": "冯曼伦比朱德庸小6岁，她是一个女权主义者，不太喜欢吃亏。",
  "uiIdx": "",
  "range": "608-631",
  "chapterUid": 12
 },
 {
  "level": 4,
  "text": "朱德庸是一个认真的人，如果没有结果，他愿意放弃。",
  "uiIdx": "",
  "range": "830-875",
  "chapterUid": 12
 },
 {
  "level": 3,
  "text": "他们的孩子是突然来的，冯曼伦决定独自抚养",
  "uiIdx": "1.2",
  "range": "1413-1564",
  "chapterUid": 12
 },
 {
  "level": 4,
  "text": "冯曼伦说，孩子是我要的，我完全可以负责。",
  "uiIdx": "",
  "range": "1413-1564",
  "chapterUid": 12
 },
 {
  "level": 4,
  "text": "冯曼伦想把他养成一个既尊重自己又尊重别人的人。",
  "uiIdx": "",
  "range": "1564-1605",
  "chapterUid": 12
 },
 {
  "level": 3,
  "text": "冯曼伦与朱德庸的关系既像夫妻，又像灵魂伴侣",
  "uiIdx": "1.3",
  "range": "2628-2677",
  "chapterUid": 12
 },
 {
  "level": 4,
  "text": "他们两个人都非常的自我，要怎么定义他们的关系呢，夫妻、灵魂伴侣，都是，都不是很像。",
  "uiIdx": "",
  "range": "2628-2677",
  "chapterUid": 12
 },
 {
  "level": 4,
  "text": "他们是很重视精神交流的人，最难的部分是碰到，其次的部分才是经营。",
  "uiIdx": "",
  "range": "3670-3702",
  "chapterUid": 12
 },
 {
  "level": 2,
  "text": "冯曼伦对婚姻和爱情的看法",
  "uiIdx": "2",
  "range": "2361-2481",
  "chapterUid": 12
 },
 {
  "level": 3,
  "text": "冯曼伦不相信婚姻，也不相信爱情",
  "uiIdx": "2.1",
  "range": "2361-2481",
  "chapterUid": 12
 },
 {
  "level": 4,
  "text": "她认为婚姻只是一个双方约定，如果约定情况改变了，大家可以各自散开，各过各的，独立的生活那是最好的结果。",
  "uiIdx": "",
  "range": "4019-4074",
  "chapterUid": 12
 },
 {
  "level": 4,
  "text": "她认为真正爱情的产生，必须是你喜欢这个人，欣赏这个人，不会腻，有很多话可以聊，这个东西是可以产生爱情的。",
  "uiIdx": "",
  "range": "4603-4758",
  "chapterUid": 12
 },
 {
  "level": 3,
  "text": "冯曼伦认为很多人可以得到爱情，但很多人得不到幸福的婚姻",
  "uiIdx": "2.2",
  "range": "4758-4788",
  "chapterUid": 12
 },
 {
  "level": 4,
  "text": "她认为我确实承担了比一般人多很多，但好在很多事我都不太在意，我觉得最重要就是自己。",
  "uiIdx": "",
  "range": "4941-4979",
  "chapterUid": 12
 },
 {
  "level": 1,
  "text": "朱德庸",
  "uiIdx": "",
  "range": "",
  "chapterUid": 12
 },
 {
  "level": 2,
  "text": "朱德庸的成名与创作经历",
  "uiIdx": "1",
  "range": "633-670",
  "chapterUid": 12
 },
 {
  "level": 3,
  "text": "《双响炮》大卖，朱德庸被全世界追着找",
  "uiIdx": "1.1",
  "range": "633-670",
  "chapterUid": 12
 },
 {
  "level": 4,
  "text": "朱德庸的书非常卖，每本书一铺出去，立刻卖光。",
  "uiIdx": "",
  "range": "633-670",
  "chapterUid": 12
 },
 {
  "level": 4,
  "text": "全世界都在找朱德庸，电话一直在响，没有停过。",
  "uiIdx": "",
  "range": "802-955",
  "chapterUid": 12
 },
 {
  "level": 3,
  "text": "朱德庸选择停下来，不再追求速度和金钱",
  "uiIdx": "1.2",
  "range": "956-1081",
  "chapterUid": 12
 },
 {
  "level": 4,
  "text": "朱德庸的太太建议他停下来，但他停不下来。",
  "uiIdx": "",
  "range": "956-1081",
  "chapterUid": 12
 },
 {
  "level": 4,
  "text": "朱德庸选择停下来，是为了证明自己的价值，而不是为了挣钱。",
  "uiIdx": "",
  "range": "1081-1148",
  "chapterUid": 12
 },
 {
  "level": 2,
  "text": "朱德庸的人生选择与价值观",
  "uiIdx": "2",
  "range": "1586-1634",
  "chapterUid": 12
 },
 {
  "level": 3,
  "text": "朱德庸放弃了很多挣钱的机会，选择了保持创作的单纯性",
  "uiIdx": "2.1",
  "range": "1586-1634",
  "chapterUid": 12
 },
 {
  "level": 4,
  "text": "朱德庸以前有一个电视剧叫《粉红女郎》，播出之后多少人来跟他买其他作品授权，要拍电视剧，要拍电影。",
  "uiIdx": "",
  "range": "1586-1634",
  "chapterUid": 12
 },
 {
  "level": 4,
  "text": "朱德庸并没有选择那个样子，他没有选择并不是因为我外行，而是我在想，我要不要去跟那么多人周旋？我要不要保存我创作的单纯性？",
  "uiIdx": "",
  "range": "1705-1765",
  "chapterUid": 12
 },
 {
  "level": 3,
  "text": "朱德庸认为人生本来就是一种选择，无论选哪条路，都不知道另一个结果是什么",
  "uiIdx": "2.2",
  "range": "1766-1903",
  "chapterUid": 12
 },
 {
  "level": 4,
  "text": "朱德庸至少可以确定，如果当时选了那条路，他跟他太太相处的时间会很少，甚至跟孩子的相处时间也会少，他身体会垮掉。",
  "uiIdx": "",
  "range": "1903-1959",
  "chapterUid": 12
 },
 {
  "level": 4,
  "text": "朱德庸可能挣了一大堆钱，就开始肝硬化。",
  "uiIdx": "",
  "range": "1977-1993",
  "chapterUid": 12
 },
 {
  "level": 2,
  "text": "朱德庸的创作灵感与生活方式",
  "uiIdx": "3",
  "range": "2501-2579",
  "chapterUid": 12
 },
 {
  "level": 3,
  "text": "画画是朱德庸的本能，陪伴他度过不愉快的童年",
  "uiIdx": "3.1",
  "range": "2501-2579",
  "chapterUid": 12
 },
 {
  "level": 4,
  "text": "朱德庸在学校受到师长的歧视，甚至同学的欺负，他回到家拿一张纸、一支笔，就开始画。",
  "uiIdx": "",
  "range": "2501-2579",
  "chapterUid": 12
 },
 {
  "level": 4,
  "text": "朱德庸把欺负他的老师画在那个纸上，想象他有100种死法，画完之后他的气就全部消了。",
  "uiIdx": "",
  "range": "2501-2579",
  "chapterUid": 12
 },
 {
  "level": 3,
  "text": "朱德庸对很多事情的感知是很强烈的，他的天线是整个打开的",
  "uiIdx": "3.2",
  "range": "2807-2956",
  "chapterUid": 12
 },
 {
  "level": 4,
  "text": "朱德庸走在街上的时候，他的天线是整个打开的，他感受每一个不管是接触的或者只是擦身而过的人。",
  "uiIdx": "",
  "range": "2807-2956",
  "chapterUid": 12
 },
 {
  "level": 4,
  "text": "朱德庸的太太会生气的，每次跟他说不要想那么多，把你那个天线关掉，你不要一直去接收。",
  "uiIdx": "",
  "range": "2975-3016",
  "chapterUid": 12
 },
 {
  "level": 1,
  "text": "冯曼伦",
  "uiIdx": "",
  "range": "",
  "chapterUid": 12
 },
 {
  "level": 2,
  "text": "冯曼伦和德庸的婚后生活",
  "uiIdx": "1",
  "range": "613-637",
  "chapterUid": 12
 },
 {
  "level": 3,
  "text": "冯曼伦和德庸结婚后，德庸决定放弃报社工作",
  "uiIdx": "1.1",
  "range": "613-637",
  "chapterUid": 12
 },
 {
  "level": 4,
  "text": "德庸在报社当漫画编辑，工资很高，活儿又很少，但他不喜欢这份工作。",
  "uiIdx": "",
  "range": "613-637",
  "chapterUid": 12
 },
 {
  "level": 3,
  "text": "冯曼伦怀孕后，决定放弃事业，专心照顾家庭",
  "uiIdx": "1.2",
  "range": "1258-1327",
  "chapterUid": 12
 },
 {
  "level": 4,
  "text": "冯曼伦发现如果只能把孩子放在家里，自己不能花力气去教养，那他（孩子）的成长环境会不够健全。",
  "uiIdx": "",
  "range": "1258-1327",
  "chapterUid": 12
 },
 {
  "level": 2,
  "text": "冯曼伦对事业的看法",
  "uiIdx": "2",
  "range": "1523-1680",
  "chapterUid": 12
 },
 {
  "level": 3,
  "text": "冯曼伦认为，如果为了工作做出太大的牺牲，会影响孩子的成长",
  "uiIdx": "2.1",
  "range": "1523-1680",
  "chapterUid": 12
 },
 {
  "level": 4,
  "text": "冯曼伦担心，如果做到总编辑，甚至讲自大一点，做到社长，但她没有办法看着她的孩子长大，这是有遗憾的。",
  "uiIdx": "",
  "range": "1523-1680",
  "chapterUid": 12
 },
 {
  "level": 3,
  "text": "冯曼伦认为，没有创作人能够被别人塑造，尤其是朱德庸",
  "uiIdx": "2.2",
  "range": "3095-3240",
  "chapterUid": 12
 },
 {
  "level": 4,
  "text": "冯曼伦认为，他非常天才，他能够坚持每一天做到一笔一画，永远有新的想法，永远有新的感受。",
  "uiIdx": "",
  "range": "3567-3614",
  "chapterUid": 12
 },
 {
  "level": 2,
  "text": "冯曼伦对德庸的支持和理解",
  "uiIdx": "3",
  "range": "3240-3379",
  "chapterUid": 12
 },
 {
  "level": 3,
  "text": "冯曼伦理解德庸，认为他的工作是他的救赎，也是他的心理治疗",
  "uiIdx": "3.1",
  "range": "3240-3379",
  "chapterUid": 12
 },
 {
  "level": 4,
  "text": "冯曼伦认为，德庸比她还能够更爱这个世界，关心所有的人，只是他从来不承认这件事。",
  "uiIdx": "",
  "range": "3240-3379",
  "chapterUid": 12
 },
 {
  "level": 3,
  "text": "冯曼伦认为，她的人生做到这一步，已经很满足，为什么要觉得她在牺牲",
  "uiIdx": "3.2",
  "range": "2690-2723",
  "chapterUid": 12
 },
 {
  "level": 4,
  "text": "冯曼伦认为，她一点儿也不后悔，也不遗憾。她把德庸的出版，把他的作品做到了最好，这是她的事业。",
  "uiIdx": "",
  "range": "3660-3833",
  "chapterUid": 12
 },
 {
  "level": 1,
  "text": "朱德庸",
  "uiIdx": "",
  "range": "",
  "chapterUid": 12
 },
 {
  "level": 2,
  "text": "朱德庸对死亡的看法",
  "uiIdx": "1",
  "range": "467-611",
  "chapterUid": 12
 },
 {
  "level": 3,
  "text": "朱德庸的父亲在他很晚的时候才生了他，他与父亲差了43岁",
  "uiIdx": "1.1",
  "range": "467-611",
  "chapterUid": 12
 },
 {
  "level": 4,
  "text": "朱德庸每年除夕吃年夜饭前，都会想，明年我父亲还在不在？",
  "uiIdx": "",
  "range": "612-751",
  "chapterUid": 12
 },
 {
  "level": 3,
  "text": "朱德庸的父亲在他80岁时去世，享年94岁",
  "uiIdx": "1.2",
  "range": "992-1082",
  "chapterUid": 12
 },
 {
  "level": 4,
  "text": "朱德庸的父亲在他妈妈过生日那天，吃东西，噎住了。",
  "uiIdx": "",
  "range": "992-1082",
  "chapterUid": 12
 },
 {
  "level": 2,
  "text": "朱德庸对生命的看法",
  "uiIdx": "2",
  "range": "1374-1390",
  "chapterUid": 12
 },
 {
  "level": 3,
  "text": "朱德庸认为死亡代表一切的结束，真正的结束",
  "uiIdx": "2.1",
  "range": "1374-1390",
  "chapterUid": 12
 },
 {
  "level": 4,
  "text": "朱德庸认为死亡应该是他最尊重的一件事情。",
  "uiIdx": "",
  "range": "1253-1374",
  "chapterUid": 12
 },
 {
  "level": 3,
  "text": "朱德庸认为人其实很难给他感动，真正能够感动他的全都是动物给他的",
  "uiIdx": "2.2",
  "range": "2736-2761",
  "chapterUid": 12
 },
 {
  "level": 4,
  "text": "朱德庸看到纯粹的爱，后来他太太走了，他们把她火葬了之后放在骨灰罐，上面挂了她的项圈。",
  "uiIdx": "",
  "range": "2476-2508",
  "chapterUid": 12
 },
 {
  "level": 4,
  "text": "朱德庸现在讲这些，眼眶还是红的，那是纯粹的思念，纯粹的爱情。",
  "uiIdx": "",
  "range": "2602-2736",
  "chapterUid": 12
 },
 {
  "level": 2,
  "text": "朱德庸对生活的看法",
  "uiIdx": "3",
  "range": "4056-4102",
  "chapterUid": 12
 },
 {
  "level": 3,
  "text": "朱德庸认为他并不是平白无故来到这个世界的，他来这个世界就是来画画的",
  "uiIdx": "3.1",
  "range": "4056-4102",
  "chapterUid": 12
 },
 {
  "level": 4,
  "text": "朱德庸觉得每一个人都需要这种认定，千万不要觉得说，我对这世界没有什么用，每一个人都有用。",
  "uiIdx": "",
  "range": "4276-4318",
  "chapterUid": 12
 },
 {
  "level": 3,
  "text": "朱德庸认为他这一生完全没有任何遗憾",
  "uiIdx": "3.2",
  "range": "4706-4873",
  "chapterUid": 12
 },
 {
  "level": 4,
  "text": "朱德庸不常跟人家说这个想法，他很怕遭到天谴，老天爷想说，哇，所有的便宜都给你占了，那不行，老天爷可能也有那个微小的邪恶。",
  "uiIdx": "",
  "range": "4706-4873",
  "chapterUid": 12
 }
]