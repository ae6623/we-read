[
 {
  "level": 1,
  "text": "学前测验",
  "uiIdx": "",
  "range": "",
  "chapterUid": 20
 },
 {
  "level": 2,
  "text": "资产负债表中列示的项目",
  "uiIdx": "1",
  "range": "386-405",
  "chapterUid": 20
 },
 {
  "level": 3,
  "text": "现金、资产、负债在资产负债表中列示。",
  "uiIdx": "1.1",
  "range": "386-405",
  "chapterUid": 20
 },
 {
  "level": 2,
  "text": "会计核算制度与盈利能力的关系",
  "uiIdx": "2",
  "range": "572-596",
  "chapterUid": 20
 },
 {
  "level": 3,
  "text": "权责发生制最能准确地反映盈利能力。",
  "uiIdx": "2.1",
  "range": "572-596",
  "chapterUid": 20
 },
 {
  "level": 2,
  "text": "应收账款定义",
  "uiIdx": "3",
  "range": "745-753",
  "chapterUid": 20
 },
 {
  "level": 3,
  "text": "应收账款是一项资产。",
  "uiIdx": "3.1",
  "range": "745-753",
  "chapterUid": 20
 },
 {
  "level": 2,
  "text": "现金对企业日常经营的重要性。",
  "uiIdx": "4",
  "range": "898-916",
  "chapterUid": 20
 },
 {
  "level": 2,
  "text": "利润表的“底线值”定义。",
  "uiIdx": "5",
  "range": "1056-1078",
  "chapterUid": 20
 },
 {
  "level": 2,
  "text": "待摊费用定义",
  "uiIdx": "6",
  "range": "1218-1226",
  "chapterUid": 20
 },
 {
  "level": 3,
  "text": "待摊费用是一项资产。",
  "uiIdx": "6.1",
  "range": "1218-1226",
  "chapterUid": 20
 },
 {
  "level": 2,
  "text": "后进先出法或先进先出法关于存货的计量。",
  "uiIdx": "7",
  "range": "1371-1395",
  "chapterUid": 20
 },
 {
  "level": 2,
  "text": "利润表中的项目。",
  "uiIdx": "8",
  "range": "1538-1553",
  "chapterUid": 20
 },
 {
  "level": 2,
  "text": "现金流状况不受影响的费用支出",
  "uiIdx": "9",
  "range": "1693-1719",
  "chapterUid": 20
 },
 {
  "level": 3,
  "text": "折旧费是企业经营时，不影响现金流状况的费用支出。",
  "uiIdx": "9.1",
  "range": "1693-1719",
  "chapterUid": 20
 },
 {
  "level": 2,
  "text": "会计基本等式",
  "uiIdx": "10",
  "range": "1982-1995",
  "chapterUid": 20
 },
 {
  "level": 3,
  "text": "资产=负债+所有者权益是会计基本等式。",
  "uiIdx": "10.1",
  "range": "1982-1995",
  "chapterUid": 20
 },
 {
  "level": 1,
  "text": "第1章 现金、原始投资、资产、负债、应付票据、所有者权益、资产负债表、存货、盈利、费用",
  "uiIdx": "",
  "range": "",
  "chapterUid": 20
 },
 {
  "level": 2,
  "text": "现金、原始投资、资产、负债、应付票据、所有者权益、资产负债表、存货、盈利、费用的概念和关系",
  "uiIdx": "1",
  "range": "369-408",
  "chapterUid": 20
 },
 {
  "level": 3,
  "text": "现金是做生意的启动资金，原始投资是用于投资生意的钱",
  "uiIdx": "1.1",
  "range": "2466-2511",
  "chapterUid": 20
 },
 {
  "level": 4,
  "text": "你从自己的小猪存钱罐里倒出全部的零钱，有25美分、5美分、10美分的硬币，总共加起来居然有5美元。",
  "uiIdx": "",
  "range": "2466-2550",
  "chapterUid": 20
 },
 {
  "level": 4,
  "text": "你把这些钱放在了一个你认为它足够安全，能防弹、防X射线，又能防盗的——你叔叔正想扔掉的一个旧雪茄盒里。",
  "uiIdx": "",
  "range": "2575-2626",
  "chapterUid": 20
 },
 {
  "level": 4,
  "text": "你不想弄乱了这些硬币，于是，妈妈或爸爸好心肠地将它们换成了5张面值1美元的纸币。为安全起见，这些纸币被放在雪茄盒子“小银行”里保管。",
  "uiIdx": "",
  "range": "2651-2717",
  "chapterUid": 20
 },
 {
  "level": 3,
  "text": "资产是做生意时拥有的东西，负债是欠别人的钱，所有者权益是自己拥有的份额",
  "uiIdx": "1.2",
  "range": "6454-6480",
  "chapterUid": 20
 },
 {
  "level": 4,
  "text": "在商业上，对于“我们所拥有的东西”你知道叫做什么吗？资产。",
  "uiIdx": "",
  "range": "6454-6480",
  "chapterUid": 20
 },
 {
  "level": 4,
  "text": "既然右边存在两个所有者，我们就在他们中间画一道横线，以示区分。右边的上半部分代表做生意时向哪些人借了钱，对于他们而言，你有偿还的义务。你打算把10美元还给爸爸妈妈吗？(若你还想过下一个生日的话，最好还给他们。)你是否欠他们10美元？是的，没错。这就是为何我们将右边的上半部分标题写成“负债”的原因了。",
  "uiIdx": "",
  "range": "6682-6749",
  "chapterUid": 20
 },
 {
  "level": 4,
  "text": "右边的下半部分表示你当前在生意中所拥有的份额，那是你的初始投资。人们怎样称呼所有者所拥有的这个份额？我们试着回答这个问题吧，在以下答案中标上记号。(提示：可能不止一个答案。)。",
  "uiIdx": "",
  "range": "6857-6944",
  "chapterUid": 20
 },
 {
  "level": 3,
  "text": "资产负债表是反映企业在某一特定日期财务状况的会计报表，利润表是反映企业在一定会计期间经营成果的会计报表",
  "uiIdx": "1.3",
  "range": "17254-17270",
  "chapterUid": 20
 },
 {
  "level": 4,
  "text": "资产负债表必须具备的特征是什么？平衡。",
  "uiIdx": "",
  "range": "17254-17270",
  "chapterUid": 20
 },
 {
  "level": 4,
  "text": "资产负债表告诉你卖了多少存货吗？没有。它告诉了你所有的费用了吗？(譬如玻璃杯租金、广告费及租用邻居的场地费。)当然没有！它告诉你赚了多少钱吗？没有，没有，太多问题在表中找不到答案！",
  "uiIdx": "",
  "range": "18216-18237",
  "chapterUid": 20
 },
 {
  "level": 4,
  "text": "那么做生意需要知道以上所有这些相关信息吗？当然！问题在于，通过阅读资产负债表，你找不到这些问题的答案。那我们该如何去做？创建另一张记账卡。我们知道资产负债表展示的是瞬间的状况，就像一张快照，但还需要另一张记账卡告诉我们一个期间内的经营情况。一些交易的发生，譬如购买存货、生产产品、销售产品以及费用的产生都发生在一段时间内。",
  "uiIdx": "",
  "range": "18216-18237",
  "chapterUid": 20
 },
 {
  "level": 1,
  "text": "第2章 毛利、净利润、利润表、现金流量",
  "uiIdx": "",
  "range": "",
  "chapterUid": 20
 },
 {
  "level": 2,
  "text": "利润表的概念和构成",
  "uiIdx": "1",
  "range": "578-591",
  "chapterUid": 20
 },
 {
  "level": 3,
  "text": "利润表就好比一部电影，有开始和结束",
  "uiIdx": "1.1",
  "range": "578-591",
  "chapterUid": 20
 },
 {
  "level": 4,
  "text": "利润表有开始和结束，不像照片有开始和结束的时候。",
  "uiIdx": "",
  "range": "578-591",
  "chapterUid": 20
 },
 {
  "level": 3,
  "text": "利润表从销售收入开始，减去商品销售成本得到毛利，再减去所有其他的费用得到净利润",
  "uiIdx": "1.2",
  "range": "2199-2230",
  "chapterUid": 20
 },
 {
  "level": 4,
  "text": "商品销售成本是产品生产过程中所有的支出。",
  "uiIdx": "",
  "range": "2740-2783",
  "chapterUid": 20
 },
 {
  "level": 4,
  "text": "费用是企业经营中与产品生产不直接相关的其他支出。",
  "uiIdx": "",
  "range": "2783-2811",
  "chapterUid": 20
 },
 {
  "level": 2,
  "text": "利润表的编制目的和作用",
  "uiIdx": "2",
  "range": "3158-3214",
  "chapterUid": 20
 },
 {
  "level": 3,
  "text": "利润表的编制目的在于记录销售收入减去销售成本而获得企业某段时期的毛利，然后，再剔除所发生的其他费用，能得到净利润",
  "uiIdx": "2.1",
  "range": "3158-3214",
  "chapterUid": 20
 },
 {
  "level": 4,
  "text": "净利润的另外的叫法还包括纯利润或底线值。",
  "uiIdx": "",
  "range": "3353-3361",
  "chapterUid": 20
 },
 {
  "level": 3,
  "text": "利润表显示了你有25美元的销售收入，相应的成本是10美元，费用是5美元",
  "uiIdx": "2.2",
  "range": "7255-7291",
  "chapterUid": 20
 },
 {
  "level": 4,
  "text": "资产负债表就好比你所居住的州的地图，你会在这张地图上看到什么？(城市、主干道、河流、山川等。)总之，是一张城市中各个地点详细位置的缩略图。",
  "uiIdx": "",
  "range": "6961-7030",
  "chapterUid": 20
 },
 {
  "level": 4,
  "text": "让我们集中关注资产负债表中的一个项目——盈利。假设它是你所居住的一个城市或小镇。地图告诉你它的位置，但却没有其他相关的详细资料。为了能在地图中清楚地看到城市中的街道、河流、当地的地标，我们需要一张什么样的地图？(城市或小镇自己的地图。)这需要把原来的州地图充分放大，这也就是利润表的作用了。",
  "uiIdx": "",
  "range": "7055-7200",
  "chapterUid": 20
 },
 {
  "level": 2,
  "text": "利润表与资产负债表的关系",
  "uiIdx": "3",
  "range": "7750-7784",
  "chapterUid": 20
 },
 {
  "level": 3,
  "text": "资产负债表和利润表中的盈利数值相同",
  "uiIdx": "3.1",
  "range": "7750-7784",
  "chapterUid": 20
 },
 {
  "level": 4,
  "text": "净利润的数值和盈利的数值相同。",
  "uiIdx": "",
  "range": "7750-7784",
  "chapterUid": 20
 },
 {
  "level": 3,
  "text": "资产负债表中的存货和利润表中的期末存货相同",
  "uiIdx": "3.2",
  "range": "7916-7945",
  "chapterUid": 20
 },
 {
  "level": 4,
  "text": "因为我们没有使用它！我们不能把它算做销售成本，因为我们没有把它销售出去。所以，我们从可供销售的商品中减掉它们。而在资产负债表上，因为我们没有卖掉它，它的价值仍然存在，我们仍旧拥有它吗？是的！。",
  "uiIdx": "",
  "range": "7916-8059",
  "chapterUid": 20
 },
 {
  "level": 4,
  "text": "那么我们可以在未来的某个时候把它们卖掉吗？当然！所以，我们把它作为期末存货。",
  "uiIdx": "",
  "range": "8113-8134",
  "chapterUid": 20
 },
 {
  "level": 2,
  "text": "利润表的局限性",
  "uiIdx": "4",
  "range": "10366-10394",
  "chapterUid": 20
 },
 {
  "level": 3,
  "text": "利润表和资产负债表并不能将整个生意状况完整地展示出来",
  "uiIdx": "4.1",
  "range": "10366-10394",
  "chapterUid": 20
 },
 {
  "level": 4,
  "text": "要想达到此目的，你至少需要三类报表。",
  "uiIdx": "",
  "range": "10394-10412",
  "chapterUid": 20
 },
 {
  "level": 3,
  "text": "借款的利息是一项费用，但并未出现在利润表中",
  "uiIdx": "4.2",
  "range": "10236-10256",
  "chapterUid": 20
 },
 {
  "level": 4,
  "text": "借款的利息是一项费用。感谢上帝，爸爸妈妈居然没想到要这笔利息！。",
  "uiIdx": "",
  "range": "10225-10256",
  "chapterUid": 20
 },
 {
  "level": 1,
  "text": "第3章 留存收益、贷款、赊账、应付账款、应付票据",
  "uiIdx": "",
  "range": "",
  "chapterUid": 20
 },
 {
  "level": 2,
  "text": "留存收益的概念和计算",
  "uiIdx": "1",
  "range": "2314-2347",
  "chapterUid": 20
 },
 {
  "level": 3,
  "text": "留存收益是过去会计期间的累积盈利",
  "uiIdx": "1.1",
  "range": "2314-2347",
  "chapterUid": 20
 },
 {
  "level": 4,
  "text": "留存收益告诉我们迄今为止的累积盈利是从什么时候开始核算的？本次会计期间以前的。",
  "uiIdx": "",
  "range": "2314-2376",
  "chapterUid": 20
 },
 {
  "level": 3,
  "text": "留存收益可以通过滚存利润的方式获得",
  "uiIdx": "1.2",
  "range": "1934-1979",
  "chapterUid": 20
 },
 {
  "level": 4,
  "text": "为了放置本周的盈利，我们打算把上周的利润一直滚存到本周，这是一个新科目，叫做“留存收益”。",
  "uiIdx": "",
  "range": "1934-1979",
  "chapterUid": 20
 },
 {
  "level": 2,
  "text": "从银行贷款的过程",
  "uiIdx": "2",
  "range": "3788-3834",
  "chapterUid": 20
 },
 {
  "level": 3,
  "text": "银行家会根据财务报表来决定是否贷款",
  "uiIdx": "2.1",
  "range": "3788-3834",
  "chapterUid": 20
 },
 {
  "level": 4,
  "text": "银行家看了看你，并点点头。“非常不错，许多成年人的生意都做不出你这样好的业绩！”。",
  "uiIdx": "",
  "range": "3788-3834",
  "chapterUid": 20
 },
 {
  "level": 3,
  "text": "贷款成功后，需要在资产负债表中记录",
  "uiIdx": "2.2",
  "range": "4770-4785",
  "chapterUid": 20
 },
 {
  "level": 4,
  "text": "首先，什么到手了？现金。所以，左边加上50美元的现金。两边平衡了吗？没有。我们现在欠谁的钱？欠银行50美元。我们把所欠的钱放在哪个项目里？应付票据。",
  "uiIdx": "",
  "range": "4770-4785",
  "chapterUid": 20
 },
 {
  "level": 2,
  "text": "赊账购买的过程",
  "uiIdx": "3",
  "range": "8724-8746",
  "chapterUid": 20
 },
 {
  "level": 3,
  "text": "赊账购买需要建立账户并记录",
  "uiIdx": "3.1",
  "range": "8724-8746",
  "chapterUid": 20
 },
 {
  "level": 4,
  "text": "我们欠账了吗？是的。为了记录在杂货店的赊账款，我们需要建立什么？一个账户。那我们应该还钱给谁？杂货店老板。在商业上这类情况称做什么？应付账款。",
  "uiIdx": "",
  "range": "8724-8746",
  "chapterUid": 20
 },
 {
  "level": 3,
  "text": "赊账购买的商品或服务需要在未来的某个时间点偿还",
  "uiIdx": "3.2",
  "range": "9657-9677",
  "chapterUid": 20
 },
 {
  "level": 4,
  "text": "通常情况下，银行的贷款(应付票据)和杂货店的信用贷款(应付账款)有着不同的还款期限。换言之，一个还款期限长，一个还款期限短。",
  "uiIdx": "",
  "range": "9615-9677",
  "chapterUid": 20
 },
 {
  "level": 2,
  "text": "应付票据和应付账款的区别",
  "uiIdx": "4",
  "range": "9443-9496",
  "chapterUid": 20
 },
 {
  "level": 3,
  "text": "应付票据是因收到他人的借款而产生的，应付账款是因为赊账购买原材料等物品而产生的",
  "uiIdx": "4.1",
  "range": "9443-9496",
  "chapterUid": 20
 },
 {
  "level": 4,
  "text": "我们因应付票据而获得现金，因应付账款而获得商品或服务。",
  "uiIdx": "",
  "range": "9525-9563",
  "chapterUid": 20
 },
 {
  "level": 3,
  "text": "应付票据通常需要支付利息，而应付账款通常不需要支付利息，除非你无法按时还款",
  "uiIdx": "4.2",
  "range": "10027-10052",
  "chapterUid": 20
 },
 {
  "level": 4,
  "text": "所有银行在贷款时通常都会索要什么，而你在商店赊购东西若还款后就不会再另行被索要什么？利息！哪一类债务需要支付利息？应付票据。通常，应付账款不需要支付利息，除非你无法按时还款。",
  "uiIdx": "",
  "range": "10027-10052",
  "chapterUid": 20
 },
 {
  "level": 1,
  "text": "第4章 应付工资、应收账款、坏账、利息、待摊费用、权责发生制、收付实现制、创意会计",
  "uiIdx": "",
  "range": "",
  "chapterUid": 20
 },
 {
  "level": 2,
  "text": "柠檬汁制作与销售",
  "uiIdx": "1",
  "range": "459-506",
  "chapterUid": 20
 },
 {
  "level": 3,
  "text": "制作柠檬汁需要原材料和人工成本",
  "uiIdx": "1.1",
  "range": "459-506",
  "chapterUid": 20
 },
 {
  "level": 4,
  "text": "50个鲜柠檬(每个20美分)、5磅白糖(每磅40美分)。",
  "uiIdx": "",
  "range": "459-506",
  "chapterUid": 20
 },
 {
  "level": 4,
  "text": "姐姐制作柠檬汁的人工成本为1美元。",
  "uiIdx": "",
  "range": "17937-17962",
  "chapterUid": 20
 },
 {
  "level": 3,
  "text": "柠檬汁销售后，现金减少，存货增加",
  "uiIdx": "1.2",
  "range": "17937-17962",
  "chapterUid": 20
 },
 {
  "level": 4,
  "text": "制作60杯柠檬汁，花费1美元的人工成本，现金减少1美元，存货增加1美元。",
  "uiIdx": "",
  "range": "17937-17962",
  "chapterUid": 20
 },
 {
  "level": 4,
  "text": "卖出60杯柠檬汁，获得30美元现金，应收账款增加10美元。",
  "uiIdx": "",
  "range": "18040-18072",
  "chapterUid": 20
 },
 {
  "level": 2,
  "text": "应收账款与坏账",
  "uiIdx": "2",
  "range": "3940-3961",
  "chapterUid": 20
 },
 {
  "level": 3,
  "text": "应收账款是客户赊账购买商品后未立即支付的款项",
  "uiIdx": "2.1",
  "range": "3940-3961",
  "chapterUid": 20
 },
 {
  "level": 4,
  "text": "你赊账卖给朋友们几杯柠檬汁，他们还没付钱。",
  "uiIdx": "",
  "range": "3940-3961",
  "chapterUid": 20
 },
 {
  "level": 4,
  "text": "你记录了你的销售额，那些你给予信用赊账的都是你的朋友。",
  "uiIdx": "",
  "range": "4232-4263",
  "chapterUid": 20
 },
 {
  "level": 3,
  "text": "坏账是由于客户无法支付欠款而造成的损失",
  "uiIdx": "2.2",
  "range": "6725-6783",
  "chapterUid": 20
 },
 {
  "level": 4,
  "text": "你的一个朋友——约翰，那个口渴得要命、一口气赊账买了你8杯柠檬汁的家伙居然开溜了。",
  "uiIdx": "",
  "range": "6725-6783",
  "chapterUid": 20
 },
 {
  "level": 4,
  "text": "你断定那个搬家的坏朋友肯定不可能把钱还你了，这类欺骗的行为将会对你的生意和财务报表产生负面影响。",
  "uiIdx": "",
  "range": "6829-6894",
  "chapterUid": 20
 },
 {
  "level": 2,
  "text": "利息与待摊费用",
  "uiIdx": "3",
  "range": "18178-18209",
  "chapterUid": 20
 },
 {
  "level": 3,
  "text": "利息是借款成本，应在借款期间内分摊",
  "uiIdx": "3.1",
  "range": "18178-18209",
  "chapterUid": 20
 },
 {
  "level": 4,
  "text": "你归还了你的银行贷款，其中本金25美元，外加2美元的利息。",
  "uiIdx": "",
  "range": "18178-18209",
  "chapterUid": 20
 },
 {
  "level": 4,
  "text": "利息费用会在利润表中显示，因为它不是贷款的本金，而是贷款的成本，应该反映在利润表中。",
  "uiIdx": "",
  "range": "10354-10396",
  "chapterUid": 20
 },
 {
  "level": 3,
  "text": "待摊费用是预先支付的费用，应在费用实际发生时或使用时才确认",
  "uiIdx": "3.2",
  "range": "16606-16626",
  "chapterUid": 20
 },
 {
  "level": 4,
  "text": "你为3年期的保单支付了3美元的保费，今年应该摊销1美元保费。",
  "uiIdx": "",
  "range": "18234-18266",
  "chapterUid": 20
 },
 {
  "level": 4,
  "text": "我们预付了保费吗？是的。预付了多少年？3年。这样算来，每年要摊销多少钱？1美元。",
  "uiIdx": "",
  "range": "12393-12407",
  "chapterUid": 20
 },
 {
  "level": 2,
  "text": "权责发生制与收付实现制",
  "uiIdx": "4",
  "range": "30522-30547",
  "chapterUid": 20
 },
 {
  "level": 3,
  "text": "权责发生制是在交易事项发生时进行会计核算，无论是否收到或支付现金",
  "uiIdx": "4.1",
  "range": "25597-25646",
  "chapterUid": 20
 },
 {
  "level": 4,
  "text": "在权责发生制下，销售收入并不是在收到现金时才被确认，应该在何时被确认？能够获得收益时。",
  "uiIdx": "",
  "range": "15736-15774",
  "chapterUid": 20
 },
 {
  "level": 4,
  "text": "在权责发生制下，我们在采购发生时即刻确认，而不论是否支付了采购款。",
  "uiIdx": "",
  "range": "16269-16305",
  "chapterUid": 20
 },
 {
  "level": 3,
  "text": "收付实现制是在交易事项发生时或涉及现金时才进行会计核算",
  "uiIdx": "4.2",
  "range": "26597-26631",
  "chapterUid": 20
 },
 {
  "level": 4,
  "text": "在收付实现制下，销售总额是多少？22美元。为何是22美元而非权责发生制下的32美元？应收账款没核算入内。",
  "uiIdx": "",
  "range": "27391-27538",
  "chapterUid": 20
 },
 {
  "level": 4,
  "text": "根据收付实现制，你因收到或支付什么而进行会计核算？现金。",
  "uiIdx": "",
  "range": "26793-26818",
  "chapterUid": 20
 },
 {
  "level": 1,
  "text": "第5章 服务业",
  "uiIdx": "",
  "range": "",
  "chapterUid": 20
 },
 {
  "level": 2,
  "text": "柠檬汁摊生意的成功与困扰",
  "uiIdx": "1",
  "range": "446-466",
  "chapterUid": 20
 },
 {
  "level": 3,
  "text": "柠檬汁摊生意受到当地报纸报道，声誉远扬",
  "uiIdx": "1.1",
  "range": "446-466",
  "chapterUid": 20
 },
 {
  "level": 4,
  "text": "报纸用了第5版整版来报道你的创业史。",
  "uiIdx": "",
  "range": "446-466",
  "chapterUid": 20
 },
 {
  "level": 4,
  "text": "上面刊登了你站在自己的柠檬汁售卖摊前的照片。",
  "uiIdx": "",
  "range": "466-514",
  "chapterUid": 20
 },
 {
  "level": 4,
  "text": "他们采访了你的父母，爸爸妈妈说这完全是你自己的主意。",
  "uiIdx": "",
  "range": "514-551",
  "chapterUid": 20
 },
 {
  "level": 4,
  "text": "其中还有帕克老爹的专访，他希望有更多的孩子像你一样。",
  "uiIdx": "",
  "range": "551-577",
  "chapterUid": 20
 },
 {
  "level": 4,
  "text": "文章中还有一些孩子们对你的柠檬汁的评价，他们说这是迄今喝到的最美味的果汁。",
  "uiIdx": "",
  "range": "577-634",
  "chapterUid": 20
 },
 {
  "level": 3,
  "text": "许多附近的孩子慕名而来咨询你关于开柠檬汁摊的事儿",
  "uiIdx": "1.2",
  "range": "712-743",
  "chapterUid": 20
 },
 {
  "level": 4,
  "text": "你试图使自己不要因为听到以上的评价而骄傲自满。",
  "uiIdx": "",
  "range": "659-682",
  "chapterUid": 20
 },
 {
  "level": 4,
  "text": "你必须考虑自己的生意不受影响。",
  "uiIdx": "",
  "range": "760-775",
  "chapterUid": 20
 },
 {
  "level": 4,
  "text": "这些孩子正在让你帮他们成为自己潜在的竞争对手！",
  "uiIdx": "",
  "range": "775-798",
  "chapterUid": 20
 },
 {
  "level": 4,
  "text": "你下决心不去帮助那些想在自己附近开柠檬汁摊的孩子。",
  "uiIdx": "",
  "range": "798-823",
  "chapterUid": 20
 },
 {
  "level": 2,
  "text": "柠檬汁咨询公司的创立",
  "uiIdx": "2",
  "range": "1090-1129",
  "chapterUid": 20
 },
 {
  "level": 3,
  "text": "简阿姨建议你雇用一些员工，让他们打理你的柠檬汁生意，你也可以培训他们成为咨询顾问",
  "uiIdx": "2.1",
  "range": "1090-1129",
  "chapterUid": 20
 },
 {
  "level": 4,
  "text": "你问简阿姨该如何收取咨询费。",
  "uiIdx": "",
  "range": "1375-1393",
  "chapterUid": 20
 },
 {
  "level": 4,
  "text": "她从“可计费小时”开始给你讲述。",
  "uiIdx": "",
  "range": "1393-1414",
  "chapterUid": 20
 },
 {
  "level": 4,
  "text": "她的意思是服务业关键在于如何管理和充分利用时间。",
  "uiIdx": "",
  "range": "1420-1444",
  "chapterUid": 20
 },
 {
  "level": 4,
  "text": "对于柠檬汁的生意你必须经营管理好原材料、柠檬汁及时间，但对于一名咨询业的从业者，其唯一的存货就是他自己的时间。",
  "uiIdx": "",
  "range": "1444-1499",
  "chapterUid": 20
 },
 {
  "level": 3,
  "text": "你决定开展你的第二项业务——柠檬汁咨询公司",
  "uiIdx": "2.2",
  "range": "1305-1350",
  "chapterUid": 20
 },
 {
  "level": 4,
  "text": "你权衡利弊觉得重新开设一家咨询公司更好。",
  "uiIdx": "",
  "range": "1305-1350",
  "chapterUid": 20
 },
 {
  "level": 2,
  "text": "柠檬汁咨询公司的运营",
  "uiIdx": "3",
  "range": "2701-2744",
  "chapterUid": 20
 },
 {
  "level": 3,
  "text": "你雇用了一些朋友，他们学会了经营公司的核心竞争力，很快就协助你打理柠檬汁的生意了",
  "uiIdx": "3.1",
  "range": "2701-2744",
  "chapterUid": 20
 },
 {
  "level": 4,
  "text": "由于当地报纸的那篇报道及各方的称赞，新的咨询生意开展得不错，两个雇员的工作都非常繁忙。",
  "uiIdx": "",
  "range": "2769-2812",
  "chapterUid": 20
 },
 {
  "level": 3,
  "text": "你弟弟迈克也想参与到你的业务中，因此，你向他承诺，只要他成功地签下一单合同，就支付1美元的佣金给他",
  "uiIdx": "3.2",
  "range": "2836-2887",
  "chapterUid": 20
 },
 {
  "level": 4,
  "text": "你“出售”给休阿姨3天的咨询服务，两个咨询师每人每天收费8美元，其中包含了他们工作期间的差旅费。",
  "uiIdx": "",
  "range": "3164-3212",
  "chapterUid": 20
 },
 {
  "level": 4,
  "text": "出差的交通费(汽油)总共是6美元，你付给两位咨询师每人每天2美元的报酬。",
  "uiIdx": "",
  "range": "3307-3343",
  "chapterUid": 20
 },
 {
  "level": 4,
  "text": "你弟弟——迈克，同意承担有关合同的管理及其他行政工作，为此，你每周要支付他2美元的工资。",
  "uiIdx": "",
  "range": "3368-3412",
  "chapterUid": 20
 },
 {
  "level": 4,
  "text": "你同时也要支付给他1美元因签下休阿姨咨询服务合同的佣金。",
  "uiIdx": "",
  "range": "3412-3440",
  "chapterUid": 20
 },
 {
  "level": 4,
  "text": "新闻报道给你的生意带来了巨大反响，你决心下一期继续做广告。刊登一则广告的支出是4美元。",
  "uiIdx": "",
  "range": "3465-3508",
  "chapterUid": 20
 },
 {
  "level": 4,
  "text": "你的两位咨询师从周一至周三向客户(你的表妹们)提供了3天的咨询服务。为了防止你的表妹们“图谋”跟随他们一起回来“夺取”你的柠檬汁调制秘方，他们随身带了价值2美元的鲜柠檬和1美元的白糖，并向你的表妹们演示了制作柠檬汁的过程。",
  "uiIdx": "",
  "range": "3533-3644",
  "chapterUid": 20
 },
 {
  "level": 4,
  "text": "周四，咨询师们回来了，用了一整天的时间为你的“美味柠檬汁咨询公司”开发一项新的咨询产品。(这是一个具有代表性的专门为害羞孩子们开设的课程，名为：“丢弃怯懦，大胆推销。”。)你给没出外勤的咨询师每人每天支付1.5美元的工资。",
  "uiIdx": "",
  "range": "3567-3644",
  "chapterUid": 20
 },
 {
  "level": 4,
  "text": "周五，他们通常在办公室(你的地下娱乐室)做些行政管理等方面的事务性工作。",
  "uiIdx": "",
  "range": "3824-3860",
  "chapterUid": 20
 },
 {
  "level": 2,
  "text": "柠檬汁咨询公司的利润表",
  "uiIdx": "4",
  "range": "4664-4696",
  "chapterUid": 20
 },
 {
  "level": 3,
  "text": "营业收入减去服务成本得到毛利(盈利)",
  "uiIdx": "4.1",
  "range": "4664-4696",
  "chapterUid": 20
 },
 {
  "level": 4,
  "text": "客户(休阿姨和埃里克叔叔)购买了每天8美元共3天的咨询服务。你派了两位咨询师前往做咨询服务。所以，收入总额是多少？48美元。",
  "uiIdx": "",
  "range": "4332-4378",
  "chapterUid": 20
 },
 {
  "level": 4,
  "text": "对于咨询服务，你投入了什么？你不得不支付咨询师每人每天2美元的报酬，两个咨询师共3天=12美元。你还必须支付他们的交通费(6美元)，还有他们带走了价值3美元的产品以便为客户演示并且将之留在客户那儿。",
  "uiIdx": "",
  "range": "4332-4362",
  "chapterUid": 20
 },
 {
  "level": 4,
  "text": "所以，你的服务成本是多少？21美元。",
  "uiIdx": "",
  "range": "4595-4608",
  "chapterUid": 20
 },
 {
  "level": 4,
  "text": "根据我们给出的公式，营业收入减去服务成本得到毛利(盈利)是多少？27美元。",
  "uiIdx": "",
  "range": "4664-4696",
  "chapterUid": 20
 },
 {
  "level": 3,
  "text": "费用与所提供的咨询服务不直接相关",
  "uiIdx": "4.2",
  "range": "4765-4804",
  "chapterUid": 20
 },
 {
  "level": 4,
  "text": "你支付给迈克1美元的佣金，在报纸上登广告花了4美元。",
  "uiIdx": "",
  "range": "4836-4862",
  "chapterUid": 20
 },
 {
  "level": 4,
  "text": "迈克还因承担了合同的管理及其他办公工作获得了2美元的报酬。接着，周五，你的咨询师在办公室干了些管理的工作，你支付给他们每人1.5美元的工资。(他们宣称自己整个周五都忙于案头工作，但你还是怀疑可能他们大部分时间都在电脑上玩纸牌游戏。)。",
  "uiIdx": "",
  "range": "4836-5003",
  "chapterUid": 20
 },
 {
  "level": 4,
  "text": "还有一项费用。你的“丢弃怯懦，大胆推销”咨询产品的研发费是多少？3美元。",
  "uiIdx": "",
  "range": "5035-5060",
  "chapterUid": 20
 },
 {
  "level": 4,
  "text": "所以，总费用是多少？13美元。",
  "uiIdx": "",
  "range": "5115-5125",
  "chapterUid": 20
 },
 {
  "level": 4,
  "text": "到现在，我们快要完成利润表了。最后一件事，将费用从毛利中减去得到净利润为多少？14美元。",
  "uiIdx": "",
  "range": "5181-5220",
  "chapterUid": 20
 },
 {
  "level": 1,
  "text": "第6章 先进先出法、后进先出法",
  "uiIdx": "",
  "range": "",
  "chapterUid": 20
 },
 {
  "level": 2,
  "text": "柠檬汁售卖摊的经营",
  "uiIdx": "1",
  "range": "590-609",
  "chapterUid": 20
 },
 {
  "level": 3,
  "text": "本周的柠檬汁售卖摊生意兴隆",
  "uiIdx": "1.1",
  "range": "4994-5011",
  "chapterUid": 20
 },
 {
  "level": 4,
  "text": "天气炎热，人们排着长队购买柠檬汁。",
  "uiIdx": "",
  "range": "4994-5011",
  "chapterUid": 20
 },
 {
  "level": 4,
  "text": "你以每杯50美分的价格售出了所有调制的柠檬汁。现金销售50杯，另外10杯赊销。总销售额=30美元，其中包括25美元的现金和5美元的应收账款。",
  "uiIdx": "",
  "range": "5249-5319",
  "chapterUid": 20
 },
 {
  "level": 3,
  "text": "滚存利润，将上周的盈利放入留存收益里",
  "uiIdx": "1.2",
  "range": "887-908",
  "chapterUid": 20
 },
 {
  "level": 4,
  "text": "这是新一周的第一天，该是补充一些原材料的时候了。",
  "uiIdx": "",
  "range": "1215-1239",
  "chapterUid": 20
 },
 {
  "level": 4,
  "text": "你从车库取出自行车，骑上它，向着帕克老爹的杂货店飞驰而去。",
  "uiIdx": "",
  "range": "1284-1335",
  "chapterUid": 20
 },
 {
  "level": 4,
  "text": "你到家后，立即编制了一张新的资产负债表。",
  "uiIdx": "",
  "range": "2112-2132",
  "chapterUid": 20
 },
 {
  "level": 2,
  "text": "存货计价方法：先进先出法(FIFO)",
  "uiIdx": "2",
  "range": "3622-3643",
  "chapterUid": 20
 },
 {
  "level": 3,
  "text": "先进先出法假设第一个购入的柠檬也是第一个被使用的柠檬",
  "uiIdx": "2.1",
  "range": "3675-3709",
  "chapterUid": 20
 },
 {
  "level": 4,
  "text": "这意味着第一个进入存货的柠檬将第一个被消耗掉，或被卖出去。",
  "uiIdx": "",
  "range": "3675-3709",
  "chapterUid": 20
 },
 {
  "level": 3,
  "text": "先进先出法的优点是账面上更好看，净利润更高",
  "uiIdx": "2.2",
  "range": "12833-12884",
  "chapterUid": 20
 },
 {
  "level": 4,
  "text": "在先进先出法下，我们的商品销售成本更低，期末存货价值更高。",
  "uiIdx": "",
  "range": "12833-12884",
  "chapterUid": 20
 },
 {
  "level": 2,
  "text": "存货计价方法：后进先出法(LIFO)",
  "uiIdx": "3",
  "range": "9395-9430",
  "chapterUid": 20
 },
 {
  "level": 3,
  "text": "后进先出法假设最后购入的存货，最先被耗用",
  "uiIdx": "3.1",
  "range": "9395-9430",
  "chapterUid": 20
 },
 {
  "level": 4,
  "text": "这意味着后进来的存货，最先被耗用或出售。",
  "uiIdx": "",
  "range": "9395-9430",
  "chapterUid": 20
 },
 {
  "level": 3,
  "text": "后进先出法的优点是节税",
  "uiIdx": "3.2",
  "range": "14317-14362",
  "chapterUid": 20
 },
 {
  "level": 4,
  "text": "对于存货采购成本不断增加的公司而言，若想减少所得税，就需要采用后进先出法。",
  "uiIdx": "",
  "range": "14317-14362",
  "chapterUid": 20
 },
 {
  "level": 4,
  "text": "假设存货的价格不断下跌，你若仍想节税，应该选择先进先出法。",
  "uiIdx": "",
  "range": "14419-14447",
  "chapterUid": 20
 },
 {
  "level": 4,
  "text": "电子产品行业类公司为了达到节税的目的，一般会采用先进先出法进行存货计价。",
  "uiIdx": "",
  "range": "14524-14570",
  "chapterUid": 20
 },
 {
  "level": 2,
  "text": "先进先出法和后进先出法的比较",
  "uiIdx": "4",
  "range": "14869-14887",
  "chapterUid": 20
 },
 {
  "level": 3,
  "text": "先进先出法和后进先出法对资产负债表和利润表的影响",
  "uiIdx": "4.1",
  "range": "14869-14887",
  "chapterUid": 20
 },
 {
  "level": 4,
  "text": "先进先出法下，总资产是多少？92美元。那么采用后进先出法的总资产是多少呢？82美元。",
  "uiIdx": "",
  "range": "14869-14887",
  "chapterUid": 20
 },
 {
  "level": 4,
  "text": "先进先出法下得到的期末存货中柠檬有多少个？50个。后进先出法下得到的期末存货中柠檬有多少个？50个。",
  "uiIdx": "",
  "range": "15191-15311",
  "chapterUid": 20
 },
 {
  "level": 4,
  "text": "两种方法下，得到的期末柠檬数量一致。无论采用先进先出法还是后进先出法，你出售或耗用的柠檬数量都完全一样。",
  "uiIdx": "",
  "range": "15343-15395",
  "chapterUid": 20
 },
 {
  "level": 3,
  "text": "先进先出法和后进先出法的选择取决于公司的纳税筹划策略和产品价格走势",
  "uiIdx": "4.2",
  "range": "13894-13922",
  "chapterUid": 20
 },
 {
  "level": 4,
  "text": "公司选择采用后进先出法的唯一目的在于节税！。",
  "uiIdx": "",
  "range": "13894-13922",
  "chapterUid": 20
 },
 {
  "level": 4,
  "text": "是吗？我怎么听不见？！请再重复一遍。但是，你也许会问，这个理由总是正确的吗？问得好！。",
  "uiIdx": "",
  "range": "13950-14207",
  "chapterUid": 20
 },
 {
  "level": 4,
  "text": "本例中为何采用后进先出法对存货计价后，利润有所减少？因为存货的进价升高了。对于那些存货采购成本不断增加的公司而言，若想减少所得税，就需要采用后进先出法。",
  "uiIdx": "",
  "range": "14261-14362",
  "chapterUid": 20
 },
 {
  "level": 4,
  "text": "假设存货的价格不断下跌，你若仍想节税，应该选择先进先出法。哪类行业的产品价格过去几年一直在下跌？电子产品行业。所以，电子产品行业类公司为了达到节税的目的，一般会采用先进先出法进行存货计价。",
  "uiIdx": "",
  "range": "14419-14447",
  "chapterUid": 20
 },
 {
  "level": 2,
  "text": "存货计价的实际操作",
  "uiIdx": "5",
  "range": "16784-16822",
  "chapterUid": 20
 },
 {
  "level": 3,
  "text": "在实际耗用或出售存货时，会使用先进先出法，而非后进先出法",
  "uiIdx": "5.1",
  "range": "16784-16822",
  "chapterUid": 20
 },
 {
  "level": 4,
  "text": "哪些柠檬总是会被使用？先进入的那些，否则，它们就变质腐坏了。",
  "uiIdx": "",
  "range": "16773-16822",
  "chapterUid": 20
 },
 {
  "level": 4,
  "text": "后进先出法是会计核算方法上的一种创新。在实践中，你应该总会使用那些先购入的柠檬，在后进先出法下，你仅仅是“假装”在使用那些新购入的柠檬。",
  "uiIdx": "",
  "range": "16854-16922",
  "chapterUid": 20
 },
 {
  "level": 3,
  "text": "公司可以选择采用哪种方法对存货进行计价，但一旦做了决定，若下次再想转换核算方法，则必须经过美国国税局许可",
  "uiIdx": "5.2",
  "range": "17182-17219",
  "chapterUid": 20
 },
 {
  "level": 4,
  "text": "如果一家公司若已经从先进先出法改为后进先出法核算，但要再一次改变，就不太可能获得美国国税局的批准。",
  "uiIdx": "",
  "range": "17244-17291",
  "chapterUid": 20
 },
 {
  "level": 4,
  "text": "如果你已经从后进先出法转变到了先进先出法核算，需要补缴因此少计的所得税吗？恐怕是这样的。",
  "uiIdx": "",
  "range": "17316-17353",
  "chapterUid": 20
 },
 {
  "level": 1,
  "text": "第7章 现金流量表、固定资产、资本化、折旧",
  "uiIdx": "",
  "range": "",
  "chapterUid": 20
 },
 {
  "level": 2,
  "text": "现金流量表的概念和作用",
  "uiIdx": "1",
  "range": "3062-3102",
  "chapterUid": 20
 },
 {
  "level": 3,
  "text": "现金流量表记录的是一个给定期间内现金的流入和流出。",
  "uiIdx": "1.1",
  "range": "3062-3102",
  "chapterUid": 20
 },
 {
  "level": 3,
  "text": "现金流量表使凳子平衡，是资产负债表和利润表之外的第三类财务报表",
  "uiIdx": "1.2",
  "range": "2295-2348",
  "chapterUid": 20
 },
 {
  "level": 4,
  "text": "一个凳子的平衡需要有几条腿？三条。若我们假设财务记账好比一个凳子，资产负债表是其中的一条腿，利润表是另一条腿，我们还需要一条腿来使凳子平衡。它就是现金流量表。",
  "uiIdx": "",
  "range": "2295-2348",
  "chapterUid": 20
 },
 {
  "level": 2,
  "text": "固定资产的定义和资本化",
  "uiIdx": "2",
  "range": "4636-4663",
  "chapterUid": 20
 },
 {
  "level": 3,
  "text": "固定资产是购得的财产、厂房和设备，能够反复被使用",
  "uiIdx": "2.1",
  "range": "4636-4663",
  "chapterUid": 20
 },
 {
  "level": 4,
  "text": "对于那些购得的财产、厂房和设备称做什么？一项固定资产。为何说它是“固定”的？因为这类东西一般不用做出售，在商业周期中，能够反复被使用。",
  "uiIdx": "",
  "range": "4636-4663",
  "chapterUid": 20
 },
 {
  "level": 3,
  "text": "资本化是将现金转换成了另一项资产的行为",
  "uiIdx": "2.2",
  "range": "5373-5405",
  "chapterUid": 20
 },
 {
  "level": 4,
  "text": "我们刚刚买了一项固定资产，它属于我们吗？是的。价值多少钱？10美元。你知道当你购买一项资产并将其添加至资产负债表的行为被称做什么吗？资产的资本化。",
  "uiIdx": "",
  "range": "5373-5405",
  "chapterUid": 20
 },
 {
  "level": 2,
  "text": "折旧的定义和计算",
  "uiIdx": "3",
  "range": "18583-18612",
  "chapterUid": 20
 },
 {
  "level": 3,
  "text": "折旧是在固定资产使用期间因耗用、磨损、过时等导致的价值减少。",
  "uiIdx": "3.1",
  "range": "18583-18612",
  "chapterUid": 20
 },
 {
  "level": 3,
  "text": "直线折旧法是在固定资产的使用年限和价值之间画一条直线，每年的折旧比例都是相同的",
  "uiIdx": "3.2",
  "range": "19665-19711",
  "chapterUid": 20
 },
 {
  "level": 4,
  "text": "运用直线折旧法，每年的折旧比例都是相同的，那么每年折旧多少才能将价值10美元的固定资产折旧完？如果使用年限为10年，每年折旧即为10%。",
  "uiIdx": "",
  "range": "20001-20158",
  "chapterUid": 20
 },
 {
  "level": 2,
  "text": "利润表的编制",
  "uiIdx": "4",
  "range": "369-386",
  "chapterUid": 20
 },
 {
  "level": 3,
  "text": "利润表记录了销售收入、销售成本、毛利、费用和净利润",
  "uiIdx": "4.1",
  "range": "369-386",
  "chapterUid": 20
 },
 {
  "level": 4,
  "text": "销售收入是50美元。",
  "uiIdx": "",
  "range": "24068-24078",
  "chapterUid": 20
 },
 {
  "level": 4,
  "text": "期初存货为10美元。",
  "uiIdx": "",
  "range": "24103-24113",
  "chapterUid": 20
 },
 {
  "level": 4,
  "text": "采购为20美元。",
  "uiIdx": "",
  "range": "24138-24146",
  "chapterUid": 20
 },
 {
  "level": 4,
  "text": "所以，可供销售的存货为30美元。",
  "uiIdx": "",
  "range": "24171-24187",
  "chapterUid": 20
 },
 {
  "level": 4,
  "text": "期末存货是10美元。",
  "uiIdx": "",
  "range": "24212-24222",
  "chapterUid": 20
 },
 {
  "level": 4,
  "text": "这意味着商品销售成本是20美元。",
  "uiIdx": "",
  "range": "24247-24263",
  "chapterUid": 20
 },
 {
  "level": 4,
  "text": "因而得出毛利为30美元。",
  "uiIdx": "",
  "range": "24288-24300",
  "chapterUid": 20
 },
 {
  "level": 4,
  "text": "费用为：油漆，2美元；顶棚修理费，1美元；利息，2美元；折旧，1美元。总费用为6美元。",
  "uiIdx": "",
  "range": "24325-24368",
  "chapterUid": 20
 },
 {
  "level": 4,
  "text": "因此，得出净利润是24美元！",
  "uiIdx": "",
  "range": "24393-24426",
  "chapterUid": 20
 },
 {
  "level": 2,
  "text": "现金流量表的编制",
  "uiIdx": "5",
  "range": "23264-23296",
  "chapterUid": 20
 },
 {
  "level": 3,
  "text": "现金流量表记录了所有的涉及现金流的交易，多少现金流出而又有多少现金流入",
  "uiIdx": "5.1",
  "range": "23264-23296",
  "chapterUid": 20
 },
 {
  "level": 4,
  "text": "现金流入是多少？45美元。",
  "uiIdx": "",
  "range": "22676-22684",
  "chapterUid": 20
 },
 {
  "level": 4,
  "text": "花费又是多少？63美元。",
  "uiIdx": "",
  "range": "22740-22747",
  "chapterUid": 20
 },
 {
  "level": 4,
  "text": "所以，+45和-63相加，得到现金流量净额为多少？-18美元。",
  "uiIdx": "",
  "range": "22803-22828",
  "chapterUid": 20
 },
 {
  "level": 1,
  "text": "第8章 利润vs现金",
  "uiIdx": "",
  "range": "",
  "chapterUid": 20
 },
 {
  "level": 2,
  "text": "利润与现金的关系",
  "uiIdx": "1",
  "range": "10362-10378",
  "chapterUid": 20
 },
 {
  "level": 3,
  "text": "利润和现金不是一回事，现金是企业的核心、驱动力及血脉",
  "uiIdx": "1.1",
  "range": "10362-10378",
  "chapterUid": 20
 },
 {
  "level": 4,
  "text": "利润仅说明了你所赚取的金钱数量，它表明了销售收入大于销售成本的差额。",
  "uiIdx": "",
  "range": "10499-10537",
  "chapterUid": 20
 },
 {
  "level": 4,
  "text": "如果没有利润企业仍会继续运营一段时间，但如果没有任何现金企业能够运作一天都不可能。",
  "uiIdx": "",
  "range": "10595-10615",
  "chapterUid": 20
 },
 {
  "level": 2,
  "text": "资产负债表和利润表的区别",
  "uiIdx": "2",
  "range": "9581-9624",
  "chapterUid": 20
 },
 {
  "level": 3,
  "text": "资产负债表是站在我们的角度上看到有什么东西流出了，我们的现金、存货等究竟是多少。",
  "uiIdx": "2.1",
  "range": "9581-9624",
  "chapterUid": 20
 },
 {
  "level": 3,
  "text": "利润表是反映我们赚取了多少利润，包括销售收入、销售成本、费用等。",
  "uiIdx": "2.2",
  "range": "10519-10537",
  "chapterUid": 20
 },
 {
  "level": 2,
  "text": "现金流的计算",
  "uiIdx": "3",
  "range": "11455-11480",
  "chapterUid": 20
 },
 {
  "level": 3,
  "text": "现金流量表是反映我们的现金流入和流出的情况。",
  "uiIdx": "3.1",
  "range": "11455-11480",
  "chapterUid": 20
 },
 {
  "level": 3,
  "text": "现金净流量为现金流入减去现金流出。",
  "uiIdx": "3.2",
  "range": "18375-18384",
  "chapterUid": 20
 },
 {
  "level": 2,
  "text": "旅行车的购买与折旧",
  "uiIdx": "4",
  "range": "3352-3394",
  "chapterUid": 20
 },
 {
  "level": 3,
  "text": "旅行车是一项设备，应作为固定资产的一项在资产负债表中单独列示",
  "uiIdx": "4.1",
  "range": "3352-3394",
  "chapterUid": 20
 },
 {
  "level": 4,
  "text": "旅行车不是附着于场地的，它是可以移动的。",
  "uiIdx": "",
  "range": "2948-2958",
  "chapterUid": 20
 },
 {
  "level": 4,
  "text": "旅行车类似建筑物或厂房吗？不。",
  "uiIdx": "",
  "range": "3128-3141",
  "chapterUid": 20
 },
 {
  "level": 4,
  "text": "一项能够移动的固定资产被称做什么？设备。",
  "uiIdx": "",
  "range": "3194-3211",
  "chapterUid": 20
 },
 {
  "level": 3,
  "text": "采用双倍余额递减法对旅行车进行折旧",
  "uiIdx": "4.2",
  "range": "13047-13071",
  "chapterUid": 20
 },
 {
  "level": 4,
  "text": "第一年的折旧额是4美元。",
  "uiIdx": "",
  "range": "13071-13085",
  "chapterUid": 20
 },
 {
  "level": 4,
  "text": "折旧公式的关键在于折旧基数。",
  "uiIdx": "",
  "range": "14044-14058",
  "chapterUid": 20
 },
 {
  "level": 4,
  "text": "使用年限仍为10年。如果采用直线折旧法，若一项价值为16美元，使用年限为10年的资产，其折旧率是多少？每年1.6美元。在此基数上乘以2，得出双倍余额递减法下的折旧额为3.2美元。所以，第二年的折旧额为3.2美元。第三年的折旧基数是多少？12.8美元(16-3.2)，直线折旧法第三年的折旧额是多少？1.28美元。在此基数上乘以2，为2.56美元。你可以观察到该方法的规律。第四年的折旧额为2.04。如果我们画张图，可以看到存在这样的规律：第一年4美元，第二年3.20美元，第三年2.56美元，第四年2.04美元……依此下去，你会得到一条曲线，如图8-1所示。",
  "uiIdx": "",
  "range": "14044-14058",
  "chapterUid": 20
 },
 {
  "level": 2,
  "text": "所得税的影响",
  "uiIdx": "5",
  "range": "15386-15422",
  "chapterUid": 20
 },
 {
  "level": 3,
  "text": "所得税是一项负债，并非要支付它们",
  "uiIdx": "5.1",
  "range": "15386-15422",
  "chapterUid": 20
 },
 {
  "level": 4,
  "text": "本周的利润为12美元，所得税率为12%，因此计算得出应交所得税额是多少？3美元。",
  "uiIdx": "",
  "range": "15386-15422",
  "chapterUid": 20
 },
 {
  "level": 4,
  "text": "因而使盈利减至多少？9美元。",
  "uiIdx": "",
  "range": "15477-15487",
  "chapterUid": 20
 },
 {
  "level": 1,
  "text": "第9章 税金、清算",
  "uiIdx": "",
  "range": "",
  "chapterUid": 20
 },
 {
  "level": 2,
  "text": "税金的计算与缴纳",
  "uiIdx": "1",
  "range": "1173-1214",
  "chapterUid": 20
 },
 {
  "level": 3,
  "text": "根据税收的要求纠正资产负债表",
  "uiIdx": "1.1",
  "range": "1173-1214",
  "chapterUid": 20
 },
 {
  "level": 4,
  "text": "上周税前利润为12美元，留存收益为52美元，税前收益总额为64美元，所得税率为25%，应交税金为16美元。",
  "uiIdx": "",
  "range": "1173-1267",
  "chapterUid": 20
 },
 {
  "level": 3,
  "text": "完成新的资产负债表",
  "uiIdx": "1.2",
  "range": "2300-2317",
  "chapterUid": 20
 },
 {
  "level": 4,
  "text": "核销10美元的存货会影响所得税，重新计算税前利润和所得税。",
  "uiIdx": "",
  "range": "2300-2317",
  "chapterUid": 20
 },
 {
  "level": 2,
  "text": "存货计价方法",
  "uiIdx": "2",
  "range": "1740-1773",
  "chapterUid": 20
 },
 {
  "level": 3,
  "text": "先进入的却仍存在(FISH)的存货计价方法",
  "uiIdx": "2.1",
  "range": "1740-1773",
  "chapterUid": 20
 },
 {
  "level": 4,
  "text": "先购入的存货，仍然留存，这种情况何时会发生？当然是存货已经烂得没人要了。",
  "uiIdx": "",
  "range": "1786-1819",
  "chapterUid": 20
 },
 {
  "level": 3,
  "text": "对腐烂的柠檬进行核销",
  "uiIdx": "2.2",
  "range": "3354-3404",
  "chapterUid": 20
 },
 {
  "level": 4,
  "text": "扔掉腐烂的柠檬并在此刻从账面上核销它们，将它们的价值确认为一项损失。",
  "uiIdx": "",
  "range": "3354-3404",
  "chapterUid": 20
 },
 {
  "level": 2,
  "text": "资产负债表和利润表的编制",
  "uiIdx": "3",
  "range": "4871-4881",
  "chapterUid": 20
 },
 {
  "level": 3,
  "text": "资产负债表中的各项目及其计算方式",
  "uiIdx": "3.1",
  "range": "4871-4881",
  "chapterUid": 20
 },
 {
  "level": 4,
  "text": "我们欠供应商多少钱？32美元。请付清它们。",
  "uiIdx": "",
  "range": "4871-4881",
  "chapterUid": 20
 },
 {
  "level": 4,
  "text": "并支付所得税14美元。",
  "uiIdx": "",
  "range": "4943-4954",
  "chapterUid": 20
 },
 {
  "level": 4,
  "text": "还有16美元的应收账款尚未收回。",
  "uiIdx": "",
  "range": "4979-4995",
  "chapterUid": 20
 },
 {
  "level": 4,
  "text": "并且，将保险取消，因此收回了预付的2美元的保费。",
  "uiIdx": "",
  "range": "5020-5044",
  "chapterUid": 20
 },
 {
  "level": 3,
  "text": "利润表中的各项目及其计算方式",
  "uiIdx": "3.2",
  "range": "2760-2788",
  "chapterUid": 20
 },
 {
  "level": 4,
  "text": "在利润表中，如何对存货进行核销？你或许会说，“将它们费用化”。",
  "uiIdx": "",
  "range": "2744-2788",
  "chapterUid": 20
 },
 {
  "level": 4,
  "text": "本周的利润表中，商品销售成本会更高而毛利会降低。",
  "uiIdx": "",
  "range": "2976-3003",
  "chapterUid": 20
 },
 {
  "level": 2,
  "text": "存货的价值确定",
  "uiIdx": "4",
  "range": "4725-4763",
  "chapterUid": 20
 },
 {
  "level": 3,
  "text": "存货价值最难确定，需要寻求专家的帮助",
  "uiIdx": "4.1",
  "range": "4725-4763",
  "chapterUid": 20
 },
 {
  "level": 4,
  "text": "如果你打算购买或出售拥有存货类的公司，就需要寻找专家来帮助你确定它们的价值。",
  "uiIdx": "",
  "range": "4725-4763",
  "chapterUid": 20
 },
 {
  "level": 2,
  "text": "清算的准备与决策",
  "uiIdx": "5",
  "range": "5573-5595",
  "chapterUid": 20
 },
 {
  "level": 3,
  "text": "明年我们的财务状况会好转吗？或者说我们应该将摊位及移动售货车清算出去吗？这需要由你自己来做决定",
  "uiIdx": "5.1",
  "range": "5573-5595",
  "chapterUid": 20
 },
 {
  "level": 4,
  "text": "如果你打算明年夏天继续经营这个售货摊，你就继续持有他们。",
  "uiIdx": "",
  "range": "5658-5686",
  "chapterUid": 20
 },
 {
  "level": 4,
  "text": "如果你决心清算这个摊位及售货车，就需要找到一位买主，可能会比较困难。",
  "uiIdx": "",
  "range": "5734-5768",
