[
 {
  "level": 1,
  "text": "正文",
  "uiIdx": "",
  "range": "",
  "chapterUid": 2
 },
 {
  "level": 2,
  "text": "泰国深山中的迷幻乌托邦",
  "uiIdx": "1",
  "range": "915-943",
  "chapterUid": 2
 },
 {
  "level": 3,
  "text": "嬉皮士和文青在泰国深山寻找自由",
  "uiIdx": "1.1",
  "range": "915-943",
  "chapterUid": 2
 },
 {
  "level": 4,
  "text": "他们逃离身体或精神的痛苦，迈入与世隔绝的自由之地。",
  "uiIdx": "",
  "range": "915-943",
  "chapterUid": 2
 },
 {
  "level": 3,
  "text": "拜县是一个欧洲小镇的翻版，充满了欧美文化元素",
  "uiIdx": "1.2",
  "range": "2088-2144",
  "chapterUid": 2
 },
 {
  "level": 4,
  "text": "英文标识随处可见，鸡尾酒、爵士乐、各国风味的餐厅，宛如把一座欧洲小镇搬到了泰国。",
  "uiIdx": "",
  "range": "2088-2144",
  "chapterUid": 2
 },
 {
  "level": 4,
  "text": "最显眼的是大麻店，明目张胆摆出几十种口味，牌子上写着“有机大麻，99泰铢”。",
  "uiIdx": "",
  "range": "2144-2182",
  "chapterUid": 2
 },
 {
  "level": 2,
  "text": "拜县的生活",
  "uiIdx": "2",
  "range": "3807-3847",
  "chapterUid": 2
 },
 {
  "level": 3,
  "text": "拜县的生活成本低廉，外国人做小生意，多是为了打发时间或个人爱好。",
  "uiIdx": "2.1",
  "range": "3807-3847",
  "chapterUid": 2
 },
 {
  "level": 3,
  "text": "拜县是一个自由的乐土，人们在这里追求艺术、真理与自由",
  "uiIdx": "2.2",
  "range": "2353-2405",
  "chapterUid": 2
 },
 {
  "level": 4,
  "text": "每晚6点，摊贩们把三轮车从寺庙的院子里推出来，在街边摆摊。他们都是附近的农民，白天种地，晚上卖小吃。",
  "uiIdx": "",
  "range": "2353-2405",
  "chapterUid": 2
 },
 {
  "level": 4,
  "text": "空气中飘来大麻的焦糊味，在昏沉的迷醉中，万物开始失真，艺术、真理与自由似乎触手可及。",
  "uiIdx": "",
  "range": "6335-6400",
  "chapterUid": 2
 },
 {
  "level": 2,
  "text": "密窝村的故事",
  "uiIdx": "3",
  "range": "8411-8440",
  "chapterUid": 2
 },
 {
  "level": 3,
  "text": "密窝村是一个云南人的后裔村，房屋、饮食、生活习惯皆保留了云南特色",
  "uiIdx": "3.1",
  "range": "8411-8440",
  "chapterUid": 2
 },
 {
  "level": 4,
  "text": "村民热爱土地，任何一片坡度较缓的空地都被开垦种植，甚至路边都利用起来。",
  "uiIdx": "",
  "range": "10123-10158",
  "chapterUid": 2
 },
 {
  "level": 4,
  "text": "种得最多的是茶树，其次是瓜果蔬菜，各色野花随意点缀，黄白色野菊花、粉紫色凤仙花、橘红木槿、鹅黄桂树、各色铁线莲，墙根下、砖头缝里都能茁壮成长。",
  "uiIdx": "",
  "range": "10158-10229",
  "chapterUid": 2
 },
 {
  "level": 3,
  "text": "密窝村是一个与世隔绝的地方，只有一公里之外就是缅甸",
  "uiIdx": "3.2",
  "range": "13011-13047",
  "chapterUid": 2
 },
 {
  "level": 4,
  "text": "有条合法的道路有两条，非法的道路千百条。",
  "uiIdx": "",
  "range": "13343-13386",
  "chapterUid": 2
 },
 {
  "level": 4,
  "text": "山上很多野路都通往缅甸，现在还有人偷跑来做毒品生意，把缅甸的货卖往曼谷。",
  "uiIdx": "",
  "range": "13386-13430",
  "chapterUid": 2
 }
]