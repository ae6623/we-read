[
 {
  "level": 1,
  "text": "正文",
  "uiIdx": "",
  "range": "",
  "chapterUid": 2
 },
 {
  "level": 2,
  "text": "《以交易为生》这本书的理解",
  "uiIdx": "1",
  "range": "479-506",
  "chapterUid": 2
 },
 {
  "level": 3,
  "text": "《以交易为生》不是一本技术书，而是一本关于交易心理的书",
  "uiIdx": "1.1",
  "range": "479-506",
  "chapterUid": 2
 },
 {
  "level": 4,
  "text": "书中反复在讲一件事：你以为你在做决策，其实你不是一个人在做决策。",
  "uiIdx": "",
  "range": "2041-2096",
  "chapterUid": 2
 },
 {
  "level": 3,
  "text": "这本书最值钱的那部分，读者基本没翻",
  "uiIdx": "1.2",
  "range": "878-911",
  "chapterUid": 2
 },
 {
  "level": 4,
  "text": "书的前言写了他是精神科医生，这行字我当年看见了，没往心里去。",
  "uiIdx": "",
  "range": "1649-1703",
  "chapterUid": 2
 },
 {
  "level": 4,
  "text": "我当时觉得那是作者简介，跟正文没关系。",
  "uiIdx": "",
  "range": "1703-1722",
  "chapterUid": 2
 },
 {
  "level": 2,
  "text": "交易中的心理角色",
  "uiIdx": "2",
  "range": "2096-2154",
  "chapterUid": 2
 },
 {
  "level": 3,
  "text": "人心里装着好几个角色，各有各的打算，各有各的风险偏好",
  "uiIdx": "2.1",
  "range": "2096-2154",
  "chapterUid": 2
 },
 {
  "level": 4,
  "text": "一个是赌徒，这个角色要的是刺激，要的是这一把的输赢快感。",
  "uiIdx": "",
  "range": "2266-2305",
  "chapterUid": 2
 },
 {
  "level": 4,
  "text": "一个是保守派，它怕浮亏，更怕浮盈没了。",
  "uiIdx": "",
  "range": "2603-2615",
  "chapterUid": 2
 },
 {
  "level": 4,
  "text": "一个是受害者，止损刚被打掉，行情立刻回头；或者一波大趋势你眼看着它起步，你没赶上。",
  "uiIdx": "",
  "range": "2765-2799",
  "chapterUid": 2
 },
 {
  "level": 4,
  "text": "还有一是我要养的那个，它认规则，认资金管理，认长期期望，把小额止损当成做生意的成本。",
  "uiIdx": "",
  "range": "3108-3139",
  "chapterUid": 2
 },
 {
  "level": 2,
  "text": "如何辨认和应对这些心理角色",
  "uiIdx": "3",
  "range": "3294-3328",
  "chapterUid": 2
 },
 {
  "level": 3,
  "text": "看你在等，还是在赶，那个理性的角色是等出来的，它不着急",
  "uiIdx": "3.1",
  "range": "3294-3328",
  "chapterUid": 2
 },
 {
  "level": 4,
  "text": "赌徒那个角色偏爱在某些时候动手，一天里的某个时段、连亏之后或者刚赚完一笔大的。",
  "uiIdx": "",
  "range": "5834-5883",
  "chapterUid": 2
 },
 {
  "level": 4,
  "text": "保守派那个跟了我很多年。我做趋势，好容易等来一笔对的，赚了几十美金就平掉。",
  "uiIdx": "",
  "range": "3917-3977",
  "chapterUid": 2
 },
 {
  "level": 4,
  "text": "受害者那个我也有。砍完仓立刻反手，这种事我干过不止一次，理由都是“它明明要回去”。",
  "uiIdx": "",
  "range": "4321-4353",
  "chapterUid": 2
 },
 {
  "level": 3,
  "text": "让那个理性的角色强壮一点，再给它配上制度，让别的角色上台了也动不了账户",
  "uiIdx": "3.2",
  "range": "5114-5158",
  "chapterUid": 2
 },
 {
  "level": 4,
  "text": "养它这件事没有捷径，我能说的只有我干过的几样：每天开盘前把计划写在纸上，写到什么价位做什么动作，写完盘里不许改。",
  "uiIdx": "",
  "range": "5158-5237",
  "chapterUid": 2
 },
 {
  "level": 4,
  "text": "制度那部分更要紧，因为光靠养，它还是有被挤下去的时候。真正救命的是提前把路堵死：下单的时候止损一起挂进去，不给自己留‘到时候再看’的余地。",
  "uiIdx": "",
  "range": "5324-5416",
  "chapterUid": 2
 },
 {
  "level": 2,
  "text": "交易中的否认机制",
  "uiIdx": "4",
  "range": "6399-6442",
  "chapterUid": 2
 },
 {
  "level": 3,
  "text": "否认发生的时候，你一点都不觉得自己在骗自己，你觉得自己特别冷静、特别客观、特别讲道理",
  "uiIdx": "4.1",
  "range": "6399-6442",
  "chapterUid": 2
 },
 {
  "level": 4,
  "text": "人在不利的局面里，脑子不会停止工作，它会换一个雇主。它照样给你找信号、找支撑、找论据，只是方向调了个头。",
  "uiIdx": "",
  "range": "6874-6961",
  "chapterUid": 2
 },
 {
  "level": 4,
  "text": "你越聪明，这套东西做得越漂亮。",
  "uiIdx": "",
  "range": "6961-6976",
  "chapterUid": 2
 },
 {
  "level": 3,
  "text": "否认多半觉察得到，只是觉察到了不想认",
  "uiIdx": "4.2",
  "range": "7599-7634",
  "chapterUid": 2
 },
 {
  "level": 4,
  "text": "我那天下午写完五条理由，我心里其实有个声音在说：“你在找理由”，我听见了，我把它按回去了。",
  "uiIdx": "",
  "range": "7634-7679",
  "chapterUid": 2
 },
 {
  "level": 2,
  "text": "赚钱的许可",
  "uiIdx": "5",
  "range": "8827-8901",
  "chapterUid": 2
 },
 {
  "level": 3,
  "text": "很多人反复把利润还回去，骄傲只是表象，真正的原因是心里根本没给自己发过那张许可证",
  "uiIdx": "5.1",
  "range": "8827-8901",
  "chapterUid": 2
 },
 {
  "level": 4,
  "text": "你从小到大被教的那些东西，关于钱、关于“不该拿这么多”，早就埋进去了，等你真赚到一笔，那套东西就起来找你麻烦。",
  "uiIdx": "",
  "range": "8901-8956",
  "chapterUid": 2
 },
 {
  "level": 4,
  "text": "你以为你在交易，其实你在跟一个很老的念头打架。",
  "uiIdx": "",
  "range": "8956-8979",
  "chapterUid": 2
 },
 {
  "level": 3,
  "text": "这毛病后来是怎么松的，我说不太准",
  "uiIdx": "5.2",
  "range": "9382-9422",
  "chapterUid": 2
 },
 {
  "level": 4,
  "text": "我能把量降下来这件事，前后用了大半年。起因是有一阵连着顺，连着做对五六笔，其中一笔赚得比较可观。",
  "uiIdx": "",
  "range": "11918-11988",
  "chapterUid": 2
 },
 {
  "level": 4,
  "text": "顺完之后我把量一次加到位，不是一步步加的。结果两周多一点，连着亏了四笔，前面赚得吐回去一大截。",
  "uiIdx": "",
  "range": "11988-12035",
  "chapterUid": 2
 },
 {
  "level": 4,
  "text": "那四笔我回头一笔一笔对过，对到第三笔发现一个共同点：它们进场的时候，我脑子里都没有“错了怎么办”这个答案。",
  "uiIdx": "",
  "range": "12035-12088",
  "chapterUid": 2
 },
 {
  "level": 4,
  "text": "平时我进场前一定先想这个，那几笔我没想。",
  "uiIdx": "",
  "range": "12088-12108",
  "chapterUid": 2
 },
 {
  "level": 4,
  "text": "降量那半年难熬，因为顺手的时候你会觉得自己被捆住了。",
  "uiIdx": "",
  "range": "12108-12157",
  "chapterUid": 2
 },
 {
  "level": 4,
  "text": "我现在回头看，那半年是我这么多年里最值的一段时间。",
  "uiIdx": "",
  "range": "12157-12182",
  "chapterUid": 2
 },
 {
  "level": 4,
  "text": "降量还有个附带的好处：它是个不需要我承认自己状态不对的动作，我嘴上可以说我只是保守一点，不用承认我飘了。",
  "uiIdx": "",
  "range": "12182-12234",
  "chapterUid": 2
 },
 {
  "level": 2,
  "text": "三重屏幕的理解和应用",
  "uiIdx": "6",
  "range": "12580-12634",
  "chapterUid": 2
 },
 {
  "level": 3,
  "text": "三重屏幕的使用不是为了提高预测准确率，而是为了拖时间",
  "uiIdx": "6.1",
  "range": "12580-12634",
  "chapterUid": 2
 },
 {
  "level": 4,
  "text": "大周期定方向，这个我主要用来否决：周线上方向跟我不一致的，中周期再好看我也不进。",
  "uiIdx": "",
  "range": "12719-12782",
  "chapterUid": 2
 },
 {
  "level": 4,
  "text": "中周期找位置，小周期挑时机，这两层的作用是让我必须把多张图挨个看一遍，看完再决定。",
  "uiIdx": "",
  "range": "12825-12866",
  "chapterUid": 2
 },
 {
  "level": 4,
  "text": "这中间多出来的那几分钟，就是它对我最有用的地方。",
  "uiIdx": "",
  "range": "12866-12890",
  "chapterUid": 2
 },
 {
  "level": 3,
  "text": "技术指标的使用不是为了更好地看行情，而是为了让自己更方便地说服自己",
  "uiIdx": "6.2",
  "range": "13583-13648",
  "chapterUid": 2
 },
 {
  "level": 4,
  "text": "我早年在指标上花过不少时间，堆过一大堆，图上花花绿绿，看的时候觉得自己掌握了很多东西，后来一样一样往下砍，砍到现在常用的就那几样。",
  "uiIdx": "",
  "range": "13583-13648",
  "chapterUid": 2
 },
 {
  "level": 4,
  "text": "这个过程跟技术关系不大，跟注意力关系大：指标一多，我每张图都能找出支持自己想法的证据。",
  "uiIdx": "",
  "range": "13648-13691",
  "chapterUid": 2
 },
 {
  "level": 2,
  "text": "交易中的孤独感",
  "uiIdx": "7",
  "range": "13936-14005",
  "chapterUid": 2
 },
 {
  "level": 3,
  "text": "交易是件很孤独的事，需要自己独立做判断",
  "uiIdx": "7.1",
  "range": "13936-14005",
  "chapterUid": 2
 },
 {
  "level": 4,
  "text": "人在生活里做重大决定，习惯找人确认，找专家，找同行，找一圈人说‘我也这么看’，说完心里踏实。",
  "uiIdx": "",
  "range": "13936-14005",
  "chapterUid": 2
 },
 {
  "level": 4,
  "text": "交易不能这么干。你要是每笔都找人确认，久了你就不会自己下判断了，那个理性的角色会一直长不大，它永远是个需要别人点头才敢动的人。",
  "uiIdx": "",
  "range": "14013-14068",
  "chapterUid": 2
 },
 {
  "level": 3,
  "text": "孤独本身是有代价的，需要找到适合自己的应对方式",
  "uiIdx": "7.2",
  "range": "14068-14102",
  "chapterUid": 2
 },
 {
  "level": 4,
  "text": "一个人天天对着账户，涨了跌了没人说，久了会长出毛病。",
  "uiIdx": "",
  "range": "14102-14128",
  "chapterUid": 2
 },
 {
  "level": 4,
  "text": "我自己的处理挺笨：我很少在群里说话，有人问我对某段行情怎么看，我一般不说。",
  "uiIdx": "",
  "range": "14197-14257",
  "chapterUid": 2
 },
 {
  "level": 4,
  "text": "这个习惯我保持了十几年，代价是我在这行没什么热闹可看。别人在群里聊得热火朝天，我一条都不回，久了有人觉得我架子大。",
  "uiIdx": "",
  "range": "14300-14380",
  "chapterUid": 2
 }
]