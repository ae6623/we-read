[
 {
  "level": 1,
  "text": "引言 飞来横祸让我与行为经济学结下不解之缘",
  "uiIdx": "",
  "range": "",
  "chapterUid": 284
 },
 {
  "level": 2,
  "text": "作者的行为经济学研究背景",
  "uiIdx": "1",
  "range": "1602-1645",
  "chapterUid": 284
 },
 {
  "level": 3,
  "text": "作者因意外事故与行为经济学结缘",
  "uiIdx": "1.1",
  "range": "1602-1645",
  "chapterUid": 284
 },
 {
  "level": 4,
  "text": "作者在一次爆炸事故中全身70%的皮肤遭受三度烧伤。",
  "uiIdx": "",
  "range": "1602-1645",
  "chapterUid": 284
 },
 {
  "level": 4,
  "text": "在住院的三年时间里，作者开始观察曾经构成自己日常活动的各种行为。",
  "uiIdx": "",
  "range": "1744-1807",
  "chapterUid": 284
 },
 {
  "level": 3,
  "text": "作者对疼痛的研究",
  "uiIdx": "1.2",
  "range": "3788-3865",
  "chapterUid": 284
 },
 {
  "level": 4,
  "text": "作者在烧伤科进行了一系列实验，以寻找减轻疼痛的方法。",
  "uiIdx": "",
  "range": "3788-3865",
  "chapterUid": 284
 },
 {
  "level": 4,
  "text": "作者的实验结果表明，采取低密度疼痛治疗的方式，时间会长一些，但病人所感受到的痛苦程度比高密度短时间的做法要轻。",
  "uiIdx": "",
  "range": "4175-4234",
  "chapterUid": 284
 },
 {
  "level": 2,
  "text": "行为经济学的定义与传统经济学的区别",
  "uiIdx": "2",
  "range": "4832-4865",
  "chapterUid": 284
 },
 {
  "level": 3,
  "text": "行为经济学是从心理学和经济学的某些领域演化而来，研究我们行为背后的决策过程",
  "uiIdx": "2.1",
  "range": "4832-4865",
  "chapterUid": 284
 },
 {
  "level": 4,
  "text": "行为经济学引导我研究所有的一切，从我们不愿储蓄防老到性兴奋时的思维不清。",
  "uiIdx": "",
  "range": "4865-4935",
  "chapterUid": 284
 },
 {
  "level": 4,
  "text": "我们远远不像传统经济学理论所假定的那么理性，我们这些非理性行为并非无规律、无意识，而是成系统的。",
  "uiIdx": "",
  "range": "6394-6460",
  "chapterUid": 284
 },
 {
  "level": 3,
  "text": "传统经济学认为人们都是理性的，能对日常生活中面临的所有选择的价值进行计算和权衡",
  "uiIdx": "2.2",
  "range": "6178-6239",
  "chapterUid": 284
 },
 {
  "level": 4,
  "text": "一旦我们犯了错误，做了非理性的事情，传统经济学认为“市场的力量”会迅速把我们拉回正确理性的道路。",
  "uiIdx": "",
  "range": "6239-6299",
  "chapterUid": 284
 },
 {
  "level": 2,
  "text": "行为经济学的实验研究方法",
  "uiIdx": "3",
  "range": "6716-6811",
  "chapterUid": 284
 },
 {
  "level": 3,
  "text": "实验可以帮助我们把人类行为放慢，分解成一个一个的镜头，把每种力量单独提取出来，放大开来，仔细加以观察",
  "uiIdx": "3.1",
  "range": "6716-6811",
  "chapterUid": 284
 },
 {
  "level": 4,
  "text": "生活是复杂的，多种多样的力量同时向我们施加影响，这种复杂性使我们难以弄清楚到底是其中的何种力量、如何促成了我们的行动。",
  "uiIdx": "",
  "range": "6657-6716",
  "chapterUid": 284
 },
 {
  "level": 4,
  "text": "对于社会科学家而言，实验就好比显微镜和闪光灯。",
  "uiIdx": "",
  "range": "6716-6811",
  "chapterUid": 284
 },
 {
  "level": 3,
  "text": "实验结果受到具体环境的局限，但其价值也有局限性，应把实验结果推演到其他环境中，以描述它们的内涵可能与生活、工作、公共政策等方面的关联",
  "uiIdx": "3.2",
  "range": "6840-6877",
  "chapterUid": 284
 },
 {
  "level": 4,
  "text": "我希望你们这样来看待这些实验，即它们是对普遍原则的具体演示，提供了对我们思想和决定的深入洞察。",
  "uiIdx": "",
  "range": "6877-6963",
  "chapterUid": 284
 },
 {
  "level": 4,
  "text": "不仅是在某一特定的实验环境下，而是通过推断，洞察到生活中其他多种环境。",
  "uiIdx": "",
  "range": "6877-6963",
  "chapterUid": 284
 },
 {
  "level": 1,
  "text": "我们生活中的价格“诱饵”",
  "uiIdx": "",
  "range": "",
  "chapterUid": 286
 },
 {
  "level": 2,
  "text": "价格“诱饵”现象",
  "uiIdx": "1",
  "range": "1116-1149",
  "chapterUid": 286
 },
 {
  "level": 3,
  "text": "人们很少做不加对比的选择，而是关注物品与其他物品的相对优劣",
  "uiIdx": "1.1",
  "range": "1116-1149",
  "chapterUid": 286
 },
 {
  "level": 4,
  "text": "我们心里并没有一个“内部价值计量器”来告诉我们某种物品真正的价值是多少。",
  "uiIdx": "",
  "range": "1079-1116",
  "chapterUid": 286
 },
 {
  "level": 4,
  "text": "相反，我们关注的是这种物品与其他物品的相对优劣，以此来估算其价值。",
  "uiIdx": "",
  "range": "1116-1149",
  "chapterUid": 286
 },
 {
  "level": 3,
  "text": "营销人员通过提供不同的选择，影响消费者的选择",
  "uiIdx": "1.2",
  "range": "1790-1843",
  "chapterUid": 286
 },
 {
  "level": 4,
  "text": "《经济学人》杂志的营销人员给了我们一个不费脑筋的选择：与单订印刷版相比，印刷加电子版套餐看起来更划算。",
  "uiIdx": "",
  "range": "1790-1843",
  "chapterUid": 286
 },
 {
  "level": 4,
  "text": "电视机推销员山姆在对供展示的电视机进行分组时，和我们玩的也是同一类的把戏。",
  "uiIdx": "",
  "range": "1897-1938",
  "chapterUid": 286
 },
 {
  "level": 4,
  "text": "餐馆顾问格雷格·拉普了解到的一个现象是，菜单上主菜的高标价能给餐馆增加盈利——即使没有人来点。",
  "uiIdx": "",
  "range": "2536-2575",
  "chapterUid": 286
 },
 {
  "level": 2,
  "text": "价格“诱饵”的影响",
  "uiIdx": "2",
  "range": "354-366",
  "chapterUid": 286
 },
 {
  "level": 3,
  "text": "诱饵影响了消费者的选择，使选择套餐的人增多",
  "uiIdx": "2.1",
  "range": "2916-2946",
  "chapterUid": 286
 },
 {
  "level": 4,
  "text": "在麻省理工学院的斯隆商学院，我让100个学生做选择，结果是：单订电子版59美元：16人；单订印刷版125美元：0人；合订印刷加电子版套餐125美元：84人。",
  "uiIdx": "",
  "range": "2871-3087",
  "chapterUid": 286
 },
 {
  "level": 4,
  "text": "去掉了诱饵，他们的选择就不一样了，32人选择了套餐，68人选择了单订电子版。",
  "uiIdx": "",
  "range": "4273-4311",
  "chapterUid": 286
 },
 {
  "level": 3,
  "text": "诱饵的存在，使得原本不会选择高价位选项的人，选择了高价位选项",
  "uiIdx": "2.2",
  "range": "4233-4273",
  "chapterUid": 286
 },
 {
  "level": 4,
  "text": "就因为有个诱饵在那里，他们中的84人就选了125美元的套餐(16人单订电子版)。",
  "uiIdx": "",
  "range": "4233-4273",
  "chapterUid": 286
 },
 {
  "level": 1,
  "text": "巴黎和罗马，你选择去哪里度蜜月？",
  "uiIdx": "",
  "range": "",
  "chapterUid": 286
 },
 {
  "level": 2,
  "text": "相对论在决策中的应用",
  "uiIdx": "1",
  "range": "834-886",
  "chapterUid": 286
 },
 {
  "level": 3,
  "text": "我们总是靠观察周围的事物以确定彼此的关系",
  "uiIdx": "1.1",
  "range": "834-886",
  "chapterUid": 286
 },
 {
  "level": 4,
  "text": "我们无法不这样，不仅在对待有形物体，例如吐司面包、自行车、小狗、餐馆的主菜、配偶等时是这样，在对待无形的体验，例如度假和教育选择时是这样，甚至在对待短暂易变的事情，例如感情、态度、观点等时也是这样。",
  "uiIdx": "",
  "range": "886-985",
  "chapterUid": 286
 },
 {
  "level": 3,
  "text": "我们不但喜欢将事物与事物进行比较，而且喜欢比较容易比较的——避免比较不容易比较的事物",
  "uiIdx": "1.2",
  "range": "1383-1430",
  "chapterUid": 286
 },
 {
  "level": 4,
  "text": "假如你要到一座新城市买房子，你的房地产代理人带你看了三处房子，你都感兴趣。其中一幢是现代风格的，另两幢是殖民地风格的老式房子。三幢房子的价格差不多，都很合意；唯一的差别是老式房子中的一幢(“诱饵”)屋顶需要换，房主已经为此折价了几千美元作为补偿。你会选择哪一幢呢？你很可能既不选那幢现代风格的，也不选择那幢需要换屋顶的，而是选择另一幢老式房子。",
  "uiIdx": "",
  "range": "1459-1582",
  "chapterUid": 286
 },
 {
  "level": 2,
  "text": "诱饵效应在决策中的应用",
  "uiIdx": "2",
  "range": "2369-2430",
  "chapterUid": 286
 },
 {
  "level": 3,
  "text": "把–A(诱饵)放进来，建构出与A的一种简单、直观的比较关系，由此使A看起来较优",
  "uiIdx": "2.1",
  "range": "2369-2430",
  "chapterUid": 286
 },
 {
  "level": 4,
  "text": "在左边的图中，我们看到两种选择，每一种都在不同属性上优于另一种。选择A在属性1(我们假定是质量)方向较优。选择B在属性2(假定是价格)方向较优。很显然，这两种选择让人感到为难，不容易做出取舍。我们再考虑增加另一选择，–A(见右图)会怎样。这一选择很明显要比选择A差，但它同时又与A相似，两者容易比较，让我们以为A不仅比–A好，同时也比B好。",
  "uiIdx": "",
  "range": "2369-2430",
  "chapterUid": 286
 },
 {
  "level": 3,
  "text": "结果是，在把–A加到场景之中后，虽然根本没有人选择它，但它会使人们更可能最终选择A",
  "uiIdx": "2.2",
  "range": "2430-2472",
  "chapterUid": 286
 },
 {
  "level": 4,
  "text": "这种选择过程有点儿似曾相识吧？还记得《经济学人》杂志的那些推销员吗？他们知道我们自己并不清楚到底要订电子版还是印刷版。不过，他们料定在三个报价中，我们会选择印刷加电子版套餐。",
  "uiIdx": "",
  "range": "2501-2588",
  "chapterUid": 286
 },
 {
  "level": 2,
  "text": "诱饵效应在度蜜月选择中的应用",
  "uiIdx": "3",
  "range": "2773-2797",
  "chapterUid": 286
 },
 {
  "level": 3,
  "text": "对多数人来说，在罗马和巴黎之间做出选择不太容易",
  "uiIdx": "3.1",
  "range": "2773-2797",
  "chapterUid": 286
 },
 {
  "level": 4,
  "text": "罗马有古竞技场，巴黎有卢浮宫。两地都充满浪漫风情，都有诱人的美食、时尚的商店。难以选择。",
  "uiIdx": "",
  "range": "2797-2836",
  "chapterUid": 286
 },
 {
  "level": 3,
  "text": "再给你第三种选择：罗马，不含早餐(即–罗马，或诱饵)",
  "uiIdx": "3.2",
  "range": "2841-2871",
  "chapterUid": 286
 },
 {
  "level": 4,
  "text": "如果让你考虑这三种选择(巴黎、罗马、–罗马)，你会立即认识到，带免费早餐的罗马与带免费早餐的巴黎具有大致相同的吸引力，而不含早餐的罗马就等而下之了。与明显处于劣势的选择(–罗马)相比，罗马则更具优势。事实上，–罗马使带免费早餐的罗马显得如此之好，以至让你觉得它甚至胜过原先难以取舍的带免费早餐的巴黎。",
  "uiIdx": "",
  "range": "2841-3050",
  "chapterUid": 286
 },
 {
  "level": 1,
  "text": "三个人中，你想跟哪一个约会？",
  "uiIdx": "",
  "range": "",
  "chapterUid": 286
 },
 {
  "level": 2,
  "text": "诱饵效应在约会选择中的应用",
  "uiIdx": "1",
  "range": "1433-1481",
  "chapterUid": 286
 },
 {
  "level": 3,
  "text": "通过实验研究诱饵效应对约会选择的影响",
  "uiIdx": "1.1",
  "range": "1433-1481",
  "chapterUid": 286
 },
 {
  "level": 4,
  "text": "麻省理工学院的学生照片作为实验材料。",
  "uiIdx": "",
  "range": "1433-1481",
  "chapterUid": 286
 },
 {
  "level": 4,
  "text": "对照片进行特殊处理，制作出诱饵版本。",
  "uiIdx": "",
  "range": "958-987",
  "chapterUid": 286
 },
 {
  "level": 4,
  "text": "让学生对照片进行配对，选择最想约会的人。",
  "uiIdx": "",
  "range": "2664-2695",
  "chapterUid": 286
 },
 {
  "level": 3,
  "text": "诱饵效应使人们更倾向于选择与诱饵相似但明显优于诱饵的人",
  "uiIdx": "1.2",
  "range": "2557-2664",
  "chapterUid": 286
 },
 {
  "level": 4,
  "text": "参与者通常都更倾向于与“正常的”原版本照片里的人约会，而不去选择另一个照片未经过扭曲的人。",
  "uiIdx": "",
  "range": "2557-2664",
  "chapterUid": 286
 },
 {
  "level": 4,
  "text": "这样选择的可不是一半对一半，整个实验中这样选择的人占了75%。",
  "uiIdx": "",
  "range": "2664-2695",
  "chapterUid": 286
 },
 {
  "level": 1,
  "text": "富人嫉妒比自己更富有的人",
  "uiIdx": "",
  "range": "",
  "chapterUid": 286
 },
 {
  "level": 2,
  "text": "诱饵效应在生活中的应用",
  "uiIdx": "1",
  "range": "771-817",
  "chapterUid": 286
 },
 {
  "level": 3,
  "text": "通过推出新型号的面包机，使得销量开始上升",
  "uiIdx": "1.1",
  "range": "771-817",
  "chapterUid": 286
 },
 {
  "level": 4,
  "text": "消费者现在有了两个型号可以选择，他们会说：“嗯，我也许不大懂面包机，但我确实懂得，真要买的话，我宁愿少花点儿钱买那个小的。”。",
  "uiIdx": "",
  "range": "771-817",
  "chapterUid": 286
 },
 {
  "level": 3,
  "text": "在相亲晚会上，带上一个外观特点和你基本相似，但要比你稍稍差一点的朋友，可以吸引更多人的注意",
  "uiIdx": "1.2",
  "range": "929-982",
  "chapterUid": 286
 },
 {
  "level": 4,
  "text": "你那个作为诱饵的朋友就会把你提升许多，不单是与他(她)比较，而且从总体上与在场的其他人来比较，也是如此。",
  "uiIdx": "",
  "range": "1043-1109",
  "chapterUid": 286
 },
 {
  "level": 2,
  "text": "嫉妒心理的产生和影响",
  "uiIdx": "2",
  "range": "1393-1422",
  "chapterUid": 286
 },
 {
  "level": 3,
  "text": "当我们把自己生活中的运气与别人相比时，就产生了嫉妒和羡慕",
  "uiIdx": "2.1",
  "range": "1393-1422",
  "chapterUid": 286
 },
 {
  "level": 4,
  "text": "《圣经》十诫里的警告是非常有道理的：“不可贪恋他人的房屋，也不可贪恋他人的妻子、仆婢、牛驴，并他一切所有的。”。",
  "uiIdx": "",
  "range": "1451-1510",
  "chapterUid": 286
 },
 {
  "level": 3,
  "text": "高管薪酬的无节制增加已经给社会造成损害性后果",
  "uiIdx": "2.2",
  "range": "3249-3274",
  "chapterUid": 286
 },
 {
  "level": 4,
  "text": "高管工资的无度增长，非但不会使他们感到羞耻，还会鼓励其他高管进行攀比，再次要求加薪。",
  "uiIdx": "",
  "range": "3274-3316",
  "chapterUid": 286
 },
 {
  "level": 4,
  "text": "在互联网时代，“富人嫉妒的是比自己更富有的人”。",
  "uiIdx": "",
  "range": "3316-3356",
  "chapterUid": 286
 },
 {
  "level": 2,
  "text": "如何应对嫉妒心理",
  "uiIdx": "3",
  "range": "2906-2930",
  "chapterUid": 286
 },
 {
  "level": 3,
  "text": "最幸福的人并不在个人收入最高的国家里",
  "uiIdx": "3.1",
  "range": "2906-2930",
  "chapterUid": 286
 },
 {
  "level": 4,
  "text": "研究证明，工资多少与幸福程度的关联并不像人们想象的那么紧密。",
  "uiIdx": "",
  "range": "2854-2906",
  "chapterUid": 286
 },
 {
  "level": 3,
  "text": "一个人对工资是否满意，取决于他是否比他未来老婆的姐姐或妹妹的老公挣得多",
  "uiIdx": "3.2",
  "range": "2961-3039",
  "chapterUid": 286
 },
 {
  "level": 4,
  "text": "为什么要这样比？因为这种比较是明显而又现成的。",
  "uiIdx": "",
  "range": "3047-3097",
  "chapterUid": 286
 },
 {
  "level": 1,
  "text": "打破相对论的怪圈",
  "uiIdx": "",
  "range": "",
  "chapterUid": 286
 },
 {
  "level": 2,
  "text": "打破相对论的怪圈",
  "uiIdx": "1",
  "range": "354-362",
  "chapterUid": 286
 },
 {
  "level": 3,
  "text": "我们可以用相对的方法看待我们的决定，就近与现成的其他选择做比较",
  "uiIdx": "1.1",
  "range": "1161-1204",
  "chapterUid": 286
 },
 {
  "level": 4,
  "text": "两支钢笔的差价使价格较低的钢笔的相对优势远远高于另一支，这个明显的答案让我们决定多花15分钟节省7美元。",
  "uiIdx": "",
  "range": "1204-1256",
  "chapterUid": 286
 },
 {
  "level": 4,
  "text": "两套西装的差价使那套价格较低的西装的相对优势显得很小，我们就愿意多花那7美元。",
  "uiIdx": "",
  "range": "1256-1298",
  "chapterUid": 286
 },
 {
  "level": 3,
  "text": "从更广泛的角度来考虑，我们就会把这3 000美元用到比真皮座椅更合适的地方",
  "uiIdx": "1.2",
  "range": "1482-1526",
  "chapterUid": 286
 },
 {
  "level": 4,
  "text": "我们把它用来买书、买衣服，或者去度假，不是更好吗？",
  "uiIdx": "",
  "range": "1526-1551",
  "chapterUid": 286
 },
 {
  "level": 2,
  "text": "詹姆斯·洪的故事",
  "uiIdx": "2",
  "range": "1831-1864",
  "chapterUid": 286
 },
 {
  "level": 3,
  "text": "詹姆斯·洪懂得如何把自己生活中的比较圈子划得小一些，而不是大一些",
  "uiIdx": "2.1",
  "range": "1831-1864",
  "chapterUid": 286
 },
 {
  "level": 4,
  "text": "他是卖掉自己的保时捷Boxster跑车，换一辆丰田普锐斯做起的。",
  "uiIdx": "",
  "range": "1864-1897",
  "chapterUid": 286
 },
 {
  "level": 4,
  "text": "“我不想过开Boxster的生活。”。",
  "uiIdx": "",
  "range": "1926-1944",
  "chapterUid": 286
 },
 {
  "level": 4,
  "text": "“因为你有了Boxster，还会想保时捷911，那些开保时捷911的想什么呢？他们还想着法拉利。”。",
  "uiIdx": "",
  "range": "1944-1996",
  "chapterUid": 286
 },
 {
  "level": 1,
  "text": "黑珍珠如何从无人问津变为稀世珍宝？",
  "uiIdx": "",
  "range": "",
  "chapterUid": 292
 },
 {
  "level": 2,
  "text": "意大利钻石商人詹姆斯·阿萨尔的经历",
  "uiIdx": "1",
  "range": "401-438",
  "chapterUid": 292
 },
 {
  "level": 3,
  "text": "阿萨尔通过他在瑞士的关系，满足了美军的防水表需求",
  "uiIdx": "1.1",
  "range": "438-483",
  "chapterUid": 292
 },
 {
  "level": 4,
  "text": "“二战”结束，美军不再买防水表，阿萨尔和美国政府的生意也做到头了，还剩下几千块瑞士防水表库存。",
  "uiIdx": "",
  "range": "512-559",
  "chapterUid": 292
 },
 {
  "level": 3,
  "text": "阿萨尔教儿子做易货贸易——用瑞士防水表换日本珍珠",
  "uiIdx": "1.2",
  "range": "593-622",
  "chapterUid": 292
 },
 {
  "level": 4,
  "text": "生意很兴隆，没多长时间，他的儿子萨尔瓦多·阿萨尔就被人们称为“珍珠王”。",
  "uiIdx": "",
  "range": "622-658",
  "chapterUid": 292
 },
 {
  "level": 2,
  "text": "黑珍珠的发现及其困境",
  "uiIdx": "2",
  "range": "749-814",
  "chapterUid": 292
 },
 {
  "level": 3,
  "text": "布鲁耶说服萨尔瓦多合伙开发黑珍珠",
  "uiIdx": "2.1",
  "range": "749-814",
  "chapterUid": 292
 },
 {
  "level": 4,
  "text": "布鲁耶刚卖掉了他的空运公司，用这笔钱为自己和年轻的妻子塔希提在法属波利尼西亚买下了一座小岛。",
  "uiIdx": "",
  "range": "749-814",
  "chapterUid": 292
 },
 {
  "level": 4,
  "text": "布鲁耶对萨尔瓦多介绍说，当地莹碧的海水中盛产一种黑边牡蛎——珠母贝。这些黑边牡蛎的壳里出产一种罕见之宝——黑珍珠。",
  "uiIdx": "",
  "range": "814-871",
  "chapterUid": 292
 },
 {
  "level": 3,
  "text": "黑珍珠的色泽不佳，又灰又暗；大小也不行",
  "uiIdx": "2.2",
  "range": "959-984",
  "chapterUid": 292
 },
 {
  "level": 4,
  "text": "结果萨尔瓦多连一颗都没卖掉，无功而返，回到了波利尼西亚。",
  "uiIdx": "",
  "range": "984-1031",
  "chapterUid": 292
 },
 {
  "level": 2,
  "text": "黑珍珠的改造与推广",
  "uiIdx": "3",
  "range": "1101-1159",
  "chapterUid": 292
 },
 {
  "level": 3,
  "text": "萨尔瓦多努力改良出一些上好的品种",
  "uiIdx": "3.1",
  "range": "1101-1159",
  "chapterUid": 292
 },
 {
  "level": 4,
  "text": "他和他的工作人员努力改良出一些上好的品种，然后带着样品去见了一个老朋友——哈利·温斯顿，一位具有传奇色彩的宝石商人。",
  "uiIdx": "",
  "range": "1101-1159",
  "chapterUid": 292
 },
 {
  "level": 3,
  "text": "萨尔瓦多在数家影响力广泛、印刷华丽的杂志上连续登载了数版广告",
  "uiIdx": "3.2",
  "range": "1198-1232",
  "chapterUid": 292
 },
 {
  "level": 4,
  "text": "广告里，一串塔希提黑珍珠在钻石、红宝石、绿宝石的映衬下，熠熠生辉。",
  "uiIdx": "",
  "range": "1232-1265",
  "chapterUid": 292
 },
 {
  "level": 2,
  "text": "黑珍珠成为稀世珍宝的过程",
  "uiIdx": "4",
  "range": "1294-1373",
  "chapterUid": 292
 },
 {
  "level": 3,
  "text": "“珍珠王”捧成了稀世珍宝",
  "uiIdx": "4.1",
  "range": "1294-1373",
  "chapterUid": 292
 },
 {
  "level": 4,
  "text": "不久前还含在一个个黑边牡蛎壳里，吊在波利尼西亚海水中的绳子上，“养在深海人未识”的珍珠，如今来到了纽约城，环绕在最当红的歌剧女明星的粉颈上，在曼哈顿招摇过市。",
  "uiIdx": "",
  "range": "1294-1373",
  "chapterUid": 292
 },
 {
  "level": 3,
  "text": "让人们渴望做一件事，只需使做这件事的机会难以获得即可",
  "uiIdx": "4.2",
  "range": "1400-1481",
  "chapterUid": 292
 },
 {
  "level": 4,
  "text": "就像马克·吐温曾经在《汤姆·索亚历险记》中所描写的那样：“汤姆无意中发现了人类行为的一个重要定律，那就是要让人们渴望做一件事，只需使做这件事的机会难以获得即可。”。",
  "uiIdx": "",
  "range": "1400-1481",
  "chapterUid": 292
 },
 {
  "level": 1,
  "text": "“幼鹅效应”与“锚定”",
  "uiIdx": "",
  "range": "",
  "chapterUid": 292
 },
 {
  "level": 2,
  "text": "“幼鹅效应”与“锚定”现象",
  "uiIdx": "1",
  "range": "354-365",
  "chapterUid": 292
 },
 {
  "level": 3,
  "text": "幼鹅会根据它们出生时的初次发现来做决定，而且决定一经形成，就坚持不变",
  "uiIdx": "1.1",
  "range": "488-534",
  "chapterUid": 292
 },
 {
  "level": 4,
  "text": "洛伦茨在一次实验中发现，他无意中被刚出壳的幼鹅们第一眼看到，它们从此就一直紧跟着他直到长大。",
  "uiIdx": "",
  "range": "442-488",
  "chapterUid": 292
 },
 {
  "level": 3,
  "text": "我们的第一印象和决定也会成为印记，影响我们此后购买这一产品的出价意愿",
  "uiIdx": "1.2",
  "range": "580-598",
  "chapterUid": 292
 },
 {
  "level": 4,
  "text": "例如，萨尔瓦多从一开始就把他的珍珠与世界上最贵重的宝石“锚定”在一起，此后它的价格就一直紧跟宝石。",
  "uiIdx": "",
  "range": "765-814",
  "chapterUid": 292
 },
 {
  "level": 4,
  "text": "我们一旦以某一价格买了某一产品，我们也就为这一价格所“锚定”。",
  "uiIdx": "",
  "range": "814-848",
  "chapterUid": 292
 },
 {
  "level": 2,
  "text": "“任意的一致”现象",
  "uiIdx": "2",
  "range": "1473-1556",
  "chapterUid": 292
 },
 {
  "level": 3,
  "text": "尽管最初的价格是任意的，但一旦这些价格在我们头脑中确立，它们就能塑造我们目前和未来的价格理念",
  "uiIdx": "2.1",
  "range": "1473-1556",
  "chapterUid": 292
 },
 {
  "level": 4,
  "text": "学生中社会保险号后两位数字较大的(80~99)出价最高，那些后两位数字较小的(01~20)出价也最低。",
  "uiIdx": "",
  "range": "2867-2918",
  "chapterUid": 292
 },
 {
  "level": 4,
  "text": "一旦参与者愿意出价买某物，他们此后购买同类产品时就也会参照他第一次决定的出价(锚)做决定。",
  "uiIdx": "",
  "range": "3797-3849",
  "chapterUid": 292
 },
 {
  "level": 2,
  "text": "价格锚定的影响",
  "uiIdx": "3",
  "range": "4212-4245",
  "chapterUid": 292
 },
 {
  "level": 3,
  "text": "第一个锚不仅影响我们当时的购买决定，而且影响后来的许多决定",
  "uiIdx": "3.1",
  "range": "4212-4245",
  "chapterUid": 292
 },
 {
  "level": 4,
  "text": "一台57英寸液晶高分辨率电视机的促销价为3 000美元。这一标价并不是锚。假如我们决定出这个价买下它(或认真考虑要买)，那么这个价格从此就成了我们以后买液晶电视机的锚。",
  "uiIdx": "",
  "range": "4274-4305",
  "chapterUid": 292
 },
 {
  "level": 3,
  "text": "我们似乎习惯于某一特定的房价水平而不愿改变",
  "uiIdx": "3.2",
  "range": "4772-4794",
  "chapterUid": 292
 },
 {
  "level": 4,
  "text": "搬家到另一个城市的人购房时总是被原住城市的房价所锚定。",
  "uiIdx": "",
  "range": "4464-4532",
  "chapterUid": 292
 },
 {
  "level": 4,
  "text": "人们从物价水平低的地区(例如得克萨斯的卢博克)搬到中等水平城市(例如匹兹堡)时并不会随之增加消费以适应当地水平。",
  "uiIdx": "",
  "range": "4532-4598",
  "chapterUid": 292
 },
 {
  "level": 4,
  "text": "从高物价城市搬来的人也总倾向于花费和原居住城市相等的钱来买房子。",
  "uiIdx": "",
  "range": "4654-4689",
  "chapterUid": 292
 },
 {
  "level": 2,
  "text": "锚定的持续效应",
  "uiIdx": "4",
  "range": "7485-7535",
  "chapterUid": 292
 },
 {
  "level": 3,
  "text": "锚具有持续效应，对当前的价格是这样，对将来的价格也是如此",
  "uiIdx": "4.1",
  "range": "7485-7535",
  "chapterUid": 292
 },
 {
  "level": 4,
  "text": "尽管把两组人同样放到我们新提出的50美分面前，用新锚来吸引他们做回答(“假定给你50美分，你愿意再听一遍吗”)，在这一噪声类别中的第一个锚(对有的人来说是10美分，对有的人来说则是90美分)仍然占主导地位。",
  "uiIdx": "",
  "range": "7683-7712",
  "chapterUid": 292
 },
 {
  "level": 3,
  "text": "我们的初次决定对随后相当长一段时间里的决定会产生共振效应",
  "uiIdx": "4.2",
  "range": "8262-8291",
  "chapterUid": 292
 },
 {
  "level": 4,
  "text": "第一印象非常重要，不论是回忆起我们买的第一台DVD(数字通用光盘)机的价格比现在这类机器的价格贵得多(想到这一点，现在的这台就好像白送一样)，还是回想起汽油曾经只要每加仑1美元，都让人感到如今就像是在割自己的肉一样。",
  "uiIdx": "",
  "range": "8291-8482",
  "chapterUid": 292
 },
 {
  "level": 1,
  "text": "“羊群效应”与星巴克咖啡",
  "uiIdx": "",
  "range": "",
  "chapterUid": 292
 },
 {
  "level": 2,
  "text": "“羊群效应”的定义及两种形式",
  "uiIdx": "1",
  "range": "587-625",
  "chapterUid": 292
 },
 {
  "level": 3,
  "text": "“羊群效应”是基于其他人的行为来推断某事物的好坏，以决定我们是否仿效。",
  "uiIdx": "1.1",
  "range": "587-625",
  "chapterUid": 292
 },
 {
  "level": 3,
  "text": "“自我羊群效应”是我们基于自己先前的行为而推想某事物好或不好。",
  "uiIdx": "1.2",
  "range": "680-708",
  "chapterUid": 292
 },
 {
  "level": 2,
  "text": "星巴克咖啡如何利用“羊群效应”和“自我羊群效应”吸引顾客",
  "uiIdx": "2",
  "range": "354-366",
  "chapterUid": 292
 },
 {
  "level": 3,
  "text": "星巴克通过提供独特的咖啡体验和一系列横向排列的品种，吸引顾客尝试并形成习惯",
  "uiIdx": "2.1",
  "range": "2038-2088",
  "chapterUid": 292
 },
 {
  "level": 4,
  "text": "星巴克的设计给人一种大陆咖啡屋的印象，散发着烤咖啡豆的香味，销售别致的法式咖啡压榨机。",
  "uiIdx": "",
  "range": "1977-2088",
  "chapterUid": 292
 },
 {
  "level": 4,
  "text": "星巴克提供小杯、中杯、大杯和特大杯，还有各种名称高贵华丽的饮料，如美式咖啡、密斯朵牛奶咖啡、焦糖玛奇朵、星冰乐等。",
  "uiIdx": "",
  "range": "2127-2203",
  "chapterUid": 292
 },
 {
  "level": 3,
  "text": "星巴克通过顾客的亲身体验和口碑传播，强化其品牌形象和吸引力",
  "uiIdx": "2.2",
  "range": "708-755",
  "chapterUid": 292
 },
 {
  "level": 4,
  "text": "顾客在星巴克的第一次体验后，会形成自我羊群效应，倾向于再次光顾。",
  "uiIdx": "",
  "range": "708-755",
  "chapterUid": 292
 },
 {
  "level": 4,
  "text": "随着时间的推移，顾客在星巴克的消费水平逐渐提高，形成了稳定的消费习惯。",
  "uiIdx": "",
  "range": "1379-1420",
  "chapterUid": 292
 },
 {
  "level": 2,
  "text": "星巴克如何通过差异化策略摆脱价格锚定",
  "uiIdx": "3",
  "range": "2203-2295",
  "chapterUid": 292
 },
 {
  "level": 3,
  "text": "星巴克通过提供与众不同的体验，使顾客不再用邓肯甜甜圈店的价格作为锚来定位",
  "uiIdx": "3.1",
  "range": "2203-2295",
  "chapterUid": 292
 },
 {
  "level": 4,
  "text": "星巴克不遗余力地打造这一切，来营造一种与众不同的体验——这种不同是如此之大，甚至让我们不再用邓肯甜甜圈店的价格作为锚来定位。",
  "uiIdx": "",
  "range": "2203-2295",
  "chapterUid": 292
 },
 {
  "level": 3,
  "text": "星巴克的成功在很大程度上取决于其差异化策略",
  "uiIdx": "3.2",
  "range": "1824-1861",
  "chapterUid": 292
 },
 {
  "level": 4,
  "text": "如果我们从前被锚定在邓肯甜甜圈店，我们是如何把锚转移到星巴克的呢？真正有意思的也就在这里。",
  "uiIdx": "",
  "range": "1824-1873",
  "chapterUid": 292
 },
 {
  "level": 1,
  "text": "“任意的一致”与消费习惯",
  "uiIdx": "",
  "range": "",
  "chapterUid": 292
 },
 {
  "level": 2,
  "text": "“任意的一致”实验揭示的消费者心理",
  "uiIdx": "1",
  "range": "354-366",
  "chapterUid": 292
 },
 {
  "level": 3,
  "text": "汤姆·索亚通过把负面体验转变为正面体验，吸引了他的小伙伴。",
  "uiIdx": "1.1",
  "range": "715-770",
  "chapterUid": 292
 },
 {
  "level": 3,
  "text": "实验中，被要求回答是否愿意付钱听我朗诵的那些学生果然愿意出价，而那些被锚定我付钱请他们听朗诵的人果然向我开出了听我朗诵的价格",
  "uiIdx": "1.2",
  "range": "1889-1920",
  "chapterUid": 292
 },
 {
  "level": 4,
  "text": "被要求回答是否愿意付钱听我朗诵的那些学生的平均出价是：付我一美元左右听短诗朗诵，两美元左右听中等长度的，三美元左右听长篇的。",
  "uiIdx": "",
  "range": "1889-1920",
  "chapterUid": 292
 },
 {
  "level": 4,
  "text": "那些被锚定我付钱请他们听朗诵(而不是付钱给我)的人平均下来，他们要求收取1.3美元来听我的短诗朗诵，2.7美元听中等长度的，4.8美元来忍受长篇。",
  "uiIdx": "",
  "range": "2226-2432",
  "chapterUid": 292
 },
 {
  "level": 2,
  "text": "“任意的一致”对消费习惯的影响",
  "uiIdx": "2",
  "range": "354-366",
  "chapterUid": 292
 },
 {
  "level": 3,
  "text": "我们所做的许多决定，不论是不经意的还是经过深思熟虑的，锚都在其中起作用",
  "uiIdx": "2.1",
  "range": "3172-3288",
  "chapterUid": 292
 },
 {
  "level": 4,
  "text": "我们决定不买麦当劳巨无霸、抽烟、闯红灯、到巴塔哥尼亚度假、听柴可夫斯基的音乐、辛苦地准备博士论文、结婚、生孩子、住郊区、投共和党的票，诸如此类。",
  "uiIdx": "",
  "range": "3172-3288",
  "chapterUid": 292
 },
 {
  "level": 3,
  "text": "我们能从这些实验中获得哪些对一般生活有益的教训呢？我们自己仔细雕琢出的生活难道在很大程度上可能只是“任意的一致”的产物吗？",
  "uiIdx": "2.2",
  "range": "3355-3383",
  "chapterUid": 292
 },
 {
  "level": 4,
  "text": "我们在过去的某一时间做出了任意决定(如同幼鹅把洛伦茨当成它们的父母)，并且把我们以后的生活建立在这一基础上，我们想当然地认为最初的决定是明智的且一直遵守，有这种可能吗？",
  "uiIdx": "",
  "range": "3419-3503",
  "chapterUid": 292
 },
 {
  "level": 4,
  "text": "我们难道就是这样选择职业、配偶，决定穿什么衣服、做什么发型的吗？归根结底，这些决定都是明智的吗？或者它们中有一部分只是我们追随最初印记的一时冲动？",
  "uiIdx": "",
  "range": "3503-3576",
  "chapterUid": 292
 },
 {
  "level": 2,
  "text": "“任意的一致”对市场价格的影响",
  "uiIdx": "3",
  "range": "4704-4781",
  "chapterUid": 292
 },
 {
  "level": 3,
  "text": "消费者的购买意愿可以很容易地被操控，也就是说，消费者实际上并不能很好地把握自己的偏好，以及他们愿意为不同商品和体验付出的价格",
  "uiIdx": "3.1",
  "range": "4704-4781",
  "chapterUid": 292
 },
 {
  "level": 4,
  "text": "根据传统的经济学架构，消费者的购买意愿(需求)是决定市场价格的两大要素之一。",
  "uiIdx": "",
  "range": "4663-4704",
  "chapterUid": 292
 },
 {
  "level": 4,
  "text": "但是，如我们的实验所证明的：消费者的购买意愿可以很容易地被操控。",
  "uiIdx": "",
  "range": "4704-4781",
  "chapterUid": 292
 },
 {
  "level": 3,
  "text": "在现实世界中，锚来自厂家的建议零售价格、广告价格、促销、产品推介等因素——所有这一切都是供方变量",
  "uiIdx": "3.2",
  "range": "4879-4928",
  "chapterUid": 292
 },
 {
  "level": 4,
  "text": "因此，似乎不是消费者的购买意愿影响了市场价格，因果关系在此有些颠倒，而是市场价格本身反过来影响了消费者的购买意愿。",
  "uiIdx": "",
  "range": "4928-4985",
  "chapterUid": 292
 },
 {
  "level": 4,
  "text": "这表明事实上，需求并不是完全独立于供给。",
  "uiIdx": "",
  "range": "4985-5005",
  "chapterUid": 292
 },
 {
  "level": 3,
  "text": "我们对价格变化的敏感度，实际在很大程度上可能是两种因素共同作用的结果——我们对过去价格的记忆，以及我们想与过去决定保持一致的欲望，根本不是对我们真正偏好或需求大小的体现",
  "uiIdx": "3.3",
  "range": "5438-5527",
  "chapterUid": 292
 },
 {
  "level": 4,
  "text": "假设从明天起要实行两种新税，一种使酒价降低50%，另一种使奶价提高100%。",
  "uiIdx": "",
  "range": "5120-5158",
  "chapterUid": 292
 },
 {
  "level": 4,
  "text": "如果伴随新税而来的是人们对从前的奶价和酒价的遗忘，那会怎样？如果两种产品的价格同样变化，你却记不起这两种产品从前的价格了，那又会怎样？",
  "uiIdx": "",
  "range": "5208-5281",
  "chapterUid": 292
 },
 {
  "level": 1,
  "text": "自由市场与宏观调控",
  "uiIdx": "",
  "range": "",
  "chapterUid": 292
 },
 {
  "level": 2,
  "text": "价格变化对需求的影响",
  "uiIdx": "1",
  "range": "451-498",
  "chapterUid": 292
 },
 {
  "level": 3,
  "text": "价格变化后，人们会先与锚做对比，然后可能会减少消费，但长远来看，需求可能会恢复到加税前的水平",
  "uiIdx": "1.1",
  "range": "451-498",
  "chapterUid": 292
 },
 {
  "level": 4,
  "text": "一旦消费者适应了新价格，把锚做了调整，我们的汽油消费，在新的价格上，就有可能恢复到加税前的水平。",
  "uiIdx": "",
  "range": "498-572",
  "chapterUid": 292
 },
 {
  "level": 4,
  "text": "调整适应过程会随价格变化带来的其他变化而加快，例如新标号的汽油、新品种的燃油(如玉米乙醇燃油)等。",
  "uiIdx": "",
  "range": "572-637",
  "chapterUid": 292
 },
 {
  "level": 3,
  "text": "价格变化对需求的长期影响比我们仅依据价格提高所预测出的短期市场反应要小得多。",
  "uiIdx": "1.2",
  "range": "693-736",
  "chapterUid": 292
 },
 {
  "level": 2,
  "text": "“任意的一致”对自由市场的影响",
  "uiIdx": "2",
  "range": "911-981",
  "chapterUid": 292
 },
 {
  "level": 3,
  "text": "如果我们的选择经常受自己最初的锚的影响，我们的选择未必能准确反映我们从这些产品中获得的使用价值与快感",
  "uiIdx": "2.1",
  "range": "911-981",
  "chapterUid": 292
 },
 {
  "level": 4,
  "text": "在许多情况下，我们在市场上做出的决定可能反映不了我们对不同物品能够带给我们快感的多少。",
  "uiIdx": "",
  "range": "981-1028",
  "chapterUid": 292
 },
 {
  "level": 4,
  "text": "如果我们无法准确计算快感的价值，而仅仅跟在任意的锚后面走，就无法弄清交易是否能让我们受益。",
  "uiIdx": "",
  "range": "1028-1078",
  "chapterUid": 292
 },
 {
  "level": 3,
  "text": "如果我们无法依赖供给和需求这两股市场力量建立理想的市场价格，也不能指望自由市场的机制来帮助我们把使用价值最大化，那我们就需要另寻出路了",
  "uiIdx": "2.2",
  "range": "1258-1326",
  "chapterUid": 292
 },
 {
  "level": 4,
  "text": "对于社会基础问题，例如健康保险、水、电、教育，以及其他的重要资源，尤其如此。",
  "uiIdx": "",
  "range": "1326-1364",
  "chapterUid": 292
 },
 {
  "level": 4,
  "text": "如果你接受市场力量和自由市场并不能完全有效地调控市场这一前提，那你就认同了这样的观点，即政府(我们希望是理性的，考虑周到的政府)必须在宏观调控方面发挥更大作用，即使这样做会限制企业的自由经营。",
  "uiIdx": "",
  "range": "1364-1460",
  "chapterUid": 292
 },
 {
  "level": 1,
  "text": "“零”的历史与传奇",
  "uiIdx": "",
  "range": "",
  "chapterUid": 298
 },
 {
  "level": 2,
  "text": "“零”的历史与传奇",
  "uiIdx": "1",
  "range": "354-363",
  "chapterUid": 298
 },
 {
  "level": 3,
  "text": "“零”不仅仅是一种特别的价格表示法，它还能唤起热烈的情绪",
  "uiIdx": "1.1",
  "range": "597-642",
  "chapterUid": 298
 },
 {
  "level": 4,
  "text": "如果某商品从50美分打折到20美分，你会买吗？有可能。如果从50美分促销为免费呢，你会不会争着伸手去拿？肯定会！。",
  "uiIdx": "",
  "range": "642-665",
  "chapterUid": 298
 },
 {
  "level": 3,
  "text": "零成本竟然如此不可抗拒，这是怎么回事呢？为什么免费使我们如此高兴？",
  "uiIdx": "1.2",
  "range": "727-747",
  "chapterUid": 298
 },
 {
  "level": 4,
  "text": "免费有可能给我们带来麻烦：我们原来压根儿不想买的东西一旦免费了，就会变得难以置信地吸引人。",
  "uiIdx": "",
  "range": "760-809",
  "chapterUid": 298
 },
 {
  "level": 3,
  "text": "零的历史源远流长，但零的地位得到确认却是在公元498年",
  "uiIdx": "1.3",
  "range": "981-1067",
  "chapterUid": 298
 },
 {
  "level": 4,
  "text": "古巴比伦人发明了“零”的概念，古希腊人用高深的术语为它进行过辩论，古印度学者平噶拉把它与1相配得到了两位数，古玛雅人和古罗马人都把零作为数字系统的一部分。",
  "uiIdx": "",
  "range": "981-1067",
  "chapterUid": 298
 },
 {
  "level": 4,
  "text": "有一天，印度天文学家阿里亚哈塔从床上坐起来叫道：“Sthanam sthanam dasa gunam”(大约可以翻译成：“一位到另一位数值差10倍”)，由此产生了“十进制”概念。",
  "uiIdx": "",
  "range": "1067-1178",
  "chapterUid": 298
 },
 {
  "level": 3,
  "text": "零价格(也就是免费)有无限广阔的用途，它不仅可以用作价格折扣和促销手段，还可以帮助我们做出决策，为我们自身和社会造福。",
  "uiIdx": "1.4",
  "range": "1369-1433",
  "chapterUid": 298
 }
]