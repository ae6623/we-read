[
 {
  "level": 1,
  "text": "《长安的荔枝》序",
  "uiIdx": "",
  "range": "",
  "chapterUid": 11
 },
 {
  "level": 2,
  "text": "《长安的荔枝》序",
  "uiIdx": "1",
  "range": "338-346",
  "chapterUid": 11
 },
 {
  "level": 3,
  "text": "马伯庸先生的著作带来现象级效果，涉及文学、影视、旅游、地方文化建设等方方面面。",
  "uiIdx": "1.1",
  "range": "399-503",
  "chapterUid": 11
 },
 {
  "level": 3,
  "text": "马伯庸将历史熟稔与现实关怀结合，文笔直击人的内心",
  "uiIdx": "1.2",
  "range": "532-579",
  "chapterUid": 11
 },
 {
  "level": 4,
  "text": "写的是古人，却经常让我们看到自己。",
  "uiIdx": "",
  "range": "579-596",
  "chapterUid": 11
 },
 {
  "level": 3,
  "text": "《长安的荔枝》是一个古装版的职场小说，是一个职场“社畜”拼命上岸的故事",
  "uiIdx": "1.3",
  "range": "708-746",
  "chapterUid": 11
 },
 {
  "level": 4,
  "text": "李善德是一个苦哈哈的房奴，为了买房贷款，被中层领导拿捏，送上前往岭南的路途，完成不可能完成的任务。",
  "uiIdx": "",
  "range": "836-908",
  "chapterUid": 11
 },
 {
  "level": 3,
  "text": "小说的内核真实，直接洞察人性，围绕着复杂的唐代职官结构和行政运作机制展开",
  "uiIdx": "1.4",
  "range": "1003-1148",
  "chapterUid": 11
 },
 {
  "level": 4,
  "text": "各种利益的博弈、管理层内部的矛盾、职场的情商、不得已的违规，甚至还有不断修改需求的“甲方”。",
  "uiIdx": "",
  "range": "1148-1194",
  "chapterUid": 11
 },
 {
  "level": 3,
  "text": "小说中的精神能让人冲破一切阻滞，那就是豁出命去守护我们所珍视的东西",
  "uiIdx": "1.5",
  "range": "1275-1343",
  "chapterUid": 11
 },
 {
  "level": 4,
  "text": "李善德凭借这种精神，对得起职责，更对得起家人。",
  "uiIdx": "",
  "range": "1343-1368",
  "chapterUid": 11
 },
 {
  "level": 3,
  "text": "马亲王对各种历史背景及细节的深入了解和呈现，让作者甚为敬佩",
  "uiIdx": "1.6",
  "range": "1448-1491",
  "chapterUid": 11
 },
 {
  "level": 4,
  "text": "作者准备把多年前写的一篇关于贵妃荔枝来自岭南的小文修改成正式的论文。",
  "uiIdx": "",
  "range": "1579-1609",
  "chapterUid": 11
 },
 {
  "level": 1,
  "text": "文后说明",
  "uiIdx": "",
  "range": "",
  "chapterUid": 18
 },
 {
  "level": 2,
  "text": "周德文的经历与作者创作《长安的荔枝》的缘起",
  "uiIdx": "1",
  "range": "518-571",
  "chapterUid": 18
 },
 {
  "level": 3,
  "text": "周德文是歙县一户姓周的人家，被安排在大兴县，负责催办钱粮、勾当公事，去全国各地采购各种建筑材料，支援新京城建设",
  "uiIdx": "1.1",
  "range": "518-571",
  "chapterUid": 18
 },
 {
  "level": 4,
  "text": "周德文作为负责物资调度的基层小吏之一，因为太过劳碌，病死在了宛平县德胜关。",
  "uiIdx": "",
  "range": "673-710",
  "chapterUid": 18
 },
 {
  "level": 3,
  "text": "作者在阅读大量徽州文书时，看到周德文的经历，引发了他的创作灵感",
  "uiIdx": "1.2",
  "range": "397-432",
  "chapterUid": 18
 },
 {
  "level": 4,
  "text": "作者用周德文的视角去审视史书上每一件大事，发现上头一道命令，下面的人得忙活上半天，有大量琐碎的事务要处理。",
  "uiIdx": "",
  "range": "798-855",
  "chapterUid": 18
 },
 {
  "level": 2,
  "text": "《长安的荔枝》的创作过程与内容",
  "uiIdx": "2",
  "range": "1426-1469",
  "chapterUid": 18
 },
 {
  "level": 3,
  "text": "作者在2020年疫情期间，看了几部日本电影，决定把“一骑红尘妃子笑”用周德文式的视角解读一下",
  "uiIdx": "2.1",
  "range": "1426-1469",
  "chapterUid": 18
 },
 {
  "level": 4,
  "text": "作者的写作过程既不考虑知识的诅咒，也不顾虑读者感受，甚至不用考虑出版的事，想怎么写就怎么写。",
  "uiIdx": "",
  "range": "1498-1567",
  "chapterUid": 18
 },
 {
  "level": 3,
  "text": "《长安的荔枝》中，杨贵妃吃的荔枝到底从何处而来，历来有三种说法：岭南、福建，以及四川涪州",
  "uiIdx": "2.2",
  "range": "1943-1979",
  "chapterUid": 18
 },
 {
  "level": 4,
  "text": "作者在小说中采用了袁郊的《甘泽谣》中的说法，认为杨贵妃吃的荔枝来自岭南。",
  "uiIdx": "",
  "range": "1943-1979",
  "chapterUid": 18
 },
 {
  "level": 4,
  "text": "小说中关于岭南荔枝道的路线，是作者用鲍防的《杂感》和清代吴应逵《岭南荔枝谱》里提供的路线为参考，综合卫星地图研判而成。",
  "uiIdx": "",
  "range": "2302-2357",
  "chapterUid": 18
 },
 {
  "level": 4,
  "text": "小说中提到的诸多保鲜方式，其实皆取自从宋代到清代的各种记载。",
  "uiIdx": "",
  "range": "2357-2416",
  "chapterUid": 18
 },
 {
  "level": 3,
  "text": "小说的主角李善德，是作者从一本敦煌写经卷子的末尾名录里找到的",
  "uiIdx": "2.3",
  "range": "2475-2549",
  "chapterUid": 18
 },
 {
  "level": 4,
  "text": "李善德的职位差不多，名字风格也符合，索性拽他到天宝末年来客串。",
  "uiIdx": "",
  "range": "2475-2549",
  "chapterUid": 18
 },
 {
  "level": 2,
  "text": "《长安的荔枝》的创作感悟与感谢",
  "uiIdx": "3",
  "range": "1134-1154",
  "chapterUid": 18
 },
 {
  "level": 3,
  "text": "作者认为，千古艰难唯做事，一事功成万头秃，没有人能随随便便成功",
  "uiIdx": "3.1",
  "range": "1134-1154",
  "chapterUid": 18
 },
 {
  "level": 4,
  "text": "作者通过周德文的经历，揭示了历史背后无数基层办事员的辛苦。",
  "uiIdx": "",
  "range": "1255-1310",
  "chapterUid": 18
 },
 {
  "level": 3,
  "text": "作者特别感谢于赓哲老师、天冬、沙漠豪猪老师和赵辛民，以及下半枝半影同学",
  "uiIdx": "3.2",
  "range": "1624-1682",
  "chapterUid": 18
 },
 {
  "level": 4,
  "text": "于赓哲老师给作者指引了查找文献的方向和建议。",
  "uiIdx": "",
  "range": "1624-1682",
  "chapterUid": 18
 },
 {
  "level": 4,
  "text": "天冬、沙漠豪猪老师在博物学方面提供了专业意见。",
  "uiIdx": "",
  "range": "1624-1682",
  "chapterUid": 18
 },
 {
  "level": 4,
  "text": "赵辛民和下半枝半影同学在创作过程中给予了作者很大的支持和帮助。",
  "uiIdx": "",
  "range": "1854-1877",
  "chapterUid": 18
 },
 {
  "level": 1,
  "text": "第一章",
  "uiIdx": "",
  "range": "",
  "chapterUid": 18
 },
 {
  "level": 2,
  "text": "李善德买房的过程",
  "uiIdx": "1",
  "range": "978-1004",
  "chapterUid": 18
 },
 {
  "level": 3,
  "text": "李善德看中了一间位于长安城南边的宅子，决定购买",
  "uiIdx": "1.1",
  "range": "978-1004",
  "chapterUid": 18
 },
 {
  "level": 4,
  "text": "这间宅子只有一进大小，不算轩敞，但收拾得颇为整洁。",
  "uiIdx": "",
  "range": "978-1004",
  "chapterUid": 18
 },
 {
  "level": 4,
  "text": "院里还有一株高大的桂花树，尽管此时还是二月光景，可一看那伸展有致的枝丫，便知秋来的茂盛气象。",
  "uiIdx": "",
  "range": "1092-1138",
  "chapterUid": 18
 },
 {
  "level": 3,
  "text": "李善德与牙人商讨价格，最终决定购买",
  "uiIdx": "1.2",
  "range": "1346-1383",
  "chapterUid": 18
 },
 {
  "level": 4,
  "text": "牙人赔笑道：“李监事，这可是天宝四载的宅子，十年房龄，三百贯已是良心之极。”。",
  "uiIdx": "",
  "range": "1346-1383",
  "chapterUid": 18
 },
 {
  "level": 4,
  "text": "李善德一咬牙，算了，还是先顾夫人孩子吧，自己多辛苦点便是，谁让这是在长安城呢。",
  "uiIdx": "",
  "range": "1768-1813",
  "chapterUid": 18
 },
 {
  "level": 3,
  "text": "李善德通过招福寺的典座，以香积钱的方式购买了宅子",
  "uiIdx": "1.3",
  "range": "2290-2325",
  "chapterUid": 18
 },
 {
  "level": 4,
  "text": "李善德拿出两张借契，从头到尾细细读了一遍，当真是功德深厚，福报连绵。",
  "uiIdx": "",
  "range": "2290-2325",
  "chapterUid": 18
 },
 {
  "level": 4,
  "text": "李善德对典座道：“大师，契上明言这功德一共两百贯，月生福报四分，两年还讫，本利结算该是三百九十二贯，怎么写成了四百三十八贯？”。",
  "uiIdx": "",
  "range": "2325-2386",
  "chapterUid": 18
 },
 {
  "level": 4,
  "text": "典座支吾起来，讪讪说许是小沙弥抄错了本子。",
  "uiIdx": "",
  "range": "2520-2541",
  "chapterUid": 18
 },
 {
  "level": 4,
  "text": "李善德悠悠道：“咱们大唐杂律里有规定，凡有借贷，只取本金为计，不得回利为本——大师精通佛法，这计算方式怕是有差池吧？”。",
  "uiIdx": "",
  "range": "2461-2520",
  "chapterUid": 18
 },
 {
  "level": 4,
  "text": "典座掏出纸笔，就地改好，李善德查验无误后，在香积钱契上落了指印与签押。",
  "uiIdx": "",
  "range": "2708-2743",
  "chapterUid": 18
 },
 {
  "level": 2,
  "text": "李善德被任命为荔枝使",
  "uiIdx": "2",
  "range": "4042-4070",
  "chapterUid": 18
 },
 {
  "level": 3,
  "text": "李善德被上林署的同僚们公推为荔枝使",
  "uiIdx": "2.1",
  "range": "4042-4070",
  "chapterUid": 18
 },
 {
  "level": 4,
  "text": "刘署令笑眯眯道：“监事且吃，有桩好事，边吃边说与你听。”。",
  "uiIdx": "",
  "range": "4042-4070",
  "chapterUid": 18
 },
 {
  "level": 4,
  "text": "“也不是什么大事，内廷要采办些荔枝煎，此事非让老李你来勾当不可。”。",
  "uiIdx": "",
  "range": "4248-4297",
  "chapterUid": 18
 },
 {
  "level": 4,
  "text": "李善德做梦也没想到，上林署的同僚们如此讲义气，居然公推他来做这个荔枝使。",
  "uiIdx": "",
  "range": "4956-4992",
  "chapterUid": 18
 },
 {
  "level": 3,
  "text": "李善德对成为荔枝使感到困惑",
  "uiIdx": "2.2",
  "range": "4475-4524",
  "chapterUid": 18
 },
 {
  "level": 4,
  "text": "李善德一看到“敕令”二字，眉头一挑，这意味着是圣人直接下的指示，既喜又疑：“这是让下官勾当此事？”。",
  "uiIdx": "",
  "range": "4475-4524",
  "chapterUid": 18
 },
 {
  "level": 4,
  "text": "李善德心里高兴，长袖一摆，一饮而尽。他酒量其实一般，一杯下肚，已有点醺醺然。",
  "uiIdx": "",
  "range": "4210-4248",
  "chapterUid": 18
 },
 {
  "level": 4,
  "text": "这时刘署令从苇席下取出一轴文牒：“也不是什么大事，内廷发来的一份空白敕牒，说欲置荔枝使一员，采办岭南特贡荔枝煎十斤，着人勾当差遣，不过填名之处还是空白。”。",
  "uiIdx": "",
  "range": "4248-4297",
  "chapterUid": 18
 },
 {
  "level": 2,
  "text": "李善德发现敕牒上的错误",
  "uiIdx": "3",
  "range": "8430-8476",
  "chapterUid": 18
 },
 {
  "level": 3,
  "text": "李善德发现敕牒上的贴黄错误",
  "uiIdx": "3.1",
  "range": "8430-8476",
  "chapterUid": 18
 },
 {
  "level": 4,
  "text": "李善德在醉意中签下文书，第二天发现贴黄掉了，敕牒上的“鲜”字被贴成了“煎”字。",
  "uiIdx": "",
  "range": "8430-8476",
  "chapterUid": 18
 },
 {
  "level": 4,
  "text": "李善德意识到，这么大的便宜，别人凭什么白白给你？说不定是因为时间苛刻，难以办理。",
  "uiIdx": "",
  "range": "6132-6165",
  "chapterUid": 18
 },
 {
  "level": 3,
  "text": "李善德确认敕牒上的错误",
  "uiIdx": "3.2",
  "range": "9493-9520",
  "chapterUid": 18
 },
 {
  "level": 4,
  "text": "李善德找到司农寺的甲库，确认了敕牒上的错误。",
  "uiIdx": "",
  "range": "9493-9520",
  "chapterUid": 18
 },
 {
  "level": 4,
  "text": "李善德意识到，从一开始，圣人想要的，就是六月一日吃到岭南的荔枝。",
  "uiIdx": "",
  "range": "10434-10459",
  "chapterUid": 18
 },
 {
  "level": 2,
  "text": "李善德的困境与选择",
  "uiIdx": "4",
  "range": "10529-10572",
  "chapterUid": 18
 },
 {
  "level": 3,
  "text": "李善德面临无法完成的任务",
  "uiIdx": "4.1",
  "range": "10529-10572",
  "chapterUid": 18
 },
 {
  "level": 4,
  "text": "荔枝三日便会变质，就算有日行千里的龙驹，也绝无可能从五千里外的岭南把新鲜荔枝运到长安。",
  "uiIdx": "",
  "range": "10529-10572",
  "chapterUid": 18
 },
 {
  "level": 4,
  "text": "李善德被坑了，谁让他恰好在这一天告假去看房，众人一合议，把不在场的人给公推出来。",
  "uiIdx": "",
  "range": "10829-10862",
  "chapterUid": 18
 },
 {
  "level": 3,
  "text": "李善德的选择",
  "uiIdx": "4.2",
  "range": "16082-16129",
  "chapterUid": 18
 },
 {
  "level": 4,
  "text": "李善德可以趁这最后四个月横行一下，多捞些油水，尽量把香积贷偿清，好歹能给孤女寡妇留下一所宅子。",
  "uiIdx": "",
  "range": "16082-16129",
  "chapterUid": 18
 },
 {
  "level": 4,
  "text": "李善德决定去岭南走过一趟，看看是否真的无法完成这个任务。",
  "uiIdx": "",
  "range": "16992-17025",
  "chapterUid": 18
 },
 {
  "level": 1,
  "text": "第二章",
  "uiIdx": "",
  "range": "",
  "chapterUid": 18
 },
 {
  "level": 2,
  "text": "李善德出发前的准备",
  "uiIdx": "1",
  "range": "1267-1292",
  "chapterUid": 18
 },
 {
  "level": 3,
  "text": "李善德决定出发去岭南，韩洄向他面授机宜",
  "uiIdx": "1.1",
  "range": "1267-1292",
  "chapterUid": 18
 },
 {
  "level": 4,
  "text": "李善德转天又去了上林署，一改唯唯诺诺的态度，让刘署令准备三十贯的驿使钱与出食钱。",
  "uiIdx": "",
  "range": "1292-1332",
  "chapterUid": 18
 },
 {
  "level": 3,
  "text": "李善德利用流程上的漏洞，赚了三十贯",
  "uiIdx": "1.2",
  "range": "2095-2121",
  "chapterUid": 18
 },
 {
  "level": 4,
  "text": "李善德用这些钱购买了一匹行脚马和一些旅途用品，余下的全数留给家人。",
  "uiIdx": "",
  "range": "1968-2001",
  "chapterUid": 18
 },
 {
  "level": 2,
  "text": "李善德的行程",
  "uiIdx": "2",
  "range": "2473-2553",
  "chapterUid": 18
 },
 {
  "level": 3,
  "text": "李善德从长安出发，经过蓝田入商州道，经襄州跨汉水，经鄂州跨江水，顺流至洪州、吉州、虔州，越五岭，穿梅关而至韶州，再到广州",
  "uiIdx": "2.1",
  "range": "2473-2553",
  "chapterUid": 18
 },
 {
  "level": 4,
  "text": "李善德在途中研究职方司的资料和沿途地势、里程，希望从中找到机会。",
  "uiIdx": "",
  "range": "2967-3039",
  "chapterUid": 18
 },
 {
  "level": 3,
  "text": "李善德抵达广州，发现运送新鲜荔枝绝无可能",
  "uiIdx": "2.2",
  "range": "4335-4357",
  "chapterUid": 18
 },
 {
  "level": 4,
  "text": "李善德一算速度，他原本的那点侥幸登时灰飞烟灭。按这种走法，再快三倍，运送新鲜荔枝也不可能。",
  "uiIdx": "",
  "range": "4315-4357",
  "chapterUid": 18
 },
 {
  "level": 2,
  "text": "李善德的计划",
  "uiIdx": "3",
  "range": "21807-21833",
  "chapterUid": 18
 },
 {
  "level": 3,
  "text": "李善德计划利用峒人的三月红和催熟之术，将荔枝提前催熟",
  "uiIdx": "3.1",
  "range": "21807-21833",
  "chapterUid": 18
 },
 {
  "level": 4,
  "text": "阿僮告诉他，有一种圆房之术。趁荔枝尚青的时候摘下来，以芭蕉为公，荔枝为母，混放埋进米缸里，可以提前数日成熟。",
  "uiIdx": "",
  "range": "17499-17539",
  "chapterUid": 18
 },
 {
  "level": 3,
  "text": "李善德计划将催熟后的荔枝通过四条路线运送到长安",
  "uiIdx": "3.2",
  "range": "20673-20702",
  "chapterUid": 18
 },
 {
  "level": 4,
  "text": "第一支走梅关道，走虔州、鄂州、随州，与李善德来时的路一致。",
  "uiIdx": "",
  "range": "20673-20702",
  "chapterUid": 18
 },
 {
  "level": 4,
  "text": "第二支走西京道，这是一条东汉时修建的古道，自乳源至郴州、衡州、潭州而至江陵，是直线距离最近的一条。",
  "uiIdx": "",
  "range": "20702-20751",
  "chapterUid": 18
 },
 {
  "level": 4,
  "text": "第三支也走梅关道，但过江之后，直线北进至宿州，加入大唐的江淮漕运路线，沿汴河、黄河、洛水至京城。",
  "uiIdx": "",
  "range": "20751-20799",
  "chapterUid": 18
 },
 {
  "level": 4,
  "text": "第四支则直接登舟，由珠江入溱水、浈水，过梅关而入赣水，至长江上溯至汉水、襄州，再转陆运走商州道。",
  "uiIdx": "",
  "range": "20799-20847",
  "chapterUid": 18
 },
 {
  "level": 2,
  "text": "李善德的挑战与决心",
  "uiIdx": "4",
  "range": "21884-21904",
  "chapterUid": 18
 },
 {
  "level": 3,
  "text": "李善德面临时间、金钱和成功的巨大挑战",
  "uiIdx": "4.1",
  "range": "21884-21904",
  "chapterUid": 18
 },
 {
  "level": 4,
  "text": "李善德最大的敌人，是时间。这个试验，必须携带荔枝，随时观察其状态。",
  "uiIdx": "",
  "range": "21873-21904",
  "chapterUid": 18
 },
 {
  "level": 4,
  "text": "李善德原本的想法，是请经略府来提供资助。可惜何节帅袖手旁观，他也只能铤而走险，选择与胡商合作。",
  "uiIdx": "",
  "range": "21321-21370",
  "chapterUid": 18
 },
 {
  "level": 3,
  "text": "李善德决心拼死一搏，即使失败，也要知道自己的极限",
  "uiIdx": "4.2",
  "range": "22220-22244",
  "chapterUid": 18
 },
 {
  "level": 4,
  "text": "李善德长长吐出一口气，仿佛要吐出胸口所有的块垒。那疲惫到极点的神情，反让他眉宇间挤出一丝坚毅。",
  "uiIdx": "",
  "range": "22220-22267",
  "chapterUid": 18
 },
 {
  "level": 4,
  "text": "“就算失败，我也想知道，自己倒在距离终点多远的地方。”。",
  "uiIdx": "",
  "range": "22296-22323",
  "chapterUid": 18
 },
 {
  "level": 1,
  "text": "第三章",
  "uiIdx": "",
  "range": "",
  "chapterUid": 18
 },
 {
  "level": 2,
  "text": "李善德发明脚程格眼",
  "uiIdx": "1",
  "range": "1180-1193",
  "chapterUid": 18
 },
 {
  "level": 3,
  "text": "李善德为了掌握荔枝的保鲜情况，发明了脚程格眼",
  "uiIdx": "1.1",
  "range": "1246-1275",
  "chapterUid": 18
 },
 {
  "level": 4,
  "text": "李善德在广州一收到消息，立刻按里程远近，用四色笔填入格眼。",
  "uiIdx": "",
  "range": "1246-1275",
  "chapterUid": 18
 },
 {
  "level": 4,
  "text": "黑圈为不变，赭点为色变，紫点为香变，朱点为味变，墨点为流汁。",
  "uiIdx": "",
  "range": "1275-1305",
  "chapterUid": 18
 },
 {
  "level": 2,
  "text": "荔枝转运的困境",
  "uiIdx": "2",
  "range": "1598-1634",
  "chapterUid": 18
 },
 {
  "level": 3,
  "text": "李善德在运输荔枝的过程中遇到了一系列问题",
  "uiIdx": "2.1",
  "range": "1598-1634",
  "chapterUid": 18
 },
 {
  "level": 4,
  "text": "在出发后第四日下午，他们冲到了浔阳口，可惜还没来得及入江，荔枝便已变味。",
  "uiIdx": "",
  "range": "1598-1634",
  "chapterUid": 18
 },
 {
  "level": 4,
  "text": "从虔州至万安一段，有一段“十八险滩”，江中怪石如精铁，突兀嶙峋，错峙波面。过往船只无不小心翼翼，往往要半天之久方能过去。",
  "uiIdx": "",
  "range": "1717-1802",
  "chapterUid": 18
 },
 {
  "level": 4,
  "text": "即使避开这一段，未来也甚为可虑。之前李善德测算过，他从鄂州入江，顺流直下，可以日行一百里。但如果按这条路线返回，则必须溯流逆行，只能日行五十里，这还是赶上风头好的时候。",
  "uiIdx": "",
  "range": "1831-1918",
  "chapterUid": 18
 },
 {
  "level": 2,
  "text": "李善德的解决方案",
  "uiIdx": "3",
  "range": "22406-22445",
  "chapterUid": 18
 },
 {
  "level": 3,
  "text": "李善德提出了一个创新的解决方案——分枝植瓮之法",
  "uiIdx": "3.1",
  "range": "22406-22445",
  "chapterUid": 18
 },
 {
  "level": 4,
  "text": "李善德事先请了一批熟峒佣工，从过壳的荔枝树枝条上切下去，截下约莫三尺长的分杈。尾端斜切，露出一半茎脉，直接扎入瓮中。",
  "uiIdx": "",
  "range": "22406-22464",
  "chapterUid": 18
 },
 {
  "level": 4,
  "text": "在分杈的上端，伸出三条细枝，上面挂着约莫二十枚半青荔枝。",
  "uiIdx": "",
  "range": "22493-22521",
  "chapterUid": 18
 },
 {
  "level": 4,
  "text": "李善德还苦心孤诣请了石门山里的生峒，用上好的麻藤编了五个罩筐，从上面套住树冠。",
  "uiIdx": "",
  "range": "22521-22560",
  "chapterUid": 18
 },
 {
  "level": 2,
  "text": "李善德的试验结果",
  "uiIdx": "4",
  "range": "13783-13803",
  "chapterUid": 18
 },
 {
  "level": 3,
  "text": "李善德的试验结果并不理想，但他并未放弃，决定再次尝试",
  "uiIdx": "4.1",
  "range": "13783-13803",
  "chapterUid": 18
 },
 {
  "level": 4,
  "text": "第一次试验，荔枝进入味变期的时间，延长了半日；而两路马队完成的里程，比上次多了两百里。",
  "uiIdx": "",
  "range": "13766-13803",
  "chapterUid": 18
 },
 {
  "level": 4,
  "text": "第二次试验，结果比上一次好一些。荔枝进入味变期的时间，延长了半日；而两路马队完成的里程，比上次多了两百里。",
  "uiIdx": "",
  "range": "13751-13803",
  "chapterUid": 18
 },
 {
  "level": 4,
  "text": "第三次试验，李善德决定随马队出发，亲自验证他的方案。",
  "uiIdx": "",
  "range": "21893-21921",
  "chapterUid": 18
 },
 {
  "level": 1,
  "text": "第四章",
  "uiIdx": "",
  "range": "",
  "chapterUid": 18
 },
 {
  "level": 2,
  "text": "李善德押运荔枝的路线和遭遇",
  "uiIdx": "1",
  "range": "1165-1204",
  "chapterUid": 18
 },
 {
  "level": 3,
  "text": "李善德带领试验马队沿着天开路朝南安县赶去",
  "uiIdx": "1.1",
  "range": "1165-1204",
  "chapterUid": 18
 },
 {
  "level": 4,
  "text": "天开路附近，带“坑”字的地名颇多，诸如黄山坑、邓坑、禾连坑、花坑等等。",
  "uiIdx": "",
  "range": "1253-1288",
  "chapterUid": 18
 },
 {
  "level": 3,
  "text": "李善德在铁罗坑遇到林邑奴，得知赵辛民的追杀计划",
  "uiIdx": "1.2",
  "range": "2018-2046",
  "chapterUid": 18
 },
 {
  "level": 4,
  "text": "林邑奴一改在广州时的呆傻笨拙，动作极为迅捷，真如猿猱一般。",
  "uiIdx": "",
  "range": "2018-2046",
  "chapterUid": 18
 },
 {
  "level": 4,
  "text": "林邑奴告诉李善德，赵辛民计划派兵追杀他。",
  "uiIdx": "",
  "range": "2625-2648",
  "chapterUid": 18
 },
 {
  "level": 2,
  "text": "李善德设计的荔枝转运之法",
  "uiIdx": "2",
  "range": "10445-10471",
  "chapterUid": 18
 },
 {
  "level": 3,
  "text": "李善德对路线进行了微调，选择了更快的转运路线",
  "uiIdx": "2.1",
  "range": "5714-5743",
  "chapterUid": 18
 },
 {
  "level": 4,
  "text": "转运队出发时走梅关道，但在抵达吉州之后，将不再继续北上抚州、洪州，而转向西北方向，直奔潭州，转到西京道。",
  "uiIdx": "",
  "range": "5743-5795",
  "chapterUid": 18
 },
 {
  "level": 4,
  "text": "马队会从潭州西北方向的昌江县穿过，弃马登船，循汨罗江进抵洞庭湖，并横渡长江。",
  "uiIdx": "",
  "range": "5861-5899",
  "chapterUid": 18
 },
 {
  "level": 4,
  "text": "渡过之后，再沿汉水、襄河、丹河辗转至商州。",
  "uiIdx": "",
  "range": "5899-5920",
  "chapterUid": 18
 },
 {
  "level": 3,
  "text": "李善德提出了荔枝转运的具体措施，包括取冰镇之、用竹箨封藏等",
  "uiIdx": "2.2",
  "range": "7289-7324",
  "chapterUid": 18
 },
 {
  "level": 4,
  "text": "如果等枝条枯萎之后，立刻摘下荔枝，放入短竹筒内，再放入瓮中，效果更好。",
  "uiIdx": "",
  "range": "7289-7324",
  "chapterUid": 18
 },
 {
  "level": 4,
  "text": "荔枝保鲜最有效的法子，是取冰镇之。可惜岭南炎热无冰，只能用双层瓮灌溪水的方式来做冷却。",
  "uiIdx": "",
  "range": "7583-7626",
  "chapterUid": 18
 },
 {
  "level": 2,
  "text": "李善德在朝廷中的遭遇",
  "uiIdx": "3",
  "range": "15921-15970",
  "chapterUid": 18
 },
 {
  "level": 3,
  "text": "李善德在户部、户房、太府寺和兵部遭到了冷遇",
  "uiIdx": "3.1",
  "range": "15921-15970",
  "chapterUid": 18
 },
 {
  "level": 4,
  "text": "户部郎中老主事对李善德的荔枝转运之法表示怀疑。",
  "uiIdx": "",
  "range": "14619-14639",
  "chapterUid": 18
 },
 {
  "level": 4,
  "text": "户房令史建议李善德去找太府寺，但左藏署和兵部驾部郎中均表示无法帮忙。",
  "uiIdx": "",
  "range": "13110-13150",
  "chapterUid": 18
 },
 {
  "level": 3,
  "text": "李善德在宫市副使鱼朝恩的帮助下，才让事情有了转机",
  "uiIdx": "3.2",
  "range": "13588-13627",
  "chapterUid": 18
 },
 {
  "level": 4,
  "text": "鱼朝恩表示愿意帮助李善德解决转运费用的问题。",
  "uiIdx": "",
  "range": "14354-14390",
  "chapterUid": 18
 },
 {
  "level": 4,
  "text": "鱼朝恩建议李善德将转运法交给宫市副使，自己回去仔细揣摩。",
  "uiIdx": "",
  "range": "13656-13678",
  "chapterUid": 18
 },
 {
  "level": 2,
  "text": "李善德的困境与对策",
  "uiIdx": "4",
  "range": "18817-18842",
  "chapterUid": 18
 },
 {
  "level": 3,
  "text": "李善德被韩洄提醒，意识到自己的失误，但为时已晚",
  "uiIdx": "4.1",
  "range": "18817-18842",
  "chapterUid": 18
 },
 {
  "level": 4,
  "text": "韩洄告诉李善德，鱼朝恩可能会抢他的功劳。",
  "uiIdx": "",
  "range": "15263-15296",
  "chapterUid": 18
 },
 {
  "level": 4,
  "text": "韩洄建议李善德在呈上转运法之时，附上一份谢表，说明此事有岭南五府经略使着力推动，度支司同人大力支持，太府寺、司农寺、尚食局助力良多。",
  "uiIdx": "",
  "range": "16479-16561",
  "chapterUid": 18
 },
 {
  "level": 3,
  "text": "李善德决定去招福寺，希望能找到解决问题的方法",
  "uiIdx": "4.2",
  "range": "17467-17501",
  "chapterUid": 18
 },
 {
  "level": 4,
  "text": "李善德收到一个神秘的名刺，指示他去招福寺。",
  "uiIdx": "",
  "range": "17824-17845",
  "chapterUid": 18
 },
 {
  "level": 4,
  "text": "李善德猜测这个名刺可能与他的问题有关，因此决定去招福寺看看。",
  "uiIdx": "",
  "range": "17467-17501",
  "chapterUid": 18
 },
 {
  "level": 1,
  "text": "第五章",
  "uiIdx": "",
  "range": "",
  "chapterUid": 18
 },
 {
  "level": 2,
  "text": "李善德与杨国忠的会面",
  "uiIdx": "1",
  "range": "1654-1682",
  "chapterUid": 18
 },
 {
  "level": 3,
  "text": "李善德被杨国忠召见，却不知其用意",
  "uiIdx": "1.1",
  "range": "1654-1682",
  "chapterUid": 18
 },
 {
  "level": 4,
  "text": "李善德在招福寺遇到杨国忠，杨国忠询问他找自己何事。",
  "uiIdx": "",
  "range": "1654-1682",
  "chapterUid": 18
 },
 {
  "level": 4,
  "text": "李善德惊慌地抬起头，不知该如何回答。",
  "uiIdx": "",
  "range": "1744-1754",
  "chapterUid": 18
 },
 {
  "level": 3,
  "text": "李善德提出自己的计划，希望得到杨国忠的支持",
  "uiIdx": "1.2",
  "range": "2101-2139",
  "chapterUid": 18
 },
 {
  "level": 4,
  "text": "李善德说他有一计，可让岭南新鲜荔枝及时运抵长安。",
  "uiIdx": "",
  "range": "2101-2139",
  "chapterUid": 18
 },
 {
  "level": 4,
  "text": "杨国忠对李善德的计划感兴趣，决定给他一次机会。",
  "uiIdx": "",
  "range": "5108-5126",
  "chapterUid": 18
 },
 {
  "level": 2,
  "text": "李善德的转运计划",
  "uiIdx": "2",
  "range": "2256-2291",
  "chapterUid": 18
 },
 {
  "level": 3,
  "text": "李善德提出借用招福寺的影壁，用来题壁抒情",
  "uiIdx": "2.1",
  "range": "2256-2291",
  "chapterUid": 18
 },
 {
  "level": 4,
  "text": "李善德环顾左右，看到宝塔旁边的竹林边缘，是一面刚粉刷雪白的影壁，眼睛一亮。",
  "uiIdx": "",
  "range": "2256-2291",
  "chapterUid": 18
 },
 {
  "level": 4,
  "text": "李善德向住持借用了影壁，用来讲解他的转运计划。",
  "uiIdx": "",
  "range": "2467-2479",
  "chapterUid": 18
 },
 {
  "level": 3,
  "text": "李善德详细讲解了他的转运计划，包括荔枝转运的现状与困难，以及对策",
  "uiIdx": "2.2",
  "range": "2938-3010",
  "chapterUid": 18
 },
 {
  "level": 4,
  "text": "李善德以词头为纲要，侃侃而谈，先谈荔枝转运的现状与困难，再一一摆出对策，配合三次试验详细解说，最后延伸开来，每一项措施所涉衙署、成本核算与转运程限。",
  "uiIdx": "",
  "range": "2938-3010",
  "chapterUid": 18
 },
 {
  "level": 4,
  "text": "李善德说得兴奋，只是苦了招福寺的和尚，李善德每说一段，便喊换一块新的白板来。",
  "uiIdx": "",
  "range": "3072-3108",
  "chapterUid": 18
 },
 {
  "level": 2,
  "text": "李善德与苏谅的冲突",
  "uiIdx": "3",
  "range": "10848-10880",
  "chapterUid": 18
 },
 {
  "level": 3,
  "text": "苏谅对李善德提出的要求感到不满，认为李善德背叛了他",
  "uiIdx": "3.1",
  "range": "10848-10880",
  "chapterUid": 18
 },
 {
  "level": 4,
  "text": "苏谅认为李善德在困顿之时，是小老不吝援手，出资襄助，方才有了今日的局面。",
  "uiIdx": "",
  "range": "10848-10880",
  "chapterUid": 18
 },
 {
  "level": 4,
  "text": "苏谅认为李善德富贵之后，便忘记贫贱之交了。",
  "uiIdx": "",
  "range": "10880-10899",
  "chapterUid": 18
 },
 {
  "level": 3,
  "text": "李善德试图向苏谅解释，但苏谅不接受",
  "uiIdx": "3.2",
  "range": "10578-10624",
  "chapterUid": 18
 },
 {
  "level": 4,
  "text": "李善德举起杯子，掩饰着自己的尴尬，半天方答道：“报效之事，暂且不劳苏老费心，朝廷另有安排。”。",
  "uiIdx": "",
  "range": "10578-10624",
  "chapterUid": 18
 },
 {
  "level": 4,
  "text": "苏谅冷笑起来：“明年？明年你是不是荔枝使还不知道呢！你立了大功，拍拍屁股升官去了，倒拿这些话来敷衍！”。",
  "uiIdx": "",
  "range": "11633-11684",
  "chapterUid": 18
 },
 {
  "level": 2,
  "text": "李善德的困境与决策",
  "uiIdx": "4",
  "range": "16941-16979",
  "chapterUid": 18
 },
 {
  "level": 3,
  "text": "李善德面临双层瓮短缺的问题，感到焦虑不安",
  "uiIdx": "4.1",
  "range": "16941-16979",
  "chapterUid": 18
 },
 {
  "level": 4,
  "text": "李善德在拟订计划时，为了节省费用，没有安排工坊烧制双层瓮，打算直接从苏谅那里采购。",
  "uiIdx": "",
  "range": "16941-16979",
  "chapterUid": 18
 },
 {
  "level": 4,
  "text": "苏谅的船队听到风声，昨天连夜拔锚离港了，把所有的存货都带走了。",
  "uiIdx": "",
  "range": "16588-16664",
  "chapterUid": 18
 },
 {
  "level": 3,
  "text": "李善德决定亲自提前检查路线，排除隐患",
  "uiIdx": "4.2",
  "range": "18499-18535",
  "chapterUid": 18
 },
 {
  "level": 4,
  "text": "李善德意识到，自己不能等到十九日和荔枝转运队一起出发。",
  "uiIdx": "",
  "range": "18499-18535",
  "chapterUid": 18
 },
 {
  "level": 4,
  "text": "他得提前把驿路走一遍，清查所有的隐患。",
  "uiIdx": "",
  "range": "18535-18579",
  "chapterUid": 18
 },
 {
  "level": 2,
  "text": "阿僮的困境与反抗",
  "uiIdx": "5",
  "range": "18874-18899",
  "chapterUid": 18
 },
 {
  "level": 3,
  "text": "阿僮的荔枝园被经略府士兵砍伐，感到绝望和愤怒",
  "uiIdx": "5.1",
  "range": "18874-18899",
  "chapterUid": 18
 },
 {
  "level": 4,
  "text": "阿僮和很多峒人则被拦在外圈，惊恐而愤怒地叫喊着。",
  "uiIdx": "",
  "range": "18874-18899",
  "chapterUid": 18
 },
 {
  "level": 4,
  "text": "阿僮发现自己的声带几乎麻痹了，连带着麻痹的，还有那颗衰老疲惫的心脏。",
  "uiIdx": "",
  "range": "20703-20745",
  "chapterUid": 18
 },
 {
  "level": 3,
  "text": "阿僮试图反抗，但最终被压制",
  "uiIdx": "5.2",
  "range": "21570-21613",
  "chapterUid": 18
 },
 {
  "level": 4,
  "text": "阿僮从腰间抽出割荔枝的短刀，朝着旁边一个指挥的小吏刺过去。",
  "uiIdx": "",
  "range": "21570-21613",
  "chapterUid": 18
 },
 {
  "level": 4,
  "text": "小吏猝不及防，被她一下捅到了大腿，惊恐地跌倒惨叫起来。其他人一拥而上，把阿僮死死压在地上。",
  "uiIdx": "",
  "range": "21642-21687",
  "chapterUid": 18
 },
 {
  "level": 1,
  "text": "第六章",
  "uiIdx": "",
  "range": "",
  "chapterUid": 18
 },
 {
  "level": 2,
  "text": "李善德的荔枝转运之旅",
  "uiIdx": "1",
  "range": "1180-1218",
  "chapterUid": 18
 },
 {
  "level": 3,
  "text": "李善德为了完成荔枝转运的任务，不顾一切地努力工作",
  "uiIdx": "1.1",
  "range": "1180-1218",
  "chapterUid": 18
 },
 {
  "level": 4,
  "text": "他每到一处驿站，会第一时间按照章程进行检查，细致、严格、无情，而且绝无通融。",
  "uiIdx": "",
  "range": "1180-1218",
  "chapterUid": 18
 },
 {
  "level": 4,
  "text": "待检查事毕，他会立刻跨上马，前往下一处目标。",
  "uiIdx": "",
  "range": "1218-1240",
  "chapterUid": 18
 },
 {
  "level": 4,
  "text": "他对自己比对驿站更加苛刻，连休息的时间都没有留出，永远是在赶路，经常在马背上晃着晃着昏睡过去，一下摔落在地。待得清醒过来，他会继续上马疾行。",
  "uiIdx": "",
  "range": "1240-1310",
  "chapterUid": 18
 },
 {
  "level": 3,
  "text": "李善德在转运过程中遇到了各种困难，但他始终坚持下去",
  "uiIdx": "1.2",
  "range": "2834-2871",
  "chapterUid": 18
 },
 {
  "level": 4,
  "text": "黄草驿发生逃驿，他在山中寻找村落，征调也罢，购买也罢，弄几匹马过来。",
  "uiIdx": "",
  "range": "2834-2934",
  "chapterUid": 18
 },
 {
  "level": 4,
  "text": "他在夜下陌生山岭，穿行于极茂密的灌木与绿林中，复杂多变的山势被这些藤萝遮住了危险，导致他数次因为脚下失误而一口气滚落数十尺，并因此摔伤了右脚脚踝，浑身的血口子更是无数。",
  "uiIdx": "",
  "range": "4385-4469",
  "chapterUid": 18
 },
 {
  "level": 4,
  "text": "他在绝望和疲惫的交迫之下，李善德的潜意识接管了身体的控制权，强行让他进入睡眠。",
  "uiIdx": "",
  "range": "5478-5516",
  "chapterUid": 18
 },
 {
  "level": 2,
  "text": "李善德与杨国忠的冲突",
  "uiIdx": "2",
  "range": "12879-12930",
  "chapterUid": 18
 },
 {
  "level": 3,
  "text": "李善德对杨国忠的荔枝转运计划提出质疑，认为其耗费巨大，且牺牲了太多",
  "uiIdx": "2.1",
  "range": "12879-12930",
  "chapterUid": 18
 },
 {
  "level": 4,
  "text": "李善德算了一笔账，荔枝转运路程四千六百里，所涉水陆驿站总计一百五十三处，每驿月均用度四十贯，半年计有三万六千七百二十贯。",
  "uiIdx": "",
  "range": "12879-12930",
  "chapterUid": 18
 },
 {
  "level": 4,
  "text": "每站附户按四十计，一共有六千一百二十户，丁口约万人，荔枝钱总有两万贯上下。合计五万六千七百二十贯。",
  "uiIdx": "",
  "range": "12879-12980",
  "chapterUid": 18
 },
 {
  "level": 4,
  "text": "本次荔枝转运，总计花费三万一千零二十贯，尚有两万五千七百贯结余。",
  "uiIdx": "",
  "range": "13054-13094",
  "chapterUid": 18
 },
 {
  "level": 3,
  "text": "杨国忠对李善德的质疑感到愤怒，认为他在指责自己的决策",
  "uiIdx": "2.2",
  "range": "11902-11924",
  "chapterUid": 18
 },
 {
  "level": 4,
  "text": "杨国忠冷笑了一声，真是改不了的穷酸命。",
  "uiIdx": "",
  "range": "11902-11924",
  "chapterUid": 18
 },
 {
  "level": 4,
  "text": "杨国忠挥起月杖，狠狠砸在了李善德的头上，登时打出一道深深的血痕。",
  "uiIdx": "",
  "range": "14710-14742",
  "chapterUid": 18
 },
 {
  "level": 2,
  "text": "李善德的结局",
  "uiIdx": "3",
  "range": "21370-21414",
  "chapterUid": 18
 },
 {
  "level": 3,
  "text": "李善德因得罪杨国忠而被判处长流岭南",
  "uiIdx": "3.1",
  "range": "21370-21414",
  "chapterUid": 18
 },
 {
  "level": 4,
  "text": "朝廷宣布了对他的判决：“贪赃上林署公廨本钱三十贯，杖二十，全家长流岭南。”。",
  "uiIdx": "",
  "range": "21370-21414",
  "chapterUid": 18
 },
 {
  "level": 3,
  "text": "李善德在岭南的生活",
  "uiIdx": "3.2",
  "range": "24115-24172",
  "chapterUid": 18
 },
 {
  "level": 4,
  "text": "李善德在石门山下选了一块地，挽起袖子从一个刀笔吏变成一个荔枝老农，照料阿僮的果园，顺便补种荔枝树赎罪。",
  "uiIdx": "",
  "range": "24115-24172",
  "chapterUid": 18
 },
 {
  "level": 4,
  "text": "李善德一家，就这样彻底告别长安城的似锦繁华，来到了岭南。",
  "uiIdx": "",
  "range": "21678-21700",
  "chapterUid": 18
 }
]