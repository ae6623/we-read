[
 {
  "level": 1,
  "text": "一",
  "uiIdx": "",
  "range": "",
  "chapterUid": 3
 },
 {
  "level": 2,
  "text": "左小龙的摩托车之旅",
  "uiIdx": "1",
  "range": "421-457",
  "chapterUid": 3
 },
 {
  "level": 3,
  "text": "左小龙骑着摩托车绕着亭林镇开了三圈，因为这个下午没有任何事情可以做",
  "uiIdx": "1.1",
  "range": "421-457",
  "chapterUid": 3
 },
 {
  "level": 4,
  "text": "昨天他听说燃油将要涨价，便在加油站加满了汽油，今天一看，涨价的是柴油，心情就有些郁闷。",
  "uiIdx": "",
  "range": "457-500",
  "chapterUid": 3
 },
 {
  "level": 3,
  "text": "左小龙的摩托车是他新买来的，花费了自己几乎所有的积蓄",
  "uiIdx": "1.2",
  "range": "632-659",
  "chapterUid": 3
 },
 {
  "level": 4,
  "text": "这意味着不能摔车，因为没钱维修。",
  "uiIdx": "",
  "range": "659-675",
  "chapterUid": 3
 },
 {
  "level": 2,
  "text": "亭林镇的修车铺",
  "uiIdx": "2",
  "range": "1154-1184",
  "chapterUid": 3
 },
 {
  "level": 3,
  "text": "左小龙发现路边新开了一个修车铺，决定去调整一下他的摩托车",
  "uiIdx": "2.1",
  "range": "1154-1184",
  "chapterUid": 3
 },
 {
  "level": 4,
  "text": "修理工把摩托车推进了屋子，发动以后闻了闻味道，说：没问题啊。我骑一下。",
  "uiIdx": "",
  "range": "1725-1755",
  "chapterUid": 3
 },
 {
  "level": 4,
  "text": "修理工上车以后笨拙地在屋子里掉了个头，左小龙生怕他在自己的修车铺里就撞了。",
  "uiIdx": "",
  "range": "1887-1924",
  "chapterUid": 3
 },
 {
  "level": 4,
  "text": "修理工出了铺子以后就是一大脚油门，前轮离地一米高。左小龙看得没有想法，只以为对方在骑马。",
  "uiIdx": "",
  "range": "1970-2014",
  "chapterUid": 3
 },
 {
  "level": 4,
  "text": "修理工就这么抬着前轮开了五十米，缓缓将前轮放下，开到了左小龙的面前，说：我知道原因了，是后轮胎压太低了，所以你觉得车有点慢。",
  "uiIdx": "",
  "range": "2014-2076",
  "chapterUid": 3
 },
 {
  "level": 4,
  "text": "我帮你把轮胎压力调整一点就好了，但也不能打得太多，到了夏天胎压会升高得很快，容易爆胎。",
  "uiIdx": "",
  "range": "2076-2119",
  "chapterUid": 3
 },
 {
  "level": 2,
  "text": "雕塑园的生活",
  "uiIdx": "3",
  "range": "2490-2532",
  "chapterUid": 3
 },
 {
  "level": 3,
  "text": "左小龙是苟延残喘的开发商指定的看守者，而他的朋友大帅是当地开发办请来看这个雕塑园的",
  "uiIdx": "3.1",
  "range": "2490-2532",
  "chapterUid": 3
 },
 {
  "level": 4,
  "text": "雕塑园大到快一望无际，长满了各种各样的植物，很多海鸥一般奇怪的大鸟经常从园子最中央草木最盛处扑腾而起，飞往二十公里外的海边，有些都快长成老鹰般大小。",
  "uiIdx": "",
  "range": "2605-2679",
  "chapterUid": 3
 },
 {
  "level": 4,
  "text": "雕塑园里还有各种各样的动物，野兔、野狗、野鸡、野鸭都在这里被他们两人发现过。",
  "uiIdx": "",
  "range": "2821-2859",
  "chapterUid": 3
 },
 {
  "level": 3,
  "text": "左小龙和泥巴在雕塑园里发现了野猪和野猫",
  "uiIdx": "3.2",
  "range": "2972-2994",
  "chapterUid": 3
 },
 {
  "level": 4,
  "text": "大帅就没有那么幸运，他基本上看见的都是野猫。",
  "uiIdx": "",
  "range": "2972-2994",
  "chapterUid": 3
 },
 {
  "level": 4,
  "text": "不管怎么样，这个地方确实很野。",
  "uiIdx": "",
  "range": "2994-3009",
  "chapterUid": 3
 },
 {
  "level": 2,
  "text": "泥巴的纯情与等待",
  "uiIdx": "4",
  "range": "3383-3413",
  "chapterUid": 3
 },
 {
  "level": 3,
  "text": "泥巴是一个纯情的姑娘，喜欢画画和幻想",
  "uiIdx": "4.1",
  "range": "3383-3413",
  "chapterUid": 3
 },
 {
  "level": 4,
  "text": "泥巴很漂亮，不少人追求，都未遂。未遂的原因是泥巴都觉得他们不遂，要么上身不遂，要么下身不遂。",
  "uiIdx": "",
  "range": "3367-3413",
  "chapterUid": 3
 },
 {
  "level": 4,
  "text": "泥巴看人注重精神，在她眼里，没有独特精神魅力的男人们都是不健全的。",
  "uiIdx": "",
  "range": "3413-3446",
  "chapterUid": 3
 },
 {
  "level": 3,
  "text": "泥巴喜欢左小龙，但左小龙并不喜欢她",
  "uiIdx": "4.2",
  "range": "4117-4186",
  "chapterUid": 3
 },
 {
  "level": 4,
  "text": "泥巴早在学校的时候就爱上了到处溜达的左小龙，她都能分辨自己喜欢的男人的摩托车声和一般阿猫阿狗的摩托车声有什么区别，哪怕他们开的是同一款车。",
  "uiIdx": "",
  "range": "4117-4186",
  "chapterUid": 3
 },
 {
  "level": 4,
  "text": "左小龙成天叼着一支烟，戴着帽子，骑着摩托车无所事事。这是一种真正的无所事事，无所事事到让外人看着就仿佛是在谋划着干大事。",
  "uiIdx": "",
  "range": "4353-4413",
  "chapterUid": 3
 },
 {
  "level": 2,
  "text": "左小龙的冒险与决定",
  "uiIdx": "5",
  "range": "9475-9492",
  "chapterUid": 3
 },
 {
  "level": 3,
  "text": "左小龙带着泥巴在镇上溜达，遇到了放激情迪斯科的杂货店",
  "uiIdx": "5.1",
  "range": "9475-9492",
  "chapterUid": 3
 },
 {
  "level": 4,
  "text": "店里播放的是激情迪斯科，里面唱道：姐妹出来混啊只为钓凯子啊凯子就是笨啊喜欢吃闷棍啊凯子若买单啊给你搀一搀啊凯子若上路啊给你露一露啊凯子若给钱啊让你摸胸部啊给看不给摸啊憋死他再说啊要想再深入啊就说你行色啊就说你行色啊就说你行色凯子很饥渴啊问他要部车啊他要给不起啊不让他再摸啊他要很上火啊送到派出所啊送到派出所啊送到派出所。",
  "uiIdx": "",
  "range": "9475-9677",
  "chapterUid": 3
 },
 {
  "level": 4,
  "text": "左小龙在旁边听得毛孔放大瞳孔缩小，一步上前去，对店里的老板说：老板，你得把它关了。",
  "uiIdx": "",
  "range": "10479-10520",
  "chapterUid": 3
 },
 {
  "level": 3,
  "text": "左小龙因为不满杂货店播放的音乐，决定破坏唱片机",
  "uiIdx": "5.2",
  "range": "10826-10852",
  "chapterUid": 3
 },
 {
  "level": 4,
  "text": "左小龙一把夺过唱机，把音乐关了，道：你的碟我没收了。",
  "uiIdx": "",
  "range": "10826-10852",
  "chapterUid": 3
 },
 {
  "level": 4,
  "text": "警察和协警很快就到了。警察到了左小龙跟前，问：是不是你抢他CD机？",
  "uiIdx": "",
  "range": "10927-10938",
  "chapterUid": 3
 },
 {
  "level": 4,
  "text": "左小龙道：你的证件呢？让我看看。",
  "uiIdx": "",
  "range": "11007-11018",
  "chapterUid": 3
 },
 {
  "level": 4,
  "text": "警察道：好，到所里去看吧。说着掏出了手铐。",
  "uiIdx": "",
  "range": "11114-11127",
  "chapterUid": 3
 },
 {
  "level": 4,
  "text": "左小龙一把推开警察，道：你知道怎么回事么？你听听他这CD里放的内容。",
  "uiIdx": "",
  "range": "11162-11196",
  "chapterUid": 3
 },
 {
  "level": 4,
  "text": "警察一下子愣了，政治神经立即绷紧了，想万一这是放的反动口号，岂不是抓错一个。警察立马到了店主面前，道：放。",
  "uiIdx": "",
  "range": "11223-11276",
  "chapterUid": 3
 },
 {
  "level": 4,
  "text": "店主懒洋洋地按了播放，迪斯科和说唱又响起。警察一直耐心地听到了“送到派出所”，琢磨了半天，转身对左小龙道：没问题啊。",
  "uiIdx": "",
  "range": "11303-11361",
  "chapterUid": 3
 },
 {
  "level": 4,
  "text": "左小龙提高声音道：这宣扬的思想不对。",
  "uiIdx": "",
  "range": "11388-11406",
  "chapterUid": 3
 },
 {
  "level": 4,
  "text": "警察满脑子只记得一句，那就是送到派出所。警察道：送到派出所有什么不对么？好了，这属于民事纠纷，算了，各自干各自的，旁边的也都别看了。",
  "uiIdx": "",
  "range": "11433-11499",
  "chapterUid": 3
 },
 {
  "level": 4,
  "text": "左小龙不屈不挠道：不行，这有危害啊。",
  "uiIdx": "",
  "range": "11526-11544",
  "chapterUid": 3
 },
 {
  "level": 4,
  "text": "警察道：有没有危害，我们没有接到上级宣传部门的通知。他在这里放，只要声音不扰民，就是合法的。",
  "uiIdx": "",
  "range": "11571-11617",
  "chapterUid": 3
 },
 {
  "level": 4,
  "text": "左小龙道：那他扰民了。",
  "uiIdx": "",
  "range": "11644-11655",
  "chapterUid": 3
 },
 {
  "level": 4,
  "text": "店老板问周围的看客说：我这音乐扰民了没有？大家觉得扰不扰？",
  "uiIdx": "",
  "range": "11682-11703",
  "chapterUid": 3
 },
 {
  "level": 4,
  "text": "周围的人笑着道：不扰。",
  "uiIdx": "",
  "range": "11738-11749",
  "chapterUid": 3
 },
 {
  "level": 4,
  "text": "警察说：你看，其实你才扰民。你要是不想听，你就放个你喜欢的，盖过他的就得了。",
  "uiIdx": "",
  "range": "11776-11814",
  "chapterUid": 3
 },
 {
  "level": 3,
  "text": "左小龙的摩托车在破坏唱片机后爆炸了",
  "uiIdx": "5.3",
  "range": "12291-12346",
  "chapterUid": 3
 },
 {
  "level": 4,
  "text": "左小龙跨在摩托车上，目光炯然，神情坚定，包括泥巴在内的所有人都诧异地看着如同雕塑一般的左小龙，一时没有了言语。",
  "uiIdx": "",
  "range": "12291-12346",
  "chapterUid": 3
 },
 {
  "level": 4,
  "text": "左小龙看着唱片机的方向，右手不断地催逼油门，一刻不想放松。此刻他的胸膛挺得更高，嘴角也向上勾起。",
  "uiIdx": "",
  "range": "12373-12421",
  "chapterUid": 3
 },
 {
  "level": 4,
  "text": "一直过了一分多钟，周围人还没能反应过来。左小龙又用力拧了一下油门，引擎的节气门顿时全开，排气管的咆哮铺天盖地，人群仿佛都被声浪劈了开来。",
  "uiIdx": "",
  "range": "12448-12516",
  "chapterUid": 3
 },
 {
  "level": 4,
  "text": "突然间，轰一声巨响，然后是咔喇咔喇的杂音，然后烟雾从他的西风摩托车发动机处腾腾升起，摩托车仪表台上的发动机转速跌到了零，摩托车颤抖了几下后，四周一片死寂，只有唱机里在播放最后一句：送到派出所啊，送到派出所。",
  "uiIdx": "",
  "range": "12516-12619",
  "chapterUid": 3
 },
 {
  "level": 1,
  "text": "二",
  "uiIdx": "",
  "range": "",
  "chapterUid": 3
 },
 {
  "level": 2,
  "text": "左小龙和泥巴修理摩托车",
  "uiIdx": "1",
  "range": "493-546",
  "chapterUid": 3
 },
 {
  "level": 3,
  "text": "左小龙在公共场合爆缸，被警察带走",
  "uiIdx": "1.1",
  "range": "493-546",
  "chapterUid": 3
 },
 {
  "level": 4,
  "text": "左小龙当众爆缸，属于产品使用不当。",
  "uiIdx": "",
  "range": "493-546",
  "chapterUid": 3
 },
 {
  "level": 4,
  "text": "警察查了半天，现场没查明白那人是怎么头破血流的，左小龙也没犯什么法。",
  "uiIdx": "",
  "range": "493-546",
  "chapterUid": 3
 },
 {
  "level": 3,
  "text": "左小龙和泥巴把摩托车推到修车铺",
  "uiIdx": "1.2",
  "range": "594-701",
  "chapterUid": 3
 },
 {
  "level": 4,
  "text": "左小龙蹲趴在地上，依靠着被调到最暗的橘黄色路灯的微光，摸索着把散落周围的引擎部件一片一片拾了起来。",
  "uiIdx": "",
  "range": "594-701",
  "chapterUid": 3
 },
 {
  "level": 4,
  "text": "左小龙把零件们都放到了书包里，拉上拉链，把手在地上搓了搓，推着摩托车，泥巴也在旁边跟着扶着，两人艰难地花了几个小时把摩托车推到了修车铺。",
  "uiIdx": "",
  "range": "847-915",
  "chapterUid": 3
 },
 {
  "level": 2,
  "text": "左小龙和泥巴等待修车",
  "uiIdx": "2",
  "range": "915-944",
  "chapterUid": 3
 },
 {
  "level": 3,
  "text": "左小龙和泥巴在修车铺门口休息",
  "uiIdx": "2.1",
  "range": "915-944",
  "chapterUid": 3
 },
 {
  "level": 4,
  "text": "在修车铺的门口，左小龙说：我走不动了，我们就在这里靠一靠。",
  "uiIdx": "",
  "range": "915-944",
  "chapterUid": 3
 },
 {
  "level": 4,
  "text": "泥巴说：嗯，就靠这里吧，也挺好的。",
  "uiIdx": "",
  "range": "971-988",
  "chapterUid": 3
 },
 {
  "level": 3,
  "text": "左小龙和泥巴在街上等待修车铺开门",
  "uiIdx": "2.2",
  "range": "1888-1951",
  "chapterUid": 3
 },
 {
  "level": 4,
  "text": "新到来的一天是一个阴天，因为丝毫没有要洒下阳光的模样，风把春天吹得像秋天一样，连嫩绿的叶子都落下几片，老天就像打了很厚的粉底。",
  "uiIdx": "",
  "range": "1888-1951",
  "chapterUid": 3
 },
 {
  "level": 4,
  "text": "左小龙本来很想嘘嘘，泥巴的脑袋又压在他的膀胱位置，让他更加难受，但他见泥巴睡得投入，实在不忍心叫醒，而且觉得把泥巴叫醒后第一句话就是“我要嘘嘘”显得自己毫无英雄气概，思前想后，一筹莫展。",
  "uiIdx": "",
  "range": "1951-2044",
  "chapterUid": 3
 },
 {
  "level": 2,
  "text": "左小龙和泥巴的摩托车被修好",
  "uiIdx": "3",
  "range": "3317-3347",
  "chapterUid": 3
 },
 {
  "level": 3,
  "text": "修车铺的师傅们无法修复摩托车的引擎",
  "uiIdx": "3.1",
  "range": "3317-3347",
  "chapterUid": 3
 },
 {
  "level": 4,
  "text": "经过修车铺的会诊，摩托车的引擎已经不能修复，只能换一台新的。",
  "uiIdx": "",
  "range": "3317-3347",
  "chapterUid": 3
 },
 {
  "level": 3,
  "text": "左小龙找到了一份兼职的工作",
  "uiIdx": "3.2",
  "range": "3432-3449",
  "chapterUid": 3
 },
 {
  "level": 4,
  "text": "左小龙找到的兼职工作是在亭林镇上一家很小的温度计厂里干活，这个温度计厂的任务是——生产温度计。",
  "uiIdx": "",
  "range": "4145-4192",
  "chapterUid": 3
 },
 {
  "level": 4,
  "text": "左小龙负责最后一道程序，就是包装和测试温度计，等于质量总监。",
  "uiIdx": "",
  "range": "4192-4222",
  "chapterUid": 3
 },
 {
  "level": 2,
  "text": "左小龙和大帅组建合唱团",
  "uiIdx": "4",
  "range": "5198-5284",
  "chapterUid": 3
 },
 {
  "level": 3,
  "text": "左小龙提出组建合唱团的想法",
  "uiIdx": "4.1",
  "range": "5198-5284",
  "chapterUid": 3
 },
 {
  "level": 4,
  "text": "左小龙说：我们把这个雕塑园搞得像一个小的国家一样，说不定还能搞出些个什么产业来，我们就能赚到钱。",
  "uiIdx": "",
  "range": "5198-5284",
  "chapterUid": 3
 },
 {
  "level": 3,
  "text": "大帅对组建合唱团表示怀疑",
  "uiIdx": "4.2",
  "range": "5311-5334",
  "chapterUid": 3
 },
 {
  "level": 4,
  "text": "大帅说：那你自己弄就行了呗，我又不会唱歌。",
  "uiIdx": "",
  "range": "5311-5334",
  "chapterUid": 3
 },
 {
  "level": 3,
  "text": "左小龙坚持要拉大帅一起组建合唱团",
  "uiIdx": "4.3",
  "range": "5456-5473",
  "chapterUid": 3
 },
 {
  "level": 4,
  "text": "左小龙想半天说：要不，你多孤独啊。",
  "uiIdx": "",
  "range": "5456-5473",
  "chapterUid": 3
 },
 {
  "level": 2,
  "text": "左小龙对黄莹的喜欢",
  "uiIdx": "5",
  "range": "8657-8697",
  "chapterUid": 3
 },
 {
  "level": 3,
  "text": "左小龙对黄莹的喜欢是一种没有预感到交集的喜欢。",
  "uiIdx": "5.1",
  "range": "8657-8697",
  "chapterUid": 3
 },
 {
  "level": 3,
  "text": "左小龙突然冒出一个想法，要把黄莹拉到合唱团里",
  "uiIdx": "5.2",
  "range": "8697-8738",
  "chapterUid": 3
 },
 {
  "level": 4,
  "text": "今天这样的场合遇见她，左小龙突然冒出一个想法，他对大帅说：大帅，你觉得黄莹怎么样？",
  "uiIdx": "",
  "range": "8697-8738",
  "chapterUid": 3
 },
 {
  "level": 4,
  "text": "左小龙说：大帅，你觉得黄莹怎么样？大帅道：上这样的女人，一定要戴上避孕套。",
  "uiIdx": "",
  "range": "8697-8785",
  "chapterUid": 3
 },
 {
  "level": 4,
  "text": "左小龙说：我不是说这个，你觉得，我们把她拉到合唱团里，怎么样？大帅道：不是说用小学生么？这样一个女的在，会不会大家芳心大乱，队伍涣散？电视剧里都是这样的。",
  "uiIdx": "",
  "range": "8812-8906",
  "chapterUid": 3
 },
 {
  "level": 4,
  "text": "左小龙说：不不，我们正好缺一个音部，没有这个音部，合唱团肯定不行，黄莹做这个音部，正合适。没错的。",
  "uiIdx": "",
  "range": "8943-8988",
  "chapterUid": 3
 },
 {
  "level": 2,
  "text": "亭林镇的环境变化",
  "uiIdx": "6",
  "range": "10459-10531",
  "chapterUid": 3
 },
 {
  "level": 3,
  "text": "亭林镇的环境因为外来打工者的涌入而发生了变化",
  "uiIdx": "6.1",
  "range": "10459-10531",
  "chapterUid": 3
 },
 {
  "level": 4,
  "text": "大量的外来打工者找到了这里，他们比当地人更能吃苦，更能耐劳，更能吸毒，而且只要求一半多的薪水，很快，当地人纷纷失业。",
  "uiIdx": "",
  "range": "10459-10531",
  "chapterUid": 3
 },
 {
  "level": 4,
  "text": "面对突然拥来的几万人口，当地的几千人走了一大半以后，剩下的突然想到，我们可以赚外来务工人员的钱，老人可以把房子租出去，年轻人开始开各种店来满足这些人的日常生活生理需要。",
  "uiIdx": "",
  "range": "10601-10685",
  "chapterUid": 3
 },
 {
  "level": 3,
  "text": "亭林镇的环境污染问题",
  "uiIdx": "6.2",
  "range": "8014-8084",
  "chapterUid": 3
 },
 {
  "level": 4,
  "text": "这个镇子的历代领导都很喜欢“文艺”这个招牌，经常举办各种与文艺相关的比赛，并想出“文艺搭台，经济唱戏”这样的全国所有破地方都喜欢的恶俗口号。",
  "uiIdx": "",
  "range": "8014-8084",
  "chapterUid": 3
 },
 {
  "level": 4,
  "text": "“文艺搭台，经济唱戏”怎么可能呢，这世界上只有“文艺坍台，经济唱戏”。一切都是为了附庸风雅，因为我们有太多没有特色的城镇，所以有人会绞尽脑汁给自己赋予一些特色，比如我们这里的农民会作画，我们这里的豆腐特别臭，我们这里的姑娘随便睡，我们这里的企业不交税，等等等等。",
  "uiIdx": "",
  "range": "8014-8215",
  "chapterUid": 3
 },
 {
  "level": 4,
  "text": "这些东西可能就是狗屎，但如果是当地特有的狗屎，那这就是好东西。文艺在亭林镇就是这样的一个狗屎。",
  "uiIdx": "",
  "range": "8215-8262",
  "chapterUid": 3
 },
 {
  "level": 2,
  "text": "左小龙和大帅的行动",
  "uiIdx": "7",
  "range": "10862-10885",
  "chapterUid": 3
 },
 {
  "level": 3,
  "text": "左小龙和大帅在街上寻找目标",
  "uiIdx": "7.1",
  "range": "10862-10885",
  "chapterUid": 3
 },
 {
  "level": 4,
  "text": "左小龙和大帅开着摩托车在这步行街里躲闪着人流。",
  "uiIdx": "",
  "range": "10862-10885",
  "chapterUid": 3
 },
 {
  "level": 4,
  "text": "左小龙突然驶离了国道，开上了小路，大帅问道：你怎么了？左小龙道：执法。",
  "uiIdx": "",
  "range": "10885-10912",
  "chapterUid": 3
 },
 {
  "level": 3,
  "text": "左小龙和大帅砸破染料厂和塑胶厂的窗户",
  "uiIdx": "7.2",
  "range": "11044-11106",
  "chapterUid": 3
 },
 {
  "level": 4,
  "text": "左小龙绕到了一个染料厂的后面，把摩托车停好，下车对大帅说：你看，这个三层的小楼是他们的高层住的地方，他们污染我的河，我要……大帅问道：怎么样？左小龙坚毅地看着小楼的玻璃，流露出视死如归的眼神，道：我要打破他的窗。",
  "uiIdx": "",
  "range": "11044-11106",
  "chapterUid": 3
 },
 {
  "level": 4,
  "text": "说罢，左小龙捡起一块石头，往小楼的窗户砸去，但因为射程比较远，左小龙的抛物线也不够合理，杀伤力一般，所以石头碰到窗的时候已经绵软无力，崩了一下以后掉落到了围墙里。",
  "uiIdx": "",
  "range": "11231-11312",
  "chapterUid": 3
 },
 {
  "level": 4,
  "text": "左小龙又捡起一块各方面条件符合的石头，对大帅说：扔石头很有讲究，我其实很喜欢这个，刚才那个是失误。你看，太大的扔不动，太小的扔不远，片状的石头容易受到气流的影响，三角的石头硌手，容易歪，最合适的就是这样的石头，椭圆形，光滑，大小……大帅接话道：这不就是鹅卵石么？左小龙没往下说，操起一块扔向玻璃。石头还没有接触到目标，左小龙就开始发动摩托车，道：赶紧走，可以了。",
  "uiIdx": "",
  "range": "11231-11455",
  "chapterUid": 3
 },
 {
  "level": 4,
  "text": "话音刚落，玻璃稀里哗啦掉一地。",
  "uiIdx": "",
  "range": "11601-11616",
  "chapterUid": 3
 },
 {
  "level": 4,
  "text": "大帅连忙跳上摩托车，两人在砂石路上卷起浓烟，转过一个村庄，到了一个塑胶厂后面。",
  "uiIdx": "",
  "range": "11643-11682",
  "chapterUid": 3
 },
 {
  "level": 4,
  "text": "这个塑胶厂的结构和刚才那个染料厂大同小异，大帅道：我来。说完从地上捡起石头，左小龙忙握住他的胳膊，说：等等。",
  "uiIdx": "",
  "range": "11709-11763",
  "chapterUid": 3
 },
 {
  "level": 4,
  "text": "大帅说：成，那你来吧。",
  "uiIdx": "",
  "range": "11790-11801",
  "chapterUid": 3
 },
 {
  "level": 4,
  "text": "左小龙道：等等，你没看见楼下有个人在扫地。等那扫地的走了再砸，要不然玻璃全插她脑袋上。",
  "uiIdx": "",
  "range": "11828-11871",
  "chapterUid": 3
 },
 {
  "level": 4,
  "text": "两人等了五分钟，那清洁工直接就坐在楼下台阶上休息。",
  "uiIdx": "",
  "range": "11898-11923",
  "chapterUid": 3
 },
 {
  "level": 4,
  "text": "大帅问：怎么办？话虽这样问，但大帅已经做好了死等的准备，他觉得依照这样一个人的脾气，这石头是一定要扔出去才算完。",
  "uiIdx": "",
  "range": "11985-12033",
  "chapterUid": 3
 },
 {
  "level": 4,
  "text": "左小龙道：吃饭去。",
  "uiIdx": "",
  "range": "12060-12069",
  "chapterUid": 3
 },
 {
  "level": 3,
  "text": "左小龙和大帅在餐馆吃饭",
  "uiIdx": "7.3",
  "range": "12096-12107",
  "chapterUid": 3
 },
 {
  "level": 4,
  "text": "两人来到了大毛土菜馆。大毛土菜馆是当地有名的菜馆，店主是个盲人，叫刘必芒，小时候他的父母觉得他必然绽放光芒，所以取名刘必芒，结果还真的盲了。",
  "uiIdx": "",
  "range": "12096-12166",
  "chapterUid": 3
 },
 {
  "level": 4,
  "text": "在他瞎了以后，他很痛恨自己的名字，觉得是这个名字不吉利，所以将“必”字去除，改名刘芒。",
  "uiIdx": "",
  "range": "12166-12209",
  "chapterUid": 3
 },
 {
  "level": 4,
  "text": "他很关心这世界正发生着什么，他很喜欢左小龙，因为只有左小龙有耐心陪他聊天，告诉他亭林镇的局势。",
  "uiIdx": "",
  "range": "12209-12256",
  "chapterUid": 3
 },
 {
  "level": 4,
  "text": "关于世界局势和中国的局势他可以从电视上听到，但是电视里不会告诉他亭林镇的局势。",
  "uiIdx": "",
  "range": "12256-12295",
  "chapterUid": 3
 },
 {
  "level": 4,
  "text": "后来他装了卫星电视，但是卫星电视让他心情不爽，因为他发现，明明是相同的事情，为什么从卫星里得知的和从国内电视台得知的有所区别。",
  "uiIdx": "",
  "range": "12295-12358",
  "chapterUid": 3
 },
 {
  "level": 4,
  "text": "他不知道相信哪个好，最后，他把卫星大锅拆了，他认为应该相信自己人的。",
  "uiIdx": "",
  "range": "12358-12392",
  "chapterUid": 3
 },
 {
  "level": 4,
  "text": "卫星大锅拆下来后，当地的警方就找到了他，警方说他是私装卫星电视。",
  "uiIdx": "",
  "range": "12392-12424",
  "chapterUid": 3
 },
 {
  "level": 4,
  "text": "店主问：卫星电视不能装么？警察说：不能装，你没看到有告示么，贴在各个地方的宣传栏上的。",
  "uiIdx": "",
  "range": "12451-12522",
  "chapterUid": 3
 },
 {
  "level": 4,
  "text": "店主回答：我没看到。警察说：这个我们要没收，还要罚款。店主问：我装在上面的时候你们为什么不罚我呢，拆下来了还要罚我？警察道：你装在上面的时候我以为是你们饭店的招牌，是个锅，你拆下来了我就看清楚了。",
  "uiIdx": "",
  "range": "12492-12522",
  "chapterUid": 3
 },
 {
  "level": 4,
  "text": "店主问：你这为什么不让看啊？警察道：我只是执行任务，执行上级的通知，这里面肯定有不健康的东西。",
  "uiIdx": "",
  "range": "12755-12829",
  "chapterUid": 3
 },
 {
  "level": 4,
  "text": "店主顶撞道：那我怎么还挺健康呢？警察笑道：你健康什么啊，你都看瞎了。算了，我就不罚你款了，你也是盲人，但你的作案工具我们就没收了。",
  "uiIdx": "",
  "range": "12856-12948",
  "chapterUid": 3
 },
 {
  "level": 4,
  "text": "就这样，他的大锅被没收。他愤然摸索到了自己的房间。而他的保姆听到动静出门，看见警察正在装卫星大锅，以为主人不知道，连忙一边上车夺下，一边大喊“刘芒刘芒”而被处以行政拘留一天，罪名是妨碍公务并且辱骂警察。",
  "uiIdx": "",
  "range": "13121-13133",
  "chapterUid": 3
 },
 {
  "level": 1,
  "text": "三",
  "uiIdx": "",
  "range": "",
  "chapterUid": 3
 },
 {
  "level": 2,
  "text": "左小龙的日常生活",
  "uiIdx": "1",
  "range": "463-568",
  "chapterUid": 3
 },
 {
  "level": 3,
  "text": "左小龙深爱骑摩托车的感觉，尤其是追逐海鸟的感觉",
  "uiIdx": "1.1",
  "range": "463-568",
  "chapterUid": 3
 },
 {
  "level": 4,
  "text": "他觉得这感觉就好似孤胆英雄，正因为孤胆英雄最重要的是孤，所以身边一定是不能坐人的。",
  "uiIdx": "",
  "range": "463-568",
  "chapterUid": 3
 },
 {
  "level": 3,
  "text": "左小龙在雕塑园里看电视，觉得这样看电视反而更容易有满足感",
  "uiIdx": "1.2",
  "range": "1554-1602",
  "chapterUid": 3
 },
 {
  "level": 4,
  "text": "因为没有有线电视，所以只能收到固定的几个频道。",
  "uiIdx": "",
  "range": "1554-1602",
  "chapterUid": 3
 },
 {
  "level": 3,
  "text": "左小龙的摩托车被拆了散落在地上，他决定给自己的摩托车取一个名字",
  "uiIdx": "1.3",
  "range": "2817-2833",
  "chapterUid": 3
 },
 {
  "level": 4,
  "text": "左小龙的脑海里冒出来的第一个名字就是“挑战者号”，但他觉得这个名字很耳熟，好像被谁用过。",
  "uiIdx": "",
  "range": "2860-2904",
  "chapterUid": 3
 },
 {
  "level": 4,
  "text": "思前想后，出来的都是一些不能让自己满意的名字，诸如“大西洋”，不行，这个就像一个国产摩托的牌子；“所向披靡”也不好，这个“靡”字他不知道怎么写；“暗夜之星”也不好，感觉它是锦江之星的兄弟。",
  "uiIdx": "",
  "range": "2860-2998",
  "chapterUid": 3
 },
 {
  "level": 2,
  "text": "亭林镇的文艺比赛",
  "uiIdx": "2",
  "range": "34754-34785",
  "chapterUid": 3
 },
 {
  "level": 3,
  "text": "亭林镇要组织一个文艺比赛，奖金很高，很多人都在唱歌",
  "uiIdx": "2.1",
  "range": "34754-34785",
  "chapterUid": 3
 },
 {
  "level": 4,
  "text": "文艺比赛在两周后举行，地点是亭林镇大礼堂。届时还有神秘嘉宾出席。",
  "uiIdx": "",
  "range": "14619-14651",
  "chapterUid": 3
 },
 {
  "level": 4,
  "text": "凭借本地居民身份证就可以参加。",
  "uiIdx": "",
  "range": "14651-14666",
  "chapterUid": 3
 },
 {
  "level": 3,
  "text": "波波印刷厂赞助亭林镇的第一届文艺比赛，并且设立波波杯",
  "uiIdx": "2.2",
  "range": "14442-14492",
  "chapterUid": 3
 },
 {
  "level": 4,
  "text": "波波杯听着很像颁发给宠物的一个奖项，但这却是亭林镇最大的奖金额度，一等奖有五万元，二等奖两万元，三等奖一万元，而且还设立了最佳合唱团的评比，胜出的合唱团可以去参加更高级别的比赛。",
  "uiIdx": "",
  "range": "14442-14583",
  "chapterUid": 3
 },
 {
  "level": 4,
  "text": "这个比赛被当地政府大加重视，因为这个比赛可以增加当地人的凝聚力，让当地的居民以比外来务工人员高一个层次的文艺面貌出现。",
  "uiIdx": "",
  "range": "14693-14752",
  "chapterUid": 3
 },
 {
  "level": 2,
  "text": "左小龙的合唱团",
  "uiIdx": "3",
  "range": "20327-20361",
  "chapterUid": 3
 },
 {
  "level": 3,
  "text": "左小龙组建了一个亭林镇合唱团，但是遇到了很多困难",
  "uiIdx": "3.1",
  "range": "20327-20361",
  "chapterUid": 3
 },
 {
  "level": 4,
  "text": "他们遇到的小学生尔一是个哑巴，这给合唱团的建设带来了很大的困难。",
  "uiIdx": "",
  "range": "20327-20361",
  "chapterUid": 3
 },
 {
  "level": 4,
  "text": "左小龙的摩托车修好了，他决定去参加文艺比赛，但是发现邮筒被人偷了，他的信无法寄出。",
  "uiIdx": "",
  "range": "34982-34994",
  "chapterUid": 3
 },
 {
  "level": 3,
  "text": "左小龙的合唱团在准备过程中遇到了很多问题，但是他依然坚持下来",
  "uiIdx": "3.2",
  "range": "20578-20610",
  "chapterUid": 3
 },
 {
  "level": 4,
  "text": "他想到了自己的摩托车应该修好了，马上奔向修车铺。",
  "uiIdx": "",
  "range": "20578-20610",
  "chapterUid": 3
 },
 {
  "level": 4,
  "text": "他骑着摩托车上了街，这世界一时间变了模样。",
  "uiIdx": "",
  "range": "20832-20857",
  "chapterUid": 3
 },
 {
  "level": 4,
  "text": "他坐在摩托车上抽烟，泥巴则去小卖部买水。看着泥巴的背影，左小龙想道，自己对这样的一个漂亮姑娘究竟是什么样的一种感情。",
  "uiIdx": "",
  "range": "25034-25094",
  "chapterUid": 3
 },
 {
  "level": 2,
  "text": "泥巴和左小龙的关系",
  "uiIdx": "4",
  "range": "25311-25341",
  "chapterUid": 3
 },
 {
  "level": 3,
  "text": "泥巴是左小龙的女朋友，她很喜欢左小龙",
  "uiIdx": "4.1",
  "range": "25311-25341",
  "chapterUid": 3
 },
 {
  "level": 4,
  "text": "泥巴给左小龙买了一套信纸和一支笔，泥巴满心欢喜。",
  "uiIdx": "",
  "range": "25311-25341",
  "chapterUid": 3
 },
 {
  "level": 4,
  "text": "泥巴给左小龙写信，表达了她对左小龙的感情。",
  "uiIdx": "",
  "range": "25056-25094",
  "chapterUid": 3
 },
 {
  "level": 3,
  "text": "左小龙对泥巴的感情很深，但是他不知道如何表达",
  "uiIdx": "4.2",
  "range": "25241-25268",
  "chapterUid": 3
 },
 {
  "level": 4,
  "text": "左小龙想，这么好的一个姑娘，自己为何就是喜欢不起来呢？",
  "uiIdx": "",
  "range": "25241-25268",
  "chapterUid": 3
 },
 {
  "level": 4,
  "text": "左小龙决定，就着信纸的主题开始写信，顺水推舟，这样可以让开场的气氛显得很轻松，自己的文采也好些。",
  "uiIdx": "",
  "range": "25894-25940",
  "chapterUid": 3
 },
 {
  "level": 2,
  "text": "亭林镇的变异事件",
  "uiIdx": "5",
  "range": "32211-32309",
  "chapterUid": 3
 },
 {
  "level": 3,
  "text": "亭林镇出现生物变大现象，属于正常合理的物种进化，是由于地球的温室效应所造成",
  "uiIdx": "5.1",
  "range": "32211-32309",
  "chapterUid": 3
 },
 {
  "level": 4,
  "text": "经过专家的化验，所有生物都没有毒性，只是比以往大了一点。",
  "uiIdx": "",
  "range": "32309-32337",
  "chapterUid": 3
 },
 {
  "level": 4,
  "text": "请群众不要恐慌，请群众不要恐慌。",
  "uiIdx": "",
  "range": "32337-32353",
  "chapterUid": 3
 },
 {
  "level": 1,
  "text": "四",
  "uiIdx": "",
  "range": "",
  "chapterUid": 3
 },
 {
  "level": 2,
  "text": "刘必芒和左小龙的对话",
  "uiIdx": "1",
  "range": "811-834",
  "chapterUid": 3
 },
 {
  "level": 3,
  "text": "刘必芒对世界的变化感到不安",
  "uiIdx": "1.1",
  "range": "811-834",
  "chapterUid": 3
 },
 {
  "level": 4,
  "text": "刘必芒认为世界天天在变，我们就不能不跟着它一起变么？",
  "uiIdx": "",
  "range": "811-834",
  "chapterUid": 3
 },
 {
  "level": 4,
  "text": "刘必芒觉得这世界就是土鸡，不变最好吃。",
  "uiIdx": "",
  "range": "1115-1129",
  "chapterUid": 3
 },
 {
  "level": 3,
  "text": "左小龙对土鸡的配方感到困惑",
  "uiIdx": "1.2",
  "range": "1156-1186",
  "chapterUid": 3
 },
 {
  "level": 4,
  "text": "左小龙道：老板，可是我们在的地方，一直没有找到你土鸡的配方。",
  "uiIdx": "",
  "range": "1156-1186",
  "chapterUid": 3
 },
 {
  "level": 2,
  "text": "刘必芒对泥巴的思念",
  "uiIdx": "2",
  "range": "1830-1854",
  "chapterUid": 3
 },
 {
  "level": 3,
  "text": "刘必芒对泥巴的思念让他感到痛苦",
  "uiIdx": "2.1",
  "range": "1830-1854",
  "chapterUid": 3
 },
 {
  "level": 4,
  "text": "刘必芒反复哼唱着这首歌，不见光明的眼角流下眼泪。",
  "uiIdx": "",
  "range": "1830-1854",
  "chapterUid": 3
 },
 {
  "level": 3,
  "text": "刘必芒对泥巴的思念让他感到甜蜜",
  "uiIdx": "2.2",
  "range": "3895-3921",
  "chapterUid": 3
 },
 {
  "level": 4,
  "text": "泥巴一句都听不见，只知道跟着左小龙去往随便什么地方。",
  "uiIdx": "",
  "range": "3895-3921",
  "chapterUid": 3
 },
 {
  "level": 2,
  "text": "左小龙和泥巴的相遇",
  "uiIdx": "3",
  "range": "3948-4007",
  "chapterUid": 3
 },
 {
  "level": 3,
  "text": "左小龙和泥巴在雕塑园相遇",
  "uiIdx": "3.1",
  "range": "3948-4007",
  "chapterUid": 3
 },
 {
  "level": 4,
  "text": "左小龙把泥巴带到了雕塑园里，老鹰般的飞禽和左小龙的摩托车并排飞行了许久。",
  "uiIdx": "",
  "range": "3948-4007",
  "chapterUid": 3
 },
 {
  "level": 4,
  "text": "左小龙把泥巴带到自己住的地方，把车停好，帮泥巴把头盔摘下。",
  "uiIdx": "",
  "range": "4007-4036",
  "chapterUid": 3
 },
 {
  "level": 3,
  "text": "左小龙和泥巴在雕塑园里发现了比卡丘",
  "uiIdx": "3.2",
  "range": "5957-5986",
  "chapterUid": 3
 },
 {
  "level": 4,
  "text": "左小龙弯下腰仔细一看，果然和信纸上的玩意儿长得八九不离十。",
  "uiIdx": "",
  "range": "5957-5986",
  "chapterUid": 3
 },
 {
  "level": 4,
  "text": "他忙问泥巴：原来这世上真有比卡丘。",
  "uiIdx": "",
  "range": "5986-6003",
  "chapterUid": 3
 },
 {
  "level": 2,
  "text": "左小龙和泥巴的分别",
  "uiIdx": "4",
  "range": "12809-12830",
  "chapterUid": 3
 },
 {
  "level": 3,
  "text": "左小龙和泥巴在雕塑园门口分别",
  "uiIdx": "4.1",
  "range": "12809-12830",
  "chapterUid": 3
 },
 {
  "level": 4,
  "text": "泥巴抱着龙猫上船，萤火虫也跟随着到了船头。",
  "uiIdx": "",
  "range": "12809-12830",
  "chapterUid": 3
 },
 {
  "level": 4,
  "text": "老人笑道：哟，你们谈恋爱带了一个电灯泡啊，还是无线的。",
  "uiIdx": "",
  "range": "12830-12857",
  "chapterUid": 3
 },
 {
  "level": 3,
  "text": "左小龙和泥巴在雕塑园门口分别后，泥巴感到伤心",
  "uiIdx": "4.2",
  "range": "13951-13961",
  "chapterUid": 3
 },
 {
  "level": 4,
  "text": "泥巴突然间哇地大哭。",
  "uiIdx": "",
  "range": "13951-13961",
  "chapterUid": 3
 },
 {
  "level": 4,
  "text": "泥巴哭得不能言语，断断续续对着划船的老人说道：爷爷，倒船。",
  "uiIdx": "",
  "range": "14030-14059",
  "chapterUid": 3
 },
 {
  "level": 2,
  "text": "亭林镇的物种变大事件",
  "uiIdx": "5",
  "range": "19872-19923",
  "chapterUid": 3
 },
 {
  "level": 3,
  "text": "亭林镇的物种变大事件引起了电视台的关注",
  "uiIdx": "5.1",
  "range": "19872-19923",
  "chapterUid": 3
 },
 {
  "level": 4,
  "text": "各个电视台就此神奇的事件进行过报道，《走进科学》也来到了镇上。",
  "uiIdx": "",
  "range": "19872-19923",
  "chapterUid": 3
 },
 {
  "level": 3,
  "text": "电视台节目组在亭林镇进行了长达三天的调查",
  "uiIdx": "5.2",
  "range": "20507-20531",
  "chapterUid": 3
 },
 {
  "level": 4,
  "text": "节目组导演端坐着说：客气客气。正因为有执着的精神，很多的疑问都被我们一一解开。",
  "uiIdx": "",
  "range": "20492-20531",
  "chapterUid": 3
 },
 {
  "level": 2,
  "text": "《走进科学》节目组的调查过程",
  "uiIdx": "6",
  "range": "23034-23052",
  "chapterUid": 3
 },
 {
  "level": 3,
  "text": "节目组怀疑是肥料出现了问题",
  "uiIdx": "6.1",
  "range": "21191-21244",
  "chapterUid": 3
 },
 {
  "level": 4,
  "text": "我们节目组就怀疑，会不会是肥料出现了问题，经过询问，他们用的是人粪浇灌。",
  "uiIdx": "",
  "range": "21191-21244",
  "chapterUid": 3
 },
 {
  "level": 3,
  "text": "节目组在现场还原肥料",
  "uiIdx": "6.2",
  "range": "21507-21540",
  "chapterUid": 3
 },
 {
  "level": 4,
  "text": "我们栏目组在取得了张某媳妇的大便以后，连夜赶回了张某所在的县城里。",
  "uiIdx": "",
  "range": "21507-21540",
  "chapterUid": 3
 },
 {
  "level": 4,
  "text": "我们在另外一个地方找到了一些作为样品的胡萝卜，我们对胡萝卜进行了浇灌，并且用摄影机记录了一个多月的生长过程，但是，遗憾的是，最后，胡萝卜还是没有变白。",
  "uiIdx": "",
  "range": "21692-21787",
  "chapterUid": 3
 },
 {
  "level": 3,
  "text": "节目组将种子拿回北京化验",
  "uiIdx": "6.3",
  "range": "22126-22157",
  "chapterUid": 3
 },
 {
  "level": 4,
  "text": "导演说：摄影小刘敏锐地发现，包装袋上写了三个字：白萝卜。答案终于揭晓了，原来张某是个文盲，他买错了种子，种的是白萝卜。",
  "uiIdx": "",
  "range": "22098-22157",
  "chapterUid": 3
 },
 {
  "level": 2,
  "text": "亭林镇物种变大的原因",
  "uiIdx": "7",
  "range": "22126-22157",
  "chapterUid": 3
 },
 {
  "level": 3,
  "text": "物种变大的原因是张某买错了种子",
  "uiIdx": "7.1",
  "range": "22126-22157",
  "chapterUid": 3
 },
 {
  "level": 4,
  "text": "原来张某是个文盲，他买错了种子，种的是白萝卜。",
  "uiIdx": "",
  "range": "22126-22157",
  "chapterUid": 3
 },
 {
  "level": 3,
  "text": "物种变大事件浪费了电视台的资源",
  "uiIdx": "7.2",
  "range": "19872-19923",
  "chapterUid": 3
 },
 {
  "level": 4,
  "text": "导演端起酒杯，一饮而尽，一抹嘴，道：后来这个节目得到了台里的高度表扬，台里负责审片的领导认为，正是因为这位农民文化水平低，所以才出现了这样的事情，导致整个国家的电视台投入了一百多万来进行研究，如果他识字，那国家就不会出现那样的浪费，所以，归根结底，是因为这农民的文化水平低而导致了这次一百多万元的浪费，这是一个很好的反面教材。",
  "uiIdx": "",
  "range": "19872-19923",
  "chapterUid": 3
 },
 {
  "level": 2,
  "text": "左小龙的新想法",
  "uiIdx": "8",
  "range": "23256-23327",
  "chapterUid": 3
 },
 {
  "level": 3,
  "text": "左小龙和大帅、哑巴三人组成一个组合",
  "uiIdx": "8.1",
  "range": "23256-23327",
  "chapterUid": 3
 },
 {
  "level": 4,
  "text": "他再去找黄莹，如果人家真的有革命的浪漫主义精神，答应了左小龙，那最好，四个人也是一个小组合。",
  "uiIdx": "",
  "range": "23256-23327",
  "chapterUid": 3
 },
 {
  "level": 3,
  "text": "左小龙在街上找人，所有人都问他：有钱么？",
  "uiIdx": "8.2",
  "range": "23178-23198",
  "chapterUid": 3
 },
 {
  "level": 4,
  "text": "大家都是没有信心的人，从来不会把宝押在自己的未来上，所以没有人愿意加入左小龙的合唱团。",
  "uiIdx": "",
  "range": "23213-23256",
  "chapterUid": 3
 },
 {
  "level": 1,
  "text": "五",
  "uiIdx": "",
  "range": "",
  "chapterUid": 3
 },
 {
  "level": 2,
  "text": "亭林镇文艺大赛的筹备和进行",
  "uiIdx": "1",
  "range": "513-534",
  "chapterUid": 3
 },
 {
  "level": 3,
  "text": "亭林镇文艺大赛的筹备充满了期待和紧张",
  "uiIdx": "1.1",
  "range": "513-534",
  "chapterUid": 3
 },
 {
  "level": 4,
  "text": "五万元的大奖究竟要被谁拿走，大家都觉得官方组织的亭林镇合唱团是最有机会的。",
  "uiIdx": "",
  "range": "513-588",
  "chapterUid": 3
 },
 {
  "level": 4,
  "text": "袁部长来到亭林镇后，参观了工业园地，一路走，一路吟诗，他的秘书将他的诗都记录了下来。",
  "uiIdx": "",
  "range": "848-909",
  "chapterUid": 3
 },
 {
  "level": 3,
  "text": "亭林镇文艺大赛的进行吸引了大量的观众",
  "uiIdx": "1.2",
  "range": "4704-4713",
  "chapterUid": 3
 },
 {
  "level": 4,
  "text": "左小龙没有买到票，只能做一个观众。",
  "uiIdx": "",
  "range": "4704-4713",
  "chapterUid": 3
 },
 {
  "level": 4,
  "text": "聚集在河边，很多没有得到票的观众都聚集在河边，准备听现场直播。",
  "uiIdx": "",
  "range": "2575-2624",
  "chapterUid": 3
 },
 {
  "level": 2,
  "text": "亭林镇文艺大赛的节目单和演出过程",
  "uiIdx": "2",
  "range": "6230-6254",
  "chapterUid": 3
 },
 {
  "level": 3,
  "text": "亭林镇文艺大赛的节目单包括多个不同类型的节目",
  "uiIdx": "2.1",
  "range": "6230-6254",
  "chapterUid": 3
 },
 {
  "level": 4,
  "text": "第一个节目是由妇联选送的歌曲——《我们要结扎》。",
  "uiIdx": "",
  "range": "6230-6254",
  "chapterUid": 3
 },
 {
  "level": 4,
  "text": "第二个节目是由黄花村村委会选送的黄花戏。",
  "uiIdx": "",
  "range": "17795-17838",
  "chapterUid": 3
 },
 {
  "level": 4,
  "text": "第三个节目是由亭林镇幼儿园选送的大班儿童大联唱——完整版的《国际歌》。",
  "uiIdx": "",
  "range": "7371-7406",
  "chapterUid": 3
 },
 {
  "level": 4,
  "text": "第四个节目是黄莹的独唱。",
  "uiIdx": "",
  "range": "11375-11387",
  "chapterUid": 3
 },
 {
  "level": 4,
  "text": "第五个节目是诗朗诵，由亭林镇走出的先锋派现代诗人，诗歌协会副会长亲自上台朗诵，朗诵自己新创作的诗歌——《听话》。",
  "uiIdx": "",
  "range": "11573-11629",
  "chapterUid": 3
 },
 {
  "level": 4,
  "text": "第六个节目是舞蹈，舞蹈的名字叫《跳出和谐的音符》，由电信局选送。",
  "uiIdx": "",
  "range": "12428-12460",
  "chapterUid": 3
 },
 {
  "level": 3,
  "text": "亭林镇文艺大赛的演出过程中，出现了许多感人的场面",
  "uiIdx": "2.2",
  "range": "5967-6015",
  "chapterUid": 3
 },
 {
  "level": 4,
  "text": "刘大虎为了集体，愿意搬迁，王秀梅是一个英雄，是一个为了集体愿意牺牲自己的女中豪杰。",
  "uiIdx": "",
  "range": "5967-6015",
  "chapterUid": 3
 },
 {
  "level": 4,
  "text": "黄莹在舞台上唱了自己的歌曲，得到了观众的认可。",
  "uiIdx": "",
  "range": "11447-11506",
  "chapterUid": 3
 },
 {
  "level": 4,
  "text": "诗人站上台，挺直了腰，润了几下嗓子，对着话筒，说道：灯光暗下来……",
  "uiIdx": "",
  "range": "11656-11682",
  "chapterUid": 3
 },
 {
  "level": 4,
  "text": "亭林镇合唱团，他们汇聚了亭林镇最会唱歌的人，由医生、护士、病人、警察、罪犯、加油站工人、处长、职工、老师、学生组成的上百人的亭林镇合唱团。",
  "uiIdx": "",
  "range": "12516-12605",
  "chapterUid": 3
 },
 {
  "level": 2,
  "text": "亭林镇文艺大赛的结果和影响",
  "uiIdx": "3",
  "range": "1902-1924",
  "chapterUid": 3
 },
 {
  "level": 3,
  "text": "亭林镇文艺大赛的结果，黄莹获得了波波特别奖",
  "uiIdx": "3.1",
  "range": "1902-1924",
  "chapterUid": 3
 },
 {
  "level": 4,
  "text": "黄莹一唱完歌就走了，书记说：你妈在不在现场？工作人员道：在。书记说：让你妈上去，让主持人说这是黄莹的妈，她是来代领的，黄莹身体不舒服先回去了。",
  "uiIdx": "",
  "range": "1902-1924",
  "chapterUid": 3
 },
 {
  "level": 3,
  "text": "亭林镇文艺大赛对亭林镇的影响，旅游业的发展",
  "uiIdx": "3.2",
  "range": "20754-20782",
  "chapterUid": 3
 },
 {
  "level": 4,
  "text": "亭林镇出现了很多大字辈的餐厅，其中以大青蛙餐厅最为有名。",
  "uiIdx": "",
  "range": "20754-20782",
  "chapterUid": 3
 },
 {
  "level": 4,
  "text": "每天来往雕塑园的人也明显增多，因为当地人都想要在这片大野地里抓点野货。",
  "uiIdx": "",
  "range": "20782-20817",
  "chapterUid": 3
 },
 {
  "level": 4,
  "text": "亭林镇开始热闹了起来。和以前都是外地务工人员不同，现在都是大城市里开轿车来猎奇吃鲜的人们。",
  "uiIdx": "",
  "range": "21357-21391",
  "chapterUid": 3
 },
 {
  "level": 2,
  "text": "左小龙的离开和归来",
  "uiIdx": "4",
  "range": "12642-12674",
  "chapterUid": 3
 },
 {
  "level": 3,
  "text": "左小龙离开亭林镇，去实现自己的梦想",
  "uiIdx": "4.1",
  "range": "12642-12674",
  "chapterUid": 3
 },
 {
  "level": 4,
  "text": "左小龙决定开摩托车环游中国。",
  "uiIdx": "",
  "range": "39431-39452",
  "chapterUid": 3
 },
 {
  "level": 4,
  "text": "左小龙对自己的目标充满了信心，他觉得自己将与凡人区别开来，成为一个自命不凡的人。",
  "uiIdx": "",
  "range": "40713-40749",
  "chapterUid": 3
 },
 {
  "level": 3,
  "text": "左小龙回到亭林镇，发现一切都发生了变化",
  "uiIdx": "4.2",
  "range": "53753-53813",
  "chapterUid": 3
 },
 {
  "level": 4,
  "text": "亭林镇变得冷清，人们都戴着墨镜，行动缓慢，需要搀扶。",
  "uiIdx": "",
  "range": "53753-53813",
  "chapterUid": 3
 },
 {
  "level": 4,
  "text": "雕塑园被拆，只剩下萤火虫这个变异的大动物。",
  "uiIdx": "",
  "range": "57021-57040",
  "chapterUid": 3
 },
 {
  "level": 2,
  "text": "亭林镇的未来",
  "uiIdx": "5",
  "range": "55839-55864",
  "chapterUid": 3
 },
 {
  "level": 3,
  "text": "亭林镇的未来充满了不确定性，人们不知道会发生什么",
  "uiIdx": "5.1",
  "range": "55839-55864",
  "chapterUid": 3
 },
 {
  "level": 4,
  "text": "所有食用过变异大动物的人，在三个月后，全都失明了。",
  "uiIdx": "",
  "range": "55839-55864",
  "chapterUid": 3
 },
 {
  "level": 4,
  "text": "亭林镇的领导层一下死绝，上级部门害怕诱发社会不稳定因素，所以这位所长是特地被委以重任来到了亭林镇。",
  "uiIdx": "",
  "range": "32177-32256",
  "chapterUid": 3
 },
 {
  "level": 3,
  "text": "亭林镇的未来，需要左小龙这样的有梦想的人去探索和改变",
