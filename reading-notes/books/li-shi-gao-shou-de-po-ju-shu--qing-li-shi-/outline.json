[
 {
  "level": 1,
  "text": "序章 历史就是智慧的实验室",
  "uiIdx": "",
  "range": "",
  "chapterUid": 3
 },
 {
  "level": 2,
  "text": "历史是智慧的实验室",
  "uiIdx": "1",
  "range": "517-541",
  "chapterUid": 3
 },
 {
  "level": 3,
  "text": "通过阅读史书，可以了解人的本性",
  "uiIdx": "1.1",
  "range": "943-981",
  "chapterUid": 3
 },
 {
  "level": 4,
  "text": "人的本性，在三年五载之内是无法显现出来的，只有三十年以上的时间才能看出端倪。",
  "uiIdx": "",
  "range": "943-981",
  "chapterUid": 3
 },
 {
  "level": 3,
  "text": "历史人物的成功和失败，可以为商业活动提供借鉴",
  "uiIdx": "1.2",
  "range": "1202-1252",
  "chapterUid": 3
 },
 {
  "level": 4,
  "text": "同样的情况，古人已经经历过并且失败了，还把失败的原因记录下来。",
  "uiIdx": "",
  "range": "1202-1252",
  "chapterUid": 3
 },
 {
  "level": 2,
  "text": "本书的原则和读法",
  "uiIdx": "2",
  "range": "1381-1477",
  "chapterUid": 3
 },
 {
  "level": 3,
  "text": "本书的引用都有查证，出处会随文标注",
  "uiIdx": "2.1",
  "range": "1381-1477",
  "chapterUid": 3
 },
 {
  "level": 4,
  "text": "《左传》为《左传》，《史记》为《史记》，无法考证的部分不会出现。",
  "uiIdx": "",
  "range": "1381-1477",
  "chapterUid": 3
 },
 {
  "level": 3,
  "text": "本书并不是一部通史，而是按照智谋的不同种类来分",
  "uiIdx": "2.2",
  "range": "1894-1953",
  "chapterUid": 3
 },
 {
  "level": 4,
  "text": "七章按照智谋的不同种类来分，并不是按照朝代顺序排列。",
  "uiIdx": "",
  "range": "1894-1953",
  "chapterUid": 3
 },
 {
  "level": 3,
  "text": "遇到和课本或者故事中不同的地方的时候，并不是立刻就对人生产生怀疑再去查找原文",
  "uiIdx": "2.3",
  "range": "2123-2192",
  "chapterUid": 3
 },
 {
  "level": 4,
  "text": "历史流传了两千多年，每一辈人都会往里面添加一些自己的东西。这本书所做的就是把那些私人添加的部分尽量去掉，把司马迁、左丘明当年所写的那一部分呈现给你。",
  "uiIdx": "",
  "range": "2208-2282",
  "chapterUid": 3
 },
 {
  "level": 2,
  "text": "智谋的理解和应用",
  "uiIdx": "3",
  "range": "2544-2577",
  "chapterUid": 3
 },
 {
  "level": 3,
  "text": "智谋是在资源不足的情况下把事情做得正确的那一种能力",
  "uiIdx": "3.1",
  "range": "2544-2577",
  "chapterUid": 3
 },
 {
  "level": 4,
  "text": "齐桓公手下的士兵比不上楚国那么多，但是仍然成为了霸主。",
  "uiIdx": "",
  "range": "2577-2627",
  "chapterUid": 3
 },
 {
  "level": 4,
  "text": "勾践只剩下会稽这座小山的时候，二十年后他就把吴国给打败了。",
  "uiIdx": "",
  "range": "2627-2656",
  "chapterUid": 3
 },
 {
  "level": 4,
  "text": "刘邦自己说自己的计谋不如张良、后勤工作不如萧何、打仗也不如韩信——但是他最终还是战胜了项羽。",
  "uiIdx": "",
  "range": "2656-2702",
  "chapterUid": 3
 },
 {
  "level": 3,
  "text": "本书结构为七种谋略按照一个“局”的整个生命过程来排列",
  "uiIdx": "3.2",
  "range": "2775-2860",
  "chapterUid": 3
 },
 {
  "level": 4,
  "text": "没有打开的局面就先借势；不利的局面就先隐忍；局要人来做，就得会用人；轮到动手了，弱者要打在对方的软肋上以弱胜强；打不下来的就换种方法，攻心；动手之前，一切都要考虑周全，这是谋定而后动；赢了之后怎么办——这是最高级的学问，急流勇退。",
  "uiIdx": "",
  "range": "2775-2940",
  "chapterUid": 3
 },
 {
  "level": 1,
  "text": "第一章 借力：名誉比兵器更值钱",
  "uiIdx": "",
  "range": "",
  "chapterUid": 3
 },
 {
  "level": 2,
  "text": "齐桓公与管仲的故事",
  "uiIdx": "1",
  "range": "686-731",
  "chapterUid": 3
 },
 {
  "level": 3,
  "text": "管仲在小白回京的路上设下埋伏，射杀小白",
  "uiIdx": "1.1",
  "range": "686-731",
  "chapterUid": 3
 },
 {
  "level": 4,
  "text": "管仲射中小白带钩，小白因此而死掉。",
  "uiIdx": "",
  "range": "1012-1021",
  "chapterUid": 3
 },
 {
  "level": 3,
  "text": "齐桓公即位后，想要杀掉管仲，鲍叔牙阻止了他",
  "uiIdx": "1.2",
  "range": "1130-1201",
  "chapterUid": 3
 },
 {
  "level": 4,
  "text": "鲍叔牙说：“如果要治理齐国的话，那么就是高傒和叔牙两个人了；如果想要称霸的话，那么就只有管仲一个人了。”。",
  "uiIdx": "",
  "range": "1130-1222",
  "chapterUid": 3
 },
 {
  "level": 3,
  "text": "齐桓公最终没有杀掉管仲，反而授予他大夫之职，把国家的大权交给他去管理。",
  "uiIdx": "1.3",
  "range": "1339-1416",
  "chapterUid": 3
 },
 {
  "level": 2,
  "text": "管仲的治国策略",
  "uiIdx": "2",
  "range": "1476-1535",
  "chapterUid": 3
 },
 {
  "level": 3,
  "text": "管仲改革税收制度、官营盐铁、编练军队等",
  "uiIdx": "2.1",
  "range": "1476-1535",
  "chapterUid": 3
 },
 {
  "level": 4,
  "text": "管仲接替齐国之后所做的事情很多。",
  "uiIdx": "",
  "range": "1476-1535",
  "chapterUid": 3
 },
 {
  "level": 3,
  "text": "管仲提出“尊王攘夷”的口号，使齐桓公成为春秋时期第一位霸主",
  "uiIdx": "2.2",
  "range": "1828-1860",
  "chapterUid": 3
 },
 {
  "level": 4,
  "text": "“尊王攘夷”的口号，则是把周天子的名份拿来使用。",
  "uiIdx": "",
  "range": "1828-1860",
  "chapterUid": 3
 },
 {
  "level": 4,
  "text": "齐桓公召集各国诸侯开会，并且打着周王室的旗号；打出“攘夷”的口号，保护中原各国，有理有据。",
  "uiIdx": "",
  "range": "1910-1980",
  "chapterUid": 3
 },
 {
  "level": 2,
  "text": "借势的重要性",
  "uiIdx": "3",
  "range": "2171-2183",
  "chapterUid": 3
 },
 {
  "level": 3,
  "text": "名分是软通货，但是便宜",
  "uiIdx": "3.1",
  "range": "2171-2183",
  "chapterUid": 3
 },
 {
  "level": 4,
  "text": "周天子这块牌子，在其他诸侯眼里就是废纸，但在齐桓公看来却是免检通行证。",
  "uiIdx": "",
  "range": "2183-2218",
  "chapterUid": 3
 },
 {
  "level": 3,
  "text": "势是最便宜的一种资源",
  "uiIdx": "3.2",
  "range": "2517-2565",
  "chapterUid": 3
 },
 {
  "level": 4,
  "text": "有风的时候，连猪都可以飞起来。",
  "uiIdx": "",
  "range": "2565-2621",
  "chapterUid": 3
 },
 {
  "level": 4,
  "text": "管仲的不同之处就在于，他并不是等待着风的到来，而是发现了哪里有风就将自己的旗帜挂在那个地方。",
  "uiIdx": "",
  "range": "2621-2667",
  "chapterUid": 3
 },
 {
  "level": 2,
  "text": "借势的步骤",
  "uiIdx": "4",
  "range": "3094-3154",
  "chapterUid": 3
 },
 {
  "level": 3,
  "text": "盘点：周围的“周天子”还有没有被用过的",
  "uiIdx": "4.1",
  "range": "3094-3154",
  "chapterUid": 3
 },
 {
  "level": 4,
  "text": "也就是行业内公认的、协会、节日、人群共识等等都可以作为候选对象。",
  "uiIdx": "",
  "range": "3094-3154",
  "chapterUid": 3
 },
 {
  "level": 3,
  "text": "抬举：借并不是利用的意思，而是供给的意思",
  "uiIdx": "4.2",
  "range": "3154-3182",
  "chapterUid": 3
 },
 {
  "level": 4,
  "text": "齐桓公对于周王室，在礼仪上从来没有缺失过，缺少的是实际行动。",
  "uiIdx": "",
  "range": "3182-3240",
  "chapterUid": 3
 },
 {
  "level": 3,
  "text": "回礼：借了名声之后就要还个动作",
  "uiIdx": "4.3",
  "range": "3240-3263",
  "chapterUid": 3
 },
 {
  "level": 4,
  "text": "攘夷是替诸侯抵挡刀剑的行为，诸侯才会一而再地前来会盟。",
  "uiIdx": "",
  "range": "3263-3290",
  "chapterUid": 3
 },
 {
  "level": 4,
  "text": "如果一直这样借势而不做任何回报的话，那么势也就死了；每次借一次，每次还一次，势就会越来越活跃。",
  "uiIdx": "",
  "range": "3290-3337",
  "chapterUid": 3
 },
 {
  "level": 1,
  "text": "第二章 隐忍：将刀收好",
  "uiIdx": "",
  "range": "",
  "chapterUid": 3
 },
 {
  "level": 2,
  "text": "越王勾践的隐忍",
  "uiIdx": "1",
  "range": "584-647",
  "chapterUid": 3
 },
 {
  "level": 3,
  "text": "越王勾践被吴国军队围困在会稽山上，选择投降求和",
  "uiIdx": "1.1",
  "range": "584-647",
  "chapterUid": 3
 },
 {
  "level": 4,
  "text": "勾践派大夫文种到吴国营中请求讲和，表示愿意做吴王的臣子，妻子愿意做吴王的妾。",
  "uiIdx": "",
  "range": "691-812",
  "chapterUid": 3
 },
 {
  "level": 3,
  "text": "勾践回到越国后，进行了一系列的忍耐教育",
  "uiIdx": "1.2",
  "range": "1074-1171",
  "chapterUid": 3
 },
 {
  "level": 4,
  "text": "勾践让自己受尽折磨、思念家乡，把胆挂在座位上，无论什么时候都要仰视着它，吃饭的时候也要尝一尝它的味道。",
  "uiIdx": "",
  "range": "1074-1171",
  "chapterUid": 3
 },
 {
  "level": 4,
  "text": "勾践亲自下田耕作、让妻子自己纺纱织布、食物中不放肉、衣服不用贵重材料、谦虚地向有才德的人请教、救济穷人、哀悼死者、和百姓一起劳动。",
  "uiIdx": "",
  "range": "1421-1538",
  "chapterUid": 3
 },
 {
  "level": 3,
  "text": "勾践在忍耐了二十年后，终于找到了复仇的机会",
  "uiIdx": "1.3",
  "range": "1667-1754",
  "chapterUid": 3
 },
 {
  "level": 4,
  "text": "吴王夫差北上争霸、与齐国、晋国在黄池会盟争夺盟主的时候，越国认为时机已经成熟了。",
  "uiIdx": "",
  "range": "1667-1754",
  "chapterUid": 3
 },
 {
  "level": 4,
  "text": "勾践问范蠡可以吗？第一次范蠡回答还没有准备好，一年之后吴军主力全部出动，只剩下老人和小孩以及太子，勾践又问了一遍，范蠡这次回答可以了。",
  "uiIdx": "",
  "range": "1878-1936",
  "chapterUid": 3
 },
 {
  "level": 2,
  "text": "司马懿的隐忍",
  "uiIdx": "2",
  "range": "2192-2266",
  "chapterUid": 3
 },
 {
  "level": 3,
  "text": "司马懿被大将军曹爽架空，选择装病隐忍",
  "uiIdx": "2.1",
  "range": "2192-2266",
  "chapterUid": 3
 },
 {
  "level": 4,
  "text": "司马懿以生病为由，不再参与国家大事。",
  "uiIdx": "",
  "range": "2192-2266",
  "chapterUid": 3
 },
 {
  "level": 4,
  "text": "司马懿在李胜探视时，假装自己病重，让曹爽放松警惕。",
  "uiIdx": "",
  "range": "3056-3086",
  "chapterUid": 3
 },
 {
  "level": 3,
  "text": "司马懿在隐忍了两年左右的时间后，成功发动了高平陵之变",
  "uiIdx": "2.2",
  "range": "3184-3237",
  "chapterUid": 3
 },
 {
  "level": 4,
  "text": "司马懿在城门处把守着，并且控制住了兵器库，又向太后上书，一天之内就完成了政变。",
  "uiIdx": "",
  "range": "3184-3237",
  "chapterUid": 3
 },
 {
  "level": 4,
  "text": "司马懿从此掌握了大权，整个国家都姓上了司马。",
  "uiIdx": "",
  "range": "3237-3267",
  "chapterUid": 3
 },
 {
  "level": 2,
  "text": "隐忍在生意场上的应用",
  "uiIdx": "3",
  "range": "3400-3440",
  "chapterUid": 3
 },
 {
  "level": 3,
  "text": "在商界中，“忍”是最难写的一个字",
  "uiIdx": "3.1",
  "range": "3400-3440",
  "chapterUid": 3
 },
 {
  "level": 4,
  "text": "见过很多企业在不利的情况下犯了两种错误。第一种就是急于表现自己，第二种就是将隐忍当作认怂。",
  "uiIdx": "",
  "range": "3440-3460",
  "chapterUid": 3
 },
 {
  "level": 3,
  "text": "隐忍的时间长短取决于你要等待的事情，而不是你的耐心",
  "uiIdx": "3.2",
  "range": "4116-4142",
  "chapterUid": 3
 },
 {
  "level": 4,
  "text": "勾践忍了二十年，因为他在等待的东西很大——等吴国自己腐烂，等伍子胥被杀、精锐部队死于齐晋、国内只剩下老人小孩。",
  "uiIdx": "",
  "range": "4028-4083",
  "chapterUid": 3
 },
 {
  "level": 4,
  "text": "司马懿只忍了两年，因为他所期待的事物很小且明确——曹爽出城那一天。",
  "uiIdx": "",
  "range": "4083-4116",
  "chapterUid": 3
 },
 {
  "level": 3,
  "text": "隐忍并不是一种痛苦的等待，而是一种观察",
  "uiIdx": "3.3",
  "range": "4193-4240",
  "chapterUid": 3
 },
 {
  "level": 4,
  "text": "观察对手衰败的速度，并在你觉得合适的时候采取行动。",
  "uiIdx": "",
  "range": "4193-4240",
  "chapterUid": 3
 },
 {
  "level": 4,
  "text": "遇到有人劝他“不如和齐国结盟、亲近楚国、依靠晋国，从而加强自己的力量”，一边忍耐着，一边还要给对手递枕头，让他睡得更深——隐忍的学习中有一半是让对手犯错误。",
  "uiIdx": "",
  "range": "4240-4318",
  "chapterUid": 3
 },
 {
  "level": 1,
  "text": "第三章 用人的方法就是雇佣比自己能力强的人来为自己工作",
  "uiIdx": "",
  "range": "",
  "chapterUid": 3
 },
 {
  "level": 2,
  "text": "刘邦的用人之道",
  "uiIdx": "1",
  "range": "535-558",
  "chapterUid": 3
 },
 {
  "level": 3,
  "text": "刘邦认为能用比自己能力强的人来为自己工作是自己取得天下的原因",
  "uiIdx": "1.1",
  "range": "535-558",
  "chapterUid": 3
 },
 {
  "level": 4,
  "text": "刘邦说：“运筹帷幄，决胜千里，我不如张良；安定国家、安抚百姓、供给军需、不断给军队输送粮食，我不如萧何；率领百万大军作战一定胜利、攻城掠地，我不如韩信。这三个人都是人中豪杰，我能使用他们，这就是我取得天下的原因。”。",
  "uiIdx": "",
  "range": "1111-1196",
  "chapterUid": 3
 },
 {
  "level": 3,
  "text": "刘邦认为项羽失败的原因是项羽有范增却不能重用他",
  "uiIdx": "1.2",
  "range": "1196-1220",
  "chapterUid": 3
 },
 {
  "level": 4,
  "text": "刘邦说：“项羽有范增却不能重用他，这也是他被我俘虏的原因。”。",
  "uiIdx": "",
  "range": "1196-1220",
  "chapterUid": 3
 },
 {
  "level": 2,
  "text": "刘邦如何对待人才",
  "uiIdx": "2",
  "range": "1275-1294",
  "chapterUid": 3
 },
 {
  "level": 3,
  "text": "刘邦真心佩服张良、萧何、韩信，认为他们的才能都是自己的",
  "uiIdx": "2.1",
  "range": "1275-1294",
  "chapterUid": 3
 },
 {
  "level": 4,
  "text": "刘邦说：“运筹帷幄、决胜千里，我不如张良；镇国安民、保障粮饷，我不如萧何；统百万之军、战必胜攻必取，我不如韩信。”。",
  "uiIdx": "",
  "range": "1220-1294",
  "chapterUid": 3
 },
 {
  "level": 3,
  "text": "刘邦给人才以足够的重视和信任，让他们愿意为自己工作",
  "uiIdx": "2.2",
  "range": "2301-2326",
  "chapterUid": 3
 },
 {
  "level": 4,
  "text": "刘邦说：“我不是跑去追人，而是去追逃跑的人。”。",
  "uiIdx": "",
  "range": "2301-2326",
  "chapterUid": 3
 },
 {
  "level": 4,
  "text": "刘邦说：“各位将领很容易得到，但是像韩信这样的人才是独一无二的。”。",
  "uiIdx": "",
  "range": "2404-2460",
  "chapterUid": 3
 },
 {
  "level": 2,
  "text": "用人原则的理解和应用",
  "uiIdx": "3",
  "range": "3739-3786",
  "chapterUid": 3
 },
 {
  "level": 3,
  "text": "用人原则是老板要学习的内容，成功之后的自我调节则是有能力的人要学习的内容",
  "uiIdx": "3.1",
  "range": "3739-3786",
  "chapterUid": 3
 },
 {
  "level": 4,
  "text": "刘邦可以驾驭天下的人，天下的人也要在刘邦手下学会如何自我调节。",
  "uiIdx": "",
  "range": "3708-3739",
  "chapterUid": 3
 },
 {
  "level": 3,
  "text": "怎么招人，就决定了这个人怎么来",
  "uiIdx": "3.2",
  "range": "3343-3410",
  "chapterUid": 3
 },
 {
  "level": 4,
  "text": "刘邦最初的做法是给一个管粮食的人的职位，而后来的做法则是斋戒、筑坛、准备礼物——这两者之间的差别并不是在待遇上，而在“被需要的感觉”上。",
  "uiIdx": "",
  "range": "3410-3478",
  "chapterUid": 3
 },
 {
  "level": 1,
  "text": "第四章 以弱胜强：不要在对方的地盘上进行比赛",
  "uiIdx": "",
  "range": "",
  "chapterUid": 3
 },
 {
  "level": 2,
  "text": "曹刿论战",
  "uiIdx": "1",
  "range": "815-855",
  "chapterUid": 3
 },
 {
  "level": 3,
  "text": "曹刿认为官员们眼界狭窄，想不到将来的事情",
  "uiIdx": "1.1",
  "range": "815-855",
  "chapterUid": 3
 },
 {
  "level": 4,
  "text": "曹刿说了一句流传至今的名言：肉食者鄙，未能远谋。",
  "uiIdx": "",
  "range": "768-815",
  "chapterUid": 3
 },
 {
  "level": 3,
  "text": "曹刿认为司法公正是一个国家最宝贵的财富之一，民心",
  "uiIdx": "1.2",
  "range": "1125-1200",
  "chapterUid": 3
 },
 {
  "level": 4,
  "text": "曹刿说：“这是尽了本分的一位君主，可以让他去打一仗。打了之后再听他的。”。",
  "uiIdx": "",
  "range": "1011-1070",
  "chapterUid": 3
 },
 {
  "level": 2,
  "text": "长勺之战",
  "uiIdx": "2",
  "range": "1256-1300",
  "chapterUid": 3
 },
 {
  "level": 3,
  "text": "鲁庄公在长勺之战中采用了曹刿的策略，最终取得胜利",
  "uiIdx": "2.1",
  "range": "1256-1300",
  "chapterUid": 3
 },
 {
  "level": 4,
  "text": "公要击鼓进军的时候，曹刿说：“不可进军。”。",
  "uiIdx": "",
  "range": "1256-1300",
  "chapterUid": 3
 },
 {
  "level": 4,
  "text": "齐国人击鼓三次了。曹刿说：“可以出击了。”。",
  "uiIdx": "",
  "range": "1332-1344",
  "chapterUid": 3
 },
 {
  "level": 4,
  "text": "当庄公要敲鼓进攻的时候，曹刿就说不可以。打了三次鼓之后，曹刿才说可以进攻了。于是齐军大败。",
  "uiIdx": "",
  "range": "1372-1433",
  "chapterUid": 3
 },
 {
  "level": 4,
  "text": "庄公想追赶敌人，曹刿又说不行。于是曹刿下车察看齐军车轮碾出的痕迹，又上车瞭望齐军旗鼓，然后说可以了，于是就追击齐军。",
  "uiIdx": "",
  "range": "1440-1523",
  "chapterUid": 3
 },
 {
  "level": 3,
  "text": "曹刿认为战争靠的是勇气，第一通鼓用来振奋军心，第二通鼓开始衰退，第三通鼓已经耗尽",
  "uiIdx": "2.2",
  "range": "1721-1781",
  "chapterUid": 3
 },
 {
  "level": 4,
  "text": "曹刿说：“一鼓作气”出自《左传》。",
  "uiIdx": "",
  "range": "1523-1569",
  "chapterUid": 3
 },
 {
  "level": 4,
  "text": "对方已经疲惫不堪，而我们还处于最佳状态，因此我们取得了胜利。",
  "uiIdx": "",
  "range": "1781-1811",
  "chapterUid": 3
 },
 {
  "level": 2,
  "text": "田忌赛马",
  "uiIdx": "3",
  "range": "2190-2276",
  "chapterUid": 3
 },
 {
  "level": 3,
  "text": "孙膑通过调整马匹的比赛顺序，帮助田忌赢得了比赛",
  "uiIdx": "3.1",
  "range": "2190-2276",
  "chapterUid": 3
 },
 {
  "level": 4,
  "text": "孙膑提出方案：用对方最好的马去换我们最好的马，用我们的中等马去换对方的中等马，用我们的最差马去换对方最好的马。",
  "uiIdx": "",
  "range": "2190-2341",
  "chapterUid": 3
 },
 {
  "level": 4,
  "text": "三局两胜制，田忌获胜后得到了一千斤粮食作为奖赏。",
  "uiIdx": "",
  "range": "2341-2388",
  "chapterUid": 3
 },
 {
  "level": 3,
  "text": "孙膑认为错位竞争存在的前提是两者之间存在“不是相差一个量级，而是相差半个级别”的差距",
  "uiIdx": "3.2",
  "range": "3236-3275",
  "chapterUid": 3
 },
 {
  "level": 4,
  "text": "相差半个级别可以通过调整结构来弥补；相差一个量级就只能用排列组合的方式来安慰自己了。",
  "uiIdx": "",
  "range": "3275-3317",
  "chapterUid": 3
 },
 {
  "level": 2,
  "text": "生意场上的回声",
  "uiIdx": "4",
  "range": "2626-2633",
  "chapterUid": 3
 },
 {
  "level": 3,
  "text": "弱者失败的原因并不是因为实力弱，而是把所有的力量都用到了对方最薄弱的地方",
  "uiIdx": "4.1",
  "range": "2661-2715",
  "chapterUid": 3
 },
 {
  "level": 4,
  "text": "小公司最容易犯的战略错误就是在对手的地盘上进行比赛。",
  "uiIdx": "",
  "range": "2975-3013",
  "chapterUid": 3
 },
 {
  "level": 4,
  "text": "所有的逆袭案例都有一个共同的特点：找到一个对方“最强的一环”无法触及的地方——可能是价格段、或者是某个小场景、或者是某一群不太主流的用户——然后用自己全部的力量去冲击它。",
  "uiIdx": "",
  "range": "3070-3156",
  "chapterUid": 3
 },
 {
  "level": 3,
  "text": "在动手之前首先要弄清楚自己凭什么赢",
  "uiIdx": "4.2",
  "range": "3535-3553",
  "chapterUid": 3
 },
 {
  "level": 4,
  "text": "曹刿排除了两种可能的答案——用利益来激励或者用虚伪的姿态去博取信任，最终选择了依靠法律公正来获得制度上的信誉。",
  "uiIdx": "",
  "range": "3553-3608",
  "chapterUid": 3
 },
 {
  "level": 4,
  "text": "用今天的话来说就是：比赛开始之前要确认自己的基础条件是否良好——用户是否愿意购买、复购是否稳定、承诺的事情是否落实到位。",
  "uiIdx": "",
  "range": "3608-3668",
  "chapterUid": 3
 },
 {
  "level": 3,
  "text": "胜利的时候是最危险的时候，因为胜利会让人们误以为自己已经取得了很大的胜利而盲目地去追击",
  "uiIdx": "4.3",
  "range": "3824-3868",
  "chapterUid": 3
 },
 {
  "level": 4,
  "text": "很多企业在一场胜利之后就趁势扩大自己的势力范围，在没有仔细观察车辙和旗帜的情况下就盲目地去追击敌人。",
  "uiIdx": "",
  "range": "3868-3937",
  "chapterUid": 3
 },
 {
  "level": 1,
  "text": "第五章 以攻心之术来夺取人心，而不是占领城市",
  "uiIdx": "",
  "range": "",
  "chapterUid": 3
 },
 {
  "level": 2,
  "text": "楚庄王绝缨宴的故事",
  "uiIdx": "1",
  "range": "758-887",
  "chapterUid": 3
 },
 {
  "level": 3,
  "text": "楚庄王在宴会上因灯光熄灭，有人拉扯美人衣袖，楚庄王命令所有人摘下帽子，找到那个扯下美人衣袖的人",
  "uiIdx": "1.1",
  "range": "758-887",
  "chapterUid": 3
 },
 {
  "level": 4,
  "text": "楚庄王说道：把酒给一个人喝，让他因为喝醉了而做出不检点的事情来羞辱妇女的贞操吗？我去请客喝酒，让客人喝得酩酊大醉，这是不礼貌的行为，难道是为了表现妇女的贞洁，就去侮辱读书人吗？",
  "uiIdx": "",
  "range": "887-1053",
  "chapterUid": 3
 },
 {
  "level": 4,
  "text": "于是他就下了一道命令：今天和我一起喝酒的人，如果帽子上的缨子没有被扯下来的话，那么就不能算是尽兴了。",
  "uiIdx": "",
  "range": "1053-1126",
  "chapterUid": 3
 },
 {
  "level": 3,
  "text": "三年后，楚国与晋国交战，一名大臣每次都冲锋在前，五次交锋五次奋勇当先，带头击退敌人",
  "uiIdx": "1.2",
  "range": "1212-1284",
  "chapterUid": 3
 },
 {
  "level": 4,
  "text": "那个人说：“臣应该被处死，过去的酒后失礼的事情已经过去了，现在王陛下宽容大度没有加罪于臣。”。",
  "uiIdx": "",
  "range": "1326-1395",
  "chapterUid": 3
 },
 {
  "level": 4,
  "text": "楚庄王感到很奇怪：我对你的待遇并没有什么不同寻常的地方，你怎么会为了我而如此卖命呢？",
  "uiIdx": "",
  "range": "1284-1326",
  "chapterUid": 3
 },
 {
  "level": 2,
  "text": "信陵君礼遇侯赢的故事",
  "uiIdx": "2",
  "range": "1876-1949",
  "chapterUid": 3
 },
 {
  "level": 3,
  "text": "信陵君去拜访侯赢，侯赢不肯接受礼物，信陵君改变方式，亲自驾车前来迎接侯赢，并且虚左相待",
  "uiIdx": "2.1",
  "range": "1876-1949",
  "chapterUid": 3
 },
 {
  "level": 4,
  "text": "信陵君用另外一种方法。摆好宴席后宾客很多，信陵君自己驾车来到夷门迎接侯生，并且让车上的座位空出来，按照古代礼仪右边是尊位。",
  "uiIdx": "",
  "range": "1876-1949",
  "chapterUid": 3
 },
 {
  "level": 4,
  "text": "侯赢整理好自己的衣服之后就直接上了车，在空出的位置上坐下，并没有谦让的意思。他这样做是想看看公子怎么样。",
  "uiIdx": "",
  "range": "1949-2024",
  "chapterUid": 3
 },
 {
  "level": 4,
  "text": "信陵君握着马缰，更加恭敬地驾车前行。",
  "uiIdx": "",
  "range": "2024-2042",
  "chapterUid": 3
 },
 {
  "level": 3,
  "text": "侯赢在信陵君离开后，向信陵君推荐朱亥，并告诉信陵君如何夺取晋鄙手下的十万大军来解救赵国",
  "uiIdx": "2.2",
  "range": "2792-2909",
  "chapterUid": 3
 },
 {
  "level": 4,
  "text": "侯赢才说：“今天我为公子做的已经足够了。”。",
  "uiIdx": "",
  "range": "2422-2466",
  "chapterUid": 3
 },
 {
  "level": 4,
  "text": "“如姬可以偷到兵符，假托命令夺取晋鄙手下的十万大军来解救赵国于危难之中，并且推荐朱亥同行——如果晋鄙不肯交出兵权的话，‘可以让他去攻打’。”。",
  "uiIdx": "",
  "range": "2792-2909",
  "chapterUid": 3
 },
 {
  "level": 4,
  "text": "临别时朱亥对他说：“我是市井中人，屠夫而已，公子多次来探望我。”“我之所以不回谢是因为小礼没有用处。”现在公子有急事需要我去帮忙了。",
  "uiIdx": "",
  "range": "2909-2998",
  "chapterUid": 3
 },
 {
  "level": 2,
  "text": "攻心的本质",
  "uiIdx": "3",
  "range": "3265-3321",
  "chapterUid": 3
 },
 {
  "level": 3,
  "text": "打动人心的钱并不是钱本身，而是被人看到、被人忍耐的钱",
  "uiIdx": "3.1",
  "range": "3265-3321",
  "chapterUid": 3
 },
 {
  "level": 4,
  "text": "楚庄王在绝缨宴的时候，他手中握有全场的优势信息——点燃之后就可以一眼看出谁的帽子上没有缨。情报在手却不使用，这是最不合人性的行为，也是成本最高的一次投资。",
  "uiIdx": "",
  "range": "3321-3427",
  "chapterUid": 3
 },
 {
  "level": 4,
  "text": "信陵君整个过程都知道侯嬴在考验自己吗？大概知道吧。老人的一些小聪明——故意坐到前面、故意绕道走、故意站了很久——司马迁写的是“想要看看公子”，大家都看得很清楚。考验摆在明面上，接受考验的人配合演出全过程，这才是真正的本事。装作不明白也不揭穿，让对方的试探得到完整的、体面的回答。很多管理者败就败在反应过快：下属每一个情绪变化、每一次试探都会立刻被发现并揭露——赢得每一场比赛，输掉整个关系。",
  "uiIdx": "",
  "range": "3321-3395",
  "chapterUid": 3
 },
 {
  "level": 2,
  "text": "攻心的定价规律",
  "uiIdx": "4",
  "range": "4191-4230",
  "chapterUid": 3
 },
 {
  "level": 3,
  "text": "攻心的回报周期很长、倍率很高，但是前提条件是你要先放下“短期内不吃亏”的想法",
  "uiIdx": "4.1",
  "range": "4191-4230",
  "chapterUid": 3
 },
 {
  "level": 4,
  "text": "绝缨宴上点灯五秒就可以不吃亏了，虚左这一招就相当于承认自己比不上一个看门人。攻心这门生意的第一步就是当场吃亏。",
  "uiIdx": "",
  "range": "4230-4285",
  "chapterUid": 3
 },
 {
  "level": 2,
  "text": "攻心的真诚性",
  "uiIdx": "5",
  "range": "4331-4400",
  "chapterUid": 3
 },
 {
  "level": 3,
  "text": "攻心并不是收买、权术表演，这两者能够成功的原因，在于他们的行为是真诚的",
  "uiIdx": "5.1",
  "range": "4331-4400",
  "chapterUid": 3
 },
 {
  "level": 4,
  "text": "楚庄王如果在酒席上想着“忍一时之痛，三年后再有人替我承担”，那么他脸上的表情就会暴露出来。",
  "uiIdx": "",
  "range": "4331-4400",
  "chapterUid": 3
 },
 {
  "level": 4,
  "text": "信陵君如果只是做样子的话，那么侯赢七十年的人生经验早就看穿了他的把戏。人心这本账簿上所记载的内容是真假与否，并非金额大小。装模作样的礼贤下士，在被人揭穿之后比没有装模作样还要糟糕。这一部分的工作一半靠技巧，另一半靠真心——技巧是可以学习的，而真心却是无法学到的，只能修炼。",
  "uiIdx": "",
  "range": "4400-4536",
  "chapterUid": 3
 },
 {
  "level": 1,
  "text": "第六章 谋定而后动：先考虑失败的情况，然后再去考虑成功的可能性",
  "uiIdx": "",
  "range": "",
  "chapterUid": 3
 },
 {
  "level": 2,
  "text": "赵惠文王赴渑池之会的原因和准备",
  "uiIdx": "1",
  "range": "805-861",
  "chapterUid": 3
 },
 {
  "level": 3,
  "text": "赵惠文王赴渑池之会，是因为廉颇、蔺相如的劝说",
  "uiIdx": "1.1",
  "range": "805-861",
  "chapterUid": 3
 },
 {
  "level": 4,
  "text": "廉颇、蔺相如认为：如果大王不去的话，就表示着赵国软弱可欺。",
  "uiIdx": "",
  "range": "805-861",
  "chapterUid": 3
 },
 {
  "level": 3,
  "text": "廉颇在赵惠文王出发前，做好了最坏的打算",
  "uiIdx": "1.2",
  "range": "868-957",
  "chapterUid": 3
 },
 {
  "level": 4,
  "text": "廉颇送到边关之后和赵王告别说：“我离开的时候要经过的道路大约有几百里，请允许我在路上遇到的地方举行会盟仪式，在回来之前不超过三十天。如果超过三十天还没有回来的话，就请赵王立太子为王来断绝秦国的念头。”。",
  "uiIdx": "",
  "range": "868-991",
  "chapterUid": 3
 },
 {
  "level": 2,
  "text": "渑池之会的过程和结果",
  "uiIdx": "2",
  "range": "1485-1526",
  "chapterUid": 3
 },
 {
  "level": 3,
  "text": "渑池会上，蔺相如以生命为代价，维护了赵国的尊严",
  "uiIdx": "2.1",
  "range": "1485-1526",
  "chapterUid": 3
 },
 {
  "level": 4,
  "text": "蔺相如上前说道：“赵王私下听说秦王会弹奏秦国音乐，请允许我用盆缶向秦王请教一下。”。",
  "uiIdx": "",
  "range": "1485-1526",
  "chapterUid": 3
 },
 {
  "level": 4,
  "text": "蔺相如回头对赵国的史官说：“这是哪一年哪一月哪一天的事情啊？秦国的国王给赵国的国王敲了下缶。”。",
  "uiIdx": "",
  "range": "1846-1916",
  "chapterUid": 3
 },
 {
  "level": 3,
  "text": "渑池会后，赵国在边关驻扎了大量军队，作为蔺相如的后盾",
  "uiIdx": "2.2",
  "range": "3111-3147",
  "chapterUid": 3
 },
 {
  "level": 4,
  "text": "蔺相如说的每一句话都是悬在空中的一把刀剑，在边关上有一支大军把它接住了。",
  "uiIdx": "",
  "range": "3111-3147",
  "chapterUid": 3
 },
 {
  "level": 2,
  "text": "预案思维在商业谈判中的应用",
  "uiIdx": "3",
  "range": "2574-2610",
  "chapterUid": 3
 },
 {
  "level": 3,
  "text": "预案是具体到天数：“三十日不还，则请立太子为王。”。",
  "uiIdx": "3.1",
  "range": "2574-2610",
  "chapterUid": 3
 },
 {
  "level": 3,
  "text": "一个真预案的标准是它包含一个具体的止损点和一个明确的接替者",
  "uiIdx": "3.2",
  "range": "2645-2675",
  "chapterUid": 3
 },
 {
  "level": 4,
  "text": "没有这两个东西的风险管理页都不算写。",
  "uiIdx": "",
  "range": "2675-2693",
  "chapterUid": 3
 },
 {
  "level": 2,
  "text": "蔺相如的“五步”启示",
  "uiIdx": "4",
  "range": "2693-2772",
  "chapterUid": 3
 },
 {
  "level": 3,
  "text": "在谈判桌上的最佳姿态并不是嗓门最大的时候，而是要让对方知道你所要求的代价是什么",
  "uiIdx": "4.1",
  "range": "2693-2772",
  "chapterUid": 3
 },
 {
  "level": 4,
  "text": "蔺相如的“狠”，其实是有计算的“狠”的：秦王此时如果输了这场因为结盟而引起的战争的话，那么政治成本就会很高；而蔺相如可以承受的风险只有一条生命而已——他在开始的时候就把这条生命纳入了成本之中。",
  "uiIdx": "",
  "range": "2772-2868",
  "chapterUid": 3
 },
 {
  "level": 2,
  "text": "商业谈判中的后路、替代方案、承受能力",
  "uiIdx": "5",
  "range": "2918-2986",
  "chapterUid": 3
 },
 {
  "level": 3,
  "text": "你的后路、你的替代方案、你对于“谈崩”的真实承受能力，决定了你在桌面上可以讲出什么样的话来",
  "uiIdx": "5.1",
  "range": "2918-2986",
  "chapterUid": 3
 },
 {
  "level": 4,
  "text": "蔺相如并不是在渑池会现场突然间产生的勇气——那个“可以死”的预算，在出发之前就已经被批准了。",
  "uiIdx": "",
  "range": "2986-3032",
  "chapterUid": 3
 },
 {
  "level": 2,
  "text": "谈判桌上的力量担保",
  "uiIdx": "6",
  "range": "3147-3173",
  "chapterUid": 3
 },
 {
  "level": 3,
  "text": "桌子上的每一种尖锐的东西都要用桌子外面的力量做担保",
  "uiIdx": "6.1",
  "range": "3147-3173",
  "chapterUid": 3
 },
 {
  "level": 4,
  "text": "没有这个担保的话，同样的话语就会变成自杀。",
  "uiIdx": "",
  "range": "3173-3194",
  "chapterUid": 3
 },
 {
  "level": 2,
  "text": "将相和的故事",
  "uiIdx": "7",
  "range": "3717-3762",
  "chapterUid": 3
 },
 {
  "level": 3,
  "text": "蔺相如以国家利益为重，避开廉颇的羞辱",
  "uiIdx": "7.1",
  "range": "3717-3762",
  "chapterUid": 3
 },
 {
  "level": 4,
  "text": "蔺相如问大家：廉颇和秦王相比，哪一个更厉害？",
  "uiIdx": "",
  "range": "3717-3762",
  "chapterUid": 3
 },
 {
  "level": 4,
  "text": "蔺相如说：“凭着秦王那样的威势，在朝廷上呵斥他，羞辱他的大臣们。我没有用处了，难道还会害怕廉将军吗？”。",
  "uiIdx": "",
  "range": "3762-3902",
  "chapterUid": 3
 },
 {
  "level": 3,
  "text": "廉颇认识到蔺相如的宽宏大量，自感惭愧，向蔺相如请罪",
  "uiIdx": "7.2",
  "range": "4106-4188",
  "chapterUid": 3
 },
 {
  "level": 4,
  "text": "廉颇听说后，脱去上衣，背着荆条，登门向蔺相如请罪，并且说了一句流传至今的话：“我是个粗人，不知道将军能这样宽宏大量。”。",
  "uiIdx": "",
  "range": "4106-4188",
  "chapterUid": 3
 },
 {
  "level": 1,
  "text": "第七章 急流勇退：最好的进攻方式就是撤退",
  "uiIdx": "",
  "range": "",
  "chapterUid": 3
 },
 {
  "level": 2,
  "text": "范蠡的急流勇退",
  "uiIdx": "1",
  "range": "617-652",
  "chapterUid": 3
 },
 {
  "level": 3,
  "text": "范蠡在越国打败吴国后，选择离开",
  "uiIdx": "1.1",
  "range": "617-652",
  "chapterUid": 3
 },
 {
  "level": 4,
  "text": "范蠡在庆功宴上向勾践提出离开的请求。",
  "uiIdx": "",
  "range": "617-652",
  "chapterUid": 3
 },
 {
  "level": 4,
  "text": "范蠡离开时给老同事文种写了封信，这封信成了中国历史上被引用次数最多的一封“辞职信”。",
  "uiIdx": "",
  "range": "1114-1222",
  "chapterUid": 3
 },
 {
  "level": 3,
  "text": "范蠡离开越国后，改名为鸱夷子皮，在齐国开垦荒地、种田养息、父子俩一起经营产业，没过多久就积累了几十万资产",
  "uiIdx": "1.2",
  "range": "1645-1702",
  "chapterUid": 3
 },
 {
  "level": 4,
  "text": "齐国人听说了他的才能和名声，请他去做宰相。",
  "uiIdx": "",
  "range": "1702-1723",
  "chapterUid": 3
 },
 {
  "level": 4,
  "text": "范蠡感慨地说：“在家的时候可以积累上千斤黄金，在朝中就可以做到卿相，这就是平民所能达到的最高境界了。长期享有尊贵的地位和名誉是不吉利的。”。",
  "uiIdx": "",
  "range": "1723-1792",
  "chapterUid": 3
 },
 {
  "level": 4,
  "text": "于是他就把相印交还给齐王，把自己的全部财产分给了自己的亲友和乡亲们，并带着贵重的物品悄悄地离开了这里，来到了陶这个地方，因为这里被认为是“天下的中心，贸易往来畅通”的地方，于是他就开始做生意，并且给自己起了个名叫陶朱公的外号。",
  "uiIdx": "",
  "range": "1792-1905",
  "chapterUid": 3
 },
 {
  "level": 4,
  "text": "不久之后，他的家产就达到了亿万。",
  "uiIdx": "",
  "range": "1905-1921",
  "chapterUid": 3
 },
 {
  "level": 2,
  "text": "张良的急流勇退",
  "uiIdx": "2",
  "range": "2430-2475",
  "chapterUid": 3
 },
 {
  "level": 3,
  "text": "张良在刘邦去世后，选择退出朝廷",
  "uiIdx": "2.1",
  "range": "2430-2475",
  "chapterUid": 3
 },
 {
  "level": 4,
  "text": "张良说：“希望放弃人世的事情，想要跟随赤松子出游。”。",
  "uiIdx": "",
  "range": "2430-2475",
  "chapterUid": 3
 },
 {
  "level": 4,
  "text": "吕后掌权、诛杀功臣的时候，张良退出了朝廷，得以善终。",
  "uiIdx": "",
  "range": "2674-2702",
  "chapterUid": 3
 },
 {
  "level": 2,
  "text": "生意场上的回声",
  "uiIdx": "3",
  "range": "2748-2755",
  "chapterUid": 3
 },
 {
  "level": 3,
  "text": "文种的问题并不是因为不够聪明，而是沉没成本幻觉",
  "uiIdx": "3.1",
  "range": "2923-2971",
  "chapterUid": 3
 },
 {
  "level": 4,
  "text": "文种说：“我和大王一起在会稽苦撑了二十年才灭掉吴国，这份功劳总得有个说法吧？离开就等于把这二十年的投资全部打水漂。”。",
  "uiIdx": "",
  "range": "2923-2990",
  "chapterUid": 3
 },
 {
  "level": 3,
  "text": "范蠡三次迁移，这才是本章真正优秀的教材",
  "uiIdx": "3.2",
  "range": "3142-3185",
  "chapterUid": 3
 },
 {
  "level": 4,
  "text": "范蠡说：“不要以为他是退休或者隐居直到去世，而是换个地方再干一番：越国败了之后跑到齐国做生意；齐国宰相辞职之后卖掉全部财产来到陶地，从头做起，赚得盆满钵满。”。",
  "uiIdx": "",
  "range": "3185-3258",
  "chapterUid": 3
 },
 {
  "level": 4,
  "text": "每次离开都很干脆利索，每次到来都是从头开始。这就是最好的连续创业者的样子：把“身份”当作流动资产、把“能力”当作固定资本。",
  "uiIdx": "",
  "range": "3258-3319",
  "chapterUid": 3
 },
 {
  "level": 4,
  "text": "他敢于离开，并不是因为积累了足够的财富，而是积累了足够的能力——能够再次出发并且成功的能力。",
  "uiIdx": "",
  "range": "3319-3365",
  "chapterUid": 3
 },
 {
  "level": 3,
  "text": "张良给出了一条可以执行的明线：布衣之极",
  "uiIdx": "3.3",
  "range": "3392-3435",
  "chapterUid": 3
 },
 {
  "level": 4,
  "text": "张良说：“他考虑的是‘作为普通人应该得到什么’，而不是‘我能得到多少’。往上走的话，每一级都是别人碗里的东西。今天仍然有效：分股份、分功劳、谈待遇，聪明人不问‘我要多少’，只问‘这个位置能拿到什么’。超出的部分就记到高利贷账上了。”。",
  "uiIdx": "",
  "range": "3435-3530",
  "chapterUid": 3
 },
 {
  "level": 1,
  "text": "尾声 道与术",
  "uiIdx": "",
  "range": "",
  "chapterUid": 3
 },
 {
  "level": 2,
  "text": "范蠡和文种的谋略与结局",
  "uiIdx": "1",
  "range": "795-839",
  "chapterUid": 3
 },
 {
  "level": 3,
  "text": "范蠡在功成名就前退出战场，成为陶朱公",
  "uiIdx": "1.1",
  "range": "795-839",
  "chapterUid": 3
 },
 {
  "level": 4,
  "text": "范蠡知道“术”之外还有另外一种东西在起作用——那就是主公的心思。",
  "uiIdx": "",
  "range": "795-839",
  "chapterUid": 3
 },
 {
  "level": 4,
  "text": "范蠡所有的聪明才智都只差一步就可以在交换之前就退出战场了。",
  "uiIdx": "",
  "range": "965-994",
  "chapterUid": 3
 },
 {
  "level": 3,
  "text": "文种留了下来，接受了勾践赐给他的那把宝剑，但最终输光一切",
  "uiIdx": "1.2",
  "range": "727-749",
  "chapterUid": 3
 },
 {
  "level": 4,
  "text": "文种只看了前半部分，赢了一生，最后一把输光一切。",
  "uiIdx": "",
  "range": "1948-1974",
  "chapterUid": 3
 },
 {
  "level": 2,
  "text": "司马懿的智谋与代价",
  "uiIdx": "2",
  "range": "1033-1062",
  "chapterUid": 3
 },
 {
  "level": 3,
  "text": "司马懿在“术”上做得比书中任何一个人更好，但最终失去了这个时代的大背景",
  "uiIdx": "2.1",
  "range": "1033-1062",
  "chapterUid": 3
 },
 {
  "level": 4,
  "text": "司马懿隐忍不发、步步为营，在“术”上做得比书中任何一个人更好。",
  "uiIdx": "",
  "range": "1033-1062",
  "chapterUid": 3
 },
 {
  "level": 4,
  "text": "高平陵之后，司马家族掌握了大权，并且最终接受了禅让，取代了曹魏。",
  "uiIdx": "",
  "range": "1062-1106",
  "chapterUid": 3
 },
 {
  "level": 4,
  "text": "但是翻开《晋书》，从高平陵之变株连的性命开始说起，一直到后来八王之乱、五胡乱华的导火索，这条路走下去所欠下的账单令人触目惊心。",
  "uiIdx": "",
  "range": "1106-1169",
  "chapterUid": 3
 },
 {
  "level": 2,
  "text": "“道”的理解",
  "uiIdx": "3",
  "range": "1299-1347",
  "chapterUid": 3
 },
 {
  "level": 3,
  "text": "“道”大概有三种味道：一味地讲信用，一味地追求分寸，一味就是退场",
  "uiIdx": "3.1",
  "range": "1299-1347",
  "chapterUid": 3
 },
 {
  "level": 4,
  "text": "一味地讲信用。齐桓公能够九次召集诸侯大会的原因是什么？尊王攘夷是手段，但是手段得以施行的基础是它本身能做到——保护周朝、驱逐少数民族、举行盟会的承诺都实现了。",
  "uiIdx": "",
  "range": "1347-1419",
  "chapterUid": 3
 },
 {
  "level": 4,
  "text": "一味地追求分寸，蔺相如给赵国的是“勇”，而不是“狠”：在渑池会上表现得勇敢，在渑池会散之后再收回来——功成名就之后遇到廉颇的挑衅，他就溜之大吉了。",
  "uiIdx": "",
  "range": "1561-1657",
  "chapterUid": 3
 },
 {
  "level": 4,
  "text": "一味就是退场，全书最后一章也是由范蠡来完成。他每次都是在人们最不舍得放弃的时候退出：灭吴之后、功高权重、陶地巨富。",
  "uiIdx": "",
  "range": "1680-1760",
  "chapterUid": 3
 },
 {
  "level": 2,
  "text": "智谋的价格清单",
  "uiIdx": "4",
  "range": "1891-1912",
  "chapterUid": 3
 },
 {
  "level": 3,
  "text": "借势有价、隐忍有价、攻心有价、退场也有价",
  "uiIdx": "4.1",
  "range": "1891-1912",
  "chapterUid": 3
 },
 {
  "level": 4,
  "text": "每一种策略，在道上都有一张账单。",
  "uiIdx": "",
  "range": "1912-1928",
  "chapterUid": 3
 },
 {
  "level": 4,
  "text": "范蠡们懂得了这张账单，所以进退都有余地；而文种们只看了前半部分，赢了一生，最后一把输光一切。",
  "uiIdx": "",
  "range": "1928-1974",
  "chapterUid": 3
 }
]