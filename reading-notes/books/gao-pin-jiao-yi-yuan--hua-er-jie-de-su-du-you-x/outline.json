[
 {
  "level": 1,
  "text": "引言 开眼看世界",
  "uiIdx": "",
  "range": "",
  "chapterUid": 4
 },
 {
  "level": 2,
  "text": "谢尔盖·阿列尼科夫的故事引发对高频交易的思考",
  "uiIdx": "1",
  "range": "419-469",
  "chapterUid": 4
 },
 {
  "level": 3,
  "text": "阿列尼科夫因盗窃高盛计算机代码被捕，引发对高频交易的好奇",
  "uiIdx": "1.1",
  "range": "2625-2658",
  "chapterUid": 4
 },
 {
  "level": 4,
  "text": "阿列尼科夫是俄罗斯人，曾在高盛做过程序员。",
  "uiIdx": "",
  "range": "469-543",
  "chapterUid": 4
 },
 {
  "level": 4,
  "text": "2009年夏天，他刚辞去高盛的工作就被美国联邦调查局逮捕了，美国政府指控他盗窃了高盛的计算机代码。",
  "uiIdx": "",
  "range": "469-543",
  "chapterUid": 4
 },
 {
  "level": 3,
  "text": "高盛的计算机代码对金融市场的重要性，以及阿列尼科夫如何接触到这些代码的，都令人惊讶",
  "uiIdx": "1.2",
  "range": "603-664",
  "chapterUid": 4
 },
 {
  "level": 4,
  "text": "政府检察官认为这个俄罗斯人不应被保释，理由竟然是他们认为高盛的计算机代码会被不法分子用来“不公平地操纵市场”。",
  "uiIdx": "",
  "range": "603-664",
  "chapterUid": 4
 },
 {
  "level": 4,
  "text": "如果这些代码极为宝贵又对金融市场危害很大的话，一个才在高盛工作两年的俄罗斯人又是怎么接触到这些代码的呢？",
  "uiIdx": "",
  "range": "892-944",
  "chapterUid": 4
 },
 {
  "level": 2,
  "text": "作者对金融市场的认识转变",
  "uiIdx": "2",
  "range": "1336-1391",
  "chapterUid": 4
 },
 {
  "level": 3,
  "text": "作者对股市的兴趣始于1987年的股市崩盘",
  "uiIdx": "2.1",
  "range": "1336-1391",
  "chapterUid": 4
 },
 {
  "level": 4,
  "text": "1987年10月19日股市崩盘时，作者正好在位于纽约自由广场一号40层的所罗门兄弟公司的股市交易和销售部门工作。",
  "uiIdx": "",
  "range": "1336-1391",
  "chapterUid": 4
 },
 {
  "level": 4,
  "text": "前一秒还一切正常，下一秒整个美国股市就下跌了22.61个百分点，而且没有人知道原因是什么。",
  "uiIdx": "",
  "range": "1445-1490",
  "chapterUid": 4
 },
 {
  "level": 3,
  "text": "计算机在股市中的作用逐渐增强",
  "uiIdx": "2.2",
  "range": "1490-1531",
  "chapterUid": 4
 },
 {
  "level": 4,
  "text": "在这场股市崩盘中，为了避免客户打电话来要求卖出股票，很多华尔街经纪商干脆不接电话。",
  "uiIdx": "",
  "range": "1490-1531",
  "chapterUid": 4
 },
 {
  "level": 4,
  "text": "1987年的股市危机开启了计算机代替人力的过程，虽然一开始规模不是很大，但随着时间的推移，这个趋势越发明显，最终以股票交易的完全自动化而告终。",
  "uiIdx": "",
  "range": "1608-1679",
  "chapterUid": 4
 },
 {
  "level": 2,
  "text": "金融市场的现状",
  "uiIdx": "3",
  "range": "1832-1887",
  "chapterUid": 4
 },
 {
  "level": 3,
  "text": "市场的操作方式已经发生了根本性的变化",
  "uiIdx": "3.1",
  "range": "1832-1887",
  "chapterUid": 4
 },
 {
  "level": 4,
  "text": "从2007年起，市场里就没有那些穿着有彩色编码马甲、扯着大粗脖子到处吼的家伙了，即使有，他们也起不到什么作用。",
  "uiIdx": "",
  "range": "1832-1887",
  "chapterUid": 4
 },
 {
  "level": 4,
  "text": "美国股市现在都在安保重重的新泽西和芝加哥大楼的黑箱里操作。",
  "uiIdx": "",
  "range": "1931-1960",
  "chapterUid": 4
 },
 {
  "level": 3,
  "text": "市场的公开报告模糊且不靠谱",
  "uiIdx": "3.2",
  "range": "2007-2073",
  "chapterUid": 4
 },
 {
  "level": 4,
  "text": "对于黑箱里所发生事情的公开报告都很模糊而且不怎么靠谱，即使是专家也不能解释其中发生了什么、这些事是什么时候发生的，以及为什么会发生。",
  "uiIdx": "",
  "range": "2007-2073",
  "chapterUid": 4
 },
 {
  "level": 4,
  "text": "对于普通投资者来说，这些就更不可能知道了。",
  "uiIdx": "",
  "range": "2073-2095",
  "chapterUid": 4
 },
 {
  "level": 2,
  "text": "本书的目的和内容",
  "uiIdx": "4",
  "range": "2380-2486",
  "chapterUid": 4
 },
 {
  "level": 3,
  "text": "本书试图解释金融市场的新变化",
  "uiIdx": "4.1",
  "range": "2380-2486",
  "chapterUid": 4
 },
 {
  "level": 4,
  "text": "我们将从小片段开始，比如后金融危机时代的华尔街、金融市场的创新手段、经过编程后完全以客观指令在运行的计算机，以及那些自以为了解华尔街最终却发现并非如此的人们。",
  "uiIdx": "",
  "range": "2380-2486",
  "chapterUid": 4
 },
 {
  "level": 4,
  "text": "在这些人当中，有一个加拿大人站了出来，他就站在这一个个小片段的中央，将所有琐碎的片段拼接成一个连贯的故事。",
  "uiIdx": "",
  "range": "2486-2539",
  "chapterUid": 4
 },
 {
  "level": 3,
  "text": "本书将揭示华尔街的运作方式",
  "uiIdx": "4.2",
  "range": "2539-2596",
  "chapterUid": 4
 },
 {
  "level": 4,
  "text": "他愿意为世人开启一扇窥见美国金融市场的窗户，让人们看到现在这个市场已经变成了什么样子。",
  "uiIdx": "",
  "range": "2539-2596",
  "chapterUid": 4
 },
 {
  "level": 1,
  "text": "第1章 13毫秒的秘密",
  "uiIdx": "",
  "range": "",
  "chapterUid": 4
 },
 {
  "level": 2,
  "text": "光缆铺设的秘密任务",
  "uiIdx": "1",
  "range": "430-493",
  "chapterUid": 4
 },
 {
  "level": 3,
  "text": "2000多名工人夜以继日地铺设一条光缆，将其使命就是将芝加哥南部的数据中心与新泽西北部的股票交易市场连接起来",
  "uiIdx": "1.1",
  "range": "430-493",
  "chapterUid": 4
 },
 {
  "level": 4,
  "text": "所有的工人都只被告知了他们应该知道的那部分信息，以确保没有任何人能泄密。",
  "uiIdx": "",
  "range": "985-1009",
  "chapterUid": 4
 },
 {
  "level": 3,
  "text": "施工人员要想知道他们所挖掘的线路的最终目的，最直接的方法莫过于问斯皮维",
  "uiIdx": "1.2",
  "range": "1598-1634",
  "chapterUid": 4
 },
 {
  "level": 4,
  "text": "斯皮维是典型的南方人，沉默寡言、守口如瓶，心中想法无数却不会向你吐露分毫。",
  "uiIdx": "",
  "range": "1634-1671",
  "chapterUid": 4
 },
 {
  "level": 2,
  "text": "斯皮维发现交易员对速度的渴求",
  "uiIdx": "2",
  "range": "2318-2361",
  "chapterUid": 4
 },
 {
  "level": 3,
  "text": "斯皮维发现交易所实际交易速度和理论可达的最快交易速度之间存在着巨大的差异",
  "uiIdx": "2.1",
  "range": "2318-2361",
  "chapterUid": 4
 },
 {
  "level": 4,
  "text": "按照光纤传输信息的光速计算，一个交易员要想在芝加哥和纽约同时交易，订单数据在两地之间传输一个来回只需12毫秒。",
  "uiIdx": "",
  "range": "2361-2416",
  "chapterUid": 4
 },
 {
  "level": 4,
  "text": "然而，三大主要电信运营商——威瑞森电信(Verizon)、美国电话电报公司(AT&T)和美国第三级通信公司(Level 3)—提供的网络服务数据传输不仅不连续，而且远达不到这一理论最快速度。",
  "uiIdx": "",
  "range": "2445-2544",
  "chapterUid": 4
 },
 {
  "level": 2,
  "text": "斯皮维规划新线路",
  "uiIdx": "3",
  "range": "3111-3166",
  "chapterUid": 4
 },
 {
  "level": 3,
  "text": "斯皮维重新规划了自己的线路，他喜欢称之为“法律允许范围内的最直路径”",
  "uiIdx": "3.1",
  "range": "3111-3166",
  "chapterUid": 4
 },
 {
  "level": 4,
  "text": "通过对各种小路、土路、桥梁、铁路，以及中途可能会碰到的私人停车场、私人庭院和玉米地的利用，斯皮维成功地将现有的电信运营商线路削减了100英里。",
  "uiIdx": "",
  "range": "3166-3237",
  "chapterUid": 4
 },
 {
  "level": 2,
  "text": "美国延展网络公司的成立和运作",
  "uiIdx": "4",
  "range": "4456-4541",
  "chapterUid": 4
 },
 {
  "level": 3,
  "text": "斯皮维成功说服了曾担任网景通信公司首席执行官的杰克逊老乡——吉姆·巴克斯代尔(Jim Barksdale)，来为这条被他估值3亿美元的电缆的铺设工程筹集资金",
  "uiIdx": "4.1",
  "range": "4456-4541",
  "chapterUid": 4
 },
 {
  "level": 4,
  "text": "他们将公司命名为美国延展网络公司(Spread Networks)，却以如东北信息技术公司(Northeastern ITS)或者美国乔布8公司(Job 8)等这样的空壳公司的名义秘密进行工程建设。",
  "uiIdx": "",
  "range": "4541-4640",
  "chapterUid": 4
 },
 {
  "level": 3,
  "text": "施工队离开芝加哥，又穿越了印第安纳和俄亥俄州，工程进展顺利的时候，他们一天就可以在地下铺设二三英里长的线路",
  "uiIdx": "4.2",
  "range": "4805-4828",
  "chapterUid": 4
 },
 {
  "level": 4,
  "text": "而当他们到达宾夕法尼亚西北部时，岩石又阻挡了他们的脚步，进度降低至一天只能铺设几百英尺。",
  "uiIdx": "",
  "range": "4859-4903",
  "chapterUid": 4
 },
 {
  "level": 2,
  "text": "美国延展网络公司销售线路",
  "uiIdx": "5",
  "range": "6528-6562",
  "chapterUid": 4
 },
 {
  "level": 3,
  "text": "他们最终定的价格为每月30万美元，这相当于现有电信线路价格的10倍",
  "uiIdx": "5.1",
  "range": "6528-6562",
  "chapterUid": 4
 },
 {
  "level": 4,
  "text": "前200个愿意提前付款并签订5年租赁合约的交易员，将可以以5年共1 060万美元的优惠价成交。",
  "uiIdx": "",
  "range": "6562-6609",
  "chapterUid": 4
 },
 {
  "level": 3,
  "text": "在华尔街最大的几家银行纷纷签订合约之时，线路出了问题",
  "uiIdx": "5.2",
  "range": "9407-9438",
  "chapterUid": 4
 },
 {
  "level": 4,
  "text": "从芝加哥出发之后，他们在试图挖埋距卡柳梅特河120英尺处的地方时就失败了6次。",
  "uiIdx": "",
  "range": "9493-9532",
  "chapterUid": 4
 },
 {
  "level": 4,
  "text": "就在他们准备放弃时，他们偶然发现了一条已经有一个多世纪历史但却废弃了40年的沟渠。",
  "uiIdx": "",
  "range": "9532-9573",
  "chapterUid": 4
 },
 {
  "level": 4,
  "text": "从西部出发的线路在解决了过河的问题之后又碰到了新的问题：道路走到了分岔点，一段向北延伸，而另一段向南延伸，而如果你想向正东走，那你就无路可走了。",
  "uiIdx": "",
  "range": "10062-10134",
  "chapterUid": 4
 },
 {
  "level": 4,
  "text": "阻挡前路的是两个大型停车场，其中一个属于一家生产上山索道的钢丝索和缆绳的工厂，另一个则属于一家拥有上百年历史的名为“韦斯市场”(We i s Markets)的杂货店。",
  "uiIdx": "",
  "range": "10164-10248",
  "chapterUid": 4
 },
 {
  "level": 1,
  "text": "第2章 谁在操控股市？",
  "uiIdx": "",
  "range": "",
  "chapterUid": 4
 },
 {
  "level": 2,
  "text": "布拉德·胜山的工作经历",
  "uiIdx": "1",
  "range": "2480-2503",
  "chapterUid": 4
 },
 {
  "level": 3,
  "text": "胜山在加拿大皇家银行工作，主要交易科技股和能源股",
  "uiIdx": "1.1",
  "range": "2480-2503",
  "chapterUid": 4
 },
 {
  "level": 4,
  "text": "胜山在多伦多郊区一个白人社区里长大，是当地为数不多的几个亚裔孩子之一。",
  "uiIdx": "",
  "range": "1482-1517",
  "chapterUid": 4
 },
 {
  "level": 4,
  "text": "他以班级最优生的身份从高中毕业后，选择了跟着女朋友和他的橄榄球队友们去了劳里埃大学。",
  "uiIdx": "",
  "range": "2015-2127",
  "chapterUid": 4
 },
 {
  "level": 4,
  "text": "从劳里埃拿着商学院优秀毕业生奖毕业之后，他最终去了加拿大皇家银行当股票交易员。",
  "uiIdx": "",
  "range": "2127-2197",
  "chapterUid": 4
 },
 {
  "level": 3,
  "text": "胜山被晋升为股票交易部门的负责人，手下约有20位交易员",
  "uiIdx": "1.2",
  "range": "2503-2565",
  "chapterUid": 4
 },
 {
  "level": 4,
  "text": "在华尔街的前几年，胜山主要交易科技股和能源股。",
  "uiIdx": "",
  "range": "2480-2503",
  "chapterUid": 4
 },
 {
  "level": 4,
  "text": "因为他对如何创造他所说的“完美市场”很有一番深刻见地而且实施效果良好，他被晋升为股票交易部门的负责人。",
  "uiIdx": "",
  "range": "2503-2565",
  "chapterUid": 4
 },
 {
  "level": 2,
  "text": "美国股市的变迁",
  "uiIdx": "2",
  "range": "8741-8811",
  "chapterUid": 4
 },
 {
  "level": 3,
  "text": "2005年，美国证交会应公众对任人唯亲现象的强烈指责下了命令，于是这两个交易所从原来由成员共有的公共事业公司转制成了以营利为目的的公众公司",
  "uiIdx": "2.1",
  "range": "8741-8811",
  "chapterUid": 4
 },
 {
  "level": 4,
  "text": "自引入竞争后，交易所数量激增。至2008年年初，已经有了13个不同的公开交易所，大多数都位于新泽西州北部。",
  "uiIdx": "",
  "range": "8811-8864",
  "chapterUid": 4
 },
 {
  "level": 3,
  "text": "交易所也在改变盈利模式，推出了一套极其复杂的收费和回扣系统，这一系统被称为“做盘人—接盘人模式”",
  "uiIdx": "2.2",
  "range": "9356-9417",
  "chapterUid": 4
 },
 {
  "level": 4,
  "text": "和很多华尔街产物一样，几乎无人能搞懂它。",
  "uiIdx": "",
  "range": "9417-9437",
  "chapterUid": 4
 },
 {
  "level": 4,
  "text": "在胜山试图解释时，即使是职业投资者也充满困惑。",
  "uiIdx": "",
  "range": "9437-9481",
  "chapterUid": 4
 },
 {
  "level": 2,
  "text": "胜山对股市的困惑",
  "uiIdx": "3",
  "range": "12595-12667",
  "chapterUid": 4
 },
 {
  "level": 3,
  "text": "胜山发现他的电脑屏幕上的市场已不再是真正的市场",
  "uiIdx": "3.1",
  "range": "12595-12667",
  "chapterUid": 4
 },
 {
  "level": 4,
  "text": "他开始设想问题实际出在他们糟糕的交易系统上。",
  "uiIdx": "",
  "range": "8320-8357",
  "chapterUid": 4
 },
 {
  "level": 4,
  "text": "这都已经形成模式了：每次胜山想根据屏幕上的市场情况做出反应时，市场就变了。",
  "uiIdx": "",
  "range": "8357-8394",
  "chapterUid": 4
 },
 {
  "level": 3,
  "text": "胜山对交易所的收费和回扣系统感到困惑",
  "uiIdx": "3.2",
  "range": "10293-10310",
  "chapterUid": 4
 },
 {
  "level": 4,
  "text": "他咨询了很多人，但没人能解释清楚。",
  "uiIdx": "",
  "range": "10293-10310",
  "chapterUid": 4
 },
 {
  "level": 4,
  "text": "更令华尔街上那些向交易所下单的股票经纪人感到困惑的是，各交易所对订单的收费不一并且经常变化。",
  "uiIdx": "",
  "range": "10343-10394",
  "chapterUid": 4
 },
 {
  "level": 2,
  "text": "胜山的调查",
  "uiIdx": "4",
  "range": "15780-15801",
  "chapterUid": 4
 },
 {
  "level": 3,
  "text": "胜山成立了一个调查团队来调查美国股市",
  "uiIdx": "4.1",
  "range": "15780-15801",
  "chapterUid": 4
 },
 {
  "level": 4,
  "text": "他找到了德意志银行的前软件工程师比赵必烈、美国银行电子交易部门的前经理约翰·施瓦尔和22岁的斯坦福大学计算机专业应届毕业生丹·艾森。",
  "uiIdx": "",
  "range": "16045-16151",
  "chapterUid": 4
 },
 {
  "level": 4,
  "text": "接着，他和帕克又去了“金鹅”所在的新泽西州普林斯顿市，打算看看他们当中有没有值得留下的。他们还在那里找到了华裔程序员张光源，这人恰巧就是暗池的代码编写者。",
  "uiIdx": "",
  "range": "16151-16241",
  "chapterUid": 4
 },
 {
  "level": 3,
  "text": "胜山的团队测试了分布在4个不同地点的13个股票交易平台",
  "uiIdx": "4.2",
  "range": "16758-16804",
  "chapterUid": 4
 },
 {
  "level": 4,
  "text": "他们测试了分布在4个不同地点的13个股票交易平台，这些平台分属纽交所、纳斯达克、巴茨和直边。",
  "uiIdx": "",
  "range": "16758-16804",
  "chapterUid": 4
 },
 {
  "level": 4,
  "text": "帕克邀请了一些交易所代表来加拿大皇家银行协助解答一些问题。",
  "uiIdx": "",
  "range": "16804-16833",
  "chapterUid": 4
 },
 {
  "level": 2,
  "text": "胜山的发现",
  "uiIdx": "5",
  "range": "18901-18946",
  "chapterUid": 4
 },
 {
  "level": 3,
  "text": "胜山发现市场上有人在利用订单到达不同交易所的传递用时不同而抢跑赚钱",
  "uiIdx": "5.1",
  "range": "18901-18946",
  "chapterUid": 4
 },
 {
  "level": 4,
  "text": "他向一家交易所下单后，他可以凭要约随意购股。显示在他屏幕上的市场，像过去一样，是真实的市场！",
  "uiIdx": "",
  "range": "17620-17675",
  "chapterUid": 4
 },
 {
  "level": 4,
  "text": "这种信息传递用时很短：理论上来说，从胜山的办公室到巴茨交易所所在地威霍肯的传递用时最短，只需2毫秒；从他办公室到卡特里特的传递用时最长，需要4毫秒。",
  "uiIdx": "",
  "range": "18315-18389",
  "chapterUid": 4
 },
 {
  "level": 3,
  "text": "胜山发现华尔街公司是如何帮助投资者避税的",
  "uiIdx": "5.2",
  "range": "20565-20587",
  "chapterUid": 4
 },
 {
  "level": 4,
  "text": "托尔展示了华尔街公司是如何帮助投资者避税的。虽然没有直接证据，但在吉特林看来，这是证据确凿、足以定罪的。",
  "uiIdx": "",
  "range": "20565-20617",
  "chapterUid": 4
 },
 {
  "level": 4,
  "text": "仅仅是胜山的存在就十足惊人了。吉特林说：“加拿大皇家银行居然有了世界顶尖的电子交易专家，这真是少见，你想象不到世界顶尖的电子交易专家居然会待在那儿。”。",
  "uiIdx": "",
  "range": "20617-20692",
  "chapterUid": 4
 },
 {
  "level": 2,
  "text": "胜山的应对",
  "uiIdx": "6",
  "range": "22152-22183",
  "chapterUid": 4
 },
 {
  "level": 3,
  "text": "胜山向他的上级提出申请，希望批准他发起类似公共信息宣传的活动",
  "uiIdx": "6.1",
  "range": "22152-22183",
  "chapterUid": 4
 },
 {
  "level": 4,
  "text": "他希望站出来告诉所有准备投资美国股票市场的人：他们正要羊入虎口。",
  "uiIdx": "",
  "range": "22183-22215",
  "chapterUid": 4
 },
 {
  "level": 4,
  "text": "他想告诉他们都有哪些新武器可以用来保护自己，但市场已经开始向他施压，让他闭嘴。",
  "uiIdx": "",
  "range": "22215-22254",
  "chapterUid": 4
 },
 {
  "level": 1,
  "text": "第3章 恍然大悟",
  "uiIdx": "",
  "range": "",
  "chapterUid": 4
 },
 {
  "level": 2,
  "text": "罗南·瑞安的背景和经历",
  "uiIdx": "1",
  "range": "1035-1067",
  "chapterUid": 4
 },
 {
  "level": 3,
  "text": "瑞安是个在都柏林出生、长大的爱尔兰人，1990年来到美国",
  "uiIdx": "1.1",
  "range": "1035-1067",
  "chapterUid": 4
 },
 {
  "level": 4,
  "text": "爱尔兰政府派遣他的父亲来纽约游说那些美国公司，希望以税收优惠来吸引它们迁往爱尔兰。",
  "uiIdx": "",
  "range": "1067-1124",
  "chapterUid": 4
 },
 {
  "level": 4,
  "text": "瑞安的父亲花光积蓄在康涅狄格州格林尼治市租了套房子，这样瑞安就可以去格林尼治的公立高中上学。",
  "uiIdx": "",
  "range": "1152-1227",
  "chapterUid": 4
 },
 {
  "level": 3,
  "text": "瑞安在电信行业工作了几年，后来发现他的客户里，华尔街大银行前所未有的多",
  "uiIdx": "1.2",
  "range": "3497-3533",
  "chapterUid": 4
 },
 {
  "level": 4,
  "text": "他遇见了另一位爱尔兰同乡，那人正好在电信巨头微波通讯公司(MCI Communications)的纽约办事处工作。",
  "uiIdx": "",
  "range": "1841-1898",
  "chapterUid": 4
 },
 {
  "level": 4,
  "text": "他被奎斯特通讯(Qwest Communications)挖走，三年之后又被另一家大型电信运营商第三级挖走了。",
  "uiIdx": "",
  "range": "3412-3474",
  "chapterUid": 4
 },
 {
  "level": 2,
  "text": "瑞安如何帮助华尔街公司解决交易速度问题",
  "uiIdx": "2",
  "range": "4860-4927",
  "chapterUid": 4
 },
 {
  "level": 3,
  "text": "瑞安帮助邦蒂富尔信托把电脑从堪萨斯城挪到了瑞迪安兹公司位于新泽西州纳特利的数据中心，此举使该信托公司的延迟从43毫秒缩短至3.8毫秒",
  "uiIdx": "2.1",
  "range": "4860-4927",
  "chapterUid": 4
 },
 {
  "level": 4,
  "text": "邦蒂富尔信托遇到了一个问题：在堪萨斯城和纽约之间进行交易时，判断订单结果——即他们买入卖出了什么——这一过程耗时过长。",
  "uiIdx": "",
  "range": "4183-4242",
  "chapterUid": 4
 },
 {
  "level": 4,
  "text": "瑞安帮助邦蒂富尔信托把电脑从堪萨斯城挪到了瑞迪安兹公司位于新泽西州纳特利的数据中心。",
  "uiIdx": "",
  "range": "4860-4927",
  "chapterUid": 4
 },
 {
  "level": 3,
  "text": "瑞安将“靠近华尔街”的服务做成一门生意，他称之为“靠近服务”(proximity services)",
  "uiIdx": "2.2",
  "range": "5505-5575",
  "chapterUid": 4
 },
 {
  "level": 4,
  "text": "当电缆长度无法再缩短时，人们就会开始关注电缆两端的仪器，比如数据转换器。",
  "uiIdx": "",
  "range": "5664-5700",
  "chapterUid": 4
 },
 {
  "level": 4,
  "text": "人们将交易所内自己光纤管线的长度计算到每一英尺，每6个月就更换一次服务器，一切只是为了那几微秒。",
  "uiIdx": "",
  "range": "5894-5942",
  "chapterUid": 4
 },
 {
  "level": 2,
  "text": "瑞安对华尔街交易系统的理解",
  "uiIdx": "3",
  "range": "11080-11116",
  "chapterUid": 4
 },
 {
  "level": 3,
  "text": "瑞安发现，这些交易员没有注意到信号传到新泽西州那些股票交易所的物理过程",
  "uiIdx": "3.1",
  "range": "11080-11116",
  "chapterUid": 4
 },
 {
  "level": 4,
  "text": "从加拿大皇家银行到新泽西州不同股票交易所的信号传递时间不同，是因为有些交易所本身的地理位置就比较远。",
  "uiIdx": "",
  "range": "11171-11221",
  "chapterUid": 4
 },
 {
  "level": 4,
  "text": "高频交易员的信号从第一个交易平台到达下一个交易平台最快要465微秒，即一眨眼时间的1/200那么长—如果你眨眼够快的话。",
  "uiIdx": "",
  "range": "11221-11281",
  "chapterUid": 4
 },
 {
  "level": 3,
  "text": "瑞安揭示了华尔街交易系统中的内幕，包括经纪商和交易所如何利用交易速度和订单信息来获取利益",
  "uiIdx": "3.2",
  "range": "14408-14437",
  "chapterUid": 4
 },
 {
  "level": 4,
  "text": "经纪商的下单路径就像是牌技差的人一样，都是一眼就能被看穿。",
  "uiIdx": "",
  "range": "14408-14437",
  "chapterUid": 4
 },
 {
  "level": 4,
  "text": "客户(你，或者代表你投资的人)一般对算法和路由程序组成的内部网络一无所知。",
  "uiIdx": "",
  "range": "14273-14379",
  "chapterUid": 4
 },
 {
  "level": 2,
  "text": "瑞安和胜山如何改变华尔街",
  "uiIdx": "4",
  "range": "15406-15500",
  "chapterUid": 4
 },
 {
  "level": 3,
  "text": "瑞安和胜山向投资者揭露了华尔街交易系统的内幕，并帮助他们理解自己的资金是如何被滥用的",
  "uiIdx": "4.1",
  "range": "15406-15500",
  "chapterUid": 4
 },
 {
  "level": 4,
  "text": "他们简要解释了他投钱方式的信息价值是怎样被经纪商和交易所卖给那些高频交易公司以供他们来赚他钱的。",
  "uiIdx": "",
  "range": "15406-15500",
  "chapterUid": 4
 },
 {
  "level": 4,
  "text": "帮助投资者去发现他们资金的实际状况，其意义是革命性的。",
  "uiIdx": "",
  "range": "21612-21646",
  "chapterUid": 4
 },
 {
  "level": 3,
  "text": "他们的努力使得加拿大皇家银行在格林尼治协会股票交易排行榜里排名第一",
  "uiIdx": "4.2",
  "range": "21790-21829",
  "chapterUid": 4
 },
 {
  "level": 4,
  "text": "2009年，加拿大皇家银行还只是第19名，在格林尼治协会股票交易排行榜里垫底。",
  "uiIdx": "",
  "range": "21790-21829",
  "chapterUid": 4
 },
 {
  "level": 4,
  "text": "而到了2010年年末，也就是托尔问世6个月后，加拿大皇家银行排到了第一名。",
  "uiIdx": "",
  "range": "21829-21866",
  "chapterUid": 4
 },
 {
  "level": 1,
  "text": "第4章 追踪“捕食者”",
  "uiIdx": "",
  "range": "",
  "chapterUid": 4
 },
 {
  "level": 2,
  "text": "高频交易员的幕后操作",
  "uiIdx": "1",
  "range": "658-757",
  "chapterUid": 4
 },
 {
  "level": 3,
  "text": "高频交易公司通常与股票交易所关系密切，但很多在华尔街银行工作的人也并不十分清楚这些银行究竟在做什么",
  "uiIdx": "1.1",
  "range": "658-757",
  "chapterUid": 4
 },
 {
  "level": 4,
  "text": "如果你为一家华尔街大银行工作，要想了解其他的银行都在忙什么，最简单的方法莫过于去问那些在其中工作又想跳槽的人。",
  "uiIdx": "",
  "range": "757-812",
  "chapterUid": 4
 },
 {
  "level": 3,
  "text": "美林证券是次级抵押债券的主要缔造者之一，要不是美银证券出手相助，其员工肯定无处安身。然而，在被收购之前，他们给自己发放了一笔巨额奖金，而这笔钱不得不由美银证券承担",
  "uiIdx": "1.2",
  "range": "1881-1917",
  "chapterUid": 4
 },
 {
  "level": 4,
  "text": "更令人难以置信的是，美林证券的这帮人最后居然执掌了美银证券的证券部门，并着手开除了原来的大多数员工，而他们当中的许多人都是美银证券的忠诚好雇员。",
  "uiIdx": "",
  "range": "1881-1917",
  "chapterUid": 4
 },
 {
  "level": 2,
  "text": "约翰·施瓦尔的发现",
  "uiIdx": "2",
  "range": "2503-2571",
  "chapterUid": 4
 },
 {
  "level": 3,
  "text": "施瓦尔发现美林证券的暗池里有越来越多的由高频交易员驱动的交易，美林已形成了一条新的收入链，专门收取高频交易员为获取进入暗池权限而支付的费用",
  "uiIdx": "2.1",
  "range": "2503-2571",
  "chapterUid": 4
 },
 {
  "level": 4,
  "text": "他注意到为美林打造电子交易平台的人成了全公司薪酬最高的几个人之一，以防他辞职单干、建立为高频交易员服务的公司。",
  "uiIdx": "",
  "range": "2571-2626",
  "chapterUid": 4
 },
 {
  "level": 4,
  "text": "美林给证交会发了好几封反对进一步对股市进行管制的信函，他保存了其中一封，上面写道：“尽管近年来市场结构和参与者行为方式发生了巨大变化，但股市实际上仍运转良好。”。",
  "uiIdx": "",
  "range": "2626-2706",
  "chapterUid": 4
 },
 {
  "level": 4,
  "text": "有一天，施瓦尔还听到了这样的传闻：美林专门让一名分析师写报告，证明美林的股票客户可因美林暗池内的交易获利。这一报告显然存在争议。施瓦尔记下了这个传闻，留待日后使用。",
  "uiIdx": "",
  "range": "2706-2759",
  "chapterUid": 4
 },
 {
  "level": 3,
  "text": "施瓦尔认为美国股市正在被非法操纵，他对局势感到焦虑不安，而他焦虑的时间越长，他就越是愤怒",
  "uiIdx": "2.2",
  "range": "4253-4281",
  "chapterUid": 4
 },
 {
  "level": 4,
  "text": "“我简直都要气疯了！”他说，“这些人居然从别人的养老金账户抢钱，我知道是谁在遭殃，就是像我父母一样的人，我必须要查出来到底是谁在搞鬼！”。",
  "uiIdx": "",
  "range": "4281-4349",
  "chapterUid": 4
 },
 {
  "level": 2,
  "text": "创建自己的股票交易所",
  "uiIdx": "3",
  "range": "19761-19772",
  "chapterUid": 4
 },
 {
  "level": 3,
  "text": "胜山提出创建一个由加拿大皇家银行主导的股票交易所",
  "uiIdx": "3.1",
  "range": "19806-19850",
  "chapterUid": 4
 },
 {
  "level": 4,
  "text": "“我们呆坐了一会儿，”帕克说，“基本上就是大家面面相觑。创建自己的股票交易所？怎么做？”。",
  "uiIdx": "",
  "range": "19733-19761",
  "chapterUid": 4
 },
 {
  "level": 3,
  "text": "创建新交易所面临诸多挑战，包括融资、说服华尔街从业者辞职等",
  "uiIdx": "3.2",
  "range": "20106-20157",
  "chapterUid": 4
 },
 {
  "level": 4,
  "text": "“我问自己：我能够找到我需要的人吗？我们在没有收入的情况下能坚持多久？我们的家人会同意我们这么做吗？”。",
  "uiIdx": "",
  "range": "20157-20208",
  "chapterUid": 4
 },
 {
  "level": 4,
  "text": "他还需要说服一大批高薪华尔街从业者辞职，而这些人只能赚取他们当前薪水的零头，甚至可能倒贴工资。",
  "uiIdx": "",
  "range": "20106-20157",
  "chapterUid": 4
 },
 {
  "level": 4,
  "text": "他面临一个严峻的问题：那些控制着近70%投资者订单的华尔街大银行会将订单交给一个真正安全的交易所吗？如果这些掌握绝大多数订单的大银行自身并不追求公平，那么要建立一个标榜公平的交易所实在是太难了。",
  "uiIdx": "",
  "range": "20208-20306",
  "chapterUid": 4
 },
 {
  "level": 1,
  "text": "第5章 高盛机密被偷了",
  "uiIdx": "",
  "range": "",
  "chapterUid": 4
 },
 {
  "level": 2,
  "text": "谢尔盖·阿列尼科夫的早年经历",
  "uiIdx": "1",
  "range": "746-782",
  "chapterUid": 4
 },
 {
  "level": 3,
  "text": "阿列尼科夫在苏联的困境和编程天赋",
  "uiIdx": "1.1",
  "range": "746-782",
  "chapterUid": 4
 },
 {
  "level": 4,
  "text": "政府不允许他学习自己想要学习的东西。",
  "uiIdx": "",
  "range": "746-782",
  "chapterUid": 4
 },
 {
  "level": 4,
  "text": "他是个天生的程序员，编程不仅在挑战智力方面吸引着他，在情感上也同样让他着迷。",
  "uiIdx": "",
  "range": "1187-1219",
  "chapterUid": 4
 },
 {
  "level": 3,
  "text": "阿列尼科夫移民美国后的生活和工作",
  "uiIdx": "1.2",
  "range": "1752-1777",
  "chapterUid": 4
 },
 {
  "level": 4,
  "text": "他来到美国的时候不仅囊中羞涩，也不知道怎样去赚钱。",
  "uiIdx": "",
  "range": "1752-1777",
  "chapterUid": 4
 },
 {
  "level": 4,
  "text": "他在罗格斯大学的计算机科学系，借助一系列工作以及助学金的支持，得以攻读硕士学位。",
  "uiIdx": "",
  "range": "2047-2106",
  "chapterUid": 4
 },
 {
  "level": 4,
  "text": "在IDT的10年里，他一直在设计系统、编写代码，力图将每天数百万个电话都接到最便宜的可用线路上。",
  "uiIdx": "",
  "range": "2161-2209",
  "chapterUid": 4
 },
 {
  "level": 2,
  "text": "阿列尼科夫在高盛的工作和影响",
  "uiIdx": "2",
  "range": "3397-3456",
  "chapterUid": 4
 },
 {
  "level": 3,
  "text": "阿列尼科夫被高盛招聘并提升系统速度",
  "uiIdx": "2.1",
  "range": "3397-3456",
  "chapterUid": 4
 },
 {
  "level": 4,
  "text": "高盛对阿列尼科夫进行了一系列的电话面试，然后把他叫到公司，对他进行了一整天漫长的现场面试。",
  "uiIdx": "",
  "range": "3397-3456",
  "chapterUid": 4
 },
 {
  "level": 4,
  "text": "他加盟高盛的这个时点，无论是对高盛本身还是对于华尔街来说都是历史上有趣的时刻。",
  "uiIdx": "",
  "range": "4884-4923",
  "chapterUid": 4
 },
 {
  "level": 3,
  "text": "阿列尼科夫的工作对高盛的影响",
  "uiIdx": "2.2",
  "range": "7513-7542",
  "chapterUid": 4
 },
 {
  "level": 4,
  "text": "他没有意识到自己实际上是在高盛内部构建了一个高频交易公司。",
  "uiIdx": "",
  "range": "7513-7542",
  "chapterUid": 4
 },
 {
  "level": 4,
  "text": "阿列尼科夫为高盛创造的速度可以被用于多种目的，既可以单纯用于快速执行高盛交易员的策略，又可以被交易员用来攫取暗池内速度更慢的客户订单的利益。",
  "uiIdx": "",
  "range": "7542-7615",
  "chapterUid": 4
 },
 {
  "level": 2,
  "text": "阿列尼科夫的离职和被捕",
  "uiIdx": "3",
  "range": "11115-11140",
  "chapterUid": 4
 },
 {
  "level": 3,
  "text": "阿列尼科夫决定离职并从头开始构建交易平台",
  "uiIdx": "3.1",
  "range": "11115-11140",
  "chapterUid": 4
 },
 {
  "level": 4,
  "text": "他接受了这个工作邀请，并告诉高盛他要离职。",
  "uiIdx": "",
  "range": "11115-11140",
  "chapterUid": 4
 },
 {
  "level": 4,
  "text": "他想念他在电信业的工作环境：“我在IDT时总是能清楚看到我工作的结果，在这里我却总是不断地修补已有的庞大系统，没人给我一个全局视角。”。",
  "uiIdx": "",
  "range": "11293-11359",
  "chapterUid": 4
 },
 {
  "level": 3,
  "text": "阿列尼科夫被捕并被指控盗窃高盛的计算机代码",
  "uiIdx": "3.2",
  "range": "12318-12359",
  "chapterUid": 4
 },
 {
  "level": 4,
  "text": "在飞往芝加哥的旅途中，阿列尼科夫基本一路上都在睡觉。而等他下飞机时，他发现了三个身穿深色衣服的男人正等在婴儿推车和轮椅的专用通道上。他们确认了阿列尼科夫的身份后，自称是美国联邦调查局的，给他戴上了手铐，搜了他的口袋，拿走了他的背包，并让他保持冷静，将他和其他乘客隔离开来。",
  "uiIdx": "",
  "range": "12318-12359",
  "chapterUid": 4
 },
 {
  "level": 4,
  "text": "他被判处了8年联邦监狱监禁，无假释。",
  "uiIdx": "",
  "range": "15127-15145",
  "chapterUid": 4
 },
 {
  "level": 1,
  "text": "第6章 拆台者同盟",
  "uiIdx": "",
  "range": "",
  "chapterUid": 4
 },
 {
  "level": 2,
  "text": "瑞安的背景和决定创建IEX的原因",
  "uiIdx": "1",
  "range": "1406-1447",
  "chapterUid": 4
 },
 {
  "level": 3,
  "text": "瑞安在华尔街工作，对华尔街的本质有所了解",
  "uiIdx": "1.1",
  "range": "1406-1447",
  "chapterUid": 4
 },
 {
  "level": 4,
  "text": "瑞安在加拿大皇家银行工作，年薪50万美元。",
  "uiIdx": "",
  "range": "1954-2005",
  "chapterUid": 4
 },
 {
  "level": 4,
  "text": "瑞安了解到了华尔街的本质，华尔街并不像他想象中那般美好。",
  "uiIdx": "",
  "range": "1406-1447",
  "chapterUid": 4
 },
 {
  "level": 3,
  "text": "瑞安的父亲希望他回家，但他决定冒险创建自己的股票交易所",
  "uiIdx": "1.2",
  "range": "834-874",
  "chapterUid": 4
 },
 {
  "level": 4,
  "text": "瑞安的父亲仍不知道他到底以何谋生，或者就此而言，为什么华尔街大银行会觉得他有用。",
  "uiIdx": "",
  "range": "834-874",
  "chapterUid": 4
 },
 {
  "level": 4,
  "text": "瑞安决定冒一次险，他辞掉了年薪50万美元的电信业工作，转而选择了一份只能赚之前1/3工资的华尔街工作。",
  "uiIdx": "",
  "range": "1954-2005",
  "chapterUid": 4
 },
 {
  "level": 2,
  "text": "IEX的创建过程和挑战",
  "uiIdx": "2",
  "range": "1508-1537",
  "chapterUid": 4
 },
 {
  "level": 3,
  "text": "瑞安、胜山、罗布·帕克和约翰·施瓦尔决定创建IEX，但他们对到底要做何事仍不太清楚",
  "uiIdx": "2.1",
  "range": "1508-1537",
  "chapterUid": 4
 },
 {
  "level": 4,
  "text": "他们轮流回答着同样的问题：“你愿意吗？”。",
  "uiIdx": "",
  "range": "1186-1206",
  "chapterUid": 4
 },
 {
  "level": 4,
  "text": "他们有个大概的思路：以托尔作为核心来打造一个新的交易所，经纪商将订单送进来后由托尔将其送至其他所有交易所。",
  "uiIdx": "",
  "range": "1667-1724",
  "chapterUid": 4
 },
 {
  "level": 3,
  "text": "IEX在创建过程中遇到了资金、人才和监管等多方面的挑战",
  "uiIdx": "2.2",
  "range": "4024-4057",
  "chapterUid": 4
 },
 {
  "level": 4,
  "text": "胜山需要1 000万美元来雇人设计新的股票交易系统并为其编写代码。",
  "uiIdx": "",
  "range": "4024-4057",
  "chapterUid": 4
 },
 {
  "level": 4,
  "text": "IEX需要招募一些特殊人才，如“解谜大王”和熟悉高频交易和股票交易所的人。",
  "uiIdx": "",
  "range": "9202-9243",
  "chapterUid": 4
 },
 {
  "level": 4,
  "text": "IEX的设计能够反映美国股市以及整个金融系统内部运行情况的新信息，这引起了监管机构的关注。",
  "uiIdx": "",
  "range": "18213-18249",
  "chapterUid": 4
 },
 {
  "level": 2,
  "text": "IEX的设计理念和特点",
  "uiIdx": "3",
  "range": "462-500",
  "chapterUid": 4
 },
 {
  "level": 3,
  "text": "IEX的目标不是消灭市场上的鬣狗和秃鹰，而是更加巧妙——消除它们杀戮的机会",
  "uiIdx": "3.1",
  "range": "462-500",
  "chapterUid": 4
 },
 {
  "level": 4,
  "text": "IEX的设计能够消除速度优势，将投资者订单的信息价值降至零。",
  "uiIdx": "",
  "range": "20495-20544",
  "chapterUid": 4
 },
 {
  "level": 4,
  "text": "IEX同时切断了捕食者的食物来源，所有可以直接在交易所交易的机构和个人都不能持有其股份。",
  "uiIdx": "",
  "range": "16884-16903",
  "chapterUid": 4
 },
 {
  "level": 3,
  "text": "IEX的设计理念是公平，所有订单都以相同费用处理，只允许三种订单存在：市价订单、限价订单和中点限价订单",
  "uiIdx": "3.2",
  "range": "17896-17946",
  "chapterUid": 4
 },
 {
  "level": 4,
  "text": "IEX决定向双方都收取同样的费用：每股0.09美分(“9米尔”)。",
  "uiIdx": "",
  "range": "17861-17896",
  "chapterUid": 4
 },
 {
  "level": 4,
  "text": "IEX只允许三种订单存在：市价订单、限价订单和中点限价订单(Mid-Point Peg Order)。",
  "uiIdx": "",
  "range": "17896-17946",
  "chapterUid": 4
 },
 {
  "level": 2,
  "text": "IEX面临的挑战和应对策略",
  "uiIdx": "4",
  "range": "26273-26310",
  "chapterUid": 4
 },
 {
  "level": 3,
  "text": "IEX面临的主要挑战是华尔街大银行的抵制，他们可能会联合起来抵制在IEX上进行交易",
  "uiIdx": "4.1",
  "range": "26273-26310",
  "chapterUid": 4
 },
 {
  "level": 4,
  "text": "华尔街大银行不仅控制着订单及其信息价值，还控制着可能执行这些订单的场所——暗池。",
  "uiIdx": "",
  "range": "20271-20309",
  "chapterUid": 4
 },
 {
  "level": 4,
  "text": "如果华尔街大银行联合起来抵制在IEX上进行交易，那么IEX肯定会胎死腹中。",
  "uiIdx": "",
  "range": "26273-26310",
  "chapterUid": 4
 },
 {
  "level": 3,
  "text": "IEX的应对策略是让投资者了解经纪商将订单送到了何处，以此改变经纪商的行为",
  "uiIdx": "4.2",
  "range": "23579-23630",
  "chapterUid": 4
 },
 {
  "level": 4,
  "text": "IEX可以在交易进行时为投资者提供一个与其经纪商就真实交易情况进行对质的聊天室。",
  "uiIdx": "",
  "range": "26838-26887",
  "chapterUid": 4
 },
 {
  "level": 4,
  "text": "IEX可以告诉买方他们已经这么做了，然后他们再去告诉他们的经纪商——这样应该就够了。",
  "uiIdx": "",
  "range": "26687-26729",
  "chapterUid": 4
 },
 {
  "level": 1,
  "text": "第7章 IEX的选择",
  "uiIdx": "",
  "range": "",
  "chapterUid": 4
 },
 {
  "level": 2,
  "text": "佐兰·佩尔科夫的早年经历和工作",
  "uiIdx": "1",
  "range": "20103-20137",
  "chapterUid": 4
 },
 {
  "level": 3,
  "text": "佩尔科夫在2001年9月11日亲历了纽约世贸中心的恐怖袭击",
  "uiIdx": "1.1",
  "range": "20103-20137",
  "chapterUid": 4
 },
 {
  "level": 4,
  "text": "佩尔科夫在地铁上注意到人们开始互相聊天，然后地铁到了华尔街，他看到第二架飞机撞上世贸南塔。",
  "uiIdx": "",
  "range": "999-1111",
  "chapterUid": 4
 },
 {
  "level": 4,
  "text": "佩尔科夫在公司的前门外，注意到那个每天进门都会看到的美女正在抽烟，她一边抽烟一边哭泣着。",
  "uiIdx": "",
  "range": "1271-1302",
  "chapterUid": 4
 },
 {
  "level": 3,
  "text": "佩尔科夫在纳斯达克工作，负责监控着纳斯达克所有市场的运行",
  "uiIdx": "1.2",
  "range": "4748-4792",
  "chapterUid": 4
 },
 {
  "level": 4,
  "text": "佩尔科夫在纳斯达克工作之后不久，他就搞砸过其中的一个市场，他曾在交易时间内试图改变交易系统。",
  "uiIdx": "",
  "range": "3774-3799",
  "chapterUid": 4
 },
 {
  "level": 4,
  "text": "佩尔科夫负责监控着纳斯达克所有市场的运行，头衔为全球运营部门主管。",
  "uiIdx": "",
  "range": "4748-4792",
  "chapterUid": 4
 },
 {
  "level": 2,
  "text": "IEX的创立和运营",
  "uiIdx": "2",
  "range": "7651-7701",
  "chapterUid": 4
 },
 {
  "level": 3,
  "text": "IEX由唐·博勒曼创立，旨在建立一个公平公正的金融市场",
  "uiIdx": "2.1",
  "range": "7651-7701",
  "chapterUid": 4
 },
 {
  "level": 4,
  "text": "博勒曼知道佩尔科夫是当时一场公司派系斗争的牺牲品，而且更重要的是，他觉得佩尔科夫是他所见过的最好的交易所运行人员。",
  "uiIdx": "",
  "range": "5502-5559",
  "chapterUid": 4
 },
 {
  "level": 4,
  "text": "IEX计划当交易量上升时降低其费用，这一条针对每一个雇用该交易所的人。",
  "uiIdx": "",
  "range": "14592-14647",
  "chapterUid": 4
 },
 {
  "level": 3,
  "text": "IEX在开业第一天交易了568,524股股票，第一周的交易量超过了1,200万股",
  "uiIdx": "2.2",
  "range": "33693-33716",
  "chapterUid": 4
 },
 {
  "level": 4,
  "text": "开业首周的股票交易量超过了1,200万股。此后的每一周，交易量都有些微的增长。直到12月第三周，IEX的周交易量达到5,000万股。",
  "uiIdx": "",
  "range": "33763-33829",
  "chapterUid": 4
 },
 {
  "level": 4,
  "text": "12月18日周三当天，交易量达到11,827,232股。从那时候开始，高盛成功接入了IEX。",
  "uiIdx": "",
  "range": "33829-33875",
  "chapterUid": 4
 },
 {
  "level": 2,
  "text": "IEX对抗华尔街大银行的利益冲突",
  "uiIdx": "3",
  "range": "428-462",
  "chapterUid": 4
 },
 {
  "level": 3,
  "text": "IEX的员工冒着毁掉职业生涯的风险去攻击股市中存在的利益冲突问题",
  "uiIdx": "3.1",
  "range": "428-462",
  "chapterUid": 4
 },
 {
  "level": 4,
  "text": "他们拒绝了可以轻易获得的华尔街大银行的投资，这一切都只是为了避免利益冲突。",
  "uiIdx": "",
  "range": "14351-14388",
  "chapterUid": 4
 },
 {
  "level": 4,
  "text": "支持IEX的投资者重新组建其投资组合，以确保他们不会因为将订单送至交易所而获得私利。",
  "uiIdx": "",
  "range": "14388-14457",
  "chapterUid": 4
 },
 {
  "level": 3,
  "text": "IEX揭露了华尔街大银行通过牺牲客户利益来提高自家暗池交易量的行为",
  "uiIdx": "3.2",
  "range": "23111-23146",
  "chapterUid": 4
 },
 {
  "level": 4,
  "text": "华尔街大银行想把订单送到IEX来，但又不想真的执行，这样就可以暴露投资者的需求，从而推动了宝洁股价的上涨，牺牲了其本应代表的投资者的利益。",
  "uiIdx": "",
  "range": "22319-22377",
  "chapterUid": 4
 },
 {
  "level": 4,
  "text": "华尔街大银行通过在自家暗池交易来增加这些暗池的交易量，这样看起来更好。",
  "uiIdx": "",
  "range": "23111-23146",
  "chapterUid": 4
 },
 {
  "level": 2,
  "text": "IEX的成功和对未来股市的影响",
  "uiIdx": "4",
  "range": "35798-35863",
  "chapterUid": 4
 },
 {
  "level": 3,
  "text": "高盛的加入使得IEX的交易量激增，证明了IEX的公平性和稳定性",
  "uiIdx": "4.1",
  "range": "35798-35863",
  "chapterUid": 4
 },
 {
  "level": 4,
  "text": "高盛的信任带来了回报：市场显示出了其公允性，92%的订单都以中间价成交了，而在华尔街暗池中这一数字只有17%，而公开交易所则更低。",
  "uiIdx": "",
  "range": "35798-35863",
  "chapterUid": 4
 },
 {
  "level": 4,
  "text": "尽管其他华尔街银行还在千方百计地打压他们，但IEX的平均交易规模已经达到了市场平均值的两倍。",
  "uiIdx": "",
  "range": "35863-35909",
  "chapterUid": 4
 },
 {
  "level": 3,
  "text": "IEX的成功可能会促使其他银行改变其行为，推动整个股市的公正性",
  "uiIdx": "4.2",
  "range": "35332-35376",
  "chapterUid": 4
 },
 {
  "level": 4,
  "text": "如果高盛乐意向投资者承认，这个新的市场是最公平和稳定的，那么其他银行也会受到压力而跟进。",
  "uiIdx": "",
  "range": "35332-35376",
  "chapterUid": 4
 },
 {
  "level": 4,
  "text": "流入IEX的订单越多，投资者的体验就会越好，其他银行就越难绕过IEX这个全新的公允的市场。",
  "uiIdx": "",
  "range": "35376-35421",
  "chapterUid": 4
 },
 {
  "level": 1,
  "text": "第8章 蜘蛛和苍蝇",
  "uiIdx": "",
  "range": "",
  "chapterUid": 4
 },
 {
  "level": 2,
  "text": "阿列尼科夫案审判背景及问题",
  "uiIdx": "1",
  "range": "516-559",
  "chapterUid": 4
 },
 {
  "level": 3,
  "text": "阿列尼科夫案缺乏外部知情人士，陪审团对高频交易缺乏了解",
  "uiIdx": "1.1",
  "range": "516-559",
  "chapterUid": 4
 },
 {
  "level": 4,
  "text": "高频交易界是个很小的圈子，那些从事这一行业或者对这一行业有所了解的人都更愿意花时间去赚钱，而不是出庭作证。",
  "uiIdx": "",
  "range": "559-612",
  "chapterUid": 4
 },
 {
  "level": 4,
  "text": "阿列尼科夫案的陪审团大多是高中毕业生，所有的陪审员都缺乏计算机编程经验。",
  "uiIdx": "",
  "range": "1109-1145",
  "chapterUid": 4
 },
 {
  "level": 3,
  "text": "高盛在庭审中的角色是将真相搅得更难让人理解",
  "uiIdx": "1.2",
  "range": "1523-1546",
  "chapterUid": 4
 },
 {
  "level": 4,
  "text": "它派来出庭作证的员工看上去更像控方观点的推销员，而不是一个中立的美国公民。",
  "uiIdx": "",
  "range": "1546-1583",
  "chapterUid": 4
 },
 {
  "level": 2,
  "text": "“二次审判”的举行及其结果",
  "uiIdx": "2",
  "range": "1905-1945",
  "chapterUid": 4
 },
 {
  "level": 3,
  "text": "“二次审判”找来了6名熟悉高盛、高频交易和计算机编程的人作为陪审团和控方的角色",
  "uiIdx": "2.1",
  "range": "1905-1945",
  "chapterUid": 4
 },
 {
  "level": 4,
  "text": "这6个人都是现在这个晦涩难懂的新型股票市场的权威人士，好几个人写过高频交易代码，还有一个人为高盛的高频交易员升级过软件。",
  "uiIdx": "",
  "range": "1945-2004",
  "chapterUid": 4
 },
 {
  "level": 3,
  "text": "“二次审判”中，陪审团认为阿列尼科夫拿走代码的行为一点儿都不可疑，一点儿都不恶劣",
  "uiIdx": "2.2",
  "range": "3239-3278",
  "chapterUid": 4
 },
 {
  "level": 4,
  "text": "使用集成存储库来储存代码以及删除bash历史的行为都很正常。输入自己的密码登录命令行才是最容易被发现也是最关键的。",
  "uiIdx": "",
  "range": "3278-3335",
  "chapterUid": 4
 },
 {
  "level": 4,
  "text": "阿列尼科夫并不像是一个想隐藏自己行踪的人。",
  "uiIdx": "",
  "range": "3335-3361",
  "chapterUid": 4
 },
 {
  "level": 2,
  "text": "阿列尼科夫的个人生活及其对代码的态度",
  "uiIdx": "3",
  "range": "2817-2875",
  "chapterUid": 4
 },
 {
  "level": 3,
  "text": "阿列尼科夫是一个典型的对工作本身而非由此带来的金钱更感兴趣的极客",
  "uiIdx": "3.1",
  "range": "2817-2875",
  "chapterUid": 4
 },
 {
  "level": 4,
  "text": "他对吃毫无兴趣，吃得也极少。",
  "uiIdx": "",
  "range": "2699-2747",
  "chapterUid": 4
 },
 {
  "level": 3,
  "text": "阿列尼科夫对高盛交易业务的性质如此不上心的另一个原因就在于，他的心不在那里",
  "uiIdx": "3.2",
  "range": "5358-5410",
  "chapterUid": 4
 },
 {
  "level": 4,
  "text": "一个自己也一直在写代码的陪审员说：“我觉得热情对一个人来说很重要，当阿列尼科夫谈到代码时，他的眼睛都放光了。”。",
  "uiIdx": "",
  "range": "5410-5465",
  "chapterUid": 4
 },
 {
  "level": 2,
  "text": "高盛对阿列尼科夫起诉的原因及其影响",
  "uiIdx": "4",
  "range": "7223-7272",
  "chapterUid": 4
 },
 {
  "level": 3,
  "text": "高盛起诉阿列尼科夫的原因可能是因为担心联邦调查局会关心他们和他们的奖金",
  "uiIdx": "4.1",
  "range": "7223-7272",
  "chapterUid": 4
 },
 {
  "level": 4,
  "text": "谁会在起火之前就拉响警报呢？只有那些受政治利益驱动的人才会这么做。",
  "uiIdx": "",
  "range": "7272-7317",
  "chapterUid": 4
 },
 {
  "level": 3,
  "text": "阿列尼科夫被捕入狱，对他的生活造成了巨大的影响",
  "uiIdx": "4.2",
  "range": "8135-8169",
  "chapterUid": 4
 },
 {
  "level": 4,
  "text": "在阿列尼科夫被捕之前，他的妻子离开了他，还带走了他们的三个女儿。",
  "uiIdx": "",
  "range": "8135-8169",
  "chapterUid": 4
 },
 {
  "level": 4,
  "text": "阿列尼科夫没有钱，也没有任何人可以依靠。",
  "uiIdx": "",
  "range": "8169-8189",
  "chapterUid": 4
 },
 {
  "level": 4,
  "text": "他在监狱里，每个月获准打300分钟的电话，大多数时间他都是打给孩子，而他的孩子则基本不接他的电话。",
  "uiIdx": "",
  "range": "8534-8587",
  "chapterUid": 4
 },
 {
  "level": 2,
  "text": "阿列尼科夫的最终释放及其反思",
  "uiIdx": "5",
  "range": "9013-9044",
  "chapterUid": 4
 },
 {
  "level": 3,
  "text": "阿列尼科夫的上诉申请终于被第二巡回法院受理，恢复了自由",
  "uiIdx": "5.1",
  "range": "9013-9044",
  "chapterUid": 4
 },
 {
  "level": 4,
  "text": "在他提出上诉当天，法庭就基于他被指控所违犯的法律并不适用于他的情况的立场，恢复了阿列尼科夫的自由。",
  "uiIdx": "",
  "range": "9082-9131",
  "chapterUid": 4
 },
 {
  "level": 3,
  "text": "阿列尼科夫在监狱中的生活，以及他对人生的理解",
  "uiIdx": "5.2",
  "range": "8616-8678",
  "chapterUid": 4
 },
 {
  "level": 4,
  "text": "他发现在那里保身并非难事，甚至找到了可以并且愿意聊天的人。",
  "uiIdx": "",
  "range": "8616-8678",
  "chapterUid": 4
 },
 {
  "level": 4,
  "text": "他在开头是这么写的：如果牢狱生活没有让你精神崩溃的话，那么它给予你的改变就是真的可以让你不再惊慌。",
  "uiIdx": "",
  "range": "10238-10277",
  "chapterUid": 4
 }
]