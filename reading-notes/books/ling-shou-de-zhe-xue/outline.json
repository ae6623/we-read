[
 {
  "level": 1,
  "text": "第1章 序",
  "uiIdx": "",
  "range": "",
  "chapterUid": 2
 },
 {
  "level": 2,
  "text": "养成读懂世间的变化的习惯",
  "uiIdx": "1",
  "range": "631-681",
  "chapterUid": 2
 },
 {
  "level": 3,
  "text": "为捕捉顾客需求的变化而在内心时刻警惕",
  "uiIdx": "1.1",
  "range": "631-681",
  "chapterUid": 2
 },
 {
  "level": 4,
  "text": "大学毕业后，供职于东京出版贩卖公司期间所积累的经验也为我日后的工作打下了坚固的基石。",
  "uiIdx": "",
  "range": "631-681",
  "chapterUid": 2
 },
 {
  "level": 3,
  "text": "从变化预测未来，环环相扣地思索应对变化的方法",
  "uiIdx": "1.2",
  "range": "1088-1134",
  "chapterUid": 2
 },
 {
  "level": 4,
  "text": "例如2013年1月7日，各行各业的高层领导出席了每年例行举办的日本三大经济集团新春联欢会。在被媒体问及今年的经济前景时，大多数人表现出了乐观的态度，只有我提出了需要慎重对待市场的不同意见。",
  "uiIdx": "",
  "range": "784-881",
  "chapterUid": 2
 },
 {
  "level": 2,
  "text": "应对变化，建立“假设”然后“执行”，再对结果进行“验证”",
  "uiIdx": "2",
  "range": "1470-1505",
  "chapterUid": 2
 },
 {
  "level": 3,
  "text": "如果在平日的工作中坚持重复“假设-执行-验证”的过程，那么在不远的未来必将有所斩获",
  "uiIdx": "2.1",
  "range": "1505-1562",
  "chapterUid": 2
 },
 {
  "level": 4,
  "text": "例如7-Eleven正是最好的例证。恰好是距今40年前的1973年，在和美国南方公司(即现在的7-Eleven,Inc.)签订特许加盟协议后，日本第一家真正意义上的便利店于翌年5月15日正式诞生了。此后，7-Eleven逐渐成长为零售行业中首个营业额超过3万亿日元的连锁店(2012年1月)。",
  "uiIdx": "",
  "range": "1591-1735",
  "chapterUid": 2
 },
 {
  "level": 2,
  "text": "7-Eleven的经营方针：灵活应对变化，贯彻基本原则",
  "uiIdx": "3",
  "range": "1735-1773",
  "chapterUid": 2
 },
 {
  "level": 3,
  "text": "7-Eleven之所以经常被同行称为业界的先驱者，其核心因素在于我们从不放过任何细微的变化并能够予以恰当的应对",
  "uiIdx": "3.1",
  "range": "1831-1913",
  "chapterUid": 2
 },
 {
  "level": 4,
  "text": "作为顾客的生活据点，持续“创造便利”的7-Eleven可谓是一个“专门应对变化的行业”。",
  "uiIdx": "",
  "range": "1913-1957",
  "chapterUid": 2
 },
 {
  "level": 2,
  "text": "捕捉变化中的机会，实现机遇",
  "uiIdx": "4",
  "range": "2173-2200",
  "chapterUid": 2
 },
 {
  "level": 3,
  "text": "实现机遇并不需要特殊的才能，关键在于问题意识和思维力",
  "uiIdx": "4.1",
  "range": "2173-2200",
  "chapterUid": 2
 },
 {
  "level": 4,
  "text": "问题意识指能经常主动研究现行的工作模式是不是处于最优的状态。",
  "uiIdx": "",
  "range": "2200-2233",
  "chapterUid": 2
 },
 {
  "level": 4,
  "text": "思维力代表了深层次挖掘事物本质的能力。",
  "uiIdx": "",
  "range": "2233-2253",
  "chapterUid": 2
 },
 {
  "level": 2,
  "text": "应对变化的能力是事业成功的关键",
  "uiIdx": "5",
  "range": "2310-2348",
  "chapterUid": 2
 },
 {
  "level": 3,
  "text": "能否比他人早一步地注意到变化，并找出有效应对的方法，是事业成功与否的分水岭",
  "uiIdx": "5.1",
  "range": "2310-2348",
  "chapterUid": 2
 },
 {
  "level": 4,
  "text": "经济呈现良好兆头的日本社会，今后也将迎来各种各样的变化。",
  "uiIdx": "",
  "range": "2282-2310",
  "chapterUid": 2
 },
 {
  "level": 4,
  "text": "如果没有应对变化的能力，终将被时代无情地淘汰。",
  "uiIdx": "",
  "range": "2348-2376",
  "chapterUid": 2
 },
 {
  "level": 1,
  "text": "第2章 一切从“打破常识”开始",
  "uiIdx": "",
  "range": "",
  "chapterUid": 2
 },
 {
  "level": 2,
  "text": "我的工作“原点”",
  "uiIdx": "1",
  "range": "479-487",
  "chapterUid": 2
 },
 {
  "level": 3,
  "text": "我过去对商品流通业并没有什么兴趣，但我现在身为7&I控股集团的经营负责者",
  "uiIdx": "1.1",
  "range": "517-538",
  "chapterUid": 2
 },
 {
  "level": 4,
  "text": "我曾认为流通行业的工作内容并不适合自己。",
  "uiIdx": "",
  "range": "566-583",
  "chapterUid": 2
 },
 {
  "level": 4,
  "text": "我现在的身份是7&I控股集团的经营负责者。",
  "uiIdx": "",
  "range": "612-695",
  "chapterUid": 2
 },
 {
  "level": 3,
  "text": "我每天努力工作的体验正是我工作的“原点”",
  "uiIdx": "1.2",
  "range": "878-899",
  "chapterUid": 2
 },
 {
  "level": 4,
  "text": "我做任何事都不会半途而废，总是坚持以这样的性格全身心地投入。",
  "uiIdx": "",
  "range": "744-785",
  "chapterUid": 2
 },
 {
  "level": 4,
  "text": "即使是被外界定论为“不可能”的事，我也能不畏艰难、勇敢地发起挑战。",
  "uiIdx": "",
  "range": "785-849",
  "chapterUid": 2
 },
 {
  "level": 2,
  "text": "奇妙的际遇",
  "uiIdx": "2",
  "range": "966-971",
  "chapterUid": 2
 },
 {
  "level": 3,
  "text": "我进入东京出版贩卖公司，后被调往出版科学研究所，掌握统计学和心理学知识",
  "uiIdx": "2.1",
  "range": "1205-1258",
  "chapterUid": 2
 },
 {
  "level": 4,
  "text": "我专心从事于需要熟记出版社名录以及各种图书、杂志特点的见习工作。",
  "uiIdx": "",
  "range": "1071-1144",
  "chapterUid": 2
 },
 {
  "level": 4,
  "text": "在研究所的工作经验对我日后身为经营者的视角起到了至关重要的作用。",
  "uiIdx": "",
  "range": "1205-1258",
  "chapterUid": 2
 },
 {
  "level": 3,
  "text": "我被派到宣传部，担任半月刊《新刊新闻》的编辑工作，并提出收费发行的方式",
  "uiIdx": "2.2",
  "range": "1907-1936",
  "chapterUid": 2
 },
 {
  "level": 4,
  "text": "杂志的编辑方针以新书目录为中心，主要工作是编辑各种介绍最新出版图书的文章。",
  "uiIdx": "",
  "range": "1936-1991",
  "chapterUid": 2
 },
 {
  "level": 4,
  "text": "我向上司提议，是否可以对杂志采用收费发行的方式。",
  "uiIdx": "",
  "range": "2075-2141",
  "chapterUid": 2
 },
 {
  "level": 3,
  "text": "我与评论家大宅壮一的学生们谈起过制作电视节目的计划，并寻找赞助商",
  "uiIdx": "2.3",
  "range": "2529-2572",
  "chapterUid": 2
 },
 {
  "level": 4,
  "text": "那时，我曾和评论家大宅壮一的学生们谈起过制作电视节目的计划。",
  "uiIdx": "",
  "range": "2529-2572",
  "chapterUid": 2
 },
 {
  "level": 4,
  "text": "为此寻找赞助商时，我想起了伊藤洋华堂。",
  "uiIdx": "",
  "range": "2572-2591",
  "chapterUid": 2
 },
 {
  "level": 2,
  "text": "作为管理部门的统筹者",
  "uiIdx": "3",
  "range": "3195-3205",
  "chapterUid": 2
 },
 {
  "level": 3,
  "text": "我兼任了推广、宣传、人事、财务经理等几乎所有管理职务",
  "uiIdx": "3.1",
  "range": "3339-3374",
  "chapterUid": 2
 },
 {
  "level": 4,
  "text": "1963年我刚刚进入经营新兴综合超市的伊藤洋华堂时，公司尚处于发展阶段。",
  "uiIdx": "",
  "range": "3235-3296",
  "chapterUid": 2
 },
 {
  "level": 4,
  "text": "到了20世纪70年代，公司迎来了急速的成长期，仅一年雇佣的应届生就超过了1000人。",
  "uiIdx": "",
  "range": "3296-3339",
  "chapterUid": 2
 },
 {
  "level": 3,
  "text": "我之所以能在日后建立日本第一家真正意义上的便利店——7-Eleven，也是因为没有受制于行业常识的缘故",
  "uiIdx": "3.2",
  "range": "3681-3736",
  "chapterUid": 2
 },
 {
  "level": 4,
  "text": "在下文中我将会详细介绍这一创业历程。",
  "uiIdx": "",
  "range": "3736-3754",
  "chapterUid": 2
 },
 {
  "level": 2,
  "text": "轻松的背后是停滞不前",
  "uiIdx": "4",
  "range": "3805-3815",
  "chapterUid": 2
 },
 {
  "level": 3,
  "text": "大型超市的繁荣期，消费者的消费需求迅速高涨，卖方市场的时代正式来临",
  "uiIdx": "4.1",
  "range": "3867-3905",
  "chapterUid": 2
 },
 {
  "level": 4,
  "text": "1966年后期，大型超市迎来了繁荣期。",
  "uiIdx": "",
  "range": "3845-3867",
  "chapterUid": 2
 },
 {
  "level": 4,
  "text": "这期间伊藤洋华堂趁势加快了开设新门店的速度。",
  "uiIdx": "",
  "range": "3905-3927",
  "chapterUid": 2
 },
 {
  "level": 3,
  "text": "中小零售店经营不善的缘由并不在于大型超市的崛起，而是经营方式已经落后于时代",
  "uiIdx": "4.2",
  "range": "4248-4302",
  "chapterUid": 2
 },
 {
  "level": 4,
  "text": "任何行业都是如此，人们总是习惯性地以为市场上的竞争对手越少越对自己有利，但是，一旦没有了竞争对手，事业往往会止步不前。",
  "uiIdx": "",
  "range": "4340-4390",
  "chapterUid": 2
 },
 {
  "level": 4,
  "text": "以零售行业为例，如果一家店铺的周围没有任何同业竞争者，那么顾客可能只是由于受到交通上的限制，无奈地进店消费，久而久之，店铺经营者将变得得过且过，产生麻痹懈怠的情绪，失去对产品和服务进行变革创新的动力。",
  "uiIdx": "",
  "range": "4390-4490",
  "chapterUid": 2
 },
 {
  "level": 2,
  "text": "邂逅顶级企业",
  "uiIdx": "5",
  "range": "4735-4741",
  "chapterUid": 2
 },
 {
  "level": 3,
  "text": "我在无意间在美国与一家以数字“7”和英文字母“Eleven”构成Logo的小店铺邂逅了",
  "uiIdx": "5.1",
  "range": "4771-4822",
  "chapterUid": 2
 },
 {
  "level": 4,
  "text": "那间小店好比一个小型超市，既有热狗、咖啡等食品，也有香皂、毛巾等一系列的生活杂货，似乎应有尽有，什么都能买到。",
  "uiIdx": "",
  "range": "4990-5045",
  "chapterUid": 2
 },
 {
  "level": 4,
  "text": "原来当时踏入的小店名为便利店，是美国南方公司在北美拥有4000多家连锁店的顶级优秀企业。",
  "uiIdx": "",
  "range": "5121-5187",
  "chapterUid": 2
 },
 {
  "level": 2,
  "text": "来自公司内部的强烈反对",
  "uiIdx": "6",
  "range": "5391-5402",
  "chapterUid": 2
 },
 {
  "level": 3,
  "text": "加盟便利店的提议却遭到了公司内部的强烈反对",
  "uiIdx": "6.1",
  "range": "5432-5457",
  "chapterUid": 2
 },
 {
  "level": 4,
  "text": "大家认为，自从超市出现在消费者的生活里之后，多数商店街上的小店铺都变得门可罗雀，营业额大幅跳水。现在再逆势而行建立小型店，根本是违背商业逻辑的行为。",
  "uiIdx": "",
  "range": "5457-5531",
  "chapterUid": 2
 },
 {
  "level": 4,
  "text": "就连公司外部的业界人士和学者们也纷纷表明了坚决否定的态度。",
  "uiIdx": "",
  "range": "5531-5561",
  "chapterUid": 2
 },
 {
  "level": 2,
  "text": "艰难而漫长的谈判之路",
  "uiIdx": "7",
  "range": "6194-6204",
  "chapterUid": 2
 },
 {
  "level": 3,
  "text": "在获取公司同意后，我于1973年4月得到了直接向美国南方公司的管理层阐述合作计划的机会",
  "uiIdx": "7.1",
  "range": "6252-6296",
  "chapterUid": 2
 },
 {
  "level": 4,
  "text": "为拿到这次谈判机会，我们做足了功课，几乎花费了一年的时间。",
  "uiIdx": "",
  "range": "6325-6354",
  "chapterUid": 2
 },
 {
  "level": 4,
  "text": "对方在谈判中态度强硬，开出了许多令我们难以接受的条件。",
  "uiIdx": "",
  "range": "6649-6679",
  "chapterUid": 2
 },
 {
  "level": 3,
  "text": "在最终谈判中，我们并没有采取任何精妙的战术，而是站在对方的立场思考，提出不能总是执拗于眼前的“费率”问题，应从长远考虑的论点，而这也成为了获得对方理解的关键转折点",
  "uiIdx": "7.2",
  "range": "6649-6679",
  "chapterUid": 2
 },
 {
  "level": 4,
  "text": "结果，对方做出了巨大妥协，同意把费率降至0.6%。",
  "uiIdx": "",
  "range": "7515-7540",
  "chapterUid": 2
 },
 {
  "level": 2,
  "text": "日本首家便利店的诞生",
  "uiIdx": "8",
  "range": "7702-7712",
  "chapterUid": 2
 },
 {
  "level": 3,
  "text": "1974年5月15日，日本首家真正意义上的便利店——“7-Eleven丰洲店”正式开业",
  "uiIdx": "8.1",
  "range": "9333-9381",
  "chapterUid": 2
 },
 {
  "level": 4,
  "text": "新公司运转资金的一部分由员工们的存款和向银行借贷的个人投资构成。",
  "uiIdx": "",
  "range": "8254-8286",
  "chapterUid": 2
 },
 {
  "level": 4,
  "text": "新公司成立后，第一个面临的问题是人员招聘。",
  "uiIdx": "",
  "range": "8339-8360",
  "chapterUid": 2
 },
 {
  "level": 4,
  "text": "经过一番考量，我决定将第1号店直接设定为使用7-Eleven招牌的独立经营加盟店。",
  "uiIdx": "",
  "range": "8678-8719",
  "chapterUid": 2
 },
 {
  "level": 2,
  "text": "密集型选址战略",
  "uiIdx": "9",
  "range": "9633-9640",
  "chapterUid": 2
 },
 {
  "level": 3,
  "text": "密集型选址的开店优势有如下三点：",
  "uiIdx": "9.1",
  "range": "10947-10963",
  "chapterUid": 2
 },
 {
  "level": 4,
  "text": "在一定区域内，提高“7-Eleven”的品牌效应，加深消费者对其的认知度。而认知度又与消费者的信任度挂钩，能促进消费的意愿。",
  "uiIdx": "",
  "range": "10992-11056",
  "chapterUid": 2
 },
 {
  "level": 4,
  "text": "当店铺集中在一定范围时，店与店之间的较短的距离能提升物流和配送的效率。不仅是送货的货车，负责向各加盟店传达总部方针并予以指导的店铺经营顾问在各店铺之间的移动时间也随之缩短，他们有更充裕的时间与店主探讨。",
  "uiIdx": "",
  "range": "11085-11188",
  "chapterUid": 2
 },
 {
  "level": 4,
  "text": "广告和促销宣传更见成效。店铺如果集中在同一区域，不仅能有效节约物流、人工成本，投放一次促销活动的影响力和覆盖率也变得事半功倍。",
  "uiIdx": "",
  "range": "11234-11299",
  "chapterUid": 2
 },
 {
  "level": 2,
  "text": "“有7-Eleven真好！”“全年无休真方便！”",
  "uiIdx": "10",
  "range": "11444-11458",
  "chapterUid": 2
 },
 {
  "level": 3,
  "text": "“有7-Eleven真好”“全年无休真方便”的广告词大获好评",
  "uiIdx": "10.1",
  "range": "11458-11468",
  "chapterUid": 2
 },
 {
  "level": 4,
  "text": "有意加盟的私人商店越来越多，其中有许多和山本同为经营酒坊的私人店主，还专程去他店里咨询情况。",
  "uiIdx": "",
  "range": "11875-11921",
  "chapterUid": 2
 },
 {
  "level": 4,
  "text": "在日均营业额上，7-Eleven比个体店表现出更良好的成长趋势，因此吸引了众多想要仿效山本店长的私人店主。",
  "uiIdx": "",
  "range": "11921-11974",
  "chapterUid": 2
 },
 {
  "level": 2,
  "text": "物流体制改革：推进商品的共同配送",
  "uiIdx": "11",
  "range": "12087-12103",
  "chapterUid": 2
 },
 {
  "level": 3,
  "text": "共同配送颠覆了过去以大批量进货为主的业界惯例，与缩减采购单位的“小额配送”同为7-Eleven全力推行的物流改革",
  "uiIdx": "11.1",
  "range": "12205-12262",
  "chapterUid": 2
 },
 {
  "level": 4,
  "text": "共同配送是指生产厂家、供应商和7-Eleven总部三方通过互相合作，集中原本相对分散的配送路径，从而形成的合理化物流体系。",
  "uiIdx": "",
  "range": "12291-12357",
  "chapterUid": 2
 },
 {
  "level": 4,
  "text": "1980年，日本流通史上首次实现了牛奶的共同配送。",
  "uiIdx": "",
  "range": "13043-13068",
  "chapterUid": 2
 },
 {
  "level": 4,
  "text": "此后，7-Eleven的共同配送体系又获得了飞跃式的成长，主要对产品进行了细分。我们在各个区域设立了共同配送中心，根据产品的不同特性，分成冷冻型(零下20摄氏度)，如冰淇淋；微冷型(5摄氏度)，如牛奶、生菜等；恒温型，如罐头、饮料等；暖温型(20摄氏度)，如面包、饭食等四个温度段进行集约化管理。而这一方式也沿用至今。",
  "uiIdx": "",
  "range": "13043-13245",
  "chapterUid": 2
 },
 {
  "level": 1,
  "text": "第3章 不要受历史经验的牵制",
  "uiIdx": "",
  "range": "",
  "chapterUid": 2
 },
 {
  "level": 2,
  "text": "7-Eleven的日均营业额为什么能领先其他连锁便利店",
  "uiIdx": "1",
  "range": "477-505",
  "chapterUid": 2
 },
 {
  "level": 3,
  "text": "7-Eleven独占鳌头的原因有三：始终贯彻密集型选址战略；具备产品研发与供应的基础体系；注重与员工的直接沟通",
  "uiIdx": "1.1",
  "range": "742-756",
  "chapterUid": 2
 },
 {
  "level": 4,
  "text": "密集型选址战略和产品研发与供应的基础体系已经在第一章有所涉及。",
  "uiIdx": "",
  "range": "873-904",
  "chapterUid": 2
 },
 {
  "level": 4,
  "text": "关于产品研发的内容我也会在第四章作详细解说。",
  "uiIdx": "",
  "range": "904-929",
  "chapterUid": 2
 },
 {
  "level": 4,
  "text": "本章的重点内容是第三点：与员工的直接沟通。",
  "uiIdx": "",
  "range": "958-979",
  "chapterUid": 2
 },
 {
  "level": 2,
  "text": "我们要盯住“客户”而不是竞争对手",
  "uiIdx": "2",
  "range": "1030-1046",
  "chapterUid": 2
 },
 {
  "level": 3,
  "text": "真正的竞争对手并不是其他品牌的便利店，而是不断变化的“客户需求”",
  "uiIdx": "2.1",
  "range": "1076-1115",
  "chapterUid": 2
 },
 {
  "level": 4,
  "text": "如果负责制定公司经营路线的管理高层具备坚定信念，就会给公司员工的工作热情带来正面的影响。",
  "uiIdx": "",
  "range": "1144-1191",
  "chapterUid": 2
 },
 {
  "level": 4,
  "text": "特许经营的商业模式，需要加盟店和总部相辅相成，缺一不可。",
  "uiIdx": "",
  "range": "1220-1248",
  "chapterUid": 2
 },
 {
  "level": 4,
  "text": "在加盟店独立运营的同时，总部也必须做好后援工作，确保每家门店成功取得盈利。",
  "uiIdx": "",
  "range": "1248-1285",
  "chapterUid": 2
 },
 {
  "level": 2,
  "text": "各种会议的存在理由",
  "uiIdx": "3",
  "range": "1516-1525",
  "chapterUid": 2
 },
 {
  "level": 3,
  "text": "会议的目的是直接向店铺经营顾问全员传达总部的经营方针，引导他们更好地成为总部与加盟店之间的沟通桥梁",
  "uiIdx": "3.1",
  "range": "1715-1764",
  "chapterUid": 2
 },
 {
  "level": 4,
  "text": "在东京四谷的7-Eleven总部召开的“区域顾问会议”有别于其他类型，当天会有约2300名负责指导加盟店经营的顾问齐聚一堂。",
  "uiIdx": "",
  "range": "1650-1715",
  "chapterUid": 2
 },
 {
  "level": 4,
  "text": "每次召开区域顾问会议时，我都会出席并发表自己对经营的想法。",
  "uiIdx": "",
  "range": "1764-1793",
  "chapterUid": 2
 },
 {
  "level": 4,
  "text": "行业中将指导连锁加盟店经营的负责人统称为督导，而并非店铺经营顾问。但我却认为店铺经营顾问与督导存在本质上的差别，并且也不在7-Eleven设立督导这一职位。",
  "uiIdx": "",
  "range": "1822-1859",
  "chapterUid": 2
 },
 {
  "level": 4,
  "text": "连锁便利店的督导起源于美国，职能是监察各加盟店是否遵循总部的规则运作。然而我们店铺经营顾问的核心职能则是帮助加盟店提升业绩，是加盟店的重要经营顾问。",
  "uiIdx": "",
  "range": "1987-2061",
  "chapterUid": 2
 },
 {
  "level": 4,
  "text": "如果协助加盟店经营的第一线人员对公司的理念理解得不够透彻，就不能向各个店长准确地传递总部的方针。因此，我坚持定期召集店铺经营顾问全员，在东京总部举行面对面的交流例会。",
  "uiIdx": "",
  "range": "2128-2211",
  "chapterUid": 2
 },
 {
  "level": 4,
  "text": "会议并不只是单方向的传达，只有把握听众的反应，进行双向的沟通，才能让会议时间变得更有价值。",
  "uiIdx": "",
  "range": "2898-2943",
  "chapterUid": 2
 },
 {
  "level": 2,
  "text": "无数次地改变切入口",
  "uiIdx": "4",
  "range": "2994-3003",
  "chapterUid": 2
 },
 {
  "level": 3,
  "text": "坚持不懈地强调同样的话题，看到管理层执著的态度，员工们自然会认识到其中的重要性，将这两点谨记于心",
  "uiIdx": "4.1",
  "range": "3360-3396",
  "chapterUid": 2
 },
 {
  "level": 4,
  "text": "通常情况下，如果重复诉说同一话题，容易引起听众的厌烦情绪，觉得又是老生常谈。",
  "uiIdx": "",
  "range": "3257-3295",
  "chapterUid": 2
 },
 {
  "level": 4,
  "text": "即便如此，这几十年来，我仍然坚持以严肃的口吻向公司员工反复强调着同样的主题。",
  "uiIdx": "",
  "range": "3322-3360",
  "chapterUid": 2
 },
 {
  "level": 4,
  "text": "坚持了几十年的会议中有这样两段插曲。一是在泡沫经济崩溃，日本经济陷入疲软发生的事情。那时便利店行业也受到影响一蹶不振，媒体甚至还提出了“便利店饱和论”。",
  "uiIdx": "",
  "range": "3425-3501",
  "chapterUid": 2
 },
 {
  "level": 4,
  "text": "又比如在某次区域顾问会议上，我说起了当天早报上，一则题为“餐饮连锁店业绩萧条”的报道。报道中写道：“餐饮业被便利店抢走了客源。”。",
  "uiIdx": "",
  "range": "3746-3810",
  "chapterUid": 2
 },
 {
  "level": 4,
  "text": "定期举行的区域顾问会议并不是我一个人的独角戏。会议不仅设置了各个部门共享信息的时间，店铺经营顾问还会发表在加盟店第一线的工作中迸发的灵感和典型事例，并由各地区的店铺经营顾问分组讨论如何把这些内容有效传达至各个分店。",
  "uiIdx": "",
  "range": "4215-4325",
  "chapterUid": 2
 },
 {
  "level": 2,
  "text": "为了成长，必须积极应对变化",
  "uiIdx": "5",
  "range": "4705-4718",
  "chapterUid": 2
 },
 {
  "level": 3,
  "text": "通过面对面的讨论让公司全员共享“理念”，也可以称作是“理念的渗透”",
  "uiIdx": "5.1",
  "range": "4748-4809",
  "chapterUid": 2
 },
 {
  "level": 4,
  "text": "在公司内部如此重视直接沟通的另一个重要理由，就是希望通过面对面的讨论让公司全员共享“理念”，也可以称作是“理念的渗透”。",
  "uiIdx": "",
  "range": "4748-4809",
  "chapterUid": 2
 },
 {
  "level": 4,
  "text": "某位媒体人士曾经发出这样的感慨：“采访7-Eleven时，所有人都和铃木会长一样，把‘为了成长，必须积极应对变化’挂在嘴上。就连加盟店的店长、供货的生产商也都说了同样的话。”。",
  "uiIdx": "",
  "range": "4838-4925",
  "chapterUid": 2
 },
 {
  "level": 4,
  "text": "在我40年间反复强调着同一经营理念的过程中，管理干部的观点自然变得与我一致，并以此为基准指导部下工作。换言之，7-Eleven的全体员工都和我持有相同的经营理念，秉承了共同的行为准则和价值观念。",
  "uiIdx": "",
  "range": "4993-5090",
  "chapterUid": 2
 },
 {
  "level": 2,
  "text": "置身于信息中",
  "uiIdx": "6",
  "range": "5401-5407",
  "chapterUid": 2
 },
 {
  "level": 3,
  "text": "在日常生活中保持发现问题的意识，即使不去刻意地收集信息，有效的信息也会主动出现，帮助我们获得新的想法",
  "uiIdx": "6.1",
  "range": "5805-5872",
  "chapterUid": 2
 },
 {
  "level": 4,
  "text": "比起收集信息，如何运用信息才是关键所在。",
  "uiIdx": "",
  "range": "5872-5895",
  "chapterUid": 2
 },
 {
  "level": 4,
  "text": "为了得到灵感和创意，我平时坚持做两件事。其一是把自己“置身于信息中”。",
  "uiIdx": "",
  "range": "5924-5959",
  "chapterUid": 2
 },
 {
  "level": 4,
  "text": "以当下炙手可热的网上超市为例。我在几十年前就精确预测了“今后必将是网络的时代”，并在公司内逐步筹备。",
  "uiIdx": "",
  "range": "6410-6460",
  "chapterUid": 2
 },
 {
  "level": 2,
  "text": "灵感的获取方法：在众人面前演讲",
  "uiIdx": "7",
  "range": "7002-7017",
  "chapterUid": 2
 },
 {
  "level": 3,
  "text": "演讲这一形式能让头脑在短时间内快速运转，让人灵光乍现",
  "uiIdx": "7.1",
  "range": "7098-7125",
  "chapterUid": 2
 },
 {
  "level": 4,
  "text": "我并不把演讲当作倾吐自身想法的时间，而是利用它整理思维，使想法系统化，将这一过程作为启发创意的源泉。",
  "uiIdx": "",
  "range": "7125-7175",
  "chapterUid": 2
 },
 {
  "level": 4,
  "text": "演讲前我从不事先准备演讲稿，即使有时一周需要发表三四次也同样如此。",
  "uiIdx": "",
  "range": "7387-7420",
  "chapterUid": 2
 },
 {
  "level": 4,
  "text": "我听闻许多企业的领导都会让下属操刀演讲稿，这项多余的工作纯粹是浪费时间。",
  "uiIdx": "",
  "range": "7449-7485",
  "chapterUid": 2
 },
 {
  "level": 2,
  "text": "不能随口说出数值目标",
  "uiIdx": "8",
  "range": "7632-7642",
  "chapterUid": 2
 },
 {
  "level": 3,
  "text": "在经营连锁店的过程中，经常会被外界问及目标开店数或者营业额，但不应在脱离确凿根据的场合下公开宣布目标数值",
  "uiIdx": "8.1",
  "range": "7799-7829",
  "chapterUid": 2
 },
 {
  "level": 4,
  "text": "在2003年创业30周年之际，日本国内的7-Eleven便利店总数突破了1万家，到了2013年则突破了1.5万家，尽管如此，我却从未订立过类似于“要在××年内建立1万家便利店”的目标。",
  "uiIdx": "",
  "range": "7909-8001",
  "chapterUid": 2
 },
 {
  "level": 4,
  "text": "连锁便利店事业的关键并不在于门店总数的多少，最优先考虑的理应是提升每家店铺的品质，这才是我们真正需要达到的“目标”。",
  "uiIdx": "",
  "range": "8030-8088",
  "chapterUid": 2
 },
 {
  "level": 4,
  "text": "如果公司全体成员充分理解把开店目标定为1万家的用意所在，那么公开宣布也未尝不可。不过绝大多数情况都与此相反。如果没有任何把握就贸然提出了一个模棱两可的数字，显然是不可取的行为。",
  "uiIdx": "",
  "range": "8150-8190",
  "chapterUid": 2
 },
 {
  "level": 1,
  "text": "第4章 大多数人反对的事业往往能够获得成功",
  "uiIdx": "",
  "range": "",
  "chapterUid": 2
 },
 {
  "level": 2,
  "text": "大多数人反对的事业往往能够获得成功",
  "uiIdx": "1",
  "range": "422-439",
  "chapterUid": 2
 },
 {
  "level": 3,
  "text": "判断一项事业是否具有可行性，更应该从消费者的立场出发，以消费者的视点，深入考察是否“符合需求”",
  "uiIdx": "1.1",
  "range": "1649-1700",
  "chapterUid": 2
 },
 {
  "level": 4,
  "text": "如果企业没有认识到这一点，人云亦云地设定经营方针的话，最终必将以失败告终。",
  "uiIdx": "",
  "range": "1436-1473",
  "chapterUid": 2
 },
 {
  "level": 3,
  "text": "一旦决定开拓某项事业，就一定要坚持到底",
  "uiIdx": "1.2",
  "range": "1700-1737",
  "chapterUid": 2
 },
 {
  "level": 4,
  "text": "40年间，我每提出建立一个新事业的想法几乎总会遭受外界的强烈反对。",
  "uiIdx": "",
  "range": "1502-1535",
  "chapterUid": 2
 },
 {
  "level": 2,
  "text": "提供便利是最终目标",
  "uiIdx": "2",
  "range": "1788-1797",
  "chapterUid": 2
 },
 {
  "level": 3,
  "text": "7-Eleven在思考如何满足顾客对“便利”的追求时，得出了这样一个结论：如果门店只是单纯地售卖产品，而不能为顾客的生活提供必要的服务，那么即使具备地理位置上的优势，也称不上是一家便利的店",
  "uiIdx": "2.1",
  "range": "1949-2012",
  "chapterUid": 2
 },
 {
  "level": 4,
  "text": "从这一层面出发，我们把视线聚焦在了代收东京电力和东京煤气等公共事业费的服务上。",
  "uiIdx": "",
  "range": "2715-2754",
  "chapterUid": 2
 },
 {
  "level": 4,
  "text": "因为当时并没有如今这样多样化的支付手段，可以便捷地通过信用卡结算或银行卡自动转账完成，所以忙于工作或家庭的消费者，每个月都要特意赶到遥远的金融机构支付水电煤等公共事业费，非常浪费时间。",
  "uiIdx": "",
  "range": "2754-2846",
  "chapterUid": 2
 },
 {
  "level": 4,
  "text": "再者，金融机构每逢周末和节假日都会公休，平时还有营业时间的限制。与此相比，7-Eleven全年无休全天营业，顾客任何时间都可以进店支付，省时又省力。",
  "uiIdx": "",
  "range": "2846-2920",
  "chapterUid": 2
 },
 {
  "level": 2,
  "text": "便利店也能开银行？",
  "uiIdx": "3",
  "range": "2994-3003",
  "chapterUid": 2
 },
 {
  "level": 3,
  "text": "为了顺应顾客的需求，我决定无论如何也应该在店内安装ATM，在90年代后期，我任命员工开始研究实现这一构想的方法",
  "uiIdx": "3.1",
  "range": "3152-3208",
  "chapterUid": 2
 },
 {
  "level": 4,
  "text": "经过调查我们了解到，公司必须取得银行的经营资格才能安装ATM，而最迅速的方法是与既有的金融机构合资成立新公司。",
  "uiIdx": "",
  "range": "3237-3292",
  "chapterUid": 2
 },
 {
  "level": 4,
  "text": "于是，伊藤洋华堂集团(IY Group，即现在的7&I控股集团)的员工与负责推广ATM的都市银行行员，组成以构建ATM共同运营公司为目标的团队，着手进行准备。",
  "uiIdx": "",
  "range": "3292-3375",
  "chapterUid": 2
 },
 {
  "level": 4,
  "text": "另一方面，一个银行的收购项目也进入了我们的视野范围，对于“如何才能在店内安装ATM”这一问题，我们决心彻底寻找出最优解答。",
  "uiIdx": "",
  "range": "3404-3465",
  "chapterUid": 2
 },
 {
  "level": 4,
  "text": "然而，在和银行方面的谈判过程中，双方总是无法达成一致。虽然我们是金融界的门外汉，但身为零售从业者，依然习惯把客户的体验放在第一位。",
  "uiIdx": "",
  "range": "3494-3559",
  "chapterUid": 2
 },
 {
  "level": 4,
  "text": "结果，我们为了能设立7-Eleven自有的ATM，决定放弃合资，转而选择了一条难度系数最大的道路——自行申请银行经营牌照。",
  "uiIdx": "",
  "range": "3715-3776",
  "chapterUid": 2
 },
 {
  "level": 2,
  "text": "外行即使开了银行也注定失败？",
  "uiIdx": "4",
  "range": "4033-4047",
  "chapterUid": 2
 },
 {
  "level": 3,
  "text": "我们所设想的银行和普通银行有两项明显的区别",
  "uiIdx": "4.1",
  "range": "4077-4099",
  "chapterUid": 2
 },
 {
  "level": 4,
  "text": "顾客使用7-Eleven店内的ATM、从特定的金融机构账户取款时所缴纳的手续费是主要的收益来源。",
  "uiIdx": "",
  "range": "4128-4178",
  "chapterUid": 2
 },
 {
  "level": 4,
  "text": "是一家不设立融资业务的狭义银行(即专业结算银行)。",
  "uiIdx": "",
  "range": "4207-4234",
  "chapterUid": 2
 },
 {
  "level": 3,
  "text": "尽管眼前的道路荆棘密布，步履维艰，但只要顾客有实际的需求，就存在挑战的价值",
  "uiIdx": "4.2",
  "range": "4835-4873",
  "chapterUid": 2
 },
 {
  "level": 4,
  "text": "在金融恐慌之中，有人毫不留情地说：“银行都快要破产了，零售业在这个时候蹚浑水实在不合理”或是“各大银行的ATM数量早已处于饱和状态，通过ATM盈利的计划根本是妄想”等等。",
  "uiIdx": "",
  "range": "4474-4566",
  "chapterUid": 2
 },
 {
  "level": 4,
  "text": "而其中，人们发出的最多质疑声就是“外行即使开了银行也注定失败”。",
  "uiIdx": "",
  "range": "4595-4628",
  "chapterUid": 2
 },
 {
  "level": 2,
  "text": "领导者的必备素质",
  "uiIdx": "5",
  "range": "4924-4932",
  "chapterUid": 2
 },
 {
  "level": 3,
  "text": "当计划暂时搁浅时，该怎样设法继续推进？这一问题对领导者的能力也是一个不小的考验",
  "uiIdx": "5.1",
  "range": "5269-5290",
  "chapterUid": 2
 },
 {
  "level": 4,
  "text": "我认为成员们如果由衷地理解这项事业的意义，即使途中产生了迷茫，最后也能自我调整、转换心情，摆脱负面的影响。",
  "uiIdx": "",
  "range": "5311-5364",
  "chapterUid": 2
 },
 {
  "level": 3,
  "text": "在引导各种项目推进的时候，每个成员对“项目实现价值”的认知程度是决定成败的关键因素",
  "uiIdx": "5.2",
  "range": "6177-6219",
  "chapterUid": 2
 },
 {
  "level": 4,
  "text": "而作为领导者，重要的一环就是制造“认知”的契机。",
  "uiIdx": "",
  "range": "6219-6243",
  "chapterUid": 2
 },
 {
  "level": 2,
  "text": "“IY BANK”的诞生",
  "uiIdx": "6",
  "range": "6294-6306",
  "chapterUid": 2
 },
 {
  "level": 3,
  "text": "顾及新银行将来的发展，对银行领导人的选拔无疑是重中之重",
  "uiIdx": "6.1",
  "range": "6336-6364",
  "chapterUid": 2
 },
 {
  "level": 4,
  "text": "在从多种渠道火热遴选人才的过程中，有人推荐了日本银行的前任董事、旧名日本长期信用银行(即现在的新生银行)的最后一任董事长——安齐隆。",
  "uiIdx": "",
  "range": "6364-6430",
  "chapterUid": 2
 },
 {
  "level": 4,
  "text": "之后和他本人见面交谈后，直觉告诉我这就是我们苦苦寻觅的最佳人选。",
  "uiIdx": "",
  "range": "6430-6462",
  "chapterUid": 2
 },
 {
  "level": 3,
  "text": "项目团队逐渐融合为一个整体，大家各自发挥所长，与监督厅斡旋、确保金融机构的协作等，解决了一个又一个棘手的问题",
  "uiIdx": "6.2",
  "range": "7397-7452",
  "chapterUid": 2
 },
 {
  "level": 4,
  "text": "经过团队的努力，2001年，“IY BANK”终于顺利开始营业。",
  "uiIdx": "",
  "range": "7481-7513",
  "chapterUid": 2
 },
 {
  "level": 2,
  "text": "实现“三年内盈利”的目标",
  "uiIdx": "7",
  "range": "7600-7612",
  "chapterUid": 2
 },
 {
  "level": 3,
  "text": "银行成立初期，财报连续两年出现了赤字。但是稳步提升的ATM使用率仍然让我充满了信心",
  "uiIdx": "7.1",
  "range": "7642-7661",
  "chapterUid": 2
 },
 {
  "level": 4,
  "text": "凡事都有一个量变到质变的推进过程，当使用者积累到一定程度时，自然会出现需求和人气蹿升的“爆发点”。",
  "uiIdx": "",
  "range": "7713-7762",
  "chapterUid": 2
 },
 {
  "level": 3,
  "text": "之后，我们顺利实现了金融厅规定的“三年内盈利”的目标，成为了网络银行等同期新银行中的一枝独秀",
  "uiIdx": "7.2",
  "range": "8295-8368",
  "chapterUid": 2
 },
 {
  "level": 4,
  "text": "这正是因为便利店内设有银行的“新价值”得到了顾客们充分认可的缘故。",
  "uiIdx": "",
  "range": "8233-8266",
  "chapterUid": 2
 },
 {
  "level": 2,
  "text": "更名为“Seven银行”",
  "uiIdx": "8",
  "range": "8419-8431",
  "chapterUid": 2
 },
 {
  "level": 3,
  "text": "2005年，在公司重组为7&I控股集团后，安齐先生建议把“IY银行”更名为“Seven银行”",
  "uiIdx": "8.1",
  "range": "8461-8512",
  "chapterUid": 2
 },
 {
  "level": 4,
  "text": "顾客使用ATM汇款时，必须从界面上点选金融机构的名称。",
  "uiIdx": "",
  "range": "8541-8568",
  "chapterUid": 2
 },
 {
  "level": 4,
  "text": "在战略层面，银行的名称起得越通俗简洁越好，因此这项更名的提议非常有价值，而且把置于7-Eleven便利店中的银行称为“Seven银行”也朗朗上口易于记忆。",
  "uiIdx": "",
  "range": "8568-8645",
  "chapterUid": 2
 },
 {
  "level": 3,
  "text": "现在，当我再次和项目组成员回顾成立Seven银行的历程时，其中一人阐述了他的感想：“如果当初整个金融行业的状态顺风顺水的话，也许零售业和网络银行都无法申请到经营牌照。正因为当时的银行业处于岌岌可危的边缘，所以我们才有机会开办银行。”",
  "uiIdx": "8.2",
  "range": "8897-8980",
  "chapterUid": 2
 },
 {
  "level": 4,
  "text": "或许事实正如他所言，有这一层因素的关系。但我成立银行的决定和金融业界出现的小小“空子”并没有任何关联。我的初衷是想要满足消费者的需求，应对人们不断改变的生活模式。",
  "uiIdx": "",
  "range": "9013-9094",
  "chapterUid": 2
 },
 {
  "level": 1,
  "text": "第5章 消费者所追求的是品质",
  "uiIdx": "",
  "range": "",
  "chapterUid": 2
 },
 {
  "level": 2,
  "text": "7-Eleven的经营理念",
  "uiIdx": "1",
  "range": "1121-1147",
  "chapterUid": 2
 },
 {
  "level": 3,
  "text": "7-Eleven追求的是“品质”二字",
  "uiIdx": "1.1",
  "range": "1121-1147",
  "chapterUid": 2
 },
 {
  "level": 4,
  "text": "不能给消费者带来价值感的产品无法在市场占有一席之地。",
  "uiIdx": "",
  "range": "1121-1147",
  "chapterUid": 2
 },
 {
  "level": 3,
  "text": "7-Eleven的产品研发理念是与制造厂商的全国性品牌保持同样的质量甚至更高的品质",
  "uiIdx": "1.2",
  "range": "2606-2675",
  "chapterUid": 2
 },
 {
  "level": 4,
  "text": "在确保高品质的同时还要实行让消费者感觉合理的定价体系。",
  "uiIdx": "",
  "range": "2606-2675",
  "chapterUid": 2
 },
 {
  "level": 2,
  "text": "7-Eleven的自有品牌“7-Premium”",
  "uiIdx": "2",
  "range": "1361-1438",
  "chapterUid": 2
 },
 {
  "level": 3,
  "text": "“7-Premium”是7&I集团的共通PB(Private Brand，自有品牌)",
  "uiIdx": "2.1",
  "range": "1361-1438",
  "chapterUid": 2
 },
 {
  "level": 4,
  "text": "7-Premium从创建初期的49种食品成长至今，已经是拥有超过1700个食品种类的产品系列。",
  "uiIdx": "",
  "range": "1438-1503",
  "chapterUid": 2
 },
 {
  "level": 3,
  "text": "“7-Premium”的诞生源头在2005年至2006年左右",
  "uiIdx": "2.2",
  "range": "1532-1583",
  "chapterUid": 2
 },
 {
  "level": 4,
  "text": "当时经历了泡沫经济期，各行各业的市场皆处于低谷。产品的供给远大于需求，买方正占据强势地位。",
  "uiIdx": "",
  "range": "1583-1628",
  "chapterUid": 2
 },
 {
  "level": 2,
  "text": "7-Eleven的产品研发方法",
  "uiIdx": "3",
  "range": "2027-2078",
  "chapterUid": 2
 },
 {
  "level": 3,
  "text": "7-Eleven采用了非常独特的产品研发方法，简而言之就是“以团队形式研发具有高附加值的产品”",
  "uiIdx": "3.1",
  "range": "2027-2078",
  "chapterUid": 2
 },
 {
  "level": 4,
  "text": "产品研发成员以7-Eleven产品总部的产品研发负责人为核心，加入了各个原料、器材、制造厂商或供应商的负责人，整个团队需要把控从制定产品企划方案到方案具体化的所有环节。",
  "uiIdx": "",
  "range": "5081-5165",
  "chapterUid": 2
 },
 {
  "level": 3,
  "text": "7-Eleven和日本食品等厂商在1979年成立的NDF(Nihon Delica Foods Association，日本鲜食联合会)",
  "uiIdx": "3.2",
  "range": "5260-5358",
  "chapterUid": 2
 },
 {
  "level": 4,
  "text": "NDF的最大特点是“只为7-Eleven制造产品”，采用了零售行业前所未有的模式。",
  "uiIdx": "",
  "range": "5816-5857",
  "chapterUid": 2
 },
 {
  "level": 2,
  "text": "7-Eleven的产品研发理念",
  "uiIdx": "4",
  "range": "4391-4431",
  "chapterUid": 2
 },
 {
  "level": 3,
  "text": "7-Eleven对口味的要求近乎苛刻，有绝不妥协的评判基准",
  "uiIdx": "4.1",
  "range": "4391-4431",
  "chapterUid": 2
 },
 {
  "level": 4,
  "text": "一款新产品的问世，不仅需要得到产品研发负责人的同意，还必须通过包括我在内的所有高层董事试吃，只有所有人都对味道感到满意，才能正式允许对外发售。",
  "uiIdx": "",
  "range": "4460-4531",
  "chapterUid": 2
 },
 {
  "level": 3,
  "text": "7-Eleven每天都要生产好几万份产品，因此在顾客面前，卖方以“工厂没有相应设备”为借口根本行不通",
  "uiIdx": "4.2",
  "range": "8848-8909",
  "chapterUid": 2
 },
 {
  "level": 4,
  "text": "当时我训斥员工还没有努力寻找解决方案，就因为做不出“家常菜的味道”而妥协放弃的态度并不可取。",
  "uiIdx": "",
  "range": "8909-8955",
  "chapterUid": 2
 },
 {
  "level": 2,
  "text": "7-Eleven的未来产品研发方向",
  "uiIdx": "5",
  "range": "9513-9591",
  "chapterUid": 2
 },
 {
  "level": 3,
  "text": "今后应该转换思路，研发“无法轻易在家中厨房烹饪的菜肴”或“需要花费大量精力才能做出的味道”",
  "uiIdx": "5.1",
  "range": "9513-9591",
  "chapterUid": 2
 },
 {
  "level": 4,
  "text": "“汤汁”就是研发项目之一。与双职工家庭的递增成反比，每个家庭花费在家务上的时间正在逐年递减。",
  "uiIdx": "",
  "range": "9636-9669",
  "chapterUid": 2
 },
 {
  "level": 4,
  "text": "另一个例子则是咖啡。近几年，味道醇正的现磨咖啡受到了顾客们的追捧。我们以轻松品尝“家庭难以实现的正宗口味”为诉求，开拓了新的市场。",
  "uiIdx": "",
  "range": "9937-10003",
  "chapterUid": 2
 },
 {
  "level": 1,
  "text": "第6章 消费即是心理战",
  "uiIdx": "",
  "range": "",
  "chapterUid": 2
 },
 {
  "level": 2,
  "text": "产品滞销的原因",
  "uiIdx": "1",
  "range": "844-890",
  "chapterUid": 2
 },
 {
  "level": 3,
  "text": "产品滞销、生意萧条的原因只有一个，即是现在的工作方法已经无法满足时代和消费者需求的变化",
  "uiIdx": "1.1",
  "range": "844-890",
  "chapterUid": 2
 },
 {
  "level": 4,
  "text": "如果存在经济不景气会导致企业业绩下滑的法则，那么就与7-Eleven业绩的逆势上扬自相矛盾。",
  "uiIdx": "",
  "range": "769-815",
  "chapterUid": 2
 },
 {
  "level": 2,
  "text": "引入POS系统",
  "uiIdx": "2",
  "range": "1110-1117",
  "chapterUid": 2
 },
 {
  "level": 3,
  "text": "1982年，7-Eleven便利店成为了日本第一家引进POS系统的公司",
  "uiIdx": "2.1",
  "range": "2736-2776",
  "chapterUid": 2
 },
 {
  "level": 4,
  "text": "订货方式从原先的手工记账进化为使用“终端Seven”读取货品条形码发送电传数据的流程。",
  "uiIdx": "",
  "range": "1961-2004",
  "chapterUid": 2
 },
 {
  "level": 2,
  "text": "走向“单品管理”",
  "uiIdx": "3",
  "range": "2827-2835",
  "chapterUid": 2
 },
 {
  "level": 3,
  "text": "“单品管理”即是日复一日地执行“假设→执行→验证”步骤",
  "uiIdx": "3.1",
  "range": "3115-3158",
  "chapterUid": 2
 },
 {
  "level": 4,
  "text": "“假设”并不是凭空想象，而是以销售数据为出发点，结合第二天的天气、气温、街市的活动等前瞻性信息，进行客观的分析和思考，提前预判顾客的消费心理，并以此为基础订货。",
  "uiIdx": "",
  "range": "2990-3070",
  "chapterUid": 2
 },
 {
  "level": 4,
  "text": "最后再通过当天收银结算的POS系统，精确地掌握产品销售的数量和时间，印证和调整自己的假设。",
  "uiIdx": "",
  "range": "3070-3115",
  "chapterUid": 2
 },
 {
  "level": 4,
  "text": "再继续下一轮的“假设→执行→验证”步骤。",
  "uiIdx": "",
  "range": "3115-3158",
  "chapterUid": 2
 },
 {
  "level": 2,
  "text": "消费是场心理战",
  "uiIdx": "4",
  "range": "3736-3743",
  "chapterUid": 2
 },
 {
  "level": 3,
  "text": "消费可能愈加低迷的原因之一是增税政策",
  "uiIdx": "4.1",
  "range": "3970-3989",
  "chapterUid": 2
 },
 {
  "level": 4,
  "text": "赞成实行增税政策的人，也许以为只上涨2%-3%的程度，对消费并不会有显著影响。",
  "uiIdx": "",
  "range": "4004-4043",
  "chapterUid": 2
 },
 {
  "level": 4,
  "text": "管理家庭收支的主妇们，她们对市场最为敏感，只要每月的开支稍微增加一点，就会感觉心理不适。",
  "uiIdx": "",
  "range": "4143-4190",
  "chapterUid": 2
 },
 {
  "level": 4,
  "text": "哪怕产品的金额只是微微上浮，人们的内心也会闪起“涨价”的警报，紧接着产生抵触情绪。",
  "uiIdx": "",
  "range": "4190-4231",
  "chapterUid": 2
 },
 {
  "level": 2,
  "text": "消费者的价值观在哪里？",
  "uiIdx": "5",
  "range": "5346-5357",
  "chapterUid": 2
 },
 {
  "level": 3,
  "text": "消费者的价值观随时代变化，企业需读懂消费者心理",
  "uiIdx": "5.1",
  "range": "5446-5504",
  "chapterUid": 2
 },
 {
  "level": 4,
  "text": "日本的泡沫经济崩溃后，市场上接二连三地出现了折扣店，这一时代的消费者有非常明确的价值取向，主要关注商品价位的高与低。",
  "uiIdx": "",
  "range": "5446-5504",
  "chapterUid": 2
 },
 {
  "level": 4,
  "text": "在少子老龄化的时代，“量大”对多数人而言并没有吸引力。随着单身人士和二人小家庭的增加，希望量少而价优，或者比起价格更期待高品质的人变得越来越多。",
  "uiIdx": "",
  "range": "5601-5674",
  "chapterUid": 2
 },
 {
  "level": 2,
  "text": "“特色饭团”为何能成为热销产品？",
  "uiIdx": "6",
  "range": "7193-7209",
  "chapterUid": 2
 },
 {
  "level": 3,
  "text": "设计让顾客满意的产品时，一定要站在顾客的立场，从建立假设开始一步步按流程执行",
  "uiIdx": "6.1",
  "range": "7239-7278",
  "chapterUid": 2
 },
 {
  "level": 4,
  "text": "7-Eleven具有代表性的热销产品——“特色饭团”就是典型的例子。这种饭团使用了比普通饭团更为高端的食材。",
  "uiIdx": "",
  "range": "7607-7661",
  "chapterUid": 2
 },
 {
  "level": 4,
  "text": "100日元饭团畅销的主要原因是出现了前所未有的价格区间，让顾客产生新鲜感，达到了促进购买行为的效果。",
  "uiIdx": "",
  "range": "8347-8397",
  "chapterUid": 2
 },
 {
  "level": 2,
  "text": "从“还在营业太好了”到“近距离的便利”",
  "uiIdx": "7",
  "range": "9036-9055",
  "chapterUid": 2
 },
 {
  "level": 3,
  "text": "企业的责任也随着时代的变化悄然发生了改变，应以“顾客的立场”做出判断",
  "uiIdx": "7.1",
  "range": "9145-9170",
  "chapterUid": 2
 },
 {
  "level": 4,
  "text": "当经营者捕捉变化，思考未来企业该如何服务于顾客时，不能唯自身的利益和方便至上，应该经常从“顾客的立场”做出判断。",
  "uiIdx": "",
  "range": "9199-9280",
  "chapterUid": 2
 },
 {
  "level": 4,
  "text": "7-Eleven成立之初的定位是“为顾客带来便利的店”。以此为基础，我们在2009年重新定义了7-Eleven应有的经营姿态——即作为贴近顾客生活的商店，必须努力实现“近距离的便利”。",
  "uiIdx": "",
  "range": "9750-9842",
  "chapterUid": 2
 },
 {
  "level": 1,
  "text": "第7章 经营理应“朝令夕改”",
  "uiIdx": "",
  "range": "",
  "chapterUid": 2
 },
 {
  "level": 2,
  "text": "走近顾客",
  "uiIdx": "1",
  "range": "477-481",
  "chapterUid": 2
 },
 {
  "level": 3,
  "text": "从心理上和空间上贴近顾客，实现“进攻型经营”",
  "uiIdx": "1.1",
  "range": "739-786",
  "chapterUid": 2
 },
 {
  "level": 4,
  "text": "心理上“贴近顾客”意为不能静止地在店内等候客人光顾，而应该不断推陈出新，以具有新鲜感、美味度及有益于生活的产品或服务设计促进买方的消费欲望。",
  "uiIdx": "",
  "range": "815-886",
  "chapterUid": 2
 },
 {
  "level": 4,
  "text": "空间意义上的“贴近”是指加强“送货上门服务”和“网络零售”，让顾客足不出户就能购买到我们的产品。",
  "uiIdx": "",
  "range": "1066-1119",
  "chapterUid": 2
 },
 {
  "level": 2,
  "text": "现代版“推销术”",
  "uiIdx": "2",
  "range": "1170-1178",
  "chapterUid": 2
 },
 {
  "level": 3,
  "text": "由卖方“主动推销”的时代已经到来",
  "uiIdx": "2.1",
  "range": "1467-1515",
  "chapterUid": 2
 },
 {
  "level": 4,
  "text": "从时代刚刚步入供大于求的“买方市场”开始，就认定商业经营应该由卖方接近买方，主动出击获得订单。",
  "uiIdx": "",
  "range": "1467-1515",
  "chapterUid": 2
 },
 {
  "level": 4,
  "text": "今后必将成为由卖方“主动推销”的时代。",
  "uiIdx": "",
  "range": "1515-1534",
  "chapterUid": 2
 },
 {
  "level": 3,
  "text": "推销手段必须根据客户的生活、年龄、性别、爱好，甚至居住区域举办的节日庆典等所有相关数据，一一对应地分析客户需要怎样的产品或服务",
  "uiIdx": "2.2",
  "range": "2327-2400",
  "chapterUid": 2
 },
 {
  "level": 4,
  "text": "企业是否能探寻到顾客在日常生活中感到的不便之处，并思考对应的解决方法，将成为影响未来经营的关键因素。",
  "uiIdx": "",
  "range": "2476-2531",
  "chapterUid": 2
 },
 {
  "level": 2,
  "text": "各种各样的“送货”结构",
  "uiIdx": "3",
  "range": "2582-2593",
  "chapterUid": 2
 },
 {
  "level": 3,
  "text": "推出了“Seven Meal”的送餐业务，以及“Seven安心送货服务”和“Seven轻松送货服务”",
  "uiIdx": "3.1",
  "range": "1671-1720",
  "chapterUid": 2
 },
 {
  "level": 4,
  "text": "“Seven Meal”的送餐业务，以及“Seven安心送货服务”和“Seven轻松送货服务”都是在思考“顾客是否需要这样的服务”“推出这样的服务是否会让顾客满足”的过程中诞生的提案。",
  "uiIdx": "",
  "range": "1671-1720",
  "chapterUid": 2
 },
 {
  "level": 3,
  "text": "7-Eleven送餐服务的另一大优势是，可选择的种类并不局限于“护理食品”",
  "uiIdx": "3.2",
  "range": "3586-3624",
  "chapterUid": 2
 },
 {
  "level": 4,
  "text": "健康的菜谱本身没有限定的受众群，无论男女老少都有相应的需求，并且我们也提供了丰富多彩的配菜和饮料选项。",
  "uiIdx": "",
  "range": "3624-3675",
  "chapterUid": 2
 },
 {
  "level": 2,
  "text": "7-11独门送货秘籍",
  "uiIdx": "4",
  "range": "5391-5401",
  "chapterUid": 2
 },
 {
  "level": 3,
  "text": "Seven Meal服务将“送货上门”作为关键词，对价值500日元以上的订单采取了免费送货的战略",
  "uiIdx": "4.1",
  "range": "5431-5480",
  "chapterUid": 2
 },
 {
  "level": 4,
  "text": "这一战略也取得了预期的效果，Seven Meal目前以都市人群为主的会员数量共计约有40万人，并且每天都在刷新纪录，相信突破百万规模也指日可待。",
  "uiIdx": "",
  "range": "5480-5553",
  "chapterUid": 2
 },
 {
  "level": 3,
  "text": "“轻松送”具有一个和其他竞争对手完全不同的优势，即由门店员工直接负责送货",
  "uiIdx": "4.2",
  "range": "6151-6197",
  "chapterUid": 2
 },
 {
  "level": 4,
  "text": "熟悉的面孔能让客户消除对外送产品品质的疑虑，亲切的店长能让顾客在便利店购物后轻松地说出“麻烦之后送到我家”的要求。",
  "uiIdx": "",
  "range": "6329-6440",
  "chapterUid": 2
 },
 {
  "level": 2,
  "text": "掌控网络＝掌控现实",
  "uiIdx": "5",
  "range": "6776-6785",
  "chapterUid": 2
 },
 {
  "level": 3,
  "text": "我们不要把网络零售视为竞争对手，而应该通过网络和实体店铺的互相融合，进一步拓宽经营的可能性",
  "uiIdx": "5.1",
  "range": "7192-7241",
  "chapterUid": 2
 },
 {
  "level": 4,
  "text": "网络零售的成长令消费者的消费模式发生了翻天覆地的变化。",
  "uiIdx": "",
  "range": "6952-6979",
  "chapterUid": 2
 },
 {
  "level": 4,
  "text": "站在卖方的角度，灵活运用网络，可以一次性向多名客户发送产品信息，如果悉心钻研，网络一定能有助于实体店的运营。",
  "uiIdx": "",
  "range": "7109-7163",
  "chapterUid": 2
 },
 {
  "level": 3,
  "text": "利用Seven Spot吸引顾客、促进销售；在店内陈列独创的产品，努力提高服务与品质",
  "uiIdx": "5.2",
  "range": "8403-8425",
  "chapterUid": 2
 },
 {
  "level": 4,
  "text": "Seven Spot也有助于企业的推广。",
  "uiIdx": "",
  "range": "7973-8003",
  "chapterUid": 2
 },
 {
  "level": 4,
  "text": "想彻底提升门店的营业额，也不能忘记要不断地改善实体店铺的产品品质和服务价值，因为这才是零售业的根本所在。",
  "uiIdx": "",
  "range": "8315-8374",
  "chapterUid": 2
 },
 {
  "level": 2,
  "text": "作为“生活基础设施”的新角色",
  "uiIdx": "6",
  "range": "8693-8707",
  "chapterUid": 2
 },
 {
  "level": 3,
  "text": "创造“新服务”是我们永恒不变的重要任务",
  "uiIdx": "6.1",
  "range": "8737-8767",
  "chapterUid": 2
 },
 {
  "level": 4,
  "text": "既然7-Eleven实行了贴近顾客的市场战略，那么今后理应不断地实现作为“生活基础设施”的各项功能。",
  "uiIdx": "",
  "range": "8767-8817",
  "chapterUid": 2
 },
 {
  "level": 3,
  "text": "不论在过去还是现在，创造“新服务”是我们永恒不变的重要任务",
  "uiIdx": "6.2",
  "range": "8737-8767",
  "chapterUid": 2
 },
 {
  "level": 4,
  "text": "例如在发生大地震时，我们承接了各地方政府的要求，倾全力投身于灾区重建的支援活动。",
  "uiIdx": "",
  "range": "9005-9045",
  "chapterUid": 2
 },
 {
  "level": 4,
  "text": "在日常的服务项目中，不仅有公共事业费用的代收服务、税金的缴纳服务，根据区域不同，有些门店甚至还设有休息区，顾客可以灵活地利用这块区域，或是买杯7-Eleven的现磨咖啡稍事小憩；或是买些小吃便当直接坐在店内用餐。",
  "uiIdx": "",
  "range": "9333-9423",
  "chapterUid": 2
 },
 {
  "level": 1,
  "text": "第8章 “应对变化”是基本原则",
  "uiIdx": "",
  "range": "",
  "chapterUid": 2
 },
 {
  "level": 2,
  "text": "理解“现在应该做的事”",
  "uiIdx": "1",
  "range": "479-490",
  "chapterUid": 2
 },
 {
  "level": 3,
  "text": "坚持应对社会和时代的变化",
  "uiIdx": "1.1",
  "range": "654-694",
  "chapterUid": 2
 },
 {
  "level": 4,
  "text": "无论面临多么大的困难，我都会从不同的角度寻找解决问题的切入口，接连发起新的挑战。",
  "uiIdx": "",
  "range": "654-694",
  "chapterUid": 2
 },
 {
  "level": 3,
  "text": "全体员工时刻保持发现问题的意识",
  "uiIdx": "1.2",
  "range": "564-580",
  "chapterUid": 2
 },
 {
  "level": 4,
  "text": "保证在工作的每一天，踏实勤恳地完成自己应该做的事。",
  "uiIdx": "",
  "range": "694-721",
  "chapterUid": 2
 },
 {
  "level": 3,
  "text": "建立假设，挑战各项业务",
  "uiIdx": "1.3",
  "range": "580-592",
  "chapterUid": 2
 },
 {
  "level": 4,
  "text": "身为7-Eleven的经营负责人，我一直谨记着“企业也会有呈现老态的一天”。",
  "uiIdx": "",
  "range": "750-788",
  "chapterUid": 2
 },
 {
  "level": 2,
  "text": "美国南方公司的衰败",
