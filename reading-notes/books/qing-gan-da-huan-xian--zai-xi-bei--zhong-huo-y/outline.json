[
 {
  "level": 1,
  "text": "文前",
  "uiIdx": "",
  "range": "",
  "chapterUid": 2
 },
 {
  "level": 2,
  "text": "旅行前的低落情绪",
  "uiIdx": "1",
  "range": "673-694",
  "chapterUid": 2
 },
 {
  "level": 3,
  "text": "心情很低落，夜不能寐，伤心欲绝",
  "uiIdx": "1.1",
  "range": "673-694",
  "chapterUid": 2
 },
 {
  "level": 4,
  "text": "人在被悲观情绪笼罩时，就像一脚踏入了泥沼。",
  "uiIdx": "",
  "range": "673-694",
  "chapterUid": 2
 },
 {
  "level": 4,
  "text": "在理性和智慧几乎降到负数的深夜，情况更糟，在黑暗中抓不住任何救命稻草，越挣扎陷得越深，眼看着另一只腿脚也进去了，半个身子下去了，快要不能呼吸了。",
  "uiIdx": "",
  "range": "734-807",
  "chapterUid": 2
 },
 {
  "level": 3,
  "text": "活着究竟有什么意思？这个问题总会在人生的某些时刻悄然现身",
  "uiIdx": "1.2",
  "range": "840-882",
  "chapterUid": 2
 },
 {
  "level": 4,
  "text": "小时候会，长大后还会。它一次次出现，我就得一次次寻找答案。",
  "uiIdx": "",
  "range": "893-911",
  "chapterUid": 2
 },
 {
  "level": 2,
  "text": "旅行计划的执行",
  "uiIdx": "2",
  "range": "952-990",
  "chapterUid": 2
 },
 {
  "level": 3,
  "text": "机票上的出发时间到了，还有旅行计划，机票买了、酒店定了",
  "uiIdx": "2.1",
  "range": "952-990",
  "chapterUid": 2
 },
 {
  "level": 4,
  "text": "暂且将所有沉郁顿挫的悲哀搁置，收拾行李，上飞机吧。",
  "uiIdx": "",
  "range": "990-1000",
  "chapterUid": 2
 },
 {
  "level": 1,
  "text": "过客匆匆，聚散有时",
  "uiIdx": "",
  "range": "",
  "chapterUid": 4
 },
 {
  "level": 2,
  "text": "小马哥的故事",
  "uiIdx": "1",
  "range": "1156-1182",
  "chapterUid": 4
 },
 {
  "level": 3,
  "text": "小马哥在清真寺学习《古兰经》的经历",
  "uiIdx": "1.1",
  "range": "1156-1182",
  "chapterUid": 4
 },
 {
  "level": 4,
  "text": "小马哥初中时不愿意读书，去清真寺里学习《古兰经》。",
  "uiIdx": "",
  "range": "1156-1182",
  "chapterUid": 4
 },
 {
  "level": 4,
  "text": "在清真寺里学了一年后，就去考驾照了。",
  "uiIdx": "",
  "range": "1380-1422",
  "chapterUid": 4
 },
 {
  "level": 3,
  "text": "小马哥在外打工的经历",
  "uiIdx": "1.2",
  "range": "1422-1446",
  "chapterUid": 4
 },
 {
  "level": 4,
  "text": "小马哥在萧山一个新材料厂子里打工，负责熔化材料。",
  "uiIdx": "",
  "range": "1422-1446",
  "chapterUid": 4
 },
 {
  "level": 4,
  "text": "小马哥在广州一个生产衣架的厂子里打工，夏季时没有空调，只有小风扇。",
  "uiIdx": "",
  "range": "1506-1565",
  "chapterUid": 4
 },
 {
  "level": 3,
  "text": "小马哥对信仰的看法",
  "uiIdx": "1.3",
  "range": "2383-2459",
  "chapterUid": 4
 },
 {
  "level": 4,
  "text": "小马哥说，信仰安拉，即使做了坏事，会先进入火狱，洗净身上的污点，再进入天堂。",
  "uiIdx": "",
  "range": "2383-2494",
  "chapterUid": 4
 },
 {
  "level": 2,
  "text": "穆斯林大爷的故事",
  "uiIdx": "2",
  "range": "4014-4074",
  "chapterUid": 4
 },
 {
  "level": 3,
  "text": "穆斯林大爷对《古兰经》的理解",
  "uiIdx": "2.1",
  "range": "4014-4074",
  "chapterUid": 4
 },
 {
  "level": 4,
  "text": "大爷说：lā ilāha illā Allāh，意思是万物非主，唯有真主。这是宇宙的真理、宇宙的灵魂。",
  "uiIdx": "",
  "range": "4014-4074",
  "chapterUid": 4
 },
 {
  "level": 3,
  "text": "穆斯林大爷对信仰的坚持",
  "uiIdx": "2.2",
  "range": "6005-6053",
  "chapterUid": 4
 },
 {
  "level": 4,
  "text": "大爷说：每天要完成自己的功课，要做礼拜，学习古兰经。",
  "uiIdx": "",
  "range": "6005-6053",
  "chapterUid": 4
 },
 {
  "level": 3,
  "text": "穆斯林大爷对不同宗教的看法",
  "uiIdx": "2.3",
  "range": "6344-6402",
  "chapterUid": 4
 },
 {
  "level": 4,
  "text": "大爷说：只有伊斯兰是真正的宗教，所谓的基督教、佛教都是他们自己认为的。",
  "uiIdx": "",
  "range": "6344-6402",
  "chapterUid": 4
 },
 {
  "level": 2,
  "text": "回族阿姨的故事",
  "uiIdx": "3",
  "range": "9086-9110",
  "chapterUid": 4
 },
 {
  "level": 3,
  "text": "回族阿姨对信仰的坚持",
  "uiIdx": "3.1",
  "range": "9086-9110",
  "chapterUid": 4
 },
 {
  "level": 4,
  "text": "阿姨说，家里的子女若不信教，就不会再理Ta了。女孩子结婚后必须戴头巾，尤其一些重要场合和节日。",
  "uiIdx": "",
  "range": "9064-9110",
  "chapterUid": 4
 },
 {
  "level": 3,
  "text": "回族阿姨对生活的态度",
  "uiIdx": "3.2",
  "range": "9289-9357",
  "chapterUid": 4
 },
 {
  "level": 4,
  "text": "阿姨说：人要讲良心，不然，不管多么高的社会阶层，多少财富，都没有用。",
  "uiIdx": "",
  "range": "9289-9357",
  "chapterUid": 4
 },
 {
  "level": 2,
  "text": "以色列小哥的故事",
  "uiIdx": "4",
  "range": "13111-13145",
  "chapterUid": 4
 },
 {
  "level": 3,
  "text": "以色列小哥对中国的看法",
  "uiIdx": "4.1",
  "range": "13111-13145",
  "chapterUid": 4
 },
 {
  "level": 4,
  "text": "玛雅说：我觉得中国怎么样？",
  "uiIdx": "",
  "range": "13111-13145",
  "chapterUid": 4
 },
 {
  "level": 3,
  "text": "以色列小哥对文学的热爱",
  "uiIdx": "4.2",
  "range": "12903-12977",
  "chapterUid": 4
 },
 {
  "level": 4,
  "text": "玛雅除了素食主义者，玛雅还是个文学爱好者，我们边吃饭边聊莫里森、伍尔夫、博尔赫斯、库切、福克纳、鲁西迪……",
  "uiIdx": "",
  "range": "12903-12977",
  "chapterUid": 4
 },
 {
  "level": 3,
  "text": "以色列小哥对旅途的期待",
  "uiIdx": "4.3",
  "range": "13185-13231",
  "chapterUid": 4
 },
 {
  "level": 4,
  "text": "玛雅说：让我来给你们讲一个以色列官员的腐败故事吧。",
  "uiIdx": "",
  "range": "13185-13231",
  "chapterUid": 4
 },
 {
  "level": 1,
  "text": "天地悠悠，万物有灵",
  "uiIdx": "",
  "range": "",
  "chapterUid": 4
 },
 {
  "level": 2,
  "text": "作者的骑骆驼经历",
  "uiIdx": "1",
  "range": "855-868",
  "chapterUid": 4
 },
 {
  "level": 3,
  "text": "作者人生中第二次骑骆驼，感到害怕但好奇",
  "uiIdx": "1.1",
  "range": "855-868",
  "chapterUid": 4
 },
 {
  "level": 4,
  "text": "作者小时候在晋祠公园门口骑过骆驼，但从未见过合影，只记得湿乎乎的感觉和害怕。",
  "uiIdx": "",
  "range": "1007-1083",
  "chapterUid": 4
 },
 {
  "level": 4,
  "text": "这次骑骆驼，作者和飞鱼骑的骆驼确定是活生生的，会动，会走。",
  "uiIdx": "",
  "range": "1122-1170",
  "chapterUid": 4
 },
 {
  "level": 3,
  "text": "骑骆驼并不舒服，但作者注意到骆驼的鼻子上插着一根木棍，眼睑附近挂着一滴泪珠",
  "uiIdx": "1.2",
  "range": "1802-1822",
  "chapterUid": 4
 },
 {
  "level": 4,
  "text": "骆驼的大眼睛下边，眼睑附近挂着一滴泪珠，作者一开始以为那是风沙吹的，但骆驼没有眨眼，那滴泪就那么挂着。",
  "uiIdx": "",
  "range": "1802-1822",
  "chapterUid": 4
 },
 {
  "level": 4,
  "text": "作者忽然有点不知所措，怀疑骆驼是为日复一日，起早贪黑在这沙漠里一圈一圈走着的命运而感到悲伤吗？",
  "uiIdx": "",
  "range": "1912-1945",
  "chapterUid": 4
 },
 {
  "level": 2,
  "text": "骆驼的宿命与贡献",
  "uiIdx": "2",
  "range": "2077-2123",
  "chapterUid": 4
 },
 {
  "level": 3,
  "text": "骆驼的鼻子是它最脆弱的地方，被驯化后，人们会在鼻孔处扎孔，穿入一根鼻棍，控制它的命运",
  "uiIdx": "2.1",
  "range": "2077-2123",
  "chapterUid": 4
 },
 {
  "level": 4,
  "text": "骆驼2一5岁时，人们会将其放倒后用木扦在鼻孔处扎孔，穿入一根长约20厘米的鼻棍，并系上缰绳。",
  "uiIdx": "",
  "range": "2077-2123",
  "chapterUid": 4
 },
 {
  "level": 3,
  "text": "骆驼力大无比，发起狂来十几个人也拉不住，但鼻子是它最脆弱的地方",
  "uiIdx": "2.2",
  "range": "2019-2077",
  "chapterUid": 4
 },
 {
  "level": 4,
  "text": "骆驼用一身的坚韧，换来“沙漠之舟”的称号，也换来了一生的负重前行。",
  "uiIdx": "",
  "range": "2278-2311",
  "chapterUid": 4
 },
 {
  "level": 2,
  "text": "草原上的马与羊",
  "uiIdx": "3",
  "range": "3529-3571",
  "chapterUid": 4
 },
 {
  "level": 3,
  "text": "草原上的马看似比沙漠里的骆驼自由得多，但实际上，它们的生活并不如看起来那么自由",
  "uiIdx": "3.1",
  "range": "3529-3571",
  "chapterUid": 4
 },
 {
  "level": 4,
  "text": "这些马儿都是供游客骑乘的，所谓的奔跑，也不过是在缰绳的牵引下绕着固定的路线走一圈。",
  "uiIdx": "",
  "range": "3571-3623",
  "chapterUid": 4
 },
 {
  "level": 4,
  "text": "十月已经入秋，草地上的黄草一日日枯下去，不知道西北寒冷彻骨的冬天它们是怎么熬过去的。",
  "uiIdx": "",
  "range": "3623-3665",
  "chapterUid": 4
 },
 {
  "level": 3,
  "text": "被抬上卡车的羊，即将面临屠宰，作者对此感到安静和无奈",
  "uiIdx": "3.2",
  "range": "3802-3861",
  "chapterUid": 4
 },
 {
  "level": 4,
  "text": "如果我是这草原上的一匹马，如果我就是那只待宰的羔羊，我还有什么好说的呢？",
  "uiIdx": "",
  "range": "3802-3861",
  "chapterUid": 4
 },
 {
  "level": 1,
  "text": "“与其死去！不如活着！”",
  "uiIdx": "",
  "range": "",
  "chapterUid": 4
 },
 {
  "level": 2,
  "text": "海子的诗歌与青海湖",
  "uiIdx": "1",
  "range": "1589-1618",
  "chapterUid": 4
 },
 {
  "level": 3,
  "text": "海子远游青海、西藏，写下一系列短诗",
  "uiIdx": "1.1",
  "range": "1589-1618",
  "chapterUid": 4
 },
 {
  "level": 4,
  "text": "1986年，海子远游内蒙古、青海、西藏，并写下一系列短诗。这些诗句是海子朝碧海，暮苍梧之路的见证。",
  "uiIdx": "",
  "range": "1589-1638",
  "chapterUid": 4
 },
 {
  "level": 3,
  "text": "海子在德令哈写下《日记》这首诗",
  "uiIdx": "1.2",
  "range": "1638-1683",
  "chapterUid": 4
 },
 {
  "level": 4,
  "text": "1988年，他再次远游青海、西藏等地，7月25日，火车经过德令哈，他写下了《日记》这首诗。",
  "uiIdx": "",
  "range": "1638-1683",
  "chapterUid": 4
 },
 {
  "level": 2,
  "text": "海子的生命与诗歌",
  "uiIdx": "2",
  "range": "3430-3482",
  "chapterUid": 4
 },
 {
  "level": 3,
  "text": "海子坚持为未完成的太阳七部书奋斗着",
  "uiIdx": "2.1",
  "range": "3430-3482",
  "chapterUid": 4
 },
 {
  "level": 4,
  "text": "1988年末，海子离开西藏前，写下“远方除了遥远，一无所有”的感慨，但他坚持为未完成的太阳七部书奋斗着。",
  "uiIdx": "",
  "range": "3430-3482",
  "chapterUid": 4
 },
 {
  "level": 3,
  "text": "海子在山海关卧轨离世。",
  "uiIdx": "2.2",
  "range": "3482-3507",
  "chapterUid": 4
 },
 {
  "level": 2,
  "text": "对海子诗歌的解读",
  "uiIdx": "3",
  "range": "3015-3044",
  "chapterUid": 4
 },
 {
  "level": 3,
  "text": "海子诗里的姐姐，是众说纷纭中的哪一位",
  "uiIdx": "3.1",
  "range": "3015-3044",
  "chapterUid": 4
 },
 {
  "level": 4,
  "text": "不知他笔下的姐姐，是众说纷纭中的哪一位；也不知海子此时是否已明了，此行将是他人生中的最后一次远旅。",
  "uiIdx": "",
  "range": "3015-3044",
  "chapterUid": 4
 },
 {
  "level": 3,
  "text": "海子为何选择结束一切",
  "uiIdx": "3.2",
  "range": "4359-4420",
  "chapterUid": 4
 },
 {
  "level": 4,
  "text": "既然有这样的热情，为何不呵护好这热情之火，让这火斩杀一切痛苦和绝望呢？",
  "uiIdx": "",
  "range": "4359-4420",
  "chapterUid": 4
 },
 {
  "level": 2,
  "text": "旅行中的感悟",
  "uiIdx": "4",
  "range": "9027-9070",
  "chapterUid": 4
 },
 {
  "level": 3,
  "text": "旅行解决不了现实生活中的任何实际问题，它只是让人暂时脱身泥沼，有个换角度看问题的机会",
  "uiIdx": "4.1",
  "range": "9027-9070",
  "chapterUid": 4
 },
 {
  "level": 4,
  "text": "这一路，我看到的他者，一部分是我自己，一部分是与我不同的这个世界。他者看到的我，亦如是。",
  "uiIdx": "",
  "range": "9070-9137",
  "chapterUid": 4
 },
 {
  "level": 3,
  "text": "无论多久，我都会记得一路遇到过的这些人，也会永远记得鸣沙山山脚下，月牙泉边，看到的“万人星空演唱会”",
  "uiIdx": "4.2",
  "range": "9137-9211",
  "chapterUid": 4
 },
 {
  "level": 4,
  "text": "夜幕下，漫山遍野的人，打着手机灯，幻化出遍山遍野的星空。无数无数的人，一起跟着音乐唱着：“岁月不知人间多少的忧伤，何不潇洒走一回？”。",
  "uiIdx": "",
  "range": "9211-9333",
  "chapterUid": 4
 },
 {
  "level": 1,
  "text": "山河湖屿，各有其色",
  "uiIdx": "",
  "range": "",
  "chapterUid": 4
 },
 {
  "level": 2,
  "text": "坎布拉国家公园",
  "uiIdx": "1",
  "range": "545-582",
  "chapterUid": 4
 },
 {
  "level": 3,
  "text": "坎布拉是藏语地名，意为“康巴人的家园”，这里是藏传佛教后弘期发祥地之一",
  "uiIdx": "1.1",
  "range": "545-582",
  "chapterUid": 4
 },
 {
  "level": 4,
  "text": "我们乘着游艇，在绿色的湖水中激浪前行。",
  "uiIdx": "",
  "range": "582-624",
  "chapterUid": 4
 },
 {
  "level": 4,
  "text": "眼前是高高低低、绵延不绝的山脉，布满黄土高原般的沟壑，但穿上了层绿色纱衣。",
  "uiIdx": "",
  "range": "624-661",
  "chapterUid": 4
 },
 {
  "level": 4,
  "text": "这里的林场平均负氧离子含量高达5×10⁴，被誉为“青藏高原天然氧吧”。",
  "uiIdx": "",
  "range": "1479-1537",
  "chapterUid": 4
 },
 {
  "level": 3,
  "text": "在远处一座绿林青青的高山上，我望到一串硕大的白色藏文字符",
  "uiIdx": "1.2",
  "range": "1553-1605",
  "chapterUid": 4
 },
 {
  "level": 4,
  "text": "那几个字符藏在这绵延山脉中，有一种说不出的神秘。",
  "uiIdx": "",
  "range": "1649-1696",
  "chapterUid": 4
 },
 {
  "level": 2,
  "text": "托素湖",
  "uiIdx": "2",
  "range": "2125-2187",
  "chapterUid": 4
 },
 {
  "level": 3,
  "text": "托素湖附近的山里有几个岩洞，洞内和湖边散落着一些造型奇特、锈迹斑斑的“铁管”",
  "uiIdx": "2.1",
  "range": "2125-2187",
  "chapterUid": 4
 },
 {
  "level": 4,
  "text": "1996年这些“铁管”被发现，因其外观太过“工业感”，加上地处无人区，引发了各种天马行空的猜想，很多人认为这就是外星人超级文明的遗迹。",
  "uiIdx": "",
  "range": "2187-2254",
  "chapterUid": 4
 },
 {
  "level": 4,
  "text": "经过地质学家多次考察和化验，发现“铁管”并非人造物，而是“铁化木”，即树木的化石。",
  "uiIdx": "",
  "range": "2285-2352",
  "chapterUid": 4
 },
 {
  "level": 2,
  "text": "可鲁克湖和托素湖",
  "uiIdx": "3",
  "range": "3546-3564",
  "chapterUid": 4
 },
 {
  "level": 3,
  "text": "左手的湖面宽一些，嵌在土黄色的山间；右手的湖面小一点，泛着灰蓝",
  "uiIdx": "3.1",
  "range": "3546-3564",
  "chapterUid": 4
 },
 {
  "level": 4,
  "text": "它们在几百万年前，同属莲湖。",
  "uiIdx": "",
  "range": "3578-3624",
  "chapterUid": 4
 },
 {
  "level": 4,
  "text": "地壳深处的岩浆沿断裂带往上涌，湖底被一点点抬升，莲湖从此一分为二，形成可鲁克湖和托素湖。",
  "uiIdx": "",
  "range": "3624-3668",
  "chapterUid": 4
 },
 {
  "level": 4,
  "text": "这对姐妹湖，不再相连，却隔着山脊遥遥相望。",
  "uiIdx": "",
  "range": "3668-3689",
  "chapterUid": 4
 },
 {
  "level": 2,
  "text": "戈壁滩",
  "uiIdx": "4",
  "range": "4097-4151",
  "chapterUid": 4
 },
 {
  "level": 3,
  "text": "在一片空旷中，我望见远处有一面土城墙",
  "uiIdx": "4.1",
  "range": "4097-4151",
  "chapterUid": 4
 },
 {
  "level": 4,
  "text": "以前是一个农场监狱，很多人在这里劳动改造。",
  "uiIdx": "",
  "range": "4151-4217",
  "chapterUid": 4
 },
 {
  "level": 4,
  "text": "很多国民党的三代人都在这里扎根，有高级将领，也有被俘的普通士兵，多的时候有四五万人。",
  "uiIdx": "",
  "range": "4521-4597",
  "chapterUid": 4
 },
 {
  "level": 2,
  "text": "茶卡盐湖",
  "uiIdx": "5",
  "range": "5595-5644",
  "chapterUid": 4
 },
 {
  "level": 3,
  "text": "茶卡盐湖在黄昏时分，云层很厚，又压得很低，落日从云层和山峰交界的缝隙里倾泻下来，像一把金色的长剑，横贯天地，气宇不凡",
  "uiIdx": "5.1",
  "range": "5595-5644",
  "chapterUid": 4
 },
 {
  "level": 4,
  "text": "神奇的是，盐湖竟把这抹金光原封不动地“克隆”了一遍。",
  "uiIdx": "",
  "range": "5644-5693",
  "chapterUid": 4
 },
 {
  "level": 4,
  "text": "上面是山川与云海，下面也是山川与云海。漫天的云在湖面上重叠。天地上下相对，彼此映照。",
  "uiIdx": "",
  "range": "5693-5735",
  "chapterUid": 4
 },
 {
  "level": 3,
  "text": "茶卡盐湖在晚霞褪色不过二十分钟，就像突然换了一套滤镜，从刚才的黄昏浪漫风，一键切成了阴郁恐怖风",
  "uiIdx": "5.2",
  "range": "7332-7382",
  "chapterUid": 4
 },
 {
  "level": 4,
  "text": "天空中只剩一小块还亮着，四周却已迅速沉进黑暗。",
  "uiIdx": "",
  "range": "7382-7428",
  "chapterUid": 4
 },
 {
  "level": 4,
  "text": "云是黑的，湖也是黑的，远处的山影也只剩一道模糊的轮廓。",
  "uiIdx": "",
  "range": "7428-7455",
  "chapterUid": 4
 },
 {
  "level": 4,
  "text": "刚才还温柔地像偶像剧，转眼就有了几分末日降临的气势。",
  "uiIdx": "",
  "range": "7455-7481",
  "chapterUid": 4
 },
 {
  "level": 2,
  "text": "柴达木盆地",
  "uiIdx": "6",
  "range": "9156-9190",
  "chapterUid": 4
 },
 {
  "level": 3,
  "text": "柴达木盆地拥有规模巨大的雅丹地貌群，是中国雅丹地貌最集中的地区之一",
  "uiIdx": "6.1",
  "range": "9156-9190",
  "chapterUid": 4
 },
 {
  "level": 4,
  "text": "这里干旱少雨，又常年受到强风侵蚀。",
  "uiIdx": "",
  "range": "9190-9230",
  "chapterUid": 4
 },
 {
  "level": 4,
  "text": "风裹着沙粒，一遍又一遍地刮过裸露的岩层，年复一年地磨、削、切割，最终把完整的岩层雕刻成一座座山丘和一道道沟槽。",
  "uiIdx": "",
  "range": "9230-9285",
  "chapterUid": 4
 },
 {
  "level": 4,
  "text": "这里缺水，缺植物。山就是山，戈壁就是戈壁，天空一直压到地平线尽头。",
  "uiIdx": "",
  "range": "9285-9341",
  "chapterUid": 4
 }
]