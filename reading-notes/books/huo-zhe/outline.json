[
 {
  "level": 1,
  "text": "自序",
  "uiIdx": "",
  "range": "",
  "chapterUid": 24
 },
 {
  "level": 2,
  "text": "内心写作的重要性",
  "uiIdx": "1",
  "range": "471-498",
  "chapterUid": 24
 },
 {
  "level": 3,
  "text": "内心让作家真实地了解自己，了解世界",
  "uiIdx": "1.1",
  "range": "471-498",
  "chapterUid": 24
 },
 {
  "level": 4,
  "text": "一旦了解了自己也就了解了世界。",
  "uiIdx": "",
  "range": "471-498",
  "chapterUid": 24
 },
 {
  "level": 3,
  "text": "只有写作、不停地写作才能使内心敞开",
  "uiIdx": "1.2",
  "range": "498-625",
  "chapterUid": 24
 },
 {
  "level": 4,
  "text": "内心并非时时刻刻都是敞开的，它更多的时候倒是封闭起来。",
  "uiIdx": "",
  "range": "498-625",
  "chapterUid": 24
 },
 {
  "level": 2,
  "text": "作家与现实的紧张关系",
  "uiIdx": "2",
  "range": "679-801",
  "chapterUid": 24
 },
 {
  "level": 3,
  "text": "作家沉湎于想象之中，又被现实紧紧控制",
  "uiIdx": "2.1",
  "range": "679-801",
  "chapterUid": 24
 },
 {
  "level": 4,
  "text": "我明确感受着自我的分裂，我无法使自己变得纯粹。",
  "uiIdx": "",
  "range": "679-801",
  "chapterUid": 24
 },
 {
  "level": 3,
  "text": "作家笔下的现实说穿了只是一个环境，是固定的、死去的现实",
  "uiIdx": "2.2",
  "range": "1419-1464",
  "chapterUid": 24
 },
 {
  "level": 4,
  "text": "他们看不到人是怎样走过来的，也看不到怎样走去。",
  "uiIdx": "",
  "range": "1464-1487",
  "chapterUid": 24
 },
 {
  "level": 2,
  "text": "作家对真理的追求",
  "uiIdx": "3",
  "range": "1608-1661",
  "chapterUid": 24
 },
 {
  "level": 3,
  "text": "一位真正的作家所寻找的是真理，是一种排斥道德判断的真理",
  "uiIdx": "3.1",
  "range": "1608-1661",
  "chapterUid": 24
 },
 {
  "level": 4,
  "text": "作家的使命不是发泄，不是控诉或者揭露，他应该向人们展示高尚。",
  "uiIdx": "",
  "range": "1661-1691",
  "chapterUid": 24
 },
 {
  "level": 3,
  "text": "人是为活着本身而活着的，而不是为了活着之外的任何事物所活着",
  "uiIdx": "3.2",
  "range": "1898-1937",
  "chapterUid": 24
 },
 {
  "level": 4,
  "text": "我感到自己写下了高尚的作品。",
  "uiIdx": "",
  "range": "1937-1951",
  "chapterUid": 24
 },
 {
  "level": 1,
  "text": "一",
  "uiIdx": "",
  "range": "",
  "chapterUid": 24,
  "display": "版权信息 · 一 · 作者的游手好闲生活"
 },
 {
  "level": 2,
  "text": "作者的游手好闲生活",
  "uiIdx": "1",
  "range": "1533-1591",
  "chapterUid": 24
 },
 {
  "level": 3,
  "text": "作者在夏天去乡间收集民间歌谣",
  "uiIdx": "1.1",
  "range": "1533-1591",
  "chapterUid": 24
 },
 {
  "level": 4,
  "text": "作者整日张大嘴巴打着哈欠，散漫地走在田间小道上。",
  "uiIdx": "",
  "range": "1533-1591",
  "chapterUid": 24
 },
 {
  "level": 3,
  "text": "作者喜欢和农民聊天，喜欢他们的茶水和生活",
  "uiIdx": "1.2",
  "range": "1167-1259",
  "chapterUid": 24
 },
 {
  "level": 4,
  "text": "作者毫无顾忌地拿起积满茶垢的茶碗舀水喝，还把自己的水壶灌满。",
  "uiIdx": "",
  "range": "1167-1259",
  "chapterUid": 24
 },
 {
  "level": 4,
  "text": "作者和一位守着瓜田的老人聊了整整一个下午。",
  "uiIdx": "",
  "range": "1259-1324",
  "chapterUid": 24
 },
 {
  "level": 4,
  "text": "作者最喜欢的是傍晚来到时，坐在农民的屋前，看着他们将提上的井水泼在地上，压住蒸腾的尘土，夕阳的光芒在树梢上照射下来，拿一把他们递过来的扇子，尝尝他们的盐一样咸的咸菜，看看几个年轻女人，和男人们说着话。",
  "uiIdx": "",
  "range": "1362-1461",
  "chapterUid": 24
 },
 {
  "level": 2,
  "text": "作者的恋爱经历",
  "uiIdx": "2",
  "range": "2203-2249",
  "chapterUid": 24
 },
 {
  "level": 3,
  "text": "作者在夏天遇到了一位赏心悦目的女孩，和她共同度过了一个炎热的下午",
  "uiIdx": "2.1",
  "range": "2203-2249",
  "chapterUid": 24
 },
 {
  "level": 4,
  "text": "这个十六七岁的女孩，羞怯地与我共同度过了一个炎热的下午，她每次露出笑容时都要深深地低下头去。",
  "uiIdx": "",
  "range": "2287-2365",
  "chapterUid": 24
 },
 {
  "level": 4,
  "text": "我看着她偷偷放下卷起的裤管，又怎样将自己的光脚丫子藏到草丛里去。",
  "uiIdx": "",
  "range": "2287-2365",
  "chapterUid": 24
 },
 {
  "level": 3,
  "text": "作者原本想带女孩外出游玩，但最终因为女孩的哥哥们而放弃",
  "uiIdx": "2.2",
  "range": "2400-2418",
  "chapterUid": 24
 },
 {
  "level": 4,
  "text": "我当初情绪激昂，说这些也是真心实意。",
  "uiIdx": "",
  "range": "2400-2418",
  "chapterUid": 24
 },
 {
  "level": 4,
  "text": "可是后来，当她三个强壮如牛的哥哥走过来时，我才吓一跳，我感到自己应该逃之夭夭了，否则我就会不得不娶她为妻。",
  "uiIdx": "",
  "range": "2445-2498",
  "chapterUid": 24
 },
 {
  "level": 2,
  "text": "福贵老人的故事",
  "uiIdx": "3",
  "range": "4290-4339",
  "chapterUid": 24
 },
 {
  "level": 3,
  "text": "福贵老人讲述自己的生平",
  "uiIdx": "3.1",
  "range": "4290-4339",
  "chapterUid": 24
 },
 {
  "level": 4,
  "text": "四十多年前，我爹常在这里走来走去，他穿着一身黑颜色的绸衣，总是把双手背在身后，他出门时常对我娘说：“我到自己的地上去走走。”。",
  "uiIdx": "",
  "range": "4290-4339",
  "chapterUid": 24
 },
 {
  "level": 4,
  "text": "我爹是很有身份的人，可他拉屎时就像个穷人了。他不爱在屋里床边的马桶上拉屎，跟牲畜似的喜欢到野地里去拉屎。",
  "uiIdx": "",
  "range": "4526-4578",
  "chapterUid": 24
 },
 {
  "level": 4,
  "text": "我念过几年私塾，穿长衫的私塾先生叫我念一段书时，是我最高兴的。",
  "uiIdx": "",
  "range": "5213-5244",
  "chapterUid": 24
 },
 {
  "level": 4,
  "text": "我从小就不可救药，这是我爹的话。私塾先生说我是朽木不可雕也。",
  "uiIdx": "",
  "range": "5429-5459",
  "chapterUid": 24
 },
 {
  "level": 4,
  "text": "我长大以后喜欢往城里跑，常常是十天半月不回家。",
  "uiIdx": "",
  "range": "5813-5836",
  "chapterUid": 24
 },
 {
  "level": 4,
  "text": "我爱往妓院钻，听那些风骚的女人整夜叽叽喳喳和哼哼哈哈，那些声音听上去像是在给我挠痒痒。",
  "uiIdx": "",
  "range": "5914-5957",
  "chapterUid": 24
 },
 {
  "level": 4,
  "text": "人哪，一旦嫖上以后，也就免不了要去赌。这个嫖和赌，就像是胳膊和肩膀连在一起，怎么都分不开。",
  "uiIdx": "",
  "range": "5957-6003",
  "chapterUid": 24
 },
 {
  "level": 4,
  "text": "后来我更喜欢赌博了，嫖妓只是为了轻松一下，就跟水喝多了要去方便一下一样，说白了就是撒尿。",
  "uiIdx": "",
  "range": "6003-6047",
  "chapterUid": 24
 },
 {
  "level": 4,
  "text": "我赌博时也在青楼，常玩的是麻将、牌九和骰子。我每赌必输，越输我越想把我爹年轻时输掉的一百多亩地赢回来。",
  "uiIdx": "",
  "range": "9822-9873",
  "chapterUid": 24
 },
 {
  "level": 4,
  "text": "我最后一次赌博时，家珍来了，那时候天都快黑了，这是家珍后来告诉我的，我当时根本不知道天是亮着还是要黑了。",
  "uiIdx": "",
  "range": "11783-11835",
  "chapterUid": 24
 },
 {
  "level": 3,
  "text": "福贵老人的结局",
  "uiIdx": "3.2",
  "range": "23801-23846",
  "chapterUid": 24
 },
 {
  "level": 4,
  "text": "我爹死后，我像是染上了瘟疫一样浑身无力，整日坐在茅屋前的地上，一会眼泪汪汪，一会唉声叹气。",
  "uiIdx": "",
  "range": "23801-23846",
  "chapterUid": 24
 },
 {
  "level": 4,
  "text": "我爹死后十天，我丈人来了，他右手提着长衫脸色铁青地走进了村里，后面是一抬披红戴绿的花轿，十来个年轻人敲锣打鼓拥在两旁。",
  "uiIdx": "",
  "range": "24325-24384",
  "chapterUid": 24
 },
 {
  "level": 4,
  "text": "我娘和家珍听到响声从屋里出来，家珍叫了声：“爹。”。",
  "uiIdx": "",
  "range": "24687-24708",
  "chapterUid": 24
 },
 {
  "level": 4,
  "text": "我丈人看看他女儿，对我娘说：“那畜生呢？”。",
  "uiIdx": "",
  "range": "24770-24784",
  "chapterUid": 24
 },
 {
  "level": 4,
  "text": "我娘赔着笑脸说：“你是说福贵吧？”。",
  "uiIdx": "",
  "range": "24849-24857",
  "chapterUid": 24
 },
 {
  "level": 4,
  "text": "“还会是谁。”我丈人的脸转了过来，看到了我，他向我走了两步，对我喊：“畜生，你过来。”。",
  "uiIdx": "",
  "range": "24924-25025",
  "chapterUid": 24
 },
 {
  "level": 4,
  "text": "我站着没有动，我哪敢过去。我丈人挥着手向我喊：“你过来，你这畜生，怎么不来向我请安了？畜生你听着，当初是怎么娶走家珍的，我今日也怎么接她回去。你看看，这是花轿，这是锣鼓，比你当初娶亲时只多不少。”。",
  "uiIdx": "",
  "range": "24960-25067",
  "chapterUid": 24
 },
 {
  "level": 4,
  "text": "喊完以后，我丈人回头对家珍说：“你快进屋去收拾一下。”。",
  "uiIdx": "",
  "range": "25210-25266",
  "chapterUid": 24
 },
 {
  "level": 4,
  "text": "家珍站着没动，叫了一声：“爹。”。",
  "uiIdx": "",
  "range": "25295-25307",
  "chapterUid": 24
 },
 {
  "level": 4,
  "text": "我丈人使劲跺了下脚说：“还不快去。”。",
  "uiIdx": "",
  "range": "25369-25380",
  "chapterUid": 24
 },
 {
  "level": 4,
  "text": "家珍看看站在远处地里的我，转身进屋了。",
  "uiIdx": "",
  "range": "25445-25464",
  "chapterUid": 24
 },
 {
  "level": 4,
  "text": "我娘这时眼泪汪汪地对他说：“行行好，让家珍留下吧。”。",
  "uiIdx": "",
  "range": "25464-25519",
  "chapterUid": 24
 },
 {
  "level": 4,
  "text": "我丈人朝我娘摆摆手，又转过身来对我喊：“畜生，从今以后家珍和你一刀两断，我们陈家和你们徐家永不往来。”。",
  "uiIdx": "",
  "range": "25548-25628",
  "chapterUid": 24
 },
 {
  "level": 4,
  "text": "我娘的身体弯下去求他：“求你看在福贵他爹的分上，让家珍留下吧。”。",
  "uiIdx": "",
  "range": "25657-25718",
  "chapterUid": 24
 },
 {
  "level": 4,
  "text": "我丈人冲着我娘喊：“他爹都让他气死啦。”。",
  "uiIdx": "",
  "range": "25785-25796",
  "chapterUid": 24
 },
 {
  "level": 4,
  "text": "喊完我丈人自己也觉得有些过分，便缓一下口气说：“你也别怪我心狠，都是那畜生胡来才会有今天。”。",
  "uiIdx": "",
  "range": "25825-25900",
  "chapterUid": 24
 },
 {
  "level": 4,
  "text": "说完丈人又转向我，喊道：“凤霞就留给你们徐家，家珍肚里的孩子就是我们陈家的人啦。”。",
  "uiIdx": "",
  "range": "25929-25999",
  "chapterUid": 24
 },
 {
  "level": 4,
  "text": "我娘站在一旁呜呜地哭，她抹着眼泪说：“这让我怎么去向徐家祖宗交代？”。",
  "uiIdx": "",
  "range": "26028-26091",
  "chapterUid": 24
 },
 {
  "level": 4,
  "text": "家珍提了个包裹走了出来。我丈人对她说：“上轿。”。",
  "uiIdx": "",
  "range": "26120-26132",
  "chapterUid": 24
 },
 {
  "level": 4,
  "text": "家珍扭头看看我，走到轿子旁又回头看了看我，再看看我娘，钻进了轿子。",
  "uiIdx": "",
  "range": "26202-26235",
  "chapterUid": 24
 },
 {
  "level": 4,
  "text": "这时凤霞不知从哪里跑了出来，一看到她娘坐上轿子了，她也想坐进去，她半个身体才进轿子，就被家珍的手推了出来。",
  "uiIdx": "",
  "range": "26235-26288",
  "chapterUid": 24
 },
 {
  "level": 4,
  "text": "我丈人向轿夫挥了挥手，轿子被抬了起来，家珍在里面大声哭起来，我丈人喊道：“给我往响里敲。”。",
  "uiIdx": "",
  "range": "26317-26362",
  "chapterUid": 24
 },
 {
  "level": 4,
  "text": "十来个年轻人拼命地敲响了锣鼓，我就听不到家珍的哭声了。",
  "uiIdx": "",
  "range": "26391-26418",
  "chapterUid": 24
 },
 {
  "level": 4,
  "text": "轿子上了路，我丈人手提长衫和轿子走得一样快。我娘扭着小脚，可怜巴巴地跟在后面，一直跟到村口才站住。",
  "uiIdx": "",
  "range": "26418-26467",
  "chapterUid": 24
 },
 {
  "level": 1,
  "text": "二",
  "uiIdx": "",
  "range": "",
  "chapterUid": 24,
  "display": "版权信息 · 二 · 福贵的经历"
 },
 {
  "level": 2,
  "text": "福贵的经历",
  "uiIdx": "1",
  "range": "5895-5912",
  "chapterUid": 24
 },
 {
  "level": 3,
  "text": "福贵年轻时挥霍无度，输光了家产",
  "uiIdx": "1.1",
  "range": "5895-5912",
  "chapterUid": 24
 },
 {
  "level": 4,
  "text": "福贵曾经是个阔少爷，可他嗜赌如命，很快就将家底败光了。",
  "uiIdx": "",
  "range": "7126-7144",
  "chapterUid": 24
 },
 {
  "level": 3,
  "text": "福贵经历了从富有到贫穷的转变，但他依然乐观",
  "uiIdx": "1.2",
  "range": "5895-5912",
  "chapterUid": 24
 },
 {
  "level": 4,
  "text": "福贵输光家产以后，他娘、家珍、凤霞和儿子有庆都跟着他受苦。",
  "uiIdx": "",
  "range": "5895-5912",
  "chapterUid": 24
 },
 {
  "level": 4,
  "text": "福贵对生活的态度很乐观，即使在最困难的时候，他也会笑对人生。",
  "uiIdx": "",
  "range": "1293-1361",
  "chapterUid": 24
 },
 {
  "level": 2,
  "text": "家珍的坚韧与伟大",
  "uiIdx": "2",
  "range": "5895-5912",
  "chapterUid": 24
 },
 {
  "level": 3,
  "text": "家珍是福贵的妻子，她坚韧不拔，始终支持着福贵",
  "uiIdx": "2.1",
  "range": "5895-5912",
  "chapterUid": 24
 },
 {
  "level": 4,
  "text": "家珍在福贵输光家产之后，依然不离不弃，回到福贵身边。",
  "uiIdx": "",
  "range": "5895-5912",
  "chapterUid": 24
 },
 {
  "level": 4,
  "text": "家珍在福贵被抓去当壮丁后，独自支撑着家庭，等待福贵的归来。",
  "uiIdx": "",
  "range": "24887-24923",
  "chapterUid": 24
 },
 {
  "level": 3,
  "text": "家珍的坚韧与伟大，使福贵深感敬意",
  "uiIdx": "2.2",
  "range": "2205-2227",
  "chapterUid": 24
 },
 {
  "level": 4,
  "text": "福贵对家珍的坚韧与伟大深感敬意，他认为家珍是世界上最善良的女人。",
  "uiIdx": "",
  "range": "2205-2227",
  "chapterUid": 24
 },
 {
  "level": 2,
  "text": "福贵与家人的生活",
  "uiIdx": "3",
  "range": "13380-13432",
  "chapterUid": 24
 },
 {
  "level": 3,
  "text": "福贵与家珍、凤霞和有庆过着艰苦但幸福的生活",
  "uiIdx": "3.1",
  "range": "13380-13432",
  "chapterUid": 24
 },
 {
  "level": 4,
  "text": "福贵与家珍、凤霞和有庆住在茅屋里，虽然生活艰苦，但他们彼此相爱，互相扶持。",
  "uiIdx": "",
  "range": "13380-13432",
  "chapterUid": 24
 },
 {
  "level": 4,
  "text": "福贵与家珍、凤霞和有庆虽然生活艰苦，但他们乐观向上，对未来充满希望。",
  "uiIdx": "",
  "range": "8958-9002",
  "chapterUid": 24
 },
 {
  "level": 3,
  "text": "福贵与家人的生活虽然艰苦，但他们始终坚持下去",
  "uiIdx": "3.2",
  "range": "1802-1862",
  "chapterUid": 24
 },
 {
  "level": 4,
  "text": "福贵与家珍、凤霞和有庆在艰苦的生活中，始终坚持下去，他们的生活虽然艰苦，但他们始终坚持下去。",
  "uiIdx": "",
  "range": "1802-1862",
  "chapterUid": 24
 },
 {
  "level": 2,
  "text": "福贵的变化",
  "uiIdx": "4",
  "range": "6908-6945",
  "chapterUid": 24
 },
 {
  "level": 3,
  "text": "福贵从过去的浪子，变成了一个勤劳的农民",
  "uiIdx": "4.1",
  "range": "6908-6945",
  "chapterUid": 24
 },
 {
  "level": 4,
  "text": "福贵租了龙二的田，开始学着种田，他起早贪黑，辛勤劳作。",
  "uiIdx": "",
  "range": "6908-6945",
  "chapterUid": 24
 },
 {
  "level": 4,
  "text": "福贵与家珍、凤霞和有庆一起劳动，他们的生活虽然艰苦，但他们始终坚持下去。",
  "uiIdx": "",
  "range": "8958-9002",
  "chapterUid": 24
 },
 {
  "level": 3,
  "text": "福贵的心态发生了变化，他更加珍惜生活，更加热爱家人",
  "uiIdx": "4.2",
  "range": "1361-1422",
  "chapterUid": 24
 },
 {
  "level": 4,
  "text": "福贵经历了战争的磨难，他对生活的看法发生了变化，他更加珍惜生活，更加热爱家人。",
  "uiIdx": "",
  "range": "1361-1422",
  "chapterUid": 24
 },
 {
  "level": 4,
  "text": "福贵对家珍、凤霞和有庆的爱，使他们的生活充满了温馨和希望。",
  "uiIdx": "",
  "range": "1451-1501",
  "chapterUid": 24
 },
 {
  "level": 1,
  "text": "三",
  "uiIdx": "",
  "range": "",
  "chapterUid": 24,
  "display": "版权信息 · 三 · 福贵和牛的劳作"
 },
 {
  "level": 2,
  "text": "福贵和牛的劳作",
  "uiIdx": "1",
  "range": "1761-1791",
  "chapterUid": 24
 },
 {
  "level": 3,
  "text": "福贵和牛的劳作情景",
  "uiIdx": "1.1",
  "range": "1761-1791",
  "chapterUid": 24
 },
 {
  "level": 4,
  "text": "福贵给牛套上犁，牛老了也和人老了一样，饿了还得先歇一下，才吃得下去东西。",
  "uiIdx": "",
  "range": "1761-1791",
  "chapterUid": 24
 },
 {
  "level": 4,
  "text": "老牛的肚皮耷拉下来，长长一条，它耕地时肚皮犹如一只大水袋一样摇来晃去。",
  "uiIdx": "",
  "range": "1851-1886",
  "chapterUid": 24
 },
 {
  "level": 3,
  "text": "福贵对牛的感情",
  "uiIdx": "1.2",
  "range": "1641-1658",
  "chapterUid": 24
 },
 {
  "level": 4,
  "text": "福贵对牛说：“家珍他们早在干活啦，你也歇够了。我知道你没吃饱，谁让你在水里待这么久？”。",
  "uiIdx": "",
  "range": "1641-1678",
  "chapterUid": 24
 },
 {
  "level": 2,
  "text": "家珍和凤霞的辛劳",
  "uiIdx": "2",
  "range": "16330-16357",
  "chapterUid": 24
 },
 {
  "level": 3,
  "text": "家珍的辛劳",
  "uiIdx": "2.1",
  "range": "16330-16357",
  "chapterUid": 24
 },
 {
  "level": 4,
  "text": "家珍得了没力气的病，起先我还以为她是年纪大了才这样的。",
  "uiIdx": "",
  "range": "16330-16357",
  "chapterUid": 24
 },
 {
  "level": 4,
  "text": "家珍再也挑不动担子了，她只能干些田里的轻活。",
  "uiIdx": "",
  "range": "16772-16802",
  "chapterUid": 24
 },
 {
  "level": 3,
  "text": "凤霞的辛劳",
  "uiIdx": "2.2",
  "range": "9006-9026",
  "chapterUid": 24
 },
 {
  "level": 4,
  "text": "凤霞已经能自己养活自己了，家里还养了两头羊，全靠有庆割草去喂它们。",
  "uiIdx": "",
  "range": "8950-9026",
  "chapterUid": 24
 },
 {
  "level": 4,
  "text": "凤霞每天蒙蒙亮时，家珍就把有庆叫醒，这孩子把镰刀扔在篮子里，一只手提着，一只手搓着眼睛跌跌撞撞走出屋门去割草。",
  "uiIdx": "",
  "range": "9026-9109",
  "chapterUid": 24
 },
 {
  "level": 2,
  "text": "有庆的成长和遭遇",
  "uiIdx": "3",
  "range": "9192-9216",
  "chapterUid": 24
 },
 {
  "level": 3,
  "text": "有庆的成长",
  "uiIdx": "3.1",
  "range": "9192-9216",
  "chapterUid": 24
 },
 {
  "level": 4,
  "text": "有庆十来岁的时候，一天两次来去就得跑五十多里路。",
  "uiIdx": "",
  "range": "9192-9216",
  "chapterUid": 24
 },
 {
  "level": 4,
  "text": "有庆每天三次给羊送草去，到了天快黑的时候，他还要去一次抱抱那两头羊。",
  "uiIdx": "",
  "range": "12346-12380",
  "chapterUid": 24
 },
 {
  "level": 3,
  "text": "有庆的遭遇",
  "uiIdx": "3.2",
  "range": "24388-24464",
  "chapterUid": 24
 },
 {
  "level": 4,
  "text": "有庆在学校里不好好念书，正用什么东西往前面一个孩子头上扔。",
  "uiIdx": "",
  "range": "24388-24464",
  "chapterUid": 24
 },
 {
  "level": 4,
  "text": "有庆把体育老师带到家里来了，大胖子把有庆夸了又夸，说他长大了能当个运动员，出去和外国人比赛跑步。",
  "uiIdx": "",
  "range": "28548-28601",
  "chapterUid": 24
 },
 {
  "level": 4,
  "text": "有庆在城里医院里抽血被抽死了。",
  "uiIdx": "",
  "range": "43622-43643",
  "chapterUid": 24
 },
 {
  "level": 2,
  "text": "家珍的去世和福贵的悲痛",
  "uiIdx": "4",
  "range": "47569-47582",
  "chapterUid": 24
 },
 {
  "level": 3,
  "text": "家珍的去世",
  "uiIdx": "4.1",
  "range": "47569-47582",
  "chapterUid": 24
 },
 {
  "level": 4,
  "text": "家珍在床上说：“福贵，我的日子不长了。”。",
  "uiIdx": "",
  "range": "47569-47582",
  "chapterUid": 24
 },
 {
  "level": 4,
  "text": "家珍说：“有庆还小啊。”。",
  "uiIdx": "",
  "range": "39265-39273",
  "chapterUid": 24
 },
 {
  "level": 3,
  "text": "福贵的悲痛",
  "uiIdx": "4.2",
  "range": "46084-46128",
  "chapterUid": 24
 },
 {
  "level": 4,
  "text": "福贵把有庆放在田埂上，回到家里偷偷拿了把锄头，再抱起有庆走到我娘和我爹的坟前，挖了一个坑。",
  "uiIdx": "",
  "range": "46084-46128",
  "chapterUid": 24
 },
 {
  "level": 4,
  "text": "福贵把有庆埋掉了，天蒙蒙亮了，我慢慢往家里走，走几步就要回头看看，走到家门口一想到再也看不到儿子，忍不住哭出了声音。",
  "uiIdx": "",
  "range": "46539-46635",
  "chapterUid": 24
 },
 {
  "level": 1,
  "text": "四",
  "uiIdx": "",
  "range": "",
  "chapterUid": 24,
  "display": "版权信息 · 四 · 有庆的死亡和家珍的悲痛"
 },
 {
  "level": 2,
  "text": "有庆的死亡和家珍的悲痛",
  "uiIdx": "1",
  "range": "6455-6482",
  "chapterUid": 24
 },
 {
  "level": 3,
  "text": "有庆在玩耍时不幸被车撞死，家珍因过度悲痛而想要随他而去",
  "uiIdx": "1.1",
  "range": "6455-6482",
  "chapterUid": 24
 },
 {
  "level": 4,
  "text": "有庆是家珍活下去的唯一希望，他的死让家珍失去了生活的信念。",
  "uiIdx": "",
  "range": "6455-6482",
  "chapterUid": 24
 },
 {
  "level": 3,
  "text": "家珍强撑着身体，但她的生命危在旦夕",
  "uiIdx": "1.2",
  "range": "2519-2545",
  "chapterUid": 24
 },
 {
  "level": 4,
  "text": "家珍病得连话都说不出，身体一点肉都没有，扶着她就跟扶着一捆柴火似的。",
  "uiIdx": "",
  "range": "2519-2545",
  "chapterUid": 24
 },
 {
  "level": 2,
  "text": "家珍的病情和福贵的决定",
  "uiIdx": "2",
  "range": "3096-3109",
  "chapterUid": 24
 },
 {
  "level": 3,
  "text": "医生诊断家珍的病情已经无法挽回，让福贵准备后事",
  "uiIdx": "2.1",
  "range": "3096-3109",
  "chapterUid": 24
 },
 {
  "level": 4,
  "text": "医生切脉后说：“脉搏弱得都快摸不到了。”。",
  "uiIdx": "",
  "range": "3096-3109",
  "chapterUid": 24
 },
 {
  "level": 4,
  "text": "医生说：“你准备着办后事吧。”。",
  "uiIdx": "",
  "range": "3138-3153",
  "chapterUid": 24
 },
 {
  "level": 3,
  "text": "福贵决定竭尽全力为家珍治病，让她死得舒坦",
  "uiIdx": "2.2",
  "range": "1476-1491",
  "chapterUid": 24
 },
 {
  "level": 4,
  "text": "福贵背着家珍到村口去看，家珍哭着说：“有庆不会在这条路上跑来了。”。",
  "uiIdx": "",
  "range": "1476-1491",
  "chapterUid": 24
 },
 {
  "level": 4,
  "text": "福贵和家珍商量着怎么也得给凤霞找一个男人，我们都是要死在她前面的，我们死后有凤霞收作，凤霞老这样下去，死后连个收作的人都没有。",
  "uiIdx": "",
  "range": "8851-8915",
  "chapterUid": 24
 },
 {
  "level": 2,
  "text": "凤霞的出嫁和不幸",
  "uiIdx": "3",
  "range": "14705-14731",
  "chapterUid": 24
 },
 {
  "level": 3,
  "text": "凤霞被城里来的搬运工万二喜娶走，过上了幸福的生活",
  "uiIdx": "3.1",
  "range": "14705-14731",
  "chapterUid": 24
 },
 {
  "level": 4,
  "text": "万二喜虽然是个偏头，但他实心眼，心眼好，把凤霞给他，我心里踏实。",
  "uiIdx": "",
  "range": "14705-14731",
  "chapterUid": 24
 },
 {
  "level": 4,
  "text": "凤霞在城里，我和家珍就跟丢了魂似的，怎么都觉得心慌。",
  "uiIdx": "",
  "range": "16263-16291",
  "chapterUid": 24
 },
 {
  "level": 3,
  "text": "凤霞生孩子时不幸去世，让福贵和二喜悲痛欲绝",
  "uiIdx": "3.2",
  "range": "30144-30198",
  "chapterUid": 24
 },
 {
  "level": 4,
  "text": "凤霞死后躺到了那间小屋里，我去看她一见到那间屋子就走不进去了，十多年前有庆也是死在这里的。",
  "uiIdx": "",
  "range": "30144-30198",
  "chapterUid": 24
 },
 {
  "level": 4,
  "text": "二喜哭得声音都哑了，走一段他说：“爹，我走不动了。”。",
  "uiIdx": "",
  "range": "30538-30593",
  "chapterUid": 24
 },
 {
  "level": 4,
  "text": "埋掉了凤霞，孩子也可以从医院里抱出来了。二喜抱着他儿子走了十多里路来我家，把孩子放在床上。",
  "uiIdx": "",
  "range": "31974-32019",
  "chapterUid": 24
 },
 {
  "level": 2,
  "text": "家珍的去世和福贵的悲痛",
  "uiIdx": "4",
  "range": "32379-32394",
  "chapterUid": 24
 },
 {
  "level": 3,
  "text": "家珍在凤霞去世三个月后也去世了，福贵和二喜都非常悲痛",
  "uiIdx": "4.1",
  "range": "32379-32394",
  "chapterUid": 24
 },
 {
  "level": 4,
  "text": "家珍死前的那些日子，常对我说：“福贵，有庆、凤霞是你送的葬，我想到你会亲手埋掉我，就安心了。”。",
  "uiIdx": "",
  "range": "32379-32455",
  "chapterUid": 24
 },
 {
  "level": 4,
  "text": "家珍是在中午死的。我收工回家，她眼睛睁了睁，我凑过去没听到她说话，就到灶间给她熬了碗粥。",
  "uiIdx": "",
  "range": "33036-33071",
  "chapterUid": 24
 },
 {
  "level": 3,
  "text": "福贵决定好好活下去，照顾苦根和二喜",
  "uiIdx": "4.2",
  "range": "32845-32912",
  "chapterUid": 24
 },
 {
  "level": 4,
  "text": "家珍说过：“凤霞、有庆都死在我前头，我心也定了，用不着再为他们操心，怎么说我也是做娘的女人，两个孩子活着时都孝顺我，做人能做成这样我该知足了。”。",
  "uiIdx": "",
  "range": "32845-32912",
  "chapterUid": 24
 },
 {
  "level": 4,
  "text": "家珍死后不到三个月，家珍也死了。家珍死前的那些日子，常对我说：“福贵，有庆、凤霞是你送的葬，我想到你会亲手埋掉我，就安心了。”。",
  "uiIdx": "",
  "range": "32363-32455",
  "chapterUid": 24
 },
 {
  "level": 1,
  "text": "五",
  "uiIdx": "",
  "range": "",
  "chapterUid": 24,
  "display": "版权信息 · 五 · 福贵对家珍之死的看法"
 },
 {
  "level": 2,
  "text": "福贵对家珍之死的看法",
  "uiIdx": "1",
  "range": "1268-1318",
  "chapterUid": 24
 },
 {
  "level": 3,
  "text": "家珍死得很好，死得平平安安、干干净净，死后一点是非都没留下",
  "uiIdx": "1.1",
  "range": "1268-1318",
  "chapterUid": 24
 },
 {
  "level": 4,
  "text": "不像村里有些女人，死了还有人说闲话。",
  "uiIdx": "",
  "range": "1268-1318",
  "chapterUid": 24
 },
 {
  "level": 2,
  "text": "苦根的成长经历",
  "uiIdx": "2",
  "range": "1801-1817",
  "chapterUid": 24
 },
 {
  "level": 3,
  "text": "家珍死后，福贵只有二喜和苦根了",
  "uiIdx": "2.1",
  "range": "1801-1817",
  "chapterUid": 24
 },
 {
  "level": 4,
  "text": "二喜花钱请人做了个背篼，苦根便整天在他爹背脊上了。",
  "uiIdx": "",
  "range": "1817-1887",
  "chapterUid": 24
 },
 {
  "level": 3,
  "text": "苦根在背篼里一哭，二喜听哭声就知道是饿了，还是撒尿了",
  "uiIdx": "2.2",
  "range": "2065-2097",
  "chapterUid": 24
 },
 {
  "level": 4,
  "text": "哭的声音长是饿了，哭的声音短是屁股那地方难受了。",
  "uiIdx": "",
  "range": "2126-2152",
  "chapterUid": 24
 },
 {
  "level": 3,
  "text": "苦根能走路了，二喜也轻松了一些",
  "uiIdx": "2.3",
  "range": "2660-2711",
  "chapterUid": 24
 },
 {
  "level": 4,
  "text": "他装卸时让苦根在一旁玩，拉起板车就把苦根放到车上。",
  "uiIdx": "",
  "range": "2660-2711",
  "chapterUid": 24
 },
 {
  "level": 3,
  "text": "苦根成了我们的命根子，他越往大里长，便越像凤霞",
  "uiIdx": "2.4",
  "range": "3271-3314",
  "chapterUid": 24
 },
 {
  "level": 4,
  "text": "越是像凤霞，也就越让我们看了心里难受。",
  "uiIdx": "",
  "range": "3271-3314",
  "chapterUid": 24
 },
 {
  "level": 2,
  "text": "二喜的意外死亡",
  "uiIdx": "3",
  "range": "4633-4646",
  "chapterUid": 24
 },
 {
  "level": 3,
  "text": "二喜是被两排水泥板夹死的",
  "uiIdx": "3.1",
  "range": "4633-4646",
  "chapterUid": 24
 },
 {
  "level": 4,
  "text": "干搬运这活，一不小心就磕破碰伤，可丢了命的只有二喜，徐家的人命都苦。",
  "uiIdx": "",
  "range": "4646-4680",
  "chapterUid": 24
 },
 {
  "level": 3,
  "text": "二喜死后，我便把苦根带到村里来住了",
  "uiIdx": "3.2",
  "range": "5786-5804",
  "chapterUid": 24
 },
 {
  "level": 4,
  "text": "离开城里那天，我把二喜屋里的用具给了那里的邻居，自己挑了几样轻便的带回来。",
  "uiIdx": "",
  "range": "5804-5841",
  "chapterUid": 24
 },
 {
  "level": 2,
  "text": "苦根的意外死亡",
  "uiIdx": "4",
  "range": "11977-12031",
  "chapterUid": 24
 },
 {
  "level": 3,
  "text": "苦根是吃豆子撑死的",
  "uiIdx": "4.1",
  "range": "11977-12031",
  "chapterUid": 24
 },
 {
  "level": 4,
  "text": "这孩子不是嘴馋，是我家太穷，村里谁家的孩子都过得比苦根好，就是豆子，苦根也是难得能吃上。",
  "uiIdx": "",
  "range": "11977-12031",
  "chapterUid": 24
 },
 {
  "level": 3,
  "text": "往后的日子我只能一个人过了，我总想着自己日子也不长了，谁知一过又过了这些年",
  "uiIdx": "4.2",
  "range": "12092-12130",
  "chapterUid": 24
 },
 {
  "level": 4,
  "text": "我还是老样子，腰还是常常疼，眼睛还是花，我耳朵倒是很灵，村里人说话，我不看也能知道是谁在说。",
  "uiIdx": "",
  "range": "12130-12176",
  "chapterUid": 24
 },
 {
  "level": 4,
  "text": "我有时候想想伤心，有时候想想又很踏实，家里人全是我送的葬，全是我亲手埋的，到了有一天我腿一伸，也不用担心谁了。",
  "uiIdx": "",
  "range": "12176-12232",
  "chapterUid": 24
 },
 {
  "level": 1,
  "text": "韩文版自序",
  "uiIdx": "",
  "range": "",
  "chapterUid": 31
 },
 {
  "level": 2,
  "text": "《活着》的主题和意义",
  "uiIdx": "1",
  "range": "621-676",
  "chapterUid": 31
 },
 {
  "level": 3,
  "text": "《活着》讲述了一个人和他的命运之间的友情，这是最为感人的友情",
  "uiIdx": "1.1",
  "range": "621-676",
  "chapterUid": 31
 },
 {
  "level": 4,
  "text": "他们互相感激，同时也互相仇恨。",
  "uiIdx": "",
  "range": "621-676",
  "chapterUid": 31
 },
 {
  "level": 4,
  "text": "他们谁也无法抛弃对方，同时谁也没有理由抱怨对方。",
  "uiIdx": "",
  "range": "676-700",
  "chapterUid": 31
 },
 {
  "level": 3,
  "text": "《活着》还讲述了人如何去承受巨大的苦难",
  "uiIdx": "1.2",
  "range": "772-792",
  "chapterUid": 31
 },
 {
  "level": 4,
  "text": "让一根头发去承受三万斤的重压，它没有断。",
  "uiIdx": "",
  "range": "772-792",
  "chapterUid": 31
 },
 {
  "level": 3,
  "text": "《活着》还讲述了眼泪的宽广和丰富；讲述了绝望的不存在",
  "uiIdx": "1.3",
  "range": "823-857",
  "chapterUid": 31
 },
 {
  "level": 4,
  "text": "讲述了人是为了活着本身而活着的，而不是为了活着之外的任何事物而活着。",
  "uiIdx": "",
  "range": "823-857",
  "chapterUid": 31
 },
 {
  "level": 3,
  "text": "《活着》也讲述了我们中国人这几十年是如何熬过来的。",
  "uiIdx": "1.4",
  "range": "857-885",
  "chapterUid": 31
 },
 {
  "level": 2,
  "text": "《活着》的创作背景和作者的期望",
  "uiIdx": "2",
  "range": "430-492",
  "chapterUid": 31
 },
 {
  "level": 3,
  "text": "作者希望通过这部作品让韩国的读者能够容忍他的冒险",
  "uiIdx": "2.1",
  "range": "430-492",
  "chapterUid": 31
 },
 {
  "level": 4,
  "text": "作者不知道应该怎样来解释这一部作品，这样的任务交给作者去完成是十分困难的。",
  "uiIdx": "",
  "range": "430-492",
  "chapterUid": 31
 },
 {
  "level": 3,
  "text": "作者希望读者能够理解作品的深层含义",
  "uiIdx": "2.2",
  "range": "903-953",
  "chapterUid": 31
 },
 {
  "level": 4,
  "text": "文学就是这样，它讲述了作家意识到的事物，同时也讲述了作家所没有意识到的，读者就是这时候站出来发言的。",
  "uiIdx": "",
  "range": "903-953",
  "chapterUid": 31
 },
 {
  "level": 1,
  "text": "日文版自序",
  "uiIdx": "",
  "range": "",
  "chapterUid": 31
 },
 {
  "level": 2,
  "text": "《活着》的主题和意义",
  "uiIdx": "1",
  "range": "612-653",
  "chapterUid": 31
 },
 {
  "level": 3,
  "text": "《活着》讲述了一个人对自己经历的感受，而非旁观者对别人经历的看法",
  "uiIdx": "1.1",
  "range": "612-653",
  "chapterUid": 31
 },
 {
  "level": 4,
  "text": "福贵虽然历经苦难，但是他是在讲述自己的故事。",
  "uiIdx": "",
  "range": "653-681",
  "chapterUid": 31
 },
 {
  "level": 4,
  "text": "我用第一人称的叙述，福贵的讲述里不需要别人的看法，只需要他自己的感受。",
  "uiIdx": "",
  "range": "681-728",
  "chapterUid": 31
 },
 {
  "level": 3,
  "text": "《活着》表达了时间的漫长和短暂，表达了时间的动荡和时间的宁静",
  "uiIdx": "1.2",
  "range": "2653-2702",
  "chapterUid": 31
 },
 {
  "level": 4,
  "text": "在文学的叙述里，描述一生的方式是表达时间最为直接的方式。",
  "uiIdx": "",
  "range": "2702-2775",
  "chapterUid": 31
 },
 {
  "level": 4,
  "text": "时间的变化掌握了《活着》里福贵命运的变化，或者说时间的方式就是福贵活着的方式。",
  "uiIdx": "",
  "range": "2702-2775",
  "chapterUid": 31
 },
 {
  "level": 2,
  "text": "时间的创造力和影响力",
  "uiIdx": "2",
  "range": "1052-1114",
  "chapterUid": 31
 },
 {
  "level": 3,
  "text": "时间创造了诞生和死亡，创造了幸福和痛苦，创造了平静和动荡，创造了记忆和感受，创造了理解和想象，最后创造了故事和神奇",
  "uiIdx": "2.1",
  "range": "1052-1114",
  "chapterUid": 31
 },
 {
  "level": 4,
  "text": "贺知章的《回乡偶书》说的就是时间带来的喜悦和辛酸。",
  "uiIdx": "",
  "range": "1114-1139",
  "chapterUid": 31
 },
 {
  "level": 4,
  "text": "《太平广记》卷第二百七十四讲述了一个由时间创造的故事。",
  "uiIdx": "",
  "range": "1324-1351",
  "chapterUid": 31
 },
 {
  "level": 4,
  "text": "但丁《神曲》中的诗句，改变了语言中的时间顺序，让我们顷刻间感受到了语言带来的速度。",
  "uiIdx": "",
  "range": "2252-2294",
  "chapterUid": 31
 },
 {
  "level": 3,
  "text": "时间在文学叙述中，没有什么比时间更具有说服力了，因为时间无须通知我们就可以改变一切",
  "uiIdx": "2.2",
  "range": "2133-2174",
  "chapterUid": 31
 },
 {
  "level": 4,
  "text": "在文学的叙述里，让时间帮助着一个人的一生在几千字的篇幅里栩栩如生。",
  "uiIdx": "",
  "range": "2448-2497",
  "chapterUid": 31
 },
 {
  "level": 4,
  "text": "时间还造就了《战争与和平》《静静的顿河》和《百年孤独》的故事和神奇。",
  "uiIdx": "",
  "range": "2497-2583",
  "chapterUid": 31
 },
 {
  "level": 1,
  "text": "英文版自序",
  "uiIdx": "",
  "range": "",
  "chapterUid": 31
 },
 {
  "level": 2,
  "text": "《活着》的创作灵感来源",
  "uiIdx": "1",
  "range": "516-550",
  "chapterUid": 31
 },
 {
  "level": 3,
  "text": "《老黑奴》这首歌深深地打动了作者，作者决定写下一篇这样的小说，就是这篇《活着》",
  "uiIdx": "1.1",
  "range": "516-550",
  "chapterUid": 31
 },
 {
  "level": 4,
  "text": "老黑奴经历了一生的苦难，家人都先他而去，而他依然友好地对待这个世界，没有一句抱怨的话。",
  "uiIdx": "",
  "range": "430-516",
  "chapterUid": 31
 },
 {
  "level": 2,
  "text": "文学的力量：跨越文化和国界的共同人性",
  "uiIdx": "2",
  "range": "763-826",
  "chapterUid": 31
 },
 {
  "level": 3,
  "text": "老黑奴和福贵，这是两个截然不同的人，但他们就像是同一个人",
  "uiIdx": "2.1",
  "range": "763-826",
  "chapterUid": 31
 },
 {
  "level": 4,
  "text": "他们生活在不同的国家，经历着不同的时代，属于不同的民族和不同的文化，有着不同的肤色和不同的嗜好。",
  "uiIdx": "",
  "range": "763-826",
  "chapterUid": 31
 },
 {
  "level": 4,
  "text": "所有的不同都无法抵挡一个基本的共同之处，人的共同之处。人的体验和欲望还有想象和理解，会取消所有不同的界限，会让一个人从他人的经历里感受到自己的命运。",
  "uiIdx": "",
  "range": "826-925",
  "chapterUid": 31
 },
 {
  "level": 2,
  "text": "作者的阅读体验：在文学作品中找到自我",
  "uiIdx": "3",
  "range": "925-987",
  "chapterUid": 31
 },
 {
  "level": 3,
  "text": "作者在纳撒尼尔·霍桑、威廉·福克纳和托妮·莫里森的作品里读到自己。",
  "uiIdx": "3.1",
  "range": "925-987",
  "chapterUid": 31
 },
 {
  "level": 1,
  "text": "麦田新版自序",
  "uiIdx": "",
  "range": "",
  "chapterUid": 31
 },
 {
  "level": 2,
  "text": "麦田出版公司成立十五年和《活着》出版十四年",
  "uiIdx": "1",
  "range": "431-461",
  "chapterUid": 31
 },
 {
  "level": 3,
  "text": "麦田决定出版《活着》的经典纪念版",
  "uiIdx": "1.1",
  "range": "461-520",
  "chapterUid": 31
 },
 {
  "level": 4,
  "text": "《活着》在台湾出版十四年来，每年加印。",
  "uiIdx": "",
  "range": "461-520",
  "chapterUid": 31
 },
 {
  "level": 2,
  "text": "作者与麦田出版公司的渊源",
  "uiIdx": "2",
  "range": "570-628",
  "chapterUid": 31
 },
 {
  "level": 3,
  "text": "陈雨航发现并出版了作者的作品",
  "uiIdx": "2.1",
  "range": "570-628",
  "chapterUid": 31
 },
 {
  "level": 4,
  "text": "陈雨航在远流出版公司主持文学和电影出版时，与作者签下了两本小说集的中文繁体字出版合同。",
  "uiIdx": "",
  "range": "570-628",
  "chapterUid": 31
 },
 {
  "level": 4,
  "text": "陈雨航辞职离开远流后，与苏拾平成立了麦田出版公司。",
  "uiIdx": "",
  "range": "742-779",
  "chapterUid": 31
 },
 {
  "level": 3,
  "text": "《活着》是作者在麦田出版的第一部小说",
  "uiIdx": "2.2",
  "range": "808-842",
  "chapterUid": 31
 },
 {
  "level": 4,
  "text": "作者的全部小说都在麦田出版了。",
  "uiIdx": "",
  "range": "808-842",
  "chapterUid": 31
 },
 {
  "level": 2,
  "text": "《活着》的创作经历和作者的人生态度",
  "uiIdx": "3",
  "range": "1219-1258",
  "chapterUid": 31
 },
 {
  "level": 3,
  "text": "作者在写作《活着》时，从旁观者的角度转向第一人称的角度",
  "uiIdx": "3.1",
  "range": "1219-1258",
  "chapterUid": 31
 },
 {
  "level": 4,
  "text": "作者最初用旁观者的角度来写作福贵的一生，困难重重，写作难以为继。",
  "uiIdx": "",
  "range": "1219-1258",
  "chapterUid": 31
 },
 {
  "level": 4,
  "text": "有一天作者突然从第一人称的角度出发，让福贵出来讲述自己的生活，于是写作顺利地完成了。",
  "uiIdx": "",
  "range": "1258-1352",
  "chapterUid": 31
 },
 {
  "level": 3,
  "text": "作者认为，生活是属于每个人自己的感受，不属于任何别人的看法",
  "uiIdx": "3.2",
  "range": "1923-1962",
  "chapterUid": 31
 },
 {
  "level": 4,
  "text": "作者在《活着》里写下了一个名叫福贵的人，现在当他回想这个福贵时，时常觉得他不是一个小说中的人物，而是作者生活中曾经出现过的一位朋友。",
  "uiIdx": "",
  "range": "1062-1130",
  "chapterUid": 31
 },
 {
  "level": 4,
  "text": "作者认为，如果从旁观者的角度，福贵的一生除了苦难还是苦难，其他什么都没有；可是当福贵从自己的角度出发，来讲述自己的一生时，他苦难的经历里立刻充满了幸福和欢乐。",
  "uiIdx": "",
  "range": "1666-1842",
  "chapterUid": 31
 }
]