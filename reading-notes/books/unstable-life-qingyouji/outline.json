[{"level": 1, "text": "文前", "uiIdx": "", "range": "", "chapterUid": 2}, {"level": 2, "text": "作者在巴塔哥尼亚高原的生活经历", "uiIdx": "1", "range": "510-603", "chapterUid": 2}, {"level": 3, "text": "作者从英国来到巴塔哥尼亚高原，住在山里，没有电没有网。", "uiIdx": "1.1", "range": "510-603", "chapterUid": 2}, {"level": 3, "text": "作者爱上了一个骑马的智利男人，与他度过了10年，后来提出分手", "uiIdx": "1.2", "range": "510-603", "chapterUid": 2}, {"level": 4, "text": "作者从山里来到小镇，开了一家旅馆。", "uiIdx": "", "range": "510-603", "chapterUid": 2}, {"level": 4, "text": "疫情期间作者倾家荡产。", "uiIdx": "", "range": "510-603", "chapterUid": 2}, {"level": 2, "text": "Vicky的旅馆", "uiIdx": "2", "range": "904-929", "chapterUid": 2}, {"level": 3, "text": "Vicky的旅馆评分9.8(满分10分)", "uiIdx": "2.1", "range": "904-929", "chapterUid": 2}, {"level": 4, "text": "作者在艰苦的徒步之前，想找一个好的旅馆好好休息几天。", "uiIdx": "", "range": "904-929", "chapterUid": 2}, {"level": 3, "text": "Vicky的旅馆有一个非常有趣的评论，“当我站在这个旅馆门前的时候，我问自己为什么要订这样的鬼地方。但当我走进旅馆内部，我被一切震惊了，这简直是一片桃花源。”。", "uiIdx": "2.2", "range": "958-1008", "chapterUid": 2}, {"level": 2, "text": "作者在Vicky旅馆的生活", "uiIdx": "3", "range": "1081-1111", "chapterUid": 2}, {"level": 3, "text": "作者拖着行李箱，从汽车站出来，走了10分钟，到了一栋小破房面前", "uiIdx": "3.1", "range": "1081-1111", "chapterUid": 2}, {"level": 4, "text": "走过的街道也都是破旧不堪，很多废弃的房子，路上没有太多人，走过的都是背包客，背着半人高的包，身上挂着登山杖等徒步用具。", "uiIdx": "", "range": "1111-1170", "chapterUid": 2}, {"level": 3, "text": "作者在旅馆的第一天，很疲惫，没有跟Vicky多聊天", "uiIdx": "3.2", "range": "1983-2008", "chapterUid": 2}, {"level": 4, "text": "作者给她whatsapp发信息，问她能不能等她有空找她聊天。", "uiIdx": "", "range": "2008-2038", "chapterUid": 2}, {"level": 4, "text": "她说她很喜欢和客人聊天，让作者任何时候都可以去找她。", "uiIdx": "", "range": "2038-2063", "chapterUid": 2}, {"level": 3, "text": "作者在旅馆工作了一整天，到下午的时候，去找Vicky聊天", "uiIdx": "3.3", "range": "2092-2121", "chapterUid": 2}, {"level": 4, "text": "Vicky打开门，5条狗跑了出来。", "uiIdx": "", "range": "2121-2138", "chapterUid": 2}, {"level": 4, "text": "作者才发现，她养了5只狗。", "uiIdx": "", "range": "2138-2150", "chapterUid": 2}, {"level": 4, "text": "“进来进来，喝茶还是咖啡？”Vicky非常热情。", "uiIdx": "", "range": "2179-2193", "chapterUid": 2}, {"level": 4, "text": "我们坐在厨房的桌子边坐下，她的狗一只把头放在作者腿上，一只小型的跳到她身上，依偎在她肩膀上睡觉。", "uiIdx": "", "range": "2395-2441", "chapterUid": 2}, {"level": 4, "text": "我们往杯子里放入一个茶包，来回晃了几下，等茶色变深时，就拿了出来，几乎同时做这样的动作。", "uiIdx": "", "range": "2470-2514", "chapterUid": 2}, {"level": 4, "text": "“我也喜欢这样喝茶！”作者说，“一直泡着会太浓了。我也是这样晃几下就拿出来。”。", "uiIdx": "", "range": "2543-2581", "chapterUid": 2}, {"level": 1, "text": "骑行4000英里的陌生男人", "uiIdx": "", "range": "", "chapterUid": 2}, {"level": 2, "text": "女主角对骑行4000英里的男人的好奇", "uiIdx": "1", "range": "677-742", "chapterUid": 2}, {"level": 3, "text": "女主角对男人骑行4000英里的故事产生好奇", "uiIdx": "1.1", "range": "677-742", "chapterUid": 2}, {"level": 4, "text": "女主角12岁时看到一张男人骑行4000英里的照片，被吸引。", "uiIdx": "", "range": "677-742", "chapterUid": 2}, {"level": 2, "text": "女主角的成长经历和职业变化", "uiIdx": "2", "range": "988-1012", "chapterUid": 2}, {"level": 3, "text": "女主角从超市员工做到市场经理", "uiIdx": "2.1", "range": "988-1012", "chapterUid": 2}, {"level": 4, "text": "女主角16岁开始在超市工作，因为喜欢整理，工作表现好，得到上级赏识，升职为市场经理。", "uiIdx": "", "range": "988-1012", "chapterUid": 2}, {"level": 3, "text": "女主角对工作的厌倦，决定辞职", "uiIdx": "2.2", "range": "1174-1189", "chapterUid": 2}, {"level": 4, "text": "女主角工作几年后感到厌倦，责任心重，做事追求完美，经常做到深夜，感觉要被累死，决定辞职。", "uiIdx": "", "range": "1174-1189", "chapterUid": 2}, {"level": 2, "text": "女主角来到智利的契机和过程", "uiIdx": "3", "range": "1516-1555", "chapterUid": 2}, {"level": 3, "text": "女主角辞职后，决定去智利Puerto Natales", "uiIdx": "3.1", "range": "1516-1555", "chapterUid": 2}, {"level": 4, "text": "女主角辞职后，生活稳定，想要不稳定，未知的世界，想到骑行4000英里的男人，决定去智利Puerto Natales。", "uiIdx": "", "range": "1516-1555", "chapterUid": 2}, {"level": 1, "text": "爱上游牧民族的放马人", "uiIdx": "", "range": "", "chapterUid": 2}, {"level": 2, "text": "女主角在Puerto Natales的生活和爱情经历", "uiIdx": "1", "range": "550-571", "chapterUid": 2}, {"level": 3, "text": "女主角来到Puerto Natales，住了下来，看到有骑马的旅行团，就报了名，去骑马，然后爱上了一个骑马的男人", "uiIdx": "1.1", "range": "550-571", "chapterUid": 2}, {"level": 4, "text": "男主角住在山里，一个与世隔绝的村子，没有电，没有自来水，他们的村子在一个湖边，他们村子的人都是靠养马为生。", "uiIdx": "", "range": "660-715", "chapterUid": 2}, {"level": 3, "text": "他们在一起10年，分手了，女主角提出的", "uiIdx": "1.2", "range": "864-899", "chapterUid": 2}, {"level": 4, "text": "男人有时候就是这样，关系已经进行不下去，他却不会提分手，他等着你提。", "uiIdx": "", "range": "864-899", "chapterUid": 2}, {"level": 2, "text": "分手的原因和女主角对爱情的理解", "uiIdx": "2", "range": "1294-1309", "chapterUid": 2}, {"level": 3, "text": "他们开始不爱聊天了，男主角总是花很多时间在工作上，没有时间陪女主角", "uiIdx": "2.1", "range": "1294-1309", "chapterUid": 2}, {"level": 4, "text": "他一周工作7天。我就想，难道工作比我还重要吗？", "uiIdx": "", "range": "1294-1309", "chapterUid": 2}, {"level": 3, "text": "好的爱情就是支持，花时间在一起", "uiIdx": "2.2", "range": "1541-1558", "chapterUid": 2}, {"level": 4, "text": "对方鼓励你去做你想做的事，即使他不想做，他也会对你说，‘你应该去做你喜欢的，这样的你一定棒极了！", "uiIdx": "", "range": "1558-1606", "chapterUid": 2}, {"level": 4, "text": "花时间在一起的意思，就是两个人要有闲暇时间，认认真真进行内心的交流。", "uiIdx": "", "range": "1606-1640", "chapterUid": 2}, {"level": 2, "text": "女主角的人生态度和选择", "uiIdx": "3", "range": "2243-2260", "chapterUid": 2}, {"level": 3, "text": "女主角坚持不生孩子，现在不能生孩子了，松了一口气的感觉", "uiIdx": "3.1", "range": "2243-2260", "chapterUid": 2}, {"level": 4, "text": "我从来不想要孩子。有了孩子，需要负太多的责任，我会牺牲掉我的人生。", "uiIdx": "", "range": "2074-2098", "chapterUid": 2}, {"level": 3, "text": "一个人孤独，两个人可能也孤独，我们要学会面对孤独", "uiIdx": "3.2", "range": "1963-1987", "chapterUid": 2}, {"level": 4, "text": "人总是会孤单的，一个人孤独，两个人可能也孤独。", "uiIdx": "", "range": "1963-1987", "chapterUid": 2}, {"level": 1, "text": "疫情中倾家荡产", "uiIdx": "", "range": "", "chapterUid": 2}, {"level": 2, "text": "旅馆经营者的故事", "uiIdx": "1", "range": "525-543", "chapterUid": 2}, {"level": 3, "text": "旅馆经营者因爱上前男友而搬到他的村子，开始当骑马的导游", "uiIdx": "1.1", "range": "525-543", "chapterUid": 2}, {"level": 4, "text": "旅馆经营者在客人建议下，决定自己开一家旅馆。", "uiIdx": "", "range": "576-617", "chapterUid": 2}, {"level": 3, "text": "旅馆经营者贷款盖房子，用心选择所有的家具、用品", "uiIdx": "1.2", "range": "849-872", "chapterUid": 2}, {"level": 4, "text": "旅馆经营者在后院盖了5间屋子，一砖一瓦都是她亲手布置的。", "uiIdx": "", "range": "872-886", "chapterUid": 2}, {"level": 3, "text": "旅馆经营者因疫情关闭两年，贷款需要还，卖掉农场还贷款", "uiIdx": "1.3", "range": "1414-1436", "chapterUid": 2}, {"level": 4, "text": "旅馆经营者工作的时候一天也不能休息，从早上6点到晚上12点，每天都睡不好觉。", "uiIdx": "", "range": "1232-1312", "chapterUid": 2}, {"level": 4, "text": "旅馆经营者疫情期间，国境关闭，外国游客不来旅游，本国人都被关在家里。", "uiIdx": "", "range": "1627-1656", "chapterUid": 2}, {"level": 4, "text": "旅馆经营者通过发信息给超市预定，超市送到门外。但没有人能出门，外面甚至有军队，出门会被抓起来。", "uiIdx": "", "range": "1806-1867", "chapterUid": 2}, {"level": 1, "text": "父亲是个作家，热爱高于一切", "uiIdx": "", "range": "", "chapterUid": 2}, {"level": 2, "text": "三文鱼养殖场的污染问题", "uiIdx": "1", "range": "696-727", "chapterUid": 2}, {"level": 3, "text": "三文鱼养殖场污染海水，污染环境", "uiIdx": "1.1", "range": "696-727", "chapterUid": 2}, {"level": 4, "text": "他们先把小鱼苗在工厂里养殖，然后等长大一些就放到海里围起来养。", "uiIdx": "", "range": "696-727", "chapterUid": 2}, {"level": 4, "text": "鱼群密度很大，排泄物、食物、疾病，都会污染海洋生态。", "uiIdx": "", "range": "727-753", "chapterUid": 2}, {"level": 4, "text": "更可怕的是，海狮会来吃三文鱼，他们就会射杀海狮。", "uiIdx": "", "range": "753-777", "chapterUid": 2}, {"level": 2, "text": "作者对父亲的理解和敬仰", "uiIdx": "2", "range": "898-921", "chapterUid": 2}, {"level": 3, "text": "父亲是研究自然的，对自然格外关注", "uiIdx": "2.1", "range": "898-921", "chapterUid": 2}, {"level": 4, "text": "他出版的第一本书是关于蛇的，当时英国没有一个人写关于蛇的书。", "uiIdx": "", "range": "921-953", "chapterUid": 2}, {"level": 4, "text": "他是第一人。", "uiIdx": "", "range": "953-960", "chapterUid": 2}, {"level": 3, "text": "父亲对工作的热爱和坚持", "uiIdx": "2.2", "range": "1045-1091", "chapterUid": 2}, {"level": 4, "text": "他在大学做教授，但他非常讨厌那份工作，他利用业余时间研究自然和动物，所以写了一本关于蛇的书。", "uiIdx": "", "range": "1045-1091", "chapterUid": 2}, {"level": 4, "text": "他用业余时间写作，然后出版了他的第一本书，之后做了专职作家，写了20多本关于自然的书，都出版了。", "uiIdx": "", "range": "1273-1333", "chapterUid": 2}, {"level": 2, "text": "作者对写作的理解和困惑", "uiIdx": "3", "range": "1362-1401", "chapterUid": 2}, {"level": 3, "text": "作者喜欢写作，但总觉得自己写得不好", "uiIdx": "3.1", "range": "1362-1401", "chapterUid": 2}, {"level": 4, "text": "我也在写东西，前前后后写了60万字吧，但我总觉得写得不好，甚至都没有投过稿。", "uiIdx": "", "range": "1362-1401", "chapterUid": 2}, {"level": 4, "text": "我很喜欢写东西，工作5分钟就身心疲惫，写东西写到凌晨3点都开心得要命，一点也不觉得累。", "uiIdx": "", "range": "1401-1446", "chapterUid": 2}, {"level": 3, "text": "作者对旅行的书有很多，自己写的又有什么特别的呢的困惑", "uiIdx": "3.2", "range": "1711-1736", "chapterUid": 2}, {"level": 4, "text": "也许应该写没有人写的东西，就像你的父亲一样。", "uiIdx": "", "range": "1736-1759", "chapterUid": 2}, {"level": 2, "text": "女性价值的理解和自信的建立", "uiIdx": "4", "range": "1597-1634", "chapterUid": 2}, {"level": 3, "text": "女性总是缺乏自信，因为从古至今，我们都是辅佐和支持男人去外面做事，我们自己的价值却被忽视了", "uiIdx": "4.1", "range": "1597-1634", "chapterUid": 2}, {"level": 4, "text": "我们经常怀疑自己，觉得自己不行。", "uiIdx": "", "range": "1634-1650", "chapterUid": 2}, {"level": 4, "text": "实际上不是这样的，我们一样有价值，很特别，有深度。", "uiIdx": "", "range": "1650-1676", "chapterUid": 2}, {"level": 3, "text": "女性应该写自己真正想写的，想抒发的，不用取悦任何人", "uiIdx": "4.2", "range": "1818-1844", "chapterUid": 2}, {"level": 4, "text": "如果你写一本大家喜欢，你却不喜欢的书，那感觉很糟糕。", "uiIdx": "", "range": "1818-1844", "chapterUid": 2}, {"level": 4, "text": "反过来，写一本可能大家不喜欢，你自己却很得意的书，这才是好的。", "uiIdx": "", "range": "1844-1875", "chapterUid": 2}, {"level": 4, "text": "要写真实的、你想去传播的东西，这才是你的心灵之声。", "uiIdx": "", "range": "1875-1901", "chapterUid": 2}, {"level": 2, "text": "对热爱的理解和坚持", "uiIdx": "5", "range": "1262-1273", "chapterUid": 2}, {"level": 3, "text": "人一定要做热爱的事情", "uiIdx": "5.1", "range": "1262-1273", "chapterUid": 2}, {"level": 4, "text": "你父亲很讨厌他的工作，他用业余时间写作，然后出版了他的第一本书，之后做了专职作家，写了20多本关于自然的书，都出版了。", "uiIdx": "", "range": "1273-1333", "chapterUid": 2}, {"level": 3, "text": "你的热爱是更重要的，你的工作只是手段，只是为了去辅佐你的热爱", "uiIdx": "5.2", "range": "2129-2160", "chapterUid": 2}, {"level": 4, "text": "你可以一边工作，一边做你喜欢的事，就像现在这样。", "uiIdx": "", "range": "2087-2112", "chapterUid": 2}, {"level": 4, "text": "终有一天，你可以抛弃工作，完全追求热爱之事。", "uiIdx": "", "range": "2160-2182", "chapterUid": 2}, {"level": 4, "text": "在此之前，你要记住热爱高于工作，一切都是为了走向热爱的道路。", "uiIdx": "", "range": "2182-2212", "chapterUid": 2}, {"level": 1, "text": "我喜欢不稳定的人生", "uiIdx": "", "range": "", "chapterUid": 2}, {"level": 2, "text": "喜欢不稳定的人生", "uiIdx": "1", "range": "368-377", "chapterUid": 2}, {"level": 3, "text": "一个女孩喜欢骑摩托车环游世界，世界上很多奇奇怪怪的人，奇怪的想法。", "uiIdx": "1.1", "range": "536-554", "chapterUid": 2}, {"level": 3, "text": "保罗·科埃略的书卖出的数量几乎与《圣经》持平", "uiIdx": "1.2", "range": "674-725", "chapterUid": 2}, {"level": 4, "text": "《牧羊少年奇幻之旅》畅销170个国家，销量6500万册，被译成70种语言。", "uiIdx": "", "range": "674-725", "chapterUid": 2}, {"level": 4, "text": "《哈利·波特》的作者是一个连吃饭钱都没有的单亲妈妈，在穷困的环境下，写了《哈利·波特》。", "uiIdx": "", "range": "839-889", "chapterUid": 2}, {"level": 3, "text": "做你热爱的事，money follows", "uiIdx": "1.3", "range": "889-922", "chapterUid": 2}, {"level": 4, "text": "不要和别人一样，我总是这样想。", "uiIdx": "", "range": "922-938", "chapterUid": 2}, {"level": 2, "text": "对未来的期待和计划", "uiIdx": "2", "range": "1297-1336", "chapterUid": 2}, {"level": 3, "text": "想要到世界各地旅行并且把故事收集成为一本书，然后出版", "uiIdx": "2.1", "range": "1297-1336", "chapterUid": 2}, {"level": 4, "text": "我每天都念这个咒语。", "uiIdx": "", "range": "1459-1473", "chapterUid": 2}, {"level": 3, "text": "如果愿望实现了，记得来英国或者世界的某个角落找我，我们要再聊一次", "uiIdx": "2.2", "range": "1508-1545", "chapterUid": 2}, {"level": 4, "text": "我们多年后再次见面，每个人又会带来什么动人的新故事呢？", "uiIdx": "", "range": "1624-1653", "chapterUid": 2}]