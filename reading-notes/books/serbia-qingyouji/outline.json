[{"level": 1, "text": "塞尔维亚：他们都爱中国人", "uiIdx": "", "range": "", "chapterUid": 2}, {"level": 2, "text": "塞尔维亚的国情与人民的生活满意度", "uiIdx": "1", "range": "8292-8313", "chapterUid": 2}, {"level": 3, "text": "塞尔维亚是人民夸赞政府、对生活满意的国家", "uiIdx": "1.1", "range": "8292-8313", "chapterUid": 2}, {"level": 4, "text": "塞尔维亚人觉得幸福，因为周边国家更穷。", "uiIdx": "", "range": "8292-8313", "chapterUid": 2}, {"level": 3, "text": "塞尔维亚存在许多亡命徒，包括很多中国人", "uiIdx": "1.2", "range": "938-987", "chapterUid": 2}, {"level": 4, "text": "亡命徒因为各种原因，被警察通缉、追踪，无法再回到故乡。", "uiIdx": "", "range": "938-987", "chapterUid": 2}, {"level": 2, "text": "贝尔格莱德的景象与书店的工作", "uiIdx": "2", "range": "7903-7937", "chapterUid": 2}, {"level": 3, "text": "贝尔格莱德城市干净、安全，但风景不好", "uiIdx": "2.1", "range": "7903-7937", "chapterUid": 2}, {"level": 4, "text": "贝尔格莱德适合生活或者“逃离过去，重新开始”。", "uiIdx": "", "range": "7937-7970", "chapterUid": 2}, {"level": 3, "text": "书店店员对工作的不满", "uiIdx": "2.2", "range": "663-700", "chapterUid": 2}, {"level": 4, "text": "书店店员不喜欢看书，工作无聊，休息时间少。", "uiIdx": "", "range": "663-700", "chapterUid": 2}, {"level": 4, "text": "书店店员还要抓小偷，偷书贼专拣贵的偷。", "uiIdx": "", "range": "2959-2982", "chapterUid": 2}, {"level": 2, "text": "中餐馆老板的生活与看法", "uiIdx": "3", "range": "3962-3976", "chapterUid": 2}, {"level": 3, "text": "中餐馆老板勤劳，语言能力在短时间内提高", "uiIdx": "3.1", "range": "3962-3976", "chapterUid": 2}, {"level": 4, "text": "中餐馆老板才来塞尔维亚3个月，语言都学会了。", "uiIdx": "", "range": "3962-3976", "chapterUid": 2}, {"level": 3, "text": "中餐馆老板对中国人看法正面，认为中国人是朋友", "uiIdx": "3.2", "range": "7665-7685", "chapterUid": 2}, {"level": 4, "text": "中餐馆老板认为中国从来不攻击其他国家，是塞尔维亚的盟友。", "uiIdx": "", "range": "7665-7685", "chapterUid": 2}, {"level": 2, "text": "塞尔维亚人的幸福观", "uiIdx": "4", "range": "8292-8313", "chapterUid": 2}, {"level": 3, "text": "塞尔维亚人觉得幸福，因为周边国家更穷", "uiIdx": "4.1", "range": "8292-8313", "chapterUid": 2}, {"level": 4, "text": "塞尔维亚人因为周边国家更穷，所以觉得自己很富裕。", "uiIdx": "", "range": "8292-8313", "chapterUid": 2}, {"level": 3, "text": "个人幸福与社会整体进步的关系", "uiIdx": "4.2", "range": "8579-8608", "chapterUid": 2}, {"level": 4, "text": "社会和人类整体的进步，需要竞争，但竞争有害于个人的幸福。", "uiIdx": "", "range": "8579-8608", "chapterUid": 2}]