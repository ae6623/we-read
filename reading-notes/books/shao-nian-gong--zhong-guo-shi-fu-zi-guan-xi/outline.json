[
 {
  "level": 1,
  "text": "一",
  "uiIdx": "",
  "range": "",
  "chapterUid": 4
 },
 {
  "level": 2,
  "text": "作者的家庭背景和居住环境",
  "uiIdx": "1",
  "range": "1180-1239",
  "chapterUid": 4
 },
 {
  "level": 3,
  "text": "作者一家住在棚户区，离少年宫近，位居其后侧",
  "uiIdx": "1.1",
  "range": "1180-1239",
  "chapterUid": 4
 },
 {
  "level": 4,
  "text": "少年宫这个城市地标性建筑几乎夜夜长明，每晚都会喂些光进我们家来，家里无须开灯，能节省一点是一点，电费都涨到五毛一度了。",
  "uiIdx": "",
  "range": "1180-1239",
  "chapterUid": 4
 },
 {
  "level": 3,
  "text": "作者的父母亲的眼睛在黑暗中待太久，花了，分不大清，还以为光是对楼来的",
  "uiIdx": "1.2",
  "range": "1282-1320",
  "chapterUid": 4
 },
 {
  "level": 4,
  "text": "少年宫能送的光有限，倘若天气不冷，家里从不关窗，尽量让光线透射进来。",
  "uiIdx": "",
  "range": "1320-1354",
  "chapterUid": 4
 },
 {
  "level": 2,
  "text": "作者的母亲和父亲的日常生活",
  "uiIdx": "2",
  "range": "884-897",
  "chapterUid": 4
 },
 {
  "level": 3,
  "text": "母亲每天凌晨五点半起床，为全家准备早餐",
  "uiIdx": "2.1",
  "range": "884-897",
  "chapterUid": 4
 },
 {
  "level": 4,
  "text": "母亲在厨房尝试下一锅面条，未等面条熟，母亲已回来了。",
  "uiIdx": "",
  "range": "872-897",
  "chapterUid": 4
 },
 {
  "level": 3,
  "text": "父亲每天在沙发上沉睡，背身翻过去，没多久，又发出细微的鼾声",
  "uiIdx": "2.2",
  "range": "827-847",
  "chapterUid": 4
 },
 {
  "level": 4,
  "text": "父亲的身体动了动，慢慢睁开双眼，直视天花板未开的灯泡。",
  "uiIdx": "",
  "range": "1074-1101",
  "chapterUid": 4
 },
 {
  "level": 2,
  "text": "赵广全与作者的家的关系",
  "uiIdx": "3",
  "range": "2070-2130",
  "chapterUid": 4
 },
 {
  "level": 3,
  "text": "赵广全和作者是邻居，两家一见如故",
  "uiIdx": "3.1",
  "range": "2070-2130",
  "chapterUid": 4
 },
 {
  "level": 4,
  "text": "我们搬来的那天恰好是正月十五，晚上全家正儿八经包了一顿饺子，猪肉大葱馅的，母亲往每家每户都送一点，记得只有赵广全开了门。",
  "uiIdx": "",
  "range": "2070-2130",
  "chapterUid": 4
 },
 {
  "level": 3,
  "text": "赵广全时不时来我们家看一看，催促父亲办理残疾证",
  "uiIdx": "3.2",
  "range": "2320-2360",
  "chapterUid": 4
 },
 {
  "level": 4,
  "text": "仅这一年里，从年初到年末，他已催促过父亲十余次了，每次一来，明言喝酒，实则谈事。",
  "uiIdx": "",
  "range": "2320-2360",
  "chapterUid": 4
 },
 {
  "level": 2,
  "text": "父亲残疾的情况和赵广全的建议",
  "uiIdx": "4",
  "range": "2928-2954",
  "chapterUid": 4
 },
 {
  "level": 3,
  "text": "父亲的腿是畸形的两条腿，其中一条的关节扭折错位，缠满绷带；而另一条，大腿以下已全部截肢",
  "uiIdx": "4.1",
  "range": "2928-2954",
  "chapterUid": 4
 },
 {
  "level": 4,
  "text": "父亲低头看了看，用毯子遮住，拿鸡爪的两手都不稳了，还是赵广全帮着掰碎，全放碗里。",
  "uiIdx": "",
  "range": "3002-3042",
  "chapterUid": 4
 },
 {
  "level": 3,
  "text": "赵广全建议父亲争取办理二级残疾证，可以享受更多的福利",
  "uiIdx": "4.2",
  "range": "3427-3501",
  "chapterUid": 4
 },
 {
  "level": 4,
  "text": "赵广全说，团结啊，关于上次那事，你想得怎么样了？父亲没吭声。他说，你说你都这样了，还在考虑什么？他敲着桌子，又说，要我说，这会儿办证，人少，正是时候，年一过，指不定啥变动，可能就不好搞了，何况你身体又不大好，早办完少一件事。他又指着自己左腿，说，我这证，当年办得也不容易，现在政策好，证一下来，坐车免费，旅游免费，每月还有各种补贴领，啥福利咱们都优先享受。",
  "uiIdx": "",
  "range": "3427-3501",
  "chapterUid": 4
 },
 {
  "level": 1,
  "text": "二",
  "uiIdx": "",
  "range": "",
  "chapterUid": 4
 },
 {
  "level": 2,
  "text": "父亲的建筑工人生涯",
  "uiIdx": "1",
  "range": "700-743",
  "chapterUid": 4
 },
 {
  "level": 3,
  "text": "父亲是一名有多年工龄的建筑工人，身体健壮，臂膀孔武有力，大腿结实，小腿肌肉紧绷",
  "uiIdx": "1.1",
  "range": "700-743",
  "chapterUid": 4
 },
 {
  "level": 4,
  "text": "父亲砌砖、推车搬运、扛着一袋袋水泥在各处工地行走。",
  "uiIdx": "",
  "range": "743-767",
  "chapterUid": 4
 },
 {
  "level": 3,
  "text": "父亲把大半辈子的光阴都抛掷在施工地，闲暇之余，唯一的乐趣就是到城市各处的自己盖过的楼房前溜达",
  "uiIdx": "1.2",
  "range": "823-870",
  "chapterUid": 4
 },
 {
  "level": 4,
  "text": "父亲引以为豪地表示，这是他给这个世界留下的痕迹，还说每次看到这些房子，就觉得自己前半生没有白活一场。",
  "uiIdx": "",
  "range": "941-990",
  "chapterUid": 4
 },
 {
  "level": 2,
  "text": "父亲的工作事故",
  "uiIdx": "2",
  "range": "1660-1738",
  "chapterUid": 4
 },
 {
  "level": 3,
  "text": "父亲一脚踩空，从高楼上坠下，掉在一处沙地上，落下腿部伤残",
  "uiIdx": "2.1",
  "range": "1660-1738",
  "chapterUid": 4
 },
 {
  "level": 4,
  "text": "父亲坚持说要做完再走，不料除夕当晚，我们没有收到他一如既往的报平安电话，却收到医院来的紧急消息。",
  "uiIdx": "",
  "range": "1660-1738",
  "chapterUid": 4
 },
 {
  "level": 2,
  "text": "父亲的生活变迁",
  "uiIdx": "3",
  "range": "1818-1865",
  "chapterUid": 4
 },
 {
  "level": 3,
  "text": "父亲休养了一年多才缓过来，终是落下腿部伤残，且拧一瓶矿泉水的力气都没了",
  "uiIdx": "3.1",
  "range": "1818-1865",
  "chapterUid": 4
 },
 {
  "level": 4,
  "text": "再出门尝试找工作时，没人肯要，给过往的朋友打电话，尽是关机。",
  "uiIdx": "",
  "range": "1865-1895",
  "chapterUid": 4
 },
 {
  "level": 3,
  "text": "父亲态度格外坚决，不光说，还自顾收拾起行李，母亲与其大吵一架，最终妥协",
  "uiIdx": "3.2",
  "range": "2108-2132",
  "chapterUid": 4
 },
 {
  "level": 4,
  "text": "出租屋的白墙面挂了一幅城市地图，父亲每天闲在家无事，一次次向地图抛掷飞镖，锻炼臂力。",
  "uiIdx": "",
  "range": "2146-2188",
  "chapterUid": 4
 },
 {
  "level": 4,
  "text": "那天凌晨，父亲把飞镖随手一掷，镖头正中地图中心，他抬眼看了看，擅自做主买上三张前往目的地的车票。",
  "uiIdx": "",
  "range": "2188-2236",
  "chapterUid": 4
 },
 {
  "level": 2,
  "text": "父亲与少年宫",
  "uiIdx": "4",
  "range": "2261-2329",
  "chapterUid": 4
 },
 {
  "level": 3,
  "text": "父亲在少年宫后面入住两年，全家慢慢适应了新的生活节奏",
  "uiIdx": "4.1",
  "range": "2261-2329",
  "chapterUid": 4
 },
 {
  "level": 4,
  "text": "邻居较少，没有外界的喧嚣，父亲终日居家饮酒，一喝就是一整天，再没当我面提起过盖楼的事。",
  "uiIdx": "",
  "range": "2261-2329",
  "chapterUid": 4
 },
 {
  "level": 3,
  "text": "父亲从未走错过，仅有那么几次，我趁父亲不注意，偷偷右拐，还没多走几步，就会被父亲呵斥叫回",
  "uiIdx": "4.2",
  "range": "3060-3097",
  "chapterUid": 4
 },
 {
  "level": 4,
  "text": "一抬头的工夫，发现所谓的侧门早已锁上。",
  "uiIdx": "",
  "range": "3097-3116",
  "chapterUid": 4
 },
 {
  "level": 4,
  "text": "铁链上生了锈，大概早已废弃，连带着这条路上更加无人，只有呜呜的风声。",
  "uiIdx": "",
  "range": "3116-3150",
  "chapterUid": 4
 },
 {
  "level": 1,
  "text": "三",
  "uiIdx": "",
  "range": "",
  "chapterUid": 4
 },
 {
  "level": 2,
  "text": "作者发烧生病，父亲在酒醉中照顾他",
  "uiIdx": "1",
  "range": "525-562",
  "chapterUid": 4
 },
 {
  "level": 3,
  "text": "作者发烧，整日下不了床，母亲抱怨是父亲带他出门散步时，被冷风吹的",
  "uiIdx": "1.1",
  "range": "525-562",
  "chapterUid": 4
 },
 {
  "level": 4,
  "text": "父亲并没有反驳什么，他在喝酒。",
  "uiIdx": "",
  "range": "525-562",
  "chapterUid": 4
 },
 {
  "level": 3,
  "text": "父亲喝醉了，从沙发上歪下来，就连酒瓶滚落到一边也没有察觉",
  "uiIdx": "1.2",
  "range": "734-792",
  "chapterUid": 4
 },
 {
  "level": 4,
  "text": "他头发乱糟，胳肢窝下夹着一片沙发垫子，盘坐在地上，一面对着那束光线，沉默地做出各种手势。",
  "uiIdx": "",
  "range": "792-836",
  "chapterUid": 4
 },
 {
  "level": 2,
  "text": "作者和父亲在光影中玩耍，度过病中数日",
  "uiIdx": "2",
  "range": "657-734",
  "chapterUid": 4
 },
 {
  "level": 3,
  "text": "作者看到靠近门方向的水泥墙面上，出现一小片光斑，光斑的区域中有一些黑影在晃",
  "uiIdx": "2.1",
  "range": "657-734",
  "chapterUid": 4
 },
 {
  "level": 4,
  "text": "我小声打了个喷嚏，头脑一下清醒了些，从门口探出头来，原来是父亲喝大了，从沙发上歪下来，就连酒瓶滚落到一边也没有察觉。",
  "uiIdx": "",
  "range": "734-792",
  "chapterUid": 4
 },
 {
  "level": 3,
  "text": "作者和父亲在那片光斑区域做出各式各样的黑影图案，但一到饭桌上，好像不经意间形成默契，彼此并无交流，甚至会刻意躲开对方的眼睛",
  "uiIdx": "2.2",
  "range": "1153-1231",
  "chapterUid": 4
 },
 {
  "level": 4,
  "text": "如此度过病中数日，这场光影游戏成为我唯一的慰藉。",
  "uiIdx": "",
  "range": "1291-1315",
  "chapterUid": 4
 },
 {
  "level": 2,
  "text": "作者想进少年宫，但父亲拒绝并卖掉他的报名表",
  "uiIdx": "3",
  "range": "1880-1907",
  "chapterUid": 4
 },
 {
  "level": 3,
  "text": "作者想进少年宫，但父亲拒绝并卖掉他的报名表",
  "uiIdx": "3.1",
  "range": "1880-1907",
  "chapterUid": 4
 },
 {
  "level": 4,
  "text": "我做了几个梦，断断续续，不成体系，等我醒来，天已大亮。",
  "uiIdx": "",
  "range": "1880-1907",
  "chapterUid": 4
 },
 {
  "level": 4,
  "text": "我昏沉着脑袋，掀开被子，穿着睡衣下床，肩后披一件厚重的黑色外套，见父亲在外屋抽烟。",
  "uiIdx": "",
  "range": "1983-2024",
  "chapterUid": 4
 },
 {
  "level": 4,
  "text": "我说，你看到报名表了吗？他说，哦，什么？我说，报名表，去少年宫的报名表。他说，年纪大了，你让我想一想。",
  "uiIdx": "",
  "range": "2113-2164",
  "chapterUid": 4
 },
 {
  "level": 4,
  "text": "我说，证，残疾人证，你怎么不去办了呢，不要拖后腿，全家最拖后腿的就是你。",
  "uiIdx": "",
  "range": "2570-2608",
  "chapterUid": 4
 },
 {
  "level": 4,
  "text": "父亲一时没说话，大口大口往喉咙里灌酒。趁他没注意，我把他手中的酒瓶夺过来，直接丢到窗外去，只听咣当一声，传来在阳光下酒瓶碎裂的声音。",
  "uiIdx": "",
  "range": "2608-2674",
  "chapterUid": 4
 },
 {
  "level": 3,
  "text": "父亲后来把报名表找回来，但作者已经错过了少年宫的招生",
  "uiIdx": "3.2",
  "range": "4336-4390",
  "chapterUid": 4
 },
 {
  "level": 4,
  "text": "父亲狠狠灌了口开水，腮帮子鼓起，水在嗓子眼发出咕噜一声响，喉结一动，一紧一缩，脸颊重新紧绷，已有了几分绯红。",
  "uiIdx": "",
  "range": "4336-4390",
  "chapterUid": 4
 },
 {
  "level": 4,
  "text": "我回过头，直视他漆黑的眼睛，一字一顿，第三次重复说，我想去。",
  "uiIdx": "",
  "range": "3250-3280",
  "chapterUid": 4
 },
 {
  "level": 4,
  "text": "初夏，午时，艳阳漂白大地，犹如熔炉般炎热。一路上，一辆辆车长驱直入少年宫。",
  "uiIdx": "",
  "range": "3305-3342",
  "chapterUid": 4
 },
 {
  "level": 4,
  "text": "我和父亲站在路边上，看着一辆辆锃亮的小车在身边缓缓经过，我俩处在烈日下面，四周没有遮蔽物，汗水浸透短袖。",
  "uiIdx": "",
  "range": "3367-3419",
  "chapterUid": 4
 },
 {
  "level": 4,
  "text": "父亲发出轻微的咳嗽声，手握成拳头，时而抬起时而放下，额头沁出不少汗珠，濡湿头发。",
  "uiIdx": "",
  "range": "3419-3459",
  "chapterUid": 4
 },
 {
  "level": 4,
  "text": "我站在他边上，两手抓着衣角，反复磨蹭，自始至终都低着头。",
  "uiIdx": "",
  "range": "3459-3487",
  "chapterUid": 4
 },
 {
  "level": 4,
  "text": "几乎四十摄氏度的高温，他却穿着一条黑色长裤，从家的那一边拄拐走来，一路上一句话也没说。",
  "uiIdx": "",
  "range": "3487-3530",
  "chapterUid": 4
 },
 {
  "level": 4,
  "text": "我摸了摸裤兜，那是折叠好的报名表，一夜过去，当父亲当着我面交给我，我并不知是他从废品站翻找出来的，或者一开始就没卖掉。",
  "uiIdx": "",
  "range": "3555-3614",
  "chapterUid": 4
 },
 {
  "level": 4,
  "text": "我的手慢慢摸索，摸到一个突兀的钝角，这张价值千金的白纸，好像有被火灼烧过的痕迹，也不知还能不能用。",
  "uiIdx": "",
  "range": "3614-3663",
  "chapterUid": 4
 },
 {
  "level": 4,
  "text": "出门前他还说，先说好，进不去就别去了，另外，你学不好也别再去了，浪费钱。",
  "uiIdx": "",
  "range": "3663-3699",
  "chapterUid": 4
 },
 {
  "level": 4,
  "text": "一早他没有喝酒，瞪着眼睛，十分清醒。他视线很直，也不知望着什么。",
  "uiIdx": "",
  "range": "3724-3756",
  "chapterUid": 4
 },
 {
  "level": 4,
  "text": "我们在大太阳底下继续等待，相互保持沉默。",
  "uiIdx": "",
  "range": "3756-3776",
  "chapterUid": 4
 },
 {
  "level": 4,
  "text": "过了一会儿，大门口的车辆渐少，等所有的车辆进去，我俩前方空了，这时，我扯了一下他的衣角，他才反应过来，慢慢挪步。",
  "uiIdx": "",
  "range": "3776-3832",
  "chapterUid": 4
 },
 {
  "level": 4,
  "text": "大约百米，我们走得极慢，当我们在少年宫所属的广场重新停下来，再往后看，已被人海包围，根本无路可退。",
  "uiIdx": "",
  "range": "3832-3881",
  "chapterUid": 4
 },
 {
  "level": 1,
  "text": "四",
  "uiIdx": "",
  "range": "",
  "chapterUid": 4
 },
 {
  "level": 2,
  "text": "父亲在少年宫卖矿泉水的经历",
  "uiIdx": "1",
  "range": "1412-1455",
  "chapterUid": 4
 },
 {
  "level": 3,
  "text": "父亲在少年宫门口站了一个多月，到处是卖冰棍的，但没人卖矿泉水",
  "uiIdx": "1.1",
  "range": "1412-1455",
  "chapterUid": 4
 },
 {
  "level": 4,
  "text": "他去进一批货，卖瓶装矿泉水，人们口渴了，一定会来买的。",
  "uiIdx": "",
  "range": "1489-1522",
  "chapterUid": 4
 },
 {
  "level": 3,
  "text": "他试着点上一支烟，抽几口，时不时咳嗽两声，也许是太暗，他开始试着点燃一支蜡烛",
  "uiIdx": "1.2",
  "range": "1547-1586",
  "chapterUid": 4
 },
 {
  "level": 4,
  "text": "白色烛芯亮起的火光摇晃两下，十分微弱，好像即将熄灭。",
  "uiIdx": "",
  "range": "1586-1612",
  "chapterUid": 4
 },
 {
  "level": 4,
  "text": "他五指并拢，用手掌回罩住，慢慢地，火光稳定下来。",
  "uiIdx": "",
  "range": "1612-1636",
  "chapterUid": 4
 },
 {
  "level": 3,
  "text": "第二天，窗台的烛泪已干，他不知从哪儿借来个小推车，上面的泡沫大箱用绳绑住",
  "uiIdx": "1.3",
  "range": "1661-1698",
  "chapterUid": 4
 },
 {
  "level": 4,
  "text": "几天后，他又进了一批矿泉水，借着接送时间，每天一早就推着车，在广场卖矿泉水。",
  "uiIdx": "",
  "range": "1698-1760",
  "chapterUid": 4
 },
 {
  "level": 4,
  "text": "不用喊，来回走两步，十来分钟，就能卖出一二十瓶。",
  "uiIdx": "",
  "range": "1698-1760",
  "chapterUid": 4
 },
 {
  "level": 4,
  "text": "而待到上课，人群散去，广场空下来，父亲又回到树下，手下拄拐，等我出来。",
  "uiIdx": "",
  "range": "1760-1795",
  "chapterUid": 4
 },
 {
  "level": 3,
  "text": "卖水的人如雨后春笋越来越多，父亲起初是在正中央，慢慢往两侧赶，到最后，只能待在犄角旮旯的角落",
  "uiIdx": "1.4",
  "range": "2146-2223",
  "chapterUid": 4
 },
 {
  "level": 4,
  "text": "泡沫箱被路过的人踢过几脚，印有几块黑鞋印，十分脏。",
  "uiIdx": "",
  "range": "2146-2223",
  "chapterUid": 4
 },
 {
  "level": 4,
  "text": "父亲蹲坐在一片巨大的阴影上，像脚踩着一只小船，他两手怀抱的泡沫箱，好似已是最后的依靠。",
  "uiIdx": "",
  "range": "2223-2266",
  "chapterUid": 4
 },
 {
  "level": 2,
  "text": "母亲被辞工的情况",
  "uiIdx": "2",
  "range": "3019-3056",
  "chapterUid": 4
 },
 {
  "level": 3,
  "text": "母亲失业了，她翻弄了一下家里所剩无几的食材，一小把豆芽菜、两包涪陵榨菜和一根火腿肠",
  "uiIdx": "2.1",
  "range": "3019-3056",
  "chapterUid": 4
 },
 {
  "level": 4,
  "text": "她把洗发水、沐浴露、毛巾，大多是一些日常用品。",
  "uiIdx": "",
  "range": "2973-2994",
  "chapterUid": 4
 },
 {
  "level": 4,
  "text": "母亲翻弄了一下家里所剩无几的食材，一小把豆芽菜、两包涪陵榨菜和一根火腿肠。",
  "uiIdx": "",
  "range": "3019-3056",
  "chapterUid": 4
 },
 {
  "level": 4,
  "text": "她的刀很快，只听咔咔咔几声，火腿肠切成火腿丁，和豆芽菜、榨菜一道，就着昨日的剩饭，混在锅里一同翻炒，并一连打了两个鸡蛋。",
  "uiIdx": "",
  "range": "3056-3116",
  "chapterUid": 4
 },
 {
  "level": 4,
  "text": "蛋炒饭炒好了，我帮着从柜台上拿出一沓碗筷，盛好饭，一共四碗，榨菜还有剩余，倒一大锅水，一人再做一碗榨菜汤。",
  "uiIdx": "",
  "range": "3312-3365",
  "chapterUid": 4
 },
 {
  "level": 4,
  "text": "饭桌上，因为室内有点闷，我提前把窗户打开了。",
  "uiIdx": "",
  "range": "3390-3412",
  "chapterUid": 4
 },
 {
  "level": 4,
  "text": "母亲突然说，我失业了。",
  "uiIdx": "",
  "range": "3412-3423",
  "chapterUid": 4
 },
 {
  "level": 4,
  "text": "我说，啊？手里捧着的碗差点掉在地上，随后看向母亲，她的脸上并没有露出什么明显的表情。",
  "uiIdx": "",
  "range": "3428-3465",
  "chapterUid": 4
 },
 {
  "level": 4,
  "text": "她略微低下头，用筷子鼓捣碗里的饭，说，前两天，一个小偷拿走了两盒饼干，我盯着监控视频都没看见，这事后来被老板发现了。",
  "uiIdx": "",
  "range": "3465-3523",
  "chapterUid": 4
 },
 {
  "level": 4,
  "text": "我看了看父亲的位置，空的，哪怕无事，他也时常去少年宫附近晃悠，不着家。",
  "uiIdx": "",
  "range": "3523-3558",
  "chapterUid": 4
 },
 {
  "level": 4,
  "text": "母亲指了指摊在另一张桌上的那些日常用品，接着说，今天，老板带着一个新人过来，比我小十岁，他说我明天不用来上班了。",
  "uiIdx": "",
  "range": "3558-3614",
  "chapterUid": 4
 },
 {
  "level": 4,
  "text": "我又啊了一声，一时间不知该说什么。",
  "uiIdx": "",
  "range": "3614-3631",
  "chapterUid": 4
 },
 {
  "level": 4,
  "text": "她迅速扒了一口饭，说，嗯，没什么，先吃饭吧。",
  "uiIdx": "",
  "range": "3631-3653",
  "chapterUid": 4
 },
 {
  "level": 2,
  "text": "父亲在广场跳舞的情景",
  "uiIdx": "3",
  "range": "5100-5156",
  "chapterUid": 4
 },
 {
  "level": 3,
  "text": "父亲在广场中心，逆时针旋转起舞，周围的人纷纷动起来",
  "uiIdx": "3.1",
  "range": "5100-5156",
  "chapterUid": 4
 },
 {
  "level": 4,
  "text": "这个平日蜷缩在角落的人，第一次来到广场中心，就在少年宫的台阶下旋转起舞。",
  "uiIdx": "",
  "range": "5100-5156",
  "chapterUid": 4
 },
 {
  "level": 4,
  "text": "徒留下身后一地失去鞭打，应声倒地的陀螺。",
  "uiIdx": "",
  "range": "5100-5156",
  "chapterUid": 4
 },
 {
  "level": 3,
  "text": "父亲旋转了很久，我在他身后也看了很久",
  "uiIdx": "3.2",
  "range": "5517-5537",
  "chapterUid": 4
 },
 {
  "level": 4,
  "text": "日照西斜，人群围拢，父亲旁若无人旋转着，慢慢地，他开始一点点偏移原本的位置，从边缘朝着中心而去。",
  "uiIdx": "",
  "range": "5044-5100",
  "chapterUid": 4
 },
 {
  "level": 4,
  "text": "天空一望无际，像一块冻结的蓝色冰块，而巨大的椭圆形落日在他背后缓缓下沉。",
  "uiIdx": "",
  "range": "5243-5300",
  "chapterUid": 4
 },
 {
  "level": 4,
  "text": "因为是逆光，父亲犹如一团黑影，好似要融入这冰冷的夕阳中。",
  "uiIdx": "",
  "range": "5300-5328",
  "chapterUid": 4
 },
 {
  "level": 4,
  "text": "没多久，天边又浮现出晚霞，如棉絮状的雾，先是橘黄色，后又变成大片的红，紫色和蓝色依次变换，仿佛一下要烧起来。",
  "uiIdx": "",
  "range": "5328-5415",
  "chapterUid": 4
 },
 {
  "level": 4,
  "text": "父亲好像风中抖动的烛火，明明暗暗，本以为行将熄灭，又被一瞬间点亮。",
  "uiIdx": "",
  "range": "5328-5415",
  "chapterUid": 4
 },
 {
  "level": 4,
  "text": "再后来，晚霞慢慢消失了，天就变成黑色，地面也变黑了，父亲好像也要消失在这一片坦阔的黑暗中。",
  "uiIdx": "",
  "range": "5415-5460",
  "chapterUid": 4
 },
 {
  "level": 1,
  "text": "五",
  "uiIdx": "",
  "range": "",
  "chapterUid": 4
 },
 {
  "level": 2,
  "text": "赵广全帮助母亲找工作",
  "uiIdx": "1",
  "range": "1120-1227",
  "chapterUid": 4
 },
 {
  "level": 3,
  "text": "赵广全自作主张帮母亲寻到一份在少年宫的保洁差事",
  "uiIdx": "1.1",
  "range": "1120-1227",
  "chapterUid": 4
 },
 {
  "level": 4,
  "text": "工资虽不高，但活儿也不多，且有五险一金保障，外带食堂福利。",
  "uiIdx": "",
  "range": "1120-1227",
  "chapterUid": 4
 },
 {
  "level": 3,
  "text": "赵广全没说办证的半个字，更没提其他事宜。",
  "uiIdx": "1.2",
  "range": "1227-1279",
  "chapterUid": 4
 },
 {
  "level": 2,
  "text": "母亲在少年宫的工作生活",
  "uiIdx": "2",
  "range": "1438-1504",
  "chapterUid": 4
 },
 {
  "level": 3,
  "text": "母亲消费一下大气了许多，但她不大会用员工卡去买零食",
  "uiIdx": "2.1",
  "range": "1438-1504",
  "chapterUid": 4
 },
 {
  "level": 4,
  "text": "更多是学其他老员工，买些素食菜和包点。",
  "uiIdx": "",
  "range": "1438-1504",
  "chapterUid": 4
 },
 {
  "level": 3,
  "text": "母亲每月会帮员工定额充卡，供他们买些零食和日常用品什么的，补贴家用",
  "uiIdx": "2.2",
  "range": "1120-1227",
  "chapterUid": 4
 },
 {
  "level": 4,
  "text": "其中一款包点叫菜宝宝，一掰开，里面有粉条、包菜、菌菇、肉末，一咬下去，香气四溢。",
  "uiIdx": "",
  "range": "1504-1544",
  "chapterUid": 4
 },
 {
  "level": 4,
  "text": "此外还有烧卖和银丝卷之类，我和我的胃在少年宫的包点下茁壮成长。",
  "uiIdx": "",
  "range": "1544-1575",
  "chapterUid": 4
 },
 {
  "level": 2,
  "text": "家庭困境的改善",
  "uiIdx": "3",
  "range": "1758-1778",
  "chapterUid": 4
 },
 {
  "level": 3,
  "text": "家里的窘境日益改善，父亲也逐渐养好身子",
  "uiIdx": "3.1",
  "range": "1758-1778",
  "chapterUid": 4
 },
 {
  "level": 4,
  "text": "有一天，赵广全在我家留下吃晚饭，母亲额外多做了两个菜。",
  "uiIdx": "",
  "range": "1778-1805",
  "chapterUid": 4
 },
 {
  "level": 4,
  "text": "父亲面色红润，以温白开代酒敬赵广全，母亲连同父亲，连连和赵广全碰杯。",
  "uiIdx": "",
  "range": "1805-1839",
  "chapterUid": 4
 },
 {
  "level": 3,
  "text": "赵广全喝至微醺，头脑摇晃，一手捏成拳头放在嘴边，好似握住一把麦克风，兀自歌唱起来",
  "uiIdx": "3.2",
  "range": "1934-1975",
  "chapterUid": 4
 },
 {
  "level": 4,
  "text": "父亲放下裤兜里刚要拿出的烟盒，一手一根筷子敲击酒杯，母亲拿出口风琴，同样给他做伴奏。",
  "uiIdx": "",
  "range": "1996-2038",
  "chapterUid": 4
 },
 {
  "level": 4,
  "text": "我看了看父母二人，拼命拍着巴掌，手都拍红了。",
  "uiIdx": "",
  "range": "2038-2060",
  "chapterUid": 4
 },
 {
  "level": 4,
  "text": "我们三人一齐为他配乐，像一场小型音乐演奏会。",
  "uiIdx": "",
  "range": "2060-2082",
  "chapterUid": 4
 },
 {
  "level": 4,
  "text": "赵广全越唱越尽兴，就差离开凳子站起来了。",
  "uiIdx": "",
  "range": "2082-2102",
  "chapterUid": 4
 },
 {
  "level": 4,
  "text": "原本以为歌声会这么持续下去，大概过了一刻钟，歌声戛然而止，赵广全两手搂住父亲的脖子，一下痛哭起来，声音响亮，我们一时间不知所措，父亲尴尬地举着筷子，不知是继续敲击，还是停下。",
  "uiIdx": "",
  "range": "2102-2188",
  "chapterUid": 4
 },
 {
  "level": 4,
  "text": "好在他哭着哭着就抹干眼泪，一问起来什么也不说，直到我送他回楼上时，他才在家门口和我道明原因。",
  "uiIdx": "",
  "range": "2188-2236",
  "chapterUid": 4
 },
 {
  "level": 4,
  "text": "自身体残疾后，结婚二十余年的妻子实在忍不下去了，带着十来岁的孩子改嫁一个做房地产的老板。",
  "uiIdx": "",
  "range": "2236-2280",
  "chapterUid": 4
 },
 {
  "level": 4,
  "text": "走前的原话是，你不能给儿子好的生活，但总有人可以给。",
  "uiIdx": "",
  "range": "2280-2306",
  "chapterUid": 4
 },
 {
  "level": 4,
  "text": "他喟叹完，找出钥匙插入钥匙孔，指了指门内黑魆魆一片，说，那天正好是正月十五，如果不是你妈那一顿饺子，我叠好最后一轮被子，打算直接从窗台上跳下去。",
  "uiIdx": "",
  "range": "2306-2378",
  "chapterUid": 4
 },
 {
  "level": 2,
  "text": "作者的自我反思和决定",
  "uiIdx": "4",
  "range": "2403-2449",
  "chapterUid": 4
 },
 {
  "level": 3,
  "text": "作者躺在床上发呆，复习书本横行在床上、桌上、地上，四处都是，而他迟迟不愿拿起",
  "uiIdx": "4.1",
  "range": "2403-2449",
  "chapterUid": 4
 },
 {
  "level": 4,
  "text": "窗外秋蝉发出最后的嘶鸣，木板床凹凸不平，在屁股下发出咯吱咯吱的声音，这张木板床我睡了将近十年，可能继续睡下去。",
  "uiIdx": "",
  "range": "2449-2504",
  "chapterUid": 4
 },
 {
  "level": 4,
  "text": "我突然回忆起更小的时候，我还没有搬过来，房间一样黑暗，母亲去上班，把我关在屋里，父亲睡觉。",
  "uiIdx": "",
  "range": "2504-2549",
  "chapterUid": 4
 },
 {
  "level": 4,
  "text": "我龟缩在角落，把墙边的蚂蚁一只只捉进小矿泉水瓶里，滴入两滴水，扔几颗煮熟的米饭，深夜放在床头，希望它们伴我入睡。",
  "uiIdx": "",
  "range": "2549-2605",
  "chapterUid": 4
 },
 {
  "level": 4,
  "text": "可第二天一早醒来，蚂蚁都死了，身形蜷曲，尸体随水漂流，只剩下一颗颗粘在瓶底，未动的米饭。",
  "uiIdx": "",
  "range": "2605-2649",
  "chapterUid": 4
 },
 {
  "level": 3,
  "text": "作者在半夜一点半，夜已经很深了，熬不住了，放下书，迷迷糊糊想要睡去",
  "uiIdx": "4.2",
  "range": "2674-2708",
  "chapterUid": 4
 },
 {
  "level": 4,
  "text": "一束微小的光穿透窗玻璃和帘布，落在床尾，落在我的被窝上。",
  "uiIdx": "",
  "range": "2708-2736",
  "chapterUid": 4
 },
 {
  "level": 4,
  "text": "我一激灵，不知哪儿来的力气，不由自主伸出手臂，努力去够那束残弱的光。",
  "uiIdx": "",
  "range": "2736-2770",
  "chapterUid": 4
 },
 {
  "level": 4,
  "text": "未见光明之前，黑暗便是整个世界。",
  "uiIdx": "",
  "range": "2795-2811",
  "chapterUid": 4
 },
 {
  "level": 4,
  "text": "我知道它来自哪儿，略一偏头，往窗后看一看，好似有一双柔和的眼睛一直在远处注视着我，注视着我们。",
  "uiIdx": "",
  "range": "2811-2858",
  "chapterUid": 4
 },
 {
  "level": 4,
  "text": "我抿了抿嘴，掖掖被子，把鞋袜穿上，小心翼翼下床。",
  "uiIdx": "",
  "range": "2858-2882",
  "chapterUid": 4
 },
 {
  "level": 4,
  "text": "书包挂在门后的铁钉上，我取下来，用手往里探了探，十分温暖。",
  "uiIdx": "",
  "range": "2882-2911",
  "chapterUid": 4
 },
 {
  "level": 4,
  "text": "我把书一本一本装进去，侧袋的水壶是满的，还温热，也许母亲不知何时来换过一次水，我扬手拍一拍，发出咕噜的响声。",
  "uiIdx": "",
  "range": "2911-2965",
  "chapterUid": 4
 },
 {
  "level": 4,
  "text": "我想，明天可以重新出发了。",
  "uiIdx": "",
  "range": "2965-2978",
  "chapterUid": 4
 },
 {
  "level": 1,
  "text": "六",
  "uiIdx": "",
  "range": "",
  "chapterUid": 4
 },
 {
  "level": 2,
  "text": "作者对少年宫的深厚情感与绘画创作",
  "uiIdx": "1",
  "range": "562-609",
  "chapterUid": 4
 },
 {
  "level": 3,
  "text": "作者通过绘画表达对少年宫的观察与感受",
  "uiIdx": "1.1",
  "range": "562-609",
  "chapterUid": 4
 },
 {
  "level": 4,
  "text": "我一次次观察这个建筑表面的纹理与内部结构，抚摸它的每一面白墙，头轻轻贴上去，感受它本身的温度。",
  "uiIdx": "",
  "range": "562-609",
  "chapterUid": 4
 },
 {
  "level": 4,
  "text": "一幅又一幅画在笔下诞生，有春季暖日和风百花绽放、夏季黄昏夕照漫洒台阶、秋季远山红叶落满广场、冬季大雪纷飞覆盖宫顶。",
  "uiIdx": "",
  "range": "609-666",
  "chapterUid": 4
 },
 {
  "level": 3,
  "text": "作者的画作在艺考中获奖，内容以少年宫为主题",
  "uiIdx": "1.2",
  "range": "708-767",
  "chapterUid": 4
 },
 {
  "level": 4,
  "text": "画的内容大致是，偌大的纸张上，两个建筑分列左右，泾渭分明，对等占据画幅一半，画的中央是一个人，一个处在分界间隙的男孩。",
  "uiIdx": "",
  "range": "708-767",
  "chapterUid": 4
 },
 {
  "level": 4,
  "text": "在画时，我不由想到古人说的阴和阳，想到光和暗，白日和黑夜，还有雨雪和阳光。家和少年宫，它们各自一半，如此平衡，占据我年少的生命历程。我的世界只有它们两个，画出黑和白，也是画出我自己的内心。",
  "uiIdx": "",
  "range": "767-861",
  "chapterUid": 4
 },
 {
  "level": 2,
  "text": "父亲与家人的烧烤聚会",
  "uiIdx": "2",
  "range": "1646-1676",
  "chapterUid": 4
 },
 {
  "level": 3,
  "text": "父亲在烧烤聚会中提议喝酒，表现出对生活的渴望",
  "uiIdx": "2.1",
  "range": "1646-1676",
  "chapterUid": 4
 },
 {
  "level": 4,
  "text": "他每喝一口，缓好半天才能喝第二口，腰部弯下，身体剧烈地抖动。",
  "uiIdx": "",
  "range": "1646-1676",
  "chapterUid": 4
 },
 {
  "level": 4,
  "text": "母亲一个劲给他拍背，一把想要夺走他手里的绿色瓶子，但啤酒瓶被父亲死死握紧了，两人僵持着。",
  "uiIdx": "",
  "range": "1676-1720",
  "chapterUid": 4
 },
 {
  "level": 4,
  "text": "父亲凝视着母亲，说，就今天让我喝一点吧，就一点。",
  "uiIdx": "",
  "range": "1720-1744",
  "chapterUid": 4
 },
 {
  "level": 3,
  "text": "父亲透露城市规划的消息，家人对此感到不安",
  "uiIdx": "2.2",
  "range": "2045-2075",
  "chapterUid": 4
 },
 {
  "level": 4,
  "text": "他喝得舌头有点大，依次竖起三根手指头，说了好几次我们才听清。",
  "uiIdx": "",
  "range": "2045-2075",
  "chapterUid": 4
 },
 {
  "level": 4,
  "text": "他说，第一，你们知不知道，外面正四处贴公告，新一轮城市规划，一路从边缘搞到中心，现在要搞到我们这儿来了。",
  "uiIdx": "",
  "range": "2075-2127",
  "chapterUid": 4
 },
 {
  "level": 4,
  "text": "他说，第二，你们知不知道，到时这一片都得拆，咱们住的地方肯定要拆，一栋栋一户户都得签字搬走。",
  "uiIdx": "",
  "range": "2136-2182",
  "chapterUid": 4
 },
 {
  "level": 4,
  "text": "母亲回过头来。他说，第三，你们知不知道，我提前了解过，到时我们都会住更大更新的房子，全是电梯房，小区绿化也做得不错，咱们以后别做上下楼了，做个对门，来去方便。",
  "uiIdx": "",
  "range": "2136-2182",
  "chapterUid": 4
 },
 {
  "level": 2,
  "text": "父亲对儿子的期望与告诫",
  "uiIdx": "3",
  "range": "3267-3322",
  "chapterUid": 4
 },
 {
  "level": 3,
  "text": "父亲告诫儿子要独立，不要回头",
  "uiIdx": "3.1",
  "range": "3267-3322",
  "chapterUid": 4
 },
 {
  "level": 4,
  "text": "父亲凝视着远方的黑暗，说，这么多年，你从来不欠我们什么，是我欠你们的，未来怎么走，我教不了你，一切都要自己走。",
  "uiIdx": "",
  "range": "3267-3322",
  "chapterUid": 4
 },
 {
  "level": 4,
  "text": "我说，是。父亲凝视着远方的黑暗，说，人活一世，不要回头，要大步向前。",
  "uiIdx": "",
  "range": "3349-3399",
  "chapterUid": 4
 },
 {
  "level": 3,
  "text": "父亲在少年宫前停留，表达对过去的怀念",
  "uiIdx": "3.2",
  "range": "2722-2758",
  "chapterUid": 4
 },
 {
  "level": 4,
  "text": "我跟着父亲，一直走到少年宫面前，像是多年前，第一次上课那样，正面直视它。",
  "uiIdx": "",
  "range": "2722-2758",
  "chapterUid": 4
 },
 {
  "level": 4,
  "text": "这时下起了蒙蒙细雨，沙沙作响。少年宫静默矗立着，好似正在安眠。",
  "uiIdx": "",
  "range": "2783-2814",
  "chapterUid": 4
 },
 {
  "level": 4,
  "text": "天空有明月高悬，散发出朦胧的幽光，泻下的月华落在少年宫的外墙壁上，原本轮廓模糊的建筑物，一点点展露身形。",
  "uiIdx": "",
  "range": "2814-2866",
  "chapterUid": 4
 },
 {
  "level": 4,
  "text": "而镶在楼中央的一个个玻璃格子窗，在夜雨中闪烁着光，仿若嵌好的一块块宝石，无数团光晕流转，每一格自成一个世界。",
  "uiIdx": "",
  "range": "2920-2974",
  "chapterUid": 4
 },
 {
  "level": 4,
  "text": "最后，在大楼的顶端，有一根尖细的避雷针，荧荧散发幽光，如同洁白独角兽头顶上的一只角，赋予了整个建筑物完全的美感。",
  "uiIdx": "",
  "range": "2974-3030",
  "chapterUid": 4
 },
 {
  "level": 4,
  "text": "当一抹云遮掩月光，夜彻底暗下来时，它们便如一块冰化在水面，更如一只竖起的眼睛，完全合上了。",
  "uiIdx": "",
  "range": "3030-3075",
  "chapterUid": 4
 },
 {
  "level": 4,
  "text": "来路难辨，四周涌起无数的夜雾，黑暗即将吞没一切，父亲仍久久不愿离开。",
  "uiIdx": "",
  "range": "3100-3134",
  "chapterUid": 4
 },
 {
  "level": 4,
  "text": "过了许久他才艰难迈动步伐，朝原路返回。",
  "uiIdx": "",
  "range": "3134-3153",
  "chapterUid": 4
 },
 {
  "level": 4,
  "text": "一路走来，父亲手捏成拳头，低声咳嗽不止，我撑着一把伞，有心学母亲那样给他拍背，却被他一手推开。",
  "uiIdx": "",
  "range": "3178-3224",
  "chapterUid": 4
 },
 {
  "level": 4,
  "text": "到了家门口，他停下脚步，盯着我说，听你妈说，你到外地读书后，一年就回来一次？我说，是。",
  "uiIdx": "",
  "range": "3224-3262",
  "chapterUid": 4
 },
 {
  "level": 1,
  "text": "七",
  "uiIdx": "",
  "range": "",
  "chapterUid": 4
 },
 {
  "level": 2,
  "text": "少年宫的拆除",
  "uiIdx": "1",
  "range": "654-669",
  "chapterUid": 4
 },
 {
  "level": 3,
  "text": "少年宫要被规划，要拆",
  "uiIdx": "1.1",
  "range": "654-669",
  "chapterUid": 4
 },
 {
  "level": 4,
  "text": "牌子已经摘了，灯关了，全部师资力量撤走，就剩下一栋空楼了。",
  "uiIdx": "",
  "range": "669-704",
  "chapterUid": 4
 },
 {
  "level": 3,
  "text": "旧的不去新的不来，世界运转的逻辑就是这样，接受现实吧。",
  "uiIdx": "1.2",
  "range": "731-764",
  "chapterUid": 4
 },
 {
  "level": 2,
  "text": "父亲的病情",
  "uiIdx": "2",
  "range": "1017-1087",
  "chapterUid": 4
 },
 {
  "level": 3,
  "text": "父亲的身体状况急转直下，因受寒染上肺结核，一下就垮了",
  "uiIdx": "2.1",
  "range": "1017-1087",
  "chapterUid": 4
 },
 {
  "level": 4,
  "text": "本就枯瘦的身子，又掉了十来斤。",
  "uiIdx": "",
  "range": "1017-1087",
  "chapterUid": 4
 },
 {
  "level": 2,
  "text": "家庭的变化",
  "uiIdx": "3",
  "range": "922-963",
  "chapterUid": 4
 },
 {
  "level": 3,
  "text": "赵广全搬走了，搬去更大更好的房子。",
  "uiIdx": "3.1",
  "range": "922-963",
  "chapterUid": 4
 },
 {
  "level": 3,
  "text": "父亲的身体状况恶化，母亲在门口接我，颤巍巍地扶着一面墙",
  "uiIdx": "3.2",
  "range": "862-897",
  "chapterUid": 4
 },
 {
  "level": 4,
  "text": "她的头发又白了少许，颤巍巍地扶着一面墙，凑近看了半天，才发现面前是我。",
  "uiIdx": "",
  "range": "862-897",
  "chapterUid": 4
 },
 {
  "level": 2,
  "text": "母亲的故事",
  "uiIdx": "4",
  "range": "3019-3064",
  "chapterUid": 4
 },
 {
  "level": 3,
  "text": "母亲被少年宫顺带解聘了",
  "uiIdx": "4.1",
  "range": "3019-3064",
  "chapterUid": 4
 },
 {
  "level": 4,
  "text": "因为忙着清理师资，她被少年宫顺带解聘了。",
  "uiIdx": "",
  "range": "3019-3064",
  "chapterUid": 4
 },
 {
  "level": 3,
  "text": "父亲活下来了，少年宫也没拆",
  "uiIdx": "4.2",
  "range": "2638-2653",
  "chapterUid": 4
 },
 {
  "level": 4,
  "text": "那年冬天喝死了不少人，都被清理掉了，没有家属，没人关心。但父亲活下来了，少年宫也没拆。",
  "uiIdx": "",
  "range": "2610-2653",
  "chapterUid": 4
 },
 {
  "level": 2,
  "text": "父亲最后的愿望",
  "uiIdx": "5",
  "range": "1538-1564",
  "chapterUid": 4
 },
 {
  "level": 3,
  "text": "父亲的手瘦骨嶙峋，能一下摸得着骨头，但他慢慢抽出来",
  "uiIdx": "5.1",
  "range": "1538-1564",
  "chapterUid": 4
 },
 {
  "level": 4,
  "text": "突然，他莫名问了我一句，你还记得小时候，我带你看房子吗？",
  "uiIdx": "",
  "range": "1564-1592",
  "chapterUid": 4
 },
 {
  "level": 3,
  "text": "父亲说，人这一辈子，到临死前，才知道为什么而活",
  "uiIdx": "5.2",
  "range": "1600-1626",
  "chapterUid": 4
 },
 {
  "level": 4,
  "text": "我把痰盂端到他面前，轻拍他的背，说，你快别说了，一直在咯血。",
  "uiIdx": "",
  "range": "1626-1656",
  "chapterUid": 4
 },
 {
  "level": 4,
  "text": "父亲随后不再说话，紧紧闭上眼睛，胸口像拉风箱一样响。",
  "uiIdx": "",
  "range": "1656-1682",
  "chapterUid": 4
 },
 {
  "level": 4,
  "text": "好半天，他才挤出最后一句，你先出去吧。",
  "uiIdx": "",
  "range": "1682-1701",
  "chapterUid": 4
 },
 {
  "level": 1,
  "text": "八",
  "uiIdx": "",
  "range": "",
  "chapterUid": 4
 },
 {
  "level": 2,
  "text": "父亲的最后几天",
  "uiIdx": "1",
  "range": "524-578",
  "chapterUid": 4
 },
 {
  "level": 3,
  "text": "父亲在床上躺着，我坐在那套沙发上，学着他过去的样子，把飞镖一次次丢掷在对面挂着的地图上，每次都能正中靶心。",
  "uiIdx": "1.1",
  "range": "524-578",
  "chapterUid": 4
 },
 {
  "level": 3,
  "text": "父亲偶尔还能下床，便执意去少年宫附近走一走，甚至力气还恢复了些，偶尔买回两袋橘子",
  "uiIdx": "1.2",
  "range": "578-652",
  "chapterUid": 4
 },
 {
  "level": 4,
  "text": "但我知道，这一切只是回光返照，一到深夜，他那咯血的声音会再次响起。",
  "uiIdx": "",
  "range": "578-652",
  "chapterUid": 4
 },
 {
  "level": 2,
  "text": "父亲对少年宫的牵挂",
  "uiIdx": "2",
  "range": "960-1003",
  "chapterUid": 4
 },
 {
  "level": 3,
  "text": "父亲早就知道少年宫要拆了，但他还是经常去少年宫附近走走",
  "uiIdx": "2.1",
  "range": "960-1003",
  "chapterUid": 4
 },
 {
  "level": 4,
  "text": "他把地图小心翼翼取下来，往后摸了摸，好像摸到什么东西，握在手掌，一摊开，是一块吸铁石。",
  "uiIdx": "",
  "range": "960-1003",
  "chapterUid": 4
 },
 {
  "level": 4,
  "text": "飞镖是铁做的，全部牢牢吸附在上面。",
  "uiIdx": "",
  "range": "1003-1020",
  "chapterUid": 4
 },
 {
  "level": 3,
  "text": "父亲认为，只要看着所有人爱它，都需要它，哪怕我不再被人需要，但只要有它在，我的生命就有了意义",
  "uiIdx": "2.2",
  "range": "1116-1227",
  "chapterUid": 4
 },
 {
  "level": 4,
  "text": "他把头别向窗外，准确说，是朝一个方向望去。那儿一片漆黑，早已不再发光了。",
  "uiIdx": "",
  "range": "1227-1263",
  "chapterUid": 4
 },
 {
  "level": 2,
  "text": "少年宫的拆除",
  "uiIdx": "3",
  "range": "2526-2570",
  "chapterUid": 4
 },
 {
  "level": 3,
  "text": "少年宫已经被拆掉，外面围上一圈红色的警戒线",
  "uiIdx": "3.1",
  "range": "2526-2570",
  "chapterUid": 4
 },
 {
  "level": 4,
  "text": "广场早已空出一大片地来，几名戴着钢盔帽子的男人站在一起，一面抬头仰望着前方那座巨大的建筑物，一面在互相嘀咕着什么。",
  "uiIdx": "",
  "range": "2839-2901",
  "chapterUid": 4
 },
 {
  "level": 4,
  "text": "我看见其中一个戴钢盔帽的手持着一个话筒大声说着话，距离太远，听不太清具体内容，但我隐隐已有所明白。",
  "uiIdx": "",
  "range": "2901-2950",
  "chapterUid": 4
 },
 {
  "level": 3,
  "text": "所谓的楼房拆迁，不一定要靠推倒，而可以采用另一种方式，且爆破的时间比预期还要早",
  "uiIdx": "3.2",
  "range": "2950-2990",
  "chapterUid": 4
 },
 {
  "level": 4,
  "text": "可这一切，都让我始料未及。",
  "uiIdx": "",
  "range": "2990-3003",
  "chapterUid": 4
 },
 {
  "level": 2,
  "text": "父亲的去世",
  "uiIdx": "4",
  "range": "1517-1531",
  "chapterUid": 4
 },
 {
  "level": 3,
  "text": "新年来临之际，父亲又倒下了",
  "uiIdx": "4.1",
  "range": "1517-1531",
  "chapterUid": 4
 },
 {
  "level": 4,
  "text": "我躺回熟悉的床上，隔壁的咯血声时不时响起，在莫可名状的黑夜，父亲拖着病残的身体，又能活几时？",
  "uiIdx": "",
  "range": "1556-1602",
  "chapterUid": 4
 },
 {
  "level": 3,
  "text": "母亲告诉我，父亲走了",
  "uiIdx": "4.2",
  "range": "3505-3510",
  "chapterUid": 4
 },
 {
  "level": 4,
  "text": "你爸走了。",
  "uiIdx": "",
  "range": "3505-3510",
  "chapterUid": 4
 }
]