[
 {
  "level": 1,
  "text": "第一章",
  "uiIdx": "",
  "range": "",
  "chapterUid": 3
 },
 {
  "level": 2,
  "text": "作者申领驾照的原因",
  "uiIdx": "1",
  "range": "585-642",
  "chapterUid": 3
 },
 {
  "level": 3,
  "text": "作者被中国的公路和正在消失的空地激发起申领驾照的愿望",
  "uiIdx": "1.1",
  "range": "585-642",
  "chapterUid": 3
 },
 {
  "level": 4,
  "text": "中国的很多公路仍然十分空旷，尤其在西北的大草原上。",
  "uiIdx": "",
  "range": "415-467",
  "chapterUid": 3
 },
 {
  "level": 4,
  "text": "即便在沿海那些发展迅猛的城镇里，也到处是空旷之路。",
  "uiIdx": "",
  "range": "467-492",
  "chapterUid": 3
 },
 {
  "level": 3,
  "text": "作者认为汽车代表着冒险和游历",
  "uiIdx": "1.2",
  "range": "880-896",
  "chapterUid": 3
 },
 {
  "level": 4,
  "text": "对我来说，它代表着冒险和游历。",
  "uiIdx": "",
  "range": "880-896",
  "chapterUid": 3
 },
 {
  "level": 2,
  "text": "中国人申领驾照的过程",
  "uiIdx": "2",
  "range": "1465-1510",
  "chapterUid": 3
 },
 {
  "level": 3,
  "text": "中国人申领驾照时，按规定要进行体检、笔试、参加技能课程训练，随后是为期两天的驾驶能力考试",
  "uiIdx": "2.1",
  "range": "1465-1510",
  "chapterUid": 3
 },
 {
  "level": 4,
  "text": "对于已经持有国外驾照的人，这套程序有所减免。",
  "uiIdx": "",
  "range": "1510-1533",
  "chapterUid": 3
 },
 {
  "level": 3,
  "text": "驾驶员考试题涉及交通规则和安全意识",
  "uiIdx": "2.2",
  "range": "1104-1127",
  "chapterUid": 3
 },
 {
  "level": 4,
  "text": "例如，223题 驾驶机动车经过积水路段时，你应该：A)加速通过，以免发动机进水。B)停车，检查积水，确认积水较浅时，缓慢通过。C)在路人的带领下通过。",
  "uiIdx": "",
  "range": "1001-1127",
  "chapterUid": 3
 },
 {
  "level": 4,
  "text": "例如，282题 驾驶机动车通过铁路道口时，你应该：A)加速通过。B)仅在看见火车即将驶来时，才可以加速通过。C)减速，确认安全后通过。",
  "uiIdx": "",
  "range": "1056-1127",
  "chapterUid": 3
 },
 {
  "level": 2,
  "text": "作者的驾车之旅",
  "uiIdx": "3",
  "range": "5406-5442",
  "chapterUid": 3
 },
 {
  "level": 3,
  "text": "作者租了一辆轿车，从北京出发，一路向西，穿过河北，山西，陕西，内蒙古",
  "uiIdx": "3.1",
  "range": "5406-5442",
  "chapterUid": 3
 },
 {
  "level": 4,
  "text": "在路上，作者遇到了各种困难，如被警察赶出榆林，车辆被刮蹭等。",
  "uiIdx": "",
  "range": "46365-46383",
  "chapterUid": 3
 },
 {
  "level": 3,
  "text": "作者在旅途中，体验了中国的乡村生活，了解了中国人的生活方式",
  "uiIdx": "3.2",
  "range": "13862-13883",
  "chapterUid": 3
 },
 {
  "level": 4,
  "text": "在路上，作者遇到了许多搭顺风车的人，他们大多是离家在外做工的人。",
  "uiIdx": "",
  "range": "38152-38179",
  "chapterUid": 3
 },
 {
  "level": 4,
  "text": "作者在山西的农村，看到了人们为了防止水土流失而进行的植树运动。",
  "uiIdx": "",
  "range": "31968-32015",
  "chapterUid": 3
 },
 {
  "level": 4,
  "text": "作者在内蒙古的沙漠地区，看到了人们为了改良贫瘠的土地而进行的种种努力。",
  "uiIdx": "",
  "range": "46729-46754",
  "chapterUid": 3
 },
 {
  "level": 2,
  "text": "中国的道路建设和长城保护",
  "uiIdx": "4",
  "range": "10125-10166",
  "chapterUid": 3
 },
 {
  "level": 3,
  "text": "中国的道路建设经历了多次变革，从最初的马拉车道路到现代的柏油马路",
  "uiIdx": "4.1",
  "range": "10125-10166",
  "chapterUid": 3
 },
 {
  "level": 4,
  "text": "首次大规模的公路建设运动始于1920年，当时的一场旱灾在华北地区造成了严重的饥荒。",
  "uiIdx": "",
  "range": "10125-10166",
  "chapterUid": 3
 },
 {
  "level": 4,
  "text": "1998年，亚洲金融风暴提供了动力，这跟过去的饥荒多少有些相像。当时的政府想要抵消经济上的风险和威胁，也看到了其中难得的机遇，终于可以激发起推迟了多年的汽车大发展。",
  "uiIdx": "",
  "range": "10125-10166",
  "chapterUid": 3
 },
 {
  "level": 3,
  "text": "长城是中国的象征，但也面临着保护和发展的矛盾",
  "uiIdx": "4.2",
  "range": "46365-46383",
  "chapterUid": 3
 },
 {
  "level": 4,
  "text": "在鄂尔多斯沙漠，长城正在一点一点被掩埋掉。",
  "uiIdx": "",
  "range": "46365-46383",
  "chapterUid": 3
 },
 {
  "level": 4,
  "text": "近年来，当地政府采取了全新的策略，人们放弃了水稻种植，改种柳树，然后用柳树叶子来饲养绵羊。他们把这种模式叫作“空中草场”。",
  "uiIdx": "",
  "range": "47516-47613",
  "chapterUid": 3
 },
 {
  "level": 1,
  "text": "第二章",
  "uiIdx": "",
  "range": "",
  "chapterUid": 3
 },
 {
  "level": 2,
  "text": "作者在中国自驾游的体验",
  "uiIdx": "1",
  "range": "2784-2840",
  "chapterUid": 3
 },
 {
  "level": 3,
  "text": "作者遇到了各种挑战，包括语言障碍、文化差异和交通规则的不同。",
  "uiIdx": "1.1",
  "range": "2784-2840",
  "chapterUid": 3
 },
 {
  "level": 3,
  "text": "作者目睹了中国农村地区的变迁，包括年轻人口外流和传统生活方式的逐渐消失。",
  "uiIdx": "1.2",
  "range": "1894-1928",
  "chapterUid": 3
 },
 {
  "level": 3,
  "text": "在穿越河西走廊的过程中，作者对中国长城的历史和文化意义有了更深入的了解。",
  "uiIdx": "1.3",
  "range": "45521-45559",
  "chapterUid": 3
 },
 {
  "level": 3,
  "text": "作者在旅行过程中，遇到了各种困难，包括被误认为是间谍和违反外国人管理法规等。",
  "uiIdx": "1.4",
  "range": "39108-39150",
  "chapterUid": 3
 },
 {
  "level": 1,
  "text": "第一章",
  "uiIdx": "",
  "range": "",
  "chapterUid": 6
 },
 {
  "level": 2,
  "text": "作者在北京以北的农村寻找第二个家",
  "uiIdx": "1",
  "range": "415-440",
  "chapterUid": 6
 },
 {
  "level": 3,
  "text": "作者希望找到一个人们依旧在耕田种地，他们的生活节奏与农田时令合拍的地方",
  "uiIdx": "1.1",
  "range": "655-693",
  "chapterUid": 6
 },
 {
  "level": 4,
  "text": "作者在密云水库那边靠近河北的地方搜寻过，那一带的道路仍旧是土路，路上跑的车子多是拖拉机。",
  "uiIdx": "",
  "range": "747-795",
  "chapterUid": 6
 },
 {
  "level": 3,
  "text": "作者在2002年春季的一天早晨，和同在乡下寻找住处的美国朋友郭眯眯一起开着车出发了",
  "uiIdx": "1.2",
  "range": "876-916",
  "chapterUid": 6
 },
 {
  "level": 4,
  "text": "我们走过了北京平原北边的小城怀柔，然后进入了燕山的山麓。",
  "uiIdx": "",
  "range": "916-944",
  "chapterUid": 6
 },
 {
  "level": 2,
  "text": "作者在三岔村的生活",
  "uiIdx": "2",
  "range": "1773-1790",
  "chapterUid": 6
 },
 {
  "level": 3,
  "text": "三岔从来就是一个小村子，近几年，这个村子的规模变得更小了",
  "uiIdx": "2.1",
  "range": "1773-1790",
  "chapterUid": 6
 },
 {
  "level": 4,
  "text": "20世纪70年代，村子有三百来口人，目前还剩不到一百五十人留守。",
  "uiIdx": "",
  "range": "1790-1822",
  "chapterUid": 6
 },
 {
  "level": 3,
  "text": "当地居民的年收入在两千元左右，这点收入差不多全来自果园",
  "uiIdx": "2.2",
  "range": "2238-2253",
  "chapterUid": 6
 },
 {
  "level": 4,
  "text": "人们养鸡，喂猪，种着玉米、大豆，还有蔬菜。",
  "uiIdx": "",
  "range": "2306-2327",
  "chapterUid": 6
 },
 {
  "level": 3,
  "text": "北京离这儿不算太远，车程只有一两个小时。可在那个时候，城里人很少到乡下来游玩",
  "uiIdx": "2.3",
  "range": "2431-2451",
  "chapterUid": 6
 },
 {
  "level": 4,
  "text": "有时候，有一两个人开着车冒险来到了通往三岔的小路。有时候，一群正儿八经的徒步旅行者会来这里，攀爬那段尚未修复的长城。",
  "uiIdx": "",
  "range": "2532-2590",
  "chapterUid": 6
 },
 {
  "level": 2,
  "text": "作者与魏子淇的交往",
  "uiIdx": "3",
  "range": "10374-10389",
  "chapterUid": 6
 },
 {
  "level": 3,
  "text": "魏子淇是三岔村读书最多的人，他收集了一些法律书籍",
  "uiIdx": "3.1",
  "range": "10374-10389",
  "chapterUid": 6
 },
 {
  "level": 4,
  "text": "他参加了法律函授课程的学习，因此收集了三十多本法律书籍。",
  "uiIdx": "",
  "range": "10389-10483",
  "chapterUid": 6
 },
 {
  "level": 3,
  "text": "魏子淇对历史不怎么在意，他喜欢研究法律，是因为法律有实用价值",
  "uiIdx": "3.2",
  "range": "18654-18689",
  "chapterUid": 6
 },
 {
  "level": 4,
  "text": "他之所以为长城画下了一幅幅地图，是因为觉得，肯定有一种法子能让他从长城的旅游中赚钱。",
  "uiIdx": "",
  "range": "18689-18731",
  "chapterUid": 6
 },
 {
  "level": 2,
  "text": "魏嘉的生病和治疗经历",
  "uiIdx": "4",
  "range": "30632-30670",
  "chapterUid": 6
 },
 {
  "level": 3,
  "text": "魏嘉被诊断出患有免疫性血小板减少性紫癜，血小板数量极低，有脑出血的危险",
  "uiIdx": "4.1",
  "range": "30632-30670",
  "chapterUid": 6
 },
 {
  "level": 4,
  "text": "小男孩的脸上出现痛苦的神情，他又开始哭喊起来：“我不要一个人呆在这里！我不要一个人呆在这里！”。",
  "uiIdx": "",
  "range": "36639-36686",
  "chapterUid": 6
 },
 {
  "level": 3,
  "text": "经过一段时间的治疗，魏嘉的病情得到了控制，血小板数量恢复了正常",
  "uiIdx": "4.2",
  "range": "45264-45280",
  "chapterUid": 6
 },
 {
  "level": 4,
  "text": "输血之后，魏嘉的烧退了。两天之内，他的血小板恢复了正常。接下来的一周时间里，血小板均维持在正常水平上。骨髓检测显示，不是白血病。",
  "uiIdx": "",
  "range": "45252-45316",
  "chapterUid": 6
 },
 {
  "level": 2,
  "text": "作者对农村医疗体系的看法",
  "uiIdx": "5",
  "range": "38940-38966",
  "chapterUid": 6
 },
 {
  "level": 3,
  "text": "农村的医疗体系相对落后，医生和护士的专业水平有待提高",
  "uiIdx": "5.1",
  "range": "38940-38966",
  "chapterUid": 6
 },
 {
  "level": 4,
  "text": "医生赵医生对血液的来源和安全性问题态度模糊，对输血的风险解释不清。",
  "uiIdx": "",
  "range": "40037-40062",
  "chapterUid": 6
 },
 {
  "level": 3,
  "text": "血液供应渠道不透明，存在安全隐患",
  "uiIdx": "5.2",
  "range": "41759-41791",
  "chapterUid": 6
 },
 {
  "level": 4,
  "text": "医生赵医生表示，他们没有办法查得出所有的病毒，血液可能携带艾滋病毒、肝炎病毒或者别的什么病毒。",
  "uiIdx": "",
  "range": "41759-41847",
  "chapterUid": 6
 },
 {
  "level": 4,
  "text": "医生赵医生认为，北京根本就没有干净的血液，除了用他们的血液，你没有别的选择。风险是有一点，但他如果不注射丙种球蛋白风险更大。你们现在就得把这事定下来！",
  "uiIdx": "",
  "range": "42292-42367",
  "chapterUid": 6
 },
 {
  "level": 1,
  "text": "第二章",
  "uiIdx": "",
  "range": "",
  "chapterUid": 6
 },
 {
  "level": 2,
  "text": "冬季是三岔最宁静的季节",
  "uiIdx": "1",
  "range": "412-424",
  "chapterUid": 6
 },
 {
  "level": 3,
  "text": "庄稼收完了，果园的活儿也基本上干完了",
  "uiIdx": "1.1",
  "range": "424-460",
  "chapterUid": 6
 },
 {
  "level": 4,
  "text": "男人们主要是捡拾柴火，有时候也会进山打猎。",
  "uiIdx": "",
  "range": "460-481",
  "chapterUid": 6
 },
 {
  "level": 3,
  "text": "人们多数时候呆在家里，因为空气干燥，下雪并不多见",
  "uiIdx": "1.2",
  "range": "521-535",
  "chapterUid": 6
 },
 {
  "level": 4,
  "text": "在屋子里，炕是唯一的热源。",
  "uiIdx": "",
  "range": "548-561",
  "chapterUid": 6
 },
 {
  "level": 4,
  "text": "日常生活多在这个巨大的土床上进行。",
  "uiIdx": "",
  "range": "561-611",
  "chapterUid": 6
 },
 {
  "level": 4,
  "text": "他们吃得很少——这儿的人在冬季只吃两顿，而不是三顿。",
  "uiIdx": "",
  "range": "611-637",
  "chapterUid": 6
 },
 {
  "level": 4,
  "text": "他们在晚上九十点钟就上床睡觉，有时候打打盹也就过了一个下午。",
  "uiIdx": "",
  "range": "637-667",
  "chapterUid": 6
 },
 {
  "level": 4,
  "text": "上午，一片宁静。寒冷的日子里，这村子如此宁静，村民们仿佛都在进行冬眠。",
  "uiIdx": "",
  "range": "667-702",
  "chapterUid": 6
 },
 {
  "level": 2,
  "text": "魏嘉的生病和康复",
  "uiIdx": "2",
  "range": "731-762",
  "chapterUid": 6
 },
 {
  "level": 3,
  "text": "魏嘉出院后，他就没去幼儿园，一直呆在家里",
  "uiIdx": "2.1",
  "range": "731-762",
  "chapterUid": 6
 },
 {
  "level": 4,
  "text": "整整两个月的时间，他基本上没有离开过屋子。",
  "uiIdx": "",
  "range": "762-803",
  "chapterUid": 6
 },
 {
  "level": 3,
  "text": "魏嘉的体重增加了八斤多",
  "uiIdx": "2.2",
  "range": "959-986",
  "chapterUid": 6
 },
 {
  "level": 4,
  "text": "他的父亲教他写一些简单的汉字，他们一起听一听英语磁带。",
  "uiIdx": "",
  "range": "959-986",
  "chapterUid": 6
 },
 {
  "level": 2,
  "text": "作者对三岔的喜爱和变化",
  "uiIdx": "3",
  "range": "1015-1030",
  "chapterUid": 6
 },
 {
  "level": 3,
  "text": "冬天是作者最喜欢到乡下去的时节",
  "uiIdx": "3.1",
  "range": "1015-1030",
  "chapterUid": 6
 },
 {
  "level": 4,
  "text": "没有夏天那种大风吹拂，每一条道路都干净多了。",
  "uiIdx": "",
  "range": "1030-1052",
  "chapterUid": 6
 },
 {
  "level": 3,
  "text": "作者对三岔的想法发生了巨大的变化",
  "uiIdx": "3.2",
  "range": "1758-1782",
  "chapterUid": 6
 },
 {
  "level": 4,
  "text": "一开始，我把这个村庄当作解脱之地，把它当成可以爬山、可以安安静静地从事写作的地方。而现在呢，我来这里完全是出于别的原因。在中国，这个地方最让我觉得有回家的感觉。",
  "uiIdx": "",
  "range": "1782-1862",
  "chapterUid": 6
 },
 {
  "level": 2,
  "text": "魏子淇的餐馆生意",
  "uiIdx": "4",
  "range": "2802-2838",
  "chapterUid": 6
 },
 {
  "level": 3,
  "text": "魏子淇在冬天决定把业务扩展一下，开一家货真价实的餐馆和招待所",
  "uiIdx": "4.1",
  "range": "2802-2838",
  "chapterUid": 6
 },
 {
  "level": 4,
  "text": "他把门前那块晒坝铺成了水泥地，还新修了一间厨房。",
  "uiIdx": "",
  "range": "2838-2884",
  "chapterUid": 6
 },
 {
  "level": 4,
  "text": "隔三岔五他就要跑一趟怀柔，去购买水泥和其他建材。",
  "uiIdx": "",
  "range": "2884-2908",
  "chapterUid": 6
 },
 {
  "level": 3,
  "text": "魏子淇为了做生意，开始注意起自己的穿着打扮",
  "uiIdx": "4.2",
  "range": "3013-3044",
  "chapterUid": 6
 },
 {
  "level": 4,
  "text": "他买了一套衣服，颜色和款式都不再是农村人经常穿着的军警服式样。",
  "uiIdx": "",
  "range": "3013-3044",
  "chapterUid": 6
 },
 {
  "level": 4,
  "text": "他买了适合城里人穿着的鞋子：一双价值三十多元的黑色皮鞋。",
  "uiIdx": "",
  "range": "3044-3073",
  "chapterUid": 6
 },
 {
  "level": 2,
  "text": "中国农村的土地问题",
  "uiIdx": "5",
  "range": "5916-5959",
  "chapterUid": 6
 },
 {
  "level": 3,
  "text": "三岔村的土地关系依然极为纷乱，持续时间长达一个多世纪",
  "uiIdx": "5.1",
  "range": "5916-5959",
  "chapterUid": 6
 },
 {
  "level": 4,
  "text": "最古老的一份文件可以追溯自清朝的光绪帝十三年。",
  "uiIdx": "",
  "range": "6132-6155",
  "chapterUid": 6
 },
 {
  "level": 4,
  "text": "1949年9月——也就是人民共和国成立前的一个月——签署的一份文件里面。",
  "uiIdx": "",
  "range": "7487-7548",
  "chapterUid": 6
 },
 {
  "level": 3,
  "text": "20世纪50年代，政府在农村地区实行了土地改革，农民们分到了田地",
  "uiIdx": "5.2",
  "range": "8629-8678",
  "chapterUid": 6
 },
 {
  "level": 4,
  "text": "1949年9月，魏家一共五口人，分得了七块田地。",
  "uiIdx": "",
  "range": "7610-7630",
  "chapterUid": 6
 },
 {
  "level": 4,
  "text": "这块地是原来属于搅屎棍的父亲——很显然，他没能赎回典押出去的那块土地。",
  "uiIdx": "",
  "range": "7721-7778",
  "chapterUid": 6
 },
 {
  "level": 3,
  "text": "1978年，邓小平主政后，他和其他一些改革家希望以某种形式将土地所有权赋予个人",
  "uiIdx": "5.3",
  "range": "8734-8774",
  "chapterUid": 6
 },
 {
  "level": 4,
  "text": "农民们跟村委会签约，获得土地使用权，条件是每年上缴一定的现金或者收成。",
  "uiIdx": "",
  "range": "8856-8891",
  "chapterUid": 6
 },
 {
  "level": 4,
  "text": "这实际上是共产党革命之前的佃农制的一种变体，差别只是现在的国家成了最大的土地所有者。",
  "uiIdx": "",
  "range": "8907-8949",
  "chapterUid": 6
 },
 {
  "level": 2,
  "text": "中国农村的变化和发展",
  "uiIdx": "6",
  "range": "13139-13185",
  "chapterUid": 6
 },
 {
  "level": 3,
  "text": "政府在农村地区启动了一项为期两年的建设工程，修建了近二十万公里的乡村道路",
  "uiIdx": "6.1",
  "range": "13139-13185",
  "chapterUid": 6
 },
 {
  "level": 4,
  "text": "在那两年时间里，人民共和国在乡村修建的沥青和水泥道路超过了之前半个世纪的总和。",
  "uiIdx": "",
  "range": "13185-13224",
  "chapterUid": 6
 },
 {
  "level": 3,
  "text": "2003年，中国的汽车市场正在经历着一场变化",
  "uiIdx": "6.2",
  "range": "13461-13479",
  "chapterUid": 6
 },
 {
  "level": 4,
  "text": "到2003年，丰田、尼桑、现代等汽车公司都开始在中国投产，而这些亚洲公司很快就产生了冲击力。",
  "uiIdx": "",
  "range": "13479-13525",
  "chapterUid": 6
 },
 {
  "level": 4,
  "text": "2003年6月，奇瑞公司——也就是我曾经去考察过试车环节的那家公司——揭开了第一辆微型汽车的面纱，并取名为QQ。",
  "uiIdx": "",
  "range": "13550-13606",
  "chapterUid": 6
 },
 {
  "level": 3,
  "text": "2003年，三岔的旅游业开始发展，一些北京商人来到三岔投资",
  "uiIdx": "6.3",
  "range": "14198-14242",
  "chapterUid": 6
 },
 {
  "level": 4,
  "text": "一个北京商人铺通了往黄花镇那条步行老路的下半段，然后在三岔水库边上开了一家餐馆和招待所。",
  "uiIdx": "",
  "range": "14198-14242",
  "chapterUid": 6
 },
 {
  "level": 4,
  "text": "那家餐馆是村子里第一家真正意义上的餐馆：一共有十几张桌子，可以进行室外烧烤，一口大水塘里养满了虹鳟鱼。",
  "uiIdx": "",
  "range": "14242-14290",
  "chapterUid": 6
 },
 {
  "level": 2,
  "text": "魏嘉的教育经历",
  "uiIdx": "7",
  "range": "40566-40604",
  "chapterUid": 6
 },
 {
  "level": 3,
  "text": "魏嘉在村子里的小学读书",
  "uiIdx": "7.1",
  "range": "40566-40604",
  "chapterUid": 6
 },
 {
  "level": 4,
  "text": "他在学校里学到的技能不一定为我所看重，但是毫无疑问，他是在为进入中国社会做着准备。",
  "uiIdx": "",
  "range": "40566-40604",
  "chapterUid": 6
 },
 {
  "level": 3,
  "text": "魏嘉的学习成绩优秀，但缺乏创造力",
  "uiIdx": "7.2",
  "range": "40688-40747",
  "chapterUid": 6
 },
 {
  "level": 4,
  "text": "他喜欢那间简陋的学生寝室——窗子上钉着窗条，铁架子上摆放着八张床垫，锈迹斑斑的散热器在每年的11月15日之前冷如磐石。",
  "uiIdx": "",
  "range": "40688-40747",
  "chapterUid": 6
 },
 {
  "level": 4,
  "text": "他最喜欢的科目是英语——他似乎对自己比其他孩子早开始学英语、单词也读得准确些这个事实颇感得意。",
  "uiIdx": "",
  "range": "40854-40901",
  "chapterUid": 6
 },
 {
  "level": 3,
  "text": "魏嘉在学校里担任纪律委员，表现出了领导能力",
  "uiIdx": "7.3",
  "range": "39721-39765",
  "chapterUid": 6
 },
 {
  "level": 4,
  "text": "如果某个小孩欺负另一个小孩，或者打架，或者侮辱人，或讲脏话，我就要扣分，要告诉老师。",
  "uiIdx": "",
  "range": "39721-39765",
  "chapterUid": 6
 },
 {
  "level": 4,
  "text": "他当纪律委员的职责有哪些。",
  "uiIdx": "",
  "range": "39676-39692",
  "chapterUid": 6
 },
 {
  "level": 2,
  "text": "魏嘉的家庭生活",
  "uiIdx": "8",
  "range": "36837-36851",
  "chapterUid": 6
 },
 {
  "level": 3,
  "text": "魏嘉的父母对他的教育非常严格",
  "uiIdx": "8.1",
  "range": "36837-36851",
  "chapterUid": 6
 },
 {
  "level": 4,
  "text": "他们逼着他去刻苦学习。",
  "uiIdx": "",
  "range": "36837-36851",
  "chapterUid": 6
 },
 {
  "level": 3,
  "text": "魏嘉的家庭生活充满了爱",
  "uiIdx": "8.2",
  "range": "40650-40688",
  "chapterUid": 6
 },
 {
  "level": 4,
  "text": "他跟他的同学在一起觉得很愉快，他的学习十分出色，他基本上从来没有抱怨过什么。",
  "uiIdx": "",
  "range": "40650-40688",
  "chapterUid": 6
 },
 {
  "level": 1,
  "text": "第三章",
  "uiIdx": "",
  "range": "",
  "chapterUid": 6
 },
 {
  "level": 2,
  "text": "魏子淇的生意和入党",
  "uiIdx": "1",
  "range": "412-442",
  "chapterUid": 6
 },
 {
  "level": 3,
  "text": "魏子淇因为搞经营而入了党，反过来，党又给他带来了更多的生意",
  "uiIdx": "1.1",
  "range": "412-442",
  "chapterUid": 6
 },
 {
  "level": 4,
  "text": "镇里的下乡干部有时候会到这家餐馆来吃饭，特别是如果有理由要到某个偏僻地方的话，他们更要来这个餐馆。",
  "uiIdx": "",
  "range": "442-491",
  "chapterUid": 6
 },
 {
  "level": 4,
  "text": "有一阵子，一群来自顺义的贪腐官员经常光顾这家餐馆，来此玩麻将进行豪赌。",
  "uiIdx": "",
  "range": "491-526",
  "chapterUid": 6
 },
 {
  "level": 3,
  "text": "2005年，政府启动了一个新的发展项目，叫作“新农村建设”",
  "uiIdx": "1.2",
  "range": "718-748",
  "chapterUid": 6
 },
 {
  "level": 4,
  "text": "这一年，当地县政府投入一笔钱支持农村地区的商业发展，以满足新兴的自驾游客的需要。",
  "uiIdx": "",
  "range": "879-919",
  "chapterUid": 6
 },
 {
  "level": 4,
  "text": "在这个项目中，魏子淇找到了一个受益的途径。他申请并得到了一笔现金资助，用来改建他的厨房。",
  "uiIdx": "",
  "range": "919-963",
  "chapterUid": 6
 },
 {
  "level": 2,
  "text": "魏子淇的家庭生活",
  "uiIdx": "2",
  "range": "6293-6319",
  "chapterUid": 6
 },
 {
  "level": 3,
  "text": "魏子淇和曹春梅的关系因为孩子的教育问题而变得紧张",
  "uiIdx": "2.1",
  "range": "6293-6319",
  "chapterUid": 6
 },
 {
  "level": 4,
  "text": "曹春梅希望魏子淇能多关心孩子，但魏子淇更专注于自己的生意和政治。",
  "uiIdx": "",
  "range": "412-442",
  "chapterUid": 6
 },
 {
  "level": 4,
  "text": "曹春梅对佛教的信仰似乎跟共产党不相一致，因为共产党员是不信宗教的。",
  "uiIdx": "",
  "range": "33885-33934",
  "chapterUid": 6
 },
 {
  "level": 3,
  "text": "魏嘉的身体状况和他的新名字",
  "uiIdx": "2.2",
  "range": "35288-35325",
  "chapterUid": 6
 },
 {
  "level": 4,
  "text": "魏嘉一直抱怨说肚子疼，而且很容易患上感冒。",
  "uiIdx": "",
  "range": "35288-35325",
  "chapterUid": 6
 },
 {
  "level": 4,
  "text": "魏嘉的新名字是通过电脑选取的，寓意着鸿运当头，长命百岁，乃至大富大贵。",
  "uiIdx": "",
  "range": "36229-36244",
  "chapterUid": 6
 },
 {
  "level": 2,
  "text": "三岔村的选举和政治",
  "uiIdx": "3",
  "range": "40806-40858",
  "chapterUid": 6
 },
 {
  "level": 3,
  "text": "三岔村的选举充满了明争暗斗，魏子淇被卷入了这场选战",
  "uiIdx": "3.1",
  "range": "40806-40858",
  "chapterUid": 6
 },
 {
  "level": 4,
  "text": "搅屎棍是魏子淇的副官，他在村子里小心翼翼地活动着，干着交头接耳、深夜密会之类的苦活累活。",
  "uiIdx": "",
  "range": "40806-40858",
  "chapterUid": 6
 },
 {
  "level": 4,
  "text": "党支部书记也鼓动起一个人充当她的副官，他们在村民中进行游说，试图影响选举结果。",
  "uiIdx": "",
  "range": "40887-40909",
  "chapterUid": 6
 },
 {
  "level": 3,
  "text": "选举结果出人意料，魏子淇落选，党支部书记胜出",
  "uiIdx": "3.2",
  "range": "43378-43395",
  "chapterUid": 6
 },
 {
  "level": 4,
  "text": "党支部书记在选举中获得了十五张提名票，魏子淇得到了十张票，获得提名。",
  "uiIdx": "",
  "range": "43378-43395",
  "chapterUid": 6
 },
 {
  "level": 4,
  "text": "在第二轮投票中，党支部书记名列第二，这意味着他们两人的职位保持不变。第三名成为了村支部委员。魏子淇什么也没捞着——连最低级别的职位都轮不到他。",
  "uiIdx": "",
  "range": "43448-43517",
  "chapterUid": 6
 },
 {
  "level": 1,
  "text": "第一章",
  "uiIdx": "",
  "range": "",
  "chapterUid": 10
 },
 {
  "level": 2,
  "text": "温州昌盛汽车租赁公司的独特经营策略",
  "uiIdx": "1",
  "range": "550-590",
  "chapterUid": 10
 },
 {
  "level": 3,
  "text": "“温州昌盛”会吸出并卖掉还车时油箱里剩余的汽油。",
  "uiIdx": "1.1",
  "range": "590-625",
  "chapterUid": 10
 },
 {
  "level": 2,
  "text": "中国汽车大发展带来的城市变革",
  "uiIdx": "2",
  "range": "889-943",
  "chapterUid": 10
 },
 {
  "level": 3,
  "text": "2005年，中国的乘用轿车保有量增加了一倍多",
  "uiIdx": "2.1",
  "range": "889-943",
  "chapterUid": 10
 },
 {
  "level": 4,
  "text": "政府公布了一系列规划以再修建五万公里的高速公路。",
  "uiIdx": "",
  "range": "943-975",
  "chapterUid": 10
 },
 {
  "level": 4,
  "text": "项目完成后，新建成的道路网络东起东部沿海的工业城镇，西至吉尔吉斯斯坦边境，将会把所有人口超过二十万的城市连接起来。",
  "uiIdx": "",
  "range": "975-1032",
  "chapterUid": 10
 },
 {
  "level": 4,
  "text": "在高速公路运输这个领域，中国也许是个后来者——全国的第一条高速公路完成于1988年——但是到了2020年，他们计划中的通车总里程数将超过美国。",
  "uiIdx": "",
  "range": "1032-1103",
  "chapterUid": 10
 },
 {
  "level": 2,
  "text": "浙江南部高速公路的修建及其影响",
  "uiIdx": "3",
  "range": "1446-1484",
  "chapterUid": 10
 },
 {
  "level": 3,
  "text": "“金丽温”高速公路起于靠近海岸线的温州，向西向北二百三十多公里后，接上了丽水市和金华市",
  "uiIdx": "3.1",
  "range": "1446-1484",
  "chapterUid": 10
 },
 {
  "level": 4,
  "text": "这条道路的很多路段跟老旧的330国道并肩而行。",
  "uiIdx": "",
  "range": "1484-1507",
  "chapterUid": 10
 },
 {
  "level": 4,
  "text": "这项工程的总投资超过一百二十七亿元，而且属于重点工程。",
  "uiIdx": "",
  "range": "1585-1622",
  "chapterUid": 10
 },
 {
  "level": 4,
  "text": "中国，那意味着这项建设工程必须夜以继日地进行。",
  "uiIdx": "",
  "range": "1622-1646",
  "chapterUid": 10
 },
 {
  "level": 2,
  "text": "浙江南部地区的小镇经济及其特色产品",
  "uiIdx": "4",
  "range": "24684-24731",
  "chapterUid": 10
 },
 {
  "level": 3,
  "text": "浙江南部的各个城镇专业生产单一产品，形成了独特的经济现象",
  "uiIdx": "4.1",
  "range": "3609-3635",
  "chapterUid": 10
 },
 {
  "level": 4,
  "text": "在武义县，有个人就直接伸手从口袋里摸出一大摞扑克牌。",
  "uiIdx": "",
  "range": "3609-3635",
  "chapterUid": 10
 },
 {
  "level": 4,
  "text": "桥头镇的总人口仅有六万四千人，但全镇范围内有三百八十多家工厂，生产的钮扣占到了中国服装行业需求量的百分之七十。",
  "uiIdx": "",
  "range": "2914-2969",
  "chapterUid": 10
 },
 {
  "level": 4,
  "text": "沿着330国道再往前走十六公里，顺着那条河转过一个弯道，可以看到桥头镇竖立的一座钮扣雕塑。",
  "uiIdx": "",
  "range": "2832-2877",
  "chapterUid": 10
 },
 {
  "level": 4,
  "text": "在浙江，这个地区的方言难听懂是出了名的，同时，只生产一样东西的小镇比比皆是。",
  "uiIdx": "",
  "range": "3430-3468",
  "chapterUid": 10
 },
 {
  "level": 4,
  "text": "从一个城镇到另一个城镇，我开着车穿行于极其美丽的乡村之间。",
  "uiIdx": "",
  "range": "3834-3863",
  "chapterUid": 10
 },
 {
  "level": 4,
  "text": "到了夜晚，我一般住在“国际宾馆”。",
  "uiIdx": "",
  "range": "4072-4089",
  "chapterUid": 10
 },
 {
  "level": 2,
  "text": "丽水经济开发区的建立和发展",
  "uiIdx": "5",
  "range": "39684-39711",
  "chapterUid": 10
 },
 {
  "level": 3,
  "text": "丽水经济开发区是政府为了吸引投资者而建立的新工业园区",
  "uiIdx": "5.1",
  "range": "5551-5592",
  "chapterUid": 10
 },
 {
  "level": 4,
  "text": "直到不久前，这里还一直是个农业地区，跟中国所有的农村一样，没有时间概念。",
  "uiIdx": "",
  "range": "5470-5544",
  "chapterUid": 10
 },
 {
  "level": 4,
  "text": "而现在，一块块农田正在被向外扩展的工业园区替代，政府希望以此吸引来自沿海的投资者。",
  "uiIdx": "",
  "range": "5551-5592",
  "chapterUid": 10
 },
 {
  "level": 4,
  "text": "新的道路一旦完工，从温州过来的三小时车程将会缩短至一个小时多一点儿。",
  "uiIdx": "",
  "range": "5592-5627",
  "chapterUid": 10
 },
 {
  "level": 2,
  "text": "胸罩调节环制造厂的创办和发展",
  "uiIdx": "6",
  "range": "35581-35612",
  "chapterUid": 10
 },
 {
  "level": 3,
  "text": "高老板和王老板在丽水经济开发区创办了一家胸罩调节环制造厂",
  "uiIdx": "6.1",
  "range": "35581-35612",
  "chapterUid": 10
 },
 {
  "level": 4,
  "text": "他们计划生产“服装配件”，不过对于具体生产什么，他没有细说。",
  "uiIdx": "",
  "range": "6222-6257",
  "chapterUid": 10
 },
 {
  "level": 4,
  "text": "两位老板一起上下各处搜寻着——哎，不管怎么说，他们算是把胸罩研究了个底朝天。",
  "uiIdx": "",
  "range": "14823-14861",
  "chapterUid": 10
 },
 {
  "level": 4,
  "text": "对于消费者来说，胸罩的肩带调节环十分简单，几乎可以忽略不计。",
  "uiIdx": "",
  "range": "15055-15085",
  "chapterUid": 10
 },
 {
  "level": 4,
  "text": "那台机器最早来自欧洲。在中国的工厂里，类似的设备通常可以找到一个谱系，顺着它，一般都会追溯到国外。",
  "uiIdx": "",
  "range": "17563-17601",
  "chapterUid": 10
 },
 {
  "level": 4,
  "text": "在丽水的工厂里，对设备进行的第一次调试失败后，罗师傅终于意识到，这台机器存在着一个重大的设计缺陷。",
  "uiIdx": "",
  "range": "19700-19749",
  "chapterUid": 10
 },
 {
  "level": 4,
  "text": "2006年1月，到那台机器开始运转起来的时候，金丽温高速公路已经通车了。",
  "uiIdx": "",
  "range": "20328-20364",
  "chapterUid": 10
 },
 {
  "level": 2,
  "text": "丽水经济开发区对外来务工人员的吸引力",
  "uiIdx": "7",
  "range": "32074-32143",
  "chapterUid": 10
 },
 {
  "level": 3,
  "text": "丽水经济开发区的发展吸引了大量的外来务工人员",
  "uiIdx": "7.1",
  "range": "32074-32143",
  "chapterUid": 10
 },
 {
  "level": 4,
  "text": "在经济开发区建设的第一年时间里，外来务工人员扛着大包小包的行李，走在尚未完工的街道上。",
  "uiIdx": "",
  "range": "32074-32143",
  "chapterUid": 10
 },
 {
  "level": 4,
  "text": "有些外来务工人员去了丽水的“人才市场”，这算得上是当地的找活中心吧。",
  "uiIdx": "",
  "range": "32217-32251",
  "chapterUid": 10
 },
 {
  "level": 4,
  "text": "在胸罩调节环制造厂所在的那条街上，我遇到了一队人马，有三十人之多。他们当时正聚集在那一带最大的工厂——金超人造革厂的大门前。",
  "uiIdx": "",
  "range": "33982-34083",
  "chapterUid": 10
 },
 {
  "level": 4,
  "text": "在丽水，女孩们的面孔代表着这个经济开发区发展的新阶段。",
  "uiIdx": "",
  "range": "39684-39711",
  "chapterUid": 10
 },
 {
  "level": 4,
  "text": "每一次，当我驾车从即将建成的厂区穿过时，总有一些新东西吸引着我的视线，它们预示着又蹒跚地往前迈进了一步。",
  "uiIdx": "",
  "range": "39711-39763",
  "chapterUid": 10
 },
 {
  "level": 1,
  "text": "第二章",
  "uiIdx": "",
  "range": "",
  "chapterUid": 10
 },
 {
  "level": 2,
  "text": "胸罩调节环制造厂的创立和经营困境",
  "uiIdx": "1",
  "range": "412-449",
  "chapterUid": 10
 },
 {
  "level": 3,
  "text": "胸罩调节环制造厂由十五岁的女孩陶玉凤和她的家人创立",
  "uiIdx": "1.1",
  "range": "412-449",
  "chapterUid": 10
 },
 {
  "level": 4,
  "text": "陶玉凤使用她姐姐的身份证进入工厂工作。",
  "uiIdx": "",
  "range": "449-485",
  "chapterUid": 10
 },
 {
  "level": 4,
  "text": "陶玉凤的父亲老陶和他的家人在工厂附近安顿下来，摆了一个很小的杂货摊。",
  "uiIdx": "",
  "range": "1465-1509",
  "chapterUid": 10
 },
 {
  "level": 3,
  "text": "厂里的机器是由一个只上过中学的农民凭着记忆设计出来的",
  "uiIdx": "1.2",
  "range": "35568-35604",
  "chapterUid": 10
 },
 {
  "level": 4,
  "text": "那台机器是模仿另一家工厂的机器设计的，但是缺少关键的零件。",
  "uiIdx": "",
  "range": "35568-35604",
  "chapterUid": 10
 },
 {
  "level": 3,
  "text": "厂里的主要产品是胸罩调节环，但由于缺乏系统和管理的结构，生产遇到了困难",
  "uiIdx": "1.3",
  "range": "36452-36487",
  "chapterUid": 10
 },
 {
  "level": 4,
  "text": "厂里最大的流动资产是装在无数个塑料袋子里的胸罩调节环，多达一百多万。",
  "uiIdx": "",
  "range": "35665-35717",
  "chapterUid": 10
 },
 {
  "level": 4,
  "text": "由于缺乏资金，厂里的生产机器无法得到及时的维护和更新。",
  "uiIdx": "",
  "range": "36452-36487",
  "chapterUid": 10
 },
 {
  "level": 2,
  "text": "罗师傅的个人经历和在工厂的工作",
  "uiIdx": "2",
  "range": "33132-33175",
  "chapterUid": 10
 },
 {
  "level": 3,
  "text": "罗师傅是一位有二十年经验的工厂工人，擅长修理机器",
  "uiIdx": "2.1",
  "range": "33132-33175",
  "chapterUid": 10
 },
 {
  "level": 4,
  "text": "罗师傅出生在湖北省松滋县，初中毕业后就开始在工厂工作。",
  "uiIdx": "",
  "range": "31334-31350",
  "chapterUid": 10
 },
 {
  "level": 4,
  "text": "罗师傅在深圳的私人培训学校学习，取得了函授高中毕业证。",
  "uiIdx": "",
  "range": "32272-32299",
  "chapterUid": 10
 },
 {
  "level": 3,
  "text": "罗师傅在胸罩调节环制造厂工作，但因为工厂的财务问题，他的工资被削减了",
  "uiIdx": "2.2",
  "range": "34622-34664",
  "chapterUid": 10
 },
 {
  "level": 4,
  "text": "罗师傅的工资从每月五千六百多元被削减到不足两千元。",
  "uiIdx": "",
  "range": "33667-33698",
  "chapterUid": 10
 },
 {
  "level": 4,
  "text": "罗师傅因为工资问题，跟老板发生了争执，最后不得不离开工厂。",
  "uiIdx": "",
  "range": "35225-35247",
  "chapterUid": 10
 },
 {
  "level": 2,
  "text": "中国工业城镇的发展和挑战",
  "uiIdx": "3",
  "range": "36331-36369",
  "chapterUid": 10
 },
 {
  "level": 3,
  "text": "中国的新兴城镇如丽水，通过吸引农村劳动力，发展起了制造业",
  "uiIdx": "3.1",
  "range": "36331-36369",
  "chapterUid": 10
 },
 {
  "level": 4,
  "text": "丽水市政府在经济开发区投入了大量资金，进行基础设施建设。",
  "uiIdx": "",
  "range": "18779-18807",
  "chapterUid": 10
 },
 {
  "level": 4,
  "text": "丽水经济开发区吸引了大量的工厂，包括胸罩调节环制造厂。",
  "uiIdx": "",
  "range": "30715-30756",
  "chapterUid": 10
 },
 {
  "level": 3,
  "text": "中国的新兴城镇面临着许多挑战，包括缺乏管理系统、教育体制落后等",
  "uiIdx": "3.2",
  "range": "28909-28927",
  "chapterUid": 10
 },
 {
  "level": 4,
  "text": "中国的新兴城镇里，没有私人报纸，没有独立的劳工联合会，宗教也许会在个人层面得到繁荣，可在组织层面上却相当弱小。",
  "uiIdx": "",
  "range": "28909-28955",
  "chapterUid": 10
 },
 {
  "level": 4,
  "text": "中国的教育体制改革缓慢，导致大多数工人的教育水平较低，缺乏创造力。",
  "uiIdx": "",
  "range": "36944-36989",
  "chapterUid": 10
 },
 {
  "level": 1,
  "text": "第三章",
  "uiIdx": "",
  "range": "",
  "chapterUid": 10
 },
 {
  "level": 2,
  "text": "作者在丽水市的考察经历",
  "uiIdx": "1",
  "range": "447-482",
  "chapterUid": 10
 },
 {
  "level": 3,
  "text": "作者定期前往浙江南部考察，喜欢开着车在那条新建成的高速公路上行驶",
  "uiIdx": "1.1",
  "range": "447-482",
  "chapterUid": 10
 },
 {
  "level": 4,
  "text": "丽水市新修了一家叫作现代广场的宾馆，作者同他们的经理协商到了特价，一晚只要一百六十元。",
  "uiIdx": "",
  "range": "503-545",
  "chapterUid": 10
 },
 {
  "level": 4,
  "text": "在几个街区之外，作者加入了那家叫作“闻香识女人”的健身俱乐部。",
  "uiIdx": "",
  "range": "545-575",
  "chapterUid": 10
 },
 {
  "level": 4,
  "text": "如果天气好的话，作者会到城南的小山上跑跑步，穿行在一片片柑橘林之间。",
  "uiIdx": "",
  "range": "716-749",
  "chapterUid": 10
 },
 {
  "level": 3,
  "text": "作者在考察途中遇到了“毛泽东”",
  "uiIdx": "1.2",
  "range": "1568-1614",
  "chapterUid": 10
 },
 {
  "level": 4,
  "text": "那位演员穿着一件灰色中山装，打着红色领带，在舞台上表演的妆容尚未褪去——脸上因此闪着不自然的红光。",
  "uiIdx": "",
  "range": "1568-1614",
  "chapterUid": 10
 },
 {
  "level": 4,
  "text": "他告诉我，他是长沙人——跟毛主席是真正的同乡。",
  "uiIdx": "",
  "range": "2832-2855",
  "chapterUid": 10
 },
 {
  "level": 4,
  "text": "他名片上的头衔至少有七个：金阳 伟大领袖毛泽东扮演者 凤之凰文化艺术中心主任 华夏国际影视有限公司总导演 北京强盛国际武术文化发展公司副总经理 北京影视研究所商业总监 中华社会大学电影学院荣誉导演 中国红蜻蜓集团高级顾问 中国红蜻蜓商业与文化中心总巡视员。",
  "uiIdx": "",
  "range": "3211-3250",
  "chapterUid": 10
 },
 {
  "level": 2,
  "text": "胸罩调节环制造厂的变迁",
  "uiIdx": "2",
  "range": "3676-3707",
  "chapterUid": 10
 },
 {
  "level": 3,
  "text": "厂里的工人们在夏季的懒散拖沓状况一直捱过了8月",
  "uiIdx": "2.1",
  "range": "3676-3707",
  "chapterUid": 10
 },
 {
  "level": 4,
  "text": "随着“深咖啡色”的出现，这种状况才终于烟消云散。",
  "uiIdx": "",
  "range": "3707-3731",
  "chapterUid": 10
 },
 {
  "level": 3,
  "text": "9月份，一个新客户订购了十多万只调节环，要求全部染成一种颜色",
  "uiIdx": "2.2",
  "range": "3731-3762",
  "chapterUid": 10
 },
 {
  "level": 4,
  "text": "经历了几个月的无所事事之后，小龙突然忙碌起来了。",
  "uiIdx": "",
  "range": "3762-3786",
  "chapterUid": 10
 },
 {
  "level": 3,
  "text": "还是在那个月，另外一个新买主签下了一张大订单",
  "uiIdx": "2.3",
  "range": "4051-4074",
  "chapterUid": 10
 },
 {
  "level": 4,
  "text": "现在，整个厂子里又开始运转起来了。",
  "uiIdx": "",
  "range": "4074-4091",
  "chapterUid": 10
 },
 {
  "level": 2,
  "text": "工人和老板的关系",
  "uiIdx": "3",
  "range": "4555-4580",
  "chapterUid": 10
 },
 {
  "level": 3,
  "text": "罗师傅和他的妻子程有琴在工厂工作，他们的孩子也出生在这里",
  "uiIdx": "3.1",
  "range": "4555-4580",
  "chapterUid": 10
 },
 {
  "level": 4,
  "text": "孩子出生五十天的那一天，作者邀请他们一家人出去吃饭。",
  "uiIdx": "",
  "range": "4555-4580",
  "chapterUid": 10
 },
 {
  "level": 3,
  "text": "罗师傅和王老板在工资和搬迁问题上产生了分歧",
  "uiIdx": "3.2",
  "range": "25135-25154",
  "chapterUid": 10
 },
 {
  "level": 4,
  "text": "王老板突访老陶，和他进行了第一次协商。",
  "uiIdx": "",
  "range": "25135-25154",
  "chapterUid": 10
 },
 {
  "level": 4,
  "text": "到了最后，罗师傅和老田在这场对话中所下的赌注。搬机器是一项十分浩大的工程，他们最不愿意做的事情，就是培训新手。",
  "uiIdx": "",
  "range": "36626-36703",
  "chapterUid": 10
 },
 {
  "level": 4,
  "text": "11月28日，也就是农历初八，这是鸿运当头、前程似锦的日子。早上，我一觉醒来，发现大众桑塔纳轿车的车胎瘪了。",
  "uiIdx": "",
  "range": "41055-41109",
  "chapterUid": 10
 },
 {
  "level": 4,
  "text": "下午，老陶出现了。他在那里漫不经心地站了半个小时，看着那几辆卡车装满货物。他没有走过去打个帮手：从现在起，他从这家工厂正式下岗了。",
  "uiIdx": "",
  "range": "42258-42323",
  "chapterUid": 10
 },
 {
  "level": 4,
  "text": "任静为自己做出了同样的决定。末了，她的母亲有些惊慌失措地追着女儿走到了工厂大门口，求她留下来。",
  "uiIdx": "",
  "range": "42538-42585",
  "chapterUid": 10
 },
 {
  "level": 4,
  "text": "陶家两姐妹离去的时候，谁也没有哭泣。两个女孩各自收拾了一个小箱子。走向老厂的时候，她们俩激动地交谈着，恰似上大学的美国孩子。",
  "uiIdx": "",
  "range": "43184-43246",
  "chapterUid": 10
 },
 {
  "level": 1,
  "text": "第四章",
  "uiIdx": "",
  "range": "",
  "chapterUid": 10
 },
 {
  "level": 2,
  "text": "作者在中国驾照过期后的生活变化",
  "uiIdx": "1",
  "range": "412-430",
  "chapterUid": 10
 },
 {
  "level": 3,
  "text": "作者在美国适应了新的道路行驶规程",
  "uiIdx": "1.1",
  "range": "430-455",
  "chapterUid": 10
 },
 {
  "level": 4,
  "text": "不开快车，也不从右边的路肩上超车。",
  "uiIdx": "",
  "range": "455-481",
  "chapterUid": 10
 },
 {
  "level": 4,
  "text": "手指不再摁住喇叭按钮不放。",
  "uiIdx": "",
  "range": "481-496",
  "chapterUid": 10
 },
 {
  "level": 4,
  "text": "遇到绿灯变亮时，得压制住在中国开车时迎着来车立即左转的冲动。",
  "uiIdx": "",
  "range": "496-534",
  "chapterUid": 10
 },
 {
  "level": 3,
  "text": "作者回到中国后，发现驾照还有宽限期，并顺利办理了新证",
  "uiIdx": "1.2",
  "range": "722-765",
  "chapterUid": 10
 },
 {
  "level": 4,
  "text": "填了一大堆表格后，北京市公安交通管理局便给作者颁发了新证。",
  "uiIdx": "",
  "range": "722-765",
  "chapterUid": 10
 },
 {
  "level": 2,
  "text": "作者在温州的所见所闻",
  "uiIdx": "2",
  "range": "794-824",
  "chapterUid": 10
 },
 {
  "level": 3,
  "text": "作者在温州租了一辆大众桑塔纳，发现红灯",
  "uiIdx": "2.1",
  "range": "794-824",
  "chapterUid": 10
 },
 {
  "level": 4,
  "text": "作者早已熟知昌盛汽车租赁公司周围八公里范围内所有的加油站。",
  "uiIdx": "",
  "range": "824-877",
  "chapterUid": 10
 },
 {
  "level": 3,
  "text": "作者在丽水市，看到政府开展东扩项目，计划引进高技术产业",
  "uiIdx": "2.2",
  "range": "1118-1148",
  "chapterUid": 10
 },
 {
  "level": 4,
  "text": "东扩项目将使工业区的面积扩大四倍。",
  "uiIdx": "",
  "range": "1118-1148",
  "chapterUid": 10
 },
 {
  "level": 4,
  "text": "为了完成东扩项目，他们又需要削平四百座大大小小的山头。",
  "uiIdx": "",
  "range": "1214-1248",
  "chapterUid": 10
 },
 {
  "level": 2,
  "text": "作者对胸罩调节环制造厂的观察",
  "uiIdx": "3",
  "range": "2175-2198",
  "chapterUid": 10
 },
 {
  "level": 3,
  "text": "胸罩调节环制造厂搬迁后，生意很不错",
  "uiIdx": "3.1",
  "range": "2175-2198",
  "chapterUid": 10
 },
 {
  "level": 4,
  "text": "他们的新厂址位于瓯海市，也就是温州南边的那座滩涂城市。",
  "uiIdx": "",
  "range": "2198-2225",
  "chapterUid": 10
 },
 {
  "level": 3,
  "text": "胸罩调节环制造厂面临新的竞争者",
  "uiIdx": "3.2",
  "range": "2534-2566",
  "chapterUid": 10
 },
 {
  "level": 4,
  "text": "附近的一个老板悄悄地接近了罗师傅，提出在罗师傅打算成立的新公司中占有股份。",
  "uiIdx": "",
  "range": "2534-2566",
  "chapterUid": 10
 },
 {
  "level": 4,
  "text": "这位邻居老板给清水机械制造公司下了订单，那台机器在温州地区就有了老二。",
  "uiIdx": "",
  "range": "2669-2726",
  "chapterUid": 10
 },
 {
  "level": 2,
  "text": "金融危机对中国经济的影响",
  "uiIdx": "4",
  "range": "3156-3187",
  "chapterUid": 10
 },
 {
  "level": 3,
  "text": "金融危机导致中国工业城镇感受影响，许多公司破产倒闭",
  "uiIdx": "4.1",
  "range": "3156-3187",
  "chapterUid": 10
 },
 {
  "level": 4,
  "text": "“每一天，你都会听到两三家公司破产倒闭的消息。”。",
  "uiIdx": "",
  "range": "3156-3187",
  "chapterUid": 10
 },
 {
  "level": 3,
  "text": "金融危机对中国农村的影响，政府采取应对措施",
  "uiIdx": "4.2",
  "range": "4182-4212",
  "chapterUid": 10
 },
 {
  "level": 4,
  "text": "中央政府为了应对这场金融危机，又开始了大规模的道路建设工程。",
  "uiIdx": "",
  "range": "4182-4212",
  "chapterUid": 10
 },
 {
  "level": 4,
  "text": "国务院通过一项决议，该决议如果得以实施，将会允许农民们拿自己的土地使用权进行出租或交易——不是出售。",
  "uiIdx": "",
  "range": "4411-4461",
  "chapterUid": 10
 },
 {
  "level": 4,
  "text": "国家政府还启动了一项新的项目，叫作“家用电器下乡”活动。政府给购买电冰箱、电视机、移动电话，以及其他商品的农村居民提供补贴。",
  "uiIdx": "",
  "range": "4485-4547",
  "chapterUid": 10
 },
 {
  "level": 2,
  "text": "罗守云的个人经历和转变",
  "uiIdx": "5",
  "range": "4975-4997",
  "chapterUid": 10
 },
 {
  "level": 3,
  "text": "罗守云从大师傅成长为老板，开设了自己的公司",
  "uiIdx": "5.1",
  "range": "4975-4997",
  "chapterUid": 10
 },
 {
  "level": 4,
  "text": "他跟靠不住的老板打过交道，自己也违反过合同。",
  "uiIdx": "",
  "range": "4975-4997",
  "chapterUid": 10
 },
 {
  "level": 4,
  "text": "他做过那么多胸罩调节环，晚上做梦都想着它们。",
  "uiIdx": "",
  "range": "4997-5019",
  "chapterUid": 10
 },
 {
  "level": 3,
  "text": "罗守云的公司专门做高档塑胶，生意不错",
  "uiIdx": "5.2",
  "range": "5318-5344",
  "chapterUid": 10
 },
 {
  "level": 4,
  "text": "他认得出哪是电冰箱，哪是电视机，甚至哪是汽车零部件。",
  "uiIdx": "",
  "range": "5318-5344",
  "chapterUid": 10
 },
 {
  "level": 4,
  "text": "他们把这些原材料拆散开来，把其中的塑胶进行加工，然后卖给中国的制造类公司。",
  "uiIdx": "",
  "range": "5344-5381",
  "chapterUid": 10
 },
 {
  "level": 2,
  "text": "陶氏姐妹和任静的生活变化",
  "uiIdx": "6",
  "range": "5519-5558",
  "chapterUid": 10
 },
 {
  "level": 3,
  "text": "陶氏姐妹和任静离开胸罩调节环制造厂，回到丽水",
  "uiIdx": "6.1",
  "range": "5519-5558",
  "chapterUid": 10
 },
 {
  "level": 4,
  "text": "看来，那也是老陶早就安排好的计划的一个方面：在假期到来之前，他为拿到更多的薪水进行了艰难的协商。",
  "uiIdx": "",
  "range": "5558-5606",
  "chapterUid": 10
 },
 {
  "level": 4,
  "text": "一旦奖金和红包到手，他就把几个女孩儿撤了回来。她们几个都回到了丽水，一起在一家生产烟灰缸的工厂里找了份工作。",
  "uiIdx": "",
  "range": "5606-5663",
  "chapterUid": 10
 },
 {
  "level": 3,
  "text": "玉凤在仿皮厂工作，对现状满意并计划未来",
  "uiIdx": "6.2",
  "range": "5841-5853",
  "chapterUid": 10
 },
 {
  "level": 4,
  "text": "“他们要给加班工资哦！”她说，“我每个月发九百元，如果把加班工资算进去，一般会有一千五。”。",
  "uiIdx": "",
  "range": "5841-5886",
  "chapterUid": 10
 },
 {
  "level": 4,
  "text": "她打算在仿皮厂再干上一年左右，然后用家里的积蓄做点生意，也许跟她爸爸一起做吧。",
  "uiIdx": "",
  "range": "6060-6099",
  "chapterUid": 10
 }
]