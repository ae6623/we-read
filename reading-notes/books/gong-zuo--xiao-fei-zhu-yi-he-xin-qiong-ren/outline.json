[
 {
  "level": 1,
  "text": "第一章 工作的意义：创造工作伦理",
  "uiIdx": "",
  "range": "",
  "chapterUid": 26
 },
 {
  "level": 2,
  "text": "工作伦理的定义与前提",
  "uiIdx": "1",
  "range": "489-525",
  "chapterUid": 26
 },
 {
  "level": 3,
  "text": "工作伦理本质上是一条戒律，它有两个外显的前提和两个内隐的假定",
  "uiIdx": "1.1",
  "range": "489-525",
  "chapterUid": 26
 },
 {
  "level": 4,
  "text": "第一个前提是：为了维持生活并获取快乐，每个人都必须做一些他人认同的有价值的事，并以之获取回报。",
  "uiIdx": "",
  "range": "554-601",
  "chapterUid": 26
 },
 {
  "level": 4,
  "text": "第二个前提是：安于现状，不思进取是可耻的——道义上来说愚蠢又有害。",
  "uiIdx": "",
  "range": "667-700",
  "chapterUid": 26
 },
 {
  "level": 4,
  "text": "内隐的一个假定是，绝大多数人都有能力工作，可以通过出售工作能力获取相应收益，用以维持生活。",
  "uiIdx": "",
  "range": "993-1038",
  "chapterUid": 26
 },
 {
  "level": 4,
  "text": "另一个内隐的假定是：只有公认的有价值的工作——那些可以要求薪水回报的，可以用于交易的——才会被工作伦理认同。",
  "uiIdx": "",
  "range": "1194-1248",
  "chapterUid": 26
 },
 {
  "level": 2,
  "text": "工作伦理的历史背景与影响",
  "uiIdx": "2",
  "range": "1406-1532",
  "chapterUid": 26
 },
 {
  "level": 3,
  "text": "工作伦理在工业化的早期就进入了欧洲人的视野，之后则以多种形式贯穿于整个现代化的曲折进程中",
  "uiIdx": "2.1",
  "range": "1406-1532",
  "chapterUid": 26
 },
 {
  "level": 4,
  "text": "成为政治家、哲学家和传教士们嘹亮的号角(或借口)，帮助他们不择手段地拔除其时的普遍性恶习。",
  "uiIdx": "",
  "range": "1406-1532",
  "chapterUid": 26
 },
 {
  "level": 3,
  "text": "工作伦理生来就是为了和这些危险、病态的恶习斗争，意欲将它们连根拔起，彻底摧毁",
  "uiIdx": "2.2",
  "range": "1583-1622",
  "chapterUid": 26
 },
 {
  "level": 4,
  "text": "传统的观念根深蒂固地认为人的需求是既定的，并不渴望追求更多。",
  "uiIdx": "",
  "range": "1622-1652",
  "chapterUid": 26
 },
 {
  "level": 4,
  "text": "一旦这些既定需求得到满足，“因循守旧”的工人就彻底丧失了继续工作的动力，无意赚取更多金钱。",
  "uiIdx": "",
  "range": "1652-1697",
  "chapterUid": 26
 },
 {
  "level": 2,
  "text": "工作伦理与人的关系",
  "uiIdx": "3",
  "range": "3105-3176",
  "chapterUid": 26
 },
 {
  "level": 3,
  "text": "在过去，人们通过自己设定目标、自己控制进程，获得工作的意义和动力",
  "uiIdx": "3.1",
  "range": "3105-3176",
  "chapterUid": 26
 },
 {
  "level": 4,
  "text": "但现在，他们只能被动地完成由他人设置和控制的任务，工作对他们而言失去了意义。",
  "uiIdx": "",
  "range": "3105-3176",
  "chapterUid": 26
 },
 {
  "level": 3,
  "text": "工作伦理改革运动是一场关于控制和服从的战争",
  "uiIdx": "3.2",
  "range": "3848-3876",
  "chapterUid": 26
 },
 {
  "level": 4,
  "text": "除名称以外，这是一场彻头彻尾的权力斗争，以崇高道德为名，迫使劳动者接受既不高尚，也不符合他们道德标准的生活。",
  "uiIdx": "",
  "range": "3876-3930",
  "chapterUid": 26
 },
 {
  "level": 2,
  "text": "工作伦理与生产活动的关系",
  "uiIdx": "4",
  "range": "4170-4196",
  "chapterUid": 26
 },
 {
  "level": 3,
  "text": "工作伦理把生产活动和人的需要分离开来",
  "uiIdx": "4.1",
  "range": "4170-4196",
  "chapterUid": 26
 },
 {
  "level": 4,
  "text": "这是历史上第一次，人们优先考虑“能做什么”，而非“需要做什么”。",
  "uiIdx": "",
  "range": "4196-4228",
  "chapterUid": 26
 },
 {
  "level": 3,
  "text": "工作伦理使得满足人的需要与生产活动的逻辑无关，更重要的是，与生产活动的限度无关",
  "uiIdx": "4.2",
  "range": "4228-4265",
  "chapterUid": 26
 },
 {
  "level": 4,
  "text": "这形成了一个新时代的悖论：“为增长而增长”。",
  "uiIdx": "",
  "range": "4265-4287",
  "chapterUid": 26
 },
 {
  "level": 2,
  "text": "工作伦理与道德教育的关系",
  "uiIdx": "5",
  "range": "7942-8007",
  "chapterUid": 26
 },
 {
  "level": 3,
  "text": "工作伦理是意义深远的道德教育议程中的关键项目之一",
  "uiIdx": "5.1",
  "range": "7942-8007",
  "chapterUid": 26
 },
 {
  "level": 4,
  "text": "它为思想者和行动者设定的任务，构成了后来现代化的拥趸所谓的“文明化进程”之核心。",
  "uiIdx": "",
  "range": "7942-8007",
  "chapterUid": 26
 },
 {
  "level": 3,
  "text": "工作伦理同时提供了建设性的愿景和拆除旧有习惯的方案",
  "uiIdx": "5.2",
  "range": "8036-8085",
  "chapterUid": 26
 },
 {
  "level": 4,
  "text": "它彻底否定了这场伦理改革运动的目标对象原有的生活习惯、喜好和欲望。",
  "uiIdx": "",
  "range": "8085-8118",
  "chapterUid": 26
 },
 {
  "level": 4,
  "text": "它描绘了正确的行为模式，但更重要的是质疑所有需要接受道德训练的人，质疑他们在未经教育和未经监督时所做的一切。",
  "uiIdx": "",
  "range": "8118-8172",
  "chapterUid": 26
 },
 {
  "level": 2,
  "text": "工作伦理与现代化的关系",
  "uiIdx": "6",
  "range": "17488-17512",
  "chapterUid": 26
 },
 {
  "level": 3,
  "text": "现代化体系的实现过程中，工作伦理厥功至伟",
  "uiIdx": "6.1",
  "range": "17488-17512",
  "chapterUid": 26
 },
 {
  "level": 4,
  "text": "对于现代工业社会的日常运作和持续发展而言，资本和劳动的共同参与必不可少。",
  "uiIdx": "",
  "range": "17512-17548",
  "chapterUid": 26
 },
 {
  "level": 4,
  "text": "工作伦理把这种共同参与视为所有成员(更确切地说，所有男性成员)的道德责任和使命。",
  "uiIdx": "",
  "range": "17548-17588",
  "chapterUid": 26
 },
 {
  "level": 3,
  "text": "工作伦理的推进激发了许多来自教会的布道，创作出很多道德故事，主日学校也日渐兴起，尽其所能地向年轻人灌输着正确的规则和价值观",
  "uiIdx": "6.2",
  "range": "13250-13312",
  "chapterUid": 26
 },
 {
  "level": 4,
  "text": "但是所有实际意图和目的都能归结为(正如边沁以他特有的直率和清醒的头脑所揭示的那样)：当下以及未来，工厂工人的选择大幅减少了。",
  "uiIdx": "",
  "range": "13312-13374",
  "chapterUid": 26
 },
 {
  "level": 1,
  "text": "第二章 从工作伦理到消费美学",
  "uiIdx": "",
  "range": "",
  "chapterUid": 26
 },
 {
  "level": 2,
  "text": "消费者社会的特征",
  "uiIdx": "1",
  "range": "539-585",
  "chapterUid": 26
 },
 {
  "level": 3,
  "text": "消费者社会是金钱满足欲望的桥梁，消费意味着把东西消耗殆尽",
  "uiIdx": "1.1",
  "range": "539-585",
  "chapterUid": 26
 },
 {
  "level": 4,
  "text": "消费者是消费的人，消费意味着把东西消耗殆尽：吃穿用度，或以其他方式满足自己的欲望。",
  "uiIdx": "",
  "range": "539-585",
  "chapterUid": 26
 },
 {
  "level": 4,
  "text": "我们所处的世界，绝大多数情况下，金钱是满足欲望的桥梁，所以作为一个消费者通常也意味着，占有那些注定要被消费的东西：付费购买它们，使其成为自己的专属财产，禁止其他人未经许可使用它们。",
  "uiIdx": "",
  "range": "539-675",
  "chapterUid": 26
 },
 {
  "level": 3,
  "text": "消费者社会与生产者社会的区别",
  "uiIdx": "1.2",
  "range": "1184-1219",
  "chapterUid": 26
 },
 {
  "level": 4,
  "text": "生产者社会是人们主要以生产者的身份参与其中，社会塑造其成员的方式由社会分工的需要决定。",
  "uiIdx": "",
  "range": "1184-1374",
  "chapterUid": 26
 },
 {
  "level": 4,
  "text": "消费者社会主要要求人们以消费者的能力参与其中，首先依照“消费者”角色需要塑造其成员，并期望他们具有消费的能力和意愿。",
  "uiIdx": "",
  "range": "1219-1374",
  "chapterUid": 26
 },
 {
  "level": 2,
  "text": "制造消费者",
  "uiIdx": "2",
  "range": "4336-4341",
  "chapterUid": 26
 },
 {
  "level": 3,
  "text": "消费者社会中的经济增长取决于消费者的热情和活力",
  "uiIdx": "2.1",
  "range": "4554-4637",
  "chapterUid": 26
 },
 {
  "level": 4,
  "text": "在消费者社会中，与其说经济增长取决于“国家生产力”，不如说取决于消费者的热情和活力。",
  "uiIdx": "",
  "range": "4554-4637",
  "chapterUid": 26
 },
 {
  "level": 4,
  "text": "消费取代了工作，把个人动机、社会整合和系统再生产链接在一起。",
  "uiIdx": "",
  "range": "4637-4667",
  "chapterUid": 26
 },
 {
  "level": 3,
  "text": "身份的社会认同也发生了变化，老式的职业生涯变得不再合时宜",
  "uiIdx": "2.2",
  "range": "5606-5654",
  "chapterUid": 26
 },
 {
  "level": 4,
  "text": "在工作的基础上构建终身身份，对绝大多数人来说(至少在目前，除了少数高技能、高特许职业的从业者外)是死路一条。",
  "uiIdx": "",
  "range": "5485-5544",
  "chapterUid": 26
 },
 {
  "level": 4,
  "text": "未来必然充满不确定性，如果不这样做，就等于自己放弃机会，放弃那些未来曲折命运以及难以预料的生活带来的未知的、只能模糊感觉到的利益。",
  "uiIdx": "",
  "range": "6095-6160",
  "chapterUid": 26
 },
 {
  "level": 3,
  "text": "文化潮流前赴后继地涌进浮华的公众市场，又迅速过时，变成荒唐滑稽的老古董",
  "uiIdx": "2.3",
  "range": "6189-6241",
  "chapterUid": 26
 },
 {
  "level": 4,
  "text": "因此，当前的身份最好都只是暂时的，人们只需轻轻地拥抱它们，确保一旦放手它们就消失不见，以拥抱下一个更新、更鲜艳或者未曾尝试的新身份。",
  "uiIdx": "",
  "range": "6241-6307",
  "chapterUid": 26
 },
 {
  "level": 4,
  "text": "身份是多重的：大多数人的生命旅程中可能都散布着遗失或遗弃的身份。",
  "uiIdx": "",
  "range": "6307-6345",
  "chapterUid": 26
 },
 {
  "level": 2,
  "text": "由美学评判的工作",
  "uiIdx": "3",
  "range": "7993-8001",
  "chapterUid": 26
 },
 {
  "level": 3,
  "text": "消费者彻头彻尾是一种个人的、独立的乃至孤独的活动",
  "uiIdx": "3.1",
  "range": "8200-8224",
  "chapterUid": 26
 },
 {
  "level": 4,
  "text": "这种活动通过不断地满足和唤醒、缓释和激发某种欲望实现，这种欲望通常是一种私人的、难以言表的感觉。",
  "uiIdx": "",
  "range": "8224-8272",
  "chapterUid": 26
 },
 {
  "level": 4,
  "text": "在消费过程中消费者确实可能会聚在一起，但即便如此，消费的本质仍然是一种彻头彻尾孤独的、私人的生活体验。",
  "uiIdx": "",
  "range": "8287-8338",
  "chapterUid": 26
 },
 {
  "level": 3,
  "text": "选择的自由设定了消费者社会的阶层，设定了消费者社会的成员(消费者)绘制生活理想的框架",
  "uiIdx": "3.2",
  "range": "8650-8719",
  "chapterUid": 26
 },
 {
  "level": 4,
  "text": "一个人选择的自由度越大，自由行使的选择权越多，他/她在社会阶层中的地位就越高，获得的社会尊重和自尊就越多，距离“美好生活”的理想也越近。",
  "uiIdx": "",
  "range": "8719-8787",
  "chapterUid": 26
 },
 {
  "level": 4,
  "text": "财富和收入也很重要，否则消费选择就会受到限制或被完全剥夺。",
  "uiIdx": "",
  "range": "8787-8819",
  "chapterUid": 26
 },
 {
  "level": 3,
  "text": "消费美学取代了工作伦理的统治地位",
  "uiIdx": "3.3",
  "range": "10018-10040",
  "chapterUid": 26
 },
 {
  "level": 4,
  "text": "对于合格的消费者来说，世界是一个充满可能性的巨型矩阵，包含着更强烈的感受和更深刻的体验。",
  "uiIdx": "",
  "range": "10040-10084",
  "chapterUid": 26
 },
 {
  "level": 4,
  "text": "评判世间万物的标准是激发人们感受和体验的能力——唤起欲望的能力，这是消费生活中最愉悦的阶段，比欲望得到满足更令人陶醉。",
  "uiIdx": "",
  "range": "10084-10143",
  "chapterUid": 26
 },
 {
  "level": 2,
  "text": "使命是一种特权",
  "uiIdx": "4",
  "range": "10625-10632",
  "chapterUid": 26
 },
 {
  "level": 3,
  "text": "工作伦理认为，所有工作就本身而言都是“人性化的”，不管从事者得到的是什么直接乐趣(或没有乐趣)",
  "uiIdx": "4.1",
  "range": "10833-10881",
  "chapterUid": 26
 },
 {
  "level": 4,
  "text": "尽职尽责能带来最直接、最具决定性、最充分的满足感。",
  "uiIdx": "",
  "range": "10881-10906",
  "chapterUid": 26
 },
 {
  "level": 4,
  "text": "在这个方面，所有工作都是平等的。",
  "uiIdx": "",
  "range": "10906-10922",
  "chapterUid": 26
 },
 {
  "level": 3,
  "text": "对工作的美学审视则截然不同。它强调了区别，放大了差异",
  "uiIdx": "4.2",
  "range": "11132-11145",
  "chapterUid": 26
 },
 {
  "level": 4,
  "text": "它把某些职业提升到引人入胜的程度，赋予其精致的美学内涵、真正的艺术性体验。",
  "uiIdx": "",
  "range": "11145-11182",
  "chapterUid": 26
 },
 {
  "level": 4,
  "text": "其他那些为了生计获取报酬的职业则根本没有任何价值。",
  "uiIdx": "",
  "range": "11182-11207",
  "chapterUid": 26
 },
 {
  "level": 3,
  "text": "富有成就感的工作，能够自我实现的工作，作为人生意义的工作，作为生活核心的工作，作为骄傲、自尊、荣誉和名声的源泉的工作，简而言之，具有使命感的工作，成为少数人的特权，成为精英阶层的特有标志",
  "uiIdx": "4.3",
  "range": "11264-11310",
  "chapterUid": 26
 },
 {
  "level": 4,
  "text": "其他人只能敬畏地远观、艳羡，只能通过低俗小说和肥皂剧来体验。",
  "uiIdx": "",
  "range": "12436-12466",
  "chapterUid": 26
 },
 {
  "level": 4,
  "text": "他们在实践中没有机会从事这类工作，体验这种生活。",
  "uiIdx": "",
  "range": "12466-12490",
  "chapterUid": 26
 },
 {
  "level": 2,
  "text": "消费者社会的穷人",
  "uiIdx": "5",
  "range": "14453-14461",
  "chapterUid": 26
 },
 {
  "level": 3,
  "text": "在消费者社会中，一个人无法幸福地生活，甚至无法正常地生活，就意味着他/她是失败的消费者，或者说是有缺陷的消费者",
  "uiIdx": "5.1",
  "range": "15882-15938",
  "chapterUid": 26
 },
 {
  "level": 4,
  "text": "消费者社会的穷人，被社会，也被其自身定义为有瑕疵的、有缺陷的、不完美的、先天不足的消费者。",
  "uiIdx": "",
  "range": "15938-15986",
  "chapterUid": 26
 },
 {
  "level": 3,
  "text": "贫穷并不仅限于物质匮乏和身体上的痛苦，也是一种社会和心理状况",
  "uiIdx": "5.2",
  "range": "15502-15533",
  "chapterUid": 26
 },
 {
  "level": 4,
  "text": "贫穷意味着被排除在“正常生活”之外，意味着“达不到标准”，从而导致自尊心受到打击，产生羞愧感和负罪感。",
  "uiIdx": "",
  "range": "15577-15628",
  "chapterUid": 26
 },
 {
  "level": 4,
  "text": "贫穷也意味着与既定社会的“幸福生活”无缘，无法享受“生活的馈赠”。",
  "uiIdx": "",
  "range": "15628-15661",
  "chapterUid": 26
 },
 {
  "level": 3,
  "text": "无聊是消费者社会特有的社会分层因素产生的心理学结果",
  "uiIdx": "5.3",
  "range": "18003-18032",
  "chapterUid": 26
 },
 {
  "level": 4,
  "text": "这些因素包括：选择的自由度和丰富度、流动的自由度、消除孤立和组织时间的能力。",
  "uiIdx": "",
  "range": "18032-18070",
  "chapterUid": 26
 },
 {
  "level": 4,
  "text": "在社会分层的心理学维度中，它或许是那些处于社会底层的人们最痛苦的感受，也是他们最恼怒、最抗拒的感受。",
  "uiIdx": "",
  "range": "18070-18120",
  "chapterUid": 26
 },
 {
  "level": 1,
  "text": "第三章 福利国家的兴衰",
  "uiIdx": "",
  "range": "",
  "chapterUid": 29
 },
 {
  "level": 2,
  "text": "福利国家的概念与工作伦理的关系",
  "uiIdx": "1",
  "range": "1178-1200",
  "chapterUid": 29
 },
 {
  "level": 3,
  "text": "福利国家理念责成国家机关负责落实个体需求的平等原则",
  "uiIdx": "1.1",
  "range": "1178-1200",
  "chapterUid": 29
 },
 {
  "level": 4,
  "text": "公共福利可以被看作是一种集体保险，由集体的所有成员共同承担。",
  "uiIdx": "",
  "range": "1089-1119",
  "chapterUid": 29
 },
 {
  "level": 4,
  "text": "它承诺按个体需求而非个体支付的保险金额进行补偿。",
  "uiIdx": "",
  "range": "1119-1143",
  "chapterUid": 29
 },
 {
  "level": 3,
  "text": "福利理念与工作伦理的核心理念存在两种截然相反、难以调和的联系",
  "uiIdx": "1.2",
  "range": "1263-1330",
  "chapterUid": 29
 },
 {
  "level": 4,
  "text": "一方面，福利国家能够很好地支持工作伦理，帮助它克服在持续、普遍的实践过程中遭遇的各种困难。",
  "uiIdx": "",
  "range": "1518-1584",
  "chapterUid": 29
 },
 {
  "level": 4,
  "text": "另一方面，公共福利的理念宣称，应该在任何时候都保证国家的所有公民“有权”过上体面的、有尊严的生活，即使他们对公共财富没有任何贡献。",
  "uiIdx": "",
  "range": "1613-1678",
  "chapterUid": 29
 },
 {
  "level": 2,
  "text": "福利国家的多因素决定性",
  "uiIdx": "2",
  "range": "2368-2404",
  "chapterUid": 29
 },
 {
  "level": 3,
  "text": "福利国家出现在下述压力或需要的交汇点：处于困境的资本主义经济，无法在缺失政治帮助的状态下只依靠自己的力量生存；有组织的劳工，无法在缺失政治帮助的状态下确保自己不受“经济周期”的影响；通过减轻最令人不能忍受的社会不平等来保护和重申社会不平等原则；通过边缘化无法参与再生产的人来刺激社会接受不平等；以及帮助社会成员安然度过不受政治控制的经济冲击",
  "uiIdx": "2.1",
  "range": "2368-2404",
  "chapterUid": 29
 },
 {
  "level": 4,
  "text": "所有这些强大的、异质的驱动力汇聚在一起，诞生于(工业化的、资本主义的、市场化的、民主的)现代社会某个高级阶段的福利国家，确实是“多因素决定的”。",
  "uiIdx": "",
  "range": "2513-2585",
  "chapterUid": 29
 },
 {
  "level": 2,
  "text": "服务大众，还是服务特定人群",
  "uiIdx": "3",
  "range": "3676-3689",
  "chapterUid": 29
 },
 {
  "level": 3,
  "text": "贝弗里奇把自己全面施行福利国家的蓝图视作自由主义美好社会理念的合理又必然的实践",
  "uiIdx": "3.1",
  "range": "4006-4088",
  "chapterUid": 29
 },
 {
  "level": 4,
  "text": "贝弗里奇认为，平等享有一切基本的自由是“自由主义的终极目标……我们可以，也应该利用社会的组织力量增加个体的权利。”。",
  "uiIdx": "",
  "range": "4088-4142",
  "chapterUid": 29
 },
 {
  "level": 3,
  "text": "贝弗里奇的设想几乎得到了普遍好评，可能有极少数人对加诸于己的财务成本担忧，但事实上没有人抱怨“负担不起”",
  "uiIdx": "3.2",
  "range": "5594-5622",
  "chapterUid": 29
 },
 {
  "level": 4,
  "text": "阿兰·迪肯(Alan Deacon)和乔纳森·布拉德肖(Jonathan Bradshaw)在他们关于经济审查历史的著名作品中指出，贝弗里奇的报告正是因为主张废除经济状况调查，才会“受到广泛的欢迎”。",
  "uiIdx": "",
  "range": "5594-5622",
  "chapterUid": 29
 },
 {
  "level": 2,
  "text": "福利国家的衰败",
  "uiIdx": "4",
  "range": "8233-8240",
  "chapterUid": 29
 },
 {
  "level": 3,
  "text": "今天福利国家的溃败，曾经满怀热情的支持者的快速消失，以及公众对于削减、取消福利供应，甚至摒弃福利国家看似不可动摇的原则的冷漠，都暗示着一种类似的“多因素决定性”",
  "uiIdx": "4.1",
  "range": "8875-8956",
  "chapterUid": 29
 },
 {
  "level": 4,
  "text": "用人们意识形态的转变，或新自由主义、货币主义、新保守主义的流行来解释福利国家的今非昔比，无异于本末倒置。",
  "uiIdx": "",
  "range": "8956-9008",
  "chapterUid": 29
 },
 {
  "level": 3,
  "text": "资本主义再生产的逻辑是，把消费者欲望作为主要的社会动员和整合力量，作为解决冲突和秩序维持的主要手段，从长远来看，这会使“劳动力成本过高”",
  "uiIdx": "4.2",
  "range": "11832-11901",
  "chapterUid": 29
 },
 {
  "level": 4,
  "text": "那些被资本主义生产方式耕耘过的连绵土地迟早都会枯竭，成为收益递减规律的牺牲品。",
  "uiIdx": "",
  "range": "11901-11940",
  "chapterUid": 29
 },
 {
  "level": 4,
  "text": "为了保持生产利润，必须寻找新的未耕耘土地。",
  "uiIdx": "",
  "range": "11940-11961",
  "chapterUid": 29
 },
 {
  "level": 2,
  "text": "心满意足的大多数",
  "uiIdx": "5",
  "range": "13314-13322",
  "chapterUid": 29
 },
 {
  "level": 3,
  "text": "近二十年来政治历程似乎否定了上面的推论。在一个又一个国家，大多数选民都支持那些明确要求削减福利的政党，或那些承诺降低个人税赋(最终也会导致福利的削减)的政党",
  "uiIdx": "5.1",
  "range": "13352-13373",
  "chapterUid": 29
 },
 {
  "level": 4,
  "text": "“增税”已经成为政客最禁忌、选民最憎恶的词语。",
  "uiIdx": "",
  "range": "13432-13455",
  "chapterUid": 29
 },
 {
  "level": 3,
  "text": "中间选民似乎非常确信，由自己管理自己的事务会更好",
  "uiIdx": "5.2",
  "range": "14765-14793",
  "chapterUid": 29
 },
 {
  "level": 4,
  "text": "他们仍然需要保险以对抗厄运和其他意外，因为他们对这些风险的控制能力并不比他们的父辈更强。",
  "uiIdx": "",
  "range": "14793-14837",
  "chapterUid": 29
 },
 {
  "level": 4,
  "text": "但是，他们认为，相对于质量低劣的国家保险而言，能够负担的私人保险会提供更多、更好的福利。",
  "uiIdx": "",
  "range": "14837-14881",
  "chapterUid": 29
 },
 {
  "level": 2,
  "text": "招致毁灭的成功",
  "uiIdx": "6",
  "range": "18016-18023",
  "chapterUid": 29
 },
 {
  "level": 3,
  "text": "“平权法案”实现了一个类似于福利国家奠基人为福利国家设定目标：它“自己完结自己的工作”",
  "uiIdx": "6.1",
  "range": "19235-19456",
  "chapterUid": 29
 },
 {
  "level": 4,
  "text": "如果没有“平权法案”，这一切会发生吗？根据纽约大学法学院最近完成的研究，在3435名非裔法律系学生(他们因此有机会进入美国最赚钱的行业之一)中，只有687人能只凭考试成绩进入该校。",
  "uiIdx": "",
  "range": "19135-19206",
  "chapterUid": 29
 },
 {
  "level": 3,
  "text": "受益于“平权法案”的照顾，一个新的、自信的非裔中产阶级已经诞生",
  "uiIdx": "6.2",
  "range": "19488-19520",
  "chapterUid": 29
 },
 {
  "level": 4,
  "text": "但是，这些受益者们不愿承认，他们之所以能有今天的地位，并不是因为他们像其他美国人一样发挥了自己的智慧和勤奋，而是因为得到了帮助。",
  "uiIdx": "",
  "range": "19520-19584",
  "chapterUid": 29
 },
 {
  "level": 4,
  "text": "他们大声又明确地宣布，如果他们“做到了”，那么其他人也能做到，如果有人做不到，一定是因为他/她不够努力。",
  "uiIdx": "",
  "range": "19600-19652",
  "chapterUid": 29
 },
 {
  "level": 1,
  "text": "第四章 工作伦理和新穷人",
  "uiIdx": "",
  "range": "",
  "chapterUid": 29
 },
 {
  "level": 2,
  "text": "工作伦理的变迁与影响",
  "uiIdx": "1",
  "range": "477-503",
  "chapterUid": 29
 },
 {
  "level": 3,
  "text": "工作伦理在19世纪初的传道者清楚他们在宣扬什么",
  "uiIdx": "1.1",
  "range": "477-503",
  "chapterUid": 29
 },
 {
  "level": 4,
  "text": "当时，劳动是财富的唯一来源，生产更多的东西基本等同于让更多的人参与生产过程。",
  "uiIdx": "",
  "range": "503-541",
  "chapterUid": 29
 },
 {
  "level": 3,
  "text": "20世纪末，工作伦理再次成为公众的焦点，它在诊治时弊的过程中作用明显",
  "uiIdx": "1.2",
  "range": "669-704",
  "chapterUid": 29
 },
 {
  "level": 4,
  "text": "在美国“以工代赈”计划中，工作伦理尤为引人注目。",
  "uiIdx": "",
  "range": "704-729",
  "chapterUid": 29
 },
 {
  "level": 2,
  "text": "“常规劳动者”的现状与困境",
  "uiIdx": "2",
  "range": "2592-2630",
  "chapterUid": 29
 },
 {
  "level": 3,
  "text": "“常规劳动者”在出售劳动力时面临的困难最小，他们的潜在买家并不会特别挑剔",
  "uiIdx": "2.1",
  "range": "2592-2630",
  "chapterUid": 29
 },
 {
  "level": 4,
  "text": "“常规劳动者”从事的工作既不需要难以掌握的稀有技能，也不需要面对面与顾客沟通所需的特殊机敏，因此他们可以比较容易地在所有有偿的低技能工作中切换。",
  "uiIdx": "",
  "range": "2630-2702",
  "chapterUid": 29
 },
 {
  "level": 3,
  "text": "“常规劳动者”也很容易被弃用，工作不稳定",
  "uiIdx": "2.2",
  "range": "2702-2727",
  "chapterUid": 29
 },
 {
  "level": 4,
  "text": "他们随时可能被替换，这不会给雇主带来什么损失。他们可能在生意不景气时被就地解雇，因为业务回暖时有很多这样的人随时可以上岗。",
  "uiIdx": "",
  "range": "2727-2788",
  "chapterUid": 29
 },
 {
  "level": 2,
  "text": "“底层阶级”的浮现与特征",
  "uiIdx": "3",
  "range": "10179-10188",
  "chapterUid": 29
 },
 {
  "level": 3,
  "text": "“底层阶级”指的是那些被排除在阶级体系之外的人，他们没任何机会，也无法被重新接纳",
  "uiIdx": "3.1",
  "range": "10559-10602",
  "chapterUid": 29
 },
 {
  "level": 4,
  "text": "他们没有容身之所，对社会没有任何有益的贡献，原则上不值得救赎。",
  "uiIdx": "",
  "range": "10602-10633",
  "chapterUid": 29
 },
 {
  "level": 3,
  "text": "底层阶级的无用性和危险性为社会提供了一种重要价值",
  "uiIdx": "3.2",
  "range": "12418-12474",
  "chapterUid": 29
 },
 {
  "level": 4,
  "text": "这个社会中没有一个行业或职业能够确信自己的长期有用性。",
  "uiIdx": "",
  "range": "12418-12474",
  "chapterUid": 29
 },
 {
  "level": 4,
  "text": "这个社会被太多焦虑困扰，人们根本无法分辨究竟在恐惧什么，如何减缓这种恐惧。",
  "uiIdx": "",
  "range": "12474-12536",
  "chapterUid": 29
 },
 {
  "level": 2,
  "text": "用于底层阶级的工作伦理",
  "uiIdx": "4",
  "range": "13176-13187",
  "chapterUid": 29
 },
 {
  "level": 3,
  "text": "工作伦理被用来洗涤社会中正常人的双手和良知，帮他们从抛弃同胞致使同胞永久失业的罪责中摆脱出来",
  "uiIdx": "4.1",
  "range": "19612-19697",
  "chapterUid": 29
 },
 {
  "level": 4,
  "text": "在对穷人的道德进行谴责的同时，对非穷人的道德实施赦免，通过这种双管齐下的方法，达到双手和良心的洁净。",
  "uiIdx": "",
  "range": "19697-19747",
  "chapterUid": 29
 },
 {
  "level": 2,
  "text": "贫穷即犯罪",
  "uiIdx": "5",
  "range": "19801-19806",
  "chapterUid": 29
 },
 {
  "level": 3,
  "text": "贫困从社会政策的问题变成了刑法学和典狱学问题",
  "uiIdx": "5.1",
  "range": "24748-24771",
  "chapterUid": 29
 },
 {
  "level": 4,
  "text": "穷人不再是消费者社会的弃儿，他们在全面的竞争中败下阵来，彻头彻尾地成为社会的公敌。",
  "uiIdx": "",
  "range": "24771-24812",
  "chapterUid": 29
 },
 {
  "level": 2,
  "text": "逐出道德义务的世界",
  "uiIdx": "6",
  "range": "24935-24944",
  "chapterUid": 29
 },
 {
  "level": 3,
  "text": "把贫穷与犯罪联系起来还有另一个作用：把穷人从道德义务的世界中驱逐出去",
  "uiIdx": "6.1",
  "range": "24974-25009",
  "chapterUid": 29
 },
 {
  "level": 4,
  "text": "道德的本质是为弱者、不幸的人、受苦难的人谋求福祉的责任冲动，给贫穷定罪可以消除和减弱这种冲动。",
  "uiIdx": "",
  "range": "25038-25085",
  "chapterUid": 29
 },
 {
  "level": 1,
  "text": "第五章 全球化之下的工作与过剩",
  "uiIdx": "",
  "range": "",
  "chapterUid": 29
 },
 {
  "level": 2,
  "text": "现代化与现代性的区别",
  "uiIdx": "1",
  "range": "659-705",
  "chapterUid": 29
 },
 {
  "level": 3,
  "text": "现代化是对世界和人们生活方式的一种难以抑制、令人上瘾的“重塑”，是“现代生活方式”的同义词",
  "uiIdx": "1.1",
  "range": "659-705",
  "chapterUid": 29
 },
 {
  "level": 4,
  "text": "现代化不应该被解释为“通往现代性(modernity)之路”。",
  "uiIdx": "",
  "range": "563-594",
  "chapterUid": 29
 },
 {
  "level": 4,
  "text": "一旦现代化停止，现代性也随之消亡。",
  "uiIdx": "",
  "range": "636-659",
  "chapterUid": 29
 },
 {
  "level": 3,
  "text": "永久和持续的现代化是现代性的基本特征",
  "uiIdx": "1.2",
  "range": "705-748",
  "chapterUid": 29
 },
 {
  "level": 4,
  "text": "这种生存方式使它有别于其他(传统主义)生存方式。",
  "uiIdx": "",
  "range": "705-748",
  "chapterUid": 29
 },
 {
  "level": 4,
  "text": "那些生存方式大体上主要致力于社会的持续再生产，最好形式上不要发生任何变化。",
  "uiIdx": "",
  "range": "748-785",
  "chapterUid": 29
 },
 {
  "level": 2,
  "text": "资本主导的现代化逻辑",
  "uiIdx": "2",
  "range": "1094-1176",
  "chapterUid": 29
 },
 {
  "level": 3,
  "text": "资本主义初期，其动力来自征服并殖民“未开发土地”",
  "uiIdx": "2.1",
  "range": "1094-1176",
  "chapterUid": 29
 },
 {
  "level": 4,
  "text": "把生产者和生产资料分离，把商业活动和家庭经济分离，从而把非现代化的生活带入市场经济的轨道，并将其变成资本的牧场。",
  "uiIdx": "",
  "range": "1094-1176",
  "chapterUid": 29
 },
 {
  "level": 3,
  "text": "一旦这项工作完成，现代资本主义社会的进一步生存就取决于把已经现代化的部分进一步现代化",
  "uiIdx": "2.2",
  "range": "1176-1236",
  "chapterUid": 29
 },
 {
  "level": 4,
  "text": "这个过程最近被封装在“资产剥离”(asset stripping)这个新潮的概念里。",
  "uiIdx": "",
  "range": "1236-1278",
  "chapterUid": 29
 },
 {
  "level": 2,
  "text": "殖民主义，还是剩余劳动力输出",
  "uiIdx": "3",
  "range": "2582-2596",
  "chapterUid": 29
 },
 {
  "level": 3,
  "text": "在托恩的案例中，劳动力市场的过度拥挤被归咎于农业技术进步导致的小农破产和衰败",
  "uiIdx": "3.1",
  "range": "3004-3043",
  "chapterUid": 29
 },
 {
  "level": 4,
  "text": "通过大规模驱逐过剩人口，把本地产生的“社会问题”输出到远方的另一个原因，是担心拥挤在城市里“过剩的人”成为不安定因素。",
  "uiIdx": "",
  "range": "3921-3980",
  "chapterUid": 29
 },
 {
  "level": 3,
  "text": "移民是由多种元素决定的",
  "uiIdx": "3.2",
  "range": "4518-4530",
  "chapterUid": 29
 },
 {
  "level": 4,
  "text": "一方面，过剩人口无法在自己的国家找到有报酬的工作，或无法维持既有或继承的社会地位，这通常出现在先进的现代化进程主导的地区。",
  "uiIdx": "",
  "range": "4530-4591",
  "chapterUid": 29
 },
 {
  "level": 4,
  "text": "另一方面，同样因为快速的现代化，产生了过剩人口的国家(即使是暂时的)在技术和军事上优越于那些尚未开始现代化进程的国家。",
  "uiIdx": "",
  "range": "4591-4650",
  "chapterUid": 29
 },
 {
  "level": 2,
  "text": "解决本土问题的全球化策略之兴衰",
  "uiIdx": "4",
  "range": "6176-6191",
  "chapterUid": 29
 },
 {
  "level": 3,
  "text": "“地球已经满负荷”是社会学和政治学的论断",
  "uiIdx": "4.1",
  "range": "6508-6529",
  "chapterUid": 29
 },
 {
  "level": 4,
  "text": "它标志着“无人区”的消失，标志着能够被界定或被视为无人居住、没有主权管辖的土地的消失，标志着可以作为殖民地的土地的消失。",
  "uiIdx": "",
  "range": "6556-6616",
  "chapterUid": 29
 },
 {
  "level": 3,
  "text": "清除和处理全球“现代化”过程中产生的“废弃人口”，是殖民主义和帝国主义征服的最深层意义",
  "uiIdx": "4.2",
  "range": "7093-7137",
  "chapterUid": 29
 },
 {
  "level": 4,
  "text": "这两个过程都是因为发展水平严重不平衡力量差距持续拉大的必然结果，这也导致现代生活模式被限制于一个相对较小的“特权”区域。",
  "uiIdx": "",
  "range": "7137-7197",
  "chapterUid": 29
 },
 {
  "level": 4,
  "text": "只要现代性(即永不停歇、引人入胜、使人沉迷的现代化)仍然是一种区域“特权”，这种情况就将持续下去。",
  "uiIdx": "",
  "range": "7258-7307",
  "chapterUid": 29
 },
 {
  "level": 4,
  "text": "一旦现代性如人们所望，艰难地挣脱束缚成为全人类普遍的福祉，它在这个星球上的统治影响力也就走到尽头。",
  "uiIdx": "",
  "range": "7307-7356",
  "chapterUid": 29
 },
 {
  "level": 2,
  "text": "工作和贫穷问题的全球化新维度",
  "uiIdx": "5",
  "range": "8363-8377",
  "chapterUid": 29
 },
 {
  "level": 3,
  "text": "远方的人遭受苦难的直接或间接源头，或许正是我们此时此地的所作所为",
  "uiIdx": "5.1",
  "range": "8530-8610",
  "chapterUid": 29
 },
 {
  "level": 4,
  "text": "由于距离遥远，它们并不会引起道德上的共鸣，也不会像身边所见的苦难那样能够引发强烈的行动意愿。",
  "uiIdx": "",
  "range": "8530-8610",
  "chapterUid": 29
 },
 {
  "level": 4,
  "text": "富人和他们雇佣或解雇的穷人之间的鸿沟会持续扩大，世界上收入位居前20%的收入总和已经是位居后20%的收入总和的114倍。",
  "uiIdx": "",
  "range": "8610-8670",
  "chapterUid": 29
 },
 {
  "level": 3,
  "text": "现代化席卷全球，于是现代生活方式也遍布全球",
  "uiIdx": "5.2",
  "range": "9953-9975",
  "chapterUid": 29
 },
 {
  "level": 4,
  "text": "新的“地球饱和”产生了两个直接的后果。",
  "uiIdx": "",
  "range": "9975-9994",
  "chapterUid": 29
 },
 {
  "level": 4,
  "text": "对于这两个后果，我们曾简要地指出，但它们值得更多的关注。",
  "uiIdx": "",
  "range": "9994-10022",
  "chapterUid": 29
 },
 {
  "level": 2,
  "text": "社会问题转为法律和秩序问题",
  "uiIdx": "6",
  "range": "11621-11634",
  "chapterUid": 29
 },
 {
  "level": 3,
  "text": "华康德(Loic Wacquant)提出一个悖论：过去那些致力于争取减少国家干预，以解放资本及其对于劳动力的使用，并取得显著成功的人，今天却在拼命要求增加国家干预，以遏制放松就业状态管制和落后区域社会保护恶化造成的恶果",
  "uiIdx": "6.1",
  "range": "11664-11689",
  "chapterUid": 29
 },
 {
  "level": 4,
  "text": "这种明显的心理变化严格符合从回收利用“废弃人口”到弃置“废弃人口”这个逻辑过程。",
  "uiIdx": "",
  "range": "11975-12015",
  "chapterUid": 29
 },
 {
  "level": 3,
  "text": "社会国家正在逐步地，不可逆转地变成亨利·吉鲁(Henry A. Giroux)所说的“卫戍型国家”(garrison state)",
  "uiIdx": "6.2",
  "range": "12441-12677",
  "chapterUid": 29
 },
 {
  "level": 4,
  "text": "监狱被指派到这场战争的前线。",
  "uiIdx": "",
  "range": "14599-14647",
  "chapterUid": 29
 },
 {
  "level": 4,
  "text": "所有的废弃物都有潜在的毒性，或者，被定义为废弃物就是被认为具有污染性，是潜藏的炸弹，总是会扰乱正常秩序。",
  "uiIdx": "",
  "range": "14647-14699",
  "chapterUid": 29
 },
 {
  "level": 4,
  "text": "如果回收利用无利可图，回收方案(无论如何在现今的环境下)也不再现实，那么处理废弃物的正确方法就是加快其“生物降解”，同时尽可能安全地将其与普通人的居住环境隔离。",
  "uiIdx": "",
  "range": "14699-14779",
  "chapterUid": 29
 },
 {
  "level": 2,
  "text": "从社会国家到“安全国家”",
  "uiIdx": "7",
  "range": "15445-15457",
  "chapterUid": 29
 },
 {
  "level": 3,
  "text": "“社会国家”(social state)是欧洲民主历史长河的最高成就，直到最近仍占据着主导地位，但今天却在逐渐衰退",
  "uiIdx": "7.1",
  "range": "15487-15545",
  "chapterUid": 29
 },
 {
  "level": 4,
  "text": "社会国家将其合法性，以及公民效忠国家、服从国家的合理性，建立在以下的承诺上：保护自己的公民，保护他们豁免于“过剩”、不被排斥、不被拒绝，帮助他们对抗命运的冲击——不因个人不足或不幸而沦为“废弃人口”。",
  "uiIdx": "",
  "range": "15574-15674",
  "chapterUid": 29
 },
 {
  "level": 3,
  "text": "人们每天都身处市场造就的切实不安全感之中，政治力量对这种不安全感无能为力，只能听之任之",
  "uiIdx": "7.2",
  "range": "16298-16342",
  "chapterUid": 29
 },
 {
  "level": 4,
  "text": "“被包围的城堡”的心态，个人身心安全和私人财产无时不处于威胁之中的心态，是可以积极培养的。",
  "uiIdx": "",
  "range": "16342-16390",
  "chapterUid": 29
 },
 {
  "level": 4,
  "text": "威胁必须被渲染上最邪恶的色彩，这样一来，无形的不可预测的威胁，就可以作为一个非常事件展现在惊慌失措的公众面前，当然更重要的是让他们认识到国家机关应对这些威胁的卓越能力、警惕性和良好意愿。",
  "uiIdx": "",
  "range": "16342-16483",
  "chapterUid": 29
 },
 {
  "level": 3,
  "text": "难怪许多面临同样局面的政府都把目光转向美国，抱有共同的期待，认为美国的政策是一个可借鉴的有效榜样",
  "uiIdx": "7.3",
  "range": "16791-16840",
  "chapterUid": 29
 },
 {
  "level": 4,
  "text": "表面的意见分歧之下，各国政府之间似乎存在着真正的“思想联盟”。",
  "uiIdx": "",
  "range": "16840-16871",
  "chapterUid": 29
 },
 {
  "level": 4,
  "text": "这完全不能归结为一时的利益一致，而是不同国家的掌权者就一个共用的合法化政策达成了不成文的默契。",
  "uiIdx": "",
  "range": "16871-16918",
  "chapterUid": 29
 },
 {
  "level": 1,
  "text": "第六章 新穷人的前景",
  "uiIdx": "",
  "range": "",
  "chapterUid": 33
 },
 {
  "level": 2,
  "text": "秩序和规范的定义与影响",
  "uiIdx": "1",
  "range": "1733-1764",
  "chapterUid": 33
 },
 {
  "level": 3,
  "text": "秩序是“对秩序的渴望”，是强烈厌世的借口",
  "uiIdx": "1.1",
  "range": "1733-1764",
  "chapterUid": 33
 },
 {
  "level": 4,
  "text": "渴望把人类世界变成一个无机的世界，在那里一切都完美运行，按部就班，服从于一个超越个体的系统。",
  "uiIdx": "",
  "range": "1655-1701",
  "chapterUid": 33
 },
 {
  "level": 4,
  "text": "对秩序的渴望未必源于厌世，却会促进厌世，因为它为厌世支配的所有行为提供了一个借口。",
  "uiIdx": "",
  "range": "1733-1838",
  "chapterUid": 33
 },
 {
  "level": 3,
  "text": "规范是秩序模式在人类行为上的投影，认定了某些行为是正常的，除此之外的其他行为则不正常",
  "uiIdx": "1.2",
  "range": "2427-2444",
  "chapterUid": 33
 },
 {
  "level": 4,
  "text": "规范告诉人们，在一个秩序井然的社会中，有秩序的行为意味着什么。",
  "uiIdx": "",
  "range": "2444-2475",
  "chapterUid": 33
 },
 {
  "level": 4,
  "text": "一旦确定了秩序，也就限定了可选的行为模式。",
  "uiIdx": "",
  "range": "2520-2541",
  "chapterUid": 33
 },
 {
  "level": 3,
  "text": "秩序和规范暗示的“应该”变成了“必须”，忽略了大量的人类现实",
  "uiIdx": "1.3",
  "range": "3013-3047",
  "chapterUid": 33
 },
 {
  "level": 4,
  "text": "秩序和规范旗帜鲜明地宣告，不是所有现存事物都可以被包含在这个公设的、正常运作的集合体中，也不是每个选择都被许可。",
  "uiIdx": "",
  "range": "3085-3141",
  "chapterUid": 33
 },
 {
  "level": 4,
  "text": "它们通过关注“不恰当的”来推行“恰当的”，把现实中那些被剥夺了生存权且注定被孤立、放逐和灭绝的部分挑选出来，加以限制和污名化。",
  "uiIdx": "",
  "range": "3184-3247",
  "chapterUid": 33
 },
 {
  "level": 2,
  "text": "失去位置的穷人",
  "uiIdx": "2",
  "range": "4460-4467",
  "chapterUid": 33
 },
 {
  "level": 3,
  "text": "每个社会都有穷人，穷人成为“不合适”和“不正常”的典型和原型",
  "uiIdx": "2.1",
  "range": "4607-4631",
  "chapterUid": 33
 },
 {
  "level": 4,
  "text": "当某种特定的人存于世的模式被提升到规范的地位，其他的选项就会被降格到低于标准或不正常的范畴。",
  "uiIdx": "",
  "range": "4561-4607",
  "chapterUid": 33
 },
 {
  "level": 3,
  "text": "穷人受到社会两种矛盾态度：恐惧和反感，怜悯和同情",
  "uiIdx": "2.2",
  "range": "4660-4704",
  "chapterUid": 33
 },
 {
  "level": 4,
  "text": "前者允许在需要秩序维护的时候对穷人进行严厉的处理。",
  "uiIdx": "",
  "range": "4715-4740",
  "chapterUid": 33
 },
 {
  "level": 4,
  "text": "后者强调了那些达不到标准的人的悲惨命运，由此让正常生活的人在遵守社会规范时遭遇的所有艰辛都变得微不足道。",
  "uiIdx": "",
  "range": "4740-4792",
  "chapterUid": 33
 },
 {
  "level": 2,
  "text": "没有位置，没有道德义务",
  "uiIdx": "3",
  "range": "9426-9437",
  "chapterUid": 33
 },
 {
  "level": 3,
  "text": "在消费者构成的世界里没有福利国家的空间",
  "uiIdx": "3.1",
  "range": "9467-9487",
  "chapterUid": 33
 },
 {
  "level": 4,
  "text": "这个工业社会的遗留看上去就是一个“保姆国家”，宠爱懒惰的人，溺爱邪恶的人，教唆堕落的人。",
  "uiIdx": "",
  "range": "9487-9531",
  "chapterUid": 33
 },
 {
  "level": 3,
  "text": "福利国家的全面衰退也就不足为奇",
  "uiIdx": "3.2",
  "range": "9910-9929",
  "chapterUid": 33
 },
 {
  "level": 4,
  "text": "只有极少数国家的福利体系还完好无损，或者说去福利国家的进程较为缓慢。",
  "uiIdx": "",
  "range": "9929-9963",
  "chapterUid": 33
 },
 {
  "level": 4,
  "text": "这些国家受到当下主流经济体的指责和嘲笑，认为它们轻率、守旧。",
  "uiIdx": "",
  "range": "9963-9993",
  "chapterUid": 33
 },
 {
  "level": 2,
  "text": "工作伦理，还是生活道德",
  "uiIdx": "4",
  "range": "14107-14118",
  "chapterUid": 33
 },
 {
  "level": 3,
  "text": "我们的世界没有能力凝聚必要的意志和决心，去实践一个完全不一样的世界",
  "uiIdx": "4.1",
  "range": "14295-14330",
  "chapterUid": 33
 },
 {
  "level": 4,
  "text": "“不切实际”这种不屑一顾的态度，在当前的政治冲突中比比皆是，正是缺乏意志和决心的真实写照。",
  "uiIdx": "",
  "range": "14330-14375",
  "chapterUid": 33
 },
 {
  "level": 3,
  "text": "以工艺伦理取代劳动力市场发展过程中形成的工作伦理",
  "uiIdx": "4.2",
  "range": "17641-17716",
  "chapterUid": 33
 },
 {
  "level": 4,
  "text": "托斯丹·凡勃伦早就指明，“工艺本能”有别于工作伦理这个现代发明，是人类的自然倾向。",
  "uiIdx": "",
  "range": "17716-17757",
  "chapterUid": 33
 },
 {
  "level": 4,
  "text": "工艺伦理将恢复人类本能的尊严，恢复社会公认的意义。",
  "uiIdx": "",
  "range": "17847-17872",
  "chapterUid": 33
 },
 {
  "level": 4,
  "text": "现代资本主义社会形成且根深蒂固的工作伦理却否认了这种尊严和意义。",
  "uiIdx": "",
  "range": "17872-17904",
  "chapterUid": 33
 }
]