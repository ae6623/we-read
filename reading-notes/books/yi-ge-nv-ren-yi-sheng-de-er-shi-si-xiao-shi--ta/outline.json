[
 {
  "level": 1,
  "text": "1",
  "uiIdx": "",
  "range": "",
  "chapterUid": 2,
  "display": "版权信息 · 1 · 争论的起因和过程"
 },
 {
  "level": 2,
  "text": "争论的起因和过程",
  "uiIdx": "1",
  "range": "1181-1241",
  "chapterUid": 2
 },
 {
  "level": 3,
  "text": "争论由一场激烈的言语纷争引发，逐渐升级为粗暴争执，甚至快要演变为互相羞辱谩骂",
  "uiIdx": "1.1",
  "range": "1181-1241",
  "chapterUid": 2
 },
 {
  "level": 4,
  "text": "大多数人其实都缺乏想象力，唯有那些直接攫住他们感官、如楔子般猛然楔入心灵的刺激，方能激起他们内心一丝波澜。",
  "uiIdx": "",
  "range": "1254-1294",
  "chapterUid": 2
 },
 {
  "level": 4,
  "text": "面对那些稍显遥远、不够迫切的事物，他们便如隔雾观火，漠不关心。",
  "uiIdx": "",
  "range": "1294-1325",
  "chapterUid": 2
 },
 {
  "level": 3,
  "text": "争论的核心是饭店里发生了一起桃色风波",
  "uiIdx": "1.2",
  "range": "1942-1968",
  "chapterUid": 2
 },
 {
  "level": 4,
  "text": "这桩风波的开端，是当天中午十二点二十分：一位年轻的法国人随车抵达，入住了临海客房。",
  "uiIdx": "",
  "range": "1968-2047",
  "chapterUid": 2
 },
 {
  "level": 4,
  "text": "他路过时，总会以谦和又真诚的方式向每一个人打招呼。",
  "uiIdx": "",
  "range": "2352-2377",
  "chapterUid": 2
 },
 {
  "level": 4,
  "text": "他仿佛是命运格外眷顾的人物。他深知，自己凭借明朗的面庞与青春的魅力，能为他人带来愉悦。",
  "uiIdx": "",
  "range": "2472-2520",
  "chapterUid": 2
 },
 {
  "level": 4,
  "text": "他的出现，对那家大多住着年老体弱宾客的饭店而言，无异于一股春风。",
  "uiIdx": "",
  "range": "2550-2640",
  "chapterUid": 2
 },
 {
  "level": 2,
  "text": "亨丽埃特夫人私奔事件的影响",
  "uiIdx": "2",
  "range": "4642-4728",
  "chapterUid": 2
 },
 {
  "level": 3,
  "text": "亨丽埃特夫人与那位年轻的法国人私奔，引起了极大的震动",
  "uiIdx": "2.1",
  "range": "4642-4728",
  "chapterUid": 2
 },
 {
  "level": 4,
  "text": "亨丽埃特夫人并非独自离开，而是与那位年轻的法国人一同私奔而去了。",
  "uiIdx": "",
  "range": "4642-4728",
  "chapterUid": 2
 },
 {
  "level": 4,
  "text": "而这位法国人先前赢得的普遍好感，此刻也正急剧褪色。",
  "uiIdx": "",
  "range": "4728-4753",
  "chapterUid": 2
 },
 {
  "level": 3,
  "text": "人们对亨丽埃特夫人的行为进行了激烈的评判",
  "uiIdx": "2.2",
  "range": "5273-5514",
  "chapterUid": 2
 },
 {
  "level": 4,
  "text": "大家一致认定，亨丽埃特夫人早已与那年轻人暗通款曲，而这位“吹笛人”此番不过是为敲定私奔的最后细节而来罢了。",
  "uiIdx": "",
  "range": "5273-5514",
  "chapterUid": 2
 },
 {
  "level": 4,
  "text": "因为，众人断言：一个正派的女人，绝不可能在短短两小时的认识之后，就随着一个陌生人一走了之。",
  "uiIdx": "",
  "range": "5514-5559",
  "chapterUid": 2
 },
 {
  "level": 2,
  "text": "作者对亨丽埃特夫人的辩护",
  "uiIdx": "3",
  "range": "8400-8422",
  "chapterUid": 2
 },
 {
  "level": 3,
  "text": "作者认为亨丽埃特夫人的行为是愚蠢但绝非卑鄙可鄙的",
  "uiIdx": "3.1",
  "range": "8400-8422",
  "chapterUid": 2
 },
 {
  "level": 4,
  "text": "她敢于遵从自己的内心。",
  "uiIdx": "",
  "range": "8329-8356",
  "chapterUid": 2
 },
 {
  "level": 4,
  "text": "她将在明天，甚至可能就在今天，就将深深陷入痛苦与悔恨之中。",
  "uiIdx": "",
  "range": "8356-8400",
  "chapterUid": 2
 },
 {
  "level": 3,
  "text": "作者坚称任何人都没有资格鄙视亨丽埃特夫人",
  "uiIdx": "3.2",
  "range": "6395-6474",
  "chapterUid": 2
 },
 {
  "level": 4,
  "text": "作者对亨丽埃特夫人的情感并没有那么强烈，不过是辩论的势头将作者推到了这个立场。",
  "uiIdx": "",
  "range": "6395-6474",
  "chapterUid": 2
 },
 {
  "level": 4,
  "text": "作者认为，比起审判人，作者更乐于去理解人。",
  "uiIdx": "",
  "range": "7850-7873",
  "chapterUid": 2
 },
 {
  "level": 2,
  "text": "C夫人对争论的平息",
  "uiIdx": "4",
  "range": "7902-7946",
  "chapterUid": 2
 },
 {
  "level": 3,
  "text": "C夫人以她的智慧和冷静平息了这场争论",
  "uiIdx": "4.1",
  "range": "7902-7946",
  "chapterUid": 2
 },
 {
  "level": 4,
  "text": "C夫人用那双清澈的灰色眼睛直直地看着作者，沉默地注视了好一会儿，似乎在权衡，也似乎在探测。",
  "uiIdx": "",
  "range": "7902-7946",
  "chapterUid": 2
 },
 {
  "level": 4,
  "text": "C夫人最终用一种几乎无法言说的从容，用那种既毫不唐突又绝对优雅的方式站起身来，温和地向作者伸出手。",
  "uiIdx": "",
  "range": "9214-9261",
  "chapterUid": 2
 },
 {
  "level": 3,
  "text": "C夫人的行为让整张餐桌恢复了平静",
  "uiIdx": "4.2",
  "range": "9261-9279",
  "chapterUid": 2
 },
 {
  "level": 4,
  "text": "我们全都在心里默默感谢她：感谢她让我们这些方才还针锋相对的“对手”，此刻竟能以勉强的礼貌互致问候。",
  "uiIdx": "",
  "range": "9279-9328",
  "chapterUid": 2
 },
 {
  "level": 4,
  "text": "那股几近爆裂的紧张氛围，也终于随着几句轻松的玩笑悄然化解。",
  "uiIdx": "",
  "range": "9328-9358",
  "chapterUid": 2
 },
 {
  "level": 1,
  "text": "2",
  "uiIdx": "",
  "range": "",
  "chapterUid": 2,
  "display": "版权信息 · 2 · 辩论后的变化"
 },
 {
  "level": 2,
  "text": "辩论后的变化",
  "uiIdx": "1",
  "range": "1151-1213",
  "chapterUid": 2
 },
 {
  "level": 3,
  "text": "辩论后，我与几位对手之间形成了一层隔膜",
  "uiIdx": "1.1",
  "range": "1151-1213",
  "chapterUid": 2
 },
 {
  "level": 4,
  "text": "那对德国夫妇明显变得疏远冷淡。",
  "uiIdx": "",
  "range": "1213-1284",
  "chapterUid": 2
 },
 {
  "level": 4,
  "text": "意大利夫妇则似乎乐在其中，接下来的几天里总是带着一丝揶揄。",
  "uiIdx": "",
  "range": "1213-1284",
  "chapterUid": 2
 },
 {
  "level": 3,
  "text": "C夫人自那之后对我表现出的格外亲切",
  "uiIdx": "1.2",
  "range": "1364-1429",
  "chapterUid": 2
 },
 {
  "level": 4,
  "text": "她本是极为拘谨的人，几乎从不在用餐之外与同桌之人多作交谈。",
  "uiIdx": "",
  "range": "1429-1458",
  "chapterUid": 2
 },
 {
  "level": 4,
  "text": "自那次争论之后，她竟多次在花园中主动走近我，和我攀谈。",
  "uiIdx": "",
  "range": "1458-1533",
  "chapterUid": 2
 },
 {
  "level": 2,
  "text": "C夫人的请求",
  "uiIdx": "2",
  "range": "2370-2397",
  "chapterUid": 2
 },
 {
  "level": 3,
  "text": "C夫人希望我能向她讲述她生命中的一段往事",
  "uiIdx": "2.1",
  "range": "2370-2397",
  "chapterUid": 2
 },
 {
  "level": 4,
  "text": "那段经历已经过去太久，几乎与她当下的生活无关。",
  "uiIdx": "",
  "range": "2370-2397",
  "chapterUid": 2
 },
 {
  "level": 4,
  "text": "但正因为我将在后天离开，这种临别的距离感反倒使她更容易说出口。",
  "uiIdx": "",
  "range": "2397-2452",
  "chapterUid": 2
 },
 {
  "level": 3,
  "text": "C夫人希望我尽全力，不隐瞒任何事，无论对我，还是对她自己",
  "uiIdx": "2.2",
  "range": "2869-2894",
  "chapterUid": 2
 },
 {
  "level": 4,
  "text": "“您说得完全正确：半真半假的话毫无意义，唯有全然的真诚才有价值。”。",
  "uiIdx": "",
  "range": "2837-2869",
  "chapterUid": 2
 },
 {
  "level": 4,
  "text": "“我会尽全力，不隐瞒任何事，无论对您，还是对我自己。请于晚餐后到我房间来，我已经六十七岁了，无须顾虑任何误解。”。",
  "uiIdx": "",
  "range": "2869-2923",
  "chapterUid": 2
 },
 {
  "level": 2,
  "text": "讲述往事的过程",
  "uiIdx": "3",
  "range": "2894-2923",
  "chapterUid": 2
 },
 {
  "level": 3,
  "text": "C夫人在晚餐后到我房间来，开始讲述她的往事",
  "uiIdx": "3.1",
  "range": "2894-2923",
  "chapterUid": 2
 },
 {
  "level": 4,
  "text": "屋子里只透着微弱的光晕，昏暗中，一盏小巧的阅读灯投下柔黄的光锥，其余角落都沉在黄昏般的半明半暗里。",
  "uiIdx": "",
  "range": "3198-3247",
  "chapterUid": 2
 },
 {
  "level": 4,
  "text": "C夫人大方自然地迎上前来，为我拉出一张扶手椅，自己则在我对面坐下。",
  "uiIdx": "",
  "range": "3247-3280",
  "chapterUid": 2
 },
 {
  "level": 3,
  "text": "C夫人讲述她的丈夫在蒙特卡洛的赌场输光了一切，然后走向死亡的过程",
  "uiIdx": "3.2",
  "range": "5673-5713",
  "chapterUid": 2
 },
 {
  "level": 4,
  "text": "“那日中午，我与M公爵夫人共进午餐，她是我家族中的一位远房亲戚。午餐后，我还未感到倦意，便走进赌场，在众桌之间悠闲踱步，自己并不下注，只是看人。”。",
  "uiIdx": "",
  "range": "5641-5713",
  "chapterUid": 2
 },
 {
  "level": 4,
  "text": "“那天傍晚，当我走进赌场，从两张拥挤不堪的赌桌旁穿过，正准备从手袋里取出几枚金币时，忽然听见一个极为奇特的声音。那声音来自赌桌对面，在轮盘球疲惫地在两个数字之间艰难摇晃、整个赌厅屏息以待的那种密不透风的沉默中，它显得格外刺耳。”。",
  "uiIdx": "",
  "range": "6207-6281",
  "chapterUid": 2
 },
 {
  "level": 4,
  "text": "“我被这情景震慑得如同石化。因为我立刻明白，这个人是要走向死亡。”。",
  "uiIdx": "",
  "range": "11542-11574",
  "chapterUid": 2
 },
 {
  "level": 4,
  "text": "“他站在衣帽间前，侍者已将外套递到他面前。然而他的手臂再也不受支配，软得像失去知觉一般，于是那位殷勤的侍者只得像扶着一个瘫痪之人般，小心而吃力地把他的手臂塞进袖中。”。",
  "uiIdx": "",
  "range": "12073-12155",
  "chapterUid": 2
 },
 {
  "level": 4,
  "text": "“这个动作如此令人震撼，以至于我在一旁观看时竟感到一阵羞愧。我不由自主地偏过头去，像是在为自己目睹一场陌生人的绝望感到难堪——仿佛我不是在现实中，而是在剧场的舞台边，窥视着某个角色的悲剧性崩溃。”。",
  "uiIdx": "",
  "range": "12307-12404",
  "chapterUid": 2
 },
 {
  "level": 4,
  "text": "“然而紧接着，那种无法解释的恐惧又一次从内心深处将我推了出去。我匆忙取回自己的外套，几乎没有思考，完全是出于某种本能与冲动，追着那个陌生人冲进了夜色之中。”。",
  "uiIdx": "",
  "range": "12404-12481",
  "chapterUid": 2
 },
 {
  "level": 1,
  "text": "3",
  "uiIdx": "",
  "range": "",
  "chapterUid": 2,
  "display": "版权信息 · 3 · C夫人的真实动机"
 },
 {
  "level": 2,
  "text": "C夫人的真实动机",
  "uiIdx": "1",
  "range": "1467-1488",
  "chapterUid": 2
 },
 {
  "level": 3,
  "text": "C夫人追上赌徒并非因为爱上他，而是出于好奇和恐惧",
  "uiIdx": "1.1",
  "range": "1467-1488",
  "chapterUid": 2
 },
 {
  "level": 4,
  "text": "C夫人当时并未将他视作一个‘男人’来看待。",
  "uiIdx": "",
  "range": "1467-1488",
  "chapterUid": 2
 },
 {
  "level": 4,
  "text": "C夫人被某种着魔般的力量吸引，被某种意志推动，甚至来不及意识到这鲁莽行为的荒谬。",
  "uiIdx": "",
  "range": "1786-1858",
  "chapterUid": 2
 },
 {
  "level": 2,
  "text": "C夫人对赌徒的观察和感受",
  "uiIdx": "2",
  "range": "2063-2087",
  "chapterUid": 2
 },
 {
  "level": 3,
  "text": "C夫人观察到赌徒的疲惫和绝望，感到震惊和恐惧",
  "uiIdx": "2.1",
  "range": "2063-2087",
  "chapterUid": 2
 },
 {
  "level": 4,
  "text": "赌徒整个身体像一个麻袋似的重重摔在长椅上。",
  "uiIdx": "",
  "range": "2063-2087",
  "chapterUid": 2
 },
 {
  "level": 4,
  "text": "赌徒头歪斜着仰靠在椅背上，手臂软塌塌、毫无形状地垂到地上。",
  "uiIdx": "",
  "range": "2140-2169",
  "chapterUid": 2
 },
 {
  "level": 4,
  "text": "C夫人看到赌徒倒下的方式，好似一块石子坠入深渊，直到触底才会停住。",
  "uiIdx": "",
  "range": "2342-2399",
  "chapterUid": 2
 },
 {
  "level": 3,
  "text": "C夫人被赌徒的绝望和孤独深深震撼",
  "uiIdx": "2.2",
  "range": "3567-3664",
  "chapterUid": 2
 },
 {
  "level": 4,
  "text": "赌徒在滂沱大雨中一动不动，疲惫得甚至无法站起、走上几步躲到屋檐下。",
  "uiIdx": "",
  "range": "3567-3664",
  "chapterUid": 2
 },
 {
  "level": 4,
  "text": "赌徒仿佛拥有一种奇异的天赋：他的一切情感都会以动作与姿态强烈而清晰地显现。",
  "uiIdx": "",
  "range": "3522-3567",
  "chapterUid": 2
 },
 {
  "level": 2,
  "text": "C夫人的行动和决定",
  "uiIdx": "3",
  "range": "3143-3209",
  "chapterUid": 2
 },
 {
  "level": 3,
  "text": "C夫人被雨声和赌徒的绝望吸引，决定去救他",
  "uiIdx": "3.1",
  "range": "3143-3209",
  "chapterUid": 2
 },
 {
  "level": 4,
  "text": "一滴雨重重地砸落下来，紧接着，大雨毫无预警地倾泻而下。",
  "uiIdx": "",
  "range": "3143-3209",
  "chapterUid": 2
 },
 {
  "level": 4,
  "text": "在骤然倾泻而下的暴雨中，那位不幸的青年依然僵坐在长椅上，纹丝不动。",
  "uiIdx": "",
  "range": "3327-3398",
  "chapterUid": 2
 },
 {
  "level": 3,
  "text": "C夫人将赌徒带到旅馆，试图帮助他",
  "uiIdx": "3.2",
  "range": "6560-6593",
  "chapterUid": 2
 },
 {
  "level": 4,
  "text": "C夫人将手伸进包里，拿出一百法郎，对赌徒说：‘这里有一百法郎，拿着，去开个房间吧，明天就回尼斯去。’。",
  "uiIdx": "",
  "range": "6560-6593",
  "chapterUid": 2
 },
 {
  "level": 4,
  "text": "赌徒用一种我从未料到的力量，将我的手推了回去，说：‘你是个好人，可别浪费你的钱了。救不了我的。’。",
  "uiIdx": "",
  "range": "6740-6785",
  "chapterUid": 2
 },
 {
  "level": 4,
  "text": "C夫人再次坚持，将钱递给赌徒，赌徒几乎是猛地推开了我的手，说：‘算了吧，’他又低声重复道，语调沉闷而绝望，‘这毫无意义。还不如让我就在外面自我了结了，总比弄得他们房间里血迹斑斑要好。你的一百法郎救不了我，哪怕一千也一样。我明天还是会拿着最后的几枚硬币回到赌厅，直到一文不剩才会停手。何必再来一遍？这一切对我来说已经够了。’。",
  "uiIdx": "",
  "range": "6740-6785",
  "chapterUid": 2
 },
 {
  "level": 4,
  "text": "C夫人决不退让，猛地抓住赌徒的手，把钞票硬塞进他掌心，说：‘你必须收下，立刻上去！’。",
  "uiIdx": "",
  "range": "7553-7585",
  "chapterUid": 2
 },
 {
  "level": 4,
  "text": "赌徒忽然用一种生硬、冷峻、几乎带着怨恨的声音说，那双冰冷的手指紧紧扣住了C夫人的手腕，力道如铁一般强硬。C夫人惊恐万分，那种惊恐——贯穿全身、令人瘫软、仿佛被闪电击中的感觉，让C夫人失去了所有反应。C夫人想挣脱，想反抗，但意志全然不听使唤。而且，C夫人感到羞耻——在门房那冷漠而催促的注视下，C夫人竟无力与一个陌生男人扭打。就这样，C夫人忽然已身在旅馆之内。",
  "uiIdx": "",
  "range": "7779-7828",
  "chapterUid": 2
 },
 {
  "level": 1,
  "text": "4",
  "uiIdx": "",
  "range": "",
  "chapterUid": 2,
  "display": "版权信息 · 4 · C夫人的情绪爆发和解释"
 },
 {
  "level": 2,
  "text": "C夫人的情绪爆发和解释",
  "uiIdx": "1",
  "range": "1165-1213",
  "chapterUid": 2
 },
 {
  "level": 3,
  "text": "C夫人情绪激荡，向作者坦白自己从未对陌生人产生过丝毫关系",
  "uiIdx": "1.1",
  "range": "1165-1213",
  "chapterUid": 2
 },
 {
  "level": 4,
  "text": "C夫人走到窗前沉默地望着窗外，或许只是将额头抵在冰冷的玻璃上静静地靠着。",
  "uiIdx": "",
  "range": "1165-1213",
  "chapterUid": 2
 },
 {
  "level": 4,
  "text": "C夫人回到作者面前，重新坐下，说：“好了，此刻，最艰难的部分我已经说出来了。”。",
  "uiIdx": "",
  "range": "1277-1350",
  "chapterUid": 2
 },
 {
  "level": 3,
  "text": "C夫人解释自己卷入悲剧完全出于一种近乎过度激发的援助冲动，与任何情欲、任何个人情感都无关",
  "uiIdx": "1.2",
  "range": "1489-1585",
  "chapterUid": 2
 },
 {
  "level": 4,
  "text": "C夫人说：“我曾对自己起誓，要对您，也对我自己坦诚到底，所以我向您重申：这件事完全出于一种近乎过度激发的援助冲动，与任何情欲、任何个人情感都无关，我是在没有任何欲望、没有任何预感的情况下，卷入了这场悲剧。”。",
  "uiIdx": "",
  "range": "1489-1585",
  "chapterUid": 2
 },
 {
  "level": 2,
  "text": "C夫人描述那一夜的经过",
  "uiIdx": "2",
  "range": "1669-1693",
  "chapterUid": 2
 },
 {
  "level": 3,
  "text": "C夫人描述了自己在那一夜与一个陌生人搏斗，为他的生命而战的经历",
  "uiIdx": "2.1",
  "range": "1669-1693",
  "chapterUid": 2
 },
 {
  "level": 4,
  "text": "C夫人说：“那一夜，我是在与一个人搏斗，为他的生命而战。”。",
  "uiIdx": "",
  "range": "1669-1693",
  "chapterUid": 2
 },
 {
  "level": 4,
  "text": "C夫人说：“我用每一根神经都清晰地感知到，那陌生人、那个几乎已然沉沦的人，正以一个濒死者的全部渴望与疯狂，紧紧攫住生命的最后一线。”。",
  "uiIdx": "",
  "range": "1714-1773",
  "chapterUid": 2
 },
 {
  "level": 3,
  "text": "C夫人描述了清晨醒来时，发现自己和一个完全陌生的男人同睡在一间旅馆房间的惊骇经历",
  "uiIdx": "2.2",
  "range": "2833-2862",
  "chapterUid": 2
 },
 {
  "level": 4,
  "text": "C夫人说：“我从铅一般沉重的睡眠中醒来，仿佛从夜的最深处浮出，那是一种从未经历过的黑暗与昏沉。”。",
  "uiIdx": "",
  "range": "2239-2280",
  "chapterUid": 2
 },
 {
  "level": 4,
  "text": "C夫人说：“我听见隔壁房间有人说话，听见水流淌的声音，听见走廊上有人拖着脚步经过，每一个声音、每一个细节都像铁锤一样，无情地敲击着我，让我不得不承认：我醒着，我无比清醒，我在活生生的现实里。”。",
  "uiIdx": "",
  "range": "3089-3178",
  "chapterUid": 2
 },
 {
  "level": 2,
  "text": "C夫人的内心感受和决定",
  "uiIdx": "3",
  "range": "2979-3023",
  "chapterUid": 2
 },
 {
  "level": 3,
  "text": "C夫人感到恐惧、耻辱与惊骇，但同时也感到欣慰和骄傲",
  "uiIdx": "3.1",
  "range": "2979-3023",
  "chapterUid": 2
 },
 {
  "level": 4,
  "text": "C夫人说：“我永远也不会知道，自己当时躺了多久，四肢冰冷，僵硬得像具尸体，直挺挺地躺在棺木中似的。”。",
  "uiIdx": "",
  "range": "2979-3023",
  "chapterUid": 2
 },
 {
  "level": 4,
  "text": "C夫人说：“我看着他，那目光，我想我只能这样说，是母亲的目光。”。",
  "uiIdx": "",
  "range": "4348-4373",
  "chapterUid": 2
 },
 {
  "level": 3,
  "text": "C夫人决定逃离旅馆，不再见到那个陌生人",
  "uiIdx": "3.2",
  "range": "4886-4914",
  "chapterUid": 2
 },
 {
  "level": 4,
  "text": "C夫人说：“‘我现在得走了，’我迅速对他说，‘你留下，先穿好衣服。十二点钟，在赌场门口等我——那时我会处理好一切后续的事。’。”。",
  "uiIdx": "",
  "range": "4886-4943",
  "chapterUid": 2
 },
 {
  "level": 4,
  "text": "C夫人说：“还不等他回话，我已冲出房间，只为不再看到那个房间、不再面对那张床、不再让这一切继续蔓延。”。",
  "uiIdx": "",
  "range": "4943-4987",
  "chapterUid": 2
 },
 {
  "level": 1,
  "text": "5",
  "uiIdx": "",
  "range": "",
  "chapterUid": 2,
  "display": "版权信息 · 5 · C夫人的转变"
 },
 {
  "level": 2,
  "text": "C夫人的转变",
  "uiIdx": "1",
  "range": "1361-1392",
  "chapterUid": 2
 },
 {
  "level": 3,
  "text": "C夫人经历了从痛苦到轻松的过程",
  "uiIdx": "1.1",
  "range": "1361-1392",
  "chapterUid": 2
 },
 {
  "level": 4,
  "text": "C夫人曾说过：丈夫去世后，我几乎彻底放弃了自己的生活。",
  "uiIdx": "",
  "range": "1361-1392",
  "chapterUid": 2
 },
 {
  "level": 4,
  "text": "但如今，命运第一次将一项真正的任务摆在我面前——我救了一个人，用尽全部意志和力量，把他从毁灭的边缘拉了回来。",
  "uiIdx": "",
  "range": "1442-1496",
  "chapterUid": 2
 },
 {
  "level": 3,
  "text": "C夫人感到自己存在的必要",
  "uiIdx": "1.2",
  "range": "1595-1629",
  "chapterUid": 2
 },
 {
  "level": 4,
  "text": "我突然重新感到自己存在的必要，血液重新奔涌，人生有了力量，有了方向。",
  "uiIdx": "",
  "range": "1595-1629",
  "chapterUid": 2
 },
 {
  "level": 2,
  "text": "陌生人的故事",
  "uiIdx": "2",
  "range": "2956-3172",
  "chapterUid": 2
 },
 {
  "level": 3,
  "text": "陌生人出身于奥地利波兰一支古老的贵族家族，原本是作为外交官培养的",
  "uiIdx": "2.1",
  "range": "2956-3172",
  "chapterUid": 2
 },
 {
  "level": 4,
  "text": "他曾在维也纳求学，并于一个月前刚刚以优异的成绩通过了第一场考试。",
  "uiIdx": "",
  "range": "3172-3203",
  "chapterUid": 2
 },
 {
  "level": 4,
  "text": "他的叔叔是一位总参谋部的高级军官，他当时正寄宿在叔叔家。",
  "uiIdx": "",
  "range": "3203-3231",
  "chapterUid": 2
 },
 {
  "level": 3,
  "text": "陌生人因为赌博，输光了所有的东西，包括他的名誉",
  "uiIdx": "2.2",
  "range": "3804-3855",
  "chapterUid": 2
 },
 {
  "level": 4,
  "text": "他越输越多，债务越积越高，而那些凭‘信用’签下的承诺，连同他的名誉，只能靠一场‘决定性的豪赌’来挽回。",
  "uiIdx": "",
  "range": "3804-3855",
  "chapterUid": 2
 },
 {
  "level": 4,
  "text": "他早已典当了手表、衣物，最终发生了最可怕的事：他从一位年长姑母的柜子里偷走了她平时很少佩戴的两枚大纽扣式珠宝。",
  "uiIdx": "",
  "range": "3855-3910",
  "chapterUid": 2
 },
 {
  "level": 2,
  "text": "C夫人的救赎",
  "uiIdx": "3",
  "range": "5359-5386",
  "chapterUid": 2
 },
 {
  "level": 3,
  "text": "C夫人决定帮助陌生人，拯救他",
  "uiIdx": "3.1",
  "range": "5359-5386",
  "chapterUid": 2
 },
 {
  "level": 4,
  "text": "我答应出钱帮他支付旅费，也帮他赎回那枚被他典当的首饰。",
  "uiIdx": "",
  "range": "5359-5386",
  "chapterUid": 2
 },
 {
  "level": 4,
  "text": "但这一切都有一个前提——他必须在今天之内离开，并且要以他的名誉发誓，从此再不碰一张牌，再不参与任何形式的赌博。",
  "uiIdx": "",
  "range": "5386-5441",
  "chapterUid": 2
 },
 {
  "level": 3,
  "text": "C夫人成功地帮助陌生人，他重新找到了生活的希望",
  "uiIdx": "3.2",
  "range": "7996-8023",
  "chapterUid": 2
 },
 {
  "level": 4,
  "text": "他转身走向一处壁龛，对着圣像划了十字，顺从地跪了下来。",
  "uiIdx": "",
  "range": "7996-8023",
  "chapterUid": 2
 },
 {
  "level": 4,
  "text": "‘请跟我念，’我说着，自己也因激动而微微颤抖，‘照着我说的重复：我发誓——’。",
  "uiIdx": "",
  "range": "8023-8074",
  "chapterUid": 2
 },
 {
  "level": 4,
  "text": "他颤抖着，一字一句复述那誓言，话语在这空旷无声的教堂里清晰地回响，仿佛被钉在空气中，久久不散。",
  "uiIdx": "",
  "range": "8177-8225",
  "chapterUid": 2
 },
 {
  "level": 4,
  "text": "随后是一阵沉寂。如此静谧，竟能听见外面树叶间被风穿梭搅动的低低涛声。",
  "uiIdx": "",
  "range": "8233-8259",
  "chapterUid": 2
 },
 {
  "level": 4,
  "text": "忽然间，他如忏悔者般扑倒在祭坛前。随之而出的，是一种我从未听过的祈祷方式：他开始用波兰语快速而杂乱地低语，像是陷入狂热的激动中，那些我无法理解的词语从他口中倾泻而出。",
  "uiIdx": "",
  "range": "8259-8342",
  "chapterUid": 2
 },
 {
  "level": 4,
  "text": "但我能感受到，这一定是祷告，是极度的感恩，是痛悔，是灵魂的倾诉。",
  "uiIdx": "",
  "range": "8342-8374",
  "chapterUid": 2
 },
 {
  "level": 4,
  "text": "他的头颅一次次低伏到祈祷台上，像是在将自己整个交托出去。",
  "uiIdx": "",
  "range": "8374-8402",
  "chapterUid": 2
 },
 {
  "level": 4,
  "text": "他以燃烧般的热情一遍遍重复着那些异国的音节，最终浓缩成一个词——那个他反复呼喊、几乎用生命之力吐出的词。",
  "uiIdx": "",
  "range": "8402-8454",
  "chapterUid": 2
 },
 {
  "level": 4,
  "text": "我至今未曾在任何教堂中听过如此祈祷，此后也再未听到过。",
  "uiIdx": "",
  "range": "8454-8481",
  "chapterUid": 2
 },
 {
  "level": 4,
  "text": "他紧紧抓住木制的跪椅，手指关节因用力而发白。整个身体被一种来自内部的风暴剧烈撕扯着，有时猛然上扬，有时又被重力狠狠压向地面。",
  "uiIdx": "",
  "range": "8481-8543",
  "chapterUid": 2
 },
 {
  "level": 4,
  "text": "他的眼睛与知觉似乎已完全从这个现实世界抽离，他的整个存在此刻正处于另一重界域：要么是涤净之火的炼狱，要么是灵魂即将升向圣洁之境的高地。",
  "uiIdx": "",
  "range": "8543-8610",
  "chapterUid": 2
 },
 {
  "level": 4,
  "text": "终于，他缓慢地站了起来，画了个十字，费力地转过身来。",
  "uiIdx": "",
  "range": "8610-8636",
  "chapterUid": 2
 },
 {
  "level": 4,
  "text": "他的双膝微微发颤，脸色苍白，像是刚从一场剧烈挣扎中脱身。",
  "uiIdx": "",
  "range": "8636-8664",
  "chapterUid": 2
 },
 {
  "level": 4,
  "text": "但当他看见我时，眼中猛然绽出光亮，一个洁净、虔诚、宛如神迹的微笑浮上他疲惫的面庞。",
  "uiIdx": "",
  "range": "8664-8705",
  "chapterUid": 2
 },
 {
  "level": 4,
  "text": "他走近我，深深地鞠了一个俄式鞠躬，然后轻轻地握住我的双手，低头、恭敬地将唇贴近我的指背，低声说道：‘是上帝把您派来的，我刚才已经为此感谢过他了。’。",
  "uiIdx": "",
  "range": "8705-8778",
  "chapterUid": 2
 },
 {
  "level": 1,
  "text": "6",
  "uiIdx": "",
  "range": "",
  "chapterUid": 2,
  "display": "版权信息 · 6 · C夫人的讲述"
 },
 {
  "level": 2,
  "text": "C夫人的讲述",
  "uiIdx": "1",
  "range": "1151-1167",
  "chapterUid": 2
 },
 {
  "level": 3,
  "text": "C夫人向讲述者倾诉了自己的身世和遭遇",
  "uiIdx": "1.1",
  "range": "1375-1389",
  "chapterUid": 2
 },
 {
  "level": 4,
  "text": "C夫人曾向讲述者承诺，要彻底坦诚。",
  "uiIdx": "",
  "range": "1375-1389",
  "chapterUid": 2
 },
 {
  "level": 4,
  "text": "C夫人强迫自己将那一段经历有条理地回忆、讲述，并为那些当时纷乱交织、彼此缠绕不清的情绪寻找清晰准确的词语。",
  "uiIdx": "",
  "range": "1409-1521",
  "chapterUid": 2
 },
 {
  "level": 3,
  "text": "C夫人讲述了自己在遇到年轻人后的失望和痛苦",
  "uiIdx": "1.2",
  "range": "1867-1923",
  "chapterUid": 2
 },
 {
  "level": 4,
  "text": "C夫人感到失望，因为这个年轻人竟那样温顺地离开了，那样毫无挣扎、毫无留恋地走了，竟丝毫没有尝试挽留我，或是留下来陪我。",
  "uiIdx": "",
  "range": "1867-1923",
  "chapterUid": 2
 },
 {
  "level": 4,
  "text": "C夫人感到痛苦，因为她的感官已经完全失序了，她的内心正被汹涌的情绪彻底淹没。",
  "uiIdx": "",
  "range": "3029-3045",
  "chapterUid": 2
 },
 {
  "level": 2,
  "text": "C夫人的回忆和挣扎",
  "uiIdx": "2",
  "range": "2548-2579",
  "chapterUid": 2
 },
 {
  "level": 3,
  "text": "C夫人回忆了自己和年轻人的相遇和分别",
  "uiIdx": "2.1",
  "range": "2548-2579",
  "chapterUid": 2
 },
 {
  "level": 4,
  "text": "C夫人回忆了自己在酒店房间里来回踱步，心乱如麻，无端拉开抽屉，又漫无目的地关上。",
  "uiIdx": "",
  "range": "2548-2579",
  "chapterUid": 2
 },
 {
  "level": 4,
  "text": "C夫人回忆了自己在车站台上，看着那些车厢从我面前缓缓滑过，我竭力想在窗口间寻得他的面容。",
  "uiIdx": "",
  "range": "4499-4560",
  "chapterUid": 2
 },
 {
  "level": 3,
  "text": "C夫人挣扎着想要忘记这段经历，但是无法做到",
  "uiIdx": "2.2",
  "range": "3410-3478",
  "chapterUid": 2
 },
 {
  "level": 4,
  "text": "C夫人挣扎着想要忘记这段经历，但是她的内心却一次又一次浮现出那张面孔，那张我曾无比热切地注视过的、令我感到近乎欢喜的面孔。",
  "uiIdx": "",
  "range": "3410-3478",
  "chapterUid": 2
 },
 {
  "level": 4,
  "text": "C夫人挣扎着想要忘记这段经历，但是每当她想起那个瞬间——那个她被他的嘲弄抽打得无处遁形、在成百上千的陌生人面前窘迫站立的瞬间——她的血液依然会在体内冰冷凝固。",
  "uiIdx": "",
  "range": "10821-10891",
  "chapterUid": 2
 },
 {
  "level": 2,
  "text": "C夫人的决定和离开",
  "uiIdx": "3",
  "range": "11271-11312",
  "chapterUid": 2
 },
 {
  "level": 3,
  "text": "C夫人决定离开这里，离开这座被诅咒的地狱",
  "uiIdx": "3.1",
  "range": "11271-11312",
  "chapterUid": 2
 },
 {
  "level": 4,
  "text": "C夫人决定离开这里，离开此刻的我，回家，回到我的亲人身边，回到我过去的、属于我自己的生活里去。",
  "uiIdx": "",
  "range": "11503-11547",
  "chapterUid": 2
 },
 {
  "level": 4,
  "text": "C夫人连夜赶往巴黎，在那里换乘火车直奔布洛涅，又从布洛涅到多佛，从多佛到伦敦，从伦敦直奔我儿子的乡间宅邸，这一切都在一种疯狂的疾驰中完成，没有思考，没有停顿。",
  "uiIdx": "",
  "range": "11547-11624",
  "chapterUid": 2
 },
 {
  "level": 3,
  "text": "C夫人最终到达了儿子的庄园，但是她的内心仍然充满了痛苦和羞愧",
  "uiIdx": "3.2",
  "range": "11679-11738",
  "chapterUid": 2
 },
 {
  "level": 4,
  "text": "C夫人最终到达了儿子的庄园，但是她的神情、她的样子，一定流露出某种无法遮掩的东西。",
  "uiIdx": "",
  "range": "11679-11738",
  "chapterUid": 2
 },
 {
  "level": 4,
  "text": "C夫人拒绝了所有问题，只要求一盆热水，我迫切需要把旅途的污垢洗掉，把那狂徒、那卑劣之人所留下的每一处痕迹，都从我身上清除干净。",
  "uiIdx": "",
  "range": "11794-11854",
  "chapterUid": 2
 }
]