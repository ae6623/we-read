[
 {
  "level": 1,
  "text": "（一） 奇迹开端",
  "uiIdx": "",
  "range": "",
  "chapterUid": 2
 },
 {
  "level": 2,
  "text": "战后日本的经济转型",
  "uiIdx": "1",
  "range": "617-712",
  "chapterUid": 2
 },
 {
  "level": 3,
  "text": "日本经济转型需要具备土地、劳动力、企业组织和外部市场四个基本条件",
  "uiIdx": "1.1",
  "range": "617-712",
  "chapterUid": 2
 },
 {
  "level": 4,
  "text": "土地以及劳动力能够重新投入工作，企业能够将资金和技术进行组织起来，并且还需要外部的市场购买你的商品。",
  "uiIdx": "",
  "range": "617-712",
  "chapterUid": 2
 },
 {
  "level": 3,
  "text": "美国占领期间的改革改变了日本的经济起跑线",
  "uiIdx": "1.2",
  "range": "867-895",
  "chapterUid": 2
 },
 {
  "level": 4,
  "text": "土地的改革使得旧地主阶层走出了历史的舞台，农民手中拥有了土地，就有了稳定生产的动力以及消费的底气。",
  "uiIdx": "",
  "range": "823-895",
  "chapterUid": 2
 },
 {
  "level": 4,
  "text": "劳动制度的改变使得工人具有组织性，而教育制度重组使得基础教育能够惠及更多的人。",
  "uiIdx": "",
  "range": "895-934",
  "chapterUid": 2
 },
 {
  "level": 3,
  "text": "外部需求对日本经济转型起到了非常重要的作用",
  "uiIdx": "1.3",
  "range": "1009-1115",
  "chapterUid": 2
 },
 {
  "level": 4,
  "text": "朝鲜战争时，大量美国的军需订单涌入日本，这不但给日本带来急需的美元的收入，更为日本工业提供了一个很好的恢复的机会。",
  "uiIdx": "",
  "range": "1009-1115",
  "chapterUid": 2
 },
 {
  "level": 2,
  "text": "日本战后制造业的追赶",
  "uiIdx": "2",
  "range": "1115-1194",
  "chapterUid": 2
 },
 {
  "level": 3,
  "text": "日本战后制造业从纺织、轻工业到钢铁、造船，再一步步地跨越到汽车，家电，电子以及精密设备的领域。",
  "uiIdx": "2.1",
  "range": "1115-1194",
  "chapterUid": 2
 },
 {
  "level": 3,
  "text": "日本制造业的追赶为日本换来了丰厚的出口收入，创造了大量城市就业的机会，带动工资上涨以及居民储蓄增加，更为关键的是，它给企业继续扩张带来了信心",
  "uiIdx": "2.2",
  "range": "1194-1300",
  "chapterUid": 2
 },
 {
  "level": 4,
  "text": "这种增长的预期一旦在社会上形成共识，便会形成一种互相加强的正向过程。",
  "uiIdx": "",
  "range": "1300-1364",
  "chapterUid": 2
 },
 {
  "level": 2,
  "text": "日本经济泡沫的原因",
  "uiIdx": "3",
  "range": "1452-1523",
  "chapterUid": 2
 },
 {
  "level": 3,
  "text": "日本高速增长期积累的许多优点，后来反而成为难以转身的负担",
  "uiIdx": "3.1",
  "range": "1452-1523",
  "chapterUid": 2
 },
 {
  "level": 4,
  "text": "长期的雇佣制虽然使得员工愿意为公司奉献自己的一生，但是也使得劳动力流动性被限制住了。",
  "uiIdx": "",
  "range": "1523-1595",
  "chapterUid": 2
 },
 {
  "level": 4,
  "text": "银行主导融资的模式使得企业拥有稳定的资金来源，同时也很容易使得“关系”凌驾于风险判断之上。",
  "uiIdx": "",
  "range": "1595-1640",
  "chapterUid": 2
 },
 {
  "level": 4,
  "text": "政府和企业的密切配合加快了产业的升级，但可能会导致政策的目标和市场真实的信号混淆。",
  "uiIdx": "",
  "range": "1640-1681",
  "chapterUid": 2
 },
 {
  "level": 3,
  "text": "日本人普遍相信资产价格上涨是有实实在在的增长在支撑，即便真的出了风险，借助强大的组织力量也能够消化掉。",
  "uiIdx": "3.2",
  "range": "1730-1853",
  "chapterUid": 2
 },
 {
  "level": 1,
  "text": "（二） 日本财团",
  "uiIdx": "",
  "range": "",
  "chapterUid": 2
 },
 {
  "level": 2,
  "text": "日本财团的形成和特点",
  "uiIdx": "1",
  "range": "698-780",
  "chapterUid": 2
 },
 {
  "level": 3,
  "text": "二战前，日本存在由家族所控制的庞大的财阀",
  "uiIdx": "1.1",
  "range": "698-780",
  "chapterUid": 2
 },
 {
  "level": 4,
  "text": "财阀掌控着金融、贸易、矿业以及制造等命脉行业。",
  "uiIdx": "",
  "range": "698-780",
  "chapterUid": 2
 },
 {
  "level": 3,
  "text": "战后，美国主导的占领军改革试图将这些财阀拆散，但企业、银行以及管理层之间的关系仍然存在于地下。",
  "uiIdx": "1.2",
  "range": "780-854",
  "chapterUid": 2
 },
 {
  "level": 3,
  "text": "后来发展出来的企业集团虽然不再由一个家族直接掌控，但依然保持了抱团融资，交叉持股，长期合作的传统",
  "uiIdx": "1.3",
  "range": "854-945",
  "chapterUid": 2
 },
 {
  "level": 4,
  "text": "主银行制度在其中充当了一个连接点。",
  "uiIdx": "",
  "range": "945-992",
  "chapterUid": 2
 },
 {
  "level": 2,
  "text": "日本财团的主要运作方式",
  "uiIdx": "2",
  "range": "992-1015",
  "chapterUid": 2
 },
 {
  "level": 3,
  "text": "主银行制度：一家大银行在企业集团中扮演着家长和金主的角色",
  "uiIdx": "2.1",
  "range": "992-1015",
  "chapterUid": 2
 },
 {
  "level": 4,
  "text": "当企业缺钱的时候，主要就是找这家银行去贷款。",
  "uiIdx": "",
  "range": "1015-1037",
  "chapterUid": 2
 },
 {
  "level": 4,
  "text": "企业经营出现问题，银行会出面协调进行重组。",
  "uiIdx": "",
  "range": "1037-1058",
  "chapterUid": 2
 },
 {
  "level": 3,
  "text": "交叉持股：企业之间你中有我，我中有你，银行持有企业的股份，企业也反过来持有银行或者其它关联公司股份",
  "uiIdx": "2.2",
  "range": "1217-1262",
  "chapterUid": 2
 },
 {
  "level": 4,
  "text": "这种方式最大的好处是股权结构很稳定，外来资本无法插手管理层决策。",
  "uiIdx": "",
  "range": "1262-1336",
  "chapterUid": 2
 },
 {
  "level": 3,
  "text": "长期的雇佣制度：员工只要进入大企业，大体上就准备干到退休，工资随着工龄增长",
  "uiIdx": "2.3",
  "range": "1480-1513",
  "chapterUid": 2
 },
 {
  "level": 4,
  "text": "这样的财团秩序，在高速增长时很有用，因为那时候日本的目标很明确：提高质量、扩大产能、降低成本，并且把产品卖给全世界。",
  "uiIdx": "",
  "range": "1513-1613",
  "chapterUid": 2
 },
 {
  "level": 2,
  "text": "日本财团的问题和风险",
  "uiIdx": "3",
  "range": "1670-1728",
  "chapterUid": 2
 },
 {
  "level": 3,
  "text": "银行与企业捆绑得太紧，贷款时容易受到集团利益的影响，放水已经成为常态。",
  "uiIdx": "3.1",
  "range": "1670-1728",
  "chapterUid": 2
 },
 {
  "level": 3,
  "text": "交叉持股如同一层防弹衣一般，挡住外部股东质疑，但是也可能保护了低效率。",
  "uiIdx": "3.2",
  "range": "1728-1763",
  "chapterUid": 2
 },
 {
  "level": 1,
  "text": "（三） 汇率",
  "uiIdx": "",
  "range": "",
  "chapterUid": 2
 },
 {
  "level": 2,
  "text": "石油危机对日本经济的影响",
  "uiIdx": "1",
  "range": "635-727",
  "chapterUid": 2
 },
 {
  "level": 3,
  "text": "石油危机导致日本进口能源成本上升，影响国内经济",
  "uiIdx": "1.1",
  "range": "635-727",
  "chapterUid": 2
 },
 {
  "level": 4,
  "text": "日本自身就缺少油和气，工业系统又全部依靠进口燃料来维持。",
  "uiIdx": "",
  "range": "635-727",
  "chapterUid": 2
 },
 {
  "level": 4,
  "text": "油价一旦上涨，从工厂开工到电费、交通，再到普通老百姓的日常柴米油盐，都受到了冲击。",
  "uiIdx": "",
  "range": "635-727",
  "chapterUid": 2
 },
 {
  "level": 3,
  "text": "日本借助节能和高效制造，成功应对石油危机",
  "uiIdx": "1.2",
  "range": "829-883",
  "chapterUid": 2
 },
 {
  "level": 4,
  "text": "日本汽车行业转向生产排量较小、省油且耐用的汽车，受到全球市场的欢迎。",
  "uiIdx": "",
  "range": "829-883",
  "chapterUid": 2
 },
 {
  "level": 4,
  "text": "家电以及电子产品因为精细的质量把控以及成本管理，进入到了千家万户之中。",
  "uiIdx": "",
  "range": "883-942",
  "chapterUid": 2
 },
 {
  "level": 2,
  "text": "美国通胀和美元汇率的影响",
  "uiIdx": "2",
  "range": "1094-1124",
  "chapterUid": 2
 },
 {
  "level": 3,
  "text": "美国通胀高企，美联储提高联邦基金利率压制通胀",
  "uiIdx": "2.1",
  "range": "1094-1124",
  "chapterUid": 2
 },
 {
  "level": 4,
  "text": "高利率使得美国压制了通胀，但是也顺便把美元汇率顶了上去。",
  "uiIdx": "",
  "range": "1094-1124",
  "chapterUid": 2
 },
 {
  "level": 3,
  "text": "美元升值，美国货物变贵，贸易逆差增大",
  "uiIdx": "2.2",
  "range": "1124-1209",
  "chapterUid": 2
 },
 {
  "level": 4,
  "text": "美元一旦升值，美国的货物卖给别人就会变贵，外国货物进入美国反倒便宜了。",
  "uiIdx": "",
  "range": "1124-1209",
  "chapterUid": 2
 },
 {
  "level": 2,
  "text": "《广场协议》的签订及其对日本经济的影响",
  "uiIdx": "3",
  "range": "1255-1302",
  "chapterUid": 2
 },
 {
  "level": 3,
  "text": "《广场协议》旨在推低美元汇率，缓解美国外部失衡",
  "uiIdx": "3.1",
  "range": "1255-1302",
  "chapterUid": 2
 },
 {
  "level": 4,
  "text": "美国、日本、联邦德国、英国、法国一起商量，决定联手推低美元汇率。",
  "uiIdx": "",
  "range": "1255-1302",
  "chapterUid": 2
 },
 {
  "level": 3,
  "text": "签订《广场协议》后，日元升值，出口企业利润减少，国内经济信心受挫",
  "uiIdx": "3.2",
  "range": "1302-1372",
  "chapterUid": 2
 },
 {
  "level": 4,
  "text": "对日本来说，签订协议后日元一路飙升，出口企业的利润减少，国内对于经济增长信心也受到了很大打击。",
  "uiIdx": "",
  "range": "1302-1372",
  "chapterUid": 2
 },
 {
  "level": 2,
  "text": "日本经济泡沫的原因",
  "uiIdx": "4",
  "range": "1706-1742",
  "chapterUid": 2
 },
 {
  "level": 3,
  "text": "日本在应付汇率压力时采取的货币方式不当",
  "uiIdx": "4.1",
  "range": "1706-1742",
  "chapterUid": 2
 },
 {
  "level": 4,
  "text": "日本在政策泥潭中，若不刺激经济，出口受阻或导致企业缩减投资；若刺激过度，大笔资金便会跑去追逐具有高收益的资产，将股市与楼市炒得过热。",
  "uiIdx": "",
  "range": "1630-1742",
  "chapterUid": 2
 },
 {
  "level": 3,
  "text": "银行扩张放贷，企业及老百姓对资产价格盲目迷信",
  "uiIdx": "4.2",
  "range": "1742-1863",
  "chapterUid": 2
 },
 {
  "level": 4,
  "text": "这种两难境况众多国家都曾经遭遇过，但是在日本，此种压力恰好碰上银行主导之融资体系，错综复杂之企业集团之间的关系，居民之高储蓄率，这几股力量一旦合流，便为信用扩张创造了极为强大的温床。",
  "uiIdx": "",
  "range": "1742-1863",
  "chapterUid": 2
 },
 {
  "level": 1,
  "text": "（四） 低利率",
  "uiIdx": "",
  "range": "",
  "chapterUid": 2
 },
 {
  "level": 2,
  "text": "日元升值带来的经济压力",
  "uiIdx": "1",
  "range": "574-660",
  "chapterUid": 2
 },
 {
  "level": 3,
  "text": "日元升值导致出口下滑，企业利润减少，订单流失，投资缩手缩脚。",
  "uiIdx": "1.1",
  "range": "574-660",
  "chapterUid": 2
 },
 {
  "level": 2,
  "text": "央行降低利率以救市",
  "uiIdx": "2",
  "range": "758-780",
  "chapterUid": 2
 },
 {
  "level": 3,
  "text": "降低利率可以使企业借钱的成本比较低，老百姓房贷的压力比较小",
  "uiIdx": "2.1",
  "range": "758-780",
  "chapterUid": 2
 },
 {
  "level": 4,
  "text": "企业借钱的成本比较低，就敢于多投资一些产线。",
  "uiIdx": "",
  "range": "758-780",
  "chapterUid": 2
 },
 {
  "level": 4,
  "text": "老百姓房贷的压力比较小，就愿意多购买一些房子、多进行消费。",
  "uiIdx": "",
  "range": "780-809",
  "chapterUid": 2
 },
 {
  "level": 2,
  "text": "日本通胀率不高带来的虚假安全感",
  "uiIdx": "3",
  "range": "991-1048",
  "chapterUid": 2
 },
 {
  "level": 3,
  "text": "传统货币政策主要看消费品的价格，股票，地皮，写字楼这类金融资产，极有可能在物价稳定的掩护之下疯涨",
  "uiIdx": "3.1",
  "range": "991-1048",
  "chapterUid": 2
 },
 {
  "level": 4,
  "text": "只要消费品价格处于平稳的状态，央行就会觉得经济没有过热。",
  "uiIdx": "",
  "range": "964-991",
  "chapterUid": 2
 },
 {
  "level": 2,
  "text": "宽松政策的短期效果",
  "uiIdx": "4",
  "range": "1185-1203",
  "chapterUid": 2
 },
 {
  "level": 3,
  "text": "宽松的政策确实是有作用的，日元升值所带来的冲击被解决掉了不少",
  "uiIdx": "4.1",
  "range": "1185-1203",
  "chapterUid": 2
 },
 {
  "level": 4,
  "text": "企业更容易借钱，内需也得到了提升，大家的信心都挺充足的。",
  "uiIdx": "",
  "range": "1203-1231",
  "chapterUid": 2
 },
 {
  "level": 2,
  "text": "政策迟迟没有转弯的原因",
  "uiIdx": "5",
  "range": "1388-1499",
  "chapterUid": 2
 },
 {
  "level": 3,
  "text": "从国际上来看，当时各个发达国家需要商量着，既要稳固汇率又要稳定利率",
  "uiIdx": "5.1",
  "range": "1388-1499",
  "chapterUid": 2
 },
 {
  "level": 4,
  "text": "担心美元跌得太快或金融市场出问题，特别是1987年美国股市大跌后，各个国家央行倾向于多给一些流动性来保平安。",
  "uiIdx": "",
  "range": "1388-1499",
  "chapterUid": 2
 },
 {
  "level": 3,
  "text": "日本国内，政府、央行、监管部门的权责并不相同，提前收紧政策意味着有人要承担经济降温的责任。",
  "uiIdx": "5.2",
  "range": "1499-1586",
  "chapterUid": 2
 },
 {
  "level": 3,
  "text": "泡沫在早期很难被大家所承认",
  "uiIdx": "5.3",
  "range": "1643-1709",
  "chapterUid": 2
 },
 {
  "level": 4,
  "text": "资产价格上涨，企业账面价值好，银行手中抵押品值钱，老百姓认为自己变富，政府税收也上涨。",
  "uiIdx": "",
  "range": "1643-1709",
  "chapterUid": 2
 },
 {
  "level": 4,
  "text": "这时候如果谁站出来反对上涨，就得罪了所有的受益者。",
  "uiIdx": "",
  "range": "1709-1776",
  "chapterUid": 2
 },
 {
  "level": 2,
  "text": "低利率环境下的资金流向",
  "uiIdx": "6",
  "range": "1840-1939",
  "chapterUid": 2
 },
 {
  "level": 3,
  "text": "低利率环境下，资金自然会流向看起来稳妥、涨势强、又容易抵押的资产，房地产尤其符合这些条件",
  "uiIdx": "6.1",
  "range": "1840-1939",
  "chapterUid": 2
 },
 {
  "level": 4,
  "text": "土地可以进行抵押，当价格上涨的时候，抵押的额度就会更高，贷到新的钱再去购买土地，购买的人多了，价格就会继续上涨。",
  "uiIdx": "",
  "range": "1939-2018",
  "chapterUid": 2
 },
 {
  "level": 4,
  "text": "股市的道理也是相同的。企业股价上涨了，融资更加容易，账面的财富增加了，市场就更加看好它的未来。",
  "uiIdx": "",
  "range": "2052-2088",
  "chapterUid": 2
 },
 {
  "level": 2,
  "text": "日本泡沫的产生与影响",
  "uiIdx": "7",
  "range": "2824-2899",
  "chapterUid": 2
 },
 {
  "level": 3,
  "text": "日本的这场泡沫是由制度、政策以及大众预期相互作用的结果，不能简单地归结到少数投机者的贪婪",
  "uiIdx": "7.1",
  "range": "2824-2899",
  "chapterUid": 2
 },
 {
  "level": 4,
  "text": "信用可以理解为借钱能力，它会额外创造购买力。",
  "uiIdx": "",
  "range": "2154-2199",
  "chapterUid": 2
 },
 {
  "level": 4,
  "text": "当所有人都期待抵押物升值时，抵押价格本身也会受到集体预期推动。",
  "uiIdx": "",
  "range": "2751-2824",
  "chapterUid": 2
 },
 {
  "level": 1,
  "text": "（五） 泡沫破裂",
  "uiIdx": "",
  "range": "",
  "chapterUid": 2
 },
 {
  "level": 2,
  "text": "日本泡沫破裂的过程与影响",
  "uiIdx": "1",
  "range": "551-620",
  "chapterUid": 2
 },
 {
  "level": 3,
  "text": "日本经济泡沫破裂，资产价格剧烈震荡",
  "uiIdx": "1.1",
  "range": "551-620",
  "chapterUid": 2
 },
 {
  "level": 4,
  "text": "1989年，日本开始意识到长期低利率和资产价格过热所带来的风险，从这一年的5月开始加息，资金成本也随之上涨，大家购置资产的欲望也就变淡了。",
  "uiIdx": "",
  "range": "551-620",
  "chapterUid": 2
 },
 {
  "level": 4,
  "text": "股市先是跌了一跤，房地产也跟着跌到了谷底。",
  "uiIdx": "",
  "range": "620-717",
  "chapterUid": 2
 },
 {
  "level": 3,
  "text": "泡沫破裂导致资产负债表出现危机",
  "uiIdx": "1.2",
  "range": "863-906",
  "chapterUid": 2
 },
 {
  "level": 4,
  "text": "企业手中的土地，厂房，股票和现金是资产；欠下银行的贷款，发行的债券是负债。",
  "uiIdx": "",
  "range": "863-923",
  "chapterUid": 2
 },
 {
  "level": 4,
  "text": "泡沫疯涨时资产价格高，负债看起来不算什么；但一旦价格崩，资产大缩水，欠人的钱却一分也不会少。",
  "uiIdx": "",
  "range": "923-969",
  "chapterUid": 2
 },
 {
  "level": 2,
  "text": "泡沫破裂后的经济困境",
  "uiIdx": "2",
  "range": "1160-1238",
  "chapterUid": 2
 },
 {
  "level": 3,
  "text": "货币政策效果降低，经济陷入长期低增长",
  "uiIdx": "2.1",
  "range": "1160-1238",
  "chapterUid": 2
 },
 {
  "level": 4,
  "text": "央行将利率降低到地板上，经济应该会有所起色，但是企业要是被债务给吓破了胆，拿了现金就只能去还贷。",
  "uiIdx": "",
  "range": "1160-1238",
  "chapterUid": 2
 },
 {
  "level": 4,
  "text": "老百姓看到房价下跌、工资停滞，也会自然而然地多存钱，少花钱。",
  "uiIdx": "",
  "range": "1238-1268",
  "chapterUid": 2
 },
 {
  "level": 3,
  "text": "企业面临痛苦蜕变或灭顶之灾",
  "uiIdx": "2.2",
  "range": "1370-1390",
  "chapterUid": 2
 },
 {
  "level": 4,
  "text": "在泡沫时期，许多公司手中握有土地和股票。甚至通过炒股炒地来粉饰利润。",
  "uiIdx": "",
  "range": "1370-1404",
  "chapterUid": 2
 },
 {
  "level": 4,
  "text": "等价格下跌，账面亏损隐藏不住，抵押物价值也缩水，再融资难以登天。",
  "uiIdx": "",
  "range": "1404-1459",
  "chapterUid": 2
 },
 {
  "level": 4,
  "text": "以往借助资产增值就可以掩盖的问题，现在必须硬着头皮依靠主营业务现金流来承担。",
  "uiIdx": "",
  "range": "1459-1539",
  "chapterUid": 2
 },
 {
  "level": 2,
  "text": "银行在泡沫破裂后的困境与选择",
  "uiIdx": "3",
  "range": "1654-1749",
  "chapterUid": 2
 },
 {
  "level": 3,
  "text": "银行积累大量不良贷款",
  "uiIdx": "3.1",
  "range": "1654-1749",
  "chapterUid": 2
 },
 {
  "level": 4,
  "text": "当资产价格出现下跌的情况时，借款人还款的能力就会随之减弱，抵押物也变得不值钱了，那么银行就会积累大量不良贷款，借款人无法按照约定还本付息的贷款。",
  "uiIdx": "",
  "range": "1654-1749",
  "chapterUid": 2
 },
 {
  "level": 3,
  "text": "银行面临承认损失或慢慢消化的选择",
  "uiIdx": "3.2",
  "range": "1804-1856",
  "chapterUid": 2
 },
 {
  "level": 4,
  "text": "承认损失就意味着企业将会成批地进行破产，银行也要进行重组。",
  "uiIdx": "",
  "range": "1804-1856",
  "chapterUid": 2
 },
 {
  "level": 4,
  "text": "慢慢地消化虽然能够延缓冲击，但是会让资金长时间低效空转。",
  "uiIdx": "",
  "range": "1856-1884",
  "chapterUid": 2
 },
 {
  "level": 3,
  "text": "日本选择长期的延迟策略，导致泡沫破裂转变为长期信用收缩以及生产率的滑坡。",
  "uiIdx": "3.3",
  "range": "1884-1968",
  "chapterUid": 2
 },
 {
  "level": 1,
  "text": "（六） 通缩社会",
  "uiIdx": "",
  "range": "",
  "chapterUid": 2
 },
 {
  "level": 2,
  "text": "通缩社会的表现和影响",
  "uiIdx": "1",
  "range": "581-668",
  "chapterUid": 2
 },
 {
  "level": 3,
  "text": "通缩导致企业、老百姓和政府的行为方式改变，压低收入和投资意愿",
  "uiIdx": "1.1",
  "range": "581-668",
  "chapterUid": 2
 },
 {
  "level": 4,
  "text": "企业认为东西卖不出去，就不敢进行扩大生产。",
  "uiIdx": "",
  "range": "668-713",
  "chapterUid": 2
 },
 {
  "level": 4,
  "text": "老百姓觉得以后买东西会更加便宜，就会将消费往后推。",
  "uiIdx": "",
  "range": "713-738",
  "chapterUid": 2
 },
 {
  "level": 4,
  "text": "企业为了能够保住利润，就会继续降薪、裁员，债务方面的压力也会变得更大。",
  "uiIdx": "",
  "range": "738-773",
  "chapterUid": 2
 },
 {
  "level": 2,
  "text": "日本通缩困境的原因",
  "uiIdx": "2",
  "range": "773-862",
  "chapterUid": 2
 },
 {
  "level": 3,
  "text": "日本近些年来出现的通缩困境，既和泡沫破裂之后债务修复存在关联，也随着人口结构的变化而不断加剧",
  "uiIdx": "2.1",
  "range": "773-862",
  "chapterUid": 2
 },
 {
  "level": 4,
  "text": "老龄化不仅表现为老年人口增加，劳动年龄人口占比也在下降。",
  "uiIdx": "",
  "range": "862-920",
  "chapterUid": 2
 },
 {
  "level": 4,
  "text": "这种变化如同慢性病一般，渗透到消费，储蓄，财政以及劳动力市场当中的每个角落。",
  "uiIdx": "",
  "range": "920-958",
  "chapterUid": 2
 },
 {
  "level": 2,
  "text": "通缩社会的问题",
  "uiIdx": "3",
  "range": "1843-1893",
  "chapterUid": 2
 },
 {
  "level": 3,
  "text": "长期的通缩使得财政背负着沉重的负担，政府为了去拉动需求，就不得不不断地增加公共方面的支出",
  "uiIdx": "3.1",
  "range": "1843-1893",
  "chapterUid": 2
 },
 {
  "level": 4,
  "text": "政府为了去拉动需求，就不得不不断地增加公共方面的支出，从而使得债务的规模如同滚雪球一般变得越发庞大。",
  "uiIdx": "",
  "range": "1843-1893",
  "chapterUid": 2
 },
 {
  "level": 3,
  "text": "通缩还会转变为一种自我实现预言，企业看到市场需求呈现出疲软的态势，便不敢给员工提高薪水；老百姓看到工资不涨，便自然而然地捂紧钱包不进行消费",
  "uiIdx": "3.2",
  "range": "1960-1986",
  "chapterUid": 2
 },
 {
  "level": 4,
  "text": "企业看到市场需求呈现出疲软的态势，便不敢给员工提高薪水。",
  "uiIdx": "",
  "range": "1932-1960",
  "chapterUid": 2
 },
 {
  "level": 4,
  "text": "老百姓看到工资不涨，便自然而然地捂紧钱包不进行消费。",
  "uiIdx": "",
  "range": "1960-1986",
  "chapterUid": 2
 },
 {
  "level": 1,
  "text": "（七） 安倍经济学",
  "uiIdx": "",
  "range": "",
  "chapterUid": 2
 },
 {
  "level": 2,
  "text": "安倍经济学的目的和策略",
  "uiIdx": "1",
  "range": "589-664",
  "chapterUid": 2
 },
 {
  "level": 3,
  "text": "安倍经济学的目的是将通缩的包袱予以甩掉，提振增长的预期，使得企业能够多赚一些钱，并且推动深层次结构性的改革。",
  "uiIdx": "1.1",
  "range": "589-664",
  "chapterUid": 2
 },
 {
  "level": 3,
  "text": "安倍经济学概括为三支箭：激进的货币宽松、灵活的财政政策和结构性改革",
  "uiIdx": "1.2",
  "range": "664-722",
  "chapterUid": 2
 },
 {
  "level": 4,
  "text": "货币宽松的目的在于解决钱以及信心方面的问题。",
  "uiIdx": "",
  "range": "722-767",
  "chapterUid": 2
 },
 {
  "level": 4,
  "text": "财政政策就是政府自己下场去花钱，解决需求不够的问题。",
  "uiIdx": "",
  "range": "1034-1090",
  "chapterUid": 2
 },
 {
  "level": 4,
  "text": "结构性的改革解决了一个国家的体质问题，即长期增长的潜力。",
  "uiIdx": "",
  "range": "1176-1227",
  "chapterUid": 2
 },
 {
  "level": 2,
  "text": "安倍经济学的实施效果",
  "uiIdx": "2",
  "range": "986-1034",
  "chapterUid": 2
 },
 {
  "level": 3,
  "text": "在安倍经济学的初期，这一套组合拳的效果确实非常明显：日元出现了贬值的情况，而企业的利润也上升了",
  "uiIdx": "2.1",
  "range": "986-1034",
  "chapterUid": 2
 },
 {
  "level": 4,
  "text": "央行开始大量购买国债，实际上就是在向金融系统里面撒钱，压低长期利率，告诉大家，我们绝对不忍受通缩。",
  "uiIdx": "",
  "range": "767-816",
  "chapterUid": 2
 },
 {
  "level": 4,
  "text": "当企业以及老百姓认为未来物价将会温和地上涨的时候，企业才敢投资、涨工资。",
  "uiIdx": "",
  "range": "908-986",
  "chapterUid": 2
 },
 {
  "level": 3,
  "text": "安倍经济学好的一方面是终结了日本政策一直以来的犹豫不决状态，释放出抗通缩的强大信号；企业的利润以及就业确实得到了改善",
  "uiIdx": "2.2",
  "range": "1353-1419",
  "chapterUid": 2
 },
 {
  "level": 4,
  "text": "过去，日本是一潭死水，物价不涨工资不涨，安倍之后，企业的利润有了好转，资产价格有了回升，招人变得困难了。",
  "uiIdx": "",
  "range": "1845-1920",
  "chapterUid": 2
 },
 {
  "level": 2,
  "text": "安倍经济学的局限性和问题",
  "uiIdx": "3",
  "range": "1436-1522",
  "chapterUid": 2
 },
 {
  "level": 3,
  "text": "工资的涨幅并没有长期地超出物价的水平，老百姓实际的购买力提升得有限",
  "uiIdx": "3.1",
  "range": "1436-1522",
  "chapterUid": 2
 },
 {
  "level": 4,
  "text": "日本企业在过去存在一个老问题，就是喜欢相互持股，安倍改革促使企业提升股东回报，增强透明度，这使得国际投资者对日本企业的印象大为改变。",
  "uiIdx": "",
  "range": "1522-1618",
  "chapterUid": 2
 },
 {
  "level": 4,
  "text": "但是，公司治理方面的改革也并非是万能的。企业要提升资本效率，一般通过卖出资产，回购股票来达成。",
  "uiIdx": "",
  "range": "1618-1688",
  "chapterUid": 2
 },
 {
  "level": 4,
  "text": "这对于股东而言是好事，但是对于企业长期战略而言，仅仅依靠这些是远远不够的。",
  "uiIdx": "",
  "range": "1688-1748",
  "chapterUid": 2
 },
 {
  "level": 4,
  "text": "要是改革不能够同时带动研发的投入、人才的流动，那么它就很容易停留在账面的财务指标改善上。",
  "uiIdx": "",
  "range": "1748-1792",
  "chapterUid": 2
 },
 {
  "level": 1,
  "text": "（八） 今日拐点",
  "uiIdx": "",
  "range": "",
  "chapterUid": 2
 },
 {
  "level": 2,
  "text": "日本经济现状",
  "uiIdx": "1",
  "range": "571-599",
  "chapterUid": 2
 },
 {
  "level": 3,
  "text": "日本工资水平上升，公司治理改革持续。",
  "uiIdx": "1.1",
  "range": "571-599",
  "chapterUid": 2
 },
 {
  "level": 3,
  "text": "疫情后供应链混乱，能源及粮食价格持续上涨，地缘政治推高贸易成本",
  "uiIdx": "1.2",
  "range": "636-674",
  "chapterUid": 2
 },
 {
  "level": 4,
  "text": "日本长期未见到通胀，进口成本带来物价压力。",
  "uiIdx": "",
  "range": "674-709",
  "chapterUid": 2
 },
 {
  "level": 3,
  "text": "日元走弱使得影响更为复杂",
  "uiIdx": "1.3",
  "range": "774-813",
  "chapterUid": 2
 },
 {
  "level": 4,
  "text": "日元贬值对出口商是好事，但对依赖进口产品的家庭及企业不利。",
  "uiIdx": "",
  "range": "813-859",
  "chapterUid": 2
 },
 {
  "level": 4,
  "text": "日本旅游业因外国游客认为到日本消费变便宜而受益。",
  "uiIdx": "",
  "range": "859-894",
  "chapterUid": 2
 },
 {
  "level": 2,
  "text": "工资谈判的重要性",
  "uiIdx": "2",
  "range": "967-1023",
  "chapterUid": 2
 },
 {
  "level": 3,
  "text": "工资谈判在日本尤为重要，每年春天都会与工会谈判工资",
  "uiIdx": "2.1",
  "range": "967-1023",
  "chapterUid": 2
 },
 {
  "level": 4,
  "text": "倘若工资能够持续上涨，物价上涨便有收入支撑，能够形成一个良性循环。",
  "uiIdx": "",
  "range": "967-1023",
  "chapterUid": 2
 },
 {
  "level": 4,
  "text": "如果工资跑不过物价，通胀则会直接减少大家的消费意愿。",
  "uiIdx": "",
  "range": "1023-1049",
  "chapterUid": 2
 },
 {
  "level": 2,
  "text": "日本央行的政策调整",
  "uiIdx": "3",
  "range": "1049-1104",
  "chapterUid": 2
 },
 {
  "level": 3,
  "text": "2024年，日本央行终结负利率政策，政策开始尝试回归常态。",
  "uiIdx": "3.1",
  "range": "1049-1104",
  "chapterUid": 2
 },
 {
  "level": 2,
  "text": "日本股市的回升",
  "uiIdx": "4",
  "range": "1104-1163",
  "chapterUid": 2
 },
 {
  "level": 3,
  "text": "日经指数突破历史高点，全球金融领域的一个大新闻",
  "uiIdx": "4.1",
  "range": "1104-1163",
  "chapterUid": 2
 },
 {
  "level": 4,
  "text": "指数创出新高只能表明上市公司市值发生了变化，并不意味着整个经济重新回到高速增长的状态。",
  "uiIdx": "",
  "range": "1194-1262",
  "chapterUid": 2
 },
 {
  "level": 3,
  "text": "日本股市回升是多方面的因素共同作用的结果",
  "uiIdx": "4.2",
  "range": "1262-1339",
  "chapterUid": 2
 },
 {
  "level": 4,
  "text": "企业盈利得到了改善，尤其是出口企业享受到日元贬值带来的好处。",
  "uiIdx": "",
  "range": "1262-1339",
  "chapterUid": 2
 },
 {
  "level": 4,
  "text": "公司治理的改革提升了资本的效率，全球的投资者也正在寻找配置的机会。",
  "uiIdx": "",
  "range": "1339-1372",
  "chapterUid": 2
 },
 {
  "level": 4,
  "text": "同时半导体以及高端制造也在供应链的重组当中被重视起来。",
  "uiIdx": "",
  "range": "1372-1399",
  "chapterUid": 2
 },
 {
  "level": 2,
  "text": "日本半导体供应链的机会",
  "uiIdx": "5",
  "range": "1462-1515",
  "chapterUid": 2
 },
 {
  "level": 3,
  "text": "日本在硅片、化学材料、精密设备等领域仍有优势",
  "uiIdx": "5.1",
  "range": "1462-1515",
  "chapterUid": 2
 },
 {
  "level": 4,
  "text": "全球各国都在关注供应链安全，日本以扎实工业基础获得了不少新的投资。",
  "uiIdx": "",
  "range": "1515-1548",
  "chapterUid": 2
 },
 {
  "level": 2,
  "text": "日本面临的人口挑战",
  "uiIdx": "6",
  "range": "1655-1713",
  "chapterUid": 2
 },
 {
  "level": 3,
  "text": "老龄化正在持续地削弱劳动力的供给，医疗养老方面的开支变得更高",
  "uiIdx": "6.1",
  "range": "1655-1713",
  "chapterUid": 2
 },
 {
  "level": 4,
  "text": "尽管企业的利润已经得到了改善，但是如果劳动人口处于减少的状态，服务业的效率也提不上去，那么内需的扩张必然会很快碰到天花板。",
  "uiIdx": "",
  "range": "1713-1774",
  "chapterUid": 2
 }
]