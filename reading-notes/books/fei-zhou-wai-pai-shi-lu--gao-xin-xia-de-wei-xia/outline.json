[
 {
  "level": 1,
  "text": "01",
  "uiIdx": "",
  "range": "",
  "chapterUid": 3
 },
 {
  "level": 2,
  "text": "作者周慕的非洲尼日利亚之行",
  "uiIdx": "1",
  "range": "559-599",
  "chapterUid": 3
 },
 {
  "level": 3,
  "text": "周慕是东北人，家里的独生子，大学通信专业毕业后，经历了国有、民营、外资各种通信企业，由青涩走向成熟。",
  "uiIdx": "1.1",
  "range": "559-599",
  "chapterUid": 3
 },
 {
  "level": 3,
  "text": "周慕的第一次海外出差是非洲尼日利亚之行",
  "uiIdx": "1.2",
  "range": "599-679",
  "chapterUid": 3
 },
 {
  "level": 4,
  "text": "大学毕业后，周慕拿到了中国一家巨头科技公司的offer。",
  "uiIdx": "",
  "range": "599-679",
  "chapterUid": 3
 },
 {
  "level": 4,
  "text": "公司派遣他去非洲尼日利亚出差。",
  "uiIdx": "",
  "range": "765-827",
  "chapterUid": 3
 },
 {
  "level": 2,
  "text": "尼日利亚的艰苦环境",
  "uiIdx": "2",
  "range": "1018-1115",
  "chapterUid": 3
 },
 {
  "level": 3,
  "text": "尼日利亚疟疾横行，病毒靠蚊子传播，出行前已经记不清打了多少防疫针",
  "uiIdx": "2.1",
  "range": "1018-1115",
  "chapterUid": 3
 },
 {
  "level": 4,
  "text": "如果在那儿不幸中招，五年内不能生育下一代，否则孩子也会被传染。",
  "uiIdx": "",
  "range": "1018-1115",
  "chapterUid": 3
 },
 {
  "level": 3,
  "text": "非洲HIV携带者比率很高，如无必要，千万不要去当地医院接触血液类物品",
  "uiIdx": "2.2",
  "range": "1115-1192",
  "chapterUid": 3
 },
 {
  "level": 4,
  "text": "曾有一个员工就因为输血被感染了。",
  "uiIdx": "",
  "range": "1115-1192",
  "chapterUid": 3
 },
 {
  "level": 2,
  "text": "尼日利亚的生活和工作",
  "uiIdx": "3",
  "range": "2001-2070",
  "chapterUid": 3
 },
 {
  "level": 3,
  "text": "尼日利亚的基础设施很差，甚至还能看到老鼠过来打招呼",
  "uiIdx": "3.1",
  "range": "2001-2070",
  "chapterUid": 3
 },
 {
  "level": 4,
  "text": "到达拉各斯后，看到一个大肚子、戴头巾的当地人举着公司的logo接我们，互相确认身份后，我们坐上了他的车。",
  "uiIdx": "",
  "range": "1663-1717",
  "chapterUid": 3
 },
 {
  "level": 4,
  "text": "一小时后，终于到达了目的地。",
  "uiIdx": "",
  "range": "1835-1849",
  "chapterUid": 3
 },
 {
  "level": 4,
  "text": "司机把我们送到员工宿舍，定睛一看，是两层高的连排别墅。",
  "uiIdx": "",
  "range": "1849-1902",
  "chapterUid": 3
 },
 {
  "level": 3,
  "text": "公司对员工的日常生活照顾得非常细致，如果有私事要办，可以约公司的司机去处理",
  "uiIdx": "3.2",
  "range": "2372-2438",
  "chapterUid": 3
 },
 {
  "level": 4,
  "text": "当天我发现我的手机没有CDMA网络，于是，我约了个司机带我去买手机。",
  "uiIdx": "",
  "range": "2438-2472",
  "chapterUid": 3
 },
 {
  "level": 4,
  "text": "原本以为这位大兄弟会带我去商场或专卖店，就像国内一样，然而，他居然把我载到一个城乡结合部，在一个三轮车的摊前停了下来。",
  "uiIdx": "",
  "range": "2472-2553",
  "chapterUid": 3
 },
 {
  "level": 4,
  "text": "我目瞪口呆地看着这些手机盒子，最终只能入乡随俗，花了五六百人民币买了一个国内价值两三百的诺基亚平板手机。",
  "uiIdx": "",
  "range": "2553-2628",
  "chapterUid": 3
 },
 {
  "level": 3,
  "text": "我们就投入了紧张繁忙的工作中。",
  "uiIdx": "3.3",
  "range": "2628-2669",
  "chapterUid": 3
 },
 {
  "level": 1,
  "text": "02",
  "uiIdx": "",
  "range": "",
  "chapterUid": 3
 },
 {
  "level": 2,
  "text": "作者在尼日利亚的工作生活",
  "uiIdx": "1",
  "range": "595-668",
  "chapterUid": 3
 },
 {
  "level": 3,
  "text": "作者负责当地最大运营商的网络升级改造项目，还要负责邻国埃塞俄比亚和喀麦隆的一部分网络仿真工作",
  "uiIdx": "1.1",
  "range": "595-668",
  "chapterUid": 3
 },
 {
  "level": 4,
  "text": "每天都要路测、写报告、优化网络，跟客户沟通交流、与第三方打口水仗，忙得像一个不停旋转的机器。",
  "uiIdx": "",
  "range": "668-733",
  "chapterUid": 3
 },
 {
  "level": 3,
  "text": "作者每天晚上下班回到宿舍，还要继续挑灯夜战，不光要高质量地完成技术报告，还要与蚊子、老鼠斗智斗勇",
  "uiIdx": "1.2",
  "range": "733-804",
  "chapterUid": 3
 },
 {
  "level": 4,
  "text": "非洲的蚊子长得很漂亮，肚子上是一圈一圈的花纹，身上还装了消音器，当你知道痒的时候，其实早就中招了。",
  "uiIdx": "",
  "range": "804-876",
  "chapterUid": 3
 },
 {
  "level": 4,
  "text": "为了防止被传染疟疾，每天晚上，我都全副武装，只露头和手，然后用电风扇吹着脑袋，奋笔疾书。",
  "uiIdx": "",
  "range": "876-943",
  "chapterUid": 3
 },
 {
  "level": 2,
  "text": "刘祥的生病及治疗",
  "uiIdx": "2",
  "range": "980-1004",
  "chapterUid": 3
 },
 {
  "level": 3,
  "text": "刘祥发烧感冒，高强度的工作，恶劣的生活环境，让他每天低烧不退",
  "uiIdx": "2.1",
  "range": "980-1004",
  "chapterUid": 3
 },
 {
  "level": 4,
  "text": "即便他把从国内带来的感冒药抗生素都吃完了也没控制住。",
  "uiIdx": "",
  "range": "1004-1084",
  "chapterUid": 3
 },
 {
  "level": 3,
  "text": "刘祥去医院检查，结果是普通感冒，打了两次退烧针，最终刘祥的感冒用了近两周的时间自愈了",
  "uiIdx": "2.2",
  "range": "1429-1500",
  "chapterUid": 3
 },
 {
  "level": 4,
  "text": "他回国后第一时间就去医院检查了HIV，所幸，一切都好。",
  "uiIdx": "",
  "range": "1500-1527",
  "chapterUid": 3
 },
 {
  "level": 2,
  "text": "作者的口语锻炼",
  "uiIdx": "3",
  "range": "1674-1769",
  "chapterUid": 3
 },
 {
  "level": 3,
  "text": "最初与人交流谈判时，作者经常憋得满脸通红，因为口语实在是作者的短板",
  "uiIdx": "3.1",
  "range": "1674-1769",
  "chapterUid": 3
 },
 {
  "level": 4,
  "text": "为此，作者每天拼命进行口语锻炼。",
  "uiIdx": "",
  "range": "1674-1769",
  "chapterUid": 3
 },
 {
  "level": 3,
  "text": "作者每天拼命进行口语锻炼，直到某天在一次重要会议上，我终于能用英语侃侃而谈",
  "uiIdx": "3.2",
  "range": "1674-1769",
  "chapterUid": 3
 },
 {
  "level": 4,
  "text": "那段时间，我能做的只是把我带来的不同种类的感冒药给他服用，在下班的时候挤出时间陪他去医院，然后再加班完成工作。",
  "uiIdx": "",
  "range": "1527-1605",
  "chapterUid": 3
 },
 {
  "level": 1,
  "text": "03",
  "uiIdx": "",
  "range": "",
  "chapterUid": 3
 },
 {
  "level": 2,
  "text": "周末聚餐的放松与压力",
  "uiIdx": "1",
  "range": "542-616",
  "chapterUid": 3
 },
 {
  "level": 3,
  "text": "周末聚餐是放松减压的好时光",
  "uiIdx": "1.1",
  "range": "542-616",
  "chapterUid": 3
 },
 {
  "level": 4,
  "text": "有同事从国内带来电磁炉、锅和火锅底料，我们会去海鲜市场买来海鲜，然后大家围坐在火锅旁享受着国内的美食。",
  "uiIdx": "",
  "range": "542-616",
  "chapterUid": 3
 },
 {
  "level": 3,
  "text": "海鲜市场满足着我们的家乡胃，也暂时冲淡了我们的压力和对家人的想念。",
  "uiIdx": "1.2",
  "range": "973-1075",
  "chapterUid": 3
 },
 {
  "level": 2,
  "text": "路测工作的艰辛与收获",
  "uiIdx": "2",
  "range": "1162-1220",
  "chapterUid": 3
 },
 {
  "level": 3,
  "text": "路测工作让我对这个城市和生活在这里的人的贫穷、疾病、贪婪有了更深入的了解。",
  "uiIdx": "2.1",
  "range": "1162-1220",
  "chapterUid": 3
 },
 {
  "level": 2,
  "text": "尼日尼亚海滩的遭遇",
  "uiIdx": "3",
  "range": "973-1075",
  "chapterUid": 3
 },
 {
  "level": 3,
  "text": "尼日尼亚海滩的海鲜市场便宜又美味",
  "uiIdx": "3.1",
  "range": "973-1075",
  "chapterUid": 3
 },
 {
  "level": 4,
  "text": "一斤一个的大螃蟹只要一元人民币。",
  "uiIdx": "",
  "range": "973-1075",
  "chapterUid": 3
 },
 {
  "level": 2,
  "text": "当地司机的敲诈与勒索",
  "uiIdx": "4",
  "range": "1220-1312",
  "chapterUid": 3
 },
 {
  "level": 3,
  "text": "当地司机借手机后丢失，被怀疑敲诈勒索",
  "uiIdx": "4.1",
  "range": "1220-1312",
  "chapterUid": 3
 },
 {
  "level": 4,
  "text": "司机借我的手机打电话，一会儿，他回来跟我说手机丢了。",
  "uiIdx": "",
  "range": "1220-1312",
  "chapterUid": 3
 },
 {
  "level": 4,
  "text": "我气不打一处来，想到平时同事们对当地司机的差评，我知道肯定有猫腻，直接对他说：“好的，我告诉你老板，从你工资里扣钱来还我手机。”。",
  "uiIdx": "",
  "range": "1312-1391",
  "chapterUid": 3
 },
 {
  "level": 3,
  "text": "被警察敲诈，汽车轮胎也被放了气",
  "uiIdx": "4.2",
  "range": "1580-1653",
  "chapterUid": 3
 },
 {
  "level": 4,
  "text": "两个警察，一男一女，穿着土黄色的警服，手里拿着一根棍子，直接让我们停车，并将我们连人带车抓到警察局。",
  "uiIdx": "",
  "range": "1580-1653",
  "chapterUid": 3
 },
 {
  "level": 4,
  "text": "警察局有一个小小的院子，黄色的平房看不到屋顶，院子里停着两辆破旧的警车。我站在院子里，给老板打电话，请他们处理这件事。",
  "uiIdx": "",
  "range": "1813-1895",
  "chapterUid": 3
 },
 {
  "level": 4,
  "text": "过了一会儿，那个胖胖的女警察居然跑来问我：“Could I go to your hotel tonight（今夜我能跟你回酒店吗）？”。",
  "uiIdx": "",
  "range": "1961-2052",
  "chapterUid": 3
 },
 {
  "level": 4,
  "text": "光天化日下的抢劫，我也是第一次见识到了。",
  "uiIdx": "",
  "range": "2212-2255",
  "chapterUid": 3
 },
 {
  "level": 2,
  "text": "公司的协调与解决",
  "uiIdx": "5",
  "range": "2110-2184",
  "chapterUid": 3
 },
 {
  "level": 3,
  "text": "公司通过当地运营商的协调，很快跟警察达成协议",
  "uiIdx": "5.1",
  "range": "2110-2184",
  "chapterUid": 3
 },
 {
  "level": 4,
  "text": "一个小时后，客户送来了6000奈拉，我被赎了出来。",
  "uiIdx": "",
  "range": "2110-2184",
  "chapterUid": 3
 },
 {
  "level": 4,
  "text": "临走时，他们又收了我几百奈拉的打气费，才把车胎充好了气。",
  "uiIdx": "",
  "range": "2184-2212",
  "chapterUid": 3
 },
 {
  "level": 1,
  "text": "04",
  "uiIdx": "",
  "range": "",
  "chapterUid": 3
 },
 {
  "level": 2,
  "text": "非洲帕塔寇特的网络升级改造",
  "uiIdx": "1",
  "range": "619-673",
  "chapterUid": 3
 },
 {
  "level": 3,
  "text": "项目地点偏远，治安状况不佳",
  "uiIdx": "1.1",
  "range": "619-673",
  "chapterUid": 3
 },
 {
  "level": 4,
  "text": "帕塔寇特是离拉各斯很远的小港口城市，至今从没有人被派去那里。",
  "uiIdx": "",
  "range": "619-673",
  "chapterUid": 3
 },
 {
  "level": 4,
  "text": "机房的门上居然有好多枪洞，客户叮嘱我们下班早些回宿舍，天黑了关好门窗，千万不要出门，因为，这里的反抗军和当地政府军在交战。",
  "uiIdx": "",
  "range": "945-1017",
  "chapterUid": 3
 },
 {
  "level": 3,
  "text": "客户雇佣当地警察保障员工安全",
  "uiIdx": "1.2",
  "range": "1093-1153",
  "chapterUid": 3
 },
 {
  "level": 4,
  "text": "为了路测的安全，客户为我们雇佣了当地警察，所以，每天我们出门都有警察押车。",
  "uiIdx": "",
  "range": "1093-1153",
  "chapterUid": 3
 },
 {
  "level": 2,
  "text": "非洲的种族屠杀经历",
  "uiIdx": "2",
  "range": "1434-1498",
  "chapterUid": 3
 },
 {
  "level": 3,
  "text": "中国兄弟在种族屠杀中逃生",
  "uiIdx": "2.1",
  "range": "1434-1498",
  "chapterUid": 3
 },
 {
  "level": 4,
  "text": "他自己已经一天半没吃东西了，我们赶紧把自己仅剩的两袋方便面和一个卤蛋都给他充饥。",
  "uiIdx": "",
  "range": "1434-1498",
  "chapterUid": 3
 },
 {
  "level": 4,
  "text": "吃完后，他才缓过一点精神，长长地吐了一口气说：“我是一个工程队的，在附近做工程，我遇到了种族屠杀。”。",
  "uiIdx": "",
  "range": "1498-1570",
  "chapterUid": 3
 },
 {
  "level": 4,
  "text": "他背靠在墙上，嘴唇还在颤抖，他接着说：“我们工程队就在他们混战的附近，他们搞暴乱，我们看到后，立刻从工地上向外跑。”。",
  "uiIdx": "",
  "range": "1732-1812",
  "chapterUid": 3
 },
 {
  "level": 4,
  "text": "“我们从郊区徒步20公里走到市里，一路上都是贫民窟，当地霍乱流行，连口水都不敢喝。在市区转了很长时间后，我看到你们这里有灯光，没想到碰到同胞了，我真是太幸运！”。",
  "uiIdx": "",
  "range": "1894-1996",
  "chapterUid": 3
 },
 {
  "level": 3,
  "text": "对种族屠杀的深刻感受",
  "uiIdx": "2.2",
  "range": "2054-2075",
  "chapterUid": 3
 },
 {
  "level": 4,
  "text": "只有身处海外，才能真切明白同胞是什么概念。",
  "uiIdx": "",
  "range": "2054-2075",
  "chapterUid": 3
 },
 {
  "level": 4,
  "text": "只有亲历战火与疾病的肆虐的人，才能感受到一个稳定国家背后所能带给你的安全感。",
  "uiIdx": "",
  "range": "2299-2375",
  "chapterUid": 3
 },
 {
  "level": 4,
  "text": "也只有那般近距离地接触过生死，才能深切感受到生命的可贵与厚重……。",
  "uiIdx": "",
  "range": "2375-2430",
  "chapterUid": 3
 }
]