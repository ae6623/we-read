[{"level": 1, "text": "遗忘之地阿拉斯加", "uiIdx": "", "range": "", "chapterUid": 2}, {"level": 2, "text": "阿拉斯加的地理环境", "uiIdx": "1", "range": "669-707", "chapterUid": 2}, {"level": 3, "text": "阿拉斯加位于北冰洋沿岸，冬季寒冷且漫长", "uiIdx": "1.1", "range": "669-707", "chapterUid": 2}, {"level": 4, "text": "2023年12月份有17台车陷入雪坑，那夜起了暴风雪，整整16小时无法救援。2个人冻死在车内。", "uiIdx": "", "range": "669-707", "chapterUid": 2}, {"level": 3, "text": "阿拉斯加人口稀少，冬天只剩3万人", "uiIdx": "1.2", "range": "962-1010", "chapterUid": 2}, {"level": 4, "text": "Fairbanks常居民有10万，冬天只剩3万，那7万人都无法忍受寒冷和无聊，去温暖地方度假了。", "uiIdx": "", "range": "962-1010", "chapterUid": 2}, {"level": 2, "text": "阿拉斯加的经济状况", "uiIdx": "2", "range": "1891-1915", "chapterUid": 2}, {"level": 3, "text": "阿拉斯加人均工资每年$7.5万，全美第二高的州", "uiIdx": "2.1", "range": "1891-1915", "chapterUid": 2}, {"level": 4, "text": "这里很好赚钱。因为缺人手，比如我做导游，都是公司求着我来的，不怕失业。", "uiIdx": "", "range": "1842-1870", "chapterUid": 2}, {"level": 3, "text": "阿拉斯加政府每年发放石油红利", "uiIdx": "2.2", "range": "1951-1975", "chapterUid": 2}, {"level": 4, "text": "2022年每人$3300，一家三口就近$1万。", "uiIdx": "", "range": "1951-1975", "chapterUid": 2}, {"level": 2, "text": "阿拉斯加的生活方式和娱乐活动", "uiIdx": "3", "range": "848-875", "chapterUid": 2}, {"level": 3, "text": "阿拉斯加人喜欢户外运动，如徒步、钓鱼、隐居、沿河漂流", "uiIdx": "3.1", "range": "848-875", "chapterUid": 2}, {"level": 4, "text": "夏秋多是美国人来旅行，他们徒步、钓鱼、隐居、沿河漂流。过着鲁滨逊那样远离尘嚣的生活。", "uiIdx": "", "range": "848-890", "chapterUid": 2}, {"level": 3, "text": "阿拉斯加有丰富的野生动物资源，如棕熊、黑熊、驯鹿等", "uiIdx": "3.2", "range": "2576-2598", "chapterUid": 2}, {"level": 4, "text": "阿拉斯加熊很多，多是棕熊。黑熊性格温顺，棕熊体型大且暴躁，会袭击人类。", "uiIdx": "", "range": "2563-2598", "chapterUid": 2}, {"level": 4, "text": "驯鹿的头长得像小牛，眼神清亮傻乎乎的，脾气很倔强，不开心了就甩几下头。", "uiIdx": "", "range": "5881-5916", "chapterUid": 2}, {"level": 3, "text": "阿拉斯加有多种独特的娱乐活动，如冰钓、雪地摩托、狗拉雪橇等", "uiIdx": "3.3", "range": "3657-3694", "chapterUid": 2}, {"level": 4, "text": "在冰湖上用电钻打一个盘子大的洞，渔线和钩放下去，上下晃动，不久就有鱼咬钩。", "uiIdx": "", "range": "3657-3694", "chapterUid": 2}, {"level": 4, "text": "骑雪地摩托最高速度可以开到50英里，有的摩托可达100英里。", "uiIdx": "", "range": "8531-8556", "chapterUid": 2}, {"level": 4, "text": "几只哈士奇和阿拉斯加犬兴奋地上蹿下跳，像炮弹一样冲出去。", "uiIdx": "", "range": "8948-8976", "chapterUid": 2}, {"level": 2, "text": "阿拉斯加人的性格特点", "uiIdx": "4", "range": "3109-3127", "chapterUid": 2}, {"level": 3, "text": "阿拉斯加人性格古怪，不爱说话，喜欢孤独和自然", "uiIdx": "4.1", "range": "3109-3127", "chapterUid": 2}, {"level": 4, "text": "这里就像没人管没规矩的“遗忘之地”。", "uiIdx": "", "range": "3109-3127", "chapterUid": 2}, {"level": 4, "text": "我喜欢这些古怪的人，不爱说话的，住在偏远地方的，喜欢动物超过人的，自然之子。", "uiIdx": "", "range": "7047-7086", "chapterUid": 2}, {"level": 3, "text": "阿拉斯加人坚韧不拔，能在艰苦的环境中生存下来", "uiIdx": "4.2", "range": "2041-2061", "chapterUid": 2}, {"level": 4, "text": "一般人干三个月就走了，能熬过一年的很少。", "uiIdx": "", "range": "2041-2061", "chapterUid": 2}, {"level": 4, "text": "他认识的一个酒店前台待了2年，就升职为经理，因为他是资历最老的员工了。", "uiIdx": "", "range": "2061-2096", "chapterUid": 2}]