[
 {
  "level": 1,
  "text": "致敬保罗·海恩",
  "uiIdx": "",
  "range": "",
  "chapterUid": 297
 },
 {
  "level": 2,
  "text": "保罗·海恩的人生经历和教育理念",
  "uiIdx": "1",
  "range": "1833-1855",
  "chapterUid": 297
 },
 {
  "level": 3,
  "text": "保罗·海恩是华盛顿大学经济系的系主任，致力于经济学教育和通识教育",
  "uiIdx": "1.1",
  "range": "1833-1855",
  "chapterUid": 297
 },
 {
  "level": 4,
  "text": "保罗·海恩的目标是建立全国最好的经济学系之一。",
  "uiIdx": "",
  "range": "1833-1855",
  "chapterUid": 297
 },
 {
  "level": 4,
  "text": "保罗·海恩决定重回讲堂，教授入门级的经济学课程。",
  "uiIdx": "",
  "range": "2017-2065",
  "chapterUid": 297
 },
 {
  "level": 3,
  "text": "保罗·海恩认为教师应将自己教授的学科视作基地而非堡垒",
  "uiIdx": "1.2",
  "range": "2523-2554",
  "chapterUid": 297
 },
 {
  "level": 4,
  "text": "他们要做的是从基地出发去探索其他学科，而不是蜷缩在堡垒中享受无忧的生活。",
  "uiIdx": "",
  "range": "2554-2590",
  "chapterUid": 297
 },
 {
  "level": 2,
  "text": "保罗·海恩对经济学教育的贡献",
  "uiIdx": "2",
  "range": "2969-3011",
  "chapterUid": 297
 },
 {
  "level": 3,
  "text": "保罗·海恩改进了本科生课程，全面改革了入门课程",
  "uiIdx": "2.1",
  "range": "2969-3011",
  "chapterUid": 297
 },
 {
  "level": 4,
  "text": "他定期与研究生助教会谈以提高他们的教学质量。",
  "uiIdx": "",
  "range": "2969-3011",
  "chapterUid": 297
 },
 {
  "level": 3,
  "text": "《经济学的思维方式》体现了保罗在经济学教育和通识教育方面的教育方法",
  "uiIdx": "2.2",
  "range": "3081-3115",
  "chapterUid": 297
 },
 {
  "level": 4,
  "text": "这种方法强调社会面临的问题以及如何用经济学说来解释这些问题。",
  "uiIdx": "",
  "range": "3136-3166",
  "chapterUid": 297
 },
 {
  "level": 4,
  "text": "这本书还强调了经济学的优势恰恰如本书的题目所言——经济学是一种思维方式。",
  "uiIdx": "",
  "range": "3181-3222",
  "chapterUid": 297
 },
 {
  "level": 2,
  "text": "保罗·海恩的个人魅力和影响",
  "uiIdx": "3",
  "range": "3429-3468",
  "chapterUid": 297
 },
 {
  "level": 3,
  "text": "保罗·海恩是一位严谨的经济学家，同时也对社区和社会福利有广泛而积极的关注",
  "uiIdx": "3.1",
  "range": "3429-3468",
  "chapterUid": 297
 },
 {
  "level": 4,
  "text": "保罗·海恩信奉个人自由，同时他也深信这种自由对每一位负责任的人类成员提出了相应要求。",
  "uiIdx": "",
  "range": "3429-3468",
  "chapterUid": 297
 },
 {
  "level": 3,
  "text": "保罗·海恩的教学方法对重视通识教育质量的教师而言，提供了源源不断的灵感和启发",
  "uiIdx": "3.2",
  "range": "3011-3052",
  "chapterUid": 297
 },
 {
  "level": 4,
  "text": "每年秋季，作者都会为大一新生开一门讨论课，作为这门课的开场白，作者会向学生介绍保罗。",
  "uiIdx": "",
  "range": "3296-3316",
  "chapterUid": 297
 }
]