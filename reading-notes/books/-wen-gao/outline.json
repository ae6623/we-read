[
 {
  "level": 1,
  "text": "第1章",
  "uiIdx": "",
  "range": "",
  "chapterUid": null
 },
 {
  "level": 2,
  "text": "论文的研究内容",
  "uiIdx": "1",
  "range": "59608-59665",
  "chapterUid": null
 },
 {
  "level": 3,
  "text": "论文对中县干部的晋升机制进行了深入研究",
  "uiIdx": "1.1",
  "range": "48056-48133",
  "chapterUid": null
 },
 {
  "level": 4,
  "text": "包括政绩与晋升的关系，关系与晋升的关系。",
  "uiIdx": "",
  "range": "48056-48133",
  "chapterUid": null
 },
 {
  "level": 4,
  "text": "以及县乡政治精英研究等。",
  "uiIdx": "",
  "range": "49745-49755",
  "chapterUid": null
 },
 {
  "level": 3,
  "text": "论文对中县干部的层级及其人口学特征进行了详细分析",
  "uiIdx": "1.2",
  "range": "59362-59383",
  "chapterUid": null
 },
 {
  "level": 4,
  "text": "揭示了中县干部的群体特征和干部政策。",
  "uiIdx": "",
  "range": "59665-59713",
  "chapterUid": null
 },
 {
  "level": 4,
  "text": "以及中县社会经济的发展阶段。",
  "uiIdx": "",
  "range": "59665-59713",
  "chapterUid": null
 },
 {
  "level": 3,
  "text": "论文对中县干部的构成进行了详细描述",
  "uiIdx": "1.3",
  "range": "59608-59665",
  "chapterUid": null
 },
 {
  "level": 4,
  "text": "以及干部来源和晋升机制等。",
  "uiIdx": "",
  "range": "38788-38838",
  "chapterUid": null
 },
 {
  "level": 4,
  "text": "包括家庭出身、性别、年龄、教育程度和籍贯分布等人口学特征。",
  "uiIdx": "",
  "range": "59608-59665",
  "chapterUid": null
 },
 {
  "level": 2,
  "text": "论文的研究结果",
  "uiIdx": "2",
  "range": "76501-76572",
  "chapterUid": null
 },
 {
  "level": 3,
  "text": "本文主要介绍了中国一个县级领导干部的选拔和晋升情况",
  "uiIdx": "2.1",
  "range": "76501-76572",
  "chapterUid": null
 },
 {
  "level": 4,
  "text": "详细列出了该县各级领导干部的职务和数量。",
  "uiIdx": "",
  "range": "76501-76572",
  "chapterUid": null
 },
 {
  "level": 4,
  "text": "分析了这些领导干部的出身、性别、年龄和学历情况。",
  "uiIdx": "",
  "range": "78638-78759",
  "chapterUid": null
 },
 {
  "level": 3,
  "text": "文章还探讨了领导干部的选拔和晋升机制，以及年龄和学历对领导干部的影响",
  "uiIdx": "2.2",
  "range": "87149-87183",
  "chapterUid": null
 },
 {
  "level": 4,
  "text": "年龄规范对干部的新陈代谢、循环更替和退出机制的建立有重要作用。",
  "uiIdx": "",
  "range": "88410-88451",
  "chapterUid": null
 },
 {
  "level": 4,
  "text": "学历规范要求领导干部逐步提高学历，但实际执行情况并不理想。",
  "uiIdx": "",
  "range": "90444-90485",
  "chapterUid": null
 },
 {
  "level": 3,
  "text": "文章指出，随着公务员制度的实施，中专一代的领导干部将退出政治舞台，这将成为共和国干部史上的一段特殊纪录。",
  "uiIdx": "2.3",
  "range": "99450-99538",
  "chapterUid": null
 },
 {
  "level": 1,
  "text": "_1",
  "uiIdx": "",
  "range": "",
  "chapterUid": null
 },
 {
  "level": 2,
  "text": "中县干部的来源和初职获得途径",
  "uiIdx": "1",
  "range": "32646-32689",
  "chapterUid": null
 },
 {
  "level": 3,
  "text": "干部来源",
  "uiIdx": "1.1",
  "range": "32646-32689",
  "chapterUid": null
 },
 {
  "level": 4,
  "text": "大中专毕业生分配占80%以上，大中专院校是培养领导干部的主要场所。",
  "uiIdx": "",
  "range": "32646-32689",
  "chapterUid": null
 },
 {
  "level": 4,
  "text": "军队转业干部占13%，是培养领导干部的第二渠道。",
  "uiIdx": "",
  "range": "32831-32854",
  "chapterUid": null
 },
 {
  "level": 4,
  "text": "吸收录用的只占6%，一方面是由于吸收录用的干部本来就少，另一方面也说明吸收录用的干部精英程度不高，能够走上县领导岗位的不多。",
  "uiIdx": "",
  "range": "32854-32947",
  "chapterUid": null
 },
 {
  "level": 3,
  "text": "初职获得",
  "uiIdx": "1.2",
  "range": "46571-46614",
  "chapterUid": null
 },
 {
  "level": 4,
  "text": "大中专毕业生的初职获得主要取决于毕业的学校和所学专业，关系资源的运 用以及单位的机会结构等因素。",
  "uiIdx": "",
  "range": "46571-46614",
  "chapterUid": null
 },
 {
  "level": 4,
  "text": "军转干部的初职，则是军队单位，因为他们从参军开始就被视为参加了工作。",
  "uiIdx": "",
  "range": "46791-46830",
  "chapterUid": null
 },
 {
  "level": 2,
  "text": "中县事业单位的设置和初职获得途径",
  "uiIdx": "2",
  "range": "43350-43391",
  "chapterUid": null
 },
 {
  "level": 3,
  "text": "事业单位的设置",
  "uiIdx": "2.1",
  "range": "43350-43391",
  "chapterUid": null
 },
 {
  "level": 4,
  "text": "中县事业单位都有相应的行政级别。",
  "uiIdx": "",
  "range": "43350-43391",
  "chapterUid": null
 },
 {
  "level": 4,
  "text": "对于副科级以上领导干部来说，机关单位和事业单位领导岗位是一个统一的内部官僚“市场”，调整时是一盘棋，可以互相流动和调配。",
  "uiIdx": "",
  "range": "43472-43517",
  "chapterUid": null
 },
 {
  "level": 3,
  "text": "初职获得途径",
  "uiIdx": "2.2",
  "range": "44504-44530",
  "chapterUid": null
 },
 {
  "level": 4,
  "text": "初职在哪个单位圈内就业，将对干部的成长产生深远影响。",
  "uiIdx": "",
  "range": "44504-44530",
  "chapterUid": null
 },
 {
  "level": 2,
  "text": "中县干部的提拔和流动情况",
  "uiIdx": "3",
  "range": "60762-60789",
  "chapterUid": null
 },
 {
  "level": 3,
  "text": "干部的初职获得过程",
  "uiIdx": "3.1",
  "range": "60762-60789",
  "chapterUid": null
 },
 {
  "level": 4,
  "text": "干部的初职获得过程包括人力资本起主要作用和人力资本和社会资本都发生作用的类型。",
  "uiIdx": "",
  "range": "60762-60789",
  "chapterUid": null
 },
 {
  "level": 3,
  "text": "单位人员构成",
  "uiIdx": "3.2",
  "range": "64374-64382",
  "chapterUid": null
 },
 {
  "level": 4,
  "text": "单位流动的原因、单位流动的走向和单位流动的影响。",
  "uiIdx": "",
  "range": "69918-69937",
  "chapterUid": null
 },
 {
  "level": 4,
  "text": "单位变迁的原因、单位变迁的影响和单位变迁的教训。",
  "uiIdx": "",
  "range": "76789-76815",
  "chapterUid": null
 },
 {
  "level": 4,
  "text": "教师从政的原因、教师从政的影响和教师从政的启示。",
  "uiIdx": "",
  "range": "81376-81382",
  "chapterUid": null
 },
 {
  "level": 3,
  "text": "干部的轨迹",
  "uiIdx": "3.3",
  "range": "99285-99312",
  "chapterUid": null
 },
 {
  "level": 4,
  "text": "副科级干部的提拔和流动以及隐性台阶的问题。",
  "uiIdx": "",
  "range": "99285-99312",
  "chapterUid": null
 },
 {
  "level": 2,
  "text": "领导干部的晋升规则",
  "uiIdx": "4",
  "range": "102518-102537",
  "chapterUid": null
 },
 {
  "level": 3,
  "text": "领导干部的晋升规则已经成为惯例，打破惯例会被认为不正常。",
  "uiIdx": "4.1",
  "range": "102518-102537",
  "chapterUid": null
 },
 {
  "level": 3,
  "text": "公开选拔是优秀年轻干部脱颖而出的重要方式，也是未来干部选拔的重要方向之一。",
  "uiIdx": "4.2",
  "range": "102799-102835",
  "chapterUid": null
 },
 {
  "level": 3,
  "text": "2008年年底，中县公开选拔团县委书记和副科级青年干部，报考团县委书记的资格为：任副科级职务一年以上，中共正式党员，年龄在30周岁以下，大专以上学历，近二年年度考核等次在称职以上，身体健康。",
  "uiIdx": "4.3",
  "range": "102924-102959",
  "chapterUid": null
 },
 {
  "level": 1,
  "text": "_2",
  "uiIdx": "",
  "range": "",
  "chapterUid": null
 },
 {
  "level": 2,
  "text": "中县县直部门在2003年到2008年没有提拔干部的原因",
  "uiIdx": "1",
  "range": "601-636",
  "chapterUid": null
 },
 {
  "level": 3,
  "text": "前任县委书记把干部资源都用尽了。",
  "uiIdx": "1.1",
  "range": "636-680",
  "chapterUid": null
 },
 {
  "level": 3,
  "text": "2008年年底，中县大规模的动干部开始实施，县政府办就配备了10位副主任。",
  "uiIdx": "1.2",
  "range": "767-826",
  "chapterUid": null
 },
 {
  "level": 2,
  "text": "中县干部资源的分布情况",
  "uiIdx": "2",
  "range": "4642-4692",
  "chapterUid": null
 },
 {
  "level": 3,
  "text": "中县正科级干部有680名，副科级干部有280人，意味着有2/3的副科级干部终其一生，都是副科级干部。",
  "uiIdx": "2.1",
  "range": "4642-4692",
  "chapterUid": null
 },
 {
  "level": 3,
  "text": "中县正处级干部有11000多人，实职处级干部只有4人，可以想象其成长之路多艰多难。",
  "uiIdx": "2.2",
  "range": "47602-47645",
  "chapterUid": null
 },
 {
  "level": 3,
  "text": "县委办和政府办是干部产出最多的地方，组织部和纪委的干部产出也相对较高。",
  "uiIdx": "2.3",
  "range": "75091-75112",
  "chapterUid": null
 },
 {
  "level": 1,
  "text": "_3",
  "uiIdx": "",
  "range": "",
  "chapterUid": null
 },
 {
  "level": 2,
  "text": "政绩在干部晋升中的作用和关系",
  "uiIdx": "1",
  "range": "17846-17867",
  "chapterUid": null
 },
 {
  "level": 3,
  "text": "政绩在干部晋升中的重要性",
  "uiIdx": "1.1",
  "range": "17846-17867",
  "chapterUid": null
 },
 {
  "level": 4,
  "text": "政绩在干部晋升中起着基础性的作用。",
  "uiIdx": "",
  "range": "17846-17867",
  "chapterUid": null
 },
 {
  "level": 4,
  "text": "政绩型干部体制使得干部的晋升与经济发展紧密相连。",
  "uiIdx": "",
  "range": "17867-17963",
  "chapterUid": null
 },
 {
  "level": 3,
  "text": "政绩与干部晋升之间的关系",
  "uiIdx": "1.2",
  "range": "32779-32837",
  "chapterUid": null
 },
 {
  "level": 4,
  "text": "政绩是干部晋升的重要依据。",
  "uiIdx": "",
  "range": "32779-32837",
  "chapterUid": null
 },
 {
  "level": 4,
  "text": "政绩的优劣直接影响干部的晋升机会。",
  "uiIdx": "",
  "range": "32779-32837",
  "chapterUid": null
 },
 {
  "level": 2,
  "text": "乡镇领导在政绩和政绩型干部体制下的经历",
  "uiIdx": "2",
  "range": "41667-41708",
  "chapterUid": null
 },
 {
  "level": 3,
  "text": "陈国达的经历",
  "uiIdx": "2.1",
  "range": "50595-50665",
  "chapterUid": null
 },
 {
  "level": 4,
  "text": "陈国达在经营困难时，以自己的房产作抵押，大搞民间高息借贷。",
  "uiIdx": "",
  "range": "50595-50665",
  "chapterUid": null
 },
 {
  "level": 3,
  "text": "杨中雨的经历",
  "uiIdx": "2.2",
  "range": "51249-51290",
  "chapterUid": null
 },
 {
  "level": 4,
  "text": "杨中雨领办的汉德贸易公司业务主要是利用价格差进行商品买卖。",
  "uiIdx": "",
  "range": "51249-51290",
  "chapterUid": null
 },
 {
  "level": 3,
  "text": "李朝中的经历",
  "uiIdx": "2.3",
  "range": "60975-61028",
  "chapterUid": null
 },
 {
  "level": 4,
  "text": "李朝中在调查研究的基础上，一方面慢慢停止前任处处冒烟的做法。",
  "uiIdx": "",
  "range": "60975-61028",
  "chapterUid": null
 },
 {
  "level": 3,
  "text": "杨玉琴的经历",
  "uiIdx": "2.4",
  "range": "62032-62068",
  "chapterUid": null
 },
 {
  "level": 4,
  "text": "杨玉琴对于前任县委书记的“休养生息”政策非常着急，认为耽误了中县的发展。",
  "uiIdx": "",
  "range": "62032-62068",
  "chapterUid": null
 },
 {
  "level": 2,
  "text": "政绩型干部体制的特点和运行逻辑",
  "uiIdx": "3",
  "range": "77270-77326",
  "chapterUid": null
 },
 {
  "level": 3,
  "text": "政绩型干部体制需要以政治忠诚为基础。",
  "uiIdx": "3.1",
  "range": "77270-77326",
  "chapterUid": null
 },
 {
  "level": 3,
  "text": "政绩型干部体制需要听话服从。",
  "uiIdx": "3.2",
  "range": "77270-77326",
  "chapterUid": null
 },
 {
  "level": 3,
  "text": "政绩型干部体制需要上级认可的政绩。",
  "uiIdx": "3.3",
  "range": "77270-77326",
  "chapterUid": null
 },
 {
  "level": 3,
  "text": "忠诚—政绩激励机制的运行逻辑。",
  "uiIdx": "3.4",
  "range": "77326-77379",
  "chapterUid": null
 },
 {
  "level": 3,
  "text": "政绩工程等假政绩的关键是工作过“左”：运动型经济，命令型经济，不从实际出发，急躁冒进，一刀切，行政干预，瞎指挥、乱折腾，经验和技术缺乏，逼民致富等等。",
  "uiIdx": "3.5",
  "range": "77461-77546",
  "chapterUid": null
 },
 {
  "level": 3,
  "text": "真政绩的特点：从实际出发，因地制宜；稳健推进，注意经验和技术的累积等等。",
  "uiIdx": "3.6",
  "range": "77627-77649",
  "chapterUid": null
 },
 {
  "level": 1,
  "text": "_4",
  "uiIdx": "",
  "range": "",
  "chapterUid": null
 },
 {
  "level": 2,
  "text": "中县政治家族现象及其对县乡政治生态的影响",
  "uiIdx": "1",
  "range": "19348-19386",
  "chapterUid": null
 },
 {
  "level": 3,
  "text": "中县政治家族的成员和关系",
  "uiIdx": "1.1",
  "range": "19348-19386",
  "chapterUid": null
 },
 {
  "level": 4,
  "text": "政治家族的成员包括他们的职务和家庭背景。",
  "uiIdx": "",
  "range": "19348-19386",
  "chapterUid": null
 },
 {
  "level": 4,
  "text": "政治家族的形成原因包括教育和入伍、领导干部及其子女形成熟人圈、政治培养等。",
  "uiIdx": "",
  "range": "19348-19386",
  "chapterUid": null
 },
 {
  "level": 3,
  "text": "政治家族对县乡政治生态的影响",
  "uiIdx": "1.2",
  "range": "22032-22073",
  "chapterUid": null
 },
 {
  "level": 4,
  "text": "政治家族提高了行政效率。",
  "uiIdx": "",
  "range": "22032-22073",
  "chapterUid": null
 },
 {
  "level": 4,
  "text": "政治家族形成了地方利益集团。",
  "uiIdx": "",
  "range": "22154-22178",
  "chapterUid": null
 },
 {
  "level": 4,
  "text": "政治家族导致了干部仕途上的不公平。",
  "uiIdx": "",
  "range": "22412-22451",
  "chapterUid": null
 },
 {
  "level": 4,
  "text": "政治家族形成了关系网和利益链。",
  "uiIdx": "",
  "range": "22502-22550",
  "chapterUid": null
 },
 {
  "level": 3,
  "text": "政治家族的衰落趋势",
  "uiIdx": "1.3",
  "range": "23162-23185",
  "chapterUid": null
 },
 {
  "level": 4,
  "text": "政治家族的衰落趋势包括计划生育政策、干部交流制度和干部群体就业观念的转变。",
  "uiIdx": "",
  "range": "23162-23185",
  "chapterUid": null
 },
 {
  "level": 2,
  "text": "中县干部的仕途格局和纪律问题",
  "uiIdx": "2",
  "range": "67318-67359",
  "chapterUid": null
 },
 {
  "level": 3,
  "text": "干部的仕途格局",
  "uiIdx": "2.1",
  "range": "67318-67359",
  "chapterUid": null
 },
 {
  "level": 4,
  "text": "关系在干部仕途中的重要作用。",
  "uiIdx": "",
  "range": "67318-67359",
  "chapterUid": null
 },
 {
  "level": 4,
  "text": "县乡过度竞争的仕途格局。",
  "uiIdx": "",
  "range": "67318-67359",
  "chapterUid": null
 },
 {
  "level": 3,
  "text": "干部的纪律问题",
  "uiIdx": "2.2",
  "range": "80794-80904",
  "chapterUid": null
 },
 {
  "level": 4,
  "text": "干部的经济问题、作风问题和政治问题的存在。",
  "uiIdx": "",
  "range": "80794-80904",
  "chapterUid": null
 },
 {
  "level": 4,
  "text": "干部查处过程中的无奈和困境。",
  "uiIdx": "",
  "range": "87855-87896",
  "chapterUid": null
 },
 {
  "level": 4,
  "text": "政治家族和政治势力集团在纪检部门安置代理人的现象。",
  "uiIdx": "",
  "range": "94239-94279",
  "chapterUid": null
 },
 {
  "level": 3,
  "text": "纪检监察制度的影响",
  "uiIdx": "2.3",
  "range": "89292-89330",
  "chapterUid": null
 },
 {
  "level": 4,
  "text": "纪检监察制度提供了合法化清除仕途障碍的组织管道。",
  "uiIdx": "",
  "range": "89292-89330",
  "chapterUid": null
 },
 {
  "level": 4,
  "text": "纪检监察制度带来了干部查处中的腐败问题。",
  "uiIdx": "",
  "range": "89292-89330",
  "chapterUid": null
 },
 {
  "level": 1,
  "text": "_5",
  "uiIdx": "",
  "range": "",
  "chapterUid": null
 },
 {
  "level": 2,
  "text": "中县在1983年至2005年间，干部在政治、作风和纪律方面的问题",
  "uiIdx": "1",
  "range": "14085-14148",
  "chapterUid": null
 },
 {
  "level": 3,
  "text": "中县纪委对王封文的处理",
  "uiIdx": "1.1",
  "range": "38357-38367",
  "chapterUid": null
 },
 {
  "level": 4,
  "text": "王封文因被举报涉及经济问题，被给予党内警告处分。",
  "uiIdx": "",
  "range": "38357-38367",
  "chapterUid": null
 },
 {
  "level": 3,
  "text": "中县纪委对贾本声的处理",
  "uiIdx": "1.2",
  "range": "48261-48300",
  "chapterUid": null
 },
 {
  "level": 4,
  "text": "贾本声因被举报涉及大量的官场潜规则，最终被判处有期徒刑一年，缓刑一年，并被开除党籍。",
  "uiIdx": "",
  "range": "48261-48300",
  "chapterUid": null
 },
 {
  "level": 3,
  "text": "中县纪委对徐庆中的处理",
  "uiIdx": "1.3",
  "range": "48261-48300",
  "chapterUid": null
 },
 {
  "level": 4,
  "text": "徐庆中因被举报涉及经济问题，被给予党内警告处分。",
  "uiIdx": "",
  "range": "48261-48300",
  "chapterUid": null
 },
 {
  "level": 3,
  "text": "中县纪委对刘军元的处理",
  "uiIdx": "1.4",
  "range": "48261-48300",
  "chapterUid": null
 },
 {
  "level": 4,
  "text": "刘军元因被举报涉及强奸罪，最终被判处有期徒刑一年，缓刑一年，并被开除党籍。",
  "uiIdx": "",
  "range": "48261-48300",
  "chapterUid": null
 },
 {
  "level": 2,
  "text": "中县干部的仕途发展，以及干部的纪律处分对其仕途的影响",
  "uiIdx": "2",
  "range": "50303-50325",
  "chapterUid": null
 },
 {
  "level": 3,
  "text": "陶勤先和叶理时的仕途发展",
  "uiIdx": "2.1",
  "range": "50407-50435",
  "chapterUid": null
 },
 {
  "level": 4,
  "text": "他们虽然曾受到党内警告处分，但并未影响他们的仕途发展。",
  "uiIdx": "",
  "range": "50407-50435",
  "chapterUid": null
 },
 {
  "level": 3,
  "text": "岳安达的仕途发展",
  "uiIdx": "2.2",
  "range": "50407-50435",
  "chapterUid": null
 },
 {
  "level": 4,
  "text": "他在受到党内严重警告、行政降级的处分后，并未影响他的仕途发展，反而晋升为新华街道办党工委副书记、纪工委书记。",
  "uiIdx": "",
  "range": "50407-50435",
  "chapterUid": null
 },
 {
  "level": 3,
  "text": "干部的纪律处分对其仕途的影响",
  "uiIdx": "2.3",
  "range": "50829-50872",
  "chapterUid": null
 },
 {
  "level": 4,
  "text": "干部的纪律处分体现非常明显的公私分明，因公务活动受到的纪律处分明显要比因私人活动受到的纪律处分轻，并且对干部的仕途往往影响不大。",
  "uiIdx": "",
  "range": "50829-50872",
  "chapterUid": null
 },
 {
  "level": 4,
  "text": "如果干部的纪律处分与私人活动有关，那么对干部的仕途往往会有较大影响。",
  "uiIdx": "",
  "range": "50829-50872",
  "chapterUid": null
 },
 {
  "level": 3,
  "text": "周国飞受处分一案",
  "uiIdx": "2.4",
  "range": "51564-51592",
  "chapterUid": null
 },
 {
  "level": 4,
  "text": "周国飞并未因此影响他的仕途发展，反而继续举报李朝中的各种问题。",
  "uiIdx": "",
  "range": "53080-53136",
  "chapterUid": null
 },
