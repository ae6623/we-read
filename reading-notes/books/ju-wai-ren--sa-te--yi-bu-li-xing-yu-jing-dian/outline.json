[
 {
  "level": 1,
  "text": "一",
  "uiIdx": "",
  "range": "",
  "chapterUid": 3,
  "display": "第一部分 · 一 · 母亲去世的消息和葬礼的安排"
 },
 {
  "level": 2,
  "text": "母亲去世的消息和葬礼的安排",
  "uiIdx": "1",
  "range": "519-539",
  "chapterUid": 3
 },
 {
  "level": 3,
  "text": "收到养老院发来的电报，得知母亲去世",
  "uiIdx": "1.1",
  "range": "519-539",
  "chapterUid": 3
 },
 {
  "level": 4,
  "text": "电报内容：“母亲去世。明日举行葬礼。谨致敬意。”。",
  "uiIdx": "",
  "range": "539-552",
  "chapterUid": 3
 },
 {
  "level": 3,
  "text": "乘坐公共汽车前往养老院，参加葬礼",
  "uiIdx": "1.2",
  "range": "609-627",
  "chapterUid": 3
 },
 {
  "level": 4,
  "text": "公共汽车行程：两点钟出发，下午抵达。",
  "uiIdx": "",
  "range": "609-627",
  "chapterUid": 3
 },
 {
  "level": 4,
  "text": "向老板请了两天假，得到老板的理解。",
  "uiIdx": "",
  "range": "646-671",
  "chapterUid": 3
 },
 {
  "level": 2,
  "text": "养老院的环境和母亲的生活",
  "uiIdx": "2",
  "range": "567-609",
  "chapterUid": 3
 },
 {
  "level": 3,
  "text": "养老院位于马伦戈，距阿尔及尔八十公里",
  "uiIdx": "2.1",
  "range": "567-609",
  "chapterUid": 3
 },
 {
  "level": 4,
  "text": "乘坐两点钟的公共汽车，下午抵达。",
  "uiIdx": "",
  "range": "609-627",
  "chapterUid": 3
 },
 {
  "level": 3,
  "text": "母亲在养老院的生活",
  "uiIdx": "2.2",
  "range": "1529-1548",
  "chapterUid": 3
 },
 {
  "level": 4,
  "text": "母亲在家时，总是默默地用目光追随着我。",
  "uiIdx": "",
  "range": "1529-1548",
  "chapterUid": 3
 },
 {
  "level": 4,
  "text": "刚住进养老院的头几天，她经常哭。",
  "uiIdx": "",
  "range": "1548-1564",
  "chapterUid": 3
 },
 {
  "level": 4,
  "text": "过去一年里，我几乎没再去那里，多少也是这个原因。",
  "uiIdx": "",
  "range": "1605-1629",
  "chapterUid": 3
 },
 {
  "level": 2,
  "text": "葬礼的过程和感受",
  "uiIdx": "3",
  "range": "1952-1967",
  "chapterUid": 3
 },
 {
  "level": 3,
  "text": "葬礼的安排和过程",
  "uiIdx": "3.1",
  "range": "1952-1967",
  "chapterUid": 3
 },
 {
  "level": 4,
  "text": "院长告诉我，葬礼定于上午十点举行。",
  "uiIdx": "",
  "range": "1952-1967",
  "chapterUid": 3
 },
 {
  "level": 4,
  "text": "我们把妈妈送到了我们那间小太平间。",
  "uiIdx": "",
  "range": "1762-1790",
  "chapterUid": 3
 },
 {
  "level": 4,
  "text": "男人们拿着一条床单，朝棺材走去。",
  "uiIdx": "",
  "range": "6234-6250",
  "chapterUid": 3
 },
 {
  "level": 4,
  "text": "我们跟着抬棺人走出了救济院。",
  "uiIdx": "",
  "range": "6351-6365",
  "chapterUid": 3
 },
 {
  "level": 3,
  "text": "葬礼中的感受和回忆",
  "uiIdx": "3.2",
  "range": "3098-3151",
  "chapterUid": 3
 },
 {
  "level": 4,
  "text": "在那间小小的太平间里，他告诉我，他是以贫民的身份进了收容所。",
  "uiIdx": "",
  "range": "3098-3151",
  "chapterUid": 3
 },
 {
  "level": 4,
  "text": "我发现，送葬队伍走快了一些。",
  "uiIdx": "",
  "range": "7371-7410",
  "chapterUid": 3
 },
 {
  "level": 4,
  "text": "我似乎觉得，送葬队伍走快了一些。",
  "uiIdx": "",
  "range": "7371-7410",
  "chapterUid": 3
 },
 {
  "level": 4,
  "text": "接下来的一切发生得如此仓促、笃定而又自然，以至于我什么都记不起来了。",
  "uiIdx": "",
  "range": "7802-7859",
  "chapterUid": 3
 },
 {
  "level": 1,
  "text": "二",
  "uiIdx": "",
  "range": "",
  "chapterUid": 3,
  "display": "第一部分 · 二 · 作者请假的误会"
 },
 {
  "level": 2,
  "text": "作者请假的误会",
  "uiIdx": "1",
  "range": "567-605",
  "chapterUid": 3
 },
 {
  "level": 3,
  "text": "作者向老板请两天假，老板以为他能休四天假",
  "uiIdx": "1.1",
  "range": "567-605",
  "chapterUid": 3
 },
 {
  "level": 4,
  "text": "作者几乎把这件事给忘了，可起床时，这个念头又突然冒了出来。",
  "uiIdx": "",
  "range": "539-567",
  "chapterUid": 3
 },
 {
  "level": 4,
  "text": "老板想当然地以为，这么一来，算上星期天，我就能休四天假，这可让他高兴不起来。",
  "uiIdx": "",
  "range": "567-605",
  "chapterUid": 3
 },
 {
  "level": 2,
  "text": "作者与玛丽在浴场的相遇",
  "uiIdx": "2",
  "range": "767-805",
  "chapterUid": 3
 },
 {
  "level": 3,
  "text": "作者在浴场遇到了以前的打字员玛丽，两人一起在水中嬉戏",
  "uiIdx": "2.1",
  "range": "767-805",
  "chapterUid": 3
 },
 {
  "level": 4,
  "text": "我在水里碰见了玛丽·卡多纳，她以前是我办公室的打字员，那时候我曾对她动过心。",
  "uiIdx": "",
  "range": "767-805",
  "chapterUid": 3
 },
 {
  "level": 4,
  "text": "我帮她爬上救生圈时，不经意间擦过了她的胸部。",
  "uiIdx": "",
  "range": "834-856",
  "chapterUid": 3
 },
 {
  "level": 4,
  "text": "我还在水里的时候，她已经趴在救生圈上了。",
  "uiIdx": "",
  "range": "856-876",
  "chapterUid": 3
 },
 {
  "level": 4,
  "text": "她转过身看向我，头发垂在眼前，正笑着。",
  "uiIdx": "",
  "range": "876-895",
  "chapterUid": 3
 },
 {
  "level": 4,
  "text": "我爬上救生圈，挨着她。",
  "uiIdx": "",
  "range": "895-906",
  "chapterUid": 3
 },
 {
  "level": 4,
  "text": "天气很宜人，我像开玩笑似的往后一仰，把头枕在她肚子上。",
  "uiIdx": "",
  "range": "906-933",
  "chapterUid": 3
 },
 {
  "level": 4,
  "text": "她什么也没说，我就那样待着。",
  "uiIdx": "",
  "range": "933-947",
  "chapterUid": 3
 },
 {
  "level": 4,
  "text": "我眼里映着整片天空，天空湛蓝，泛着金色。",
  "uiIdx": "",
  "range": "947-967",
  "chapterUid": 3
 },
 {
  "level": 4,
  "text": "我的后颈贴着玛丽的腹部，能感觉到她的肚子轻轻搏动。",
  "uiIdx": "",
  "range": "967-992",
  "chapterUid": 3
 },
 {
  "level": 4,
  "text": "我们在浮圈上待了很久，半睡半醒。",
  "uiIdx": "",
  "range": "992-1008",
  "chapterUid": 3
 },
 {
  "level": 4,
  "text": "太阳晒得太厉害的时候，她潜入水中，我也跟着潜了下去。",
  "uiIdx": "",
  "range": "1008-1034",
  "chapterUid": 3
 },
 {
  "level": 4,
  "text": "我追上她，伸手揽住她的腰，和她一起游了起来。",
  "uiIdx": "",
  "range": "1034-1056",
  "chapterUid": 3
 },
 {
  "level": 4,
  "text": "她总是笑个不停。",
  "uiIdx": "",
  "range": "1056-1064",
  "chapterUid": 3
 },
 {
  "level": 4,
  "text": "我们在码头上擦干身体时，她对我说：“我的肤色比您深。”。",
  "uiIdx": "",
  "range": "1064-1091",
  "chapterUid": 3
 },
 {
  "level": 4,
  "text": "我问她晚上想不想和我一起去看电影。她又笑了起来，说她想看一部费南代尔主演的电影。",
  "uiIdx": "",
  "range": "1091-1131",
  "chapterUid": 3
 },
 {
  "level": 4,
  "text": "我们重新穿好衣服后，她看到我打着一条黑领带，显得十分惊讶，还问我是不是在服丧。",
  "uiIdx": "",
  "range": "1131-1170",
  "chapterUid": 3
 },
 {
  "level": 4,
  "text": "我告诉她，妈妈已经去世了。",
  "uiIdx": "",
  "range": "1170-1183",
  "chapterUid": 3
 },
 {
  "level": 4,
  "text": "她想知道我妈妈是什么时候去世的，我便回答：“昨天。”。",
  "uiIdx": "",
  "range": "1183-1209",
  "chapterUid": 3
 },
 {
  "level": 4,
  "text": "她微微往后退了退，却什么也没说。",
  "uiIdx": "",
  "range": "1209-1225",
  "chapterUid": 3
 },
 {
  "level": 4,
  "text": "我本想告诉她这不是我的错，但话到嘴边又停住了，因为我想起自己已经跟老板说过了。",
  "uiIdx": "",
  "range": "1225-1264",
  "chapterUid": 3
 },
 {
  "level": 4,
  "text": "这没什么意义。反正，人多少总有些过错。",
  "uiIdx": "",
  "range": "1271-1283",
  "chapterUid": 3
 },
 {
  "level": 2,
  "text": "作者对星期天的感受",
  "uiIdx": "3",
  "range": "1422-1439",
  "chapterUid": 3
 },
 {
  "level": 3,
  "text": "作者不喜欢星期天，因为妈妈下葬的那天正好是星期天",
  "uiIdx": "3.1",
  "range": "1422-1439",
  "chapterUid": 3
 },
 {
  "level": 4,
  "text": "我醒来时，玛丽已经走了。她之前跟我解释过，她得去她姨妈家。",
  "uiIdx": "",
  "range": "1387-1439",
  "chapterUid": 3
 },
 {
  "level": 4,
  "text": "我以为那天是星期天，于是心里就烦了起来：我不喜欢星期天。",
  "uiIdx": "",
  "range": "1439-1467",
  "chapterUid": 3
 },
 {
  "level": 2,
  "text": "作者在公寓的生活",
  "uiIdx": "4",
  "range": "1595-1640",
  "chapterUid": 3
 },
 {
  "level": 3,
  "text": "作者在公寓里四处闲逛，感到无聊",
  "uiIdx": "4.1",
  "range": "1595-1640",
  "chapterUid": 3
 },
 {
  "level": 4,
  "text": "午饭后，我觉得有点无聊，便在公寓里四处闲逛。",
  "uiIdx": "",
  "range": "1595-1640",
  "chapterUid": 3
 },
 {
  "level": 4,
  "text": "妈妈在的时候，这里刚刚好。现在公寓对我来说太大了，我只好把餐桌搬到我的房间里。",
  "uiIdx": "",
  "range": "1640-1679",
  "chapterUid": 3
 },
 {
  "level": 4,
  "text": "如今我只住在这间屋子里，周遭只有几把椅面微微凹陷的草编椅、一座镜面泛黄的衣柜、一张梳妆台和一张铜床。其余地方都荒废了。",
  "uiIdx": "",
  "range": "1679-1729",
  "chapterUid": 3
 },
 {
  "level": 3,
  "text": "作者在阳台上抽烟，看着街上的景象",
  "uiIdx": "4.2",
  "range": "2362-2419",
  "chapterUid": 3
 },
 {
  "level": 4,
  "text": "我把椅子转了个方向，照着烟草店老板的样子摆好，因为我觉得这样更方便。",
  "uiIdx": "",
  "range": "2362-2419",
  "chapterUid": 3
 },
 {
  "level": 4,
  "text": "我抽了两支烟，回屋拿了块巧克力，又回到窗边吃了。",
  "uiIdx": "",
  "range": "2419-2443",
  "chapterUid": 3
 },
 {
  "level": 4,
  "text": "没过多久，天色就暗了下来，我还以为夏日的雷雨要来了。",
  "uiIdx": "",
  "range": "2443-2469",
  "chapterUid": 3
 },
 {
  "level": 4,
  "text": "不过，天色渐渐放晴了。但云层掠过后，街道上仿佛留下了风雨欲来的征兆，使街面更加阴暗。",
  "uiIdx": "",
  "range": "2480-2511",
  "chapterUid": 3
 },
 {
  "level": 4,
  "text": "我久久凝望着天空。",
  "uiIdx": "",
  "range": "2511-2520",
  "chapterUid": 3
 },
 {
  "level": 2,
  "text": "作者对生活的感慨",
  "uiIdx": "5",
  "range": "2520-2578",
  "chapterUid": 3
 },
 {
  "level": 3,
  "text": "作者认为生活没有改变，妈妈已经下葬，他也要回去上班",
  "uiIdx": "5.1",
  "range": "2520-2578",
  "chapterUid": 3
 },
 {
  "level": 4,
  "text": "五点钟，有轨电车在一片喧闹声中驶来，载着从郊区体育场返回的一群群观众；他们挤在踏板和栏杆上。",
  "uiIdx": "",
  "range": "2520-2589",
  "chapterUid": 3
 },
 {
  "level": 4,
  "text": "随后驶来的有轨电车把球员们送了回来，我通过他们的小行李箱认出了他们。",
  "uiIdx": "",
  "range": "2589-2623",
  "chapterUid": 3
 },
 {
  "level": 4,
  "text": "他们扯开嗓子又喊又唱，坚称他们的俱乐部绝不会消亡。",
  "uiIdx": "",
  "range": "2623-2648",
  "chapterUid": 3
 },
 {
  "level": 4,
  "text": "好几个人都朝我打手势。其中一个甚至冲我喊道：“我们赢了！”。",
  "uiIdx": "",
  "range": "2648-2677",
  "chapterUid": 3
 },
 {
  "level": 4,
  "text": "从那一刻起，汽车便开始纷纷涌来。",
  "uiIdx": "",
  "range": "2689-2705",
  "chapterUid": 3
 },
 {
  "level": 4,
  "text": "又过了一会儿，屋顶上方的天空渐渐泛红。暮色刚刚降临，街道也热闹起来。",
  "uiIdx": "",
  "range": "2705-2762",
  "chapterUid": 3
 },
 {
  "level": 4,
  "text": "散步的人们渐渐回来了。我从其他人群中认出了那位气度不凡的先生。孩子们哭着，或是任由别人拖着走。",
  "uiIdx": "",
  "range": "2773-2809",
  "chapterUid": 3
 },
 {
  "level": 4,
  "text": "几乎紧接着，附近几家电影院的观众便潮水般涌上街头。",
  "uiIdx": "",
  "range": "2809-2834",
  "chapterUid": 3
 },
 {
  "level": 4,
  "text": "其中，年轻人的动作比平时更加果断，我想他们是看了部冒险电影。",
  "uiIdx": "",
  "range": "2834-2864",
  "chapterUid": 3
 },
 {
  "level": 4,
  "text": "从城里电影院回来的人稍晚些才到。他们显得更加严肃了。",
  "uiIdx": "",
  "range": "2864-2880",
  "chapterUid": 3
 },
 {
  "level": 4,
  "text": "虽然仍会笑，但偶尔也会显得疲惫而若有所思。",
  "uiIdx": "",
  "range": "2890-2911",
  "chapterUid": 3
 },
 {
  "level": 4,
  "text": "他们一直待在街上，在马路对面的人行道上来回走动。",
  "uiIdx": "",
  "range": "2911-2935",
  "chapterUid": 3
 },
 {
  "level": 4,
  "text": "街区里的姑娘们都没戴帽子，彼此挽着胳膊。年轻小伙子们特意找机会与她们相遇，冲她们说些俏皮话，姑娘们笑着把头扭开。",
  "uiIdx": "",
  "range": "2935-2991",
  "chapterUid": 3
 },
 {
  "level": 4,
  "text": "我认识的几个姑娘还朝我打了招呼。",
  "uiIdx": "",
  "range": "2991-3007",
  "chapterUid": 3
 },
 {
  "level": 4,
  "text": "街灯这时骤然亮起，把夜幕中初升的星星映得黯然失色。",
  "uiIdx": "",
  "range": "3007-3055",
  "chapterUid": 3
 },
 {
  "level": 4,
  "text": "望着人群熙攘、灯火映照的人行道，我感到眼睛渐渐疲倦起来。",
  "uiIdx": "",
  "range": "3055-3083",
  "chapterUid": 3
 },
 {
  "level": 4,
  "text": "灯光照亮了湿漉漉的石板路，有轨电车则不时驶过，将车影投在发亮的头发、一抹笑容或一只银手镯上。",
  "uiIdx": "",
  "range": "3083-3129",
  "chapterUid": 3
 },
 {
  "level": 4,
  "text": "不久之后，随着有轨电车渐渐稀少，树木与灯火上方的夜色愈发浓郁，街区也悄然空了下来，直到第一只猫慢慢穿过那条再度空无一人的街道。",
  "uiIdx": "",
  "range": "3129-3192",
  "chapterUid": 3
 },
 {
  "level": 4,
  "text": "这时我想到，该吃晚饭了。长时间靠着椅背，我的脖子有些疼。",
  "uiIdx": "",
  "range": "3192-3220",
  "chapterUid": 3
 },
 {
  "level": 4,
  "text": "我下楼买了面包和意面，做了饭，然后站着吃了。",
  "uiIdx": "",
  "range": "3220-3242",
  "chapterUid": 3
 },
 {
  "level": 4,
  "text": "我本想在窗边抽支烟，可空气已经凉了些，我也觉得有点冷。",
  "uiIdx": "",
  "range": "3242-3269",
  "chapterUid": 3
 },
 {
  "level": 4,
  "text": "我关上窗户，回来时从镜子里看见一小块桌面，上面放着我的酒精灯和几块面包。",
  "uiIdx": "",
  "range": "3269-3305",
  "chapterUid": 3
 },
 {
  "level": 4,
  "text": "我想，星期天又过去了，妈妈已经下葬，我也要回去上班了。总的来说，一切都没有改变。",
  "uiIdx": "",
  "range": "3305-3345",
  "chapterUid": 3
 },
 {
  "level": 1,
  "text": "三",
  "uiIdx": "",
  "range": "",
  "chapterUid": 3,
  "display": "第一部分 · 三 · 办公室工作的一天"
 },
 {
  "level": 2,
  "text": "办公室工作的一天",
  "uiIdx": "1",
  "range": "512-520",
  "chapterUid": 3
 },
 {
  "level": 3,
  "text": "老板待人很和气，询问我的工作和家庭情况",
  "uiIdx": "1.1",
  "range": "512-520",
  "chapterUid": 3
 },
 {
  "level": 4,
  "text": "老板问我累不累，还想知道我妈妈多大年纪。",
  "uiIdx": "",
  "range": "520-539",
  "chapterUid": 3
 },
 {
  "level": 3,
  "text": "桌上堆了一大摞提单，需要逐一查阅",
  "uiIdx": "1.2",
  "range": "584-637",
  "chapterUid": 3
 },
 {
  "level": 4,
  "text": "离开办公室去吃午饭前，我洗了手。",
  "uiIdx": "",
  "range": "637-653",
  "chapterUid": 3
 },
 {
  "level": 2,
  "text": "午餐后的工作",
  "uiIdx": "2",
  "range": "751-781",
  "chapterUid": 3
 },
 {
  "level": 3,
  "text": "中午十二点半才和在发货部工作的伊曼纽尔一起走",
  "uiIdx": "2.1",
  "range": "751-781",
  "chapterUid": 3
 },
 {
  "level": 4,
  "text": "办公室面朝大海，我们花了些时间，望着烈日下港口里的货船。",
  "uiIdx": "",
  "range": "781-809",
  "chapterUid": 3
 },
 {
  "level": 3,
  "text": "一辆卡车在链条哐啷作响和爆炸声中驶来，我们跑了起来",
  "uiIdx": "2.2",
  "range": "809-833",
  "chapterUid": 3
 },
 {
  "level": 4,
  "text": "卡车从我们身边驶过，我们拔腿追了上去。",
  "uiIdx": "",
  "range": "855-874",
  "chapterUid": 3
 },
 {
  "level": 4,
  "text": "我先借力纵身一跃。随后，我又扶伊曼纽尔坐下。",
  "uiIdx": "",
  "range": "938-960",
  "chapterUid": 3
 },
 {
  "level": 4,
  "text": "我们气喘吁吁，卡车在码头凹凸不平的石板路上颠簸跳跃，尘土飞扬，阳光刺眼。",
  "uiIdx": "",
  "range": "960-996",
  "chapterUid": 3
 },
 {
  "level": 4,
  "text": "伊曼纽尔笑得上气不接下气。",
  "uiIdx": "",
  "range": "996-1009",
  "chapterUid": 3
 },
 {
  "level": 2,
  "text": "塞莱斯特的晚餐",
  "uiIdx": "3",
  "range": "1049-1072",
  "chapterUid": 3
 },
 {
  "level": 3,
  "text": "塞莱斯特还在那儿，挺着大肚子，系着围裙，留着白胡须",
  "uiIdx": "3.1",
  "range": "1049-1072",
  "chapterUid": 3
 },
 {
  "level": 4,
  "text": "他问我“你还好吗？”，我说还好，也告诉他我饿了。",
  "uiIdx": "",
  "range": "1072-1096",
  "chapterUid": 3
 },
 {
  "level": 4,
  "text": "我吃得很快，还喝了咖啡。",
  "uiIdx": "",
  "range": "1096-1108",
  "chapterUid": 3
 },
 {
  "level": 4,
  "text": "之后我回到家，睡了一会儿，因为葡萄酒喝多了。",
  "uiIdx": "",
  "range": "1108-1130",
  "chapterUid": 3
 },
 {
  "level": 4,
  "text": "醒来时，我又想抽烟。天已经很晚了，我跑着去赶电车。",
  "uiIdx": "",
  "range": "1130-1155",
  "chapterUid": 3
 },
 {
  "level": 2,
  "text": "邻居萨拉马诺的故事",
  "uiIdx": "4",
  "range": "1325-1374",
  "chapterUid": 3
 },
 {
  "level": 3,
  "text": "萨拉马诺和狗一起，患有一种皮肤病，几乎掉光了所有的毛",
  "uiIdx": "4.1",
  "range": "1325-1374",
  "chapterUid": 3
 },
 {
  "level": 4,
  "text": "老萨拉马诺和它两人长期独自住在一间小屋里，久而久之，老萨拉马诺也变得和它很像。",
  "uiIdx": "",
  "range": "1374-1413",
  "chapterUid": 3
 },
 {
  "level": 4,
  "text": "他脸上结着红褐色的痂，毛发稀疏发黄。狗也学了主人的几分佝偻模样：口鼻朝前探着，脖子绷得紧紧的。",
  "uiIdx": "",
  "range": "1413-1460",
  "chapterUid": 3
 },
 {
  "level": 4,
  "text": "他们看起来像是同一品种，却彼此憎恨。",
  "uiIdx": "",
  "range": "1460-1478",
  "chapterUid": 3
 },
 {
  "level": 3,
  "text": "老人每天遛狗两次，分别在上午十一点和下午六点",
  "uiIdx": "4.2",
  "range": "1478-1501",
  "chapterUid": 3
 },
 {
  "level": 4,
  "text": "八年来，他们一直没换过路线。沿着里昂街，人们可以看到他们：狗拽着老人往前走，直到老萨拉马诺踉跄一下。",
  "uiIdx": "",
  "range": "1501-1551",
  "chapterUid": 3
 },
 {
  "level": 4,
  "text": "然后他打起狗来，还辱骂它。狗吓得在地上爬行，任由他拖着走。",
  "uiIdx": "",
  "range": "1551-1580",
  "chapterUid": 3
 },
 {
  "level": 4,
  "text": "这时候就轮到老人来拉它了。狗忘了之后，又会重新拽着主人走，结果再次挨打挨骂。",
  "uiIdx": "",
  "range": "1580-1618",
  "chapterUid": 3
 },
 {
  "level": 4,
  "text": "于是，他们俩就留在人行道上，彼此对视着：狗满眼恐惧，男人满眼憎恨。",
  "uiIdx": "",
  "range": "1618-1651",
  "chapterUid": 3
 },
 {
  "level": 4,
  "text": "狗想撒尿时，老人不给它时间，便拽着它继续往前走，西班牙猎犬身后留下一串小尿滴。",
  "uiIdx": "",
  "range": "1658-1697",
  "chapterUid": 3
 },
 {
  "level": 4,
  "text": "如果狗碰巧在房间里大小便，就又会挨一顿打。",
  "uiIdx": "",
  "range": "1697-1718",
  "chapterUid": 3
 },
 {
  "level": 4,
  "text": "这种情况已经持续八年了。塞莱斯特总是说：“真不幸。”。",
  "uiIdx": "",
  "range": "1718-1744",
  "chapterUid": 3
 },
 {
  "level": 2,
  "text": "邻居雷蒙·桑泰斯的故事",
  "uiIdx": "5",
  "range": "2011-2038",
  "chapterUid": 3
 },
 {
  "level": 3,
  "text": "雷蒙·桑泰斯靠女人活着，但别人问起他的职业时，他的回答却是“仓库管理员”",
  "uiIdx": "5.1",
  "range": "2011-2038",
  "chapterUid": 3
 },
 {
  "level": 4,
  "text": "他总是穿得十分体面。他也跟我说起萨拉马诺，还感叹道：“真可怜啊！”。",
  "uiIdx": "",
  "range": "2143-2176",
  "chapterUid": 3
 },
 {
  "level": 4,
  "text": "他问我会不会觉得恶心，我回答说不会。",
  "uiIdx": "",
  "range": "2176-2194",
  "chapterUid": 3
 },
 {
  "level": 3,
  "text": "雷蒙·桑泰斯和情妇的纠纷",
  "uiIdx": "5.2",
  "range": "3039-3051",
  "chapterUid": 3
 },
 {
  "level": 4,
  "text": "他发现这里面有诈。他给她的钱仅够维持生活。他亲自替她支付房租，每天还另给她二十法郎作伙食费。",
  "uiIdx": "",
  "range": "3039-3076",
  "chapterUid": 3
 },
 {
  "level": 4,
  "text": "“房租三百法郎，伙食费六百法郎，偶尔再买一双长袜，加起来一共一千法郎。而太太并不工作。可她告诉我，我给她的钱实在不够用，靠这些钱她过不下去。”。",
  "uiIdx": "",
  "range": "3051-3111",
  "chapterUid": 3
 },
 {
  "level": 4,
  "text": "他发现她典当了两只手镯。在那之前，他一直不知道这些手镯的存在。",
  "uiIdx": "",
  "range": "3359-3413",
  "chapterUid": 3
 },
 {
  "level": 4,
  "text": "于是他告诉我，他在自己的包里发现了一张彩票，而她无法向他解释这张彩票是怎么买来的。",
  "uiIdx": "",
  "range": "3295-3359",
  "chapterUid": 3
 },
 {
  "level": 4,
  "text": "他把她打到见血。但此前，他并不会打她。“我会打她，不过可以说是温柔地打。她会叫几声。我关上百叶窗，最后事情总是照旧收场。但现在这事严重了。”。",
  "uiIdx": "",
  "range": "3435-3450",
  "chapterUid": 3
 },
 {
  "level": 4,
  "text": "于是他向我解释说，他正因如此才需要征求意见。他停下来调了调那盏灯的灯芯，那灯正冒着黑烟。",
  "uiIdx": "",
  "range": "3658-3725",
  "chapterUid": 3
 },
 {
  "level": 4,
  "text": "我仍在听他说话。我喝了将近一升葡萄酒，太阳穴烫得厉害。我抽着雷蒙的烟，因为自己的烟已经抽完了。",
  "uiIdx": "",
  "range": "3725-3772",
  "chapterUid": 3
 },
 {
  "level": 4,
  "text": "末班电车驶过，将郊区已然渐远的喧闹声也一并带走。",
  "uiIdx": "",
  "range": "3772-3796",
  "chapterUid": 3
 },
 {
  "level": 4,
  "text": "雷蒙接着说：“让他烦恼的是，他对自己的姘头还有点感情。”。",
  "uiIdx": "",
  "range": "3796-3824",
  "chapterUid": 3
 },
 {
  "level": 4,
  "text": "可他想惩罚她。他起初打算带她去一家旅馆，再叫“风化警察”来闹一出丑闻，好让她被列入妓女名册。",
  "uiIdx": "",
  "range": "3831-3870",
  "chapterUid": 3
 },
 {
  "level": 4,
  "text": "后来，他向黑道上的几个朋友求助，但他们一无所获。正如雷蒙提醒我的那样，混黑道可真够值的。",
  "uiIdx": "",
  "range": "3870-3914",
  "chapterUid": 3
 },
 {
  "level": 4,
  "text": "他把这件事告诉了他们，他们便提议给她“做个记号”。但这并不是他想要的。",
  "uiIdx": "",
  "range": "3914-3949",
  "chapterUid": 3
 },
 {
  "level": 4,
  "text": "他打算考虑一下。在此之前，他想问我一件事。而且，在问我这件事之前，他还想知道我对这件事怎么看。",
  "uiIdx": "",
  "range": "3957-3996",
  "chapterUid": 3
 },
 {
  "level": 4,
  "text": "我回答说，我对此没什么看法，不过觉得这件事挺有意思。",
  "uiIdx": "",
  "range": "3996-4022",
  "chapterUid": 3
 },
 {
  "level": 4,
  "text": "他问我是否觉得其中有诈；我觉得确实如此。",
  "uiIdx": "",
  "range": "4022-4034",
  "chapterUid": 3
 },
 {
  "level": 4,
  "text": "接着，他又问我是否认为应该惩罚她，以及换作是我会怎么做。",
  "uiIdx": "",
  "range": "4042-4070",
  "chapterUid": 3
 },
 {
  "level": 4,
  "text": "我告诉他，这种事永远也无从知晓，不过我理解他想惩罚她。",
  "uiIdx": "",
  "range": "4070-4097",
  "chapterUid": 3
 },
 {
  "level": 4,
  "text": "我又喝了点酒。他点了支烟，然后把他的想法告诉了我。",
  "uiIdx": "",
  "range": "4097-4122",
  "chapterUid": 3
 },
 {
  "level": 4,
  "text": "他想给她写一封信，信里既要有踢她几脚的狠劲，也要有让她后悔的话。",
  "uiIdx": "",
  "range": "4122-4154",
  "chapterUid": 3
 },
 {
  "level": 4,
  "text": "之后，等她回来，他会跟她上床，并在“快要完事时”朝她脸上吐口水，然后把她赶出去。",
  "uiIdx": "",
  "range": "4154-4194",
  "chapterUid": 3
 },
 {
  "level": 4,
  "text": "我觉得，这样的确能惩罚她。不过雷蒙告诉我，他觉得自己写不了那封必要的信，便想到让我来起草。",
  "uiIdx": "",
  "range": "4194-4239",
  "chapterUid": 3
 },
 {
  "level": 4,
  "text": "见我没说话，他便问我介不介意马上就做，我说不介意。",
  "uiIdx": "",
  "range": "4239-4264",
  "chapterUid": 3
 },
 {
  "level": 4,
  "text": "他喝完一杯葡萄酒后，便站起身来。他把盘子和我们剩下的一点冷血肠都推到了一旁。",
  "uiIdx": "",
  "range": "4264-4325",
  "chapterUid": 3
 },
 {
  "level": 4,
  "text": "他仔细擦净了桌上的油布，然后从床头柜的抽屉里取出一张方格纸、一个黄色信封、一支红色的小木笔杆和一只装着紫色墨水的方形墨水瓶。",
  "uiIdx": "",
  "range": "4325-4387",
  "chapterUid": 3
 },
 {
  "level": 4,
  "text": "他告诉我那个女人的名字时，我便看出她是个摩尔女人。",
  "uiIdx": "",
  "range": "4387-4412",
  "chapterUid": 3
 },
 {
  "level": 4,
  "text": "我写好了那封信。写的时候有些随意，但我还是费心让雷蒙满意，因为我没有理由不这么做。",
  "uiIdx": "",
  "range": "4412-4453",
  "chapterUid": 3
 },
 {
  "level": 4,
  "text": "然后我把信大声念了出来。他一边抽烟，一边点头听着，随后让我再念一遍。",
  "uiIdx": "",
  "range": "4453-4487",
  "chapterUid": 3
 },
 {
  "level": 4,
  "text": "他非常满意。他对我说：“我就知道你很懂生活。”。",
  "uiIdx": "",
  "range": "4493-4510",
  "chapterUid": 3
 },
 {
  "level": 4,
  "text": "起初我并没有意识到他是在用“你”来称呼我。直到他对我说：“现在你是个真正的朋友了。”。",
  "uiIdx": "",
  "range": "4493-4552",
  "chapterUid": 3
 },
 {
  "level": 4,
  "text": "他封好了信，我们也把酒喝完了。",
  "uiIdx": "",
  "range": "4605-4620",
  "chapterUid": 3
 },
 {
  "level": 4,
  "text": "随后，我们又待了一会儿，什么也没说，只是抽着烟。",
  "uiIdx": "",
  "range": "4620-4644",
  "chapterUid": 3
 },
 {
  "level": 4,
  "text": "外面一片宁静，我们听见一辆汽车驶过的声音。",
  "uiIdx": "",
  "range": "4644-4665",
  "chapterUid": 3
 },
 {
  "level": 4,
  "text": "我说：“很晚了。”。",
  "uiIdx": "",
  "range": "4665-4674",
  "chapterUid": 3
 },
 {
  "level": 4,
  "text": "雷蒙也这么觉得。他发现时间过得很快；从某种意义上说，确实如此。",
  "uiIdx": "",
  "range": "4682-4705",
  "chapterUid": 3
 },
 {
  "level": 4,
  "text": "我很困，但起床很费劲。我一定显得很疲惫，因为雷蒙对我说，人不能任由自己消沉下去。",
  "uiIdx": "",
  "range": "4705-4745",
  "chapterUid": 3
 },
 {
  "level": 4,
  "text": "起初我没明白。随后他向我解释说，他已经听说我妈妈去世了，不过这件事迟早会发生。",
  "uiIdx": "",
  "range": "4752-4784",
  "chapterUid": 3
 },
 {
  "level": 4,
  "text": "我也这么认为。",
  "uiIdx": "",
  "range": "4784-4791",
  "chapterUid": 3
 },
 {
  "level": 4,
  "text": "我站起身来，雷蒙紧紧握了握我的手，对我说，男人之间总是彼此理解的。",
  "uiIdx": "",
  "range": "4791-4847",
  "chapterUid": 3
 },
 {
  "level": 4,
  "text": "我走出他家，关上门，在楼梯平台的黑暗中站了一会儿。",
  "uiIdx": "",
  "range": "4847-4872",
  "chapterUid": 3
 },
 {
  "level": 4,
  "text": "屋子里一片寂静，楼梯间深处升起一股幽暗而潮湿的气息。",
  "uiIdx": "",
  "range": "4872-4898",
  "chapterUid": 3
 },
 {
  "level": 4,
  "text": "我耳中嗡嗡作响，只听见血液一下一下地搏动。",
  "uiIdx": "",
  "range": "4898-4919",
  "chapterUid": 3
 },
 {
  "level": 4,
  "text": "我一动不动地待着。但老萨拉马诺房里的狗发出一声低沉的呜咽。",
  "uiIdx": "",
  "range": "4928-4948",
  "chapterUid": 3
 },
 {
  "level": 1,
  "text": "四",
  "uiIdx": "",
  "range": "",
  "chapterUid": 3,
  "display": "第一部分 · 四 · 作者与玛丽在海滩上的亲密时光"
 },
 {
  "level": 2,
  "text": "作者与玛丽在海滩上的亲密时光",
  "uiIdx": "1",
  "range": "752-790",
  "chapterUid": 3
 },
 {
  "level": 3,
  "text": "玛丽教作者一种游戏，两人在海浪中翻滚",
  "uiIdx": "1.1",
  "range": "752-790",
  "chapterUid": 3
 },
 {
  "level": 4,
  "text": "游泳时，得在浪尖上喝水，把所有泡沫都积在嘴里，然后仰面躺下，把泡沫喷向天空。",
  "uiIdx": "",
  "range": "752-790",
  "chapterUid": 3
 },
 {
  "level": 3,
  "text": "作者吻了玛丽，两人决定不再说话，急着回家",
  "uiIdx": "1.2",
  "range": "972-1008",
  "chapterUid": 3
 },
 {
  "level": 4,
  "text": "我把她紧紧搂在怀里，我们急着找辆公交车回去，去我家，然后一起扑到我床上。",
  "uiIdx": "",
  "range": "972-1008",
  "chapterUid": 3
 },
 {
  "level": 2,
  "text": "雷蒙的家庭纠纷和警察介入",
  "uiIdx": "2",
  "range": "1324-1382",
  "chapterUid": 3
 },
 {
  "level": 3,
  "text": "雷蒙的妻子因为雷蒙的出轨而与雷蒙争吵",
  "uiIdx": "2.1",
  "range": "1324-1382",
  "chapterUid": 3
 },
 {
  "level": 4,
  "text": "我们先听见一个女人尖细的声音，随后又听见雷蒙说：“我想你了，我想你了。我要让你知道，冒犯我的下场。”。",
  "uiIdx": "",
  "range": "1324-1397",
  "chapterUid": 3
 },
 {
  "level": 3,
  "text": "警察介入，雷蒙被扇耳光，并被要求捡起烟头",
  "uiIdx": "2.2",
  "range": "1166-1181",
  "chapterUid": 3
 },
 {
  "level": 4,
  "text": "“混蛋，畜生！”接着，他们便出了门，走到街上。",
  "uiIdx": "",
  "range": "1166-1181",
  "chapterUid": 3
 },
 {
  "level": 4,
  "text": "警员狠狠一巴掌，结结实实地扇在他的脸颊上。香烟掉在几米外。",
  "uiIdx": "",
  "range": "1655-1689",
  "chapterUid": 3
 },
 {
  "level": 2,
  "text": "作者决定为雷蒙作证",
  "uiIdx": "3",
  "range": "2422-2437",
  "chapterUid": 3
 },
 {
  "level": 3,
  "text": "作者被雷蒙请喝白兰地，后一起去妓院，但被作者拒绝",
  "uiIdx": "3.1",
  "range": "2422-2437",
  "chapterUid": 3
 },
 {
  "level": 4,
  "text": "随后他想打一局台球，我惜败了。之后他想去妓院，但我拒绝了，因为我不喜欢那种地方。",
  "uiIdx": "",
  "range": "2422-2462",
  "chapterUid": 3
 },
 {
  "level": 3,
  "text": "雷蒙告诉作者，他成功惩罚了情妇，心里很高兴",
  "uiIdx": "3.2",
  "range": "2497-2518",
  "chapterUid": 3
 },
 {
  "level": 4,
  "text": "我觉得他对我特别友好，心想这正是个好时机。",
  "uiIdx": "",
  "range": "2497-2518",
  "chapterUid": 3
 },
 {
  "level": 2,
  "text": "老萨拉马诺的狗丢失和寻找",
  "uiIdx": "4",
  "range": "1110-1129",
  "chapterUid": 3
 },
 {
  "level": 3,
  "text": "老萨拉马诺的狗丢失，他四处寻找，显得焦躁不安",
  "uiIdx": "4.1",
  "range": "2583-2634",
  "chapterUid": 3
 },
 {
  "level": 4,
  "text": "他四下张望，原地打转，试图看穿走廊里的黑暗，嘴里嘟囔着些不着边际的话，随后又用那双小红眼睛搜寻着街道。",
  "uiIdx": "",
  "range": "2583-2634",
  "chapterUid": 3
 },
 {
  "level": 3,
  "text": "老萨拉马诺决定去动物收容所，但不愿交费用",
  "uiIdx": "4.2",
  "range": "3027-3044",
  "chapterUid": 3
 },
 {
  "level": 4,
  "text": "他发起火来：“为这具腐尸掏钱。啊！它死了才好！”。",
  "uiIdx": "",
  "range": "3027-3044",
  "chapterUid": 3
 },
 {
  "level": 4,
  "text": "他随即开始骂它。雷蒙笑了笑，走进屋里。",
  "uiIdx": "",
  "range": "3061-3072",
  "chapterUid": 3
 },
 {
  "level": 2,
  "text": "作者对老萨拉马诺的同情和理解",
  "uiIdx": "5",
  "range": "2867-2891",
  "chapterUid": 3
 },
 {
  "level": 3,
  "text": "作者理解老萨拉马诺的担忧，告诉他狗会回来",
  "uiIdx": "5.1",
  "range": "2867-2891",
  "chapterUid": 3
 },
 {
  "level": 4,
  "text": "他举例说，有些狗会跋涉几十公里，只为了找到主人。",
  "uiIdx": "",
  "range": "2867-2891",
  "chapterUid": 3
 },
 {
  "level": 3,
  "text": "作者安慰老萨拉马诺，告诉他收容所会把狗留三天",
  "uiIdx": "5.2",
  "range": "3268-3286",
  "chapterUid": 3
 },
 {
  "level": 4,
  "text": "他静静地看着我，随后说道：“晚安。”。",
  "uiIdx": "",
  "range": "3268-3286",
  "chapterUid": 3
 },
 {
  "level": 1,
  "text": "五",
  "uiIdx": "",
  "range": "",
  "chapterUid": 3,
  "display": "第一部分 · 五 · 雷蒙的邀请"
 },
 {
  "level": 2,
  "text": "雷蒙的邀请",
  "uiIdx": "1",
  "range": "510-561",
  "chapterUid": 3
 },
 {
  "level": 3,
  "text": "雷蒙邀请我星期天去他位于阿尔及尔附近的小屋，和他共度一天",
  "uiIdx": "1.1",
  "range": "510-561",
  "chapterUid": 3
 },
 {
  "level": 4,
  "text": "我回答说我很乐意，不过那天已经答应安排给一个朋友了。",
  "uiIdx": "",
  "range": "561-587",
  "chapterUid": 3
 },
 {
  "level": 4,
  "text": "雷蒙立刻告诉我，他也会邀请她的。",
  "uiIdx": "",
  "range": "587-603",
  "chapterUid": 3
 },
 {
  "level": 3,
  "text": "雷蒙告诉我他一整天都被一群阿拉伯人跟踪",
  "uiIdx": "1.2",
  "range": "755-781",
  "chapterUid": 3
 },
 {
  "level": 4,
  "text": "“如果你今晚回家时在房子附近看见他，就告诉我一声。”。",
  "uiIdx": "",
  "range": "755-781",
  "chapterUid": 3
 },
 {
  "level": 2,
  "text": "老板的提议",
  "uiIdx": "2",
  "range": "878-893",
  "chapterUid": 3
 },
 {
  "level": 3,
  "text": "老板想在巴黎设立一个办事处，想让我去那里",
  "uiIdx": "2.1",
  "range": "878-893",
  "chapterUid": 3
 },
 {
  "level": 4,
  "text": "他只是想征求我对这件事的意见。",
  "uiIdx": "",
  "range": "878-893",
  "chapterUid": 3
 },
 {
  "level": 4,
  "text": "他打算在巴黎设立一个办事处，在当地直接与各大公司打理业务，并想知道我是否愿意去那里。",
  "uiIdx": "",
  "range": "893-935",
  "chapterUid": 3
 },
 {
  "level": 4,
  "text": "这样我就能住在巴黎，也能每年抽出一段时间去旅行。",
  "uiIdx": "",
  "range": "935-959",
  "chapterUid": 3
 },
 {
  "level": 3,
  "text": "老板认为我对换一种生活不感兴趣",
  "uiIdx": "2.2",
  "range": "1016-1034",
  "chapterUid": 3
 },
 {
  "level": 4,
  "text": "我回答说，人从来不会改变自己的生活；反正各种生活都差不多，而我一点也不讨厌自己在这里的生活。",
  "uiIdx": "",
  "range": "1016-1062",
  "chapterUid": 3
 },
 {
  "level": 2,
  "text": "玛丽的求婚",
  "uiIdx": "3",
  "range": "1203-1246",
  "chapterUid": 3
 },
 {
  "level": 3,
  "text": "玛丽问我愿不愿意和她结婚，我说我无所谓",
  "uiIdx": "3.1",
  "range": "1203-1246",
  "chapterUid": 3
 },
 {
  "level": 4,
  "text": "如果她愿意，我们可以这么做。",
  "uiIdx": "",
  "range": "1341-1354",
  "chapterUid": 3
 },
 {
  "level": 3,
  "text": "玛丽想知道我是否爱她，我解释说这并不重要",
  "uiIdx": "3.2",
  "range": "1354-1374",
  "chapterUid": 3
 },
 {
  "level": 4,
  "text": "如果她愿意，我们可以结婚。再说，是她提出的，我不过是应了声“好”。",
  "uiIdx": "",
  "range": "1341-1374",
  "chapterUid": 3
 },
 {
  "level": 2,
  "text": "塞莱斯特家的晚餐",
  "uiIdx": "4",
  "range": "2028-2053",
  "chapterUid": 3
 },
 {
  "level": 3,
  "text": "我在塞莱斯特的店里吃晚饭，遇到一个古怪的小个子女人",
  "uiIdx": "4.1",
  "range": "2028-2053",
  "chapterUid": 3
 },
 {
  "level": 4,
  "text": "她动作有些僵硬，苹果似的小脸上，一双眼睛闪闪发亮。",
  "uiIdx": "",
  "range": "2028-2053",
  "chapterUid": 3
 },
 {
  "level": 4,
  "text": "她脱下短外套，坐下来，急切地查看菜单。",
  "uiIdx": "",
  "range": "2053-2072",
  "chapterUid": 3
 },
 {
  "level": 4,
  "text": "等开胃菜上桌时，她打开手提包，取出一小张方形纸和一支铅笔，提前算好账，然后从小口袋里掏出一笔恰好够付账、连小费也算在内的钱，放在自己面前。",
  "uiIdx": "",
  "range": "2103-2172",
  "chapterUid": 3
 },
 {
  "level": 4,
  "text": "等下一道菜上来时，她又从包里拿出一支蓝色铅笔和一本刊有本周广播节目表的杂志。",
  "uiIdx": "",
  "range": "2200-2238",
  "chapterUid": 3
 },
 {
  "level": 4,
  "text": "她仔细地将几乎所有节目都逐一勾选了一遍。",
  "uiIdx": "",
  "range": "2238-2258",
  "chapterUid": 3
 },
 {
  "level": 4,
  "text": "因为杂志有十来页，她整个用餐期间都在一丝不苟地继续这项工作。",
  "uiIdx": "",
  "range": "2258-2288",
  "chapterUid": 3
 },
 {
  "level": 4,
  "text": "随后，她站起身，用同样精准而机械的动作穿回外套，然后离开了。",
  "uiIdx": "",
  "range": "2307-2337",
  "chapterUid": 3
 },
 {
  "level": 2,
  "text": "老萨拉马诺的谈话",
  "uiIdx": "5",
  "range": "2467-2494",
  "chapterUid": 3
 },
 {
  "level": 3,
  "text": "老萨拉马诺告诉我他的狗走丢了，因为狗不在收容所里",
  "uiIdx": "5.1",
  "range": "2467-2494",
  "chapterUid": 3
 },
 {
  "level": 4,
  "text": "工作人员告诉他，它可能被碾了。",
  "uiIdx": "",
  "range": "2494-2509",
  "chapterUid": 3
 },
 {
  "level": 4,
  "text": "他问能不能去警察局打听一下。对方答复他说，这类事情不做记录，因为每天都会发生。",
  "uiIdx": "",
  "range": "2509-2548",
  "chapterUid": 3
 },
 {
  "level": 3,
  "text": "老萨拉马诺说他可以再养一只狗，但他指出自己已经习惯了那只狗",
  "uiIdx": "5.2",
  "range": "2548-2589",
  "chapterUid": 3
 },
 {
  "level": 4,
  "text": "他和妻子在一起并不幸福，但总的来说，他也算是习惯了她。",
  "uiIdx": "",
  "range": "2817-2844",
  "chapterUid": 3
 },
 {
  "level": 4,
  "text": "她去世后，他感到非常孤独。于是，他向一位工友要来一只狗，那只狗当时还很小。",
  "uiIdx": "",
  "range": "2844-2881",
  "chapterUid": 3
 },
 {
  "level": 4,
  "text": "当初只好用奶瓶喂它。可狗的寿命比人短，他们最后还是一起变老了。",
  "uiIdx": "",
  "range": "2881-2912",
  "chapterUid": 3
 },
 {
  "level": 4,
  "text": "“它脾气很坏，”萨拉马诺对我说，“我们偶尔也会吵上几句。但它毕竟是条好狗。”。",
  "uiIdx": "",
  "range": "2912-2950",
  "chapterUid": 3
 },
 {
  "level": 4,
  "text": "“再说，”他又补充道，“你在他生病之前还不认识他呢。那是它身上最好看的毛。”。",
  "uiIdx": "",
  "range": "2968-3006",
  "chapterUid": 3
 },
 {
  "level": 4,
  "text": "自从狗得了这种皮肤病，萨拉马诺就每天早晚给它涂药膏。但在他看来，他真正的病是衰老，而衰老是治不好的。",
  "uiIdx": "",
  "range": "3006-3056",
  "chapterUid": 3
 },
 {
  "level": 1,
  "text": "六",
  "uiIdx": "",
  "range": "",
  "chapterUid": 3,
  "display": "第一部分 · 六 · 描述星期天的早晨和计划"
 },
 {
  "level": 2,
  "text": "描述星期天的早晨和计划",
  "uiIdx": "1",
  "range": "540-555",
  "chapterUid": 3
 },
 {
  "level": 3,
  "text": "玛丽叫醒主角，两人决定去游泳",
  "uiIdx": "1.1",
  "range": "540-555",
  "chapterUid": 3
 },
 {
  "level": 4,
  "text": "主角觉得肚子空空的，头也有点疼。",
  "uiIdx": "",
  "range": "540-555",
  "chapterUid": 3
 },
 {
  "level": 4,
  "text": "玛丽取笑主角，说主角“一副哭丧着脸的样子”。",
  "uiIdx": "",
  "range": "567-587",
  "chapterUid": 3
 },
 {
  "level": 3,
  "text": "主角和玛丽下楼，遇见雷蒙",
  "uiIdx": "1.2",
  "range": "656-666",
  "chapterUid": 3
 },
 {
  "level": 4,
  "text": "雷蒙正要下楼，告诉主角他正要下楼。",
  "uiIdx": "",
  "range": "656-666",
  "chapterUid": 3
 },
 {
  "level": 4,
  "text": "雷蒙穿着蓝色长裤和白色短袖衬衫，却戴了顶平顶草帽，惹得玛丽笑了起来。",
  "uiIdx": "",
  "range": "809-842",
  "chapterUid": 3
 },
 {
  "level": 2,
  "text": "描述去海滩的过程和遭遇",
  "uiIdx": "2",
  "range": "1066-1084",
  "chapterUid": 3
 },
 {
  "level": 3,
  "text": "主角和玛丽乘公交车去海滩，遇见阿拉伯人",
  "uiIdx": "2.1",
  "range": "1066-1084",
  "chapterUid": 3
 },
 {
  "level": 4,
  "text": "主角看见一群阿拉伯人倚在烟草店门面旁，他们默默地看着主角和玛丽。",
  "uiIdx": "",
  "range": "1066-1084",
  "chapterUid": 3
 },
 {
  "level": 4,
  "text": "雷蒙告诉主角，从左往右数第二个就是那个家伙，而且他看起来有些忧心忡忡。",
  "uiIdx": "",
  "range": "1115-1149",
  "chapterUid": 3
 },
 {
  "level": 3,
  "text": "主角和玛丽在海滩游泳，遇见马松",
  "uiIdx": "2.2",
  "range": "1980-2023",
  "chapterUid": 3
 },
 {
  "level": 4,
  "text": "马松想去游泳，但他的妻子和雷蒙都不想去。",
  "uiIdx": "",
  "range": "1980-2023",
  "chapterUid": 3
 },
 {
  "level": 4,
  "text": "主角和玛丽三个人一起下去，玛丽立刻跳进了水里。",
  "uiIdx": "",
  "range": "2023-2043",
  "chapterUid": 3
 },
 {
  "level": 2,
  "text": "描述海滩上的冲突和雷蒙的受伤",
  "uiIdx": "3",
  "range": "3466-3511",
  "chapterUid": 3
 },
 {
  "level": 3,
  "text": "主角和玛丽在海滩上被阿拉伯人攻击",
  "uiIdx": "3.1",
  "range": "3466-3511",
  "chapterUid": 3
 },
 {
  "level": 4,
  "text": "两个穿着蓝色工装的阿拉伯人正朝主角和玛丽走来。",
  "uiIdx": "",
  "range": "3466-3511",
  "chapterUid": 3
 },
 {
  "level": 4,
  "text": "马松向前猛地一跃。可另一个阿拉伯人已经站起身来，站到了那个拿刀的人身后。",
  "uiIdx": "",
  "range": "4042-4069",
  "chapterUid": 3
 },
 {
  "level": 3,
  "text": "雷蒙受伤，主角和玛丽返回小屋",
  "uiIdx": "3.2",
  "range": "4380-4399",
  "chapterUid": 3
 },
 {
  "level": 4,
  "text": "雷蒙的胳膊缠着绷带，嘴角贴着一块胶布。",
  "uiIdx": "",
  "range": "4380-4399",
  "chapterUid": 3
 },
 {
  "level": 4,
  "text": "医生告诉他没什么事，但雷蒙看上去神情十分阴郁。",
  "uiIdx": "",
  "range": "4399-4422",
  "chapterUid": 3
 },
 {
  "level": 2,
  "text": "描述主角在海滩上的孤独和反思",
  "uiIdx": "4",
  "range": "5689-5750",
  "chapterUid": 3
 },
 {
  "level": 3,
  "text": "主角在海滩上独自面对阿拉伯人",
  "uiIdx": "4.1",
  "range": "5689-5750",
  "chapterUid": 3
 },
 {
  "level": 4,
  "text": "主角远远望见那块小小的暗色岩石，周围环绕着一道被光线和海上水雾映得刺眼的光晕。",
  "uiIdx": "",
  "range": "5689-5750",
  "chapterUid": 3
 },
 {
  "level": 4,
  "text": "主角以为只要转个身，一切就都结束了。",
  "uiIdx": "",
  "range": "6217-6257",
  "chapterUid": 3
 },
 {
  "level": 3,
  "text": "主角开枪杀死阿拉伯人，然后离开",
  "uiIdx": "4.2",
  "range": "6762-6772",
  "chapterUid": 3
 },
 {
  "level": 4,
  "text": "主角抖落了汗水和阳光。",
  "uiIdx": "",
  "range": "6762-6772",
  "chapterUid": 3
 },
 {
  "level": 4,
  "text": "主角意识到，自己已经破坏了这一天原有的平衡，也打破了那片海滩上难得的宁静。",
  "uiIdx": "",
  "range": "6772-6819",
  "chapterUid": 3
 },
 {
  "level": 1,
  "text": "一",
  "uiIdx": "",
  "range": "",
  "chapterUid": 10,
  "display": "第二部分 · 一 · 作者被捕后的经历"
 },
 {
  "level": 2,
  "text": "作者被捕后的经历",
  "uiIdx": "1",
  "range": "515-535",
  "chapterUid": 10
 },
 {
  "level": 3,
  "text": "作者被讯问了好几次，但只是身份讯问，持续的时间并不长",
  "uiIdx": "1.1",
  "range": "515-535",
  "chapterUid": 10
 },
 {
  "level": 4,
  "text": "第一次在警察局时，似乎没有人对我的案子感兴趣。",
  "uiIdx": "",
  "range": "535-558",
  "chapterUid": 10
 },
 {
  "level": 4,
  "text": "八天后，预审法官却带着好奇地打量着我。",
  "uiIdx": "",
  "range": "558-577",
  "chapterUid": 10
 },
 {
  "level": 3,
  "text": "预审法官对作者进行了详细的讯问，包括他的私生活、对母亲去世的反应等",
  "uiIdx": "1.2",
  "range": "625-644",
  "chapterUid": 10
 },
 {
  "level": 4,
  "text": "预审法官想知道我是否已经选好律师，我承认没有，并问他是否必须请一名律师。",
  "uiIdx": "",
  "range": "608-644",
  "chapterUid": 10
 },
 {
  "level": 4,
  "text": "预审法官问了我那天是不是很难过，这个问题让我非常惊讶。",
  "uiIdx": "",
  "range": "1405-1461",
  "chapterUid": 10
 },
 {
  "level": 4,
  "text": "预审法官又莫名其妙地问我，是否用左轮手枪连续开了五枪。",
  "uiIdx": "",
  "range": "2779-2809",
  "chapterUid": 10
 },
 {
  "level": 4,
  "text": "预审法官问我爱不爱妈妈，我说：“是的，和所有人一样。”。",
  "uiIdx": "",
  "range": "2723-2738",
  "chapterUid": 10
 },
 {
  "level": 4,
  "text": "预审法官问我是否信上帝，我回答说不信。",
  "uiIdx": "",
  "range": "3482-3512",
  "chapterUid": 10
 },
 {
  "level": 3,
  "text": "预审法官对作者的讯问越来越激烈，甚至用十字架威胁作者",
  "uiIdx": "1.3",
  "range": "4009-4035",
  "chapterUid": 10
 },
 {
  "level": 4,
  "text": "预审法官站起身来，仿佛是在向我表示讯问已经结束。",
  "uiIdx": "",
  "range": "4009-4035",
  "chapterUid": 10
 },
 {
  "level": 4,
  "text": "他只是仍用那副略带倦意的口吻问我，是否后悔自己做过的事。",
  "uiIdx": "",
  "range": "4035-4063",
  "chapterUid": 10
 },
 {
  "level": 2,
  "text": "作者对预审法官的反应",
  "uiIdx": "2",
  "range": "2499-2553",
  "chapterUid": 10
 },
 {
  "level": 3,
  "text": "作者对预审法官的讯问感到厌倦，但尽量保持冷静",
  "uiIdx": "2.1",
  "range": "2499-2553",
  "chapterUid": 10
 },
 {
  "level": 4,
  "text": "我把先前告诉过他的事又复述了一遍：雷蒙、海滩、游泳、争吵、再次来到海滩、泉水、阳光，以及左轮手枪的五声枪响。",
  "uiIdx": "",
  "range": "2499-2553",
  "chapterUid": 10
 },
 {
  "level": 4,
  "text": "我每说一句，他都说：“好，好。”。",
  "uiIdx": "",
  "range": "2553-2569",
  "chapterUid": 10
 },
 {
  "level": 3,
  "text": "作者对预审法官的信仰表示怀疑，但并未直接反驳",
  "uiIdx": "2.2",
  "range": "3364-3411",
  "chapterUid": 10
 },
 {
  "level": 4,
  "text": "我大致听明白了：在他看来，我的供述里只有一点说不通，那就是我竟等了一会儿才用左轮手枪开第二枪。",
  "uiIdx": "",
  "range": "3364-3411",
  "chapterUid": 10
 },
 {
  "level": 4,
  "text": "其他方面都很好，可这一点他无法理解。",
  "uiIdx": "",
  "range": "3411-3429",
  "chapterUid": 10
 },
 {
  "level": 3,
  "text": "作者对预审法官的态度感到不满，但并未直接表达",
  "uiIdx": "2.3",
  "range": "3611-3629",
  "chapterUid": 10
 },
 {
  "level": 4,
  "text": "我觉得这事跟我无关，也这么告诉了他。",
  "uiIdx": "",
  "range": "3611-3629",
  "chapterUid": 10
 },
 {
  "level": 4,
  "text": "但他已经隔着桌子把基督像举到我眼前，失去理智地喊道：“我可是基督徒。我替你向上主请求宽恕你的过错。你怎么能不相信他是为你受苦的？”。",
  "uiIdx": "",
  "range": "3629-3694",
  "chapterUid": 10
 },
 {
  "level": 1,
  "text": "二",
  "uiIdx": "",
  "range": "",
  "chapterUid": 10,
  "display": "第二部分 · 二 · 作者在监狱中的生活"
 },
 {
  "level": 2,
  "text": "作者在监狱中的生活",
  "uiIdx": "1",
  "range": "693-735",
  "chapterUid": 10
 },
 {
  "level": 3,
  "text": "作者被关进监狱，经历了从自由人到囚徒的转变",
  "uiIdx": "1.1",
  "range": "693-735",
  "chapterUid": 10
 },
 {
  "level": 4,
  "text": "我被捕那天，他们先把我关进一间屋子，里面已经有好几名被拘的人，其中大多数是阿拉伯人。",
  "uiIdx": "",
  "range": "693-735",
  "chapterUid": 10
 },
 {
  "level": 4,
  "text": "他们看见我时笑了起来，接着问我做了什么。我说我杀了一个阿拉伯人，他们便沉默了。",
  "uiIdx": "",
  "range": "735-774",
  "chapterUid": 10
 },
 {
  "level": 4,
  "text": "但过了一会儿，天就黑了。他们告诉我那张晚上要睡的席子该怎么铺。把其中一端卷起来，就能做成一个长枕。整整一夜，臭虫都在我脸上爬来爬去。",
  "uiIdx": "",
  "range": "774-840",
  "chapterUid": 10
 },
 {
  "level": 4,
  "text": "几天后，我被单独关进一间牢房，睡在一块木制铺板上。我有一个便桶和一只铁盆。监狱位于城里地势最高的地方，透过一扇小窗，我能看见大海。",
  "uiIdx": "",
  "range": "840-905",
  "chapterUid": 10
 },
 {
  "level": 3,
  "text": "作者在监狱中度过了五个月，体验了各种滋味",
  "uiIdx": "1.2",
  "range": "5015-5043",
  "chapterUid": 10
 },
 {
  "level": 4,
  "text": "我当时还不明白这件事。对我来说，进入牢房的总是同一天，而我也总是在做同一件事。",
  "uiIdx": "",
  "range": "5015-5043",
  "chapterUid": 10
 },
 {
  "level": 4,
  "text": "那天，看守离开后，我借着铁饭盒照了照自己的样子。我觉得自己的影像看起来依旧很严肃，尽管我试着对它微笑。",
  "uiIdx": "",
  "range": "5043-5094",
  "chapterUid": 10
 },
 {
  "level": 4,
  "text": "我拿着饭盒在面前晃了晃。我笑了笑，她依旧一脸严肃和悲伤。",
  "uiIdx": "",
  "range": "5094-5122",
  "chapterUid": 10
 },
 {
  "level": 4,
  "text": "天色渐晚，那是我不愿提起的时刻，一个无名的时刻；傍晚的声响从监狱的各层此起彼伏，宛如一支无声的队伍。",
  "uiIdx": "",
  "range": "5122-5172",
  "chapterUid": 10
 },
 {
  "level": 4,
  "text": "我走近那扇小窗，借着最后一抹光线，再次端详起自己的影像。依然很严肃，这有什么奇怪的？",
  "uiIdx": "",
  "range": "5172-5214",
  "chapterUid": 10
 },
 {
  "level": 4,
  "text": "此刻的我也是一样。但与此同时，几个月来我第一次清晰地听见了自己的声音。",
  "uiIdx": "",
  "range": "5223-5249",
  "chapterUid": 10
 },
 {
  "level": 4,
  "text": "我听出来，那正是多日以来一直在我耳边回响的声音，也明白了这段时间里始终只有我一个人在说话。",
  "uiIdx": "",
  "range": "5249-5294",
  "chapterUid": 10
 },
 {
  "level": 2,
  "text": "作者在监狱中的心理变化",
  "uiIdx": "2",
  "range": "2814-2842",
  "chapterUid": 10
 },
 {
  "level": 3,
  "text": "作者刚被关押时，仍像一个自由人那样思考",
  "uiIdx": "2.1",
  "range": "2814-2842",
  "chapterUid": 10
 },
 {
  "level": 4,
  "text": "比如，我会突然很想去海滩上，朝大海走去。想象着最初的浪声在脚底响起、身体进入水中，以及我在水中感受到的解脱，我忽然感到，监狱的墙壁竟离我如此之近。",
  "uiIdx": "",
  "range": "2842-2915",
  "chapterUid": 10
 },
 {
  "level": 3,
  "text": "作者后来脑子里只剩下囚徒般的想法，等待着每天到院子里散步，也等着律师来探望",
  "uiIdx": "2.2",
  "range": "2945-2967",
  "chapterUid": 10
 },
 {
  "level": 4,
  "text": "我也很清楚怎么打发剩下的时间。",
  "uiIdx": "",
  "range": "2967-2982",
  "chapterUid": 10
 },
 {
  "level": 4,
  "text": "我那时常常想，假如有人让我住进一截枯树干里，除了看着头顶那朵天空之花，什么事也做不了，我也会渐渐习惯的。",
  "uiIdx": "",
  "range": "2982-3034",
  "chapterUid": 10
 },
 {
  "level": 2,
  "text": "作者在监狱中的日常",
  "uiIdx": "3",
  "range": "3912-3957",
  "chapterUid": 10
 },
 {
  "level": 3,
  "text": "作者通过回忆、阅读、睡觉来打发时间",
  "uiIdx": "3.1",
  "range": "3912-3957",
  "chapterUid": 10
 },
 {
  "level": 4,
  "text": "我有时会想起自己的房间，在脑海中从一个角落出发，沿途把经过的一切一一默数，最后再回到原处。",
  "uiIdx": "",
  "range": "3912-3957",
  "chapterUid": 10
 },
 {
  "level": 4,
  "text": "我发现了一小片旧报纸，它几乎粘在布料上，已经泛黄而透明。他讲述了一则缺了开头的社会新闻，不过这件事想必发生在捷克斯洛伐克。",
  "uiIdx": "",
  "range": "4373-4467",
  "chapterUid": 10
 },
 {
  "level": 4,
  "text": "起初，我晚上睡不好，白天则完全睡不着。渐渐地，我夜里睡得越来越好了，白天也能睡了。",
  "uiIdx": "",
  "range": "4265-4306",
  "chapterUid": 10
 },
 {
  "level": 3,
  "text": "作者在监狱中感受到了时间的流逝",
  "uiIdx": "3.2",
  "range": "4832-4857",
  "chapterUid": 10
 },
 {
  "level": 4,
  "text": "我确实读到过，人在监狱里待久了，最终会失去时间感。",
  "uiIdx": "",
  "range": "4832-4857",
  "chapterUid": 10
 },
 {
  "level": 4,
  "text": "时间无疑漫长而难熬，却又被拉得如此松散，最终彼此交叠起来。日子在此失去了名字。",
  "uiIdx": "",
  "range": "4892-4921",
  "chapterUid": 10
 },
 {
  "level": 1,
  "text": "三",
  "uiIdx": "",
  "range": "",
  "chapterUid": 10,
  "display": "第二部分 · 三 · 审判前的准备和期待"
 },
 {
  "level": 2,
  "text": "审判前的准备和期待",
  "uiIdx": "1",
  "range": "706-731",
  "chapterUid": 10
 },
 {
  "level": 3,
  "text": "作者被带到司法宫，等待审判开始",
  "uiIdx": "1.1",
  "range": "706-731",
  "chapterUid": 10
 },
 {
  "level": 4,
  "text": "作者被两名宪兵带到一间小房间，里面弥漫着荫翳的气息。",
  "uiIdx": "",
  "range": "706-731",
  "chapterUid": 10
 },
 {
  "level": 4,
  "text": "他们坐在门边等着，门后传来人声、呼喊声、椅子挪动的声响，还有一片忙乱嘈杂。",
  "uiIdx": "",
  "range": "731-768",
  "chapterUid": 10
 },
 {
  "level": 3,
  "text": "作者对审判充满期待，但同时也感到紧张",
  "uiIdx": "1.2",
  "range": "875-916",
  "chapterUid": 10
 },
 {
  "level": 4,
  "text": "作者这辈子从来没机会看过审判，所以有些紧张。",
  "uiIdx": "",
  "range": "875-916",
  "chapterUid": 10
 },
 {
  "level": 4,
  "text": "作者意识到，这个想法很愚蠢，因为他们在这里要找的不是荒唐可笑之处，而是罪行。",
  "uiIdx": "",
  "range": "1163-1200",
  "chapterUid": 10
 },
 {
  "level": 2,
  "text": "审判的过程和感受",
  "uiIdx": "2",
  "range": "993-1028",
  "chapterUid": 10
 },
 {
  "level": 3,
  "text": "审判开始，作者被带到被告席",
  "uiIdx": "2.1",
  "range": "993-1028",
  "chapterUid": 10
 },
 {
  "level": 4,
  "text": "法庭里挤满了人，尽管百叶窗挡着，阳光还是从缝隙间透了进来，空气也已经闷得让人喘不过气。",
  "uiIdx": "",
  "range": "993-1028",
  "chapterUid": 10
 },
 {
  "level": 4,
  "text": "作者坐下后，宪兵们便站在我两侧。就在这时，我看见面前站着一排人，他们全都望着我。我这才明白，他们就是陪审员。",
  "uiIdx": "",
  "range": "1035-1088",
  "chapterUid": 10
 },
 {
  "level": 3,
  "text": "审判过程中，作者被讯问，律师为其辩护",
  "uiIdx": "2.2",
  "range": "2974-3002",
  "chapterUid": 10
 },
 {
  "level": 4,
  "text": "审判长平静地询问作者，在我看来，态度中甚至还带着一丝亲切。",
  "uiIdx": "",
  "range": "2974-3002",
  "chapterUid": 10
 },
 {
  "level": 4,
  "text": "他们又让我报上自己的身份。尽管心里很恼火，我还是觉得这终归是自然要做的事，如果把一个人错当成另一个人来审判，后果实在太严重了。",
  "uiIdx": "",
  "range": "3015-3065",
  "chapterUid": 10
 },
 {
  "level": 4,
  "text": "随后，审判长又开始复述我做过的事，每讲三句话就向我确认一次：“是这样吗？”每次我都遵照我的律师的指示回答：“是的，审判长先生。”。",
  "uiIdx": "",
  "range": "3065-3129",
  "chapterUid": 10
 },
 {
  "level": 4,
  "text": "我的律师身着律师袍，在许多同行的簇拥下到场了。他走向记者们，与他们握手。他们有说有笑，显得十分自在，直到法庭里响起铃声。",
  "uiIdx": "",
  "range": "1844-1927",
  "chapterUid": 10
 },
 {
  "level": 4,
  "text": "轮到托马斯·佩雷斯时，法警不得不搀扶着他走到证人席前。佩雷斯说，他认识我母亲，对于我，他只在葬礼那天见过我一次。",
  "uiIdx": "",
  "range": "4864-4943",
  "chapterUid": 10
 },
 {
  "level": 4,
  "text": "随后，大家几乎没听马松发言。他说我是个诚实的人，甚至还说我是个正派的人。就连萨拉马诺作证时，也几乎没人听他说话。",
  "uiIdx": "",
  "range": "6559-6638",
  "chapterUid": 10
 },
 {
  "level": 4,
  "text": "之后，大家几乎没听马松发言。他说我是个诚实的人，甚至还说我是个正派的人。就连萨拉马诺作证时，也几乎没人听他说话。",
  "uiIdx": "",
  "range": "6559-6638",
  "chapterUid": 10
 },
 {
  "level": 4,
  "text": "随后轮到雷蒙，他是最后一位证人。雷蒙向我微微示意了一下，随即就说我无罪。但审判长表示，不是要他提供看法，而是提供事实。",
  "uiIdx": "",
  "range": "6732-6814",
  "chapterUid": 10
 },
 {
  "level": 3,
  "text": "审判结束，作者被带走",
  "uiIdx": "2.3",
  "range": "7641-7702",
  "chapterUid": 10
 },
 {
  "level": 4,
  "text": "庭审结束后，我走出司法宫，正要上车时，短短一瞬间看到了夏日傍晚的气息与色彩。",
  "uiIdx": "",
  "range": "7641-7702",
  "chapterUid": 10
 },
 {
  "level": 4,
  "text": "在我那间行驶中的牢房里，我仿佛从疲惫深处一一找回了那些熟悉的声响：这声音来自我爱着的那座城市，也来自某个特定的时刻——那一刻我感到满足。",
  "uiIdx": "",
  "range": "7702-7770",
  "chapterUid": 10
 },
 {
  "level": 1,
  "text": "四",
  "uiIdx": "",
  "range": "",
  "chapterUid": 10,
  "display": "第二部分 · 四 · 审判过程"
 },
 {
  "level": 2,
  "text": "审判过程",
  "uiIdx": "1",
  "range": "590-610",
  "chapterUid": 10
 },
 {
  "level": 3,
  "text": "检察官和律师的陈述",
  "uiIdx": "1.1",
  "range": "590-610",
  "chapterUid": 10
 },
 {
  "level": 4,
  "text": "检察官承认我有罪，但还替我辩解。",
  "uiIdx": "",
  "range": "590-610",
  "chapterUid": 10
 },
 {
  "level": 4,
  "text": "律师举起双臂，承认我有罪，但还替我辩解。",
  "uiIdx": "",
  "range": "590-610",
  "chapterUid": 10
 },
 {
  "level": 3,
  "text": "检察官对案件的解读",
  "uiIdx": "1.2",
  "range": "1054-1138",
  "chapterUid": 10
 },
 {
  "level": 4,
  "text": "检察官认为我是蓄意犯罪的，从我的妈妈去世说起，概述了事情经过。",
  "uiIdx": "",
  "range": "1054-1138",
  "chapterUid": 10
 },
 {
  "level": 4,
  "text": "检察官认为我应该受到惩罚，因为我是聪明人，知道该如何作答，懂得言辞的分量。",
  "uiIdx": "",
  "range": "1552-1569",
  "chapterUid": 10
 },
 {
  "level": 3,
  "text": "律师对案件的解读",
  "uiIdx": "1.3",
  "range": "3534-3586",
  "chapterUid": 10
 },
 {
  "level": 4,
  "text": "律师认为我是个正直的人，工作勤恳、从不知疲倦，忠于雇用我的那户人家，人人都喜欢我，也同情他人的不幸。",
  "uiIdx": "",
  "range": "3534-3586",
  "chapterUid": 10
 },
 {
  "level": 4,
  "text": "律师认为我是个模范儿子，一直竭尽所能赡养母亲。",
  "uiIdx": "",
  "range": "3586-3610",
  "chapterUid": 10
 },
 {
  "level": 2,
  "text": "审判结果",
  "uiIdx": "2",
  "range": "4878-4901",
  "chapterUid": 10
 },
 {
  "level": 3,
  "text": "陪审团的决定",
  "uiIdx": "2.1",
  "range": "4878-4901",
  "chapterUid": 10
 },
 {
  "level": 4,
  "text": "陪审团审判长要宣读结果了。",
  "uiIdx": "",
  "range": "4878-4901",
  "chapterUid": 10
 },
 {
  "level": 4,
  "text": "我将以法国人民的名义在一个公共广场上被斩首。",
  "uiIdx": "",
  "range": "5052-5097",
  "chapterUid": 10
 },
 {
  "level": 3,
  "text": "我的反应",
  "uiIdx": "2.2",
  "range": "5155-5163",
  "chapterUid": 10
 },
 {
  "level": 4,
  "text": "我什么都不想了。",
  "uiIdx": "",
  "range": "5155-5163",
  "chapterUid": 10
 },
 {
  "level": 4,
  "text": "我想了想，说：“没有。”。",
  "uiIdx": "",
