 {
  "level": 2,
  "text": "《人间快乐小卖部》内容简介",
  "uiIdx": "1",
  "range": "517-566",
  "chapterUid": 2
 },
 {
  "level": 3,
  "text": "《人间快乐小卖部》汇集丰子恺、老舍、鲁迅、朱自清等名家经典散文，恰似一间贩卖细碎欢喜的温情小卖部。",
  "uiIdx": "1.1",
  "range": "517-566",
  "chapterUid": 2
 },
 {
  "level": 3,
  "text": "全书分六大货架，吃食风物、童年趣事、四时景致、旧人往事、山河游历、闲居心绪尽数收纳",
  "uiIdx": "1.2",
  "range": "566-608",
  "chapterUid": 2
 },
 {
  "level": 4,
  "text": "这里有瓜子、杨梅、落花生等烟火吃食，回味舌尖上的人间滋味。",
  "uiIdx": "",
  "range": "608-660",
  "chapterUid": 2
 },
 {
  "level": 4,
  "text": "也有童年嬉戏的片段，重温纯粹烂漫的童心。",
  "uiIdx": "",
  "range": "660-680",
  "chapterUid": 2
 },
 {
  "level": 4,
  "text": "春山秋树，冬阳夏雨，书写四季流转的自然意趣。",
  "uiIdx": "",
  "range": "680-702",
  "chapterUid": 2
 },
 {
  "level": 4,
  "text": "追忆亲人故友，字里行间漫着旧时光的暖意。",
  "uiIdx": "",
  "range": "702-722",
  "chapterUid": 2
 },
 {
  "level": 4,
  "text": "泛舟山河，领略各地风物，于闲读短文间暂避俗世纷扰。",
  "uiIdx": "",
  "range": "722-770",
  "chapterUid": 2
 },
 {
  "level": 4,
  "text": "不堆砌宏大道理，撷取生活点滴美好，随手翻开一篇，便能收获片刻松弛与简单的快乐。",
  "uiIdx": "",
  "range": "770-809",
  "chapterUid": 2
 }
]