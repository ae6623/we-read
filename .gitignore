# Agent2Agent 前端通信板的本地"已读游标"（每个 Agent 各自维护，不共享、不提交）
/.a2a/

# 本机 agent 工作目录（各 agent 私有，不入库）
/.workbuddy/

# Python 编译产物
__pycache__/
*.pyc

# 本地 SQLite 与解析中间产物（可由 outline.html 重算，不入库）
/data/*
# 例外：全书导图的提炼结果。重算要过 LLM（配额有限），且含人工修正，必须留存
!/data/mindmap/
